<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<!-- Keep the large-rule estimate visible; measured tradeoffs are recorded in the benchmark README. -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);GRAM5003</WarningsNotAsErrors>
		<RootNamespace>DotGram.Finance</RootNamespace>
		<Description>FIX 4.4 tag-value parsing built with DotGram.</Description>
		<PackageReleaseNotes>FIX 4.4 flat typed field parsing with native byte streams and an explicitly invoked message, group and validation API.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>fix;finance;parser;dotgram</PackageTags>
		<PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
		<DebugType>embedded</DebugType>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="DotGram.Finance.Tests" />
		<ProjectReference Include="../DotGram/DotGram.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="Fix/Fix44/*.gram" />
		<AdditionalFiles Include="Fix/FixDispatch/*.gram" />
		<None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="Fix/Fix44/Specification/LICENSE" Pack="true" PackagePath="licenses/FIX-Orchestra/" />
		<None Include="../../LICENSE" Pack="true" PackagePath="licenses/DotGram/" />
		<None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Memory" />
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>
</Project>
