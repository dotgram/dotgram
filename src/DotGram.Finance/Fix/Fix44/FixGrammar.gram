@using DotGram.Finance.Fix;
using Known;

context : @FixContext

Separator    = ['\u0001']
LogSeparator = ['|']
ValueText    = (?!Separator & any)+
Digits       = ['1'..'9'] & ['0'..'9']*

// Only Pair enters Data, after selecting the matching length and data tags.
Block4096 = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 4096) & any{4096}
Block256  = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 256) & any{256}
Block16   = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 16) & any{16}
Octet     = when @(parserSpan.Start + parserSpan.Length < context.DataLimit) & any

Data =
	{ when @(context.BeginData(parserSpan.Start + parserSpan.Length))
	& Block4096* & Block256* & Block16* & Octet*
	& when @(parserSpan.Start + parserSpan.Length == context.DataLimit)
	}

Unknown : @FixField =
	tag: Digits & when @(FixContext.IsUnknown(tag)) & '='
	& value: (when @(context.IsDataTag(tag)) & Data | when @(!context.IsDataTag(tag)) & ValueText)
	=> @(new FixField.Unknown(FixContext.Tag(tag), FixConvert.Data(value)))

Field : @FixField =
	(v: KnownField(ValueText, Data) | v: Unknown) & Separator => @(v)

Pair : @FixFieldUnit =
	first: Field & when @(context.BeginPair(first.Tag, parserText))
	& tag: ?=Digits & when @(context.IsPairData(tag)) & second: Field
	=> @(new FixFieldUnit(first, second))

Unit : @FixFieldUnit =
	tag: ?=Digits & (
		when @(context.IsTextTag(tag)) & field: Field => @(new FixFieldUnit(field))
		| when @(context.IsLengthTag(tag)) & pair: Pair => @(pair)
	)

Fields : @FixField[] = units: Unit* => @(FixFieldUnit.Flatten(units))
Units : @FixFieldUnit[] = { Unit* }

parse Fields stream bytes
parse Fields with (Separator = LogSeparator) as ParseLogFields stream bytes

parse Units as ReadFields stream bytes yield : @FixFieldUnit
parse Units with (Separator = LogSeparator) as ReadLogFields stream bytes yield : @FixFieldUnit
