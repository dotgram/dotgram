@using DotGram.Finance.Fix;
using Known;

context : @FixContext

Separator    = ['\u0001']
LogSeparator = ['|']
ValueText    = (?!Separator & any)+
Digits       = ['1'..'9'] & ['0'..'9']*

LengthValue = { when @(context.BeginLength(parserSpan.Start + parserSpan.Length)) & ValueText & when @(context.RecordLength(parserSpan.Start + parserSpan.Length, parserText)) }

// Raw data is bounded by the preceding length field, not by a delimiter.
Block4096 = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 4096) & any{4096}
Block256  = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 256) & any{256}
Block16   = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 16) & any{16}
Octet     = when @(parserSpan.Start + parserSpan.Length < context.DataLimit) & any

Data =
	{ when @(context.BeginData(parserSpan.Start + parserSpan.Length))
	& Block4096* & Block256* & Block16* & Octet*
	& when @(parserSpan.Start + parserSpan.Length == context.DataLimit)
	}

UnknownData : @FixField =
	?!KnownTag & tag: Digits & when @(FixContext.Tag(tag) > 0 && context.IsDataTag(tag))
	& '=' & value: Data & Separator
	=> @(new FixField.Unknown(FixContext.Tag(tag), FixConvert.Data(value)))

UnknownText : @FixField =
	?!KnownTag & tag: Digits & when @(FixContext.Tag(tag) > 0 && !context.IsDataTag(tag) && !context.IsLengthTag(tag))
	& '=' & value: ValueText & Separator
	=> @(new FixField.Unknown(FixContext.Tag(tag), FixConvert.Data(value)))

UnknownLength : @FixField =
	?!KnownTag & tag: Digits & when @(FixContext.Tag(tag) > 0 && context.IsLengthTag(tag))
	& '=' & value: LengthValue & Separator
	=> @(new FixField.Unknown(FixContext.Tag(tag), FixConvert.Data(value)))

Field : @FixField =
	when @(context.BeginField(parserSpan.Start + parserSpan.Length))
	& (
		v: KnownField(ValueText, LengthValue, Data, Separator)
		| v: UnknownData
		| v: UnknownLength
		| v: UnknownText
	)
	=> @(v)

Fields : @FixField[] = { Field* }

parse Fields stream bytes
parse Fields with (Separator = LogSeparator) as ParseLogFields stream bytes
