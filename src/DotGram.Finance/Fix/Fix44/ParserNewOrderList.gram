HeaderRest : @FixNode[] = (F49 | F56 | F115 | F128 | F90 | F91 | F34 | F50 | F142 | F57 | F143 | F116 | F144 | F129 | F145 | F43 | F97 | F52 | F122 | F212 | F213 | F347 | F369 | G2085)*
Trailer : @FixNode[] = F93? & F89? & F10
Header : @FixNode[] = begin: F8 & length: F9 & type: MessageType & rest: HeaderRest => @(FixContext.Header(begin, length, type, rest))
MessageType : @FixNode = f: F35 & when @(context.SetMessageType(f)) => @(f)

