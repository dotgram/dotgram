		| value: NetworkResponseID(text, separator)
		| value: NetworkRequestID(text, separator)
		| value: LastNetworkResponseID(text, separator)
		| value: NetworkRequestType(text, separator)
		| value: NoCompIDs(text, separator)
		| value: NetworkStatusResponseType(text, separator)
		| value: NoCollInquiryQualifier(text, separator)
		| value: TrdRptStatus(text, separator)
		| value: AffirmStatus(text, separator)
		| value: UnderlyingStrikeCurrency(text, separator)
		| value: LegStrikeCurrency(text, separator)
		| value: TimeBracket(text, separator)
		| value: CollAction(text, separator)
		| value: CollInquiryStatus(text, separator)
		| value: CollInquiryResult(text, separator)
		| value: StrikeCurrency(text, separator)
		| value: NoNested3PartyIDs(text, separator)
		| value: Nested3PartyID(text, separator)
		| value: Nested3PartyIDSource(text, separator)
		| value: Nested3PartyRole(text, separator)
		| value: NoNested3PartySubIDs(text, separator)
		| value: Nested3PartySubID(text, separator)
		| value: Nested3PartySubIDType(text, separator)
		| value: LegContractSettlMonth(text, separator)
		| value: LegInterestAccrualDate(text, separator)
	)
	=> @(value)
