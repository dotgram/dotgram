<#@ assembly name="System.Core" #>
<#@ assembly name="System.Xml" #>
<#@ assembly name="System.Xml.Linq" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Xml.Linq" #>
<#+
// Shared model of the pinned Orchestra dictionary. No dependency on generated code.
readonly XNamespace Xml = "http://fixprotocol.io/2020/orchestra/repository";
string Root;
string Output;
XElement Repository;
List<XElement> Fields;
List<XElement> Components;
List<XElement> Groups;
List<XElement> Messages;
List<XElement> CodeSets;
Dictionary<int, XElement> FieldsById;
Dictionary<int, XElement> ComponentsById;
Dictionary<int, XElement> GroupsById;
Dictionary<string, XElement> CodesByName;
readonly List<string> Saved = new List<string>();

void LoadDictionary(string directory)
{
	Output = directory;
	Root = Path.GetFullPath(Path.Combine(directory, "../../.."));
	Repository = XDocument.Load(Path.Combine(directory, "Specification/OrchestraFIX44.xml")).Root;
	Fields = Elements("fields", "field");
	Components = Elements("components", "component");
	Groups = Elements("groups", "group");
	Messages = Elements("messages", "message");
	CodeSets = Elements("codeSets", "codeSet");
	FieldsById = Fields.ToDictionary(Id);
	ComponentsById = Components.ToDictionary(Id);
	GroupsById = Groups.ToDictionary(Id);
	CodesByName = CodeSets.ToDictionary(e => Attr(e, "name"));
}

List<XElement> Elements(string parent, string child) => Repository.Element(Xml + parent).Elements(Xml + child).ToList();
static string Attr(XElement element, string name) => (string)element.Attribute(name);
static int Id(XElement element) => int.Parse(Attr(element, "id"), CultureInfo.InvariantCulture);
IEnumerable<XElement> References(XElement element) => element.Elements().Where(e =>
	e.Name.LocalName == "fieldRef" || e.Name.LocalName == "componentRef" || e.Name.LocalName == "groupRef");
string FieldType(XElement field)
{
	var type = Attr(field, "type");
	XElement codes;
	return CodesByName.TryGetValue(type, out codes) ? Attr(codes, "type") : type;
}

sealed class Item
{
	public Item(bool group, int id) { Group = group; Id = id; }
	public readonly bool Group;
	public readonly int Id;
}

IEnumerable<Item> Flatten(XElement element)
{
	foreach (var reference in References(element))
	{
		var id = Id(reference);
		if (reference.Name.LocalName == "componentRef")
		{
			foreach (var item in Flatten(ComponentsById[id])) yield return item;
		}
		else yield return new Item(reference.Name.LocalName == "groupRef", id);
	}
}

int Tag(Item item) => item.Group ? Id(GroupsById[item.Id].Element(Xml + "numInGroup")) : item.Id;
bool Number(XElement field) => new[] { "int", "Length", "NumInGroup", "SeqNum", "TagNum", "DayOfMonth", "float", "Qty", "Price", "PriceOffset", "Amt", "Percentage" }.Contains(FieldType(field));

void Properties(IEnumerable<Item> items)
{
	var seen = new HashSet<string>();
	foreach (var item in items)
	{
		var tag = Tag(item);
		var field = FieldsById[tag];
		var name = Attr(field, "name");
		if (!seen.Add(name)) continue;
		if (item.Group)
		{
			var group = Attr(GroupsById[item.Id], "name");
			WriteLine("\tpublic IReadOnlyList<{0}Entry> {0} => GetTypedGroup<{0}Entry>({1});", group, tag);
		}
		else WriteLine("\tpublic {0}? {1} => {2}({3});", Number(field) ? "FixNumber" : "string", name, Number(field) ? "GetNumber" : "GetText", tag);
	}
}

void SchemaArray(string name, XElement element, string displayName)
{
	WriteLine("\t// " + displayName);
	WriteLine("\tstatic readonly SchemaRef[] " + name + " =");
	WriteLine("\t{");
	foreach (var reference in References(element))
	{
		var id = Id(reference);
		var kind = reference.Name.LocalName == "fieldRef" ? 0 : reference.Name.LocalName == "componentRef" ? 1 : 2;
		var dictionary = kind == 0 ? FieldsById : kind == 1 ? ComponentsById : GroupsById;
		WriteLine("\t\tnew SchemaRef({0}, {1}, {2}), // {3}", id, Attr(reference, "presence") == "required" ? "true" : "false", kind, Attr(dictionary[id], "name"));
	}
	WriteLine("\t};");
	WriteLine("");
}

sealed class Primitive
{
	public Primitive(string type, string conversion) { Type = type; Conversion = conversion; }
	public readonly string Type;
	public readonly string Conversion;
}

Primitive ValueType(XElement field)
{
	switch (FieldType(field))
	{
		case "int": case "Length": case "NumInGroup": case "SeqNum": case "TagNum": case "DayOfMonth": return new Primitive("BigInteger", "Integer");
		case "float": case "Qty": case "Price": case "PriceOffset": case "Amt": case "Percentage": return new Primitive("FixDecimal", "Decimal");
		case "Boolean": return new Primitive("bool", "Boolean");
		case "char": return new Primitive("char", "Character");
		case "data": return new Primitive("ReadOnlyMemory<byte>", "Data");
		case "UTCTimestamp": return new Primitive("FixTimestamp", "Timestamp");
		case "UTCTimeOnly": return new Primitive("FixTime", "Time");
		case "UTCDateOnly": case "LocalMktDate": return new Primitive("FixDate", "Date");
		case "MonthYear": return new Primitive("FixMonthYear", "MonthYear");
		case "MultipleValueString": return new Primitive("string[]", "Multiple");
		default: return new Primitive("string", "Text");
	}
}

// Commit only completed outputs, retaining timestamps when their bytes are unchanged.
void Save(string name)
{
	var path = Path.GetFullPath(Path.Combine(Output, name));
	if (!path.StartsWith(Root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
		throw new InvalidOperationException("Generated file is outside the repository: " + path);
	var text = GenerationEnvironment.ToString().Replace("\r\n", "\n").TrimEnd() + "\n";
	GenerationEnvironment.Clear();
	var encoding = new UTF8Encoding(Path.GetExtension(path) == ".cs");
	var bytes = encoding.GetPreamble().Concat(encoding.GetBytes(text.Replace("\n", "\r\n"))).ToArray();
	Directory.CreateDirectory(Path.GetDirectoryName(path));
	if (!File.Exists(path) || !File.ReadAllBytes(path).SequenceEqual(bytes)) File.WriteAllBytes(path, bytes);
	Saved.Add(path.Substring(Root.Length + 1).Replace('\\', '/'));
}

// Small deterministic JSON writer, shared by inventory and fixtures. Preserve the
// existing ASCII escaping, property order, tabs and CRLF without a JSON dependency.
static List<KeyValuePair<string, object>> Object(params object[] pairs)
{
	var result = new List<KeyValuePair<string, object>>();
	for (var i = 0; i < pairs.Length; i += 2) result.Add(new KeyValuePair<string, object>((string)pairs[i], pairs[i + 1]));
	return result;
}

static string Quote(string value)
{
	var result = new StringBuilder("\"");
	foreach (var c in value)
	{
		switch (c)
		{
			case '"': result.Append("\\\""); break;
			case '\\': result.Append("\\\\"); break;
			case '\b': result.Append("\\b"); break;
			case '\f': result.Append("\\f"); break;
			case '\n': result.Append("\\n"); break;
			case '\r': result.Append("\\r"); break;
			case '\t': result.Append("\\t"); break;
			default:
				if (c < 32 || c > 126) result.Append("\\u" + ((int)c).ToString("x4", CultureInfo.InvariantCulture));
				else result.Append(c);
				break;
		}
	}
	return result.Append('"').ToString();
}

static string Json(object value, int depth = 0)
{
	if (value is string) return Quote((string)value);
	var properties = value as List<KeyValuePair<string, object>>;
	var array = value as IEnumerable<object>;
	if (properties != null || array != null)
	{
		var entries = properties != null
			? properties.Select(p => Quote(p.Key) + ": " + Json(p.Value, depth + 1)).ToArray()
			: array.Select(p => Json(p, depth + 1)).ToArray();
		var open = properties != null ? "{" : "[";
		var close = properties != null ? "}" : "]";
		return entries.Length == 0 ? open + close : open + "\n" + new string('\t', depth + 1) +
			string.Join(",\n" + new string('\t', depth + 1), entries) + "\n" + new string('\t', depth) + close;
	}
	return Convert.ToString(value, CultureInfo.InvariantCulture);
}

void Inventory()
{
	Write(Json(Object("version", Attr(Repository, "version"),
		"counts", Object("messages", Messages.Count, "fields", Fields.Count, "components", Components.Count, "groups", Groups.Count, "codeSets", CodeSets.Count),
		"messages", Messages.Select(m => (object)Object("name", Attr(m, "name"), "msgType", Attr(m, "msgType"))),
		"lengthDataPairs", Fields.Where(f => f.Attribute("lengthId") != null).Select(f => (object)Object("lengthTag", int.Parse(Attr(f, "lengthId"), CultureInfo.InvariantCulture), "dataTag", Id(f))))));
}

string SampleField(int id)
{
	var field = FieldsById[id];
	XElement codes;
	if (CodesByName.TryGetValue(Attr(field, "type"), out codes)) return Attr(codes.Element(Xml + "code"), "value");
	switch (FieldType(field))
	{
		case "String": case "char": case "data": case "MultipleValueString": return "X";
		case "Boolean": return "N";
		case "Currency": return "USD";
		case "Country": return "US";
		case "Exchange": return "XNAS";
		case "MonthYear": return "202609";
		case "UTCTimestamp": return "20260915-12:00:00";
		case "UTCTimeOnly": return "12:00:00";
		case "UTCDateOnly": case "LocalMktDate": return "20260915";
		default: return "1";
	}
}

List<KeyValuePair<int, string>> Sample(XElement element, bool forceFirst = false, bool requiredComponent = false, bool full = false)
{
	var result = new List<KeyValuePair<int, string>>();
	var index = 0;
	foreach (var child in References(element))
	{
		var first = index++ == 0;
		var id = Id(child);
		if (!full && Attr(child, "presence") != "required" && !(forceFirst && first)) continue;
		if (child.Name.LocalName == "componentRef")
		{
			if (id != 1024 && id != 1025) result.AddRange(Sample(ComponentsById[id], requiredComponent: true, full: full));
		}
		else if (child.Name.LocalName == "groupRef")
		{
			result.Add(new KeyValuePair<int, string>(Tag(new Item(true, id)), "1"));
			result.AddRange(Sample(GroupsById[id], forceFirst: true, full: full));
		}
		else result.Add(new KeyValuePair<int, string>(id, SampleField(id)));
	}
	return requiredComponent && result.Count == 0 ? Sample(element, forceFirst: true) : result;
}

static string WireFields(IEnumerable<KeyValuePair<int, string>> fields) => string.Concat(fields.Select(p => p.Key.ToString(CultureInfo.InvariantCulture) + "=" + p.Value + '\x01'));

void Fixtures()
{
	var fixtures = new List<object>();
	foreach (var message in Messages)
		foreach (var full in new[] { false, true })
		{
			var body = "35=" + Attr(message, "msgType") + "\x01";
			body += full ? WireFields(Sample(ComponentsById[1024], full: true).Where(p => p.Key != 8 && p.Key != 9 && p.Key != 35))
				: "49=SENDER\x01" + "56=TARGET\x01" + "34=1\x01" + "52=20260915-12:00:00\x01";
			body += WireFields(Sample(message.Element(Xml + "structure"), full: full));
			if (full) body += "93=1\x01" + "89=X\x01";
			var wire = "8=FIX.4.4\x01" + "9=" + body.Length.ToString(CultureInfo.InvariantCulture) + '\x01' + body;
			wire += "10=" + (wire.Sum(c => (int)c) % 256).ToString("000", CultureInfo.InvariantCulture) + '\x01';
			fixtures.Add(Object("name", Attr(message, "name"), "wire", wire));
		}
	Write(Json(fixtures));
}
#>
