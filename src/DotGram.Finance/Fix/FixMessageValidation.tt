<#+
	// ═══ what is written once, because it is the standard's and not any message's ════════════

	void EmitShared()
	{
		Line(0, "/// <summary>The code sets FIX 4.4 publishes, each named by its tag.</summary>");
		Line(0, "/// <remarks>");
		Line(0, "/// Not a table and not looked up: a validator names the one array it needs, and the name");
		Line(0, "/// is resolved by the compiler. They live together only so that a set shared by twenty");
		Line(0, "/// message types is written once rather than twenty times.");
		Line(0, "/// </remarks>");
		Line(0, "static class FixCodes");
		Line(0, "{");

		var first = true;

		foreach (var tag in codeSets)
		{
			if (!first)
				Blank();

			var field = fieldsByTag[tag];

			Line(1, "/// <summary>The code set of " + field.Name + ", tag " + tag + ".</summary>");
			Line(1, "public static readonly string[] T" + tag + " =");
			Line(1, "[");
			Line(2, string.Join(", ", field.Codes.Select(code => "\"" + code + "\"").ToArray()));
			Line(1, "];");

			first = false;
		}

		Line(0, "}");
		Blank();
		Line(0, "/// <summary>What every message is held to, because the standard says it of all of them.</summary>");
		Line(0, "/// <remarks>");
		Line(0, "/// The standard header and trailer are one scope each for all ninety-three types; the");
		Line(0, "/// sixteen length/data pairs are the standard's; and whether FIX 4.4 defines a tag at all");
		Line(0, "/// is a question about the standard, not about a message. Writing them out in every");
		Line(0, "/// validator would add about thirty-six thousand lines and tell a reader nothing new.");
		Line(0, "/// </remarks>");
		Line(0, "static class FixStandard");
		Line(0, "{");

		Line(1, "/// <summary>The standard header, which every message carries.</summary>");
		Line(1, "public static void Header(FixMessage message, ref List<FixFinding>? found)");
		Line(1, "{");
		EmitScope(header, "message.Header", "FixScope.Header", "0", "-1", false, 0, 2);
		Line(1, "}");
		Blank();

		Line(1, "/// <summary>The standard trailer, which every message carries.</summary>");
		Line(1, "public static void Trailer(FixMessage message, ref List<FixFinding>? found)");
		Line(1, "{");
		EmitScope(trailer, "message.Trailer", "FixScope.Trailer", "0", "-1", false, 0, 2);
		Line(1, "}");
		Blank();

		EmitEncoding();
		Blank();
		EmitPairs();
		Blank();
		EmitNotInScope();

		Line(0, "}");
	}

	void EmitEncoding()
	{
		var encoded = lengthOfData.Keys
			.Where(tag => fieldsByTag[tag].Name.StartsWith("Encoded", StringComparison.Ordinal))
			.OrderBy(tag => tag)
			.ToArray();

		Line(1, "/// <summary>MessageEncoding, which an Encoded field cannot be read without.</summary>");
		Line(1, "public static void Encoding(FixMessage message, ref List<FixFinding>? found)");
		Line(1, "{");
		Line(2, "if (message.Header.GetField(347) == null && (Encoded(message.Header) || Encoded(message)))");
		Line(3, "(found ??= []).Add(new FixFinding(FixRule.MessageEncodingMissing, FixScope.Header, 347, 0, -1, 0,");
		Line(4, "\"MessageEncoding is required where an Encoded field is present.\"));");
		Line(1, "}");
		Blank();
		Line(1, "static bool Encoded(FixFieldSet scope)");
		Line(1, "{");
		Line(2, "foreach (var node in scope.Nodes)");
		Line(2, "{");
		Line(3, "switch (node.Tag)");
		Line(3, "{");

		foreach (var tag in encoded)
			Line(4, "case " + tag + ":   // " + fieldsByTag[tag].Name);

		Line(5, "return true;");
		Line(3, "}");
		Blank();
		Line(3, "if (node.Entries != null)");
		Line(4, "foreach (var entry in node.Entries)");
		Line(5, "if (Encoded(entry))");
		Line(6, "return true;");
		Line(2, "}");
		Blank();
		Line(2, "return false;");
		Line(1, "}");
	}

	void EmitPairs()
	{
		Line(1, "/// <summary>A data field follows the length that measures it, and a length precedes it.</summary>");
		Line(1, "/// <remarks>");
		Line(1, "/// The sixteen pairs of FIX 4.4, asked of every field of every scope. Which tags are a");
		Line(1, "/// pair is the standard's answer and the same in every message, so it is written here");
		Line(1, "/// once; a pair is read off the wire as ONE field carrying the data tag, and these two");
		Line(1, "/// findings are about the length field that should have stood beside it.");
		Line(1, "/// </remarks>");
		Line(1, "public static void Pair(FixFieldSet scope, int index, FixScope where, int groupTag, int entry, ref List<FixFinding>? found)");
		Line(1, "{");
		Line(2, "switch (scope.Nodes[index].Tag)");
		Line(2, "{");

		foreach (var pair in lengthOfData.OrderBy(one => one.Key))
		{
			Line(3, "case " + pair.Key + ":   // " + fieldsByTag[pair.Key].Name + ", which tag " + pair.Value + " measures");
			Line(4, "AfterLength(scope, index, " + pair.Value + ", where, groupTag, entry, ref found);");
			Line(4, "break;");
			Blank();
		}

		foreach (var pair in dataOfLength.OrderBy(one => one.Key))
		{
			Line(3, "case " + pair.Key + ":   // " + fieldsByTag[pair.Key].Name + ", which measures tag " + pair.Value);
			Line(4, "BeforeData(scope, index, " + pair.Value + ", where, groupTag, entry, ref found);");
			Line(4, "break;");
			Blank();
		}

		Line(2, "}");
		Line(1, "}");
		Blank();
		Line(1, "static void AfterLength(FixFieldSet scope, int index, int lengthTag, FixScope where, int groupTag, int entry, ref List<FixFinding>? found)");
		Line(1, "{");
		Line(2, "var node = scope.Nodes[index];");
		Blank();
		Line(2, "if (index == 0 ||");
		Line(3, "scope.Nodes[index - 1].Tag != lengthTag ||");
		Line(3, "!scope.Nodes[index - 1].Field(scope.Source).TryGetInt64(out var measured) ||");
		Line(3, "measured != node.Length)");
		Line(2, "{");
		Line(3, "var field = node.Field(scope.Source);");
		Blank();
		Line(3, "(found ??= []).Add(new FixFinding(FixRule.DataFieldNotAfterLength, where, field.Tag, groupTag, entry, field.ValuePosition,");
		Line(4, "$\"A data field must immediately follow tag {lengthTag}, which measures it.\"));");
		Line(2, "}");
		Line(1, "}");
		Blank();
		Line(1, "static void BeforeData(FixFieldSet scope, int index, int dataTag, FixScope where, int groupTag, int entry, ref List<FixFinding>? found)");
		Line(1, "{");
		Line(2, "if (index + 1 == scope.Nodes.Length || scope.Nodes[index + 1].Tag != dataTag)");
		Line(2, "{");
		Line(3, "var field = scope.Nodes[index].Field(scope.Source);");
		Blank();
		Line(3, "(found ??= []).Add(new FixFinding(FixRule.LengthFieldNotBeforeData, where, field.Tag, groupTag, entry, field.ValuePosition,");
		Line(4, "$\"A length field must immediately precede tag {dataTag}, which it measures.\"));");
		Line(2, "}");
		Line(1, "}");
	}

	void EmitNotInScope()
	{
		Line(1, "/// <summary>A tag the scope does not list, and the two sentences that tells apart.</summary>");
		Line(1, "/// <remarks>");
		Line(1, "/// Whether FIX 4.4 defines a tag at all is a question about the standard and the same for");
		Line(1, "/// every scope, which is why it is asked here rather than written into each of them.");
		Line(1, "/// </remarks>");
		Line(1, "public static void NotInScope(FixFieldView field, FixScope where, int groupTag, int entry, ref List<FixFinding>? found)");
		Line(1, "{");
		Line(2, "(found ??= []).Add(new FixFinding(FixRule.FieldNotInScope, where, field.Tag, groupTag, entry, field.ValuePosition,");
		Line(3, "Defines(field.Tag)");
		Line(4, "? \"The schema defines this tag, but not in this scope.\"");
		Line(4, ": \"The schema defines no such tag.\"));");
		Line(1, "}");
		Blank();
		Line(1, "/// <summary>Whether FIX 4.4 gives this tag a name at all.</summary>");
		Line(1, "static bool Defines(int tag)");
		Line(1, "{");
		Line(2, "switch (tag)");
		Line(2, "{");

		var line  = new StringBuilder();
		var count = 0;

		foreach (var tag in fieldsByTag.Keys.OrderBy(one => one))
		{
			line.Append("case ").Append(tag).Append(": ");

			if (++count % 10 == 0)
			{
				Line(3, line.ToString().TrimEnd());
				line.Clear();
			}
		}

		if (line.Length != 0)
			Line(3, line.ToString().TrimEnd());

		Line(4, "return true;");
		Blank();
		Line(3, "default:");
		Line(4, "return false;");
		Line(2, "}");
		Line(1, "}");
	}

	static string Indent(int depth)
	{
		return new string('\t', depth);
	}
