@using System;
@using DotGram.Parsers.Sql;

using Sql92;

// A dialect, and this file is the whole of what makes it one. The rules of
// ISO/IEC 9075:1992 come from `SqlStandard92.gram`, inherited by the class this
// grammar is attached to; what is written here is only where T-SQL differs, and
// §5.1's rebinding is what makes the difference reach every rule that leads to it.
//
// Twenty-one rules replace twenty-one of the standard's. Nothing else is restated and nothing
// is copied: a query expression, a join, a predicate and the whole value tower are
// the ones already read against the standard, reading a dialect's identifiers and
// a dialect's primaries because the substitution rewrote every call inside them.

// ── What the wrapper does not carry across ──────────────────────────────────
//
// A grammar this one inherits is wrapped in a namespace of its own, and §4.5 is
// exactly that a namespace keeps its own trivia. So the standard's whitespace and
// its word boundary belong to the standard's rules, and the rules written here
// need their own — the same two, said again, pointing at the same lexemes.
//
// Not saying them is not an error and that is the trap: rules without a boundary
// read their keywords as punctuation, and a grammar that reads `USERS` as `USER`
// followed by `S` is wrong in a way nothing in it looks wrong.
wordboundary = TSql.IdentifierPart

// Spacing stops short of a line that says `GO`, which is a lexeme of its own (`TSql.GoLine`).
// The spaces are the engine's (`TSql.Spacing`), and they are what the standard's rules
// read between their words too: `FROM t` and a line separator and `WHERE` is read.
trivia       = { (TSql.Spacing | Std.LineComment("--") | TSql.NestedComment)* }

// ── The lexemes T-SQL has and the standard does not ─────────────────────────
//
// A namespace with no trivia, so a token is its characters — the same shape
// `Sql92.Lexical` has, and a separate one because a grammar declares its own.
namespace TSql
{
	trivia = none

	// What the engine takes for a space, asked one character at a time: every control
	// character below the space, Unicode's spaces and its two separators — which is what
	// .NET calls white space — and the zero-width space besides, which SQL:2003 lists
	// among its own. Not U+007F, a soft hyphen, the joiners, the direction marks, U+180E
	// or U+FEFF. The corpus writes U+202F between the words of a statement, and U+200B
	// and U+3000 in front of a number.
	Spacing = ['\u0001'..'\u001F' | '\u0085' | '\u200B' | \p{Zs} | \p{Zl} | \p{Zp}]+

	// A comment in brackets holds another, as T-SQL's do: `/* a /* b */ c */` is one comment,
	// and `/* a /* b */` is refused as unclosed (`Msg 113`). A quote inside means nothing —
	// `/* '*/' */` ends at the first `*/`, as the engine ends it.
	//
	// The lexer is a finite machine and nesting is not finite, so the depth is written out:
	// six comments deep, which is deeper than anything the corpus or the reference writes. A
	// seventh `/*` inside the sixth leaves the comment unclosed where the engine would read
	// it — the one place this reads less than the engine does. Each level is, until it
	// closes, the one inside it or a character that does not open one: the close is asked
	// first and each way is kept from the other's start, so the seam is still one scan.
	NestedComment = "/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ?!"/*" & any)* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/"

	// A delimited identifier written the way T-SQL writes it, with `]]` for a
	// bracket inside — the same escape the standard's `""` is.
	BracketedIdentifier = '[' & ("]]" | [^ ']'])* & ']'

	// A name's characters after its first: the standard's, and `@`, `$` and `#`, which a T-SQL name
	// may hold anywhere but first — `Row#`, `a$b`, `@a#b` — and which end a word no more than a
	// letter does: `SELECT FROM#` is a column called `FROM#`, and `SELECT@a` is refused.
	IdentifierPart    = [\p{L} | \p{Nd} | '_' | '@' | '$' | '#']
	RegularIdentifier = Sql92.Lexical.IdentifierStart & TSql.IdentifierPart*

	// A local variable, a parameter, and the two `@@` spellings of a built-in.
	// One rule: what tells them apart is the catalogue and not the syntax.
	Variable = '@' & '@'? & Sql92.Lexical.IdentifierStart & TSql.IdentifierPart*

	// Money, written with the sign the culture uses, and a binary string written the
	// way T-SQL writes one. Neither is a lexeme of the standard. A binary string goes on past a
	// backslash at the end of a line, as the engine continues it: `0xabc\` and `def` on the next
	// line are `0xABCDEF`. A string's backslash is one of its characters and needs nothing.
	//
	// The currency sign, the sign of the number and the digits stand as far apart as they like
	// — `$ 10.12`, `-$   10.12`, `$ -10.12` and `-£ 10.12` are all read — which is why this is
	// not one run of characters. The point is not so free: `$10 . 12` is `Msg 102`, so the
	// digits on either side of it hug it, and each side is a lexeme of its own.
	MoneyLiteral  = ['$' | '£' | '¥' | '€'] & Spacing? & ['+' | '-']? & Spacing? & MoneyDigits
	MoneyDigits   = Sql92.Lexical.Digits & ('.' & Sql92.Lexical.Digits?)?
	BinaryLiteral = '0' & 'x'i & ['0'..'9' | 'a'..'f' | 'A'..'F']* & ('\\' & ('\r' & '\n'? | '\n') & ['0'..'9' | 'a'..'f' | 'A'..'F']*)*

	// A name the `$` is part of: `$IDENTITY`, `$ROWGUID`, `$PARTITION`, a graph table's
	// `$node_id`. One token, since the engine refuses `$ IDENTITY`; a digit after the `$`
	// makes it money instead.
	PseudoColumn = '$' & Sql92.Lexical.IdentifierStart & TSql.IdentifierPart*

	// A temporary table, local or global. The name is otherwise ordinary.
	TemporaryName = '#' & '#'? & Sql92.Lexical.IdentifierStart & TSql.IdentifierPart*

	// The line a client cuts a script at: `GO`, a count where one is written — `GO 5` sends
	// the batch five times — and whatever may close the line, up to and including its line
	// break. The line break is what makes it a separator: the lexeme is longer than the word
	// `GO`, so the longest match takes it, and `SELECT 1` and then `GO` on the next line is a
	// batch and its end, not a column called `GO`; `GOTO` and `GO_x` have no line break after
	// the `GO` and stay words, and so does a `GO` in a comment or a string.
	//
	// A lexer skips trivia before it reads a lexeme, so the line break before the `GO` cannot
	// be the lexeme's, and what is asked is that `GO` end a line rather than begin one. The
	// two differ only on a line that has both something before the `GO` and nothing after
	// it, or a `GO` with a statement after it on the same line — neither in the corpus. And
	// the end of the input cannot close the line, since a lexeme is a pattern and `eof` is
	// not one (GRAM5004): a `GO` on the last line of a file with no line break after it —
	// forty-three files of the corpus end so — is the word, and the script takes it there
	// (`FinalGo`).
	GoLine = 'G'i & 'O'i
		   & ([' ' | '\t']+ & Sql92.Lexical.Digits)? & [' ' | '\t']*
		   & (';' & [' ' | '\t']*)?
		   & (Std.BlockComment("/*", "*/") & [' ' | '\t']*)?
		   & Std.LineComment("--")?
		   & ('\r' & '\n'? | '\n')
}

// ── What T-SQL reserves ─────────────────────────────────────────────────────
//
// A different list and not a longer one. The standard reserves `NATURAL`, `MATCH`
// and `CAST`, which T-SQL does not; T-SQL reserves `TOP`, `OPTION` and `OVER`,
// which the standard has never heard of. So it replaces rather than adds, and the
// standard's own list stands where the standard's rules still read.
//
// All hundred and seventy-nine of them, where `Sql92.Reserved` is a curated part of
// §5.2 — "the part this layer can be confused by". Curating it here was tried and
// is what let `SELECT TOP` read as a column called `TOP` and `FROM t OPTION (x)`
// read as a correlation named `OPTION` with a column list: both are refusals in
// any real T-SQL, and neither looked wrong. The list is Microsoft's own, taken
// from the token table its parser generator is fed (`TSqlTokenTypes.g`), where a
// word being a token at all is exactly what makes it unavailable as a name.
TSqlReserved = ("ADD"i | "ALL"i | "ALTER"i | "AND"i | "ANY"i | "AS"i | "ASC"i | "AUTHORIZATION"i
	| "BACKUP"i | "BEGIN"i | "BETWEEN"i | "BREAK"i | "BROWSE"i | "BULK"i | "BY"i
	| "CASCADE"i | "CASE"i | "CHECK"i | "CHECKPOINT"i | "CLOSE"i | "CLUSTERED"i
	| "COALESCE"i | "COLLATE"i | "COLUMN"i | "COMMIT"i | "COMPUTE"i | "CONSTRAINT"i
	| "CONTAINS"i | "CONTAINSTABLE"i | "CONTINUE"i | "CONVERT"i | "CREATE"i | "CROSS"i
	| "CURRENT"i | "CURRENT_DATE"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i
	| "CURRENT_USER"i | "CURSOR"i | "DATABASE"i | "DBCC"i | "DEALLOCATE"i | "DECLARE"i
	| "DEFAULT"i | "DELETE"i | "DENY"i | "DESC"i | "DISTINCT"i | "DISTRIBUTED"i
	| "DOUBLE"i | "DROP"i | "ELSE"i | "END"i | "ERRLVL"i | "ESCAPE"i | "EXCEPT"i
	| "EXEC"i | "EXECUTE"i | "EXISTS"i | "EXIT"i | "FETCH"i | "FILE"i | "FILLFACTOR"i
	| "FOR"i | "FOREIGN"i | "FREETEXT"i | "FREETEXTTABLE"i | "FROM"i | "FULL"i
	| "FUNCTION"i | "GOTO"i | "GRANT"i | "GROUP"i | "HAVING"i | "HOLDLOCK"i
	| "IDENTITY"i | "IDENTITYCOL"i | "IDENTITY_INSERT"i | "IF"i | "IN"i | "INDEX"i
	| "INNER"i | "INSERT"i | "INTERSECT"i | "INTO"i | "IS"i | "JOIN"i | "KEY"i | "KILL"i
	| "LEFT"i | "LIKE"i | "LINENO"i | "NATIONAL"i | "NOCHECK"i | "NONCLUSTERED"i
	| "NOT"i | "NULL"i | "NULLIF"i | "OF"i | "OFF"i | "OFFSETS"i | "ON"i | "OPEN"i
	| "OPENDATASOURCE"i | "OPENQUERY"i | "OPENROWSET"i | "OPENXML"i | "OPTION"i | "OR"i
	| "ORDER"i | "OUTER"i | "OVER"i | "PERCENT"i | "PLAN"i | "PRIMARY"i | "PRINT"i
	| "PROC"i | "PROCEDURE"i | "PUBLIC"i | "RAISERROR"i | "READ"i | "READTEXT"i
	| "RECONFIGURE"i | "REFERENCES"i | "REPLICATION"i | "RESTORE"i | "RESTRICT"i
	| "RETURN"i | "REVOKE"i | "RIGHT"i | "ROLLBACK"i | "ROWCOUNT"i | "ROWGUIDCOL"i
	| "RULE"i | "SAVE"i | "SCHEMA"i | "SELECT"i | "SESSION_USER"i | "SET"i | "SETUSER"i
	| "SHUTDOWN"i | "SOME"i | "STATISTICS"i | "SYSTEM_USER"i | "TABLE"i | "TEXTSIZE"i
	| "THEN"i | "TO"i | "TOP"i | "TRAN"i | "TRANSACTION"i | "TRIGGER"i | "TRUNCATE"i
	| "TSEQUAL"i | "UNION"i | "UNIQUE"i | "UPDATE"i | "UPDATETEXT"i | "USE"i | "USER"i
	| "VALUES"i | "VARYING"i | "VIEW"i | "WAITFOR"i | "WHEN"i | "WHERE"i | "WHILE"i
	| "WITH"i | "WRITETEXT"i
	// And ten more, which Microsoft's list of reserved keywords has, the token table does not,
	// and the engine refuses as a name wherever a name stands — a table, a column, an alias,
	// after a dot. The list's `DISK`, `DUMP`, `LOAD`, `PRECISION` and `SECURITYAUDIT` it reads
	// as names, and they are not here.
	| "EXTERNAL"i | "MERGE"i | "PIVOT"i | "REVERT"i | "SEMANTICKEYPHRASETABLE"i
	| "SEMANTICSIMILARITYDETAILSTABLE"i | "SEMANTICSIMILARITYTABLE"i | "TABLESAMPLE"i
	| "TRY_CONVERT"i | "UNPIVOT"i)

// ── §6.20's simple when, widened ───────────────────────────────────────────
//
// `CASE x WHEN NULL THEN …` compares against the null nothing equals, which is useless
// and legal — the standard's `<when operand>` is a value expression and null is not one,
// and T-SQL admits it where the standard does not.
TSqlSimpleWhen : @Clause.When
	= "WHEN"i & test: Result & "THEN"i & result: Result => @(new Clause.When(test, result))

// ── §7.10's query expression, narrowed ─────────────────────────────────────
//
// **`ALL` belongs to `UNION` and to nothing else.** The standard writes it on all three
// set operators and the dialect inherited that; SQL Server answers `The 'ALL' version of
// the EXCEPT operator is not supported` and says the same of `INTERSECT`. `CORRESPONDING`
// goes with it: it is SQL-92 and T-SQL has never had it.
//
// The strengths are the standard's own — `INTERSECT` tighter than the two beside it, all
// three to the left (§4.3.1).
TSqlQueryExpression : @Query
	= left: TSqlQueryExpression & "UNION"i & all: "ALL"i? & right: TSqlQueryExpression  << 1
		=> @(Query.Combined("UNION", all, left, right))
	| left: TSqlQueryExpression & "EXCEPT"i & right: TSqlQueryExpression                << 1
		=> @(Query.Combined("EXCEPT", null, left, right))
	| left: TSqlQueryExpression & "INTERSECT"i & right: TSqlQueryExpression             << 2
		=> @(Query.Combined("INTERSECT", null, left, right))
	| q: QueryPrimary => @(q)

// ── §6.4's qualified name, widened ─────────────────────────────────────────
//
// A part may be left out: `myDb..t2` names a database and a table and no schema between
// them. Written as a dot that stands in front of another dot rather than as an optional
// name, so that `t.*` still ends where it did — a name that could end with a dot would
// eat the one the star needs.
TSqlQualifiedName
	= Identifier     & NamePart*
	| PartitionName  & NamePart*
	| SystemFunction & NamePart*
	| NamePart+

NamePart     = '.' & NamePartName
NamePartName = Identifier | PartitionName | ?='.'

// A name the `$` is part of rather than the money literal it opens elsewhere:
// `$PARTITION.f1(x)` names an index's partition function, `$node_id`, `$edge_id`,
// `$from_id` and `$to_id` are the columns a graph table has and nobody declared, and
// `$IDENTITY` and `$ROWGUID` the table's identity and row-GUID columns whatever they are
// called. `IDENTITY` is reserved, so a `$` and a name read the last two as nothing.
PartitionName = TSql.PseudoColumn

// The older spelling of a system table-valued function, which puts the `::` in front of
// the name instead of between two of them: `CROSS APPLY ::fn_get_sql (h)`.
SystemFunction = "::" & Identifier

// ── §5.2's identifier, widened ──────────────────────────────────────────────
//
// The standard's two spellings and the two more T-SQL admits. The lookahead
// stands in front of the regular one only, exactly as it does in the standard:
// a bracketed name may be a reserved word, and that is what brackets are for.
TSqlIdentifier
	= ?!TSqlReserved & TSql.RegularIdentifier
	| Sql92.Lexical.DelimitedIdentifier
	| TSql.BracketedIdentifier
	| TSql.TemporaryName

// ── §6.3's general value specification, widened ─────────────────────────────
//
// A variable stands where a parameter does, which is what the standard's rule is
// for. Its own alternatives are restated rather than called: a replacement that
// named the rule it replaces would be rewritten into itself.
TSqlValueSpecification : @Expression
	= t: (':' & Identifier & ("INDICATOR"i? & ':' & Identifier)?)
		=> @(new Expression.Literal(SqlLiteralKind.Parameter, t))
	| '?'
		=> @(new Expression.Literal(SqlLiteralKind.Parameter, "?"))
	| t: TSql.Variable
		=> @(new Expression.Literal(SqlLiteralKind.Parameter, t))
	| t: ("USER"i | "CURRENT_USER"i | "SESSION_USER"i | "SYSTEM_USER"i | "VALUE"i)
		=> @(new Expression.Literal(SqlLiteralKind.Special, t))

// ── §6.11's value expression, widened ───────────────────────────────────────
//
// The standard's tower with T-SQL's operators in it, at the strengths the engine gives
// them, asked with numbers since a parse says nothing of grouping: `&`, `|` and `^` are as
// weak as `+` and `-` and read left to right with them — `2 + 5 & 4` is 4 and `5 & 4 + 2`
// is 6 — `%` is as strong as `*`, and `~` is a sign, `~2 * 3` being -9. A comparison is
// weaker than all of them: `1 & 3 = 1` holds. Restated rather than called, as a
// replacement has to be.
TSqlValueExpression : @Expression
	= left: TSqlValueExpression & op: ('+' | '-' | "||" | '&' | '|' | '^') & right: TSqlValueExpression << 1
		=> @(Expression.Additive(op, left, right))
	| left: TSqlValueExpression & op: ('*' | '/' | '%') & right: TSqlValueExpression           << 2
		=> @(Expression.Multiplicative(op, left, right))
	| sign: ['+' | '-' | '~'] & v: TSqlValueExpression                                         >> 3
		=> @(Expression.Signed(sign, v))
	| p: TSqlValuePrimary & how: Collate? => @(how is null ? p : new Expression.Collated(p, how))

// §8.2's comparison operators and T-SQL's three, `!=`, `!<` and `!>`. Each of the two
// character ones is two tokens to the engine, which reads `< >`, `> =` and `! <` as well;
// `!<>`, `!<=` and `!!` it refuses. Here the lexer takes `<=` whole wherever it is written
// together, since other rules have the literal, so each is read both ways.
TSqlCompOp
	= "<>" | "<=" | ">=" | "!=" | "!<" | "!>"
	| '<' & '>' | '<' & '=' | '>' & '=' | '!' & '=' | '!' & '<' | '!' & '>'
	| '=' | '<' | '>'

// ── §6.11's value expression primary, widened ───────────────────────────────
//
// The standard names every function it has and leaves the rest to a routine
// invocation it does not define; T-SQL's are ordinary calls on a qualified name,
// which is one alternative and has to stand after the named ones — `COUNT(*)` is
// a set function and not a call to something called `COUNT`.
//
// A postfix stands outside the choice rather than on each arm of it: `AT TIME ZONE`
// applies to whatever was just read, which is one rule around the core and not
// twelve inside it.
//
// The zones chain, `a AT TIME ZONE b AT TIME ZONE c`, and a collation may stand in front
// of each, `a COLLATE x AT TIME ZONE b`; the engine reads both. The last collation is the
// standard's own, after the primary, so two never stand side by side, which the engine
// refuses.
TSqlValuePrimary : @Expression
	= p: TSqlPrimaryCore & members: Member* & zones: AtTimeZone*
		=> @(Syntax.Reached(p, members, zones))

// Built with what it applies to left null, the way a member is, and closed in `Reached`.
AtTimeZone : @Expression
	= how: Collate? & "AT"i & "TIME"i & "ZONE"i & v: TimeZone
		=> @(new Expression.RoutineInvocation("AT TIME ZONE",
				 new Expression[] { how is null ? null! : new Expression.Collated(null!, how), v }))

// A zone is a primary with its members, and signs in front of it: `- b`, `~ b`, `b::c`.
TimeZone : @Expression
	= sign: ['+' | '-' | '~'] & v: TimeZone   => @(Expression.Signed(sign, v))
	| p: TSqlPrimaryCore & members: Member*  => @(Syntax.Reached(p, members, null))

TSqlPrimaryCore : @Expression
	= '(' & v: ValueExpression & ')' => @(new Expression.Parenthesized(v))
	| c: CaseExpression                        => @(c)
	| c: TSqlCast                              => @(c)
	| f: ValueFunction                         => @(f)
	| f: TSqlValueFunction                     => @(f)
	| f: CountStar & tail: CallTail?                => @(Syntax.Called(f, tail))
	| f: SetFunctionSpecification & tail: CallTail? => @(Syntax.Called(f, tail))
	| q: ScalarSubquery                        => @(q)
	| n: NextValue                             => @(n)
	| f: DatePartCall                          => @(f)
	| f: LeftRightCall                         => @(f)
	| f: FunctionCall                          => @(f)
	| e: OdbcEscape                            => @(e)
	| t: TSql.MoneyLiteral                     => @(new Expression.Literal(SqlLiteralKind.Number, t))
	| t: TSql.BinaryLiteral                    => @(new Expression.Literal(SqlLiteralKind.Hex, t))
	| v: UnsignedValueSpecification            => @(v)
	| "NULL"i                                  => @(Expression.NullValue)
	| t: RowColumnName                         => @(new Expression.ColumnReference(t))
	| n: ColumnReference                       => @(n)

// `LEFT` and `RIGHT` are reserved for the joins and are functions besides: `LEFT('a', 1)` is
// read, and `dbo.LEFT(1)` and `LEFT('a', 1) OVER ()` are refused.
LeftRightCall : @Expression
	= name: ("LEFT"i | "RIGHT"i) & '(' & args: Arguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))

// A table's identity and row-GUID columns by the reserved words that name them, under
// whatever prefix a column takes: `IDENTITYCOL`, `t.ROWGUIDCOL`, `a.b.c.IDENTITYCOL`, and
// `master..t1.IDENTITYCOL`, whose middle part is left out as any name's may be. A column only
// — not an alias, not what a `SET` assigns (`Msg 156`), not a call.
RowColumnName = (NamePartName & '.')* & ("IDENTITYCOL"i | "ROWGUIDCOL"i)

// The functions whose first argument is a date part. A name there is one of a closed list —
// `year`, `yy`, `w`, `tzoffset`, `isowk` and the rest — bracketed, quoted or neither, or in
// brackets of its own; `foo`, `[foo]` and `t.a` are refused (`Msg 155`). Any other value — a
// string, a variable, a call — the engine reads, and objects to when it compiles (`Msg 1023`).
// The tree is the call's, the part a column reference as it was.
DatePartCall : @Expression
	= name: DatePartFunction & '(' & part: DatePart & (',' & rest: Arguments)? & ')' & tail: CallTail?
		=> @(Syntax.Called(new Expression.RoutineInvocation(name, Syntax.Listed(part, rest)), tail))

DatePartFunction : @string
	= t: ("DATEPART"i | "DATENAME"i | "DATEADD"i | "DATEDIFF_BIG"i | "DATEDIFF"i | "DATETRUNC"i | "DATE_BUCKET"i)
		=> @(t)

DatePart : @Expression
	= t: Identifier & when @(Syntax.IsDatePart(t)) => @(new Expression.ColumnReference(t))
	| '(' & p: DatePart & ')'                     => @(new Expression.Parenthesized(p))
	| v: ValueExpression & when @(!Syntax.IsColumn(v)) => @(v)

// ODBC's escapes, which every driver has understood since before this language had a
// standard and which SQL Server still reads: a function called the portable way, and the
// four typed literals. `{ FN convert (@a, sql_int) }` is answered by the engine with a
// complaint about the ODBC type name, which is it having read the escape and then
// disagreeing about what was named inside it.
OdbcEscape : @Expression
	= '{' & fn: "FN"i & f: OdbcFunction & '}' => @(f with { Kind = fn })
	| '{' & kind: OdbcLiteralKind & t: Sql92.Lexical.CharacterStringLiteral & '}'
		=> @(new Expression.OdbcEscape(kind, new Expression.Literal(SqlLiteralKind.Text, t)))

OdbcLiteralKind : @string = t: ("TS"i | "D"i | "T"i | "GUID"i) => @(t)

// The name inside `{ fn … }` is ODBC's and not this language's, so a word T-SQL reserves
// may stand there: `{ fn convert (@a, sql_int) }` calls ODBC's two-argument `convert`,
// which is not the `CONVERT` of §6.10 and does not have to obey its shape.
// Built as the escape itself and not as what is inside it: whether the brackets of a call
// were written is a fact about this rule's two alternatives, and the rule above has no way
// to ask which of them answered.
OdbcFunction : @Expression.OdbcEscape
	= name: OdbcName & '(' & args: Arguments? & ')'
		=> @(new Expression.OdbcEscape(
				 "", new Expression.RoutineInvocation(name, args ?? Expression.None), true))
	| v: ValueExpression => @(new Expression.OdbcEscape("", v))

OdbcName = word

// A property or a method reached through a name: `(c1).SomeProperty`, `t::a`,
// `dbo.[type 1]::[Property]`. Kept, as a collate clause is — what it names is a
// type's business and not this tree's, but the text has to come back out.
// Written as a postfix because a qualified name has already eaten every `.` it
// could, so this fires only where one is left over.
// Built with its left side null and closed by whoever read it, so that a chain of members
// is a chain of nodes rather than one node holding a list of names.
Member : @Expression.Member
	= by: ("::" | '.') & name: Identifier
	  & call: ('(' & args: Arguments? & ')')?
		=> @(new Expression.Member(null!, by, name, call is null ? null : args ?? Expression.None))

// §6.10's cast, widened, and the T-SQL spellings that are casts under other names.
// `CONVERT` is a different rule and not a wider one: the standard's takes a value and
// a character set, T-SQL's takes a type and a value, in that order.
TSqlCast : @Expression
	= name: "CAST"i & '(' & v: CastOperand & "AS"i & type: DataType & ')' => @(new Expression.RoutineInvocation(name, new Expression[] { v }, type))
	| name: "TRY_CAST"i & '(' & v: CastOperand & "AS"i & type: DataType & ')' => @(new Expression.RoutineInvocation(name, new Expression[] { v }, type))
	| name: ("TRY_CONVERT"i | "CONVERT"i) & '(' & type: DataType & ',' & v: ValueExpression
	  & (',' & style: ValueExpression)? & ')'
		=> @(new Expression.RoutineInvocation(name, style is null ? new Expression[] { v } : new Expression[] { v, style }, type))
	| name: ("TRY_PARSE"i | "PARSE"i) & '(' & v: ValueExpression & "AS"i & type: DataType
	  & ("USING"i & culture: ValueExpression)? & ')'
		=> @(new Expression.RoutineInvocation(
				 name,
				 culture is null ? new Expression[] { v } : new Expression[] { v, culture },
				 type))

// The T-SQL functions with a syntax of their own rather than an argument list, which
// is the same reason §6.16's are written out in the standard. What they have in common
// is a condition standing where a value would: `IIF` takes one, and a value expression
// cannot be one.
//
// And the JSON constructors, which have three things an argument list has not: a key
// written with `:` rather than a comma, a clause saying what a null does, and a type to
// return. All three are from the published syntax of `JSON_OBJECT`.
TSqlValueFunction : @Expression
	= name: "IIF"i & '(' & c: SearchCondition & ',' & a: ValueExpression & ',' & b: ValueExpression & ')'
		=> @(new Expression.RoutineInvocation(name, new Expression[] { c, a, b }))
	| name: "CHOOSE"i & '(' & at: ValueExpression & ',' & first: ValueExpression & (',' & rest: ValueExpression)* & ')'
		=> @(new Expression.RoutineInvocation(name, Syntax.Listed(at, Syntax.Listed(first, rest))))
	| name: JsonObjectName & '(' & body: JsonObjectBody? & ')' & tail: CallTail?
		=> @(Syntax.Called(new Expression.RoutineInvocation(name, body ?? Expression.None), tail))
	| name: JsonArrayName & '(' & body: JsonArrayBody? & ')' & tail: CallTail?
		=> @(Syntax.Called(new Expression.RoutineInvocation(name, body ?? Expression.None), tail))

// **The null clause needs something to be null.** The published syntax makes the key
// values and the clause independently optional — `JSON_OBJECT ( [ <json_key_value>
// [ , ...n ] ] [ json_null_clause ] [ RETURNING json ] )` — so `JSON_OBJECT(NULL ON NULL)`
// reads by the documentation and is answered by SQL Server 2025 with `Incorrect syntax near
// the keyword 'ON'`. The engine is right and the syntax block is wrong, which is the first
// thing found on that side rather than in a parser.
JsonObjectBody : @Expression[]
	= pairs: JsonKeyValues & nulls: JsonNullClause? & returning: JsonReturning?
		=> @(Syntax.Tailed(pairs, nulls, returning))
	| returning: JsonReturning => @(Syntax.Tailed(Expression.None, returning))

JsonArrayBody : @Expression[]
	= items: Arguments & order: JsonOrder? & nulls: JsonNullClause? & returning: JsonReturning?
		=> @(Syntax.Tailed(items, order, nulls, returning))
	| returning: JsonReturning => @(Syntax.Tailed(Expression.None, returning))

JsonObjectName = "JSON_OBJECT"i | "JSON_OBJECTAGG"i
JsonArrayName  = "JSON_ARRAY"i  | "JSON_ARRAYAGG"i

JsonKeyValues : @Expression[]
	= first: JsonKeyValue & (',' & rest: JsonKeyValue)* => @(Syntax.Listed(first, rest))

// `json_key_name : value_expression` — the one place in T-SQL where a colon joins two
// values rather than introducing a parameter.
JsonKeyValue : @Expression
	= key: ValueExpression & ':' & v: JsonValue => @(new Expression.JsonPair(key, v))

// A key's value may be the null a value expression is not — `'type':NULL` is the case
// the `ABSENT ON NULL` clause exists for.
JsonValue : @Expression = "NULL"i => @(Expression.NullValue) | v: ValueExpression => @(v)

// Which model an AI function is computed with, written after its arguments rather than
// as one of them: `AI_GENERATE_EMBEDDINGS ('text' USE MODEL MyModel)`.
UseModel : @string = t: ("USE"i & "MODEL"i & QualifiedName & UseModelParameters?) => @(t)

UseModelParameters = "PARAMETERS"i & ValueExpression

JsonNullClause : @string = t: ("NULL"i & "ON"i & "NULL"i | "ABSENT"i & "ON"i & "NULL"i) => @(t)
JsonReturning  : @string = t: ("RETURNING"i & DataType) => @(t)
JsonOrder      : @string = t: ("ORDER"i & "BY"i & ValueExpression & ("ASC"i | "DESC"i)?) => @(t)

// A sequence, read where a value stands. `FOR` here is not the `FOR` of `FOR JSON`;
// it is the middle of one three-word name.
NextValue : @Expression
	= word: ("NEXT"i & "VALUE"i & "FOR"i) & name: QualifiedName & tail: CallTail?
		=> @(Syntax.Called(
				 new Expression.RoutineInvocation(word, Expression.None, name), tail))

// A call to something this grammar has never heard of, which is most of them: the
// name is a catalogue's business and the arguments are values.
// A name of one part is called bare: `[LEN]('a')` and `"LEN"('a')` are refused, and
// `dbo.[LEN]('a')` is read.
FunctionCall : @Expression
	= name: QualifiedName & when @(Syntax.Callable(name) && !Syntax.IsDatePartFunction(name))
	  & '(' & quantifier: SetQuantifier? & args: Arguments? & model: UseModel?
	  & returning: JsonReturning? & ')' & tail: CallTail?
		=> @(Syntax.Called(
				 new Expression.RoutineInvocation(
					 name, Syntax.Tailed(args ?? Expression.None, model, returning), Syntax.Distinctly(quantifier)), tail))

// What may follow a call: which rows of a window it sees when they are null, what a
// set function inside a window is ordered by, and the window itself. All three are kept,
// for the same reason `OVER` is.
//
// Written out as alternatives of a rule rather than as three optionals in a sequence,
// and that is the shape it has to have. **A choice inside a sequence or a repetition does
// not come back**: `Nulls? & WithinGroup? & Over?` read `RESPECT NULLS` and then refused
// `OVER ()`, and `(Nulls | WithinGroup | Over)*` did the same. Alternatives of a rule do
// come back — which is what makes the two spellings different languages here and not two
// ways of writing one. The same thing shapes `WindowFrame` below.
// Built with its call left null and filled in by whoever read it, the way a predicate's
// left operand is: the call is read once for the five shapes that may follow it.
CallTail : @Expression.WindowFunction
	= t: Nulls & w: Over       => @(new Expression.WindowFunction(null!, t, w))
	| t: WithinGroup & w: Over => @(new Expression.WindowFunction(null!, t, w))
	| t: Nulls                 => @(new Expression.WindowFunction(null!, t, null))
	| t: WithinGroup           => @(new Expression.WindowFunction(null!, t, null))
	| w: Over                  => @(new Expression.WindowFunction(null!, null, w))
Nulls : @string = t: ("RESPECT"i & "NULLS"i | "IGNORE"i & "NULLS"i) => @(t)

// The ordered set a call is computed over reads from level 110; below it the engine answers
// `Incorrect syntax`. The graph path it has as well reads at every level.
WithinGroup : @string
	= t: ("WITHIN"i & "GROUP"i & '(' & OrderByClause & ')') & when Version is Since110 => @(t)
	| t: ("WITHIN"i & "GROUP"i & '(' & "GRAPH"i & "PATH"i & ')') => @(t)

// `TRIM(LEADING … FROM …)`: the standard's three words, which T-SQL reads from level 160.
// `TRIM(x FROM y)` without one reads at every level, and is the standard's own rule still.
TSqlTrimSpecification = ("LEADING"i | "TRAILING"i | "BOTH"i) & when Version is Since160

// The window a call is computed over. Kept, as `TOP` is: it says which rows the call
// sees and not what the call is, which was the argument for dropping it until the round
// trip made it an argument for a field. A window may also be named, and the name is
// declared by the query's own `WINDOW` clause.
//
// A name alone in the brackets is not a window here, whatever SQL:2003 says: SQL Server
// answers `OVER (w)` with `Incorrect syntax` at every level, and reads `OVER w` and
// `OVER (w ORDER BY c)`. A `WINDOW` clause's own definitions may be a name alone —
// `w2 AS (w1)` reads — so the refusal is this rule's and not the specification's.
Over : @Clause.Window
	= "OVER"i & '(' & ?!(WindowName & ')') & w: WindowSpecification & ')' => @(w)
	| "OVER"i & only: Identifier => @(new Clause.Window(only, Expression.None, null, null))

// SQL:2003's <window specification>: the window it is built on, the partition, the order,
// the frame — each optional, in that order. What `OVER (…)` holds, and what a `WINDOW`
// clause declares under a name.
WindowSpecification : @Clause.Window
	= name: WindowName?
	  & ("PARTITION"i & "BY"i & first: ValueExpression & (',' & rest: ValueExpression)*)?
	  & by: OrderByClause?
	  & frame: WindowFrame?
		=> @(new Clause.Window(
				 name, first is null ? Expression.None : Syntax.Listed(first, rest),
				 Clause.Ordered(by, null), frame))

// The name of a window declared by the query's `WINDOW` clause, standing where the
// window itself would. Guarded the same way a correlation name is and for the same
// reason: `PARTITION`, `ROWS` and `RANGE` are not reserved words, so without the
// lookahead the name swallowed the clause that follows it and every frame stopped
// reading — which is exactly what happened when this was written without one.
WindowName   = ?!WindowClause & Identifier
WindowClause = "PARTITION"i | "ROWS"i | "RANGE"i

// A window frame: how far either side of the current row the window reaches.
WindowFrame : @string
	= t: (("ROWS"i | "RANGE"i) & "BETWEEN"i & FrameBound & "AND"i & FrameBound) => @(t)
	| t: (("ROWS"i | "RANGE"i) & FrameBound)                                    => @(t)

FrameBound
	= "UNBOUNDED"i & ("PRECEDING"i | "FOLLOWING"i)
	| "CURRENT"i & "ROW"i
	| ValueExpression & ("PRECEDING"i | "FOLLOWING"i)

// A `*` is not an argument. It stands inside four names and no others, and reading it as
// one made `trim(*)` a call — which SQL Server answers with `Incorrect syntax near '*'`,
// found by putting the corpus to the engine rather than to another parser.
// An argument may be either of the two words a value expression is not: `string_split
// (NULL, N',')` and `dbo.f (DEFAULT, 1)` are both read by the engine, and §7.1's
// `<row value constructor element>` is where the standard says the same thing.
Arguments : @Expression[]
	= first: Argument & (',' & rest: Argument)* => @(Syntax.Listed(first, rest))

Argument : @Expression
	= "NULL"i    => @(Expression.NullValue)
	| "DEFAULT"i => @(Expression.DefaultValue)
	| v: ValueExpression => @(v)

CountStar : @Expression
	= name: ("COUNT_BIG"i | "CHECKSUM"i | "BINARY_CHECKSUM"i) & '(' & '*' & ')'
		=> @(new Expression.RoutineInvocation(name, Expression.None, "*"))

// ── §6.1's data type, widened ───────────────────────────────────────────────
//
// Restated rather than called, as every replacement here is. What T-SQL adds is a
// third of the list — the money, the two blobs, the four datetimes, the spatial
// three — and one thing that is not a type at all: `MAX` where a length stands,
// which says the largest the type allows rather than a number of characters.
//
// A bare qualified name stands last, and it is not a catch-all by accident: a type in
// T-SQL may be one somebody declared, and no parser can tell without the catalogue.
// What keeps it from swallowing everything is that the only place a type is read is
// after `AS` inside a cast.
TSqlDataType
	= ("CHARACTER"i & "VARYING"i? | "CHAR"i & "VARYING"i? | "VARCHAR"i
	  | "NATIONAL"i & ("CHARACTER"i | "CHAR"i) & "VARYING"i? | "NCHAR"i & "VARYING"i? | "NVARCHAR"i
	  | "BINARY"i & "VARYING"i? | "VARBINARY"i | "VECTOR"i) & TSqlLength?
	| ("NUMERIC"i | "DECIMAL"i | "DEC"i)
	  & ('(' & Sql92.Lexical.Digits & (',' & Sql92.Lexical.Digits)? & ')')?
	| "FLOAT"i & ('(' & Sql92.Lexical.Digits & ')')?
	| ("DATETIME2"i | "DATETIMEOFFSET"i | "TIME"i | "TIMESTAMP"i)
	  & ('(' & Sql92.Lexical.Digits & ')')? & ("WITH"i & "TIME"i & "ZONE"i)?
	| "INTEGER"i | "INT"i | "SMALLINT"i | "TINYINT"i | "BIGINT"i | "BIT"i
	| "REAL"i | "DOUBLE"i & "PRECISION"i | "MONEY"i | "SMALLMONEY"i
	| "DATE"i | "DATETIME"i | "SMALLDATETIME"i
	| "TEXT"i | "NTEXT"i | "IMAGE"i | "JSON"i
	| "XML"i & ('(' & XmlContent? & QualifiedName & ')')?
	| "UNIQUEIDENTIFIER"i | "SQL_VARIANT"i | "ROWVERSION"i | "SYSNAME"i
	| "GEOGRAPHY"i | "GEOMETRY"i | "HIERARCHYID"i
	| "INTERVAL"i & IntervalQualifier
	| QualifiedName & TSqlLength?

TSqlLength = '(' & (Sql92.Lexical.Digits | "MAX"i) & ')'

XmlContent = "CONTENT"i | "DOCUMENT"i

// ── §8's predicate, widened ─────────────────────────────────────────────────
//
// Two things T-SQL has that the standard does not. `IS [NOT] DISTINCT FROM` compares
// two rows treating null as a value, and it stands after the standard's tail rather
// than inside it: `IS NOT NULL` and `IS NOT DISTINCT FROM` share three words, and the
// tail is the rule that reads the first of them.
//
// And a handful of functions that yield a truth rather than a value. A call cannot
// stand where a condition does in general — `WHERE f(x)` is not T-SQL either — so
// they are named, exactly as §6.16's functions are named on the value side.
// ── The full-text predicates ────────────────────────────────────────────────
//
// `CONTAINS` and `FREETEXT`, put to the engine some ninety times. What is searched is a
// column, `*`, a table's `t.*`, `PROPERTY (column, 'name')`, or a bracketed list of columns;
// a list holds names only, and `*` and `t.*` stand alone, bracketed or not. What is searched
// for is a string or a variable, nothing computed, and a language is `LANGUAGE` and a whole
// number, a hex number, a string or a variable. The tree is the call it was, its arguments
// written with the nodes the rowset functions use for the same things.
FullTextPredicate : @Expression
	= name: FullTextName & '(' & c: FullTextColumns & ',' & s: FullTextSearch & l: SearchLanguage? & ')'
		=> @(new Expression.RoutineInvocation(name, l is null ? new[] { c, s } : new[] { c, s, l }))

FullTextName = "CONTAINS"i | "FREETEXT"i

FullTextColumns : @Expression
	= a: FullTextAll => @(a)
	| ?=("PROPERTY"i & '(' & QualifiedName & ',' & Quoted & ')') & p: ValueExpression => @(p)
	| '(' & a: FullTextAll & ')' => @(new Expression.RowValueConstructor(new[] { a }))
	| '(' & first: SearchedColumn & (',' & rest: SearchedColumn)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| c: SearchedColumn => @(c)

// Every column, or every column of one table.
FullTextAll : @Expression
	= '*' => @(new Expression.ColumnReference("*"))
	| t: (QualifiedName & '.' & '*') => @(new Expression.ColumnReference(t))

SearchedColumn : @Expression = t: QualifiedName => @(new Expression.ColumnReference(t))

FullTextSearch : @Expression = ?=((Quoted | TSql.Variable) & (',' | ')')) & s: ValueExpression => @(s)

SearchLanguage : @Expression
	= ',' & w: "LANGUAGE"i & ?=((Sql92.Lexical.Digits | TSql.BinaryLiteral | Quoted | TSql.Variable) & (',' | ')'))
	  & v: ValueExpression
		=> @(new Expression.Prefixed(w, v))

TSqlPredicate : @Expression
	= "EXISTS"i & q: TableSubquery => @(new Expression.Exists(q))
	| "UNIQUE"i & q: TableSubquery => @(new Expression.Unique(q))
	| f: FullTextPredicate => @(f)
	| name: ("TSEQUAL"i | "REGEXP_LIKE"i | "UPDATE"i)
	  & '(' & args: Arguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))
	| m: GraphMatch => @(m)
	| row: RowValueConstructor & tail: PredicateTail => @(Expression.Predicated(row, tail))
	| left: RowValueConstructor & "IS"i & negated: "NOT"i? & "DISTINCT"i & "FROM"i
	  & other: DistinctTail
		=> @(new Expression.IsDistinctFrom(left, negated is not null, other))

DistinctTail : @Expression
	= q: Quantifier & sub: TableSubquery => @(new Expression.Prefixed(Syntax.Squared(q), new Expression.Subquery(sub)))
	| right: RowValueConstructor         => @(right)

// ── §7.9's query specification, widened ─────────────────────────────────────
//
// What may be left out and what may be added. T-SQL's `FROM` is optional — `SELECT 1`
// is a query — `TOP` stands between the quantifier and the select list, `INTO` names a
// table the rows are written to rather than returned from, and a `WINDOW` clause at the
// end declares the windows the select list named. The count and the windows are kept, as
// the standard's collate clause is: they say how many rows come back and how a call sees
// them rather than what the rows are, and a statement printed without them is not the
// statement that came in.
TSqlQuerySpecification : @Query
	= "SELECT"i & quantifier: SetQuantifier? & top: Top? & columns: SelectList & into: Into?
	  & when @(into is not null || !Syntax.HasIdentity(columns))
	  & from: FromClause? & where: WhereClause? & group: GroupByClause? & having: HavingClause?
	  & windows: Window?
		=> @(new Query.Specification(
				 Syntax.Distinctly(quantifier), top, columns, into,
				 from ?? TableReference.None, where, group, having, windows))

// Written as alternatives of a rule rather than one sequence with a choice inside it,
// for the reason `CallTail` gives.
//
// The brackets of `TOP` may be a subquery's own: `TOP (SELECT * FROM t2) PERCENT` and `TOP
// ((SELECT …) EXCEPT (SELECT …))` are read, and kept as the subquery they are, so that the
// bracket is written once. A `WITH` or a `VALUES` there is refused.
Top : @Clause.Top
	= "TOP"i & ?!('(' & "VALUES"i) & q: Subquery & suffix: TopSuffix?
		=> @(Clause.Topped(new Expression.Subquery(q), suffix))
	| "TOP"i & '(' & v: ValueExpression & ')' & suffix: TopSuffix?
		=> @(Clause.Topped(new Expression.Parenthesized(v), suffix))
	| "TOP"i & t: Sql92.Lexical.UnsignedNumericLiteral & suffix: TopSuffix?
		=> @(Clause.Topped(new Expression.Literal(SqlLiteralKind.Number, t), suffix))

// Read as the words they are and taken apart in C#: two questions and a rule, and asking
// them here would be three captures where one run of words says it.
TopSuffix : @string = t: ("PERCENT"i & TopWith? | TopWith) => @(t)
TopWith   = "WITH"i & "TIES"i | "WITH"i & "APPROXIMATE"i | "WITH"i & "APPROX"i

// §7.9 has nowhere to put this: the rows go into a table instead of coming back, and
// the filegroup says where that table's pages live.
Into : @Clause
	= "INTO"i & name: QualifiedName & ("ON"i & on: Identifier)?
		=> @(new Clause.Into(name, on))

// The windows a call may name instead of writing out: each a name and the window it
// stands for, in the shape `OVER (…)` has inside its brackets.
Window : @Clause[]
	= "WINDOW"i & first: WindowDef & (',' & rest: WindowDef)* & when Version is Since160 => @(Syntax.Listed(first, rest))

WindowDef : @Clause
	= name: Identifier & "AS"i & '(' & w: WindowSpecification & ')' => @(new Clause.WindowDefinition(name, w))

// ── §7.9's select list, widened ─────────────────────────────────────────────
//
// §7.9 makes a bare `*` the whole list; T-SQL makes it an item, which may stand anywhere
// in the list and more than once: `SELECT 1, *, 2` and `SELECT *, t.*, *` are read. It is
// not named, not bracketed and not assigned — `* AS x`, `(*)` and `x = *` are refused.
TSqlSelectList : @Clause[]
	= first: SelectSublist & (',' & rest: SelectSublist)* => @(Syntax.Listed(first, rest))

// Two things stand where a value does. A variable takes the value rather than the query
// returning it — `SELECT @a += 1` is an assignment written as a query — and an alias may
// be written in front with `=` rather than behind with `AS`. And an alias may be a
// string, which the standard does not allow and every dialect does.
TSqlSelectSublist : @Clause
	= '*'                                          => @(new Clause.QualifiedAsterisk(null))
	| qualifier: QualifiedName & '.' & '*'        => @(new Clause.QualifiedAsterisk(qualifier))
	| into: TSql.Variable & by: AssignOp & v: ValueExpression
		=> @(new Clause.VariableAssignment(into, by, v))
	| label: TSqlAlias & '=' & v: IdentityFunction => @(new Clause.DerivedColumn(v, label))
	| v: IdentityFunction & alias: TSqlAsClause    => @(new Clause.DerivedColumn(v, alias))
	| label: TSqlAlias & '=' & v: ValueExpression  => @(new Clause.DerivedColumn(v, label))
	| v: ValueExpression & alias: TSqlAsClause?    => @(new Clause.DerivedColumn(v, alias))

// T-SQL's `IDENTITY` function, which gives the table a `SELECT … INTO` makes an identity
// column: a type, and a seed and a step, numbers with a sign or without — `@a`, `1 + 1`,
// `(1)` and `0x1` are refused. A whole item of the list and never part of a value, and always
// named: `IDENTITY(INT, 1, 1) + 1` and `IDENTITY(INT, 1, 1)` alone are refused. Only with an
// `INTO`, which the engine says when the statement is compiled (`Msg 177`) and a guard on the
// query says here.
IdentityFunction : @Expression
	= name: "IDENTITY"i & '(' & type: DataType & (',' & seed: IdentityNumber & ',' & step: IdentityNumber)? & ')'
		=> @(new Expression.RoutineInvocation(name, seed is null ? Expression.None : new Expression[] { seed, step! }, type))

IdentityNumber : @Expression
	= t: (['+' | '-']? & Sql92.Lexical.UnsignedNumericLiteral)
		=> @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))

AssignOp : @string = t: ('=' | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "||=") => @(t)

TSqlAlias    : @string
	= t: Identifier                                  => @(t)
	| t: Sql92.Lexical.CharacterStringLiteral         => @(t)
	| t: Sql92.Lexical.NationalCharacterStringLiteral => @(t)
TSqlAsClause : @string = "AS"i & t: TSqlAlias => @(t) | t: TSqlAlias => @(t)

// ── §7.7's group by, widened ────────────────────────────────────────────────
//
// Written from the published `GROUP BY` syntax rather than from what the corpus
// happened to contain, which is what caught the nesting: a `ROLLUP` or a `CUBE` takes
// group-by expressions and not grouping sets, and only a `GROUPING SETS` list may hold
// another `ROLLUP` or `CUBE`. The two spellings are separate rules here because the
// specification makes them separate — `GROUP BY GROUPING SETS (GROUPING SETS (a))` is
// legal SQL-2006 and is refused by T-SQL, and refusing it is the point.
//
// And the older spelling beside the ISO one: `WITH CUBE` and `WITH ROLLUP` say after
// the list what `CUBE (…)` and `ROLLUP (…)` say in front of it.
TSqlGroupByClause : @Clause
	= "GROUP"i & "BY"i & "ALL"i & first: TSqlGrouping & (',' & rest: TSqlGrouping)*
		=> @(new Clause.GroupBy(true, Syntax.Listed(first, rest), null))
	| "GROUP"i & "BY"i & first: TSqlGrouping & (',' & rest: TSqlGrouping)* & with: GroupWith?
		=> @(new Clause.GroupBy(false, Syntax.Listed(first, rest), with))

GroupWith : @string = "WITH"i & t: ("CUBE"i | "ROLLUP"i) => @(t)
					| "WITH"i & '(' & t: Identifier & ')' => @(t)

TSqlGrouping : @Expression
	= "CUBE"i     & g: GroupList => @(new Expression.RoutineInvocation("CUBE",   g))
	| "ROLLUP"i   & g: GroupList => @(new Expression.RoutineInvocation("ROLLUP", g))
	| "GROUPING"i & "SETS"i & '(' & first: GroupingSet & (',' & rest: GroupingSet)* & ')'
		=> @(new Expression.RoutineInvocation("GROUPING SETS", Syntax.Listed(first, rest)))
	| e: GroupByExpression => @(e)

GroupList : @Expression[]
	= '(' & first: GroupByExpression & (',' & rest: GroupByExpression)* & ')'
		=> @(Syntax.Listed(first, rest))

// A column, or a list of them standing as one — and the empty list, which is the grand
// total and the one grouping that names nothing.
GroupByExpression : @Expression
	= '(' & ')' => @(new Expression.RowValueConstructor(Expression.None))
	| '(' & first: TSqlGroupingColumn & (',' & rest: TSqlGroupingColumn)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| c: TSqlGroupingColumn => @(c)

TSqlGroupingColumn : @Expression
	= c: ValueExpression & collation: Collate? & hint: ("WITH"i & '(' & Identifier & ')')?
		=> @(Syntax.Grouped(c, collation, hint))

// One entry of a `GROUPING SETS` list: a cube, a rollup, a list of those, or a plain
// group-by expression. A grouping set inside a grouping set is not here, deliberately.
GroupingSet : @Expression
	= "CUBE"i   & g: GroupList => @(new Expression.RoutineInvocation("CUBE",   g))
	| "ROLLUP"i & g: GroupList => @(new Expression.RoutineInvocation("ROLLUP", g))
	| '(' & first: GroupingSetItem & (',' & rest: GroupingSetItem)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| e: GroupByExpression => @(e)

GroupingSetItem : @Expression
	= "CUBE"i   & g: GroupList => @(new Expression.RoutineInvocation("CUBE",   g))
	| "ROLLUP"i & g: GroupList => @(new Expression.RoutineInvocation("ROLLUP", g))
	| e: GroupByExpression => @(e)

// ── §7.5's joined table, widened ────────────────────────────────────────────
//
// **T-SQL has neither `NATURAL JOIN` nor `USING`, and a qualified join must say `ON`.**
// The published `<joined_table>` is three forms and no more: a join with a condition, a
// cross join, and an apply. The dialect read all three of the standard's extra spellings
// until this was written from the syntax rather than from what the corpus contained —
// which is over-acceptance, the half of correctness a refusal count cannot see.
//
// `APPLY` is a join whose right side is read once per row of its left, which is a
// question about evaluation and not about shape — so the tree says `CROSS JOIN` and the
// word is not kept. A join hint says which algorithm to use and is kept for the same
// reason `OPTION` is; the syntax puts it inside the join type, so a hint without a type
// is not a join.
TSqlTableReference : @TableReference
	= left: TSqlTableReference & "CROSS"i & "JOIN"i & right: TablePrimary
		=> @(new TableReference.Joined(SqlJoin.Cross, false, false, left, right))
	| left: TSqlTableReference & "CROSS"i & "APPLY"i & right: TablePrimary
		=> @(new TableReference.Joined(SqlJoin.CrossApply, false, false, left, right))
	| left: TSqlTableReference & "OUTER"i & "APPLY"i & right: TablePrimary
		=> @(new TableReference.Joined(SqlJoin.OuterApply, false, false, left, right))
	| left: TSqlTableReference & kind: TSqlJoinType? & hint: JoinHint? & "JOIN"i & right: TablePrimary
	  & "ON"i & on: SearchCondition
		=> @(TableReference.Joining(kind, null, left, right, on, null, hint))
	| t: TablePrimary => @(t)

TSqlJoinType : @string = t: JoinType => @(t)

JoinHint : @string
	= t: ("HASH"i | "LOOP"i | "MERGE"i | "REMOTE"i | "REDUCE"i | "REPLICATE"i | "REDISTRIBUTE"i) => @(Syntax.Squared(t))

// ── §7.4's table primary, widened ───────────────────────────────────────────
//
// The published order, which is not the order the examples suggested: a temporal clause
// stands before the correlation name, and a sample before the hints. Writing the hints
// first was accepted here until the syntax said otherwise, and whether ScriptDom accepts
// them the other way round is a question worth asking of it rather than of us.
TSqlTablePrimary : @TableReference
	= f: JsonFunction & schema: JsonSchema?
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
	  & pivot: PivotSuffix?
		=> @(Syntax.Pivoted(
				 new TableReference.FunctionCall(f, alias, columns, schema ?? Clause.None), pivot))
	| f: PredictCall & schema: PredictSchema & ("AS"i? & alias: CorrelationName)?
		=> @(new TableReference.FunctionCall(f, alias, null, schema))
	| f: RowsetFunction & schema: RowsetSchema? & when @(Syntax.Schemas(f, schema))
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
	  & pivot: PivotSuffix?
		=> @(Syntax.Pivoted(
				 new TableReference.FunctionCall(f, alias, columns, schema ?? Clause.None), pivot))
	| server: AdHocServer & named: AdHocObject & ("AS"i? & alias: CorrelationName)? & pivot: PivotSuffix?
		=> @(Syntax.Pivoted(new TableReference.Named(named, null, false, alias, null, null, Clause.None, server), pivot))
	// A table takes hints and a table-valued function does not: `dbo.f() WITH (NOLOCK)` is
	// refused.
	| name: QualifiedName & version: SystemTime? & path: GraphPath? & call: ('(' & args: Arguments? & ')')?
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
	  & sample: TableSample? & hints: TableHints? & when @(call is null || (hints is null && path is null))
	  & pivot: PivotSuffix?
		=> @(Syntax.Sourced(name, version, path is not null, call, args, alias, columns, sample, hints, pivot))
	| t: TSql.Variable & s: VariableSource => @(Syntax.OfVariable(t, s))
	| derived: TableSubquery & path: GraphPath? & "AS"i? & alias: CorrelationName
	  & ('(' & columns: ColumnList & ')')? & pivot: PivotSuffix?
		=> @(Syntax.Pivoted(new TableReference.Derived(derived, path is not null, alias, columns), pivot))
	| '(' & j: TableReference & ')' & TableSample? & TableHints?
		=> @(new TableReference.Parenthesized(j))
	| '{' & "OJ"i & j: TableReference & '}' => @(new TableReference.OdbcJoin(j))

// What a variable may be as a table: the table variable itself, or a table-valued method
// on a variable of a user-defined type — `FROM @v.f(1) AS t(c)`. Left-factored because
// both begin with the variable, which is what GRAM4016 asks for.
VariableSource : @TableReference
	= '.' & method: Identifier & '(' & args: Arguments? & ')'
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
		=> @(new TableReference.FunctionCall(
				 new Expression.RoutineInvocation("." + method, args ?? Expression.None),
				 alias, columns, Clause.None))
	| ("AS"i? & alias: CorrelationName)? & sample: TableSample? & hints: TableHints?
		=> @(new TableReference.Named("", null, false, alias, null, sample, hints ?? Clause.None))

// The published syntax makes a pivoted table a source of its own — `table_source PIVOT
// (…) [AS] alias` — which is left recursion, and §4.3 folds that only where the rule
// recurses on itself. So it is written as what follows a primary instead, which reads
// the same language wherever a pivot is applied to one source rather than to a join.
//
// The alias is required and not optional, which the syntax says and the examples did
// not: `PIVOT (…)` with nothing after it is not a table source.
// Built with the source it is applied to left null, the way a predicate tail is: the
// source is read once and the pivot is what may follow it.
PivotSuffix : @TableReference = p: Pivot => @(p) | u: Unpivot => @(u)

Pivot : @TableReference
	= "PIVOT"i & '(' & aggregate: ValueExpression & "FOR"i & column: QualifiedName
	  & "IN"i & '(' & names: PivotNames & ')' & ')' & "AS"i? & alias: CorrelationName
		=> @(new TableReference.Pivot(null!, aggregate, column, names, alias))

Unpivot : @TableReference
	= "UNPIVOT"i & '(' & value: QualifiedName & "FOR"i & column: QualifiedName
	  & "IN"i & '(' & names: PivotNames & ')' & ')' & "AS"i? & alias: CorrelationName
		=> @(new TableReference.Unpivot(null!, value, column, names, alias))

PivotNames : @string[]
	= first: PivotName & (',' & rest: PivotName)* => @(Syntax.Named(first, rest))

PivotName : @string = t: QualifiedName => @(t)

// A graph's table read as a path: a mark on the source, which a `SHORTEST_PATH` needs on
// every alias it repeats (`Msg 13948`). No page gives it a syntax; the engine takes it
// after a table's version and before its alias, and after a query or `VALUES` in brackets,
// and refuses it on a function, a variable and a rowset.
GraphPath = "FOR"i & "PATH"i

// Which version of a temporal table to read. `FOR` is reserved, so nothing here can be
// mistaken for the correlation name it stands in front of.
SystemTime : @Clause
	= "FOR"i & "SYSTEM_TIME"i & w: SystemTimeWhen => @(w)

SystemTimeWhen : @Clause
	= "AS"i & "OF"i & v: ValueExpression
		=> @(new Clause.SystemTime("AS OF", new Expression[] { v }))
	| "FROM"i & from: ValueExpression & "TO"i & to: ValueExpression
		=> @(new Clause.SystemTime("FROM", new Expression[] { from, to }))
	| "BETWEEN"i & from: ValueExpression & "AND"i & to: ValueExpression
		=> @(new Clause.SystemTime("BETWEEN", new Expression[] { from, to }))
	| "CONTAINED"i & "IN"i & '(' & from: ValueExpression & ',' & to: ValueExpression & ')'
		=> @(new Clause.SystemTime("CONTAINED IN", new Expression[] { from, to }))
	| "ALL"i => @(new Clause.SystemTime("ALL", Expression.None))

// A correlation name is an identifier, and not one of the words that begin a clause of
// its own after a source. None of them is reserved — a column may be called `WINDOW` —
// but a name is what stands *after* a source, and `FROM t PIVOT (…)` has no name in it.
// Without the lookahead the pivot became the correlation and the parse stopped one token
// later, saying nothing about why.
//
// `USING` joined them when `MERGE` was written, and it is the fourth word to do so. The
// shape is always the same: a word that begins a clause, an optional name in the same
// position, and the name winning. Anything added after a source belongs on this list.
CorrelationName = ?!SourceClause & Identifier
SourceClause    = "WINDOW"i | "PIVOT"i | "UNPIVOT"i | "TABLESAMPLE"i | "USING"i

// **Transcribed from `TSql170.g`'s own `tableHint` and `optimizerHints`, and that makes
// these two rules weaker evidence than the rest of this file.** A rule written from the
// other parser's grammar cannot disagree with the other parser: the comparison stops
// being a comparison and becomes a check that the transcription was faithful. Everywhere
// else here the source is the published syntax, so a difference is a finding — a bug on
// one side or the other — and that is the whole point of measuring against ScriptDom at
// all. These two are marked because they are the exception.
//
// What the shape says, and a list of hint names would not: `HOLDLOCK`, `INDEX`, `MERGE`,
// A hint's name is a word and nothing else: `NOLOCK`, `FORCESEEK`, `RECOMPILE`, `MAXDOP`
// are ordinary ones and `ORDER`, `GROUP`, `PLAN`, `TABLE` are words T-SQL reserves, and
// inside these brackets nothing tells them apart. So the rule says `word` (§4.6) and is
// about the shape of a hint list rather than about which hints exist — the ones written
// out are the ones that take an argument of their own.
//
// All of it is kept, one `Clause.Hint` per hint holding the text as written: a hint says
// how the rows are to be fetched and never which rows they are, which is a good reason to
// leave it out of a tree and no reason at all to lose it.
// ── Hints ───────────────────────────────────────────────────────────────────
//
// Table, query and join hints, from the published blocks and some hundred and sixty probes.
// Each list is closed: a table hint the engine does not know is its 321, a query hint its
// 102. The table hints are the block's two lists as one, since the engine reads the
// limited ones (`KEEPIDENTITY`, `IGNORE_TRIGGERS`) in a `FROM` as well, and objects only
// afterwards to a hint a target may not carry (1065, 1069, 10724). The comma between table
// hints may be left out, as the block's `[ , ]` says, but not doubled.
TableHints : @Clause[]
	= "WITH"i & '(' & first: TableHint & (','? & rest: TableHint)* & ')'
		=> @(Syntax.Listed(first, rest))

TableHint : @Clause = t: TableHintSyntax => @(new Clause.Hint(t))

// `FORCESEEK (i)` without its columns is refused, and so are `INDEX = (i)` — which the block
// lists — and a variable for the spatial cells. `FORCE_ANN_ONLY` is not known to this
// engine, 17.0.1125, and `FASTFIRSTROW` has been removed.
TableHintSyntax
	= "NOEXPAND"i
	| "INDEX"i & IndexArgument
	| "FORCESEEK"i & ('(' & IndexValue & '(' & ColumnList & ')' & ')')?
	| "SPATIAL_WINDOW_MAX_CELLS"i & '=' & Sql92.Lexical.Digits
	| "FORCESCAN"i | "HOLDLOCK"i | "NOLOCK"i | "NOWAIT"i | "PAGLOCK"i
	| "READCOMMITTED"i | "READCOMMITTEDLOCK"i | "READPAST"i | "READUNCOMMITTED"i
	| "REPEATABLEREAD"i | "ROWLOCK"i | "SERIALIZABLE"i | "SNAPSHOT"i
	| "TABLOCK"i | "TABLOCKX"i | "UPDLOCK"i | "XLOCK"i
	| "KEEPIDENTITY"i | "KEEPDEFAULTS"i | "IGNORE_CONSTRAINTS"i | "IGNORE_TRIGGERS"i

IndexArgument
	= '=' & IndexValue
	| '(' & IndexValue & (',' & IndexValue)* & ')'

IndexValue = Identifier | Sql92.Lexical.UnsignedNumericLiteral

QueryHints : @Clause[]
	= "OPTION"i & '(' & first: QueryHint & (',' & rest: QueryHint)* & ')'
		=> @(Syntax.Listed(first, rest))

// Kept as the words it was written as, which is what a hint is: see `Clause.Hint`.
QueryHint : @Clause = t: QueryHintSyntax => @(new Clause.Hint(t))

// Whole numbers where the block says an integer — `FAST 1.5` and `MAXDOP = 2` are refused —
// and a fraction for a grant. `PARAMETERIZATION` is a plan guide's and not a query's, the
// external pushdown is not known to this engine, and neither is
// `DISABLE_OPTIMIZED_PLAN_FORCING`; `LABEL`, which is Synapse's, it reads. In `TABLE HINT`
// the comma after the table is not optional, where the ones between its hints are.
QueryHintSyntax
	= ("HASH"i | "ORDER"i) & "GROUP"i
	| ("CONCAT"i | "HASH"i | "MERGE"i) & "UNION"i
	| ("LOOP"i | "MERGE"i | "HASH"i) & "JOIN"i
	| "EXPAND"i & "VIEWS"i
	| "FORCE"i & "ORDER"i
	| ("FORCE"i | "DISABLE"i) & "SCALEOUTEXECUTION"i
	| "IGNORE_NONCLUSTERED_COLUMNSTORE_INDEX"i
	| ("KEEP"i | "KEEPFIXED"i | "ROBUST"i) & "PLAN"i
	| ("FAST"i | "MAXDOP"i | "MAXRECURSION"i | "QUERYTRACEON"i) & Sql92.Lexical.Digits
	| ("MAX_GRANT_PERCENT"i | "MIN_GRANT_PERCENT"i) & '=' & Sql92.Lexical.ExactNumericLiteral
	| "NO_PERFORMANCE_SPOOL"i
	| "OPTIMIZE"i & "FOR"i & (OptimizeFor | "UNKNOWN"i)
	| "RECOMPILE"i
	| "USE"i & "HINT"i & '(' & HintString & (',' & HintString)* & ')'
	| "USE"i & "PLAN"i & HintString
	| "TABLE"i & "HINT"i & '(' & QualifiedName
	  & (',' & TableHintSyntax & (','? & TableHintSyntax)*)? & ')'
	| "LABEL"i & '=' & HintString

	// Five the block does not name and the engine reads, all from the corpus of SQL Server
	// 2005's days; two more from the same file, `OPTIMIZE CORRELATED UNION ALL` and `BYPASS
	// OPTIMIZER_QUEUE`, it refuses.
	| ("CHECKCONSTRAINTS"i | "SHRINKDB"i | "ALTERCOLUMN"i) & "PLAN"i
	| "USEPLAN"i & Sql92.Lexical.Digits
	| "KEEP"i & "UNION"i

OptimizeFor
	= '(' & VariableValue & (',' & VariableValue)* & ')'
	| Identifier

HintString = Sql92.Lexical.NationalCharacterStringLiteral | Sql92.Lexical.CharacterStringLiteral

// `OPTIMIZE FOR (@a)` — a variable with neither a value nor `UNKNOWN` — is read too.
VariableValue = TSql.Variable & VariableValueTail?

VariableValueTail = '=' & HintValue | "UNKNOWN"i

HintValue = "NULL"i | ValueExpression

// §7.4's table sample: how much of a source to read, in rows or in per cent, and the
// seed that makes the choice repeatable. Kept for the same reason a hint is.
TableSample : @Clause
	= "TABLESAMPLE"i & system: "SYSTEM"i?
	  & '(' & v: ValueExpression & unit: SampleUnit? & ')' & seed: TableRepeatable?
		=> @(new Clause.TableSample(system is not null, v, unit, seed))

SampleUnit      : @string     = t: ("PERCENT"i | "ROWS"i) => @(t)
TableRepeatable : @Expression = "REPEATABLE"i & '(' & v: ValueExpression & ')' => @(v)

// ── §7.13's subquery, widened ───────────────────────────────────────────────
//
// A query in brackets may carry an order and a shape of its own — `(SELECT TOP 1 a FROM t
// ORDER BY a)`, `(SELECT … ORDER BY 1 OFFSET 1 ROWS)`, `(SELECT … FOR XML PATH)` — as a
// value, under `IN` and `EXISTS`, as a derived table, after `APPLY` and in a `TOP`; kept as
// a `Query.Ordered`. An `ORDER BY` without a `TOP` or an `OFFSET` the engine reads and then
// refuses (`Msg 1033`); an `OPTION` there it refuses as syntax, since that is a statement's.
TSqlSubquery : @Query
	= '(' & q: QueryExpression & by: OrderByClause? & window: OffsetFetch? & shape: ForClause? & ')'
		=> @(Syntax.Ordered(q, Clause.Ordered(by, window), shape))

// §7.3's table value constructor, narrowed: T-SQL writes every row in brackets — `VALUES 1,
// 2` is refused — and the brackets hold values and never a query: `VALUES (SELECT a FROM u)`
// is refused, and `VALUES ((SELECT a FROM u))` read. A row of one is `(DEFAULT)` as readily
// as `(1)`, which the standard's rule, reading a row of one without its brackets, refused.
TSqlTableValueConstructor : @Query
	= "VALUES"i & first: TSqlRow & (',' & rest: TSqlRow)*
		=> @(new Query.TableValueConstructor(Syntax.Listed(first, rest)))

TSqlRow : @Expression
	= '(' & first: RowValueConstructorElement & (',' & rest: RowValueConstructorElement)* & ')'
		=> @(rest is { Length: > 0 }
				 ? new Expression.RowValueConstructor(Syntax.Listed(first, rest))
				 : new Expression.Parenthesized(first))

// ── §13.1's direct select, widened ──────────────────────────────────────────
//
// Where the clauses that belong to the statement rather than to the query go: how many
// rows to skip and take, what shape to return them in, and how to run the whole thing.
TSqlDirectSelect : @Statement
	= with: WithClause? & q: QueryExpression & by: OrderByClause? & window: OffsetFetch?
	  & shape: ForClause? & options: QueryHints?
		=> @(new Statement.Select(
				 with ?? Clause.None, q, Clause.Ordered(by, window),
				 shape is null ? Clause.None : new Clause[] { shape },
				 options ?? Clause.None))

// §7's `WITH <common_table_expression>`: a query given a name in front of the statement
// that uses it. Kept as one clause per definition — `Clause.CommonTableExpression`, name,
// columns and query — which is the place the tree once had none for.
//
// The definition is a query expression and not a whole statement: the syntax forbids a
// `WITH` inside a `WITH`, and writing it that way is how the grammar says so.
WithClause : @Clause[]
	= "WITH"i & t: ChangeTrackingContext & (',' & rest: CteDefinition)*
		=> @(Syntax.Listed<Clause>(new Clause.Option(t, null, Clause.None), rest))
	| "WITH"i & t: XmlNamespaces & (',' & rest: CteDefinition)*
		=> @(Syntax.Listed<Clause>(new Clause.Option(t, null, Clause.None), rest))
	| "WITH"i & first: CteDefinition & (',' & rest: CteDefinition)*
		=> @(Syntax.Listed<Clause>(first, rest))

// The namespaces a `FOR XML` may use, declared where a named query is declared and in
// the same breath as one.
ChangeTrackingContext : @string
	= t: ("CHANGE_TRACKING_CONTEXT"i & '(' & ValueExpression & ')') => @(t)

XmlNamespaces : @string
	= t: ("XMLNAMESPACES"i & '(' & XmlNamespace & (',' & XmlNamespace)* & ')') => @(t)
XmlNamespace  = "DEFAULT"i & ValueExpression
			  | ValueExpression & "AS"i & Identifier
CteDefinition : @Clause.CommonTableExpression
	= name: Identifier & ('(' & columns: ColumnList & ')')? & "AS"i & '(' & q: CteBody & ')'
		=> @(new Clause.CommonTableExpression(name, columns, q))

// §13.1 sorts by a column or by its position in the select list; T-SQL sorts by any value —
// `ORDER BY a + 1`, `LEN(a)`, a `CASE`, a subquery — and a position is a number among them.
// A collation is the value's own, as a primary's is.
TSqlSortKey : @Expression = v: ValueExpression => @(v)

// The order a named query is written in is kept, as a `Query.Ordered`: a `WITH` defines a
// table, and a table has no order until something asks for one, but the order was written
// and a statement printed without it is not the one that came in.
CteBody : @Query
	= q: QueryExpression & by: OrderByClause? & window: OffsetFetch?
		=> @(Syntax.Ordered(q, Clause.Ordered(by, window), null))

// `FETCH` without `OFFSET` in front of it is not a clause: the engine answers
// `Incorrect syntax`, though ScriptDom reads it. The corpus statement that asked for it was
// wrong to, and reading it was over-acceptance rather than coverage.
// Published as two clauses inside `ORDER BY` and read here as one, since neither may be
// written without the sort. What comes out is the order clause with an empty list, and
// whoever read the list fills it in — `Clause.Ordered` is where the two meet.
OffsetFetch : @Clause.OrderBy
	= "OFFSET"i & skip: ValueExpression & RowWord & take: FetchClause?
		=> @(new Clause.OrderBy(Clause.None, skip, take))

FetchClause : @Expression
	= "FETCH"i & "APPROXIMATE"i & FetchAt & v: ValueExpression & RowWord & "ONLY"i => @(v)
	| "FETCH"i & FetchAt & v: ValueExpression & RowWord & "ONLY"i                  => @(v)

FetchAt = "NEXT"i | "FIRST"i
RowWord = "ROWS"i | "ROW"i

// ── The shape the rows come back in ─────────────────────────────────────────
//
// `FOR XML`, `FOR JSON` and `FOR BROWSE`, put to the engine some seventy times, and the
// cursor's `FOR UPDATE` and `FOR READ ONLY`, which a plain `SELECT` takes as well. XML has four
// modes, each with an element name in a string, which the engine reads for all four and
// objects to for two (6859); then one list of directives for every mode, in any order — the
// block gives each mode its own list and an order, and the engine reads `EXPLICIT, ELEMENTS`
// and the whole list backwards. JSON has two modes and no name, and three options of its own;
// neither takes the other's. A directive said twice, and `XMLDATA` with `XMLSCHEMA`, the
// engine refuses as it reads; that is the walker's, as a repeat is everywhere.
ForClause : @Clause
	= "FOR"i & "BROWSE"i => @(new Clause.For("BROWSE", Syntax.NoNames))
	| "FOR"i & kind: ForXml & first: XmlMode & (',' & rest: XmlDirective)*
		=> @(new Clause.For(kind, Syntax.Named(first, rest)))
	| "FOR"i & kind: ForJson & first: JsonMode & (',' & rest: JsonDirective)*
		=> @(new Clause.For(kind, Syntax.Named(first, rest)))
	| "FOR"i & "UPDATE"i & "OF"i & columns: ColumnList => @(new Clause.For("UPDATE OF", columns))
	| "FOR"i & "UPDATE"i => @(new Clause.For("UPDATE", Syntax.NoNames))
	| "FOR"i & "READ"i & "ONLY"i => @(new Clause.For("READ ONLY", Syntax.NoNames))

ForXml  = "XML"i
ForJson = "JSON"i

XmlMode : @string = t: (("RAW"i | "AUTO"i | "EXPLICIT"i | "PATH"i) & ForName?) => @(t)

XmlDirective : @string
	= t: ("BINARY"i & "BASE64"i | "TYPE"i | "ROOT"i & ForName? | "XMLDATA"i | "XMLSCHEMA"i & ForName?
		  | "ELEMENTS"i & ("XSINIL"i | "ABSENT"i)?) => @(t)

JsonMode : @string = t: ("AUTO"i | "PATH"i) => @(t)

JsonDirective : @string = t: ("ROOT"i & ForName? | "INCLUDE_NULL_VALUES"i | "WITHOUT_ARRAY_WRAPPER"i) => @(t)

// An element, a root or a namespace: a string, never a name.
ForName = '(' & Quoted & ')'

// ── What the dialect is, said once ──────────────────────────────────────────
//
// One header, and every rule reachable from inside it reads T-SQL. The four entry
// points are the standard's own, called through the substitution rather than
// rewritten — which is the whole claim this file makes.
namespace Dialect with (
	Identifier                = TSqlIdentifier,
	GeneralValueSpecification = TSqlValueSpecification,
	ValueExpression           = TSqlValueExpression,
	ValueExpressionPrimary    = TSqlValuePrimary,
	CompOp                    = TSqlCompOp,
	SortKey                   = TSqlSortKey,
	SelectList                = TSqlSelectList,
	Subquery                  = TSqlSubquery,
	TableValueConstructor     = TSqlTableValueConstructor,
	QuerySpecification        = TSqlQuerySpecification,
	TablePrimary              = TSqlTablePrimary,
	TableReference            = TSqlTableReference,
	SelectSublist             = TSqlSelectSublist,
	GroupByClause             = TSqlGroupByClause,
	DirectSelect              = TSqlDirectSelect,
	QualifiedName             = TSqlQualifiedName,
	QueryExpression           = TSqlQueryExpression,
	SimpleWhen                = TSqlSimpleWhen,
	DataType                  = TSqlDataType,
	Predicate                 = TSqlPredicate,
	TrimSpecification         = TSqlTrimSpecification)
{
	Select    : @Statement  = q: Sql92.DirectSelect    => @(q)
	Query     : @Query      = q: Sql92.QueryExpression => @(q)
	Condition : @Expression = c: Sql92.SearchCondition => @(c)
	Value     : @Expression = v: Sql92.ValueExpression => @(v)
	Statement : @Statement = s: TSqlStatement         => @(s)
	Sql       : @Statement[] = s: SqlText             => @(s)
	Script    : @Batch[]     = s: ScriptText          => @(s)
}

parse Dialect.Select    as ParseSelect
parse Dialect.Query     as ParseQuery
parse Dialect.Condition as ParseSearchCondition
parse Dialect.Value     as ParseValueExpression
parse Dialect.Statement as ParseStatement
parse Dialect.Sql       as ParseSql
parse Dialect.Script    as ParseScript

// ── Which level of the language ─────────────────────────────────────────────
//
// SQL Server has one parser, and a database's compatibility level gates a small part of
// what it reads. Measured rather than remembered: `--levels` asks every level from 100 to
// 170 about every statement of the corpus, and 138 of 7,234 are answered differently
// (docs/next.md). Those are the conditions written in this grammar and nothing else is — a
// feature that arrived in a later release and reads at every level, `FOR JSON`, `OFFSET`,
// `IS DISTINCT FROM`, the `json` type, is read by every parser below, as the engine reads it.
//
// `Version` is never called. Only `when Version is …` names it, so each publication's `with`
// makes a reading of this grammar rather than a copy of it, and the parsers share one
// machine (§5.1). `ParseStatement`, which names no level, keeps every one and reads them all.
Version  = "100" | "110" | "120" | "130" | "140" | "150" | "160" | "170"
Since110 = "110" | "120" | "130" | "140" | "150" | "160" | "170"
Since130 = "130" | "140" | "150" | "160" | "170"
Since160 = "160" | "170"
Until100 = "100"
Until120 = "100" | "110" | "120"

parse Dialect.Statement with (Version = "100") as ParseStatement100
parse Dialect.Statement with (Version = "110") as ParseStatement110
parse Dialect.Statement with (Version = "120") as ParseStatement120
parse Dialect.Statement with (Version = "130") as ParseStatement130
parse Dialect.Statement with (Version = "140") as ParseStatement140
parse Dialect.Statement with (Version = "150") as ParseStatement150
parse Dialect.Statement with (Version = "160") as ParseStatement160
parse Dialect.Statement with (Version = "170") as ParseStatement170

parse Dialect.Sql with (Version = "100") as ParseSql100
parse Dialect.Sql with (Version = "110") as ParseSql110
parse Dialect.Sql with (Version = "120") as ParseSql120
parse Dialect.Sql with (Version = "130") as ParseSql130
parse Dialect.Sql with (Version = "140") as ParseSql140
parse Dialect.Sql with (Version = "150") as ParseSql150
parse Dialect.Sql with (Version = "160") as ParseSql160
parse Dialect.Sql with (Version = "170") as ParseSql170

parse Dialect.Script with (Version = "100") as ParseScript100
parse Dialect.Script with (Version = "110") as ParseScript110
parse Dialect.Script with (Version = "120") as ParseScript120
parse Dialect.Script with (Version = "130") as ParseScript130
parse Dialect.Script with (Version = "140") as ParseScript140
parse Dialect.Script with (Version = "150") as ParseScript150
parse Dialect.Script with (Version = "160") as ParseScript160
parse Dialect.Script with (Version = "170") as ParseScript170

// ── The graph pattern, which is a language of its own ───────────────────────
//
// `MATCH` is a predicate whose operand is not an expression at all: it is a drawing.
// Nodes are names, edges are names in parentheses, and an arrow between them says which
// way the edge points — `Person1-(friend)->Person2`. Written from the published `MATCH`
// syntax, and the whole of it is here: the simple pattern, the arbitrary-length one that
// `SHORTEST_PATH` takes, its two quantifiers, and the predicate that compares the last
// node of two paths.
//
// **The arrows are written as two characters and not as one lexeme, deliberately.** A
// `<-` token would be produced everywhere, and `a <-1` — a comparison with a negative
// number — would stop being one. There is no ambiguity to pay for it: a drawing appears
// only inside `MATCH (…)`, so the two characters can be read as two and the only thing
// admitted that nobody writes is a space between them.
GraphMatch : @Expression
	= "MATCH"i & '(' & t: GraphPattern & ')' => @(new Expression.GraphMatch(t))

// `AND` inside a drawing joins two drawings, and it is the only connective there is: the
// syntax says `OR` and `NOT` are not supported in a pattern. It shows a comma as well, and
// a drawing in brackets after `AND`; the engine refuses both, at every level, and so does
// this.
GraphPattern = GraphItem & ("AND"i & GraphItem)*

// A path of any length only inside `SHORTEST_PATH`, one to it; the last nodes of two paths
// compared, and nothing else compared; or a chain of nodes and edges, either end of which
// may be a path's last node.
GraphItem
	= "SHORTEST_PATH"i & '(' & GraphLengthPattern & ')'
	| GraphLastNode & GraphLastTail
	| GraphAlias & GraphChain

GraphLastTail = '=' & GraphLastNode | GraphChain
GraphChain    = (GraphEdge & GraphNode)+

// A node is the alias a table was given in the `FROM` clause, or its name, one part and no
// more: `dbo.N` is refused. `LAST_NODE` names the far end of a path rather than a table.
GraphNode     = GraphLastNode | GraphAlias
GraphLastNode = "LAST_NODE"i & '(' & GraphAlias & ')'
GraphAlias    = Identifier

// An edge points one way or the other and must say which.
GraphEdge
	= '<' & '-' & '(' & GraphAlias & ')' & '-'
	| '-' & '(' & GraphAlias & ')' & '-' & '>'

// The pattern `SHORTEST_PATH` repeats, with the regular expression's own two quantifiers.
// It is written edge first or node first, and the difference is which end the node that
// bounds it stands at. Inside the brackets the nodes are aliases: `LAST_NODE` is refused
// there and read at the end outside them.
GraphLengthPattern
	= GraphNode & '(' & (GraphEdge & GraphAlias)+ & ')' & GraphQuantifier
	| '(' & (GraphAlias & GraphEdge)+ & ')' & GraphQuantifier & GraphNode

// `+`, or at least so many and at most so many, the most left out: `{1,}` is read, and `{3}`
// and `{,3}` are refused.
GraphQuantifier = '+' | '{' & Sql92.Lexical.Digits & ',' & Sql92.Lexical.Digits? & '}'

// ── The rowset functions ────────────────────────────────────────────────────
//
// A dozen small languages rather than one. Each is a name followed by an argument list
// that is not an argument list: `OPENJSON` takes a schema, `OPENROWSET` takes a file and
// a list of options, `CHANGETABLE` takes a word and then a table, and the full-text four
// take a column list where a value would stand.
//
// What they share is the shape around them — a name, parentheses, and a correlation — so
// they are one alternative of the table primary with a rule each inside it.

// `OPENJSON ( json [ , path ] ) [ WITH ( colName type [ path ] [ AS JSON ] , … ) ]`, and
// `OPENXML`'s schema declaration, which is the same shape with a different fourth part: a
// pattern where JSON has a path, and no `AS JSON`, which the engine refuses there. So the
// columns are two rules and the list around them one shape, the JSON one behind the level
// its function reads from.
RowsetSchema : @Clause[]
	= "WITH"i & '(' & first: SchemaColumn & (',' & rest: SchemaColumn)* & ')'
		=> @(Syntax.Listed(first, rest))
	| "WITH"i & name: QualifiedName
		=> @(new Clause[] { new Clause.JsonColumn(name, null, null, false) })

// A collation, which no block names and the engine reads straight after the type and
// nowhere else: a plain name, `[Latin1_General_Bin2]` and a string refused. The node keeps it
// with the type it belongs to, a collation being what a character type is compared by.
// A bulk rowset's column says which column of the file it is, after its type and its
// collation and not before (`Msg 156`): a whole number from one up (`Msg 16204`), no larger
// than an `int`. A pattern is `OPENXML`'s and a number `OPENROWSET`'s, and no column has both
// (`Syntax.Schemas` asks which function it belongs to).
SchemaColumn : @Clause
	= name: Identifier & type: DataType & c: SchemaCollate? & path: SchemaPath? & ordinal: SchemaOrdinal?
		=> @(new Clause.JsonColumn(name, c is null ? type : type + " COLLATE " + c, path, false, ordinal))

SchemaOrdinal : @string = t: Sql92.Lexical.Digits & when @(Syntax.Ranked(t)) => @(t)

JsonSchemaColumn : @Clause
	= name: Identifier & type: DataType & c: SchemaCollate? & path: SchemaPath? & json: SchemaAsJson?
		=> @(new Clause.JsonColumn(name, c is null ? type : type + " COLLATE " + c, path, json is not null))

SchemaCollate : @string = "COLLATE"i & n: SchemaCollation => @(n)
SchemaCollation = ?!(TSql.BracketedIdentifier | Sql92.Lexical.DelimitedIdentifier) & Identifier

SchemaPath : @string
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(t)
	| t: Sql92.Lexical.CharacterStringLiteral         => @(t)

SchemaAsJson = "AS"i & "JSON"i

// What may stand where one of these functions takes an argument. The published syntax of
// each names its own options — `SINGLE_NCLOB`, `FORMATFILE`, `CHANGES`, `LANGUAGE` — and
// the shape they all have is a word, a word and a value, a name, a list of names, or an
// ordinary value. So the shape is written and the vocabulary is left open, exactly as it
// is for the table hints and for the same reason: a name here is a catalogue's business,
// and adding one to T-SQL does not change the grammar.
RowsetArguments : @Expression[]
	= first: RowsetArgument & (',' & rest: RowsetArgument)* => @(Syntax.Listed(first, rest))

RowsetArgument : @Expression
	// A bare `*` here is every column of the source, which is what a column reference
	// spelled `*` says — a select list's `<qualified asterisk>` is a clause and this is not
	// in a select list.
	= '*'                                        => @(new Expression.ColumnReference("*"))
	| n: RowsetOrder                             => @(n)
	| word: "BULK"i & '(' & first: RowsetValue & (',' & rest: RowsetValue)+ & ')'
		=> @(new Expression.Prefixed(word, new Expression.RowValueConstructor(Syntax.Listed(first, rest))))
	| word: "BULK"i & v: RowsetValue             => @(new Expression.Prefixed(word, v))
	| name: Identifier & '=' & v: RowsetValue & alias: DataAlias?
	  & when @(alias is null || string.Equals(name, "DATA", System.StringComparison.OrdinalIgnoreCase))
		=> @(new Expression.NamedArgument(name, alias is null ? v : (Expression)(alias with { Value = v })))
	| word: Identifier & v: RowsetValue          => @(new Expression.Prefixed(word, v))
	| '(' & first: RowsetArgument & (',' & rest: RowsetArgument)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| v: RowsetValue                             => @(v)

// `ORDER ( c1 ASC, c2 DESC ) [ UNIQUE ]` says a bulk source is already sorted.
RowsetOrder : @Expression
	= "ORDER"i & '(' & first: SortSpecification & (',' & rest: SortSpecification)* & ')'
	  & unique: "UNIQUE"i?
		=> @(new Expression.RowsetOrder(Syntax.Listed(first, rest), unique is not null))

// A provider's arguments may be joined by semicolons rather than commas — a connection
// string written as three pieces, which is `OPENROWSET`'s oldest spelling.
RowsetValue : @Expression
	= first: ValueExpression & (';' & rest: ValueExpression)+
		=> @(new Expression.Pieced(Syntax.Listed(first, rest)))
	| "NULL"i    => @(Expression.NullValue)
	| "DEFAULT"i => @(Expression.DefaultValue)
	| v: ValueExpression => @(v)

// `OPENQUERY` takes a server and a query and neither is an expression: the server is one
// identifier, plain or delimited, and no more — `OPENQUERY('s1', 'q')`, `OPENQUERY(s1.a, 'q')`
// and `OPENQUERY(@s, 'q')` are all `Msg 102` — and the query is a string written out, `'q'` or
// `N'q'` but not `'q' + 'r'`. Two arguments exactly: one is `Msg 102` and so are three. It has
// a rule of its own because it is also the only rowset a statement writes to (`DmlTarget`).
OpenQueryCall : @Expression.RoutineInvocation
	= name: "OPENQUERY"i & '(' & server: Identifier & ',' & query: BrokerString & ')'
		=> @(new Expression.RoutineInvocation(name, new Expression[] { new Expression.ColumnReference(server), query }))

RowsetFunction : @Expression.RoutineInvocation
	= f: OpenQueryCall => @(f)
	| name: RowsetName & '(' & args: RowsetArguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))
	| name: FullTextTableName & '(' & table: QualifiedName & ',' & c: TableSearchColumns & ','
	  & s: FullTextSearch & l: SearchLanguage? & n: SearchTop? & ')'
		=> @(new Expression.RoutineInvocation(name, Syntax.Written(new Expression.ColumnReference(table), c, s, l, n)))
	| name: SemanticName & '(' & args: SemanticArguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))

// The three semantic-search functions, which take every column (`*`) or a list of them from
// level 110 and one column at every level; `CONTAINSTABLE (t, *, …)`, the same shape, reads
// at 100. So they have their arguments to themselves, and the one place the two forms are
// written is here.
SemanticName = "SEMANTICKEYPHRASETABLE"i | "SEMANTICSIMILARITYTABLE"i | "SEMANTICSIMILARITYDETAILSTABLE"i

SemanticArguments : @Expression[]
	= first: SemanticArgument & (',' & rest: SemanticArgument)* => @(Syntax.Listed(first, rest))

SemanticArgument : @Expression
	= '*' & when Version is Since110 => @(new Expression.ColumnReference("*"))
	| '(' & first: RowsetArgument & (',' & rest: RowsetArgument)* & ')' & when Version is Since110
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| ?!('*' | '(') & v: RowsetArgument => @(v)

// `OPENJSON` is a rowset function like the others but for one thing: its schema reads from
// level 130, where `OPENXML`'s — the same shape — reads at every level. Below 130 the engine
// answers `Incorrect syntax near the keyword 'with'` and reads the call without one. So it
// has a rule of its own, and is not among the names below.
JsonFunction : @Expression.RoutineInvocation
	= name: "OPENJSON"i & '(' & args: RowsetArguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))

JsonSchema : @Clause[]
	= "WITH"i & '(' & first: JsonSchemaColumn & (',' & rest: JsonSchemaColumn)* & ')' & when Version is Since130
		=> @(Syntax.Listed(first, rest))
	| "WITH"i & name: QualifiedName & when Version is Since130
		=> @(new Clause[] { new Clause.JsonColumn(name, null, null, false) })

RowsetName
	= "OPENROWSET"i | "OPENXML"i
	| "CHANGETABLE"i
	| "VECTOR_SEARCH"i | "GENERATE_SERIES"i | "STRING_SPLIT"i

// `PREDICT`'s data may be named where it stands, `DATA = dbo.t AS d`, and no other argument
// may: `MODEL = @m AS m` and `FORMATFILE = 'x' AS y` are refused. `PREDICT` takes its model and
// its data and nothing else — `RUNTIME = ONNX` is another product's (`Syntax.Predicts`).
DataAlias : @Expression.Aliased
	= "AS"i & t: Identifier => @(new Expression.Aliased(Expression.NullValue, t, true))
	| t: Identifier         => @(new Expression.Aliased(Expression.NullValue, t, false))

// `PREDICT`, which says what it returns and must: without its `WITH` it is `Msg 102`, and so
// is `RUNTIME = ONNX` with it or without. The `WITH` is its own and not a rowset's schema — a
// name, a type, perhaps a collation and then a nullability; no path, no `AS JSON`, no schema
// named for it — and the alias after it takes no columns.
PredictCall : @Expression.RoutineInvocation
	= name: "PREDICT"i & '(' & args: RowsetArguments & ')' & when @(Syntax.Predicts(args))
		=> @(new Expression.RoutineInvocation(name, args))

PredictSchema : @Clause[]
	= "WITH"i & '(' & first: PredictColumn & (',' & rest: PredictColumn)* & ')' => @(Syntax.Listed(first, rest))

PredictColumn : @Clause
	= name: Identifier & type: DataType & c: SchemaCollate? & n: NullSpec?
		=> @(new Clause.JsonColumn(name, type + (c is null ? "" : " COLLATE " + c) + (n is null ? "" : " " + n), null, false))

// `OPENDATASOURCE` is not a rowset: it stands where a server's name does, and the name of what
// is on that server follows it — `OPENDATASOURCE('MSOLEDBSQL', 'Server=s').db.dbo.t` in a
// `FROM`, an `EXECUTE`, an `INSERT`, an `UPDATE`, a `DELETE` or a `MERGE`, and never alone
// (`Msg 102`). Its two arguments are strings written out; the name after it has as many parts
// as it likes, empty ones among them (`..t`), and no trailing dot. Standing for a table it
// takes a correlation name, and no columns, no version, no sample and no hints.
AdHocServer : @Expression.RoutineInvocation
	= name: "OPENDATASOURCE"i & '(' & provider: BrokerString & ',' & init: BrokerString & ')'
		=> @(new Expression.RoutineInvocation(name, new Expression[] { provider, init }))

AdHocObject : @string = '.' & t: ('.'* & Identifier & ('.'+ & Identifier)*) => @(t)

// The full-text rowsets, put to the engine some fifty times, and stricter than the predicates
// they rank: a table by its name, and what is searched a column by its bare name, a list of
// them, `*` or a property — not `t.b`, not `t.*`, not `$IDENTITY`. Then what is searched for
// and the language as a predicate has them, and last how many rows, a whole number or a
// variable, after the language and never before it.
FullTextTableName = "CONTAINSTABLE"i | "FREETEXTTABLE"i

TableSearchColumns : @Expression
	= '*' => @(new Expression.ColumnReference("*"))
	| ?=("PROPERTY"i & '(' & QualifiedName & ',' & Quoted & ')') & p: ValueExpression => @(p)
	| '(' & '*' & ')' => @(new Expression.RowValueConstructor(new Expression[] { new Expression.ColumnReference("*") }))
	| '(' & first: TableSearchColumn & (',' & rest: TableSearchColumn)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| c: TableSearchColumn => @(c)

TableSearchColumn : @Expression = t: Identifier => @(new Expression.ColumnReference(t))

SearchTop : @Expression = ',' & ?=((Sql92.Lexical.Digits | TSql.Variable) & ')') & v: ValueExpression => @(v)

// ── The statements that change rows ─────────────────────────────────────────
//
// The query level was the whole of this grammar until now, and the four statements that
// write are written on top of it rather than beside it: an `INSERT` takes a query, an
// `UPDATE` takes a `FROM` clause, a `MERGE` takes a table source and two search
// conditions. Almost nothing here is new — what is new is the frame around what was
// already read.
//
// `OUTPUT` is kept, as `TOP` and the hints are. It says what a statement hands back
// rather than what it does, and it is a field on each of the four records that can carry
// one — which the round trip reads, so it is no longer a field nothing does.
// The terminator is part of the statement and not of the script, at least for one of
// them: SQL Server answers `A MERGE statement must be terminated by a semi-colon (;)`.
// So it is read here where it stands rather than cut off before the parse — cutting it
// off is what made every merge in the corpus look like a defect on this side.
//
// One `WITH` to a statement. A query reads its own as well, so after this one the body may
// not open with another: `WITH a AS (…) WITH b AS (…) SELECT …` is refused (156), where the
// two are written as one list, `WITH a AS (…), b AS (…)`.
// A statement and as many `;` after it as a text of statements takes, the engine reading the
// empty ones: a statement cut out of a text may carry them, `… AS staging_data;\n;`.
TSqlStatement : @Statement
	= (with: WithClause & ?!"WITH"i)? & s: StatementBody & ';'* => @(Syntax.Preceded(with, s))
	| c: BareCall & ';'*                                         => @(c)

StatementBody : @Statement
	= s: TSqlInsert   => @(s)
	| s: TSqlUpdate   => @(s)
	| s: TSqlDelete   => @(s)
	| s: TSqlMerge    => @(s)
	| s: Procedural   => @(s)
	| s: DirectSelect => @(s)

// What a statement writes to. Narrower than a table primary on purpose: the syntax gives
// a target no correlation and no sample, and `UPDATE t AS x SET …` is not T-SQL.
//
// A rowset function is not a target either, `OPENQUERY` excepted: the engine refuses
// `INSERT INTO OPENROWSET (BULK 'f1', FORMATFILE = 'g1') SELECT …` (`Msg 156`, the
// documented form among them), `DELETE FROM OPENXML (@h, '/a')` and `DELETE FROM
// CHANGETABLE (CHANGES t1, 1)` (`Msg 102`), under every one of `INSERT`, `UPDATE`,
// `DELETE` and `MERGE`. `OPENQUERY` it reads under all four. The names it refuses are
// reserved words, so nothing reads them back in as a call; `OPENJSON`, `STRING_SPLIT`
// and `GENERATE_SERIES` are not reserved and are read as one, which is what the engine
// does with them.
DmlTarget : @TableReference
	= server: AdHocServer & named: AdHocObject => @(new TableReference.Named(named, null, false, null, null, null, Clause.None, server))
	| f: OpenQueryCall                  => @(new TableReference.FunctionCall(f, null, null, Clause.None))
	| t: TSql.Variable & hints: TableHints?    => @(new TableReference.Named(t, null, false, null, null, null, hints ?? Clause.None))
	| name: QualifiedName & hints: TableHints? => @(new TableReference.Named(name, null, false, null, null, null, hints ?? Clause.None))

// A table-valued function is a target too, its arguments and nothing after them: the
// engine reads `UPDATE dbo.f() SET …`, `DELETE FROM dbo.f(1)` and `MERGE dbo.f() USING …`,
// and refuses a hint or an alias after the call, and a method of a variable.
DmlCall : @TableReference
	= name: QualifiedName & '(' & args: Arguments? & ')'
		=> @(new TableReference.FunctionCall(
				 new Expression.RoutineInvocation(name, args ?? Expression.None), null, null, Clause.None))

DmlSubject : @TableReference = c: DmlCall => @(c) | t: DmlTarget => @(t)

// ── §INSERT ─────────────────────────────────────────────────────────────────
// The query hints stand after the rows, as they do after an `UPDATE`'s — except where the
// rows are an `EXEC`, whose own options end the statement: `INSERT t EXEC p OPTION (…)` is
// refused.
//
// A function is the second reading, tried when the first has failed: `INSERT t (c1) VALUES
// …` is a table and its columns, and `INSERT dbo.f() (c1) …` and `INSERT dbo.f(1, DEFAULT)
// VALUES …` are what cannot be.
TSqlInsert : @Statement
	= "INSERT"i & top: Top? & into: "INTO"i? & target: DmlTarget
	  & ('(' & columns: InsertColumns & ')')? & output: OutputClause?
	  & rows: InsertRows & options: QueryHints? & when @(options is null || rows is not Query.FromExecute)
		=> @(new Statement.Insert(target, columns, rows, null, top, output, into is not null) { Options = options })
	| "INSERT"i & top: Top? & into: "INTO"i? & target: DmlCall & when @(Syntax.Written(target))
	  & ('(' & columns: InsertColumns & ')')? & output: OutputClause?
	  & rows: InsertRows & options: QueryHints? & when @(options is null || rows is not Query.FromExecute)
		=> @(new Statement.Insert(target, columns, rows, null, top, output, into is not null) { Options = options })

// What an `INSERT` names its columns by, which is not the standard's plain identifier: a part
// may be left out, `INSERT @v1 (..a1)`, as it may wherever a name is written. Reading them as
// names is what tells the columns of a table from the arguments of a function besides: with a
// plain identifier `INSERT t1 (..a1) VALUES (1)` was read as an insert into `t1 (..a1)`, a
// call, which the engine does not do.
InsertColumns : @string[] = first: InsertColumn & (',' & rest: InsertColumn)* => @(Syntax.Named(first, rest))

InsertColumn : @string = t: WrittenColumn => @(t)

InsertRows : @Query
	= "DEFAULT"i & "VALUES"i    => @(new Query.DefaultValues())
	| v: TableValueConstructor  => @(v)
	| e: ExecuteStatement       => @(new Query.FromExecute(e))
	| q: ChangedSource          => @(q)
	| q: QueryExpression & by: OrderByClause? & window: OffsetFetch? & shape: ForClause?
		=> @(Syntax.Ordered(q, Clause.Ordered(by, window), shape))

// The rows a statement returns, read as the rows to insert: `SELECT … FROM (MERGE … OUTPUT …)
// AS c WHERE …`, which the published block calls `<dml_table_source>`. Put to the engine some
// fifty times. It is the one place such a statement stands where a table does — a query of its
// own, `UPDATE … FROM`, a subquery and a derived table all refuse it (`Msg 10729` to `10731`)
// — and the query around it is as bare as the block writes it: one table, no join or comma
// (`Msg 10727`), no grouping, order or `TOP` (`Msg 10717`), no `DISTINCT` (`Msg 10722`), no
// `UNION` (`Msg 10732`), no `INTO`, `FOR`, hint or sample; a condition, and the `INSERT`'s own
// hints after it. The statement is any of the four, with no `WITH` in front of it and no
// second pair of brackets round it, and it returns its rows (`Syntax.Returns`).
ChangedSource : @Query
	= "SELECT"i & columns: SelectList & when @(!Syntax.HasIdentity(columns))
	  & "FROM"i & source: ChangedTable & where: WhereClause?
		=> @(new Query.Specification(null, null, columns, null, new TableReference[] { source }, where, null, null))

ChangedTable : @TableReference
	= '(' & s: ChangedStatement & ')' & "AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?
		=> @(new TableReference.Changed(s, alias, columns))

ChangedStatement : @Statement
	= s: TSqlDelete & when @(Syntax.Returns(s)) => @(s)
	| s: TSqlUpdate & when @(Syntax.Returns(s)) => @(s)
	| s: TSqlInsert & when @(Syntax.Returns(s)) => @(s)
	| s: TSqlMerge  & when @(Syntax.Returns(s)) => @(s)

// ── §UPDATE ─────────────────────────────────────────────────────────────────
TSqlUpdate : @Statement
	= "UPDATE"i & top: Top? & target: DmlSubject
	  & "SET"i & sets: Assignments & output: OutputClause?
	  & from: FromClause? & where: DmlWhere? & options: QueryHints?
		=> @(new Statement.Update(target, sets, from ?? TableReference.None, where, null, top, output, options))

Assignments : @Clause[]
	= first: Assignment & (',' & rest: Assignment)* => @(Syntax.Listed(first, rest))

// Everything the syntax allows on the left of a `SET`, which is more than a column: a
// variable, a variable and a column at once, a member of a user-defined type, and a
// method called on one. `.WRITE (…)` needs no rule of its own — a qualified name has
// already eaten the dot, so what is left is a call.
Assignment : @Clause
	= to: TSql.Variable   & s: UpdateVariableTail => @(s with { Target = to })
	| to: WrittenColumn   & s: ColumnAssignTail   => @(s with { Target = to })

// The name of a column being written to, which is narrower than the name of one being read.
// A `$` name stands alone there and carries no prefix: `INSERT t1 ($node_id)` and `UPDATE t1
// SET $IDENTITY = 1` are read, `INSERT t1 (a.$ACTION)`, `INSERT t1 (t1.$node_id)`, `UPDATE t1
// SET [a].$IDENTITY = 1` and `..$node_id` are all `Msg 102`. Delimited it is an ordinary name
// and takes one as it likes — `a.[$ACTION]` is read — and as a value it is ordinary too,
// `SELECT t1.$node_id` and `OUTPUT INSERTED.$node_id` being read where these are not. So the
// parts under a prefix are identifiers and the gaps between them, `..a1` and `a..b` included.
WrittenColumn = PartitionName | WrittenName

WrittenName     = Identifier & WrittenNamePart* | WrittenNamePart+
WrittenNamePart = '.' & (Identifier | ?='.')

// `DEFAULT` is assigned and not compounded: the engine answers `DEFAULT is not allowed
// on the right hand side of "-="`, which is a rule about the operator rather than about
// the value, so it is written on the operator. And it is a column's: a variable is not given
// it, `SET @a = DEFAULT` and `UPDATE t SET @a = DEFAULT` being refused.
//
// A variable's own `SET` takes a value or a compound one, and nothing more.
AssignTail : @Clause.Set
	= '=' & v: SetValue          => @(new Clause.Set("", "=", v))
	| op: AssignOp & v: SetValue => @(new Clause.Set("", op, v))

// In an `UPDATE` a variable may take a column's new value along with the column, `@a = c =
// 1` or `@a = c += 1`, with `DEFAULT` where the column is assigned plainly — `@a = c =
// DEFAULT` is read. A variable's own `SET` refuses the column: `SET @a = c = 1`.
UpdateVariableTail : @Clause.Set
	= '=' & c: QualifiedName & s: VariableChainTail => @(s with { Through = c })

	| s: AssignTail                         => @(s)

ChainTail : @Clause.Set
	= '=' & v: AssignedValue     => @(new Clause.Set("", "=", v))
	| op: AssignOp & v: SetValue => @(new Clause.Set("", op, v))

// The chain a variable takes a column's value through, which is the one place a compound
// operator takes `DEFAULT`: `SET c1 -= DEFAULT` is `Msg 10708`, and `SET @a = c1 -= DEFAULT` is
// read — with every operator, in an `UPDATE` and in a `MERGE`'s.
VariableChainTail : @Clause.Set
	= '=' & v: AssignedValue       => @(new Clause.Set("", "=", v))
	| op: AssignOp & v: AssignedValue => @(new Clause.Set("", op, v))

ColumnAssignTail : @Clause.Set
	= '(' & args: Arguments? & ')' => @(new Clause.Set("", "", new Expression.RoutineInvocation("", args ?? Expression.None)))
	| s: ChainTail                 => @(s)

AssignedValue : @Expression
	= "DEFAULT"i => @(Expression.DefaultValue)
	| v: SetValue => @(v)

SetValue : @Expression
	= "NULL"i    => @(Expression.NullValue)
	| v: ValueExpression => @(v)

// A `WHERE` that may name a cursor's current row instead of a condition.
DmlWhere : @Expression
	= "WHERE"i & t: ("CURRENT"i & "OF"i & "GLOBAL"i? & QualifiedName)
		=> @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| "WHERE"i & c: SearchCondition => @(c)

// ── §DELETE ─────────────────────────────────────────────────────────────────
TSqlDelete : @Statement
	= "DELETE"i & top: Top? & "FROM"i? & target: DmlSubject & output: OutputClause?
	  & from: FromClause? & where: DmlWhere? & options: QueryHints?
		=> @(new Statement.Delete(target, from ?? TableReference.None, where, null, top, output, options))

// ── §MERGE ──────────────────────────────────────────────────────────────────
//
// Three shapes of arm and they are not interchangeable: a match and a missing target may
// insert, a missing source may update or delete, and the syntax says which is which.
TSqlMerge : @Statement
	= "MERGE"i & top: Top? & into: "INTO"i? & target: DmlSubject & ("AS"i? & alias: CorrelationName)?
	  & "USING"i & source: TableReference
	  & "ON"i & on: SearchCondition
	  & whens: MergeArm+ & output: OutputClause? & options: QueryHints?
		=> @(new Statement.Merge(target, source, on, whens, null, top, alias, output, options, into is not null))

MergeArm : @Clause
	= "WHEN"i & "MATCHED"i & ("AND"i & c: SearchCondition)? & "THEN"i & a: MergeChange
		=> @(new Clause.MergeWhen(true, null, c, a))
	| "WHEN"i & "NOT"i & "MATCHED"i & "BY"i & "SOURCE"i & ("AND"i & c: SearchCondition)?
	  & "THEN"i & a: MergeChange
		=> @(new Clause.MergeWhen(false, "SOURCE", c, a))
	| "WHEN"i & "NOT"i & "MATCHED"i & by: ("BY"i & "TARGET"i)? & ("AND"i & c: SearchCondition)?
	  & "THEN"i & a: MergeInsert
		=> @(new Clause.MergeWhen(false, by is null ? null : "TARGET", c, a))

MergeChange : @Statement
	= "UPDATE"i & "SET"i & sets: Assignments
		=> @(new Statement.Update(null, sets, TableReference.None, null))
	| "DELETE"i
		=> @(new Statement.Delete(null, TableReference.None, null))

// The columns a merge inserts into, which are the standard's plain names and a `$` name
// besides: `INSERT ($ACTION, $CUID) VALUES (10)` is read, and so is `$IDENTITY`. Not the
// insert's own list, which reads a name with parts — here a part is `Msg 10739`, `a.c1`,
// `..c1` and `a.b.c.d` alike — and not a run of names either, since `IDENTITYCOL` is
// `Msg 156` where `[$ACTION]` is read as the ordinary name it is.
MergeInsert : @Statement
	= "INSERT"i & ('(' & columns: MergeColumns & ')')? & rows: MergeInsertRows
		=> @(new Statement.Insert(null, columns, rows))

MergeColumns : @string[] = first: MergeColumn & (',' & rest: MergeColumn)* => @(Syntax.Named(first, rest))

MergeColumn : @string = t: (Identifier | PartitionName) => @(t)

MergeInsertRows : @Query
	= "DEFAULT"i & "VALUES"i   => @(new Query.DefaultValues())
	| v: TableValueConstructor => @(v)

// ── The output clause, shared by all four ───────────────────────────────────
//
// What it names is `INSERTED`, `DELETED` or a table of the `FROM` clause, and `$action`
// for a merge — all of them ordinary names once `$` is part of one.
OutputClause : @Clause
	= "OUTPUT"i & items: OutputList & "INTO"i & into: DmlTarget & ('(' & columns: ColumnList & ')')? & next: OutputClause?
		=> @(new Clause.Output(items, into, columns, next))
	| "OUTPUT"i & items: OutputList
		=> @(new Clause.Output(items))

OutputList : @Clause[] = first: OutputItem & (',' & rest: OutputItem)* => @(Syntax.Listed(first, rest))

OutputItem : @Clause
	= q: QualifiedName & '.' & '*'          => @(new Clause.QualifiedAsterisk(q))
	| v: ValueExpression & alias: TSqlAsClause? => @(new Clause.DerivedColumn(v, alias))

// ── The procedural level ────────────────────────────────────────────────────
//
// The frame everything else stands inside. It is worth writing before the rest of the
// statement language and not after: `CREATE PROCEDURE`, `CREATE TRIGGER` and
// `CREATE FUNCTION` are a header and a body, and the body is this — so none of the three
// can be read at all until it exists, and `INSERT … EXEC` cannot either.
//
// Everything here was written from the published syntax and every form put to the engine.

// Split in two, and not for tidiness: with all of it in one rule the generator answered
// GRAM5003 — one materializing method of 2,132 basic blocks, past the point where the JIT
// stops optimizing and runs it several times slower than it needs to. Two rules are two
// methods, and each is inside the budget. It is the first time this grammar has been large
// enough for that to happen, and it will not be the last.
Procedural : @Statement
	= s: ControlStatement    => @(s)
	| s: DefinitionStatement => @(s)

ControlStatement : @Statement
	= s: TryCatchStatement    => @(s)
	| s: TransactionStatement => @(s)
	| s: StatementBlock       => @(s)
	| s: ConditionalStatement => @(s)
	| s: LoopStatement        => @(s)
	| s: SimpleCommand        => @(s)
	| s: CursorStatement      => @(s)
	| s: DbccStatement        => @(s)
	| s: ConversationStatement => @(s)

DefinitionStatement : @Statement
	= s: DeclareStatement     => @(s)
	| s: SetStatement         => @(s)
	| s: SessionStatement     => @(s)
	| e: ExecuteStatement     => @(e)
	| s: BulkInsertStatement  => @(s)
	| s: CreateTableStatement => @(s)
	| s: AlterTableStatement  => @(s)
	| s: CreateRoutine        => @(s)
	| s: CreateIndexStatement => @(s)
	| s: AlterIndexStatement  => @(s)
	| s: PermissionStatement  => @(s)
	| s: AuditStatement          => @(s)
	| s: KeyStatement            => @(s)
	| s: FullTextStatement       => @(s)
	| s: BackupStatement         => @(s)
	| s: RestoreStatement        => @(s)
	| s: CreateDatabaseStatement => @(s)
	| s: AlterDatabaseStatement  => @(s)
	| s: DropStatement           => @(s)
	| s: PrincipalStatement      => @(s)
	| s: ExternalStatement       => @(s)
	| s: BrokerStatement         => @(s)
	| s: ServerStatement         => @(s)
	| s: PartitionStatement      => @(s)
	| s: SequenceStatement       => @(s)
	| s: TypeStatement           => @(s)
	| s: MaintenanceStatement    => @(s)
	| s: CodeStatement           => @(s)
	| s: TextStatement           => @(s)

// ── A text of statements ────────────────────────────────────────────────────
//
// What a client sends the server in one call, and what a block holds: statements one after
// another, each ended by a `;` or by nothing, with as many empty ones between as anybody
// writes — `SELECT 1;;` and `BEGIN ; SELECT 1 END` are read. Nothing will do before a
// `WITH`, which is the clause of the statement after it and which the engine will not tell
// from a continuation of the one before: `SELECT 1 WITH a AS (…) SELECT …` is refused (319),
// and so is the same after `PRINT`, `SET`, `UPDATE`, `DROP`, an `IF` or a block. Two engine
// answers go the other way and are not followed here: after a `DECLARE` whose last variable
// has no value, `DECLARE @x INT`, and after `RAISERROR (…)` it reads the `WITH` without the
// `;`.
SqlText : @Statement[]
	= first: FirstPiece & rest: SqlPiece* => @(Syntax.Listed(first, rest))
	| ';'* & s: SqlPiece*                 => @(s ?? System.Array.Empty<Statement>())

// The first statement of a text may be a procedure's call without the word — `sp_who`,
// `dbo.p 1, @a OUTPUT` — which the engine reads there and nowhere else: after a `;`, after
// another statement, in a block and in a procedure's body the same words are refused. It is
// the second reading, tried where no statement could be read, since a word like `THROW`
// begins both.
FirstPiece : @Statement
	= s: SqlPiece                      => @(s)
	| c: BareCall & (';'+ | ?!"WITH"i) => @(c)

SqlPiece : @Statement
	= (with: WithClause & ?!"WITH"i)? & s: StatementBody & (';'+ | ?!"WITH"i & ?!Unseparated)
		=> @(Syntax.Preceded(with, s))

// A statement not ended by `;` is not followed by one whose first word is not reserved: the
// engine reads the word as a continuation of the statement before it and answers `Msg 102`.
// `END CONVERSATION 10 ENABLE TRIGGER t1 ON o1` is refused and `END CONVERSATION 10; ENABLE
// TRIGGER t1 ON o1` read, while `PRINT 1 TRUNCATE TABLE t` needs no `;` — `TRUNCATE` is
// reserved and cannot continue anything. Seven words open a statement and are not reserved,
// and a block's first statement is none of this: `BEGIN ENABLE TRIGGER t1 ON o1 END` is read.
Unseparated = "ENABLE"i | "DISABLE"i | "RECEIVE"i | "THROW"i | "MOVE"i | "GET"i | "SEND"i

StatementList : @Statement[] = ';'* & s: SqlPiece+ => @(s)

// ── A script ────────────────────────────────────────────────────────────────
//
// What a file of T-SQL is: batches, each a text of statements, cut apart by the lines that
// say `GO`. The server never sees those lines — a client cuts the file at them and sends
// each batch in its own call — so a script is not one text of statements but several, and a
// `GO` that stands first in the file ends a batch with nothing in it. What ScriptDom reads
// as a script this reads the same way, with one difference: `GO 5`, which sqlcmd and the
// management tools read as five sends of the batch, ScriptDom refuses.
ScriptText : @Batch[]
	= first: SqlText & rest: ScriptBatch* & last: FinalGo? => @(Syntax.Scripted(first, rest, last))

// A `GO` on the last line of a file, with no line break after it, which the lexeme cannot
// take (the end of the input is not a pattern). Nothing can follow it, so it is the word
// itself, read where the last batch ended — unless that batch's last statement read it
// first, as the name a `SELECT`'s last column is called.
FinalGo : @string = t: ("GO"i & Sql92.Lexical.Digits?) => @(Syntax.GoLine(t))

// A batch with the `GO` in front of it; the script moves each `GO` onto the batch it ends.
ScriptBatch : @Batch = go: GoText & s: SqlText => @(new Batch(s, go))

GoText : @string = t: TSql.GoLine => @(Syntax.GoLine(t))

// `BEGIN TRY` and `BEGIN TRANSACTION` open with the same word as a block, so both stand
// in front of it. A `CATCH` may hold nothing — `BEGIN TRY SELECT 1; END TRY BEGIN CATCH END
// CATCH` is read — and a `TRY` may not (`Msg 102`); neither holds a `;` and nothing else, the
// list being statements or nothing.
TryCatchStatement : @Statement
	= "BEGIN"i & "TRY"i & tried: StatementList & "END"i & "TRY"i
	  & "BEGIN"i & "CATCH"i & caught: StatementList? & "END"i & "CATCH"i
		=> @(new Statement.TryCatch(tried, caught ?? System.Array.Empty<Statement>()))

StatementBlock : @Statement
	= "BEGIN"i & "ATOMIC"i & "WITH"i & '(' & atomic: OptionList & ')' & body: StatementList & "END"i
		=> @(new Statement.Compound(body, atomic))
	| "BEGIN"i & body: StatementList & "END"i => @(new Statement.Compound(body))

// A branch leaves its `;` to the statement it is a branch of, unless an `ELSE` follows: the
// `;` of `IF c SELECT 1; WITH a AS (…) SELECT …` ends the `IF`, and a `WITH` after it is the
// next statement's, which the engine reads.
ConditionalStatement : @Statement
	= "IF"i & c: SearchCondition & then: Branch & other: ElseBranch?
		=> @(new Statement.If(c, then, other))

ElseBranch : @Statement = ';'? & "ELSE"i & s: Branch => @(s)

LoopStatement : @Statement
	= "WHILE"i & c: SearchCondition & body: Branch => @(new Statement.While(c, body))

Branch : @Statement
	= (with: WithClause & ?!"WITH"i)? & s: StatementBody => @(Syntax.Preceded(with, s))

// ── Transactions ────────────────────────────────────────────────────────────
TransactionStatement : @Statement
	= "BEGIN"i & "DISTRIBUTED"i & word: TranWord & name: TranName? & mark: TranMark?
		=> @(new Statement.Transaction("BEGIN DISTRIBUTED", name, word, Syntax.Tail(mark)))
	| "BEGIN"i & word: TranWord & name: TranName? & mark: TranMark?
		=> @(new Statement.Transaction("BEGIN", name, word, Syntax.Tail(mark)))
	| "COMMIT"i & word: TranWord? & name: TranName? & how: TranDelayed?
		=> @(new Statement.Transaction("COMMIT", name, word, Syntax.Tail(how)))
	| "ROLLBACK"i & word: TranWord? & name: TranName?
		=> @(new Statement.Transaction("ROLLBACK", name, word))
	| "SAVE"i & word: TranWord & name: TranName
		=> @(new Statement.Transaction("SAVE", name, word))

TranWord : @string = t: ("TRANSACTION"i | "TRAN"i | "WORK"i) => @(Syntax.Squared(t))
TranMark    = "WITH"i & "MARK"i & ValueExpression?
TranDelayed = "WITH"i & '(' & OptionList & ')'

// A name, a variable, or a number and a name of two parts: `SAVE TRANSACTION -5:a.b`, which
// every transaction statement reads. The number has a sign or not and a fraction or not, and
// no exponent; the name has two parts and no more, quoted or not, and no empty one.
TranName : @string
	= t: Identifier                                              => @(t)
	| t: TSql.Variable                                           => @(t)
	| t: ('-'? & ExactNumber & ':' & Identifier & '.' & Identifier) => @(Syntax.Spaced(t))

// ── Declarations ────────────────────────────────────────────────────────────
DeclareStatement : @Statement
	= "DECLARE"i & name: Identifier & d: CursorDefinition => @(new Statement.DeclareCursor(name, d))
	| "DECLARE"i & first: Declaration & (',' & rest: Declaration)*
		=> @(new Statement.Declare(Syntax.Listed(first, rest)))

Declaration : @Clause
	= name: TSql.Variable & said: "AS"i? & d: DeclaredAs
		=> @(d with { Name = name, As = said is not null })

DeclaredAs : @Clause.VariableDeclaration
	= "TABLE"i & '(' & body: TableBody & ')'              => @(new Clause.VariableDeclaration("", "TABLE", null, body))
	| "CURSOR"i                                           => @(new Clause.VariableDeclaration("", "CURSOR", null))
	| type: DataType & n: NullSpec? & ('=' & v: SetValue)? => @(new Clause.VariableDeclaration("", type, v, null, n))

// ── Text read and written in place, and a configuration taken up ──────────────────
//
// `READTEXT`, `WRITETEXT` and `UPDATETEXT`, the old way to a `text`, `ntext` or `image` value
// through its pointer, and `RECONFIGURE`: a record each, put to the engine some hundred and
// twenty times.
//
// The column is named by two parts to four (`Msg 182`), and the pointer is a variable or a
// binary string, never `NULL` or an `@@` one. What is read is a start and a size, each a number
// with no sign and no exponent or a variable, and then `HOLDLOCK` if wanted — once, and no
// other hint (`Msg 1018`). What is written is a string, a binary string, a variable or `NULL`,
// never a number or an expression; after `BULK` nothing is, the data coming by the bulk
// protocol (`Msg 185`), and without it something must be (`Msg 186`). What is updated is a start
// and a length, each `NULL`, a variable or a number that may be negative, and then a value,
// another column and its pointer, or nothing. `RECONFIGURE` takes `WITH OVERRIDE` and no more.
TextStatement : @Statement
	= "READTEXT"i & column: TextColumn & pointer: TextPointer & offset: TextAmount & size: TextAmount
	  & hold: "HOLDLOCK"i?
		=> @(new Statement.ReadText(column, pointer, offset, size, hold is not null))
	| "WRITETEXT"i & "BULK"i & column: TextColumn & pointer: TextPointer & log: TextLog?
		=> @(new Statement.WriteText(column, pointer, null, true, log is not null))
	| "WRITETEXT"i & column: TextColumn & pointer: TextPointer & log: TextLog? & data: TextData
		=> @(new Statement.WriteText(column, pointer, data, false, log is not null))
	| "UPDATETEXT"i & "BULK"i & column: TextColumn & pointer: TextPointer & offset: TextPlace & length: TextPlace
	  & log: TextLog?
		=> @(new Statement.UpdateText(column, pointer, offset, length, null, null, null, true, log is not null))
	| "UPDATETEXT"i & column: TextColumn & pointer: TextPointer & offset: TextPlace & length: TextPlace
	  & log: TextLog? & (source: TextColumn & from: TextPointer | data: TextData)?
		=> @(new Statement.UpdateText(column, pointer, offset, length, data, source, from, false, log is not null))
	| "RECONFIGURE"i & o: ("WITH"i & "OVERRIDE"i)?
		=> @(new Statement.Reconfigure(o is not null))

TextColumn : @string = t: (Identifier & '.' & Identifier & ('.' & Identifier)? & ('.' & Identifier)?) => @(t)

TextPointer : @Expression
	= v: LocalVariable      => @(v)
	| t: TSql.BinaryLiteral => @(new Expression.Literal(SqlLiteralKind.Hex, t))

TextAmount : @Expression
	= n: ExactNumber   => @(new Expression.Literal(SqlLiteralKind.Number, n))
	| v: LocalVariable => @(v)

TextPlace : @Expression
	= "NULL"i                => @(Expression.NullValue)
	| t: ('-' & ExactNumber) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| n: ExactNumber         => @(new Expression.Literal(SqlLiteralKind.Number, n))
	| v: LocalVariable       => @(v)

TextData : @Expression
	= v: BrokerString       => @(v)
	| t: TSql.BinaryLiteral => @(new Expression.Literal(SqlLiteralKind.Hex, t))
	| v: LocalVariable      => @(v)
	| "NULL"i               => @(Expression.NullValue)

TextLog = "WITH"i & "LOG"i

// ── Code the server loads, and what binds or signs it ─────────────────────────────
//
// Put to the engine some two hundred times. The objects are kept as every object here is, a
// name and the words after it; a signature is the mirror of its `DROP`.
//
// An assembly is named by one part and made of one value or more — a path, bits, any value —
// with its permission set said once. Altered, it is given new bits, options each once
// (`PERMISSION_SET`, `VISIBILITY`, `UNCHECKED DATA`), files dropped (all of them, or by their
// strings) and files added (a value, and a string to call it), in that order and at least one
// of them. A cryptographic provider is named by one part and made from a file's string;
// altered, it is switched on, off, or given another file, one of the three. An external
// language is named by one part and made of one file or two, each a bracket that names its
// content and its file (`Msg 39123`) and perhaps its platform and its parameters, any of them
// more than once; `ENVIRONMENT_VARIABLES`, which the published syntax lists, is refused
// (`Msg 39133`). Of two files the platforms differ (`Msg 39112`, `Syntax.LanguageFiles`).
// Altered, it is given one file anew, one more, or one taken away by its platform.
//
// A rule and a default are named by two parts at most (`Msg 166`). A rule's condition names
// one variable — none is `Msg 160` unless a subquery stands in it, two are `Msg 161` — and a
// default's value is any value; neither draws from a sequence outside a subquery
// (`Msg 11719`, `Syntax.Binds`). An aggregate is named by two parts at most, takes one
// parameter or more with a type and a nullability and nothing else — a default is
// `Msg 10726`, `OUTPUT` `Msg 181` — and names the assembly's class by one part or two.
//
// A module, of the class `OBJECT`, `ASSEMBLY` or `DATABASE` where one is said, is signed by
// certificates and asymmetric keys, each named by one part and perhaps with its password or
// the signature after it; by symmetric keys; or by passwords. A signature is a binary string
// and a password a string, neither a variable. `DROP SIGNATURE` is answered the same and
// shares the rules, which it did not before: it read `CERTIFICATE dbo.c`, which the engine
// refuses, and refused `ASSEMBLY::a`, a symmetric key and a password.
CodeStatement : @Statement
	= "CREATE"i & "ASSEMBLY"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & Identifier)? & "FROM"i & SetValue & (',' & SetValue)*
			   & ("WITH"i & "PERMISSION_SET"i & '=' & AssemblyPermission)?)
		=> @(Statement.Defined("ASSEMBLY", name, Syntax.Tail(tail), "CREATE"))
	| "ALTER"i & "ASSEMBLY"i & name: Identifier
	  & tail: (("FROM"i & SetValue)? & options: AssemblyOptions? & AssemblyDrop? & AssemblyAdd?)
	  & when @(Syntax.Tail(tail) is not null)
		=> @(Statement.Defined("ASSEMBLY", name, Syntax.Tail(tail), "ALTER", options))
	| "CREATE"i & "CRYPTOGRAPHIC"i & "PROVIDER"i & name: Identifier & tail: ("FROM"i & "FILE"i & '=' & Quoted)
		=> @(Statement.Defined("CRYPTOGRAPHIC PROVIDER", name, Syntax.Tail(tail), "CREATE"))
	| "ALTER"i & "CRYPTOGRAPHIC"i & "PROVIDER"i & name: Identifier
	  & tail: ("ENABLE"i | "DISABLE"i | "FROM"i & "FILE"i & '=' & Quoted)
		=> @(Statement.Defined("CRYPTOGRAPHIC PROVIDER", name, Syntax.Tail(tail), "ALTER"))
	| "CREATE"i & "EXTERNAL"i & "LANGUAGE"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & Identifier)? & "FROM"i & file: LanguageFile & (',' & other: LanguageFile)?)
	  & when @(Syntax.LanguageFiles(file, other))
		=> @(Statement.Defined("EXTERNAL LANGUAGE", name, Syntax.Tail(tail), "CREATE"))
	| "ALTER"i & "EXTERNAL"i & "LANGUAGE"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & Identifier)?
			   & (("SET"i | "ADD"i) & LanguageFile | "REMOVE"i & "PLATFORM"i & LanguagePlatform))
		=> @(Statement.Defined("EXTERNAL LANGUAGE", name, Syntax.Tail(tail), "ALTER"))
	| "CREATE"i & "RULE"i & name: TwoPartName & tail: ("AS"i & c: SearchCondition) & when @(Syntax.Binds(c, true))
		=> @(Statement.Defined("RULE", name, Syntax.Tail(tail)))
	| "CREATE"i & "DEFAULT"i & name: TwoPartName & tail: ("AS"i & v: SetValue) & when @(Syntax.Binds(v, false))
		=> @(Statement.Defined("DEFAULT", name, Syntax.Tail(tail)))
	| "CREATE"i & "AGGREGATE"i & name: TwoPartName
	  & tail: ('(' & AggregateParameter & (',' & AggregateParameter)* & ')'
			   & "RETURNS"i & DataType & "EXTERNAL"i & "NAME"i & Identifier & ('.' & Identifier)?)
		=> @(Statement.Defined("AGGREGATE", name, Syntax.Tail(tail)))
	| "ADD"i & counter: "COUNTER"i? & "SIGNATURE"i & "TO"i & to: SignedModule & "BY"i
	  & crypto: SignatureCrypto & (',' & cryptos: SignatureCrypto)*
		=> @(new Statement.AddSignature(Syntax.Listed(crypto, cryptos), to, counter is not null))

AssemblyPermission = "SAFE"i | "EXTERNAL_ACCESS"i | "UNSAFE"i

AssemblyOptions : @Clause[]
	= "WITH"i & first: AssemblyOption & (',' & rest: AssemblyOption)* & when @(Syntax.NamedOnce(first, rest))
		=> @(Syntax.Listed(first, rest))

AssemblyOption : @Clause
	= "PERMISSION_SET"i & '=' & t: AssemblyPermission
		=> @(new Clause.Option("PERMISSION_SET", new Expression.ColumnReference(Syntax.Squared(t)), Clause.None))
	| "VISIBILITY"i & '=' & on: OnOff => @(new Clause.Option("VISIBILITY", new Expression.ColumnReference(on), Clause.None))
	| "UNCHECKED"i & "DATA"i           => @(new Clause.Option("UNCHECKED DATA", null, Clause.None))

AssemblyDrop = "DROP"i & "FILE"i & ("ALL"i | Quoted & (',' & Quoted)*)
AssemblyAdd  = "ADD"i & "FILE"i & "FROM"i & AssemblyFile & (',' & AssemblyFile)*
AssemblyFile = SetValue & ("AS"i & Quoted)?

LanguageFile : @Clause[]
	= '(' & first: LanguageOption & (',' & rest: LanguageOption)* & ')' => @(Syntax.Listed(first, rest))

LanguageOption : @Clause
	= "CONTENT"i & '=' & v: SetValue          => @(new Clause.Option("CONTENT", v, Clause.None))
	| "FILE_NAME"i & '=' & v: BrokerString    => @(new Clause.Option("FILE_NAME", v, Clause.None))
	| "PARAMETERS"i & '=' & v: BrokerString   => @(new Clause.Option("PARAMETERS", v, Clause.None))
	| "PLATFORM"i & '=' & t: LanguagePlatform => @(new Clause.Option("PLATFORM", new Expression.ColumnReference(t), Clause.None))

LanguagePlatform : @string = t: ("WINDOWS"i | "LINUX"i) => @(Syntax.Squared(t))

TwoPartName = Identifier & ('.' & Identifier)?

AggregateParameter = TSql.Variable & "AS"i? & DataType & NullSpec?

SignedModule : @string
	= t: (("OBJECT"i | "ASSEMBLY"i | "DATABASE"i) & "::" & QualifiedName) => @(Syntax.Spaced(t))
	| t: QualifiedName                                                   => @(t)

SignatureCrypto : @Expression
	= t: ("CERTIFICATE"i & Identifier & SignatureProof?)         => @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| t: ("ASYMMETRIC"i & "KEY"i & Identifier & SignatureProof?) => @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| t: ("SYMMETRIC"i & "KEY"i & Identifier)                    => @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| t: ("PASSWORD"i & '=' & Quoted)                        => @(new Expression.ColumnReference(Syntax.Spaced(t)))

SignatureProof = "WITH"i & ("PASSWORD"i & '=' & Quoted | "SIGNATURE"i & '=' & TSql.BinaryLiteral)

// ── A table emptied, a trigger switched, a session killed, a column classified ────
//
// Four statements, put to the engine some eighty times, each a record of its own.
//
// A table is emptied by one name of up to four parts, a temporary table's among them and a
// variable's not, and of its partitions where `WITH (PARTITIONS (…))` names them: numbers,
// any value, or ranges of them, backwards too. Triggers are switched by name, two parts at
// most, or all of them, never both; on an object, `DATABASE` or `ALL SERVER`. A session is
// killed by its number or a unit of work by its string — not a variable, not an expression —
// with `STATUSONLY`, `COMMIT` or `ROLLBACK` after it if it likes; a subscription by its number
// or all of them, a statistics job by its number. Columns are classified by two parts or
// three, with strings for the labels and the types and a word for the rank, each once.
MaintenanceStatement : @Statement
	= "TRUNCATE"i & "TABLE"i & name: QualifiedName & p: TruncatePartitions?
		=> @(new Statement.Truncate(name, p))
	| verb: ("ENABLE"i | "DISABLE"i) & "TRIGGER"i & triggers: TriggerNames & "ON"i & on: TriggerScope
		=> @(new Statement.TriggerSwitch(Syntax.Squared(verb) == "ENABLE", triggers.Length == 0 ? null : triggers, on))
	| "KILL"i & "QUERY"i & "NOTIFICATION"i & "SUBSCRIPTION"i & t: KillSubscription
		=> @(new Statement.Kill("QUERY NOTIFICATION SUBSCRIPTION", t))
	| "KILL"i & "STATS"i & "JOB"i & t: KillNumber
		=> @(new Statement.Kill("STATS JOB", t))
	| "KILL"i & t: KillSession & with: KillWith?
		=> @(new Statement.Kill("", t, with))
	| "ADD"i & "SENSITIVITY"i & "CLASSIFICATION"i & "TO"i & first: ClassifiedColumn & (',' & rest: ClassifiedColumn)*
	  & "WITH"i & '(' & option: ClassificationOption & (',' & options: ClassificationOption)* & ')'
	  & when @(Syntax.NamedOnce(option, options))
		=> @(new Statement.Classification(true, Syntax.Named(first, rest), Syntax.Listed(option, options)))

TruncatePartitions : @Clause[]
	= "WITH"i & '(' & "PARTITIONS"i & '(' & first: PartitionSpan & (',' & rest: PartitionSpan)* & ')' & ')'
		=> @(Syntax.Listed(first, rest))

PartitionSpan : @Clause = from: ValueExpression & ("TO"i & to: ValueExpression)? => @(new Clause.PartitionRange(from, to))

TriggerNames : @string[]
	= "ALL"i                                          => @(System.Array.Empty<string>())
	| first: TriggerName & (',' & rest: TriggerName)* => @(Syntax.Named(first, rest))

TriggerName : @string = t: (Identifier & ('.' & Identifier)?) => @(t)

TriggerScope : @string
	= "ALL"i & "SERVER"i => @("ALL SERVER")
	| "DATABASE"i        => @("DATABASE")
	| t: QualifiedName   => @(t)

KillSubscription : @Expression = "ALL"i => @(new Expression.ColumnReference("ALL")) | n: KillNumber => @(n)
KillNumber       : @Expression = t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
KillSession      : @Expression = n: KillNumber => @(n) | s: BrokerString => @(s)
KillWith         : @string = "WITH"i & t: ("STATUSONLY"i | "COMMIT"i | "ROLLBACK"i) => @(Syntax.Squared(t))

ClassifiedColumn : @string = t: (Identifier & '.' & Identifier & ('.' & Identifier)?) => @(t)

ClassificationOption : @Clause
	= name: ("LABEL_ID"i | "LABEL"i | "INFORMATION_TYPE_ID"i | "INFORMATION_TYPE"i) & '=' & v: BrokerString
		=> @(new Clause.Option(Syntax.Squared(name), v, Clause.None))
	| "RANK"i & '=' & t: ("NONE"i | "LOW"i | "MEDIUM"i | "HIGH"i | "CRITICAL"i)
		=> @(new Clause.Option("RANK", new Expression.ColumnReference(Syntax.Squared(t)), Clause.None))

// ── Types, schema collections and synonyms ──────────────────────────────────
//
// Put to the engine some sixty times and kept as every object here is.
//
// A type is made of another type, with a nullability and no default; of an assembly's class,
// by one part or two; or of a table, whose body is a table's but for what ties it elsewhere or
// names what it holds (`Syntax.TableTyped`), and which may be kept in memory and nothing more
// — `DATA_COMPRESSION` and a filegroup are refused. A schema collection is made of a value
// and added to by one, any value. A synonym is named by two parts at most, and stands for a
// name of as many as it likes, empty ones among them; it is never altered.
TypeStatement : @Statement
	= "CREATE"i & "TYPE"i & name: QualifiedName
	  & tail: ("FROM"i & DataType & NullSpec?
			  | "EXTERNAL"i & "NAME"i & Identifier & ('.' & Identifier)?
			  | "AS"i & "TABLE"i & TableTypeBody & ("WITH"i & '(' & "MEMORY_OPTIMIZED"i & '=' & OnOff & ')')?)
		=> @(Statement.Defined("TYPE", name, Syntax.Tail(tail)))
	| "CREATE"i & "XML"i & "SCHEMA"i & "COLLECTION"i & name: QualifiedName & tail: ("AS"i & ValueExpression)
		=> @(Statement.Defined("XML SCHEMA COLLECTION", name, Syntax.Tail(tail)))
	| "ALTER"i & "XML"i & "SCHEMA"i & "COLLECTION"i & name: QualifiedName & tail: ("ADD"i & ValueExpression)
		=> @(Statement.Defined("ALTER XML SCHEMA COLLECTION", name, Syntax.Tail(tail)))
	| "CREATE"i & "SYNONYM"i & synonym: SynonymName & tail: ("FOR"i & Identifier & ('.'+ & Identifier)*)
		=> @(Statement.Defined("SYNONYM", synonym, Syntax.Tail(tail)))

TableTypeBody : @Clause[] = '(' & body: TableBody & ')' & when @(Syntax.TableTyped(body)) => @(body)

SynonymName : @string = t: (Identifier & ('.' & Identifier)?) => @(t)

// ── Sequences ───────────────────────────────────────────────────────────────
//
// Created and altered, put to the engine some sixty times and kept as every object here is,
// the options as nodes where the engine counts them. A sequence is named by two parts at most
// (`Msg 166`). Its options stand in any order and without commas, each group once — a value
// and its `NO` are one group, and two of a group are `Msg 11712`. A value is a number, signed
// or not and with a fraction or without, and nothing more: not a variable, an expression, a
// bracket, a string or an exponent; `MINVALUE` and `MAXVALUE` want theirs, the block
// notwithstanding. A cache is a number or none. A sequence created is not restarted
// (`Msg 11709`); one altered does not start, does not change its type (`Msg 11710`, `11711`)
// and changes something (`Msg 11715`).
SequenceStatement : @Statement
	= "CREATE"i & "SEQUENCE"i & name: SequenceName & tail: (options: SequenceOption*)
	  & when @(Syntax.NamedOnce(null, options) && !Syntax.HasOption(options, "RESTART"))
		=> @(Statement.Defined("SEQUENCE", name, Syntax.Tail(tail), "CREATE", options))
	| "ALTER"i & "SEQUENCE"i & name: SequenceName & tail: (options: SequenceOption+)
	  & when @(Syntax.NamedOnce(null, options) && !Syntax.HasOption(options, "START") && !Syntax.HasOption(options, "AS"))
		=> @(Statement.Defined("SEQUENCE", name, Syntax.Tail(tail), "ALTER", options))

SequenceName : @string = t: (Identifier & ('.' & Identifier)?) => @(t)

SequenceOption : @Clause
	= "AS"i & DataType                          => @(new Clause.Option("AS", null, Clause.None))
	| "START"i & "WITH"i & v: SequenceValue      => @(new Clause.Option("START", v, Clause.None))
	| "RESTART"i & ("WITH"i & v: SequenceValue)? => @(new Clause.Option("RESTART", v, Clause.None))
	| "INCREMENT"i & "BY"i & v: SequenceValue    => @(new Clause.Option("INCREMENT", v, Clause.None))
	| "MINVALUE"i & v: SequenceValue             => @(new Clause.Option("MINVALUE", v, Clause.None))
	| "MAXVALUE"i & v: SequenceValue             => @(new Clause.Option("MAXVALUE", v, Clause.None))
	| "CACHE"i & t: ExactNumber?
		=> @(new Clause.Option("CACHE", t is null ? null : new Expression.Literal(SqlLiteralKind.Number, t), Clause.None))
	| "CYCLE"i                                   => @(new Clause.Option("CYCLE", null, Clause.None))
	| "NO"i & w: ("MINVALUE"i | "MAXVALUE"i | "CYCLE"i | "CACHE"i)
		=> @(new Clause.Option(Syntax.Squared(w), null, Clause.None))

SequenceValue : @Expression
	= t: (('+' | '-')? & Sql92.Lexical.UnsignedNumericLiteral) & when @(t is not null && t.IndexOfAny(new[] { 'e', 'E' }) < 0)
		=> @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))

// ── Partitions ──────────────────────────────────────────────────────────────
//
// A function and a scheme, each created and altered, put to the engine some sixty times. Kept
// as every object here is, a name and the words after it. Both are named by one part.
//
// A function takes one type — none and two are refused (`Msg 7702`, `7703`) — and its
// boundaries are any values, a query's and a call's among them, `NULL` too and `DEFAULT` not, or
// none at all. One is split or merged at a time, and the function is named with its empty
// brackets. A scheme's filegroups are one or more, a name or a string, `[PRIMARY]` in its
// brackets since the word is reserved; the next one used is one or none.
PartitionStatement : @Statement
	= "CREATE"i & "PARTITION"i & "FUNCTION"i & name: Identifier
	  & tail: ('(' & DataType & ')' & "AS"i & "RANGE"i & ("LEFT"i | "RIGHT"i)? & "FOR"i & "VALUES"i
			   & '(' & (PartitionBoundary & (',' & PartitionBoundary)*)? & ')')
		=> @(Statement.Defined("PARTITION FUNCTION", name, Syntax.Tail(tail)))
	| "ALTER"i & "PARTITION"i & "FUNCTION"i & name: Identifier
	  & tail: ('(' & ')' & ("SPLIT"i | "MERGE"i) & "RANGE"i & '(' & PartitionBoundary & ')')
		=> @(Statement.Defined("ALTER PARTITION FUNCTION", name, Syntax.Tail(tail)))
	| "CREATE"i & "PARTITION"i & "SCHEME"i & name: Identifier
	  & tail: ("AS"i & "PARTITION"i & Identifier & "ALL"i? & "TO"i
			   & '(' & PartitionFileGroup & (',' & PartitionFileGroup)* & ')')
		=> @(Statement.Defined("PARTITION SCHEME", name, Syntax.Tail(tail)))
	| "ALTER"i & "PARTITION"i & "SCHEME"i & name: Identifier & tail: ("NEXT"i & "USED"i & PartitionFileGroup?)
		=> @(Statement.Defined("ALTER PARTITION SCHEME", name, Syntax.Tail(tail)))

PartitionBoundary  = "NULL"i | ValueExpression
PartitionFileGroup = Identifier | Quoted

// ── The server's configuration ──────────────────────────────────────────────
//
// Two statements that name nothing and change the server, put to the engine some hundred and
// fifty times. Kept as every object is, the words after the phrase as its tail.
//
// The governor is reconfigured, disabled, has its statistics reset, or is given one setting in
// brackets — two are refused, in either order — and any of those may be followed by
// `RECONFIGURE`; `RECONFIGURE RESET STATISTICS` may not. Its classifier is a function named
// by two parts exactly, or `NULL`; its I/O limit a number neither negative nor approximate, or
// `DEFAULT`.
//
// The configuration is one setting after `SET`, as its block writes it, and no more: an
// affinity's processors are whole numbers and ranges of them, `AUTO` for processors only; a
// log's size is in megabytes; a cluster's properties are the seven the block names, the path
// and the connection options a string and the rest a number; a buffer pool's extension says
// its file and then its size, in a unit. `HARDWARE_OFFLOAD` is refused by the engine on this
// server, the block's syntax notwithstanding, and is not read.
ServerStatement : @Statement
	= "ALTER"i & "RESOURCE"i & "GOVERNOR"i & tail: (GovernorAction & "RECONFIGURE"i?)
		=> @(Statement.Defined("ALTER RESOURCE GOVERNOR", "", Syntax.Tail(tail)))
	| "ALTER"i & "SERVER"i & "CONFIGURATION"i & tail: ("SET"i & ServerSetting)
		=> @(Statement.Defined("ALTER SERVER CONFIGURATION", "", Syntax.Tail(tail)))

GovernorAction = "RECONFIGURE"i | "DISABLE"i | "RESET"i & "STATISTICS"i | "WITH"i & '(' & GovernorSetting & ')'

GovernorSetting = "CLASSIFIER_FUNCTION"i & '=' & ("NULL"i | Identifier & '.' & Identifier)
				| "MAX_OUTSTANDING_IO_PER_VOLUME"i & '=' & (ExactNumber | "DEFAULT"i)

// A number with no exponent. A rule of its own and a guard, because an exponent is the one
// thing that tells the two apart and the lexer reads both as one kind.
ExactNumber : @string = t: Sql92.Lexical.UnsignedNumericLiteral & when @(t is not null && t.IndexOfAny(new[] { 'e', 'E' }) < 0) => @(t)

ServerSetting
	= "PROCESS"i & "AFFINITY"i & ("CPU"i & '=' & ("AUTO"i | ServerRanges) | "NUMANODE"i & '=' & ServerRanges)
	| "DIAGNOSTICS"i & "LOG"i
	  & ("ON"i | "OFF"i
		| "PATH"i & '=' & (BrokerString | "DEFAULT"i)
		| "MAX_SIZE"i & '=' & (Sql92.Lexical.Digits & "MB"i | "DEFAULT"i)
		| "MAX_FILES"i & '=' & (Sql92.Lexical.Digits | "DEFAULT"i))
	| "FAILOVER"i & "CLUSTER"i & "PROPERTY"i & ClusterProperty
	| "HADR"i & "CLUSTER"i & "CONTEXT"i & '=' & (BrokerString | "LOCAL"i)
	| "BUFFER"i & "POOL"i & "EXTENSION"i
	  & ("OFF"i | "ON"i & '(' & "FILENAME"i & '=' & BrokerString & ',' & "SIZE"i & '=' & Sql92.Lexical.Digits
				   & ("KB"i | "MB"i | "GB"i) & ')')
	| "SOFTNUMA"i & OnOff
	| "MEMORY_OPTIMIZED"i
	  & ("ON"i | "OFF"i
		| "TEMPDB_METADATA"i & '=' & ("ON"i & ('(' & "RESOURCE_POOL"i & '=' & BrokerString & ')')? | "OFF"i)
		| "HYBRID_BUFFER_POOL"i & '=' & OnOff)
	| "SUSPEND_FOR_SNAPSHOT_BACKUP"i & '=' & OnOff & ('(' & SnapshotScope & ')')?

ServerRanges = ServerRange & (',' & ServerRange)*
ServerRange  = Sql92.Lexical.Digits & ("TO"i & Sql92.Lexical.Digits)?

ClusterProperty
	= ("SqlDumperDumpPath"i | "ClusterConnectionOptions"i) & '=' & (BrokerString | "DEFAULT"i)
	| ("VerboseLogging"i | "SqlDumperDumpFlags"i | "SqlDumperDumpTimeOut"i | "FailureConditionLevel"i | "HealthCheckTimeout"i)
	  & '=' & (Sql92.Lexical.Digits | "DEFAULT"i)

SnapshotScope = "GROUP"i & '=' & '(' & Identifier & (',' & Identifier)* & ')' & (',' & "MODE"i & '=' & "COPY_ONLY"i)?
			  | "MODE"i & '=' & "COPY_ONLY"i

// ── Service Broker ──────────────────────────────────────────────────────────
//
// Seven kinds of object and eight statements about conversations, put to the engine some three
// hundred times. The objects are kept the way every other object here is, a name and the
// words after it; what the engine counts in them — an option said twice, an activation short
// of what it needs — is asked of the options as nodes.
//
// A message type is validated by any word, which the engine does not check until it runs, and
// `VALID_XML` wants its schema collection. A contract lists its messages and who sends each, in
// brackets and at least one; `[DEFAULT]` is a message's name and a bare `DEFAULT` is refused.
// A queue created may say its activation only in full — the procedure, how many read and whom
// they run as — where one altered may say any of it, or drop it; an altered queue is changed
// one way at a time. A route's settings are strings but its lifetime, and one created says
// where it goes. A binding names its user, bare. A priority's names are one part or `ANY`, the
// remote service a string or `ANY`, the level a number or `DEFAULT`. Every list is separated
// by commas and names each thing once.
BrokerStatement : @Statement
	= "CREATE"i & "MESSAGE"i & "TYPE"i & name: Identifier & tail: (Authorization? & MessageValidation?)
		=> @(Statement.Defined("MESSAGE TYPE", name, Syntax.Tail(tail), "CREATE"))
	| "ALTER"i & "MESSAGE"i & "TYPE"i & name: Identifier & tail: MessageValidation
		=> @(Statement.Defined("MESSAGE TYPE", name, Syntax.Tail(tail), "ALTER"))
	| "CREATE"i & "CONTRACT"i & name: Identifier
	  & tail: (Authorization? & '(' & ContractMessage & (',' & ContractMessage)* & ')')
		=> @(Statement.Defined("CONTRACT", name, Syntax.Tail(tail)))
	| "CREATE"i & "QUEUE"i & name: QualifiedName & tail: (options: QueueWith? & ("ON"i & Identifier)?)
	  & when @(Syntax.NamedOnce(null, options) && Syntax.Activates(options))
		=> @(Statement.Defined("QUEUE", name, Syntax.Tail(tail), "CREATE", options))
	| "ALTER"i & "QUEUE"i & name: QualifiedName & tail: (options: QueueWith | QueueAction)
	  & when @(Syntax.NamedOnce(null, options))
		=> @(Statement.Defined("QUEUE", name, Syntax.Tail(tail), "ALTER", options))
	| "CREATE"i & "SERVICE"i & name: Identifier
	  & tail: (Authorization? & "ON"i & "QUEUE"i & QualifiedName & ('(' & Identifier & (',' & Identifier)* & ')')?)
		=> @(Statement.Defined("SERVICE", name, Syntax.Tail(tail), "CREATE"))
	| "ALTER"i & "SERVICE"i & name: Identifier
	  & tail: ("ON"i & "QUEUE"i & QualifiedName & ServiceChanges? | ServiceChanges)
		=> @(Statement.Defined("SERVICE", name, Syntax.Tail(tail), "ALTER"))
	| "CREATE"i & "ROUTE"i & name: Identifier & tail: (Authorization? & "WITH"i & options: RouteOptions)
	  & when @(Syntax.NamedOnce(null, options) && Syntax.HasOption(options, "ADDRESS"))
		=> @(Statement.Defined("ROUTE", name, Syntax.Tail(tail), "CREATE", options))
	| "ALTER"i & "ROUTE"i & name: Identifier & tail: ("WITH"i & options: RouteOptions)
	  & when @(Syntax.NamedOnce(null, options))
		=> @(Statement.Defined("ROUTE", name, Syntax.Tail(tail), "ALTER", options))
	| "CREATE"i & "REMOTE"i & "SERVICE"i & "BINDING"i & name: Identifier
	  & tail: (Authorization? & "TO"i & "SERVICE"i & BrokerString & "WITH"i & options: BindingOptions)
	  & when @(Syntax.NamedOnce(null, options) && Syntax.HasOption(options, "USER"))
		=> @(Statement.Defined("REMOTE SERVICE BINDING", name, Syntax.Tail(tail), "CREATE", options))
	| "ALTER"i & "REMOTE"i & "SERVICE"i & "BINDING"i & name: Identifier & tail: ("WITH"i & options: BindingOptions)
	  & when @(Syntax.NamedOnce(null, options))
		=> @(Statement.Defined("REMOTE SERVICE BINDING", name, Syntax.Tail(tail), "ALTER", options))
	| "CREATE"i & "BROKER"i & "PRIORITY"i & name: Identifier
	  & tail: ("FOR"i & "CONVERSATION"i & ("SET"i & '(' & options: PriorityOptions & ')')?)
	  & when @(Syntax.NamedOnce(null, options))
		=> @(Statement.Defined("BROKER PRIORITY", name, Syntax.Tail(tail), "CREATE", options))
	| "ALTER"i & "BROKER"i & "PRIORITY"i & name: Identifier
	  & tail: ("FOR"i & "CONVERSATION"i & "SET"i & '(' & options: PriorityOptions & ')')
	  & when @(Syntax.NamedOnce(null, options))
		=> @(Statement.Defined("BROKER PRIORITY", name, Syntax.Tail(tail), "ALTER", options))

MessageValidation = "VALIDATION"i & '=' & ("VALID_XML"i & "WITH"i & "SCHEMA"i & "COLLECTION"i & QualifiedName
										 | ?!"VALID_XML"i & Identifier)

ContractMessage = Identifier & "SENT"i & "BY"i & ("INITIATOR"i | "TARGET"i | "ANY"i)

QueueWith : @Clause[] = "WITH"i & first: QueueOption & (',' & rest: QueueOption)* => @(Syntax.Listed(first, rest))

QueueOption : @Clause
	= "STATUS"i & '=' & v: OnOff    => @(new Clause.Option("STATUS", new Expression.ColumnReference(v), Clause.None))
	| "RETENTION"i & '=' & v: OnOff => @(new Clause.Option("RETENTION", new Expression.ColumnReference(v), Clause.None))
	| "ACTIVATION"i & '(' & "DROP"i & ')'
		=> @(new Clause.Option("ACTIVATION", null, new Clause[] { new Clause.Option("DROP", null, Clause.None) }, null, true))
	| "ACTIVATION"i & '(' & first: Activation & (',' & rest: Activation)* & ')' & when @(Syntax.NamedOnce(first, rest))
		=> @(new Clause.Option("ACTIVATION", null, Syntax.Listed(first, rest), null, true))
	| "POISON_MESSAGE_HANDLING"i & '(' & "STATUS"i & '=' & v: OnOff & ')'
		=> @(new Clause.Option("POISON_MESSAGE_HANDLING", null,
				 new Clause[] { new Clause.Option("STATUS", new Expression.ColumnReference(v), Clause.None) }, null, true))

Activation : @Clause
	= "STATUS"i & '=' & o: OnOff
		=> @(new Clause.Option("STATUS", new Expression.ColumnReference(o), Clause.None))
	| "PROCEDURE_NAME"i & '=' & t: QualifiedName
		=> @(new Clause.Option("PROCEDURE_NAME", new Expression.ColumnReference(t), Clause.None))
	| "MAX_QUEUE_READERS"i & '=' & t: Sql92.Lexical.UnsignedNumericLiteral
		=> @(new Clause.Option("MAX_QUEUE_READERS", new Expression.Literal(SqlLiteralKind.Number, t), Clause.None))
	| "EXECUTE"i & "AS"i & t: ("SELF"i | "OWNER"i)
		=> @(new Clause.Option("EXECUTE AS", new Expression.ColumnReference(Syntax.Squared(t)), Clause.None, null, true))
	| "EXECUTE"i & "AS"i & t: Sql92.Lexical.CharacterStringLiteral
		=> @(new Clause.Option("EXECUTE AS", new Expression.Literal(SqlLiteralKind.Text, t), Clause.None, null, true))

QueueAction = "REBUILD"i & ("WITH"i & '(' & "MAXDOP"i & '=' & Number & ')')?
			| "REORGANIZE"i & ("WITH"i & '(' & "LOB_COMPACTION"i & '=' & OnOff & ')')?
			| "MOVE"i & "TO"i & Identifier

ServiceChanges = '(' & ServiceChange & (',' & ServiceChange)* & ')'
ServiceChange  = ("ADD"i | "DROP"i) & "CONTRACT"i & Identifier

RouteOptions : @Clause[] = first: RouteOption & (',' & rest: RouteOption)* => @(Syntax.Listed(first, rest))

RouteOption : @Clause
	= name: ("SERVICE_NAME"i | "BROKER_INSTANCE"i | "MIRROR_ADDRESS"i | "ADDRESS"i) & '=' & v: BrokerString
		=> @(new Clause.Option(Syntax.Squared(name), v, Clause.None))
	| "LIFETIME"i & '=' & t: Sql92.Lexical.UnsignedNumericLiteral
		=> @(new Clause.Option("LIFETIME", new Expression.Literal(SqlLiteralKind.Number, t), Clause.None))

BindingOptions : @Clause[] = first: BindingOption & (',' & rest: BindingOption)* => @(Syntax.Listed(first, rest))

BindingOption : @Clause
	= "USER"i & '=' & t: Identifier   => @(new Clause.Option("USER", new Expression.ColumnReference(t), Clause.None))
	| "ANONYMOUS"i & '=' & o: OnOff   => @(new Clause.Option("ANONYMOUS", new Expression.ColumnReference(o), Clause.None))

PriorityOptions : @Clause[] = first: PriorityOption & (',' & rest: PriorityOption)* => @(Syntax.Listed(first, rest))

PriorityOption : @Clause
	= name: ("CONTRACT_NAME"i | "LOCAL_SERVICE_NAME"i) & '=' & v: NameOrAny
		=> @(new Clause.Option(Syntax.Squared(name), v, Clause.None))
	| "REMOTE_SERVICE_NAME"i & '=' & v: StringOrAny
		=> @(new Clause.Option("REMOTE_SERVICE_NAME", v, Clause.None))
	| "PRIORITY_LEVEL"i & '=' & v: LevelOrDefault
		=> @(new Clause.Option("PRIORITY_LEVEL", v, Clause.None))

NameOrAny : @Expression = "ANY"i => @(new Expression.ColumnReference("ANY")) | t: Identifier => @(new Expression.ColumnReference(t))
StringOrAny : @Expression = "ANY"i => @(new Expression.ColumnReference("ANY")) | v: BrokerString => @(v)

LevelOrDefault : @Expression
	= "DEFAULT"i => @(new Expression.ColumnReference("DEFAULT"))
	| t: Sql92.Lexical.UnsignedNumericLiteral => @(new Expression.Literal(SqlLiteralKind.Number, t))

BrokerString : @Expression
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral         => @(new Expression.Literal(SqlLiteralKind.Text, t))

// A string or a variable, which is what the engine takes for a service it cannot see, a
// failure's description and the conversation `RECEIVE` is asked about.
BrokerTarget : @Expression = v: BrokerString => @(v) | t: TSql.Variable => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

// A conversation's handle is a value wherever it is not being made — `END CONVERSATION a`,
// `f()` and `@h + 1` are read — and only `BEGIN DIALOG` wants a variable, to put the handle
// in. The dialog is begun from a service named and to one written as a string, and a second
// string after a comma says which broker; its options are separated by commas, each said
// once, and relate it to a conversation or to a group, not both. A timer's handle is in
// brackets and its timeout follows `=`. A conversation is ended plainly, with `CLEANUP`, or
// with an error — a number or a variable, never negative — and its description, in that
// order and with no comma. `SEND` takes one handle bare or any in brackets, a message type by
// name and a body in brackets.
ConversationStatement : @Statement
	= "BEGIN"i & "DIALOG"i & said: "CONVERSATION"i? & handle: TSql.Variable
	  & "FROM"i & "SERVICE"i & from: QualifiedName & "TO"i & "SERVICE"i & to: BrokerTarget
	  & (',' & instance: BrokerTarget)? & ("ON"i & "CONTRACT"i & contract: QualifiedName)?
	  & options: DialogWith? & when @(Syntax.DialogAgrees(options))
		=> @(new Statement.BeginDialog(handle, said is not null, from, to, instance, contract, options ?? Clause.None))
	| "BEGIN"i & "CONVERSATION"i & "TIMER"i & '(' & h: ValueExpression & ')' & "TIMEOUT"i & '=' & timeout: ValueExpression
		=> @(new Statement.ConversationTimer(h, timeout))
	| "END"i & "CONVERSATION"i & h: ValueExpression & ending: EndConversationWith?
		=> @(ending is null ? new Statement.EndConversation(h) : ending with { Handle = h })
	| "MOVE"i & "CONVERSATION"i & h: ValueExpression & "TO"i & group: ValueExpression
		=> @(new Statement.MoveConversation(h, group))
	| "SEND"i & "ON"i & "CONVERSATION"i & targets: SendTargets & ("MESSAGE"i & "TYPE"i & type: QualifiedName)?
	  & ('(' & body: ValueExpression & ')')?
		=> @(targets with { MessageType = type, Body = body })
	| s: GetConversationGroup => @(s)
	| s: ReceiveStatement     => @(s)

DialogWith : @Clause[] = "WITH"i & first: DialogOption & (',' & rest: DialogOption)* => @(Syntax.Listed(first, rest))

DialogOption : @Clause
	= name: ("RELATED_CONVERSATION_GROUP"i | "RELATED_CONVERSATION"i | "LIFETIME"i) & '=' & v: ValueExpression
		=> @(new Clause.Option(Syntax.Squared(name), v, Clause.None))
	| "ENCRYPTION"i & '=' & t: OnOff
		=> @(new Clause.Option("ENCRYPTION", new Expression.ColumnReference(t), Clause.None))

EndConversationWith : @Statement.EndConversation
	= "WITH"i & "CLEANUP"i => @(new Statement.EndConversation(Expression.NullValue, Cleanup: true))
	| "WITH"i & "ERROR"i & '=' & e: ConversationError & "DESCRIPTION"i & '=' & d: BrokerTarget
		=> @(new Statement.EndConversation(Expression.NullValue, e, d))

ConversationError : @Expression
	= t: Sql92.Lexical.UnsignedNumericLiteral => @(new Expression.Literal(SqlLiteralKind.Number, t))
	| t: TSql.Variable                         => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

SendTargets : @Statement.Send
	= '(' & first: ValueExpression & (',' & rest: ValueExpression)* & ')'
		=> @(new Statement.Send(Syntax.Listed(first, rest), true))
	| v: ValueExpression => @(new Statement.Send(new[] { v }, false))

// `GET CONVERSATION GROUP` and `RECEIVE` stand alone or inside `WAITFOR ( … )`, and only
// there may a `TIMEOUT` follow, after a comma: a number, negative or not, or a variable.
GetConversationGroup : @Statement
	= "GET"i & "CONVERSATION"i & "GROUP"i & g: TSql.Variable & "FROM"i & q: QualifiedName
		=> @(new Statement.GetConversationGroup(g, q))

// `TOP` in brackets and nothing after it; columns as a select list has them, but for an alias
// written in front with `=` and a table's star; a queue named, with no alias or hints; the
// rows into a table variable; and `WHERE` one comparison, of one of two columns written bare
// on its left, with a string or a variable. No `DISTINCT` and no `ORDER BY`.
ReceiveStatement : @Statement
	= "RECEIVE"i & top: ReceiveTop? & first: ReceiveColumn & (',' & rest: ReceiveColumn)* & "FROM"i & q: QualifiedName
	  & ("INTO"i & into: TSql.Variable)? & ("WHERE"i & where: ReceiveWhere)?
		=> @(new Statement.Receive(top, Syntax.Listed(first, rest), q, into, where))

ReceiveTop : @Clause = "TOP"i & '(' & v: ValueExpression & ')' => @(Clause.Topped(new Expression.Parenthesized(v), null))

ReceiveColumn : @Clause
	= '*'                                                     => @(new Clause.QualifiedAsterisk(null))
	| into: TSql.Variable & by: AssignOp & v: ValueExpression => @(new Clause.VariableAssignment(into, by, v))
	| v: ValueExpression & alias: TSqlAsClause?               => @(new Clause.DerivedColumn(v, alias))

ReceiveWhere : @Expression
	= t: ("CONVERSATION_HANDLE"i | "CONVERSATION_GROUP_ID"i) & '=' & v: BrokerTarget
		=> @(new Expression.Comparison(new Expression.ColumnReference(t), SqlComparison.Equal, v))

WaitedFor : @Statement = s: ReceiveStatement => @(s) | s: GetConversationGroup => @(s)

WaitTimeout : @Expression
	= t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| t: TSql.Variable                                  => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

// ── DBCC ────────────────────────────────────────────────────────────────────
//
// The engine reads every DBCC one way, the thirty-nine it documents and the ones it does not —
// `DBCC PAGE`, `DBCC FOO` — so this is that one way, and not a catalogue of commands, which
// would refuse what the engine reads. Put to it some two hundred times.
//
// The command is a word: not a delimited name, a qualified one or a variable. What stands in
// its brackets is nothing or a list, each a number, negative or not (`- 1` with a space, never
// `+1`), money, a string, binary, `NULL`, a variable, or a name of one part that is not
// reserved — or one of those given a name, `SIZE = 10`, `@p = 1`, the name bare. Not an
// expression, a call, `DEFAULT` (`Msg 1009`), `a.b` or a bracket inside. After `WITH`, a list
// of words, each at most a word: `MAXDOP` alone takes a value, a number neither negative nor
// approximate, and `WAIT_AT_LOW_PRIORITY` alone a list of its own, of `MAX_DURATION` in
// minutes and `ABORT_AFTER_WAIT` and any word, each named once (`Msg 401`).
DbccStatement : @Statement
	= "DBCC"i & name: DbccWord & args: DbccArguments? & options: DbccOptions?
		=> @(new Statement.Dbcc(name, args, options ?? Clause.None))

DbccWord : @string = t: Identifier & when @(Syntax.IsBare(t)) => @(t)

DbccArguments : @Expression[]
	= '(' & ')' => @(System.Array.Empty<Expression>())
	| '(' & first: DbccArgument & (',' & rest: DbccArgument)* & ')' => @(Syntax.Listed(first, rest))

DbccArgument : @Expression
	= name: DbccWord & '=' & v: DbccValue          => @(new Expression.NamedArgument(name, v))
	| variable: TSql.Variable & '=' & v: DbccValue => @(new Expression.NamedArgument(variable, v))
	| v: DbccValue                                 => @(v)

DbccValue : @Expression
	= t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| t: TSql.MoneyLiteral                              => @(new Expression.Literal(SqlLiteralKind.Number, t))
	| t: Sql92.Lexical.NationalCharacterStringLiteral   => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral           => @(new Expression.Literal(SqlLiteralKind.Text, t))
	| t: TSql.BinaryLiteral                             => @(new Expression.Literal(SqlLiteralKind.Hex, t))
	| "NULL"i                                           => @(Expression.NullValue)
	| t: TSql.Variable                                  => @(new Expression.Literal(SqlLiteralKind.Parameter, t))
	| t: Identifier                                     => @(new Expression.ColumnReference(t))

DbccOptions : @Clause[] = "WITH"i & first: DbccOption & (',' & rest: DbccOption)* => @(Syntax.Listed(first, rest))

DbccOption : @Clause
	= "MAXDOP"i & '=' & t: Sql92.Lexical.UnsignedNumericLiteral & when @(t is not null && t.IndexOfAny(new[] { 'e', 'E' }) < 0)
		=> @(new Clause.Option("MAXDOP", new Expression.Literal(SqlLiteralKind.Number, t), Clause.None))
	| "WAIT_AT_LOW_PRIORITY"i & '(' & first: DbccWait & (',' & rest: DbccWait)* & ')' & when @(Syntax.NamedOnce(first, rest))
		=> @(new Clause.Option("WAIT_AT_LOW_PRIORITY", null, Syntax.Listed(first, rest), null, true))
	| name: DbccWord => @(new Clause.Option(Syntax.Squared(name), null, Clause.None))

DbccWait : @Clause
	= "MAX_DURATION"i & '=' & t: Sql92.Lexical.UnsignedNumericLiteral & u: "MINUTES"i?
		=> @(new Clause.Option("MAX_DURATION", Syntax.Measured(new Expression.Literal(SqlLiteralKind.Number, t), u), Clause.None))
	| "ABORT_AFTER_WAIT"i & '=' & w: DbccWord
		=> @(new Clause.Option("ABORT_AFTER_WAIT", new Expression.ColumnReference(Syntax.Squared(w)), Clause.None))

// ── Cursors ─────────────────────────────────────────────────────────────────
//
// Put to the engine some two hundred times, every pair of words among them. A cursor is
// declared the standard's way, `INSENSITIVE` and `SCROLL` before `CURSOR`, or T-SQL's, its
// words after it — never both (`Msg 1049`) — and a variable is set to one only T-SQL's way.
// A word may be said twice and in any order; which words agree is `Syntax.CursorAgrees`.
CursorDefinition : @Clause.CursorDefinition
	= before: CursorIsoWord+ & "CURSOR"i & "FOR"i & q: CursorQuery
	  & when @(Syntax.CursorAgrees(before, q?.Access))
		=> @(q with { Before = before ?? System.Array.Empty<string>() })
	| "CURSOR"i & options: CursorOption* & "FOR"i & q: CursorQuery
	  & when @(Syntax.CursorAgrees(options, q?.Access))
		=> @(q with { Options = options ?? System.Array.Empty<string>() })

// The same T-SQL form, where a variable is set to it: `READ_ONLY` and `FOR READ ONLY` are read
// together here, and refused together in a declaration (`Msg 1058`).
CursorInPlace : @Clause.CursorDefinition
	= "CURSOR"i & options: CursorOption* & "FOR"i & q: CursorQuery
	  & when @(Syntax.CursorAgrees(options, q?.Access, false))
		=> @(q with { Options = options ?? System.Array.Empty<string>() })

CursorIsoWord : @string = t: ("INSENSITIVE"i | "SCROLL"i) => @(Syntax.Squared(t))

CursorOption : @string
	= t: ("LOCAL"i | "GLOBAL"i | "FORWARD_ONLY"i | "SCROLL_LOCKS"i | "SCROLL"i | "STATIC"i | "KEYSET"i
		| "DYNAMIC"i | "FAST_FORWARD"i | "READ_ONLY"i | "OPTIMISTIC"i | "TYPE_WARNING"i)
		=> @(Syntax.Squared(t))

// The query is a whole select — its common table expressions, its order and its hints — and
// not a shape: `FOR XML`, `FOR JSON` and `FOR BROWSE` are refused (`Msg 6819`, `13602`,
// `16907`), and so are `INTO` (`Msg 154`) and `VALUES` (`Msg 156`). After it comes `FOR READ
// ONLY` or `FOR UPDATE`, one of them, before the hints or after: the engine reads both.
CursorQuery : @Clause.CursorDefinition
	= with: WithClause? & q: CursorSelect & f: CursorFor & hints: QueryHints
		=> @(Syntax.Cursor(with, q, f, hints, true))
	| with: WithClause? & q: CursorSelect & hints: QueryHints? & f: CursorFor?
		=> @(Syntax.Cursor(with, q, f, hints, false))

CursorSelect : @Query
	= q: QueryExpression & by: OrderByClause? & window: OffsetFetch? & when @(Syntax.Cursorable(q))
		=> @(Syntax.Ordered(q, Clause.Ordered(by, window), null))

CursorFor : @Clause
	= "FOR"i & "READ"i & "ONLY"i => @(new Clause.CursorFor(false))
	| "FOR"i & "UPDATE"i & columns: CursorColumns? => @(new Clause.CursorFor(true, columns))

// A name each, typed: a text rule captured in a repetition is the turns' text joined (§10).
CursorColumns : @string[] = "OF"i & first: CursorColumn & (',' & rest: CursorColumn)* => @(Syntax.Named(first, rest))
CursorColumn  : @string   = t: QualifiedName => @(t)

// A cursor is named by one part, `GLOBAL` before it where it is the connection's, or held in a
// variable, which `GLOBAL` never stands before; and it may be called `GLOBAL` — `OPEN GLOBAL`
// opens it. `FETCH` may say which row, and `FROM` after that is not optional. The row of
// `ABSOLUTE` and `RELATIVE` is a number, negative or not, or a variable, and nothing more: not
// `+1`, `(1)`, `1 + 1` or `1e1`. It goes into variables and into nothing else. A variable is
// any but the server's own, which the engine refuses in all three places: `@@x` is read,
// `@@ROWCOUNT` is not.
CursorStatement : @Statement
	= "OPEN"i & ?!KeyWord & c: CursorName  => @(c with { Verb = "OPEN" })
	| "CLOSE"i & ?!KeyWord & c: CursorName => @(c with { Verb = "CLOSE" })
	| "DEALLOCATE"i & c: CursorName => @(c with { Verb = "DEALLOCATE" })
	| "FETCH"i & t: ("NEXT"i | "PRIOR"i | "FIRST"i | "LAST"i) & "FROM"i & c: CursorName & into: FetchInto?
		=> @(new Statement.Fetch(Syntax.Squared(t), null, true, c.Cursor, c.Global, into))
	| "FETCH"i & t: ("ABSOLUTE"i | "RELATIVE"i) & n: FetchRow & "FROM"i & c: CursorName & into: FetchInto?
		=> @(new Statement.Fetch(Syntax.Squared(t), n, true, c.Cursor, c.Global, into))
	| "FETCH"i & from: "FROM"i? & c: CursorName & into: FetchInto?
		=> @(new Statement.Fetch(null, null, from is not null, c.Cursor, c.Global, into))

// After `OPEN` and `CLOSE` these three begin a key's statement and not a cursor's name: `OPEN
// master` is refused, `OPEN [master]`, `OPEN GLOBAL master` and `DEALLOCATE master` are read.
KeyWord = "MASTER"i | "SYMMETRIC"i | "ASYMMETRIC"i

CursorName : @Statement.CursorAction
	= "GLOBAL"i & t: Identifier => @(new Statement.CursorAction("", new Expression.ColumnReference(t), true))
	| t: Identifier             => @(new Statement.CursorAction("", new Expression.ColumnReference(t), false))
	| v: LocalVariable          => @(new Statement.CursorAction("", v, false))

FetchRow : @Expression
	= t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral) & when @(t is not null && t.IndexOfAny(new[] { 'e', 'E' }) < 0)
		=> @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| v: LocalVariable => @(v)

FetchInto : @Expression[] = "INTO"i & first: LocalVariable & (',' & rest: LocalVariable)* => @(Syntax.Listed(first, rest))

LocalVariable : @Expression
	= t: TSql.Variable & when @(!Syntax.IsServerVariable(t)) => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

IndexOrder : @string = t: ("CLUSTERED"i | "NONCLUSTERED"i) => @(Syntax.Squared(t))

// `GENERATED ALWAYS AS { ROW | TRANSACTION_ID | SEQUENCE_NUMBER } { START | END }`, and
// `END` is a reserved word — so the two ends are named rather than read as identifiers,
// which is what the published syntax says they are anyway.
// What a generated column is generated from, and which end of it. The published block names
// three sources and two ends and nothing else: the row's period for a temporal table, and
// the transaction and sequence for a ledger one. `SUSER_SID` and `SUSER_SNAME` are in
// ScriptDom's grammar and in its tests, "temporal generated always as suser_sid start", and
// SQL Server 2025 refuses them at every level; no product was found that reads them. `HIDDEN`
// is the period columns' and is written after this, not as an option of any column.
GeneratedWhat = "ROW"i | "TRANSACTION_ID"i | "SEQUENCE_NUMBER"i
GeneratedWhen = "START"i | "END"i

// ── SET ─────────────────────────────────────────────────────────────────────
//
// Two constructions share the word, as Microsoft's reference has them: `SET @local_variable`,
// which assigns a variable, and the SET statements, which change the session. What follows
// `SET` in the second is a list of `SetExpression`s of one form — the engine refuses a switch
// among values, or a variable among either — each in the group Microsoft's page of the SET
// statements puts it in. Put to the engine some hundred times with its variables declared:
// every setting takes values of its own kind, and none an expression.
SetStatement : @Statement
	= "SET"i & name: TSql.Variable & '=' & d: CursorInPlace => @(new Statement.SetCursor(name, d))
	| "SET"i & name: TSql.Variable & ('.' & members: MemberName)+ & tail: MemberTail
	  & when @(tail is not { Operator: "" } || members is { Length: 1 })
		=> @(new Statement.SetVariable(Syntax.Member(name, members), tail.Value, tail.Operator))
	| "SET"i & name: TSql.Variable & s: AssignTail
		=> @(new Statement.SetVariable(name, s.Value, s.Operator, s.Through))
	| "SET"i & items: SetExpressions => @(new Statement.SetStatement(items))

// A variable's property is assigned, and its method called, the way a column's are in an
// `UPDATE`: `SET @g.STSrid = 4267`, `SET @x.modify('delete /a')`. A property may be a property's,
// `@g.a.b = 1`; a method is the variable's own, and `@x.a.b('a')` is refused. `DEFAULT` is not a
// value here (`Msg 4119`), and a list is not either.
MemberName : @string = t: Identifier => @(t)

MemberTail : @Clause.Set
	= '(' & args: Arguments? & ')' => @(new Clause.Set("", "", new Expression.RoutineInvocation("", args ?? Expression.None)))
	| s: AssignTail                => @(s)

// The forms with words of their own first, reserved words among them, each of them alone: the
// engine refuses `SET FIPS_FLAGGER OFF, DATEFIRST 7` and `SET DATEFIRST 7, ROWCOUNT 0`. Then
// the switches, and then the settings given values, which a list may name twice. A name alone
// is refused — `SET PARSEONLY` wants its `ON`.
//
// Every name is one the engine knows. It parses any word after `SET` and anything after that
// word to the end of the statement — `SET FOO, SELECT 1` passes `PARSEONLY` — and refuses the
// name when the statement runs: `Msg 195`, "not a recognized SET option", as it refuses `SET
// DATEFIRST ON`, `SET A, B 5` and a word of `STATISTICS` or `OFFSETS` it has not heard of.
// What is read here is what it runs.
SetExpressions : @SetExpression[]
	= ("TRANSACTION"i | "TRAN"i) & "ISOLATION"i & "LEVEL"i & level: IsolationLevel
		=> @(new SetExpression[] { new SetExpression.Transactions.IsolationLevel(level) })
	| "IDENTITY_INSERT"i & table: QualifiedName & on: OnOff
		=> @(new SetExpression[] { new SetExpression.Miscellaneous.IdentityInsert(table, Syntax.Switched(on)) })
	| "STATISTICS"i & kind: SetReport & (',' & kinds: SetReport)* & on: OnOff
		=> @(SetExpression.Reported(Syntax.Named(kind, kinds), Syntax.Switched(on)))
	| "OFFSETS"i & word: SetOffset & (',' & words: SetOffset)* & on: OnOff
		=> @(SetExpression.Offsets(Syntax.Named(word, words), Syntax.Switched(on)))
	| "ROWCOUNT"i & v: SetRowCount
		=> @(new SetExpression[] { new SetExpression.QueryExecution.RowCount(v) })
	| "TEXTSIZE"i & v: SetInteger
		=> @(new SetExpression[] { new SetExpression.QueryExecution.TextSize(v) })
	| "ERRLVL"i & v: SetInteger
		=> @(new SetExpression[] { new SetExpression.Miscellaneous.ErrorLevel(v) })
	| "FIPS_FLAGGER"i & "OFF"i
		=> @(new SetExpression[] { new SetExpression.Miscellaneous.FipsFlagger(new Expression.ColumnReference("OFF")) })
	| option: SetSwitch & (',' & options: SetSwitch)* & on: OnOff
		=> @(SetExpression.Switches(Syntax.Named(option, options), Syntax.Switched(on)))
	| first: SettingValue & (',' & rest: SettingValue)*
		=> @(Syntax.Listed(first, rest))

// The switches of Microsoft's pages, and `NO_BROWSETABLE`, which no page describes and the
// drivers send. `RESULT_SET_CACHING` is Synapse's and `RECOMMENDATIONS` Fabric's; SQL Server
// says it has not heard of either.
SetSwitch : @string = t: SetSwitchName => @(t)
SetSwitchName
	= "ANSI_DEFAULTS"i | "ANSI_NULL_DFLT_OFF"i | "ANSI_NULL_DFLT_ON"i | "ANSI_NULLS"i
	| "ANSI_PADDING"i | "ANSI_WARNINGS"i | "ARITHABORT"i | "ARITHIGNORE"i
	| "CONCAT_NULL_YIELDS_NULL"i | "CURSOR_CLOSE_ON_COMMIT"i | "FMTONLY"i | "FORCEPLAN"i
	| "IMPLICIT_TRANSACTIONS"i | "NO_BROWSETABLE"i | "NOCOUNT"i | "NOEXEC"i
	| "NUMERIC_ROUNDABORT"i | "PARSEONLY"i | "QUOTED_IDENTIFIER"i | "RECOMMENDATIONS"i
	| "REMOTE_PROC_TRANSACTIONS"i | "RESULT_SET_CACHING"i | "SHOWPLAN_ALL"i | "SHOWPLAN_TEXT"i | "SHOWPLAN_XML"i | "XACT_ABORT"i

// What `STATISTICS` reports, and the keywords `OFFSETS` returns: `PROC` and `EXEC` spelled
// short, and `COMPUTE`, which the page no longer has and the engine still knows. Longest first.
SetReport : @string = t: SetReportName => @(t)
SetReportName = "IO"i | "TIME"i | "PROFILE"i | "XML"i
SetOffset : @string = t: SetOffsetName => @(t)
SetOffsetName
	= "SELECT"i | "FROM"i | "ORDER"i | "COMPUTE"i | "TABLE"i | "PROCEDURE"i | "PROC"i
	| "STATEMENT"i | "PARAM"i | "EXECUTE"i | "EXEC"i

OnOff : @string = "ON"i => @("ON") | "OFF"i => @("OFF")

// A setting given a value, each the kind of value the engine takes for it.
SettingValue : @SetExpression
	= "DATEFIRST"i & v: SetConstant         => @(new SetExpression.DateAndTime.DateFirst(v))
	| "DATEFORMAT"i & v: SetConstant        => @(new SetExpression.DateAndTime.DateFormat(v))
	| "DEADLOCK_PRIORITY"i & v: SetConstant => @(new SetExpression.Locking.DeadlockPriority(v))
	| "LOCK_TIMEOUT"i & v: SetInteger       => @(new SetExpression.Locking.LockTimeout(v))
	| "LANGUAGE"i & v: SetConstant          => @(new SetExpression.Miscellaneous.Language(v))
	| "FIPS_FLAGGER"i & v: SetFipsLevel     => @(new SetExpression.Miscellaneous.FipsFlagger(v))
	| "CONTEXT_INFO"i & v: SetConstant      => @(new SetExpression.Miscellaneous.ContextInfo(v))
	| "QUERY_GOVERNOR_COST_LIMIT"i & v: SetNumber
		=> @(new SetExpression.QueryExecution.QueryGovernorCostLimit(v))

// A constant, a word or a variable: `DATEFIRST 1.5`, `DATEFORMAT dmy`, `LANGUAGE [us_english]`,
// `DEADLOCK_PRIORITY @v`. Not an expression — `DATEFIRST 7 + 1` is refused.
SetConstant : @Expression
	= t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral)  => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| t: Sql92.Lexical.NationalCharacterStringLiteral   => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral           => @(new Expression.Literal(SqlLiteralKind.Text, t))
	| t: TSql.BinaryLiteral                             => @(new Expression.Literal(SqlLiteralKind.Hex, t))
	| t: TSql.Variable                                  => @(new Expression.Literal(SqlLiteralKind.Parameter, t))
	| t: Identifier                                     => @(new Expression.ColumnReference(t))

// A whole number, negative or not: `LOCK_TIMEOUT -1`, `TEXTSIZE 2048`. No variable.
SetInteger : @Expression = t: ('-'? & Sql92.Lexical.Digits) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))

// A number, negative or not, a fraction included: `QUERY_GOVERNOR_COST_LIMIT 1.5`.
SetNumber : @Expression
	= t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))

// A number that is not negative, or a variable: `ROWCOUNT -1` is refused.
SetRowCount : @Expression
	= t: Sql92.Lexical.UnsignedNumericLiteral => @(new Expression.Literal(SqlLiteralKind.Number, t))
	| t: TSql.Variable                        => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

// A level in a string, never a national one. `OFF` is a form of its own, which stands alone:
// the engine reads `SET FIPS_FLAGGER 'FULL', DATEFIRST 7` and refuses it with `OFF`.
SetFipsLevel : @Expression
	= t: Sql92.Lexical.CharacterStringLiteral => @(new Expression.Literal(SqlLiteralKind.Text, t))

IsolationLevel = "READ"i & "UNCOMMITTED"i | "READ"i & "COMMITTED"i | "REPEATABLE"i & "READ"i
			   | "SNAPSHOT"i | "SERIALIZABLE"i

// ── Whom the session runs as ────────────────────────────────────────────────
//
// `EXECUTE AS`, `REVERT` and `SETUSER`, put to the engine some sixty times. A user or a login
// is any expression — a string, a variable, a call, a concatenation — and a caller the word
// alone; `SELF`, `OWNER` and a bare string are a module's, and refused here. After it, `WITH
// NO REVERT` or a cookie, one of the two: a first probe, its variable undeclared, had the
// engine read the cookie and then `NO REVERT`, which it refuses once the variable exists.
// `REVERT` shows the cookie as any expression, and `SETUSER` takes a string or a variable,
// and `WITH NORESET` only after one; a second cookie, or a second value after `SETUSER`, the
// engine refuses too.
SessionStatement : @Statement
	= ExecWord & "AS"i & who: SessionWho & w: SessionWith?
		=> @(w is null ? who : who with { NoRevert = w.NoRevert, Cookie = w.Cookie })
	| "REVERT"i & k: RevertCookie? => @(new Statement.Revert(k))
	| "SETUSER"i & n: SessionUser & r: SessionNoReset? => @(new Statement.SetUser(n, r is not null))
	| "SETUSER"i => @(new Statement.SetUser())

SessionWho : @Statement.ExecuteAs
	= "CALLER"i => @(new Statement.ExecuteAs("CALLER", null))
	| kind: SessionKind & '=' & v: ValueExpression => @(new Statement.ExecuteAs(kind, v))

// What follows whom: the node's own two fields and nothing of its kind, laid onto it above.
SessionWith : @Statement.ExecuteAs
	= "WITH"i & "NO"i & "REVERT"i => @(new Statement.ExecuteAs("", null, true))
	| "WITH"i & "COOKIE"i & "INTO"i & c: TSql.Variable
		=> @(new Statement.ExecuteAs("", null, false, new Expression.Literal(SqlLiteralKind.Parameter, c)))

SessionKind : @string = "USER"i => @("USER") | "LOGIN"i => @("LOGIN")

SessionNoReset = "WITH"i & "NORESET"i

RevertCookie : @Expression = "WITH"i & "COOKIE"i & '=' & c: ValueExpression => @(c)

SessionUser : @Expression
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral         => @(new Expression.Literal(SqlLiteralKind.Text, t))
	| t: TSql.Variable                                => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

// ── EXECUTE ─────────────────────────────────────────────────────────────────
ExecuteStatement : @Statement.Execute = ExecWord & e: ExecuteBody => @(e)

// A string run: the string, and after it the values its `?`s take, which only a linked
// server or a data source takes — `EXEC ('SELECT 1', 5, @a)` is refused and `EXEC ('SELECT ?',
// 1) AT srv` read. The context it runs in, `AS LOGIN = 'x'` or `AS USER = N'u'`, is a string's
// alone and stands before the server; a variable, an expression and `CALLER` are refused
// there, and so is a context on a procedure. A server and a data source are one part each.
ExecuteBody : @Statement.Execute
	= '(' & args: Arguments & ')' & context: ExecContext? & source: ExecDataSource? & at: ExecAt?
	  & when @((source is null || at is null) && (at is not null || source is not null || args is { Length: 1 }))
	  & with: ExecWith?
		=> @(new Statement.Execute(null, "(", args, context, at, source, Syntax.Tail(with)))
	| into: ExecReturn? & target: ExecTarget & args: ExecArguments? & at: ExecAt? & with: ExecWith?
		=> @(target with { Into = into, Arguments = args ?? Expression.None, At = at, Tail = Syntax.Tail(with) })

// A call without the word, which only a batch's first statement may be (`FirstPiece`): the
// same call but for `AT`, which the engine refuses there. A `GO` on a file's last line, which
// no line break ends and so no `GoLine` takes, opens an empty batch there and is the
// separator (`FinalGo`), not a procedure called `GO`.
BareCall : @Statement.Execute
	= ?!FinalGo & into: ExecReturn? & target: ExecTarget & args: ExecArguments? & with: ExecWith?
		=> @(target with { Into = into, Arguments = args ?? Expression.None, Tail = Syntax.Tail(with), Bare = true })

ExecWord   = "EXECUTE"i | "EXEC"i
ExecReturn : @string = t: TSql.Variable & '=' => @(t)
ExecName   : @string = t: QualifiedName => @(t) | t: TSql.Variable => @(t)

// A procedure is named, held in a variable, or on a server `OPENDATASOURCE` stands for.
ExecTarget : @Statement.Execute
	= server: AdHocServer & name: AdHocObject => @(new Statement.Execute(null, name, Expression.None, Server: server))
	| name: ExecName                          => @(new Statement.Execute(null, name, Expression.None))
ExecAt     : @string = "AT"i & t: Identifier => @(t)

ExecDataSource : @string = "AT"i & "DATA_SOURCE"i & t: Identifier => @(t)

ExecContext : @Clause
	= "AS"i & kind: ExecContextKind & '=' & name: ExecContextName
		=> @(new Clause.ExecutionContext(kind, name))

ExecContextKind : @string = t: ("LOGIN"i | "USER"i) => @(Syntax.Squared(t))

ExecContextName : @Expression
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral         => @(new Expression.Literal(SqlLiteralKind.Text, t))
ExecWith   = "WITH"i & ExecOption & (',' & ExecOption)*
ExecOption = "RESULT"i & "SETS"i & ResultSets
		   | Identifier

// A result set's columns are a table's, each with its type: a table's column may leave its
// type out and a result set's may not, `WITH RESULT SETS ((a, b))` being refused.
ResultColumns : @Clause[] = body: TableBody & when @(Syntax.Typed(body)) => @(body)

// `WITH RESULT SETS` says what comes back, and the three answers are none, undefined, or
// the shapes written out. Left-factored on the two words, which is what GRAM4016 asks for
// where alternatives share a head.
ResultSets = "NONE"i
		   | "UNDEFINED"i
		   | '(' & ResultSet & (',' & ResultSet)* & ')'

// One result set: its columns written out, or the name of something already shaped.
ResultSet = '(' & ResultColumns & ')'
		  | "AS"i & "OBJECT"i & QualifiedName
		  | "AS"i & "TYPE"i & QualifiedName
		  | "AS"i & "FOR"i & "XML"i

ExecArguments : @Expression[]
	= first: ExecArgument & (',' & rest: ExecArgument)* => @(Syntax.Listed(first, rest))

// The lookahead is the fifth of its kind and the first that is not about a name: `AT` is
// not reserved, so `EXEC dbo.p AT linked` read `AT` as an argument and then wanted the
// clause it had just eaten. The shape is the same wherever an optional list stands in
// front of a clause whose first word could belong to the list.
ExecArgument : @Expression
	= name: TSql.Variable & '=' & v: ExecValue & back: OutputWord? & when @(Syntax.Passes(v, back))
		=> @(Syntax.Hinted(new Expression.NamedArgument(name, v), back))
	| ?!"AT"i & v: ExecValue & back: OutputWord? & when @(Syntax.Passes(v, back))
		=> @(Syntax.Hinted(v, back))

// The two spellings of the same word, kept as the author wrote it.
OutputWord = "OUTPUT"i | "OUT"i

// What a procedure is passed is a constant, a variable or a name, and not an expression: the
// engine refuses `1 + 1`, `(1)`, a call, `-@a`, `+1`, `COLLATE` and a name of two parts, and
// reads a number or a money amount with one `-` before it, a string, a binary string, an ODBC
// literal, `NULL`, `DEFAULT`, a variable and a name of one part. Only a variable is passed
// back: `1 OUTPUT` is `Msg 179`. The values are a `DBCC` command's, and so is the rule.
ExecValue : @Expression
	= "DEFAULT"i => @(Expression.DefaultValue)
	| '{' & kind: OdbcLiteralKind & t: Sql92.Lexical.CharacterStringLiteral & '}'
		=> @(new Expression.OdbcEscape(kind, new Expression.Literal(SqlLiteralKind.Text, t)))
	| t: ('-' & TSql.MoneyLiteral) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| v: DbccValue                 => @(v)

// ── BULK INSERT ─────────────────────────────────────────────────────────────
BulkInsertStatement : @Statement
	= "BULK"i & "INSERT"i & target: DmlTarget & "FROM"i & file: ValueExpression
	  & ("WITH"i & '(' & first: BulkOption & (',' & rest: BulkOption)* & ')')?
		=> @(new Statement.Insert(target, null, new Query.FromFile(file, first is null ? null : Syntax.Listed(first, rest)), null, null, null, false))

// `ORDER (c1 ASC, c2 DESC)` is an option whose value is a sort, kept as the words; the
// rest are a name, and what it is set to or given in brackets.
BulkOption : @Clause
	= t: ("ORDER"i & '(' & SortSpecification & (',' & SortSpecification)* & ')')
		=> @(new Clause.Option(Syntax.Spaced(t), null, Clause.None))
	| name: Identifier & tail: BulkOptionTail? => @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

BulkOptionTail : @Clause.Option
	= '=' & v: ValueExpression   => @(new Clause.Option("", v, Clause.None))
	| '(' & a: Arguments & ')'   => @(new Clause.Option("", new Expression.RoutineInvocation("", a), Clause.None, null, true))

// ── A word and some values ──────────────────────────────────────────────────
SimpleCommand : @Statement
	= "PRINT"i & v: ValueExpression      => @(Statement.Commanded("PRINT", v))
	| "RETURN"i & v: ValueExpression?    => @(Statement.Commanded("RETURN", v))
	| "THROW"i & args: Arguments?        => @(Statement.Commanded("THROW", args))
	| "GOTO"i & name: Identifier         => @(Statement.Commanded("GOTO", new Expression.ColumnReference(name)))
	| "BREAK"i                           => @(Statement.Commanded("BREAK", (Expression?)null))
	| "CONTINUE"i                        => @(Statement.Commanded("CONTINUE", (Expression?)null))
	| "CHECKPOINT"i & v: ValueExpression? => @(Statement.Commanded("CHECKPOINT", v))
	| "USE"i & name: QualifiedName       => @(Statement.Commanded("USE", new Expression.ColumnReference(name)))
	| "RAISERROR"i & '(' & args: Arguments & ')' & how: RaiseWith?
		=> @(new Statement.RaiseError(args, Syntax.Tail(how)))
	| "RAISERROR"i & args: Arguments & how: RaiseWith?
		=> @(new Statement.RaiseError(args, Syntax.Tail(how)))
	| "WAITFOR"i & '(' & waited: WaitedFor & ')' & (',' & "TIMEOUT"i & timeout: WaitTimeout)?
		=> @(new Statement.WaitForStatement(waited, timeout))
	| "WAITFOR"i & t: Sql92.Lexical.TimeLiteral
		=> @(new Statement.WaitFor(new Expression.Literal(SqlLiteralKind.Text, t.Substring(t.IndexOf('\''))), "TIME"))
	| "WAITFOR"i & kind: WaitKind & v: WaitValue
		=> @(new Statement.WaitFor(v, Syntax.Squared(kind)))

RaiseWith = "WITH"i & Identifier & (',' & Identifier)*
WaitKind  = "DELAY"i | "TIME"i

// A string, a national one or a variable, and nothing else: `WAITFOR DELAY 1`, `(@t)` and
// `'1' + ''` are refused. `TIME '10:00'` is a time literal to the lexer and is read whole,
// above; with a national string or a variable after it, `TIME` is a word.
WaitValue : @Expression
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral         => @(new Expression.Literal(SqlLiteralKind.Text, t))
	| t: TSql.Variable                                => @(new Expression.Literal(SqlLiteralKind.Parameter, t))

// ── CREATE TABLE, and the column definitions everything shares ──────────────
//
// The largest single kind in the corpus, and the one that pulls the most behind it: a
// column definition is what `ALTER TABLE … ADD` adds and what `ALTER TABLE … ALTER COLUMN`
// changes, and the table body a variable declares is the same thing smaller.
//
// The option lists — `WITH (DATA_COMPRESSION = PAGE, …)`, `WITH (FILLFACTOR = 80)` — are
// written as a shape with an open vocabulary, as the table hints are and for the same
// reason: the names are a catalogue, and adding one to T-SQL does not change the grammar.
// `AS FileTable` stands before the columns and `AS NODE` after them, which is two
// syntaxes rather than one written twice; and a file table has no columns at all, its
// shape being the one the feature gives it.
CreateTableStatement : @Statement
	= "CREATE"i & "TABLE"i & name: QualifiedName & ('(' & columns: ColumnList & ')')?
	  & options: OptionsWith & "AS"i & q: DirectSelect
		=> @(new Statement.CreateTableAsSelect(name, columns, options, q))

	// Without its options a table made of a query names its columns, and that is what tells it
	// from a table declared: `CREATE TABLE t AS SELECT …` and `CREATE TABLE t (a INT) AS SELECT
	// …` are refused (`Msg 156`), and `CREATE TABLE t (a, b) AS SELECT …` is read.
	| "CREATE"i & "TABLE"i & name: QualifiedName & '(' & columns: ColumnList & ')' & "AS"i & q: DirectSelect
		=> @(new Statement.CreateTableAsSelect(name, columns, Clause.None, q))
	| "CREATE"i & "TABLE"i & name: QualifiedName & kind: TableAs? & '(' & body: TableBody & ','? & ')'
	  & after: TableAs? & placements: TablePlacement* & options: TableWith?
		=> @(new Statement.TableDefinition(name, kind ?? after, body, placements ?? Clause.None, options ?? Clause.None))
	| "CREATE"i & "TABLE"i & name: QualifiedName & kind: TableAs & placements: TablePlacement* & options: TableWith?
		=> @(new Statement.TableDefinition(name, kind, Clause.None, placements ?? Clause.None, options ?? Clause.None))

TableAs : @string = "AS"i & t: Identifier => @(t)

TablePlacement : @Clause
	// Large values go to a filegroup and not by a partition: `TEXTIMAGE_ON 'fg' (a)` is refused.
	= k: ("ON"i | "TEXTIMAGE_ON"i | "FILESTREAM_ON"i) & p: PlacementTarget
	  & when @(p is not { Columns: not null } || Syntax.Squared(k!) != "TEXTIMAGE_ON")
		=> @(p with { Kind = Syntax.Squared(k) })

// The target and, for a partition scheme, the column it partitions on. The word in front
// is the caller's to say: the same target stands after `ON`, after `MOVE TO`, and after
// `FILESTREAM_ON`. The engine reads the column after a string or a quoted name as after a
// scheme's: `ON 'fg' (a)`, `MOVE TO "default" (a)`.
PlacementTarget : @Clause.Placement
	= t: "DEFAULT"i                                => @(new Clause.Placement("", t, null))
	| t: Sql92.Lexical.CharacterStringLiteral & ('(' & c: ColumnList & ')')? => @(new Clause.Placement("", t, c))
	| t: Sql92.Lexical.DelimitedIdentifier & ('(' & c: ColumnList & ')')?    => @(new Clause.Placement("", t, c))
	| t: Identifier & ('(' & c: ColumnList & ')')? => @(new Clause.Placement("", t, c))

OptionsWith : @Clause[] = "WITH"i & '(' & o: OptionList & ')' => @(o)

// The same, where the statement keeps what it read as the words rather than as options.
OptionsWithText = "WITH"i & '(' & OptionList & ')'
OptionList  : @Clause[] = first: OptionSetting & (',' & rest: OptionSetting)* => @(Syntax.Listed(first, rest))

OptionSetting : @Clause
	= "DEFAULT"i & '=' & v: OptionValue => @(new Clause.Option("DEFAULT", v, Clause.None))
	| "MOVE"i & "TO"i & m: PlacementTarget => @(new Clause.Option("MOVE TO", null, new Clause[] { m }))

	// `AFFINITY SCHEDULER = AUTO`, `AFFINITY CPU = (0 TO 3)`,
	// `AFFINITY NUMANODE = (0)` — a value that is itself a name and a value.
	| name: ("AFFINITY"i & word?) & '=' & a: AffinityValue
		=> @(new Clause.Option(Syntax.Squared(name), new Expression.ColumnReference(a), Clause.None))

	// `RESAMPLE ON PARTITIONS (1, 3 TO 5)`: a name and a placement.
	| name: OptionName & p: OnPartitions => @(new Clause.Option(name, null, Clause.None, p))

	// `SAMPLE 50 PERCENT`, `SAMPLE 12 ROWS`. A run of words would read it whole
	// and does not: a number is a lexeme whose class holds a `.`, so it is not a
	// word however much §4.6 says a digit continues one.
	| "SAMPLE"i & v: ValueExpression & u: SampleUnit? => @(new Clause.Option("SAMPLE", Syntax.Measured(v, u), Clause.None))
	| t: ("PARTITION"i & '(' & Identifier & "RANGE"i & LeftOrRight?
		  & "FOR"i & "VALUES"i & '(' & Arguments? & ')' & ')')
		=> @(new Clause.Option(t, null, Clause.None))
	| name: OptionName & tail: OptionTail? => @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

// An option's name is not an identifier: `WITH (FILLFACTOR = 80)` names a word T-SQL
// reserves, and so do a dozen others. Nothing about it is a name of this language — it is
// a word standing inside brackets where only a word can stand — and that is what `word`
// says (§4.6). It was twelve reserved words written out beside `Identifier`, which was a
// catalogue of what SQL Server happened to have called its options and went stale on its
// own.
//
// A run of them, because the published syntax says a run in four places: `MOVE TO`,
// `CLUSTERED COLUMNSTORE INDEX`, `TRANSACTION ISOLATION LEVEL = SNAPSHOT` inside a
// `BEGIN ATOMIC WITH`, and the settings a `CREATE DATABASE` lists. Where it ends
// is the syntax: `ON` and `OFF` are what an option is set to rather than part of its
// name, and `WITH` begins the clause after the list.
OptionName = OptionWord+

OptionWord = ?!OptionEnd & word
OptionEnd  = "WITH"i | OnOff

// Two words at least, which is what tells a run from a name: one word is a name and a
// qualified one begins with a word, so a run of one would take `dbo` out of `dbo.h`.
// And a run of words is a value only where the comma or the bracket proves the run ended.
// Without that it takes the clause after an unbracketed list — `ALGORITHM = AES_256
// ENCRYPTION BY PASSWORD = 'p'` read the encryption as three more words of the algorithm.
// Where the list ends at the terminator its last value is one word, which is every value a
// list without brackets is written with.
OptionWords = OptionWord & OptionWord+ & ?=(',' | ')')

// A bare `ON` is a value only where the list goes on or ends. `CREATE INDEX … WITH
// PAD_INDEX ON ps (a)` is the old unbracketed `WITH` and then a placement, and without the
// lookahead the `ON` was read as what `PAD_INDEX` is set to — which GRAM5009 said, and the
// engine confirmed by refusing what came out.
// The list before the value: `CLEANUP_POLICY = (STALE_QUERY_THRESHOLD_DAYS = 367)` is a
// list and not an expression that happens to compare, and only the list reads it as one.
OptionTail : @Clause.Option
	= '=' & n: OptionNest & p: OnPartitions?   => @(new Clause.Option("", null, n, p))
	| '=' & v: OptionValue & n: OptionNest? & p: OnPartitions? => @(new Clause.Option("", v, n ?? Clause.None, p))
	| s: OnOff & o: SwitchTail                 => @(new Clause.Option("", new Expression.ColumnReference(s), o, null, true))
	| '(' & o: OptionList & ')'                => @(new Clause.Option("", null, o, null, true))

// Said as a refusal rather than as a demand, because a list without brackets ends at the
// terminator and a lookahead for a comma would refuse its last option. What a bare switch
// may not be followed by is a placement: `WITH PAD_INDEX ON ps (a)` is an option and then
// the filegroup it goes on, and `WITH TRUSTWORTHY ON` is an option set to on.
SwitchTail : @Clause[] = '(' & o: OptionList & ')' => @(o) | ?!PlacementTarget => @(Clause.None)

// The list a value may carry after it: `IGNORE_DUP_KEY = ON (SUPPRESS_MESSAGES = ON)`.
OptionNest : @Clause[] = '(' & o: OptionList & ')' => @(o)

// Typed, because what a setting is set to is the interesting half of `SET MAXDOP = 4`
// and the only half a name does not already say. `ON` and `OFF` are values here and not
// words of the language, so they arrive as themselves.
OptionValue : @Expression
	= "NULL"i => @(Expression.NullValue)
	| "OFF"i  => @(new Expression.ColumnReference("OFF"))
	| "ON"i   => @(new Expression.ColumnReference("ON"))
	| t: ('(' & Sql92.Lexical.UnsignedNumericLiteral+ & ')') => @(new Expression.ColumnReference(t))
	| '(' & a: Arguments & ')'  => @(new Expression.RoutineInvocation("", a))

	// A run of words, which several protocols spell their settings with:
	// `AUTHENTICATION = WINDOWS NTLM CERTIFICATE c`, `ENCRYPTION = SUPPORTED ALGORITHM AES
	// RC4`. In front of the expression, since a word is one and the run is longer; it stops
	// where an option's name does, which is what leaves `PAGE ON PARTITIONS (…)` alone.
	| w: OptionWords => @(new Expression.ColumnReference(w))

	| v: ValueExpression & u: OptionUnit? => @(Syntax.Measured(v, u))

	// And one word behind the expression, for the words a value may be that a name may
	// not: `MAXDOP = PRIMARY`, `QUERY_CAPTURE_MODE = ALL`.
	| w: word => @(new Expression.ColumnReference(w))

// A catalogue, and here the catalogue is the syntax: a unit is one of the words the
// language has for a size or a span, and nothing else may stand after a value. It was any
// identifier, and then `SET b = 5, c = 10 ACTION (…)` read `ACTION` as the unit of ten and
// lost the clause behind it — the same trap an optional at the end of a rule always is.
OptionUnit : @string = t: ("KB"i | "MB"i | "GB"i | "TB"i | "PB"i
		   | "SECOND"i | "SECONDS"i | "MINUTE"i | "MINUTES"i | "HOUR"i | "HOURS"i
		   | "DAY"i | "DAYS"i | "WEEK"i | "WEEKS"i | "MONTH"i | "MONTHS"i
		   | "YEAR"i | "YEARS"i
		   | "PERCENT"i | "ROWS"i
		   | '%') => @(t)

AffinityValue : @string
	= t: ("AUTO"i
		  | '(' & PartitionRange & (',' & PartitionRange)* & ')'
		  | word & '=' & '(' & PartitionRange & (',' & PartitionRange)* & ')') => @(t)

OnPartitions : @string
	= t: ("ON"i & "PARTITIONS"i & '(' & PartitionRange & (',' & PartitionRange)* & ')') => @(Syntax.Squared(t))
PartitionRange = ValueExpression & ("TO"i & ValueExpression)?

// ── The body ────────────────────────────────────────────────────────────────
TableBody : @Clause[]
	= first: TableElement & (',' & rest: TableElement)* => @(Syntax.Listed(first, rest))

TableElement : @Clause
	= "PERIOD"i & "FOR"i & "SYSTEM_TIME"i & '(' & columns: ColumnList & ')'
		=> @(Clause.Constrained("PERIOD FOR SYSTEM_TIME", Syntax.Columns(columns), null))
	| i: TableIndex                                => @(i)
	| "CONSTRAINT"i & name: Identifier & c: ConstraintBody => @(c with { Name = name })
	| c: ConstraintBody                            => @(c)
	| f: TableColumn                               => @(f)

ColumnDefinition : @Clause
	= name: Identifier & f: ColumnBody => @(f with { Name = name })

// A table's column, which may leave its type out: the published syntax allows it `timestamp`
// alone and the engine's parser any column, `Msg 173` — a definition must include a type —
// being said when the statement runs. Not before what belongs to a type (`Syntax.Untyped`),
// and not where a column is altered, which says its type again: `ALTER COLUMN timestamp` is
// refused, and `ALTER COLUMN c ADD ROWGUIDCOL` is not a column called `c` with no type.
TableColumn : @Clause
	= name: Identifier & f: TableColumnBody => @(f with { Name = name })

TableColumnBody : @Clause.ColumnDefinition
	= f: ColumnBody => @(f)
	| tail: ColumnTail* & when @(Syntax.Untyped(tail))
		=> @(new Clause.ColumnDefinition("", null, null, tail ?? Clause.None))

ColumnBody : @Clause.ColumnDefinition
	= "AS"i & v: ValueExpression & tail: ColumnTail*
		=> @(new Clause.ColumnDefinition("", null, v, tail ?? Clause.None))
	// A column's type may be sized `(MAX)` whatever the type is — `DECIMAL (MAX)`, `INT (MAX)`,
	// `DOUBLE PRECISION (MAX)` are read wherever a column is declared or altered, and refused
	// where a variable, a cast or a type is (`Msg 156`). The type's own size said, `MAX` is
	// one more: `NVARCHAR (MAX, 1)` and `DECIMAL (MAX, 2)` are refused.
	| type: DataType & max: ('(' & "MAX"i & ')')? & tail: ColumnTail*
		=> @(new Clause.ColumnDefinition("", max is null ? type : type + " " + Syntax.Spaced(max), null, tail ?? Clause.None))

// What may be said about a column after its type, each kept as what it is: an option, a
// constraint, or an index, in the order they were written.
ColumnTail : @Clause
	= t: "FILESTREAM"i                => @(Clause.Optioned(t))
	| "COLLATE"i & q: QualifiedName   => @(Clause.Optioned("COLLATE", new Expression.ColumnReference(q)))
	| t: "SPARSE"i                    => @(Clause.Optioned(t))
	| "MASKED"i & "WITH"i & '(' & o: OptionList & ')'
		=> @(new Clause.ColumnOption("MASKED", Expression.None, o, null))
	| "IDENTITY"i & ('(' & a: Arguments & ')')?
		=> @(new Clause.ColumnOption("IDENTITY", a ?? Expression.None, Clause.None, null))
	| t: ("NOT"i & "FOR"i & "REPLICATION"i) => @(Clause.Optioned(t))
	| s: NullSpec                     => @(Clause.Optioned(s))
	| t: ("GENERATED"i & "ALWAYS"i & "AS"i & GeneratedWhat & GeneratedWhen) & h: "HIDDEN"i?
		=> @(new Clause.ColumnOption(Syntax.Squared(t), Expression.None, Syntax.Unit(h), null))
	| t: "ROWGUIDCOL"i                => @(Clause.Optioned(t))
	| "ENCRYPTED"i & "WITH"i & '(' & o: OptionList & ')'
		=> @(new Clause.ColumnOption("ENCRYPTED", Expression.None, o, null))
	| t: "PERSISTED"i                 => @(Clause.Optioned(t))
	| t: ("COLUMN_SET"i & "FOR"i & "ALL_SPARSE_COLUMNS"i) => @(Clause.Optioned(t))
	| "CONSTRAINT"i & name: Identifier & n: NamedConstraint => @(Clause.Named(n, name))
	| c: ConstraintBody               => @(c)
	| i: TableIndex                   => @(i)

// The published syntax gives a nullability a constraint name of its own, and nothing else
// about a nullability suggests it can have one.
NamedConstraint : @Clause
	= t: NullSpec       => @(Clause.Optioned(t))
	| c: ConstraintBody => @(c)

NullSpec : @string = t: ("NOT"i & "NULL"i | "NULL"i) => @(Syntax.Squared(t))

// ── Constraints ─────────────────────────────────────────────────────────────
ConstraintBody : @Clause.ConstraintDefinition
	= "PRIMARY"i & "KEY"i & k: IndexOrder? & h: "HASH"i? & columns: IndexColumns?
	  & o: ConstraintWith? & p: IndexOn? & e: Enforced?
		=> @(Clause.Keyed("PRIMARY KEY", k, h, columns, o?.Options, p, e)
			 with { Bracketed = o is not { Bare: true } })
	| "UNIQUE"i & k: IndexOrder? & h: "HASH"i? & columns: IndexColumns?
	  & o: ConstraintWith? & p: IndexOn? & e: Enforced?
		=> @(Clause.Keyed("UNIQUE", k, h, columns, o?.Options, p, e)
			 with { Bracketed = o is not { Bare: true } })
	| "FOREIGN"i & "KEY"i & columns: IndexColumns? & r: References & e: Enforced?
		=> @(Clause.Constrained("FOREIGN KEY", columns, null) with { Referenced = r, Enforced = Syntax.Enforced(e) })
	| r: References & e: Enforced?
		=> @(Clause.Constrained("REFERENCES", null, null) with { Referenced = r, Enforced = Syntax.Enforced(e) })
	| "CHECK"i & n: ("NOT"i & "FOR"i & "REPLICATION"i)? & '(' & c: SearchCondition & ')'
		=> @(Clause.Constrained("CHECK", null, c) with { Options = Syntax.Unit(n) })
	| "CONNECTION"i & '(' & first: EdgePair & (',' & rest: EdgePair)* & ')' & a: ReferenceAction*
		=> @(Clause.Constrained("CONNECTION", null, null) with { Options = Syntax.Connected(first, rest, a) })
	| "DEFAULT"i & v: ValueExpression & ("FOR"i & f: Identifier)?
		=> @(Clause.Constrained("DEFAULT", null, v) with { ForColumn = f })

// A key a warehouse declares and does not check. Not the box's syntax and refused there,
// which is where the version chain will put it.
Enforced : @string = t: ("NOT"i? & "ENFORCED"i) => @(t)

// Which node tables an edge may join, which is the one constraint only a graph has.
EdgePair : @Clause = f: QualifiedName & "TO"i & t: QualifiedName => @(new Clause.Connection(f, t))

References : @Clause
	= "REFERENCES"i & t: QualifiedName & ('(' & c: ColumnList & ')')? & a: ReferenceAction*
		=> @(Syntax.Referenced(t, c, a))

ReferenceAction : @string
	= t: ("ON"i & DeleteOrUpdate & RefAction) => @(t)
	| t: ("NOT"i & "FOR"i & "REPLICATION"i)  => @(t)

DeleteOrUpdate = "DELETE"i | "UPDATE"i
RefAction      = "NO"i & "ACTION"i | "CASCADE"i | "SET"i & "NULL"i | "SET"i & "DEFAULT"i

IndexColumns : @Clause[] = '(' & first: IndexColumn & (',' & rest: IndexColumn)* & ')'
	=> @(Syntax.Listed(first, rest))

IndexColumn : @Clause
	= t: IndexName & o: ("ASC"i | "DESC"i)?
		=> @(new Clause.SortSpecification(new Expression.ColumnReference(t), Syntax.Ordered(o)))

// `$NODE_ID` and its fellows are columns a graph table has that nobody declared, and an
// index may be built on one.
IndexName : @string = t: Identifier => @(t) | t: PartitionName => @(t)

// The columns an index carries along, which may be a graph table's own: `INCLUDE ($NODE_ID)`.
IncludeColumns : @string[] = first: IndexName & (',' & rest: IndexName)* => @(Syntax.Named(first, rest))

// The current form and the one that predates it: `WITH (FILLFACTOR = 80, ONLINE = ON)`
// and the bare `WITH PAD_INDEX, FILLFACTOR = 80` SQL Server still reads.
// The modern spelling and the one it replaced, in one rule and not two. They are two
// syntaxes and not two layouts — without the brackets an option may stand as a word alone,
// `WITH FILLFACTOR = 23, PAD_INDEX`, and inside them it may not — so which was written is
// carried on `Bare`, an option that holds the list rather than being one.
//
// Two rules would not do. A rule takes its commit with its first token, so a bracketed
// rule of its own would take the `WITH`, find no bracket, and sink the alternative around
// it: six of the corpus's indexes stopped being read the afternoon that was tried.
IndexWith : @Clause.Option
	= "WITH"i & '(' & first: IndexOption & (',' & rest: IndexOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))
	| "WITH"i & first: OldIndexOption & (',' & rest: OldIndexOption)*
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest), null, true))

// ── The index options' catalogue ────────────────────────────────────────────
//
// One list for each place an index is built or rebuilt, as the published blocks give them
// and the engine settled wherever they leave anything open. They differ more than the
// blocks suggest: `OPTIMIZE_FOR_SEQUENTIAL_KEY` is `CREATE INDEX`'s and not `REBUILD`'s; a
// key in `CREATE TABLE` takes neither `ONLINE` nor `SORT_IN_TEMPDB`, and one `ALTER TABLE`
// adds takes both; an XML index takes `STATISTICS_NORECOMPUTE`, which its block does not
// name; and `IGNORE_DUP_KEY = ON` may carry `(SUPPRESS_MESSAGES = …)`, which no block names
// at all. A value is a literal — `FILLFACTOR = @f` is refused.
//
// Each list is a recognizer standing in front of the builder: what it names may be written,
// and the option is then built as every other is, so the tree and what prints it are the ones
// the round trip already holds. Inside brackets an option ends at a comma or at the bracket,
// because `ONLINE = ON (MAXDOP = 2)` begins like an option and is not one.

OptionEnds = ?=(',' | ')')

OnOffValue      = '=' & OnOff
Number          = Sql92.Lexical.UnsignedNumericLiteral
Minutes         = Number & "MINUTES"i?

// A delay may say its unit either way, which a duration may not: `COMPRESSION_DELAY = 1
// MINUTE` reads and `MAX_DURATION = 5 MINUTE` is refused.
DelayMinutes    = Number & ("MINUTES"i | "MINUTE"i)?
LowPriorityWait = "WAIT_AT_LOW_PRIORITY"i & '(' & "MAX_DURATION"i & '=' & Minutes & ','
				  & "ABORT_AFTER_WAIT"i & '=' & ("NONE"i | "SELF"i | "BLOCKERS"i) & ')'

RowCompression         = "NONE"i | "ROW"i | "PAGE"i
ColumnstoreCompression = "COLUMNSTORE"i | "COLUMNSTORE_ARCHIVE"i

PadIndex         = "PAD_INDEX"i & OnOffValue
FillFactor       = "FILLFACTOR"i & '=' & Number
SortInTempdb     = "SORT_IN_TEMPDB"i & OnOffValue
IgnoreDupKey     = "IGNORE_DUP_KEY"i & '=' & ("ON"i & ('(' & "SUPPRESS_MESSAGES"i & OnOffValue & ')')? | "OFF"i)
NoRecompute      = "STATISTICS_NORECOMPUTE"i & OnOffValue
IncrementalStats = "STATISTICS_INCREMENTAL"i & OnOffValue
DropExisting     = "DROP_EXISTING"i & OnOffValue
OnlineOption     = "ONLINE"i & '=' & ("ON"i & ('(' & LowPriorityWait & ')')? | "OFF"i)
OnlineOnOff      = "ONLINE"i & OnOffValue
Resumable        = "RESUMABLE"i & OnOffValue
MaxDuration      = "MAX_DURATION"i & '=' & Minutes
RowLocks         = "ALLOW_ROW_LOCKS"i & OnOffValue
PageLocks        = "ALLOW_PAGE_LOCKS"i & OnOffValue
SequentialKey    = "OPTIMIZE_FOR_SEQUENTIAL_KEY"i & OnOffValue
MaxDop           = "MAXDOP"i & '=' & Number
CompressionDelay = "COMPRESSION_DELAY"i & '=' & DelayMinutes
XmlCompression   = "XML_COMPRESSION"i & OnOffValue & OnPartitions?

// A memory-optimized hash index's size. The engine reads it wherever an index is built or
// rebuilt and objects later to one that is not a hash index, so it is in every such list.
BucketCount      = "BUCKET_COUNT"i & '=' & Number

RowDataCompression         = "DATA_COMPRESSION"i & '=' & RowCompression & OnPartitions?
ColumnstoreDataCompression = "DATA_COMPRESSION"i & '=' & ColumnstoreCompression & OnPartitions?
AnyDataCompression         = "DATA_COMPRESSION"i & '=' & (RowCompression | ColumnstoreCompression) & OnPartitions?

// `CREATE INDEX` on rows.
IndexOption : @Clause = ?=(IndexOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
IndexOptionSyntax
	= PadIndex | FillFactor | SortInTempdb | IgnoreDupKey | NoRecompute | IncrementalStats
	| DropExisting | OnlineOption | Resumable | MaxDuration | RowLocks | PageLocks | SequentialKey
	| MaxDop | RowDataCompression | XmlCompression | BucketCount

// The unbracketed list `CREATE INDEX` still reads, and only its six — `WITH ALLOW_ROW_LOCKS
// = ON` without brackets is refused.
OldIndexOption : @Clause = ?=OldIndexOptionSyntax & o: OptionSetting => @(o)
OldIndexOptionSyntax
	= ("PAD_INDEX"i | "SORT_IN_TEMPDB"i | "IGNORE_DUP_KEY"i | "STATISTICS_NORECOMPUTE"i | "DROP_EXISTING"i) & ?!'='
	| FillFactor

// A columnstore index's five.
ColumnstoreOption : @Clause = ?=(ColumnstoreOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
ColumnstoreOptionSyntax = DropExisting | MaxDop | OnlineOnOff | CompressionDelay | ColumnstoreDataCompression

ColumnstoreWith : @Clause.Option
	= "WITH"i & '(' & first: ColumnstoreOption & (',' & rest: ColumnstoreOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

// An XML index's, selective or not: never built online, never ignoring a duplicate, and
// compressed only as XML.
XmlIndexOption : @Clause = ?=(XmlIndexOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
XmlIndexOptionSyntax
	= PadIndex | FillFactor | SortInTempdb | "IGNORE_DUP_KEY"i & '=' & "OFF"i | DropExisting
	| "ONLINE"i & '=' & "OFF"i | RowLocks | PageLocks | MaxDop | XmlCompression | NoRecompute

XmlIndexWith : @Clause.Option
	= "WITH"i & '(' & first: XmlIndexOption & (',' & rest: XmlIndexOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

// An index written inside the table, which may be a columnstore and so takes a delay.
TableIndexOption : @Clause = ?=(TableIndexOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
TableIndexOptionSyntax = ConstraintOptionSyntax | CompressionDelay

TableIndexWith : @Clause.Option
	= "WITH"i & '(' & first: TableIndexOption & (',' & rest: TableIndexOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

// A primary key or a unique constraint in `CREATE TABLE`, and the one old spelling it keeps:
// `WITH FILLFACTOR = 80` alone.
ConstraintOption : @Clause = ?=(ConstraintOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
ConstraintOptionSyntax
	= PadIndex | FillFactor | IgnoreDupKey | NoRecompute | IncrementalStats | RowLocks | PageLocks
	| SequentialKey | AnyDataCompression | XmlCompression | BucketCount

FillFactorAlone : @Clause = ?=FillFactor & o: OptionSetting => @(o)

ConstraintWith : @Clause.Option
	= "WITH"i & '(' & first: ConstraintOption & (',' & rest: ConstraintOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))
	| "WITH"i & only: FillFactorAlone
		=> @(new Clause.Option("WITH", null, new Clause[] { only }, null, true))

// And one `ALTER TABLE` adds, which may be built online and resumed — put in place of the
// one above by `ALTER TABLE … ADD`, not written twice.
AlterConstraintOption : @Clause = ?=(AlterConstraintOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
AlterConstraintOptionSyntax
	= ConstraintOptionSyntax | SortInTempdb | MaxDop | OnlineOnOff | Resumable | MaxDuration

AlterConstraintWith : @Clause.Option
	= "WITH"i & '(' & first: AlterConstraintOption & (',' & rest: AlterConstraintOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))
	| "WITH"i & only: FillFactorAlone
		=> @(new Clause.Option("WITH", null, new Clause[] { only }, null, true))

// `ALTER INDEX`: a rebuild of every partition, of one, a reorganization, a resumption and
// the settings an index keeps.
RebuildOption : @Clause = ?=(RebuildOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
RebuildOptionSyntax
	= PadIndex | FillFactor | SortInTempdb | IgnoreDupKey | NoRecompute | IncrementalStats
	| OnlineOption | Resumable | MaxDuration | RowLocks | PageLocks | MaxDop | AnyDataCompression
	| XmlCompression | BucketCount

RebuildWith : @Clause.Option
	= "WITH"i & '(' & first: RebuildOption & (',' & rest: RebuildOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

PartitionRebuildOption : @Clause = ?=(PartitionRebuildOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
PartitionRebuildOptionSyntax
	= SortInTempdb | MaxDop | Resumable | MaxDuration | AnyDataCompression | XmlCompression | OnlineOption

PartitionRebuildWith : @Clause.Option
	= "WITH"i & '(' & first: PartitionRebuildOption & (',' & rest: PartitionRebuildOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

ReorganizeOption : @Clause = ?=(ReorganizeOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
ReorganizeOptionSyntax = "LOB_COMPACTION"i & OnOffValue | "COMPRESS_ALL_ROW_GROUPS"i & OnOffValue

ReorganizeWith : @Clause.Option
	= "WITH"i & '(' & first: ReorganizeOption & (',' & rest: ReorganizeOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

ResumeOption : @Clause = ?=(ResumeOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
ResumeOptionSyntax = MaxDop | MaxDuration | LowPriorityWait

ResumeWith : @Clause.Option
	= "WITH"i & '(' & first: ResumeOption & (',' & rest: ResumeOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

SetIndexOption : @Clause = ?=(SetIndexOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
SetIndexOptionSyntax = RowLocks | PageLocks | SequentialKey | IgnoreDupKey | NoRecompute | CompressionDelay

SetIndexOptions : @Clause[] = first: SetIndexOption & (',' & rest: SetIndexOption)* => @(Syntax.Listed(first, rest))

IndexOn : @Clause = "ON"i & p: PlacementTarget => @(p with { Kind = "ON" })

// ── An index written inside the table ───────────────────────────────────────
TableIndex : @Clause
	= "INDEX"i & name: Identifier & u: "UNIQUE"i? & c: IndexOrder? & s: "COLUMNSTORE"i? & h: "HASH"i?
	  & columns: IndexColumns?
	  & ("ORDER"i & '(' & order: ColumnList & ')')?
	  & ("INCLUDE"i & '(' & include: IncludeColumns & ')')?
	  & ("WHERE"i & filter: SearchCondition)?
	  & o: TableIndexWith? & p: IndexOn? & ("FILESTREAM_ON"i & f: PlacementTarget)?
		=> @(Clause.Indexed(name, u, c, s, h, columns, order, include, filter, o?.Options, (Clause.Placement?)p, f is null ? null : f with { Kind = "FILESTREAM_ON" })
			 with { Bracketed = o is not { Bare: true } })

// ── What a table is created with, and set to ────────────────────────────────
//
// `CREATE TABLE … WITH (…)`, `ALTER TABLE … SET (…)` and `ALTER TABLE … REBUILD WITH (…)`,
// from the published blocks and some two hundred probes. Three lists and not one: a table
// is created compressed, memory-optimized or ledgered and is not set so afterwards —
// `SET (DATA_COMPRESSION = PAGE)`, `SET (MEMORY_OPTIMIZED = ON)` and `SET (LEDGER = ON)` are
// refused — and only `SET` knows `LOCK_ESCALATION` and `FILESTREAM_ON`.
//
// The engine reads `DISTRIBUTION = HASH (a)`, `ROUND_ROBIN` and `REPLICATE`, which are
// Synapse's, and refuses the rest of what Synapse writes there: `HEAP`, `CLUSTERED
// COLUMNSTORE INDEX`, `CLUSTERED INDEX (a)`, `PARTITION (…)`. `DATA_DELETION` is Azure SQL
// Edge's: the engine refuses it, except with a unit it then finds wrong (47305), so it is
// written from its block and the audit names its product.
TableWith : @Clause[]
	= "WITH"i & '(' & first: TableOption & (',' & rest: TableOption)* & ')' => @(Syntax.Listed(first, rest))
TableOption : @Clause = ?=(TableOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
TableOptionSyntax
	= AnyDataCompression | XmlCompression
	| "MEMORY_OPTIMIZED"i & OnOffValue
	| "DURABILITY"i & '=' & ("SCHEMA_ONLY"i | "SCHEMA_AND_DATA"i)
	| Versioning | Ledger | DataDeletion | Stretch
	| "FILETABLE_DIRECTORY"i & '=' & Quoted
	| "FILETABLE_COLLATE_FILENAME"i & '=' & Identifier
	| ("FILETABLE_PRIMARY_KEY_CONSTRAINT_NAME"i | "FILETABLE_STREAMID_UNIQUE_CONSTRAINT_NAME"i
	  | "FILETABLE_FULLPATH_UNIQUE_CONSTRAINT_NAME"i) & '=' & Identifier
	| "DISTRIBUTION"i & '='
	  & ("HASH"i & '(' & Identifier & (',' & Identifier)* & ')' | "ROUND_ROBIN"i | "REPLICATE"i)

// What `ALTER TABLE … SET` may set, several at once. `FILESTREAM_ON` takes a name or a
// string, `"default"` and `"NULL"` among the names; a bare `NULL` is refused. A FileTable's
// directory is the one thing of its creation that may be set again.
TableSetting
	= "LOCK_ESCALATION"i & '=' & ("AUTO"i | "TABLE"i | "DISABLE"i)
	| "FILESTREAM_ON"i & '=' & (Quoted | Identifier)
	| "FILETABLE_DIRECTORY"i & '=' & Quoted
	| Versioning | DataDeletion | Stretch

// The history table and its retention, in any order. A unit the engine does not keep
// history in, `1 HOUR`, is read and objected to afterwards (13744), and so is a word that is
// no unit at all, `1 FOO` — which is refused here, where the option builder has no word for
// it.
Versioning
	= "SYSTEM_VERSIONING"i & '='
	  & ("OFF"i | "ON"i & ('(' & VersioningItem & (',' & VersioningItem)* & ')')?)
VersioningItem
	= "HISTORY_TABLE"i & '=' & QualifiedName
	| "HISTORY_RETENTION_PERIOD"i & '='
	  & ("INFINITE"i | '-'? & Sql92.Lexical.ExactNumericLiteral & PeriodUnit)
	| "DATA_CONSISTENCY_CHECK"i & OnOffValue
PeriodUnit
	= "DAY"i | "DAYS"i | "WEEK"i | "WEEKS"i | "MONTH"i | "MONTHS"i | "YEAR"i | "YEARS"i
	| "HOUR"i | "HOURS"i | "MINUTE"i | "MINUTES"i | "SECOND"i | "SECONDS"i

Ledger
	= "LEDGER"i & '=' & ("OFF"i | "ON"i & ('(' & LedgerItem & (',' & LedgerItem)* & ')')?)
LedgerItem
	= "LEDGER_VIEW"i & '=' & QualifiedName & ('(' & LedgerViewItem & (',' & LedgerViewItem)* & ')')?
	| "APPEND_ONLY"i & OnOffValue
LedgerViewItem
	= ("TRANSACTION_ID_COLUMN_NAME"i | "SEQUENCE_NUMBER_COLUMN_NAME"i
	  | "OPERATION_TYPE_COLUMN_NAME"i | "OPERATION_TYPE_DESC_COLUMN_NAME"i) & '=' & Identifier

DataDeletion
	= "DATA_DELETION"i & '=' & ("OFF"i | "ON"i & ('(' & DeletionItem & (',' & DeletionItem)* & ')')?)
DeletionItem
	= "FILTER_COLUMN"i & '=' & Identifier
	| "RETENTION_PERIOD"i & '=' & ("INFINITE"i | Sql92.Lexical.Digits & PeriodUnit)

// Stretch: the state is optional and the list is not — `REMOTE_DATA_ARCHIVE = ON` alone is
// refused.
Stretch
	= "REMOTE_DATA_ARCHIVE"i & ('=' & ("ON"i | "OFF_WITHOUT_DATA_RECOVERY"i | "OFF"i))?
	  & '(' & StretchItem & (',' & StretchItem)* & ')'
StretchItem
	= "MIGRATION_STATE"i & '=' & ("OUTBOUND"i | "INBOUND"i | "PAUSED"i)
	| "FILTER_PREDICATE"i & '=' & ("NULL"i | QualifiedName & '(' & Arguments? & ')')

// A table's rebuild is an index's without what only an index has: `RESUMABLE`,
// `MAX_DURATION` and `BUCKET_COUNT` are refused here. One partition takes five.
TableRebuild
	= PadIndex | FillFactor | SortInTempdb | IgnoreDupKey | NoRecompute | IncrementalStats
	| OnlineOption | RowLocks | PageLocks | MaxDop | AnyDataCompression | XmlCompression
TablePartitionRebuild
	= SortInTempdb | MaxDop | AnyDataCompression | XmlCompression | OnlineOption

// ── ALTER TABLE ─────────────────────────────────────────────────────────────
//
// Nine actions and they share nothing but the header, so the header is read once and each
// action says which it is. What the tree keeps is the table, the word, and the elements
// where the action has any.
AlterTableStatement : @Statement
	= "ALTER"i & "TABLE"i & name: QualifiedName & a: AlterTableAction
		=> @(a with { Name = name })

AlterTableAction : @Statement.AlterTable
	= "ADD"i & c: ConstraintBody & "FOR"i & Identifier
		=> @(Statement.Altered("ADD", new Clause[] { c }))
	| "ADD"i & "CONSTRAINT"i & name: Identifier & c: ConstraintBody & "FOR"i & Identifier
		=> @(Statement.Altered("ADD", new Clause[] { c with { Name = name } }))
	// A key `ALTER TABLE` adds may be built online and resumed, which one `CREATE TABLE`
	// declares may not: the same body, with the other list of index options in its place.
	| "ADD"i & body: TableBody with (ConstraintWith = AlterConstraintWith)
		=> @(Statement.Altered("ADD", body))
	| "WITH"i & mode: CheckWord & "ADD"i & body: TableBody with (ConstraintWith = AlterConstraintWith)
		=> @(Statement.Altered("WITH " + Syntax.Squared(mode) + " ADD", body))
	| "ALTER"i & "COLUMN"i & column: ColumnDefinition & options: ColumnOnline?
		=> @(Statement.Altered("ALTER COLUMN", new Clause[] { column }, options))
	| "ALTER"i & "COLUMN"i & name: Identifier & flag: AlterColumnWord & options: ColumnOnline?
	  & when @(Syntax.FlagsOnline(flag, options))
		=> @(Statement.Flagged(name, flag, options))
	| "DROP"i & first: DropTarget & (',' & rest: DropTarget)*
		=> @(Statement.Altered("DROP", Syntax.Listed(first, rest)))
	| word: CheckWord & tail: ("CONSTRAINT"i & ConstraintNames)
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))

	// `WITH NOCHECK CHECK CONSTRAINT ALL`: whether the rows already there are checked, then
	// which constraints are switched, in all four pairings, as the engine reads them.
	| "WITH"i & mode: CheckWord & word: CheckWord & tail: ("CONSTRAINT"i & ConstraintNames)
		=> @(Statement.Altered("WITH " + Syntax.Squared(mode) + " " + Syntax.Squared(word), null, null, tail))
	| word: EnableWord & tail: ("TRIGGER"i & ConstraintNames)
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| word: EnableWord & tail: ("CHANGE_TRACKING"i & OptionsWith?)
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| word: EnableWord & tail: "FILETABLE_NAMESPACE"i
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| "ALTER"i & tail: ("INDEX"i & Identifier & "REBUILD"i & IndexOrder? & OptionsWith?)
		=> @(Statement.Altered("ALTER", null, null, tail))
	| word: SplitOrMerge & tail: ("RANGE"i & '(' & SetValue & ')')
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| "SET"i & tail: ('(' & TableSetting & (',' & TableSetting)* & ')')
		=> @(Statement.Altered("SET", null, null, tail))
	| "REBUILD"i & tail: ("PARTITION"i & '=' & ?!"ALL"i & PartitionWhich
						  & ("WITH"i & '(' & TablePartitionRebuild & (',' & TablePartitionRebuild)* & ')')?
						| ("PARTITION"i & '=' & "ALL"i)?
						  & ("WITH"i & '(' & TableRebuild & (',' & TableRebuild)* & ')')?)
		=> @(Statement.Altered("REBUILD", null, null, tail))
	| "SWITCH"i & tail: (("PARTITION"i & ValueExpression)? & "TO"i & QualifiedName
						 & ("PARTITION"i & ValueExpression)? & OptionsWith?)
		=> @(Statement.Altered("SWITCH", null, null, tail))

AlterColumnWord : @string = t: ("ADD"i & AlterColumnFlag | "DROP"i & AlterColumnFlag) => @(Syntax.Squared(t))

// An altered column is altered online or not, and that is all it is asked: `MAXDOP` is refused
// (`Msg 102`), a name the engine does not know is `Msg 155`, and `ONLINE` is said once. Which
// flags may be changed online is `Syntax.FlagsOnline`.
ColumnOnline : @Clause[]
	= "WITH"i & '(' & "ONLINE"i & '=' & o: OnOff & ')'
		=> @(new Clause[] { new Clause.Option("ONLINE", new Expression.ColumnReference(o), Clause.None) })

AlterColumnFlag  = "MASKED"i & ("WITH"i & '(' & OptionList & ')')?
				 | "HIDDEN"i
				 | ColumnTail
CheckWord        = "CHECK"i | "NOCHECK"i
SplitOrMerge     = "SPLIT"i | "MERGE"i
LeftOrRight      = "LEFT"i | "RIGHT"i
EnableWord       = "ENABLE"i | "DISABLE"i
ConstraintNames  = "ALL"i | Identifier & (',' & Identifier)*
PartitionWhich : @Expression = "ALL"i => @(new Expression.ColumnReference("ALL")) | v: ValueExpression => @(v)

DropTarget : @Clause
	= "COLUMN"i & exists: IfExists? & name: Identifier
		=> @(Clause.Marked("COLUMN", name, exists, null))
	| "CONSTRAINT"i & exists: IfExists? & name: Identifier & tail: DropWith?
		=> @(Clause.Marked("CONSTRAINT", name, exists, tail))
	| "INDEX"i & name: Identifier      => @(Clause.Marked("INDEX", name))
	| "PERIOD"i & "FOR"i & "SYSTEM_TIME"i => @(Clause.Marked("PERIOD FOR SYSTEM_TIME", null))
	// A name on its own, where the `CONSTRAINT` in front of the list stands for it too.
	| name: Identifier & tail: DropWith?
		=> @(Clause.Marked("", name, null, tail))

IfExists = "IF"i & "EXISTS"i

// What a constraint dropped with its index is dropped with: a degree of parallelism, whether it
// is done online, where the rows go, and how long it waits — each once (`Msg 153`) and nothing
// else (`Msg 155`). The published block names three; the engine reads the fourth as well, as
// strictly as an index's rebuild does. The rows go anywhere but a bare `DEFAULT` (`Msg 156`).
DropWith = "WITH"i & '(' & DropOptions & ')'

DropOptions : @Clause[]
	= first: DropOption & (',' & rest: DropOption)* & when @(Syntax.NamedOnce(first, rest)) => @(Syntax.Listed(first, rest))

DropOption : @Clause
	= "MAXDOP"i & '=' & t: Sql92.Lexical.Digits
		=> @(new Clause.Option("MAXDOP", new Expression.Literal(SqlLiteralKind.Number, t), Clause.None))
	| "ONLINE"i & '=' & o: OnOff
		=> @(new Clause.Option("ONLINE", new Expression.ColumnReference(o), Clause.None))
	| "MOVE"i & "TO"i & ?!"DEFAULT"i & p: PlacementTarget
		=> @(new Clause.Option("MOVE TO", null, new Clause[] { p }))
	| LowPriorityWait
		=> @(new Clause.Option("WAIT_AT_LOW_PRIORITY", null, Clause.None))

// ── The routines: a header and a body ───────────────────────────────────────
//
// Four statements that could not be read at all until the procedural level was written,
// because each of them is a header and then whatever T-SQL somebody put inside it. That
// is 341 statements of the corpus, and the body is the part that was already done.
//
// `CREATE OR ALTER` is one word in front of all four, so it is read once.
CreateRoutine : @Statement
	= verb: ("CREATE"i & OrAlter?) & r: RoutineBody => @(Syntax.Verbed(r, verb))
	| verb: "ALTER"i & r: RoutineBody               => @(Syntax.Verbed(r, verb))

OrAlter = "OR"i & "ALTER"i

RoutineBody : @Statement
	= p: ProcedureStatement => @(p)
	| f: FunctionStatement  => @(f)
	| g: TriggerStatement   => @(g)
	| v: ViewStatement      => @(v)

// ── CREATE PROCEDURE ────────────────────────────────────────────────────────
ProcedureStatement : @Statement
	= ProcWord & name: QualifiedName & (';' & number: Sql92.Lexical.Digits)?
	  & parameters: RoutineParameters? & options: RoutineOptions? & replication: ("FOR"i & "REPLICATION"i)?
	  & "AS"i & ("EXTERNAL"i & "NAME"i & external: QualifiedName | body: StatementList)
		=> @(new Statement.CreateProcedure(name, parameters ?? Clause.None, body ?? Statement.None, options, replication is not null, external, number))

ProcWord = "PROCEDURE"i | "PROC"i

// The parentheses are optional, which is why a parameter list is a rule rather than a
// bracketed one: `CREATE PROCEDURE p @a INT AS …` is as good as `p (@a INT)`.
RoutineParameters : @Clause[]
	= '(' & ')' => @(Clause.None)
	| '(' & first: RoutineParameter & (',' & rest: RoutineParameter)* & ')'
		=> @(Syntax.Listed(first, rest))
	| first: RoutineParameter & (',' & rest: RoutineParameter)*
		=> @(Syntax.Listed(first, rest))

// A cursor is passed out and only out, `CURSOR VARYING OUTPUT` and nothing else — without
// either word `Msg 1051`, with a default, a nullability or `READONLY` refused — and `VARYING`
// is a cursor's word: `@a INT VARYING OUTPUT` is refused. A function takes no cursor at all
// (`Msg 5306`), which `FunctionStatement` asks.
RoutineParameter : @Clause
	= name: TSql.Variable & "AS"i? & p: ParameterTail => @(p with { Name = name })

ParameterTail : @Clause.ParameterDeclaration
	= "CURSOR"i & "VARYING"i & way: ("OUTPUT"i | "OUT"i)
		=> @(new Clause.ParameterDeclaration("", "CURSOR", null, null, true, new[] { Syntax.Squared(way) }))
	| type: DataType & n: NullSpec? & ('=' & v: AssignedValue)? & ways: ParameterWay*
		=> @(new Clause.ParameterDeclaration("", type, v, n, false, ways))

ParameterWay : @string = t: ("OUTPUT"i | "OUT"i | "READONLY"i) => @(Syntax.Squared(t))

RoutineOptions : @Clause[]
	= "WITH"i & first: RoutineOption & (',' & rest: RoutineOption)* => @(Syntax.Listed(first, rest))

RoutineOption : @Clause
	= "EXECUTE"i & "AS"i & who: ExecuteAsWho
		=> @(new Clause.Option("EXECUTE AS", new Expression.ColumnReference(who), Clause.None, null, true))
	| t: ("RETURNS"i & "NULL"i & "ON"i & "NULL"i & "INPUT"i) => @(new Clause.Option(Syntax.Squared(t), null, Clause.None))
	| t: ("CALLED"i & "ON"i & "NULL"i & "INPUT"i)            => @(new Clause.Option(Syntax.Squared(t), null, Clause.None))

	// One word and not a run of them, unlike an option inside brackets: this list is not
	// bracketed and `AS` follows it, so a run would take the `AS` and the body behind it.
	// What the published syntax names here is one word anyway — `ENCRYPTION`,
	// `SCHEMABINDING`, `NATIVE_COMPILATION`, `INLINE = ON`.
	| name: word & tail: OptionTail? => @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

ExecuteAsWho : @string
	= t: ("CALLER"i | "SELF"i | "OWNER"i
		  | Sql92.Lexical.CharacterStringLiteral
		  | Sql92.Lexical.NationalCharacterStringLiteral) => @(t)

// ── CREATE FUNCTION ─────────────────────────────────────────────────────────
//
// Three shapes and the difference is what `RETURNS` says: a type, `TABLE`, or a table
// variable and the columns it holds.
FunctionStatement : @Statement
	= "FUNCTION"i & name: QualifiedName & parameters: RoutineParameters?
	  & "RETURNS"i & r: FunctionReturns & when @(!Syntax.HasCursorParameter(parameters))
		=> @(r with { Name = name, Parameters = parameters ?? Clause.None })

FunctionReturns : @Statement.CreateFunction
	= "TABLE"i & '(' & columns: TableBody & ')' & ("ORDER"i & order: IndexColumns)? & options: RoutineOptions?
	  & "AS"i & "EXTERNAL"i & "NAME"i & external: QualifiedName
		=> @(new Statement.CreateFunction("", Clause.None, "TABLE", Statement.None, options, columns, null, order, external))
	| "TABLE"i & options: RoutineOptions? & "AS"i? & "RETURN"i & body: InlineReturn
		=> @(new Statement.CreateFunction("", Clause.None, "TABLE", body, options))
	| name: TSql.Variable & "TABLE"i & '(' & columns: TableBody & ')' & options: RoutineOptions? & "AS"i?
	  & body: StatementList
		=> @(new Statement.CreateFunction("", Clause.None, "TABLE", body, options, columns, name))
	| type: DataType & options: RoutineOptions? & "AS"i?
	  & ("EXTERNAL"i & "NAME"i & external: QualifiedName | body: StatementList)
		=> @(new Statement.CreateFunction("", Clause.None, type, body ?? Statement.None, options, null, null, null, external))

InlineReturn : @Statement[]
	= '(' & q: QueryExpression & OrderByClause? & ')'
		=> @(new Statement[] { Statement.Selected(new Query.Parenthesized(q)) })
	| q: QueryExpression & OrderByClause?             => @(new Statement[] { Statement.Selected(q) })

// ── CREATE TRIGGER ──────────────────────────────────────────────────────────
TriggerStatement : @Statement
	= "TRIGGER"i & name: QualifiedName & "ON"i & on: TriggerOn & options: RoutineOptions?
	  & fires: TriggerWhen & events: TriggerEvents
	  & append: ("WITH"i & "APPEND"i)? & replication: ("NOT"i & "FOR"i & "REPLICATION"i)?
	  & "AS"i & ("EXTERNAL"i & "NAME"i & external: QualifiedName | body: StatementList)
		=> @(new Statement.CreateTrigger(name, on, events, body ?? Statement.None, fires, options,
				 append is not null, replication is not null, external))

TriggerOn : @string
	= "ALL"i & "SERVER"i => @("ALL SERVER")
	| "DATABASE"i        => @("DATABASE")
	| t: QualifiedName   => @(t)

TriggerWhen : @string = t: ("INSTEAD"i & "OF"i | "AFTER"i | "FOR"i) => @(Syntax.Squared(t))

// A DML trigger names the three statements; a DDL one names events or a group of them,
// and both are words separated by commas.
TriggerEvents : @string[]
	= first: TriggerEvent & (',' & rest: TriggerEvent)* => @(Syntax.Named(first, rest))

TriggerEvent : @string
	= "INSERT"i => @("INSERT")
	| "UPDATE"i => @("UPDATE")
	| "DELETE"i => @("DELETE")
	| t: Identifier => @(t)

// ── CREATE VIEW ─────────────────────────────────────────────────────────────
ViewStatement : @Statement
	= "MATERIALIZED"i & "VIEW"i & name: QualifiedName & options: OptionsWith?
	  & "AS"i & q: DirectSelect
		=> @(new Statement.ViewDefinition(name, null, q, options, false, true))
	| "VIEW"i & name: QualifiedName & ('(' & columns: ColumnList & ')')? & options: RoutineOptions?
	  & "AS"i & q: DirectSelect & check: ("WITH"i & "CHECK"i & "OPTION"i)?
		=> @(new Statement.ViewDefinition(name, columns, q, options, check is not null))

// ── Indexes ─────────────────────────────────────────────────────────────────
//
// Almost all of it was already written: an index inside a `CREATE TABLE` is the same
// thing said in the same words, so the columns, the options, the placement and the
// filter are shared and only the header is new.
CreateIndexStatement : @Statement
	// Named: `CREATE SELECTIVE XML INDEX ON t (c) …`, which the reference writes once, is refused.
	= "CREATE"i & "SELECTIVE"i & "XML"i & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & '(' & promoted: ColumnList & ')'
	  & tail: (("WITH"i & XmlNamespaces)? & SelectivePaths) & o: XmlIndexWith?
		=> @(new Statement.CreateIndex(
				 on, Clause.Indexed(name, null, null, null, null, Syntax.Columns(promoted), null, null, null, o?.Options, null, null),
				 "SELECTIVE XML", Syntax.Tail(tail)))
	// A spatial index: one column, the grid it is cut by, and a list of options the engine reads
	// as it reads no other (`SpatialWith`). Put to the engine some two hundred times.
	| "CREATE"i & kind: "SPATIAL"i & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: SpatialColumn
	  & over: ("USING"i & Identifier)? & o: SpatialWith? & p: IndexOn? & when @(p is not Clause.Placement(_, _, not null))
		=> @(new Statement.CreateIndex(
				 on, Clause.Indexed(name, null, null, null, null, columns, null, null, null, o?.Options, (Clause.Placement?)p, null),
				 Syntax.Squared(kind), Syntax.Tail(over)))
	| "CREATE"i & kind: ("PRIMARY"i? & "XML"i) & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: IndexColumns
	  & over: XmlIndexUsing? & when @(over is null || Syntax.Squared(kind!) == "XML") & o: XmlIndexWith?
		=> @(new Statement.CreateIndex(
				 on, Clause.Indexed(name, null, null, null, null, columns, null, null, null, o?.Options, null, null),
				 Syntax.Squared(kind), Syntax.Tail(over)))
	| "CREATE"i & u: "UNIQUE"i? & k: IndexOrder? & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: IndexColumns
	  & ("INCLUDE"i & '(' & include: IncludeColumns & ')')?
	  & ("WHERE"i & filter: SearchCondition)?
	  & o: IndexWith? & p: IndexOn? & ("FILESTREAM_ON"i & f: PlacementTarget)?
		=> @(new Statement.CreateIndex(on, Clause.Indexed(name, u, k, null, null, columns, null, include, filter, o?.Options, (Clause.Placement?)p, f is null ? null : f with { Kind = "FILESTREAM_ON" })
			 with { Bracketed = o is not { Bare: true } }))
	| "CREATE"i & k: IndexOrder? & s: "COLUMNSTORE"i & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: IndexColumns?
	  & ("ORDER"i & '(' & order: ColumnList & ')')?
	  & ("WHERE"i & filter: SearchCondition)?
	  & o: ColumnstoreWith? & p: IndexOn?
		=> @(new Statement.CreateIndex(on, Clause.Indexed(name, null, k, s, null, columns, order, null, filter, o?.Options, (Clause.Placement?)p, null)
			 with { Bracketed = o is not { Bare: true } }))

// `ALTER INDEX` names one index or all of them, and then says what to do.
AlterIndexStatement : @Statement
	= "ALTER"i & "INDEX"i & name: IndexTarget & "ON"i & on: QualifiedName
	  & ("WITH"i & ns: XmlNamespaces)? & paths: SelectivePaths & o: XmlIndexWith?
		=> @(new Statement.AlterIndex(name, on, "FOR", null, o?.Options, paths, ns))
	| "ALTER"i & "INDEX"i & name: IndexTarget & "ON"i & on: QualifiedName & a: AlterIndexAction
		=> @(a with { Name = name, On = on })

IndexTarget : @string = "ALL"i => @("ALL") | t: Identifier => @(t)

// A secondary XML index is built over a primary one, `USING XML INDEX p`, and says which kind
// it is — `FOR VALUE`, `PATH` or `PROPERTY`, and no other word (`Msg 487`) — or, over a
// selective index, which of its paths, by a name of one part in brackets. It says one or the
// other: `USING XML INDEX p` alone is refused, and a primary index says neither.
XmlIndexUsing = "USING"i & "XML"i & "INDEX"i & Identifier & "FOR"i & ("VALUE"i | "PATH"i | "PROPERTY"i | '(' & Identifier & ')')

// ── A spatial index's options ───────────────────────────────────────────────
//
// One column, by a name of its own — `$node_id` is refused — and bare: no order, no second
// one, no filter, no included columns, no stream. The
// grid is any one name, which the engine checks later. The options are a list of their own,
// not the index catalogue: any name the engine has never heard of, set to any plain value —
// a word, a number, a string, a binary string, `NULL` — or to a bracket of them, all by
// position or all by name, is read, and then a word is said about a few names
// (`Syntax.Spatial`). Never a variable (`Msg 112`), `DEFAULT`, an expression, a name of two
// parts or a run of words; never an empty bracket, a bracket inside one, or the list without
// its brackets. Each may be said twice.
SpatialColumn : @Clause[]
	= '(' & t: Identifier & ')'
		=> @(new Clause[] { new Clause.SortSpecification(new Expression.ColumnReference(t), Syntax.Ordered(default(string))) })

SpatialWith : @Clause.Option
	= "WITH"i & '(' & first: SpatialOption & (',' & rest: SpatialOption)* & ')'
		=> @(new Clause.Option("WITH", null, Syntax.Listed(first, rest)))

SpatialOption : @Clause
	= name: word & '=' & o: SpatialSet & when @(Syntax.Spatial(name, o)) => @(o with { Name = name })

// A bracket by name before one by position, which a word would begin as well.
SpatialSet : @Clause.Option
	= '(' & first: SpatialSetting & (',' & rest: SpatialSetting)* & ')'
		=> @(new Clause.Option("", null, Syntax.Listed(first, rest)))
	| '(' & item: SpatialItem & (',' & items: SpatialItem)* & ')'
		=> @(new Clause.Option("", new Expression.RoutineInvocation("", Syntax.Listed(item, items)), Clause.None))
	| v: SpatialValue => @(new Clause.Option("", v, Clause.None))

SpatialSetting : @Clause = name: word & '=' & v: SpatialItem => @(new Clause.Option(name, v, Clause.None))

// A switch stands only where a whole value does: `FOO = (ON)` is refused (`Msg 156`).
SpatialValue : @Expression
	= t: ("ON"i | "OFF"i) => @(new Expression.ColumnReference(Syntax.Squared(t)))
	| v: SpatialItem      => @(v)

SpatialItem : @Expression
	= "NULL"i                                          => @(Expression.NullValue)
	| t: ('-'? & Sql92.Lexical.UnsignedNumericLiteral) => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| t: ('-'? & TSql.MoneyLiteral)                    => @(new Expression.Literal(SqlLiteralKind.Number, Syntax.Compacted(t)))
	| v: BrokerString                                  => @(v)
	| t: TSql.BinaryLiteral                            => @(new Expression.Literal(SqlLiteralKind.Hex, t))
	| t: Identifier                                    => @(new Expression.ColumnReference(t))

// `FOR ( name = '/a/b' AS XQUERY 'xs:double' MAXLENGTH (200) SINGLETON, … )`, and the
// three ways `ALTER INDEX` changes one of them.
SelectivePaths : @string[]
	= "FOR"i & '(' & first: SelectivePath & (',' & rest: SelectivePath)* & ')'
		=> @(Syntax.Named(first, rest))

// Each path as it was written: what it promotes, its XQuery type, its length, its
// cardinality — a small language of its own that the tree keeps whole.
SelectivePath : @string
	= t: ("ADD"i & PromotedPath
		  | "ALTER"i & "PATH"i & PromotedPath
		  | "REMOVE"i & Identifier
		  | PromotedPath) => @(t)

PromotedPath : @string
	= name: Identifier & '=' & path: Sql92.Lexical.CharacterStringLiteral & PathHint*
		=> @(name)
	| path: Sql92.Lexical.CharacterStringLiteral & PathHint*
		=> @(path)

PathHint = "AS"i & "XQUERY"i & Sql92.Lexical.CharacterStringLiteral? & PathLength?
		 | "AS"i & "SQL"i & DataType
		 | "SINGLETON"i
		 | "AS"i & word

PathLength = "MAXLENGTH"i & '(' & Sql92.Lexical.UnsignedNumericLiteral & ')'

AlterIndexAction : @Statement.AlterIndex
	// One partition takes fewer options than all of them — `FILLFACTOR` is refused there.
	= "REBUILD"i & "PARTITION"i & '=' & ?!"ALL"i & p: PartitionWhich & o: PartitionRebuildWith?
		=> @(new Statement.AlterIndex("", "", "REBUILD", p, o?.Options))
	| "REBUILD"i & ("PARTITION"i & '=' & ?="ALL"i & p: PartitionWhich)? & o: RebuildWith?
		=> @(new Statement.AlterIndex("", "", "REBUILD", p, o?.Options))
	| "REORGANIZE"i & ("PARTITION"i & '=' & p: PartitionWhich)? & o: ReorganizeWith?
		=> @(new Statement.AlterIndex("", "", "REORGANIZE", p, o?.Options))
	| "DISABLE"i => @(new Statement.AlterIndex("", "", "DISABLE"))
	| "PAUSE"i   => @(new Statement.AlterIndex("", "", "PAUSE"))
	| "ABORT"i   => @(new Statement.AlterIndex("", "", "ABORT"))
	| "RESUME"i & o: ResumeWith? => @(new Statement.AlterIndex("", "", "RESUME", null, o?.Options))
	| "SET"i & '(' & settings: SetIndexOptions & ')' => @(new Statement.AlterIndex("", "", "SET", null, settings))

// ── The keys, and what is locked with them ──────────────────────────────────
//
// Seventeen published blocks and one idea running through them: a key is made from
// somewhere, locked by something, and the something is a certificate, a password or another
// key. `ENCRYPTION BY` is written in six of the seventeen and reads the same in all six, so
// it is one rule.
KeyStatement : @Statement
	= "CREATE"i & "ASYMMETRIC"i & "KEY"i & name: Identifier
	  & tail: (Authorization? & o: AsymmetricBody & ("ENCRYPTION"i & "BY"i & PasswordEncryptor)?)
		=> @(Statement.Defined("ASYMMETRIC KEY", name, Syntax.Tail(tail), options: o))
	| "ALTER"i & "ASYMMETRIC"i & "KEY"i & name: Identifier & tail: (o: AsymmetricChange)
		=> @(Statement.Defined("ALTER ASYMMETRIC KEY", name, Syntax.Tail(tail), options: o))

	| "CREATE"i & "SYMMETRIC"i & "KEY"i & name: SymmetricKeyName & tail: (Authorization? & o: SymmetricBody)
		=> @(Statement.Defined("SYMMETRIC KEY", name, Syntax.Tail(tail), options: o))
	| "ALTER"i & "SYMMETRIC"i & "KEY"i & name: Identifier
	  & tail: (AddOrDrop & "ENCRYPTION"i & "BY"i & KeyEncryptor & (',' & KeyEncryptor)*)
		=> @(Statement.Defined("ALTER SYMMETRIC KEY", name, Syntax.Tail(tail)))

	| "CREATE"i & "CERTIFICATE"i & name: Identifier
	  & tail: (Authorization? & o: CertificateBody & ("ACTIVE"i & "FOR"i & "BEGIN_DIALOG"i & '=' & OnOff)?)
		=> @(Statement.Defined("CERTIFICATE", name, Syntax.Tail(tail), options: o))
	| "ALTER"i & "CERTIFICATE"i & name: Identifier & tail: (o: CertificateChange)
		=> @(Statement.Defined("ALTER CERTIFICATE", name, Syntax.Tail(tail), options: o))

	// Azure SQL Database makes a master key with no password; SQL Server answers that it is
	// not supported in this version, which is a product's answer and not a syntax's.
	// Opened for the session and closed again. A symmetric key is named by one part and opened by
	// a certificate or an asymmetric key, with the password it is kept under, by another symmetric
	// key with none, or by a password — a string, never a variable. The master key is opened by its
	// password alone. One key is closed at a time, or all of them.
	| "OPEN"i & "SYMMETRIC"i & "KEY"i & name: Identifier & tail: ("DECRYPTION"i & "BY"i & KeyDecryptor)
		=> @(Statement.Defined("OPEN SYMMETRIC KEY", name, Syntax.Tail(tail)))
	| "OPEN"i & "MASTER"i & "KEY"i & tail: ("DECRYPTION"i & "BY"i & PasswordEncryptor)
		=> @(Statement.Defined("OPEN MASTER KEY", "", Syntax.Tail(tail)))
	| "CLOSE"i & "SYMMETRIC"i & "KEY"i & name: Identifier
		=> @(Statement.Defined("CLOSE SYMMETRIC KEY", name))
	| "CLOSE"i & "ALL"i & "SYMMETRIC"i & "KEYS"i
		=> @(Statement.Defined("CLOSE ALL SYMMETRIC KEYS", ""))
	| "CLOSE"i & "MASTER"i & "KEY"i
		=> @(Statement.Defined("CLOSE MASTER KEY", ""))

	| "CREATE"i & "MASTER"i & "KEY"i & tail: ("ENCRYPTION"i & "BY"i & PasswordEncryptor)?
		=> @(Statement.Defined("MASTER KEY", "", Syntax.Tail(tail)))
	| "ALTER"i & "MASTER"i & "KEY"i & tail: MasterKeyChange
		=> @(Statement.Defined("ALTER MASTER KEY", "", Syntax.Tail(tail)))
	| "ALTER"i & "SERVICE"i & "MASTER"i & "KEY"i & tail: ServiceKeyChange
		=> @(Statement.Defined("ALTER SERVICE MASTER KEY", "", Syntax.Tail(tail)))

	| "CREATE"i & "DATABASE"i & "ENCRYPTION"i & "KEY"i
	  & tail: ("WITH"i & "ALGORITHM"i & '=' & DatabaseKeyAlgorithm & ServerEncryption)
		=> @(Statement.Defined("DATABASE ENCRYPTION KEY", "", Syntax.Tail(tail)))
	| "ALTER"i & "DATABASE"i & "ENCRYPTION"i & "KEY"i
	  & tail: ("REGENERATE"i & "WITH"i & "ALGORITHM"i & '=' & DatabaseKeyAlgorithm | ServerEncryption)
		=> @(Statement.Defined("ALTER DATABASE ENCRYPTION KEY", "", Syntax.Tail(tail)))

	| "CREATE"i & "COLUMN"i & "ENCRYPTION"i & "KEY"i & name: Identifier
	  & tail: ("WITH"i & "VALUES"i & first: ColumnKeyValue & (',' & rest: ColumnKeyValue)*)
		=> @(Statement.Defined("COLUMN ENCRYPTION KEY", name, Syntax.Tail(tail), options: Syntax.Listed(first, rest)))
	| "ALTER"i & "COLUMN"i & "ENCRYPTION"i & "KEY"i & name: Identifier
	  & tail: ("ADD"i & "VALUE"i & added: ColumnKeyValue
			  | "DROP"i & "VALUE"i & '(' & dropped: ColumnKeySetting & ')')
		=> @(Statement.Defined("ALTER COLUMN ENCRYPTION KEY", name, Syntax.Tail(tail),
				 options: added is not null ? new Clause[] { added } : Statement.Holding("VALUE", new Clause[] { dropped! })))
	| "CREATE"i & "COLUMN"i & "MASTER"i & "KEY"i & name: Identifier
	  & tail: ("WITH"i & ?=('(' & MasterKeyLocation & (',' & MasterKeyEnclave)? & ')')
			   & '(' & first: MasterKeySetting & (',' & rest: MasterKeySetting)* & ')')
		=> @(Statement.Defined("COLUMN MASTER KEY", name, Syntax.Tail(tail), options: Syntax.Listed(first, rest)))

	| verb: CreateOrAlter & "CREDENTIAL"i & name: Identifier
	  & tail: (CredentialWith & ("FOR"i & "CRYPTOGRAPHIC"i & "PROVIDER"i & Identifier)?)
		=> @(Statement.Defined("CREDENTIAL", name, Syntax.Tail(tail), verb))
	| verb: CreateOrAlter & "DATABASE"i & "SCOPED"i & "CREDENTIAL"i & name: Identifier
	  & tail: CredentialWith
		=> @(Statement.Defined("DATABASE SCOPED CREDENTIAL", name, Syntax.Tail(tail), verb))

	// A security policy is a list of predicates rather than a list of settings, and each
	// predicate names a function, the table it guards, and when it fires.
	// A policy created may be kept from replication after its predicates; one altered is
	// kept from it or given back to it as a change of its own, `ADD NOT FOR REPLICATION`,
	// and never alongside predicates or options.
	| "CREATE"i & "SECURITY"i & "POLICY"i & name: QualifiedName
	  & tail: (PolicyPredicates? & OptionsWith? & NotForReplication?)
		=> @(Statement.Defined("SECURITY POLICY", name, Syntax.Tail(tail), "CREATE"))
	| "ALTER"i & "SECURITY"i & "POLICY"i & name: QualifiedName & tail: PolicyAlteration
		=> @(Statement.Defined("SECURITY POLICY", name, Syntax.Tail(tail), "ALTER"))

KeyDecryptor
	= "CERTIFICATE"i & Identifier & ("WITH"i & PasswordEncryptor)?
	| "ASYMMETRIC"i & "KEY"i & Identifier & ("WITH"i & PasswordEncryptor)?
	| "SYMMETRIC"i & "KEY"i & Identifier
	| PasswordEncryptor

Authorization     = "AUTHORIZATION"i & QualifiedName
NotForReplication = "NOT"i & "FOR"i & "REPLICATION"i

// ── The keys' catalogue ─────────────────────────────────────────────────────
//
// Written from the published blocks and put to the engine line by line, and closed: an
// option this does not name is refused, as the engine refuses it (`Msg 102`). What the
// blocks leave open the engine settled — a password is a literal and never a variable, a
// symmetric key's options are joined by commas and its encryptions follow them with none,
// a credential's `IDENTITY` comes first.
//
// One thing the engine checks and this does not: an option written twice. `SUBJECT = 's',
// SUBJECT = 't'` is `Msg 102` there and read here, because "each at most once, in any order"
// is a count the notation has no way to say short of writing out every order.

// A literal, which is what every password, path and name below is.
Quoted = Sql92.Lexical.NationalCharacterStringLiteral | Sql92.Lexical.CharacterStringLiteral

// The algorithms, and one list of them for both kinds of key, because that is how the engine
// reads them: `CREATE SYMMETRIC KEY … ALGORITHM = RSA_2048` and `CREATE ASYMMETRIC KEY …
// ALGORITHM = AES_128` are read and refused later, not as syntax, where `ALGORITHM = FOO` is.
// The weak ones are refused from 130 on — "to use older algorithms you must set the database
// to compatibility level 120 or lower" — and RC4 from 110, "only in compatibility level 90 or
// 100". Except where a provider makes the key: the engine takes any of them at any level.
KeyAlgorithm
	= "AES_128"i | "AES_192"i | "AES_256"i | "RSA_4096"i | "RSA_3072"i | "RSA_2048"i
	| WeakAlgorithm & when Version is Until120
	| ("RC4"i | "RC4_128"i) & when Version is Until100

ProviderAlgorithm
	= "AES_128"i | "AES_192"i | "AES_256"i | "RSA_4096"i | "RSA_3072"i | "RSA_2048"i
	| WeakAlgorithm | "RC4"i | "RC4_128"i

WeakAlgorithm = "DES"i | "TRIPLE_DES"i | "TRIPLE_DES_3KEY"i | "RC2"i | "DESX"i | "RSA_1024"i | "RSA_512"i

DatabaseKeyAlgorithm
	= "AES_128"i | "AES_192"i | "AES_256"i
	| "TRIPLE_DES_3KEY"i & when Version is Until120

Disposition = "CREATE_NEW"i | "OPEN_EXISTING"i

PasswordEncryptor = "PASSWORD"i & '=' & Quoted

// What a symmetric key may be locked with — never a server's certificate, which is a
// database encryption key's.
KeyEncryptor
	= "CERTIFICATE"i & QualifiedName
	| PasswordEncryptor
	| "SYMMETRIC"i & "KEY"i & QualifiedName
	| "ASYMMETRIC"i & "KEY"i & QualifiedName

ServerEncryption = "ENCRYPTION"i & "BY"i & "SERVER"i & ("CERTIFICATE"i | "ASYMMETRIC"i & "KEY"i) & QualifiedName

// An asymmetric key made by a provider takes a list; one read from a file or an assembly
// takes nothing; one made here takes an algorithm at most. The provider's two options
// without the provider are refused, and so is an algorithm for a key that already exists.
//
// What each of these gives back is the settings it read, as nodes, for the statement's
// `Options`: the words go to the tail as they were, and a check matches these.
AsymmetricBody : @Clause[]
	= "FROM"i & "PROVIDER"i & Identifier & ("WITH"i & first: ProviderKeySetting & (',' & rest: ProviderKeySetting)*)?
		=> @(first is null ? Clause.None : Syntax.Listed(first, rest))
	| "FROM"i & AsymmetricSource => @(Clause.None)
	| ("WITH"i & only: AlgorithmSetting)? => @(only is null ? Clause.None : new Clause[] { only })

// Each setting as a node, made from the words the catalogue's line read and nothing more.
// Not from the builder the index options use: a key's list has no brackets and the clause
// after it no comma, and the builder reads a value as a run of words up to one — so
// `ALGORITHM = AES_256 ENCRYPTION BY CERTIFICATE c, PASSWORD = 'p'` had the encryption taken
// for the algorithm's value, and the statement refused.
ProviderKeySetting : @Clause = t: ProviderKeyOption                                    => @(Syntax.Setting(t))
AlgorithmSetting   : @Clause = t: ("ALGORITHM"i & '=' & KeyAlgorithm)                 => @(Syntax.Setting(t))
SymmetricSetting   : @Clause = t: SymmetricOption                                      => @(Syntax.Setting(t))
ProviderSetting    : @Clause = t: ProviderOption                                       => @(Syntax.Setting(t))
CertificateSetting : @Clause = t: CertificateOption                                    => @(Syntax.Setting(t))
PrivateKeySetting  : @Clause = t: PrivateKeyOption                                     => @(Syntax.Setting(t))
KeyPasswordSetting : @Clause = t: KeyPassword                                          => @(Syntax.Setting(t))
ColumnKeySetting   : @Clause = t: ColumnKeyPart                                        => @(Syntax.Setting(t))
MasterKeySetting   : @Clause = t: (MasterKeyProvider | MasterKeyPath | MasterKeyEnclave) => @(Syntax.Setting(t))

AsymmetricSource
	= "EXECUTABLE"i? & "FILE"i & '=' & Quoted
	| "ASSEMBLY"i & QualifiedName

ProviderKeyOption
	= "ALGORITHM"i & '=' & ProviderAlgorithm
	| "PROVIDER_KEY_NAME"i & '=' & Quoted
	| "CREATION_DISPOSITION"i & '=' & Disposition

AsymmetricChange : @Clause[]
	= "REMOVE"i & "PRIVATE"i & "KEY"i => @(Clause.None)
	| "WITH"i & "PRIVATE"i & "KEY"i & '(' & first: KeyPasswordSetting & (',' & rest: KeyPasswordSetting)* & ')'
		=> @(Statement.Holding("PRIVATE KEY", Syntax.Listed(first, rest)))
	| Attestation => @(Clause.None)

// Who vouches for a key or a certificate. In no published block, and read by the engine at
// every level, both ways round.
Attestation = "ATTESTED"i & "BY"i & Quoted | "REMOVE"i & "ATTESTED"i & "OPTION"i

KeyPassword
	= "DECRYPTION"i & "BY"i & PasswordEncryptor
	| "ENCRYPTION"i & "BY"i & PasswordEncryptor

// A temporary key is named with one `#`.
SymmetricKeyName = Identifier | TSql.TemporaryName

// A key a provider holds may say nothing more; one made here says at least one option and
// is locked by at least one thing.
SymmetricBody : @Clause[]
	= "FROM"i & "PROVIDER"i & Identifier & ("WITH"i & first: ProviderSetting & (',' & rest: ProviderSetting)*)?
	  & SymmetricEncryption?
		=> @(first is null ? Clause.None : Syntax.Listed(first, rest))
	| "WITH"i & first: SymmetricSetting & (',' & rest: SymmetricSetting)* & SymmetricEncryption
		=> @(Syntax.Listed(first, rest))

ProviderOption
	= "ALGORITHM"i & '=' & ProviderAlgorithm
	| SymmetricOption

SymmetricOption
	= "KEY_SOURCE"i & '=' & Quoted
	| "ALGORITHM"i & '=' & KeyAlgorithm
	| "IDENTITY_VALUE"i & '=' & Quoted
	| "PROVIDER_KEY_NAME"i & '=' & Quoted
	| "CREATION_DISPOSITION"i & '=' & Disposition

SymmetricEncryption = "ENCRYPTION"i & "BY"i & KeyEncryptor & (',' & KeyEncryptor)*

MasterKeyChange
	= "FORCE"i? & "REGENERATE"i & "WITH"i & "ENCRYPTION"i & "BY"i & PasswordEncryptor
	| AddOrDrop & "ENCRYPTION"i & "BY"i & ("SERVICE"i & "MASTER"i & "KEY"i | PasswordEncryptor)

// The service master key is regenerated, forced or not, or told that the account the service
// runs under has changed — the old one or the new one, its name and then its password, both
// strings and in that order; nothing else, and not nothing.
ServiceKeyChange
	= "FORCE"i? & "REGENERATE"i
	| "WITH"i & "OLD_ACCOUNT"i & '=' & Quoted & ',' & "OLD_PASSWORD"i & '=' & Quoted
	| "WITH"i & "NEW_ACCOUNT"i & '=' & Quoted & ',' & "NEW_PASSWORD"i & '=' & Quoted

// A certificate made here takes its options in any order and none of them is required; one
// read from somewhere takes its private key's.
CertificateBody : @Clause[]
	= "FROM"i & s: CertificateSource => @(s)
	| ("ENCRYPTION"i & "BY"i & PasswordEncryptor)? & "WITH"i & first: CertificateSetting & (',' & rest: CertificateSetting)*
		=> @(Syntax.Listed(first, rest))

CertificateOption
	= "SUBJECT"i & '=' & Quoted
	| "START_DATE"i & '=' & Quoted
	| "EXPIRY_DATE"i & '=' & Quoted

CertificateSource : @Clause[]
	= "ASSEMBLY"i & QualifiedName => @(Clause.None)
	| "EXECUTABLE"i? & "FILE"i & '=' & Quoted
	  & ("WITH"i & ("FORMAT"i & '=' & Quoted & ',')? & "PRIVATE"i & "KEY"i & k: PrivateKeyList)?
		=> @(Statement.Holding("PRIVATE KEY", k))
	| "BINARY"i & '=' & TSql.BinaryLiteral & ("WITH"i & "PRIVATE"i & "KEY"i & k: PrivateKeyList)?
		=> @(Statement.Holding("PRIVATE KEY", k))

PrivateKeyList : @Clause[]
	= '(' & first: PrivateKeySetting & (',' & rest: PrivateKeySetting)* & ')' => @(Syntax.Listed(first, rest))

PrivateKeyOption
	= "FILE"i & '=' & Quoted
	| "BINARY"i & '=' & TSql.BinaryLiteral
	| KeyPassword

CertificateChange : @Clause[]
	= "REMOVE"i & "PRIVATE"i & "KEY"i => @(Clause.None)
	| "WITH"i & "PRIVATE"i & "KEY"i & k: PrivateKeyList => @(Statement.Holding("PRIVATE KEY", k))
	| "WITH"i & "ACTIVE"i & "FOR"i & "BEGIN_DIALOG"i & '=' & OnOff => @(Clause.None)
	| Attestation => @(Clause.None)

// An Always Encrypted key's value: which master key, which algorithm and the value itself,
// all three and in any order. The algorithm is a literal — `ALGORITHM = RSA_OAEP` unquoted
// is refused.
ColumnKeyValue : @Clause
	= '(' & a: ColumnKeySetting & ',' & b: ColumnKeySetting & ',' & c: ColumnKeySetting & ')'
		=> @(new Clause.Option("VALUE", null, new Clause[] { a, b, c }))

ColumnKeyPart
	= ColumnKeyMaster
	| "ALGORITHM"i & '=' & Quoted
	| "ENCRYPTED_VALUE"i & '=' & TSql.BinaryLiteral

ColumnKeyMaster = "COLUMN_MASTER_KEY"i & '=' & Identifier

// Where the master key lives, both parts and in either order, and the enclave's signature
// after them and only after them.
MasterKeyLocation
	= MasterKeyProvider & ',' & MasterKeyPath
	| MasterKeyPath & ',' & MasterKeyProvider

MasterKeyProvider = "KEY_STORE_PROVIDER_NAME"i & '=' & Quoted
MasterKeyPath     = "KEY_PATH"i & '=' & Quoted
MasterKeyEnclave  = "ENCLAVE_COMPUTATIONS"i & '(' & "SIGNATURE"i & '=' & TSql.BinaryLiteral & ')'

// The identity first, and the secret after it if there is one.
CredentialWith = "WITH"i & "IDENTITY"i & '=' & Quoted & (',' & "SECRET"i & '=' & Quoted)?

PolicyPredicates = PolicyPredicate & (',' & PolicyPredicate)*

PolicyAlteration = ("ADD"i | "DROP"i) & NotForReplication
				 | PolicyPredicates? & OptionsWith?

// A predicate says what it is — `ADD PREDICATE` alone is refused — and only a block predicate
// says which change it blocks: after an insert or an update, before an update or a delete,
// and those four only.
PolicyPredicate = PolicyChange & PolicyAdded
				| "DROP"i & PolicyDropped

PolicyAdded   = "FILTER"i & "PREDICATE"i & PolicyFunction & "ON"i & QualifiedName
			  | "BLOCK"i & "PREDICATE"i & PolicyFunction & "ON"i & QualifiedName & PolicyWhen?
PolicyDropped = "FILTER"i & "PREDICATE"i & "ON"i & QualifiedName
			  | "BLOCK"i & "PREDICATE"i & "ON"i & QualifiedName & PolicyWhen?

PolicyFunction = QualifiedName & '(' & Arguments? & ')'
PolicyChange   = "ADD"i | "ALTER"i
PolicyWhen   = "AFTER"i & ("INSERT"i | "UPDATE"i) | "BEFORE"i & ("UPDATE"i | "DELETE"i)

// ── The full-text catalogue, and the index over it ──────────────────────────
//
// Eight published blocks. A full-text index is the one index with no name of its own — it
// is named by the table it is on, there being one per table — and the one whose columns
// carry a language and a type column beside them.
FullTextStatement : @Statement
	= "CREATE"i & "FULLTEXT"i & "INDEX"i & "ON"i & on: QualifiedName
	  & tail: (('(' & FullTextColumn & (',' & FullTextColumn)* & ')')?
			   & "KEY"i & "INDEX"i & Identifier & ("ON"i & FullTextCatalogOn)? & FullTextWith?)
		=> @(Statement.Defined("FULLTEXT INDEX", on, Syntax.Tail(tail)))
	| "ALTER"i & "FULLTEXT"i & "INDEX"i & "ON"i & on: QualifiedName & tail: FullTextAction
		=> @(Statement.Defined("ALTER FULLTEXT INDEX", on, Syntax.Tail(tail)))

	| "CREATE"i & "FULLTEXT"i & "CATALOG"i & name: Identifier
	  & tail: (("ON"i & "FILEGROUP"i & Identifier)? & ("IN"i & "PATH"i & ValueExpression)?
			   & ("WITH"i & OptionList)? & AsDefault? & ("AUTHORIZATION"i & QualifiedName)?)
		=> @(Statement.Defined("FULLTEXT CATALOG", name, Syntax.Tail(tail)))
	| "ALTER"i & "FULLTEXT"i & "CATALOG"i & name: Identifier & tail: FullTextCatalogAction
		=> @(Statement.Defined("ALTER FULLTEXT CATALOG", name, Syntax.Tail(tail)))

	| "CREATE"i & "FULLTEXT"i & "STOPLIST"i & name: Identifier
	  & tail: (StopListFrom? & ("AUTHORIZATION"i & QualifiedName)?)
		=> @(Statement.Defined("FULLTEXT STOPLIST", name, Syntax.Tail(tail)))
	| "ALTER"i & "FULLTEXT"i & "STOPLIST"i & name: Identifier & tail: StopListAction
		=> @(Statement.Defined("ALTER FULLTEXT STOPLIST", name, Syntax.Tail(tail)))

	| "CREATE"i & "SEARCH"i & "PROPERTY"i & "LIST"i & name: Identifier
	  & tail: (("FROM"i & QualifiedName)? & ("AUTHORIZATION"i & QualifiedName)?)
		=> @(Statement.Defined("SEARCH PROPERTY LIST", name, Syntax.Tail(tail)))
	| "ALTER"i & "SEARCH"i & "PROPERTY"i & "LIST"i & name: Identifier & tail: PropertyListAction
		=> @(Statement.Defined("ALTER SEARCH PROPERTY LIST", name, Syntax.Tail(tail)))

// Bracketed or not, which the published block writes one way and the corpus both.
FullTextWith = "WITH"i & '(' & OptionList & ')'
			 | "WITH"i & OptionList

AsDefault = "AS"i & "DEFAULT"i

FullTextColumn = Identifier & ("TYPE"i & "COLUMN"i & Identifier)?
			   & ("LANGUAGE"i & FullTextLanguage)? & "STATISTICAL_SEMANTICS"i?

// A language is named, numbered or quoted, and the syntax means all three.
FullTextLanguage = ValueExpression

FullTextCatalogOn = '(' & FullTextPlace & (',' & FullTextPlace)* & ')'
				  | Identifier

FullTextPlace = "FILEGROUP"i & Identifier | Identifier

FullTextAction
	= "ENABLE"i
	| "DISABLE"i
	| "SET"i & OptionList & NoPopulation?
	| "ADD"i & '(' & FullTextColumn & (',' & FullTextColumn)* & ')' & NoPopulation?
	| "ALTER"i & "COLUMN"i & Identifier & AddOrDrop & "STATISTICAL_SEMANTICS"i & NoPopulation?
	| "DROP"i & '(' & ColumnList & ')' & NoPopulation?
	| "START"i & word & "POPULATION"i
	| PopulationWord & "POPULATION"i

NoPopulation   = "WITH"i & "NO"i & "POPULATION"i
PopulationWord = "STOP"i | "PAUSE"i | "RESUME"i

FullTextCatalogAction = "REBUILD"i & ("WITH"i & OptionList)?
					  | "REORGANIZE"i
					  | AsDefault

StopListFrom = "FROM"i & "SYSTEM"i & "STOPLIST"i
			 | "FROM"i & QualifiedName

StopListAction = "ADD"i & ValueExpression & "LANGUAGE"i & FullTextLanguage
			   | "DROP"i & "ALL"i & ("LANGUAGE"i & FullTextLanguage)?
			   | "DROP"i & ValueExpression & "LANGUAGE"i & FullTextLanguage

// A property added says its set's GUID and its integer id, in that order and in brackets, and
// may describe itself after them; the engine refuses any other order, either without the
// other, and the list without brackets — the reference's own example among them.
PropertyListAction = "ADD"i & ValueExpression & "WITH"i & '('
					   & "PROPERTY_SET_GUID"i & '=' & ValueExpression
					   & ',' & "PROPERTY_INT_ID"i & '=' & ValueExpression
					   & (',' & "PROPERTY_DESCRIPTION"i & '=' & ValueExpression)? & ')'
				   | "DROP"i & ValueExpression

// ── BACKUP and RESTORE ──────────────────────────────────────────────────────
//
// Two statements and one shape between them: what is being copied, the devices it is
// copied to or from, and a long option list. A device is a name or one of three words and
// a path, which is the only part of either that is not an option.
BackupStatement : @Statement
	// A group is several databases, which no other backup is.
	= "BACKUP"i & "GROUP"i & name: BackupGroup
	  & tail: ("TO"i & BackupDevices & MirrorTo* & BackupWith?)
		=> @(Statement.BackedUp("GROUP", name, Syntax.Tail(tail)))
	| "BACKUP"i & what: BackupWhat & name: BackupTarget?
	  & tail: (BackupFiles* & "TO"i & BackupDevices & MirrorTo* & BackupWith?)
		=> @(Statement.BackedUp(what, name, Syntax.Tail(tail)))
	// A key or a certificate to a file, put to the engine some sixty times: the path and the
	// passwords are strings, never variables; the name is one part. A certificate goes to a
	// file only and takes no password of its own, its private key going beside it in a list
	// of its own; a key takes the password it is locked with, and the service master key a
	// file only.
	| "BACKUP"i & "CERTIFICATE"i & key: Identifier
	  & tail: ("TO"i & "FILE"i & '=' & Quoted & CertificatePrivateKey?)
		=> @(Statement.BackedUp("CERTIFICATE", key, Syntax.Tail(tail)))
	| "BACKUP"i & "SYMMETRIC"i & "KEY"i & key: Identifier & tail: ("TO"i & KeyPlace & KeyLockedBy)
		=> @(Statement.BackedUp("SYMMETRIC KEY", key, Syntax.Tail(tail)))
	| "BACKUP"i & "MASTER"i & "KEY"i & tail: ("TO"i & KeyPlace & KeyLockedBy)
		=> @(Statement.BackedUp("MASTER KEY", null, Syntax.Tail(tail)))
	| "BACKUP"i & "SERVICE"i & "MASTER"i & "KEY"i & tail: ("TO"i & "FILE"i & '=' & Quoted & KeyLockedBy)
		=> @(Statement.BackedUp("SERVICE MASTER KEY", null, Syntax.Tail(tail)))

// And back: the password it was locked with, then — for the two that are locked again — the
// one to lock it with, in that order, and `FORCE` last.
RestoreStatement : @Statement
	= "RESTORE"i & "MASTER"i & "KEY"i & tail: ("FROM"i & KeyPlace & KeyUnlockedBy & KeyLockedBy & "FORCE"i?)
		=> @(Statement.Restored("MASTER KEY", null, Syntax.Tail(tail)))
	| "RESTORE"i & "SERVICE"i & "MASTER"i & "KEY"i
	  & tail: ("FROM"i & "FILE"i & '=' & Quoted & KeyUnlockedBy & "FORCE"i?)
		=> @(Statement.Restored("SERVICE MASTER KEY", null, Syntax.Tail(tail)))
	| "RESTORE"i & "SYMMETRIC"i & "KEY"i & key: Identifier
	  & tail: ("FROM"i & KeyPlace & KeyUnlockedBy & KeyLockedBy & "FORCE"i?)
		=> @(Statement.Restored("SYMMETRIC KEY", key, Syntax.Tail(tail)))
	| "RESTORE"i & what: RestoreWhat & name: BackupTarget?
	  & tail: (BackupFiles* & ("FROM"i & RestoreFrom)? & RestoreWith?)
		=> @(Statement.Restored(what, name, Syntax.Tail(tail)))

// Where a key goes and comes from, and the two passwords it is locked and unlocked with.
KeyPlace      = ("FILE"i | "URL"i) & '=' & Quoted
KeyLockedBy   = "ENCRYPTION"i & "BY"i & "PASSWORD"i & '=' & Quoted
KeyUnlockedBy = "DECRYPTION"i & "BY"i & "PASSWORD"i & '=' & Quoted

// A certificate's private key, written beside it: a file and the passwords, in any order,
// after the format the certificate is written in if one is named.
CertificatePrivateKey = "WITH"i & ("FORMAT"i & '=' & Quoted & ',')? & "PRIVATE"i & "KEY"i
					  & '(' & CertificateKeyItems & ')'

// The algorithm the key is written with, which a backup names and nothing else does — `CREATE`
// and `ALTER CERTIFICATE` refuse it, and so do the keys' own backups — is a string, whatever
// it says, and said once (`Msg 102`).
CertificateKeyItems : @string[]
	= first: CertificateKeyItem & (',' & rest: CertificateKeyItem)* & when @(Syntax.Once("ALGORITHM", first, rest))
		=> @(Syntax.Named(first, rest))

CertificateKeyItem : @string
	= t: ("FILE"i & '=' & Quoted | KeyLockedBy | KeyUnlockedBy | "ALGORITHM"i & '=' & Quoted) => @(t)


BackupWhat : @string
	= "DATABASE"i => @("DATABASE")
	| "LOG"i      => @("LOG")
	| "SERVER"i   => @("SERVER")

RestoreWhat : @string
	= "DATABASE"i     => @("DATABASE")
	| "LOG"i          => @("LOG")
	| "FILELISTONLY"i => @("FILELISTONLY")
	| "HEADERONLY"i   => @("HEADERONLY")
	| "LABELONLY"i    => @("LABELONLY")
	| "REWINDONLY"i   => @("REWINDONLY")
	| "VERIFYONLY"i   => @("VERIFYONLY")

// What a database being copied is called, and what it is not: the four words that begin a
// file clause and the three that begin the clause after it. Without the lookahead the name
// takes the `FILE` of `BACKUP DATABASE FILE = 'f' TO …` and the statement is one word short
// for the rest of its length — which GRAM5009 said before anybody wrote that script.
BackupTarget : @string = ?!BackupBoundary & t: BackupName => @(t)

BackupBoundary = "FILE"i | "FILEGROUP"i | "READ_WRITE_FILEGROUPS"i | "PAGE"i
			   | "TO"i | "FROM"i | "WITH"i

BackupName : @string
	= t: QualifiedName                       => @(t)
	| t: TSql.Variable                       => @(t)
	| t: Sql92.Lexical.CharacterStringLiteral => @(t)
	| '(' & first: BackupName & (',' & BackupName)* & ')' => @(first)

// The four the published syntax names, written out. An option's name is a run of words,
// so a rule that read one here would read `TO someDevice` and leave the statement with no
// device — the same trap an unbounded run always is.
BackupFiles = ','? & BackupFile

BackupFile = "FILE"i & '=' & BackupName
		   | "FILEGROUP"i & '=' & BackupName
		   | "READ_WRITE_FILEGROUPS"i
		   | "PAGE"i & '=' & ValueExpression

BackupDevices = BackupDevice & (',' & BackupDevice)*

BackupDevice = DeviceWord & '=' & ValueExpression
			 | QualifiedName
			 | TSql.Variable

DeviceWord = "DISK"i | "TAPE"i | "URL"i

MirrorTo = "MIRROR"i & "TO"i & BackupDevices

// A snapshot is named by a string or a variable, not by a name: `= s` is refused.
RestoreFrom = "DATABASE_SNAPSHOT"i & '=' & BackupString
			| BackupDevices

BackupGroup : @string = t: (BackupName & (',' & BackupName)*) => @(t)

// ── What a backup and a restore are given ───────────────────────────────────
//
// The published blocks' options, put to the engine some two hundred times. A backup and a
// restore have a list each, and the restore's is one list for all its forms: the engine
// reads `RECOVERY` and `MOVE` in a `RESTORE HEADERONLY` as well, where the blocks give each
// form its own shorter list, and objects afterwards. Every name here — a backup set's, a
// media set's, a credential's, a password — is a string or a variable, never a name; every
// number is a constant or a variable, and a constant may be a string. `ENCRYPTION` and
// `CREDENTIAL` alone, which the backup block lists, are refused; so are `TRUNCATE_ONLY`,
// removed, and the Parallel Data Warehouse's `BASE` and `DIFFERENTIAL` in a restore. A
// restore takes one option no block names, `KEEP_TEMPORAL_RETENTION`, which the corpus has,
// and a FILESTREAM directory that is `NULL`.
BackupWith  = "WITH"i & BackupOption & (',' & BackupOption)*
RestoreWith = "WITH"i & RestoreOption & (',' & RestoreOption)*

BackupString = Quoted | TSql.Variable
BackupValue  = Quoted | TSql.Variable | Sql92.Lexical.UnsignedNumericLiteral

BackupOption
	= "DIFFERENTIAL"i | "COPY_ONLY"i | "NO_COMPRESSION"i | "FILE_SNAPSHOT"i
	| "METADATA_ONLY"i | "SNAPSHOT"i
	| "COMPRESSION"i
	  & ('(' & "ALGORITHM"i & '=' & CompressionAlgorithm
		 & (',' & "LEVEL"i & '=' & ("LOW"i | "MEDIUM"i | "HIGH"i))? & ')')?
	| "ENCRYPTION"i & '(' & "ALGORITHM"i & '=' & ("AES_128"i | "AES_192"i | "AES_256"i | "TRIPLE_DES_3KEY"i)
	  & ',' & "SERVER"i & ("CERTIFICATE"i | "ASYMMETRIC"i & "KEY"i) & '=' & Identifier & ')'
	| ("DESCRIPTION"i | "MEDIADESCRIPTION"i | "EXPIREDATE"i | "RETAINDAYS"i
	  | "BLOCKSIZE"i | "BUFFERCOUNT"i | "MAXTRANSFERSIZE"i | "BACKUP_OPTIONS"i) & '=' & BackupValue
	| ("NAME"i | "MEDIANAME"i | "CREDENTIAL"i | "PASSWORD"i | "MEDIAPASSWORD"i | "STANDBY"i)
	  & '=' & BackupString
	| "INIT"i | "NOINIT"i | "SKIP"i | "NOSKIP"i | "FORMAT"i | "NOFORMAT"i
	| "CHECKSUM"i | "NO_CHECKSUM"i | "STOP_ON_ERROR"i | "CONTINUE_AFTER_ERROR"i | "RESTART"i
	| "STATS"i & ('=' & BackupValue)?
	| "REWIND"i | "NOREWIND"i | "UNLOAD"i | "NOUNLOAD"i
	| "NORECOVERY"i | "NO_TRUNCATE"i | "NO_LOG"i

// `QAT_DEFLATE` is the accelerator's, and the engine reads it; `ALGORITHM = FOO` it does not.
CompressionAlgorithm = "MS_XPRESS"i | "ZSTD"i | "QAT_DEFLATE"i

// The moved file's names are strings, and two moves need the comma between them.
RestoreOption
	= "RECOVERY"i | "NORECOVERY"i | "REPLACE"i | "RESTART"i | "RESTRICTED_USER"i
	| "PARTIAL"i | "LOADHISTORY"i | "METADATA_ONLY"i | "SNAPSHOT"i
	| "STANDBY"i & '=' & BackupString
	| "MOVE"i & BackupString & "TO"i & BackupString
	| ("CREDENTIAL"i | "PASSWORD"i | "MEDIAPASSWORD"i | "MEDIANAME"i | "DBNAME"i | "RESTORE_OPTIONS"i) & '=' & BackupString
	| "FILE"i & '=' & (Sql92.Lexical.UnsignedNumericLiteral | TSql.Variable)
	| ("BLOCKSIZE"i | "BUFFERCOUNT"i | "MAXTRANSFERSIZE"i | "STOPAT"i) & '=' & BackupValue
	| ("STOPATMARK"i | "STOPBEFOREMARK"i) & '=' & BackupValue & ("AFTER"i & BackupValue)?
	| "CHECKSUM"i | "NO_CHECKSUM"i | "STOP_ON_ERROR"i | "CONTINUE_AFTER_ERROR"i
	| "STATS"i & ('=' & BackupValue)?
	| "REWIND"i | "NOREWIND"i | "UNLOAD"i | "NOUNLOAD"i
	| "KEEP_REPLICATION"i | "KEEP_CDC"i | "KEEP_TEMPORAL_RETENTION"i
	| "FILESTREAM"i & '(' & "DIRECTORY_NAME"i & '=' & (Quoted | "NULL"i) & ')'
	| "ENABLE_BROKER"i | "ERROR_BROKER_CONVERSATIONS"i | "NEW_BROKER"i

// ── What the server watches, and who it listens to ──────────────────────────
//
// Audits, extended-event sessions, event notifications and endpoints. Eleven published
// blocks and three shapes: a name and where its output goes, a list of things added and
// dropped, and a bracketed argument list per protocol.
AuditStatement : @Statement
	// A specification is a list of what is watched, added and dropped a bracket at a time.
	// In front of the audit it belongs to, since `ALTER SERVER AUDIT SPECIFICATION` begins
	// with `ALTER SERVER AUDIT` and every clause of an audit is optional — so the shorter
	// reading fits, and over kinds a reading that fits is the one that stands (§4).
	= verb: CreateOrAlter & scope: ServerOrDatabase & "AUDIT"i & "SPECIFICATION"i & name: Identifier
	  & tail: (("FOR"i & "SERVER"i & "AUDIT"i & QualifiedName)? & AuditAction* & OptionsWith?)
		=> @(Statement.Defined(
				 scope == "SERVER" ? "AUDIT SPECIFICATION" : "DATABASE AUDIT SPECIFICATION",
				 name, Syntax.Tail(tail), verb))

	| said: "CREATE"i & "SERVER"i & "AUDIT"i & name: Identifier
	  & tail: ("TO"i & AuditTarget & OptionsWith? & AuditWhere?)
		=> @(Statement.Defined("SERVER AUDIT", name, Syntax.Tail(tail), said))
	| said: "ALTER"i & "SERVER"i & "AUDIT"i & name: Identifier & tail: AlterAuditBody
		=> @(Statement.Defined("SERVER AUDIT", name, Syntax.Tail(tail), said))

	// An extended-event session: events, targets, and what to spend on them.
	| verb: CreateOrAlter & "EVENT"i & "SESSION"i & name: Identifier & "ON"i & on: ServerOrDatabase
	  & pieces: EventPieces? & options: OptionsWith? & ("STATE"i & '=' & status: word)?
		=> @(new Statement.EventSessionDefinition(name, verb, on, pieces, options, status))

	| "CREATE"i & "EVENT"i & "NOTIFICATION"i & name: Identifier
	  & tail: ("ON"i & NotificationScope & ("WITH"i & "FAN_IN"i)?
			   & "FOR"i & ActionWords & (',' & ActionWords)*
			   & "TO"i & "SERVICE"i & ValueExpression & (',' & ValueExpression)*)
		=> @(Statement.Defined("EVENT NOTIFICATION", name, Syntax.Tail(tail)))

	// An endpoint says how it is reached and what it speaks, and each is a bracket of
	// arguments belonging to that protocol rather than to this language. The two come in
	// either order, and an owner is given only when the endpoint is created.
	| verb: CreateOrAlter & "ENDPOINT"i & name: Identifier & ("AUTHORIZATION"i & owner: QualifiedName)?
	  & standing: EndpointState? & reached: EndpointAs? & spoken: EndpointFor? & late: EndpointAs?
	  & when @((owner is null || verb == "CREATE") && (reached is null || late is null)
			  && Syntax.Created(verb, spoken))
		=> @(new Statement.EndpointDefinition(name, verb, owner,
				 standing?.Name is "" ? null : standing?.Name, standing?.Options,
				 (reached ?? late)?.Name, (reached ?? late)?.Options, spoken?.Name, spoken?.Options))

ServerOrDatabase : @string = "SERVER"i => @("SERVER") | "DATABASE"i => @("DATABASE")

NotificationScope = "QUEUE"i & QualifiedName | "SERVER"i | "DATABASE"i

// ── An audit ────────────────────────────────────────────────────────────────
AuditTarget = "FILE"i & '(' & OptionList & ')'
			| word

AuditWhere = "WHERE"i & SearchCondition

AlterAuditBody = "REMOVE"i & "WHERE"i
			   | "MODIFY"i & "NAME"i & '=' & Identifier
			   | ("TO"i & AuditTarget)? & OptionsWith? & AuditWhere?

// `ADD (SELECT ON t BY dbo)`, `DROP (DATABASE_PERMISSION_CHANGE_GROUP)`. The comma between
// two of them is optional in the corpus and required in the block, so it is read as neither.
AuditAction = AddOrDrop & '(' & AuditActionBody & ')' & ','?

AddOrDrop = "ADD"i | "DROP"i

AuditActionBody = ActionWords & (',' & ActionWords)* & AuditActionOn?

// Whom an action is watched for: principals, and `NULL` among them anywhere, as a permission's
// grantees are — `BY PUBLIC, NULL, dbo` is read, and `BY NULL AS x` refused.
AuditActionOn = "ON"i & SecurableClass? & QualifiedName & "BY"i & Grantees

// ── An extended-event session ───────────────────────────────────────────────
EventPieces : @Clause[] = first: EventPiece & (','? & rest: EventPiece)* => @(Syntax.Listed(first, rest))

EventPiece : @Clause
	= "ADD"i & "EVENT"i & name: QualifiedName & ('(' & body: EventBody & ')')?
		=> @((body ?? new Clause.EventPiece("", "")) with { Action = "ADD EVENT", Name = name })
	| "DROP"i & "EVENT"i & name: QualifiedName  => @(new Clause.EventPiece("DROP EVENT", name))
	| "ADD"i & "TARGET"i & name: QualifiedName & ('(' & "SET"i & set: OptionList & ')')?
		=> @(new Clause.EventPiece("ADD TARGET", name, set))
	| "DROP"i & "TARGET"i & name: QualifiedName => @(new Clause.EventPiece("DROP TARGET", name))

EventBody : @Clause.EventPiece
	= ("SET"i & set: OptionList)? & actions: EventActions? & ("WHERE"i & where: EventPredicate)?
		=> @(new Clause.EventPiece("", "", set, actions, where))

// Not a search condition. An event's predicate compares a field with a constant, and it
// also *calls* a comparison the package supplies — `sqlserver.equal_i_sql_unicode_string
// (field, N'x')` — which is a call standing where a condition goes and is not one anywhere
// else in this language. The comma joins two of them, as `AND` does.
EventPredicate : @string = t: (EventFactor & (EventJoin & EventFactor)*) => @(Syntax.Spaced(t))

EventJoin   = "AND"i | "OR"i | ','
EventFactor = "NOT"i? & EventTerm

EventTerm = '(' & EventPredicate & ')'
		  | name: QualifiedName & EventTermTail

EventTermTail = '(' & EventSource & ',' & ValueExpression & ')'
			  | EventCompare & ValueExpression

EventSource  = '(' & QualifiedName & ')' | QualifiedName
EventCompare = "<>" | "!=" | ">=" | "<=" | '=' | '>' | '<' | "NOT"i? & "LIKE"i

EventActions : @string[] = "ACTION"i & '(' & first: EventAction & (',' & rest: EventAction)* & ')' => @(Syntax.Named(first, rest))
EventAction  : @string   = t: QualifiedName => @(t)

// ── An endpoint ─────────────────────────────────────────────────────────────
//
// The published blocks, put to the engine some hundred and fifty times. What it knows is
// closed for every protocol and every language: `AS FOO` and `FOR FOO` are refused, and so
// is a setting the language does not have — `ROLE` belongs to mirroring, the forwarding to
// the broker, and T-SQL takes an encryption and nothing else. A setting said twice it reads
// and objects to afterwards (7816), so a repeat is the walker's here as everywhere.
//
// It also reads what no page describes any more: `AS HTTP` and `FOR SOAP`, SQL Server 2005's
// web services, removed in 2012 and still in the parser. Those two keep the open list, there
// being no block to close it with.

// `STATE = STARTED, AFFINITY = NONE`: the published block names only the state, and the
// engine reads an affinity too — before the state, after it or alone, the comma between them
// — which is `NONE` or `ADMIN` and not a name. Kept as written: a state first is the node's
// state, and anything else its list.
EndpointState : @Clause.Option
	= "STATE"i & '=' & s: EndpointStateWord & (',' & rest: EndpointSetting)*
		=> @(new Clause.Option(s, null, rest ?? Clause.None))
	| first: EndpointAffinity & (',' & rest: EndpointSetting)*
		=> @(new Clause.Option("", null, Syntax.Listed(first, rest)))

EndpointStateWord    = "STARTED"i | "STOPPED"i | "DISABLED"i
EndpointAffinityWord = "NONE"i | "ADMIN"i

EndpointSetting : @Clause
	= "STATE"i & '=' & s: EndpointStateWord => @(new Clause.Option("STATE", new Expression.ColumnReference(s), Clause.None))
	| a: EndpointAffinity => @(a)

EndpointAffinity : @Clause
	= "AFFINITY"i & '=' & v: EndpointAffinityWord => @(new Clause.Option("AFFINITY", new Expression.ColumnReference(v), Clause.None))

// How it is reached. TCP needs a setting at least; `AS TCP ()` is refused.
EndpointAs : @Clause.Option
	= "AS"i & w: EndpointTcp & '(' & first: EndpointTcpOption & (',' & rest: EndpointTcpOption)* & ')'
		=> @(new Clause.Option(w, null, Syntax.Listed(first, rest)))
	| "AS"i & w: EndpointHttp & '(' & o: OptionList & ')' => @(new Clause.Option(w, null, o))

EndpointTcp  = "TCP"i
EndpointHttp = "HTTP"i

// A port is a whole number — `-1` is read, and then found out of range (7810) — and an
// address `ALL`, strings in brackets for IPv6, or four numbers in brackets however they are
// spaced: `(1 . 2 . 3 . 4)` is how the corpus writes it, and a number of the lexer's own
// holds a dot, so the four are counted after the reading rather than by it. Four more after
// a colon are the mask, `(1.1.1.1:255.0.0.0)`, which no block names and the engine reads.
EndpointTcpOption : @Clause
	= ?=("LISTENER_PORT"i & '=' & '-'? & Sql92.Lexical.Digits & OptionEnds) & o: OptionSetting => @(o)
	| ?=("LISTENER_IP"i & '=' & ("ALL"i | '(' & Quoted & (',' & Quoted)* & ')') & OptionEnds) & o: OptionSetting => @(o)
	| "LISTENER_IP"i & '=' & t: EndpointAddress & when @(t is not null && Syntax.IsAddress(t))
		=> @(new Clause.Option("LISTENER_IP", new Expression.ColumnReference(Syntax.Compacted(t)), Clause.None))

EndpointAddress = '(' & (Sql92.Lexical.UnsignedNumericLiteral | '.' | ':')+ & ')'

// What it speaks, and each language its own list; an empty bracket is read for all four.
EndpointFor : @Clause.Option
	= "FOR"i & w: EndpointTsql & '(' & o: EndpointTsqlOptions? & ')' => @(new Clause.Option(w, null, o ?? Clause.None))
	| "FOR"i & w: EndpointBroker & '(' & o: EndpointBrokerOptions? & ')' => @(new Clause.Option(w, null, o ?? Clause.None))
	| "FOR"i & w: EndpointMirroring & '(' & o: EndpointMirroringOptions? & ')' => @(new Clause.Option(w, null, o ?? Clause.None))
	| "FOR"i & w: EndpointSoap & '(' & o: EndpointSoapOptions? & ')' => @(new Clause.Option(w, null, o ?? Clause.None))

EndpointTsql      = "TSQL"i
EndpointBroker    = "SERVICE_BROKER"i
EndpointMirroring = "DATABASE_MIRRORING"i | "DATA_MIRRORING"i
EndpointSoap      = "SOAP"i

// SOAP's own list, which is its settings and its web methods mixed in either order. A method
// is added, altered or dropped where the endpoint is altered, and written bare where it is
// created — bare under an `ALTER` is `Msg 7803`, which the statement asks about since the verb
// is read there and not here. Its name is one quoted string or two, `'n1'.'m1'`, and never an
// identifier —
// `ADD WEBMETHOD m1 (NAME = 'n1')` is `Msg 102` and a run of option words had read it.
// Dropped it takes nothing further; added or altered it takes a bracket that may not be empty,
// holding `NAME` (a string, and `NAME = d1.dbo.n1` is refused), `SCHEMA` and `FORMAT` from
// their catalogues, each of them readable twice.
//
// What the engine says of `ADD WEBMETHOD 'm1'(NAME = 'n1')` is `Msg 7819`, "The SOAP method
// object 'n1' must be specified using a fully qualified three-part name" — a judgement about
// the name it was given rather than about the shape it was written in, so the statement was
// read. These endpoints were removed in 2012 and the parser still reads them, which is the
// same reason `AS HTTP` is here.
EndpointSoapOptions : @Clause[]
	= first: EndpointSoapOption & (',' & rest: EndpointSoapOption)* => @(Syntax.Listed(first, rest))

EndpointSoapOption : @Clause
	= verb: ("ADD"i | "ALTER"i) & "WEBMETHOD"i & name: WebMethodName
	  & '(' & method: WebMethodOptions & ')'
		=> @(new Clause.Option(Syntax.Spaced(verb) + " WEBMETHOD",
				 new Expression.Literal(SqlLiteralKind.Text, name), method, null, true))
	| "DROP"i & "WEBMETHOD"i & name: WebMethodName
		=> @(new Clause.Option("DROP WEBMETHOD",
				 new Expression.Literal(SqlLiteralKind.Text, name), Clause.None, null, true))
	| "WEBMETHOD"i & name: WebMethodName & '(' & method: WebMethodOptions & ')'
		=> @(new Clause.Option("WEBMETHOD",
				 new Expression.Literal(SqlLiteralKind.Text, name), method, null, true))

	// A setting, and never a web method the alternatives above have refused: a run of option
	// words would read `ADD WEBMETHOD m1 (NAME = 'n1')` whole, which is `Msg 102`.
	| ?!(("ADD"i | "ALTER"i | "DROP"i)? & "WEBMETHOD"i) & o: OptionSetting => @(o)

WebMethodName : @string = t: (Quoted & ('.' & Quoted)?) => @(t)

WebMethodOptions : @Clause[]
	= first: WebMethodOption & (',' & rest: WebMethodOption)* => @(Syntax.Listed(first, rest))

WebMethodOption : @Clause
	= "NAME"i & '=' & v: BrokerString
		=> @(new Clause.Option("NAME", v, Clause.None))
	| "SCHEMA"i & '=' & t: WebMethodSchema
		=> @(new Clause.Option("SCHEMA", new Expression.ColumnReference(t), Clause.None))
	| "FORMAT"i & '=' & t: WebMethodFormat
		=> @(new Clause.Option("FORMAT", new Expression.ColumnReference(t), Clause.None))

WebMethodSchema = "NONE"i | "STANDARD"i | "DEFAULT"i
WebMethodFormat = "NONE"i | "ALL_RESULTS"i | "ROWSETS_ONLY"i

EndpointTsqlOptions : @Clause[]
	= first: EndpointEncryption & (',' & rest: EndpointEncryption)* => @(Syntax.Listed(first, rest))
EndpointBrokerOptions : @Clause[]
	= first: EndpointBrokerOption & (',' & rest: EndpointBrokerOption)* => @(Syntax.Listed(first, rest))
EndpointMirroringOptions : @Clause[]
	= first: EndpointMirroringOption & (',' & rest: EndpointMirroringOption)* => @(Syntax.Listed(first, rest))

EndpointBrokerOption : @Clause
	= e: EndpointEncryption     => @(e)
	| a: EndpointAuthentication => @(a)
	| ?=(("MESSAGE_FORWARDING"i & '=' & ("ENABLED"i | "DISABLED"i)
		 | "MESSAGE_FORWARD_SIZE"i & '=' & '-'? & Sql92.Lexical.Digits) & OptionEnds) & o: OptionSetting => @(o)

EndpointMirroringOption : @Clause
	= e: EndpointEncryption     => @(e)
	| a: EndpointAuthentication => @(a)
	| ?=("ROLE"i & '=' & ("WITNESS"i | "PARTNER"i | "ALL"i) & OptionEnds) & o: OptionSetting => @(o)

// One encryption for the three languages: the block gives T-SQL `NEGOTIATED` and `STRICT`
// and the other two the rest, and the engine reads every one of them in each. An algorithm
// follows only what may be encrypted, and names each of the two once.
EndpointEncryption : @Clause = ?=("ENCRYPTION"i & '=' & EndpointEncryptionSyntax & OptionEnds) & o: OptionSetting => @(o)

EndpointEncryptionSyntax
	= "DISABLED"i | "NEGOTIATED"i | "STRICT"i
	| ("SUPPORTED"i | "REQUIRED"i) & ("ALGORITHM"i & ("AES"i & "RC4"i? | "RC4"i & "AES"i?))?

// Windows with its protocol, a certificate, or both in either order, each once. The
// certificate is a name, `[c]` included, which a run of option words does not read.
EndpointAuthentication : @Clause
	= "AUTHENTICATION"i & '=' & t: EndpointAuthenticationSyntax
		=> @(new Clause.Option("AUTHENTICATION", new Expression.ColumnReference(Syntax.Spaced(t)), Clause.None))

EndpointAuthenticationSyntax
	= "WINDOWS"i & EndpointWindowsMode? & ("CERTIFICATE"i & Identifier)?
	| "CERTIFICATE"i & Identifier & ("WINDOWS"i & EndpointWindowsMode?)?

EndpointWindowsMode = "NTLM"i | "KERBEROS"i | "NEGOTIATE"i

// ── What lives outside the database, and what the server spends on it ───────
//
// External data sources, file formats, tables and libraries; resource pools and workload
// groups; statistics. Fourteen published blocks and almost all of them are a name and an
// option list — which is the shape this grammar has been reading since `CREATE TABLE`.
// What is new is four clauses that are not a name and a value.
ExternalStatement : @Statement
	= verb: CreateOrAlter & "EXTERNAL"i & "DATA"i & "SOURCE"i & name: Identifier & tail: DataSourceBody
		=> @(Statement.Defined("EXTERNAL DATA SOURCE", name, Syntax.Tail(tail), verb))
	| "CREATE"i & "EXTERNAL"i & "FILE"i & "FORMAT"i & name: Identifier & tail: OptionsWithText
		=> @(Statement.Defined("EXTERNAL FILE FORMAT", name, Syntax.Tail(tail)))

	// A table of somebody else's rows: the columns as this grammar reads any columns, and
	// then where they are. Synapse writes the query instead and lets it say the columns.
	| "CREATE"i & "EXTERNAL"i & "TABLE"i & name: QualifiedName & '(' & body: TableBody & ')'
	  & options: OptionsWith
		=> @(new Statement.TableDefinition(name, null, body, Clause.None, options, true))
	| "CREATE"i & "EXTERNAL"i & "TABLE"i & name: QualifiedName & options: OptionsWith
	  & "AS"i & q: DirectSelect
		=> @(new Statement.CreateTableAsSelect(name, null, options, q, true))

	| said: "CREATE"i & "EXTERNAL"i & "LIBRARY"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & QualifiedName)?
			   & "FROM"i & LibraryFile & (',' & LibraryFile)* & OptionsWith?)
		=> @(Statement.Defined("EXTERNAL LIBRARY", name, Syntax.Tail(tail), said))
	| said: "ALTER"i & "EXTERNAL"i & "LIBRARY"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & QualifiedName)?
			   & LibraryChange & LibraryFile & (',' & LibraryFile)* & OptionsWith?)
		=> @(Statement.Defined("EXTERNAL LIBRARY", name, Syntax.Tail(tail), said))

	| verb: CreateOrAlter & "EXTERNAL"i & "RESOURCE"i & "POOL"i & pool: PoolName & tail: OptionsWithText?
		=> @(Statement.Defined("EXTERNAL RESOURCE POOL", pool, Syntax.Tail(tail), verb))
	| verb: CreateOrAlter & "RESOURCE"i & "POOL"i & pool: PoolName & tail: OptionsWithText?
		=> @(Statement.Defined("RESOURCE POOL", pool, Syntax.Tail(tail), verb))
	| verb: CreateOrAlter & "WORKLOAD"i & "GROUP"i & pool: PoolName
	  & tail: (OptionsWithText? & ("USING"i & WorkloadPool & (',' & WorkloadPool)*)?)
		=> @(Statement.Defined("WORKLOAD GROUP", pool, Syntax.Tail(tail), verb))

	// Statistics: a name, what they are on, and how they are gathered. `SAMPLE 50 PERCENT`
	// is three words where an option is usually a name and a value, and the option list
	// reads it as one name — which is what a run of words is for (§4.6).
	| "CREATE"i & "STATISTICS"i & name: Identifier
	  & tail: ("ON"i & QualifiedName & IndexColumns & ("WHERE"i & SearchCondition)? & CreateStatisticsWith?)
		=> @(new Statement.StatisticsDefinition(name) { Tail = Syntax.Tail(tail) })
	| "UPDATE"i & "STATISTICS"i & on: QualifiedName & tail: (StatisticsTarget? & UpdateStatisticsWith?)
		=> @(new Statement.UpdateStatistics(on) { Tail = Syntax.Tail(tail) })

CreateOrAlter : @string = "CREATE"i => @("CREATE") | "ALTER"i => @("ALTER")

// `"default"` is a pool, and a delimited name is how the syntax says so.
PoolName : @string = t: Identifier => @(t) | t: Sql92.Lexical.CharacterStringLiteral => @(t)

WorkloadPool = "EXTERNAL"i? & PoolName

DataSourceBody = OptionsWith
			   | "SET"i & OptionList

LibraryChange = "SET"i | "ADD"i
LibraryFile   = '(' & OptionList & ')'

// Statistics' own lists, the commas required and the order free. Making statistics takes
// neither a resample nor which statistics to make — `RESAMPLE` and `COLUMNS` are refused
// there — and of the stream it may be handed, only the stream: `ROWCOUNT` and `PAGECOUNT`,
// which its block lists beside it, are refused.
CreateStatisticsWith = "WITH"i & CreateStatisticsOption & (',' & CreateStatisticsOption)*

CreateStatisticsOption
	= "FULLSCAN"i
	| "SAMPLE"i & Number & ("PERCENT"i | "ROWS"i)
	| "PERSIST_SAMPLE_PERCENT"i & OnOffValue
	| "NORECOMPUTE"i
	| "INCREMENTAL"i & OnOffValue
	| MaxDop
	| "AUTO_DROP"i & OnOffValue
	| "STATS_STREAM"i & '=' & TSql.BinaryLiteral

UpdateStatisticsWith = "WITH"i & UpdateStatisticsOption & (',' & UpdateStatisticsOption)*

UpdateStatisticsOption
	= CreateStatisticsOption
	| "RESAMPLE"i & OnPartitions?
	| "ALL"i | "COLUMNS"i | "INDEX"i
	| "ROWCOUNT"i & '=' & Number
	| "PAGECOUNT"i & '=' & Number

StatisticsTarget = '(' & IndexName & (',' & IndexName)* & ')'
				 | IndexName

// ── Who may connect, and as whom ────────────────────────────────────────────
//
// Logins, users, roles and schemas: a name, where it came from, and a list of settings.
// The settings are a closed list for each statement, put to the engine some two hundred
// times, and no two statements share one: a login from Windows takes a database and a
// language, one from a certificate a credential and nothing else, and an application role
// being altered takes a login and a language that one being created does not.
//
// What they share is how a value is written. A password is a string, or a hash in hex that
// says it is one, `0x0100 HASHED`, and never a variable; a SID is a hex string; a database,
// a language, a schema, a credential and a new name are names, and `'d'` is refused where a
// block writes `database`. And a password is followed by words with no commas between them
// — `PASSWORD = 'p' MUST_CHANGE`, `PASSWORD = 'p' OLD_PASSWORD = 'q'` — which is why it is a
// rule of its own in each list.
PrincipalStatement : @Statement
	= "CREATE"i & "LOGIN"i & name: Identifier & tail: LoginBody
		=> @(Statement.Defined("CREATE LOGIN", name, Syntax.Tail(tail)))
	| "ALTER"i & "LOGIN"i & name: Identifier & tail: AlterLoginBody
		=> @(Statement.Defined("ALTER LOGIN", name, Syntax.Tail(tail)))

	| "CREATE"i & "USER"i & name: Identifier & tail: (UserSource? & UserOptions?)
		=> @(Statement.Defined("CREATE USER", name, Syntax.Tail(tail)))
	| "ALTER"i & "USER"i & name: Identifier & tail: AlterUserBody
		=> @(Statement.Defined("ALTER USER", name, Syntax.Tail(tail)))

	| "CREATE"i & scope: RoleWord & name: Identifier & tail: ("AUTHORIZATION"i & QualifiedName)?
		=> @(Statement.Defined(
				 Syntax.Squared(scope) == "ROLE" ? "CREATE ROLE" : "CREATE SERVER ROLE",
				 name, Syntax.Tail(tail)))
	| "ALTER"i & scope: RoleWord & name: Identifier & tail: RoleAction
		=> @(Statement.Defined(
				 Syntax.Squared(scope) == "ROLE" ? "ALTER ROLE" : "ALTER SERVER ROLE",
				 name, Syntax.Tail(tail)))

	| "CREATE"i & "APPLICATION"i & "ROLE"i & name: Identifier & tail: ("WITH"i & CreateRoleOptions)
		=> @(Statement.Defined("CREATE APPLICATION ROLE", name, Syntax.Tail(tail)))
	| "ALTER"i & "APPLICATION"i & "ROLE"i & name: Identifier & tail: ("WITH"i & AlterRoleOptions)
		=> @(Statement.Defined("ALTER APPLICATION ROLE", name, Syntax.Tail(tail)))

	// A schema may be declared by its owner alone — `CREATE SCHEMA AUTHORIZATION dbo` — and
	// what follows it is not a clause but whole statements, which is the one statement in
	// T-SQL that holds others without a `BEGIN`.
	| "CREATE"i & "SCHEMA"i & name: Identifier
	  & tail: ("AUTHORIZATION"i & QualifiedName & SchemaElement*)
		=> @(Statement.Defined("CREATE SCHEMA", name, Syntax.Tail(tail)))
	| "CREATE"i & "SCHEMA"i & tail: ("AUTHORIZATION"i & QualifiedName & SchemaElement*)
		=> @(Statement.Defined("CREATE SCHEMA", "", Syntax.Tail(tail)))
	| "CREATE"i & "SCHEMA"i & name: Identifier & tail: (SchemaElement*)
		=> @(Statement.Defined("CREATE SCHEMA", name, Syntax.Tail(tail)))
	| "ALTER"i & "SCHEMA"i & name: Identifier
	  & tail: ("TRANSFER"i & SecurableClass? & QualifiedName)
		=> @(Statement.Defined("ALTER SCHEMA", name, Syntax.Tail(tail)))

	| "ALTER"i & "AUTHORIZATION"i & tail: ("ON"i & SecurableClass? & QualifiedName
										  & "TO"i & AuthorizationTo)
		=> @(Statement.Defined("ALTER AUTHORIZATION", "", Syntax.Tail(tail)))

RoleWord : @string = t: ("SERVER"i & "ROLE"i | "ROLE"i) => @(Syntax.Squared(t))

RoleAction = "ADD"i & "MEMBER"i & QualifiedName
		   | "DROP"i & "MEMBER"i & QualifiedName
		   | "WITH"i & "NAME"i & '=' & QualifiedName

AuthorizationTo = "SCHEMA"i & "OWNER"i | QualifiedName

// What a schema declares in the same breath as itself. The published list is exactly these
// five, and each is the whole statement it is elsewhere.
SchemaElement = s: CreateTableStatement | s: CreateRoutine | s: PermissionStatement

// ── A login ─────────────────────────────────────────────────────────────────
// A login with a password has it first, and the rest after a comma; one without a password
// comes from somewhere, and takes what that source allows.
LoginBody = "WITH"i & CreatePassword & (',' & CreateLoginOption)*
		  | "FROM"i & LoginSource

// `'p' MUST_CHANGE HASHED` and `'p' HASHED MUST_CHANGE` alike, each word once; a hash in hex
// has to say it is one. `UNLOCK` and `OLD_PASSWORD` are for a login that exists.
CreatePassword = "PASSWORD"i & '=' & (Quoted & CreateHash? | TSql.BinaryLiteral & CreateHashed)

CreateHash   = "HASHED"i & "MUST_CHANGE"i? | "MUST_CHANGE"i & "HASHED"i?
CreateHashed = "HASHED"i & "MUST_CHANGE"i? | "MUST_CHANGE"i & "HASHED"i

CreateLoginOption = "SID"i & '=' & TSql.BinaryLiteral
				  | LoginPlace
				  | ("CHECK_EXPIRATION"i | "CHECK_POLICY"i) & '=' & OnOff
				  | "CREDENTIAL"i & '=' & Identifier

// Where a login starts: its database and its language, both names.
LoginPlace = ("DEFAULT_DATABASE"i | "DEFAULT_LANGUAGE"i) & '=' & Identifier

LoginSource = "WINDOWS"i & ("WITH"i & LoginPlace & (',' & LoginPlace)*)?
			| "EXTERNAL"i & "PROVIDER"i & ("WITH"i & ExternalLoginOption & (',' & ExternalLoginOption)*)?
			| "CERTIFICATE"i & Identifier & KeyCredential?
			| "ASYMMETRIC"i & "KEY"i & Identifier & KeyCredential?

// `TYPE = E` or `X`, a user or a group, which the block does not list and the corpus has; as
// for a user, the engine takes any name.
ExternalLoginOption = "OBJECT_ID"i & '=' & Quoted
					| "SID"i & '=' & TSql.BinaryLiteral
					| "TYPE"i & '=' & Identifier
					| LoginPlace

KeyCredential = "WITH"i & "CREDENTIAL"i & '=' & Identifier

AlterLoginBody = "ENABLE"i
			   | "DISABLE"i
			   | "WITH"i & AlterLoginOption & (',' & AlterLoginOption)*
			   | "ADD"i & "CREDENTIAL"i & QualifiedName
			   | "DROP"i & "CREDENTIAL"i & QualifiedName

AlterLoginOption = AlterPassword
				 | LoginPlace
				 | "NAME"i & '=' & Identifier
				 | ("CHECK_EXPIRATION"i | "CHECK_POLICY"i) & '=' & OnOff
				 | "CREDENTIAL"i & '=' & Identifier
				 | "NO"i & "CREDENTIAL"i
				 | "TYPE"i & '=' & Identifier

// The old password, or `HASHED`, `MUST_CHANGE` and `UNLOCK` in any order and each once: the
// block puts `HASHED` straight after the value, and the engine reads `'p' MUST_CHANGE HASHED
// UNLOCK` as well. Not the old password and the words both, and a hash in hex has to say it
// is one wherever the word stands.
AlterPassword = "PASSWORD"i & '=' & Quoted & "OLD_PASSWORD"i & '=' & Quoted
			  | "PASSWORD"i & '=' & (Quoted & PasswordWords? | TSql.BinaryLiteral & HashedWords)

PasswordWords = "HASHED"i & ("MUST_CHANGE"i & "UNLOCK"i? | "UNLOCK"i & "MUST_CHANGE"i?)?
			  | "MUST_CHANGE"i & ("HASHED"i & "UNLOCK"i? | "UNLOCK"i & "HASHED"i?)?
			  | "UNLOCK"i & ("HASHED"i & "MUST_CHANGE"i? | "MUST_CHANGE"i & "HASHED"i?)?

HashedWords = "HASHED"i & ("MUST_CHANGE"i & "UNLOCK"i? | "UNLOCK"i & "MUST_CHANGE"i?)?
			| "MUST_CHANGE"i & ("HASHED"i & "UNLOCK"i? | "UNLOCK"i & "HASHED"i)
			| "UNLOCK"i & ("HASHED"i & "MUST_CHANGE"i? | "MUST_CHANGE"i & "HASHED"i)

// ── A user ──────────────────────────────────────────────────────────────────
// Where a user comes from, and then one list whatever the source: the blocks give each
// source its own, but the engine reads a password after `FOR LOGIN` and objects afterwards
// (33234).
UserSource = ForOrFrom & UserFrom
		   | "WITHOUT"i & "LOGIN"i

UserFrom = "LOGIN"i & Identifier
		 | "CERTIFICATE"i & Identifier
		 | "ASYMMETRIC"i & "KEY"i & Identifier
		 | "EXTERNAL"i & "PROVIDER"i

ForOrFrom = "FOR"i | "FROM"i

UserOptions = "WITH"i & UserOption & (',' & UserOption)*

// A password with nothing after it. `TYPE = Z` and `OBJECT_ID = x` are read: a word, which
// only the Fabric warehouse the two are for looks at.
UserOption = "PASSWORD"i & '=' & Quoted
		   | "DEFAULT_SCHEMA"i & '=' & Identifier
		   | UserLanguage
		   | "SID"i & '=' & TSql.BinaryLiteral
		   | "ALLOW_ENCRYPTED_VALUE_MODIFICATIONS"i & '=' & OnOff
		   | "TYPE"i & '=' & Identifier
		   | "OBJECT_ID"i & '=' & (Quoted | Identifier)

// A language by its name or by its number, not by a string.
UserLanguage = "DEFAULT_LANGUAGE"i & '=' & (Identifier | Sql92.Lexical.Digits)

// Altered, a user takes settings only: where it comes from was fixed when it was created,
// and `FROM EXTERNAL PROVIDER`, the managed instance's, this engine refuses.
AlterUserBody = "WITH"i & AlterUserOption & (',' & AlterUserOption)*

AlterUserOption = "NAME"i & '=' & Identifier
				| "DEFAULT_SCHEMA"i & '=' & (Identifier | "NULL"i)
				| "LOGIN"i & '=' & Identifier
				| "PASSWORD"i & '=' & Quoted & ("OLD_PASSWORD"i & '=' & Quoted)?
				| UserLanguage
				| "ALLOW_ENCRYPTED_VALUE_MODIFICATIONS"i & '=' & OnOff

// ── An application role ─────────────────────────────────────────────────────
CreateRoleOptions = CreateRoleOption & (',' & CreateRoleOption)*
CreateRoleOption  = "PASSWORD"i & '=' & Quoted
				  | "DEFAULT_SCHEMA"i & '=' & Identifier

// Altered, a role takes a new name, a login and a language as well, which the block does
// not list for it and a user's list does — though the language only by its name.
AlterRoleOptions = AlterRoleOption & (',' & AlterRoleOption)*
AlterRoleOption  = CreateRoleOption
				 | "NAME"i & '=' & Identifier
				 | "LOGIN"i & '=' & Identifier
				 | "DEFAULT_LANGUAGE"i & '=' & Identifier

// ── DROP ────────────────────────────────────────────────────────────────────
//
// Sixty-six statements in the reference and one shape: `DROP <what> [ IF EXISTS ] <names>`,
// with a clause after it for the five that have one. Written from the sixty-six published
// blocks, which agree about everything but the words in the middle.
//
// Those words are written out, and here that is the syntax rather than a catalogue: `DROP
// TABLE` and `DROP VIEW` are different statements, `DROP DATABASE ENCRYPTION KEY` names no
// object at all, and a rule wide enough for any word would read `DROP FOO x` and call it
// one of them. The order is the one the words force — `DATABASE AUDIT SPECIFICATION`
// before `DATABASE`, `SERVER AUDIT SPECIFICATION` before `SERVER AUDIT` before `SERVER
// ROLE` — since ordered choice reads the first that fits.
DropStatement : @Statement
	= "DROP"i & d: DropBody => @(d)

DropBody : @Statement
	// The five that name something and then say where it is or what to do about it.
	= what: DropKeyKind & exists: IfExists? & names: DropNames
	  & tail: ("REMOVE"i & "PROVIDER"i & "KEY"i)?
		=> @(Statement.Dropped(what, names, tail, exists))
	| "ASSEMBLY"i & exists: IfExists? & names: DropNames
	  & tail: ("WITH"i & "NO"i & "DEPENDENTS"i)?
		=> @(Statement.Dropped("ASSEMBLY", names, tail, exists))
	| "EXTERNAL"i & "LIBRARY"i & names: DropNames & tail: ("AUTHORIZATION"i & QualifiedName)?
		=> @(Statement.Dropped("EXTERNAL LIBRARY", names, tail))
	| "EXTERNAL"i & "LANGUAGE"i & names: DropNames & tail: ("AUTHORIZATION"i & QualifiedName)?
		=> @(Statement.Dropped("EXTERNAL LANGUAGE", names, tail))
	| "EVENT"i & "SESSION"i & names: DropNames & tail: ("ON"i & DropScope)
		=> @(Statement.Dropped("EVENT SESSION", names, tail))
	| "EVENT"i & "NOTIFICATION"i & names: DropNames & tail: ("ON"i & DropScope)
		=> @(Statement.Dropped("EVENT NOTIFICATION", names, tail))

	// An index is named twice — once for itself and once for what it is on — and the older
	// spelling puts both in one qualified name.
	| "FULLTEXT"i & "INDEX"i & "ON"i & on: DropName
		=> @(Statement.Dropped("FULLTEXT INDEX", new Expression[] { on }))
	| "INDEX"i & exists: IfExists? & first: DropIndexName & (',' & rest: DropIndexName)*
		=> @(Statement.Dropped("INDEX", Syntax.Listed(first, rest), null, exists))

	// A signature is dropped off a module rather than by its own name, and a sensitivity
	// classification off a column.
	| counter: "COUNTER"i? & "SIGNATURE"i & "FROM"i & module: SignedModule & "BY"i
	  & first: SignatureCrypto & (',' & rest: SignatureCrypto)*
		=> @(new Statement.DropSignature(Syntax.Listed(first, rest), module, counter is not null))
	| "SENSITIVITY"i & "CLASSIFICATION"i & from: "FROM"i & names: DropNames
		=> @(Statement.Dropped("SENSITIVITY CLASSIFICATION", names))

	// A trigger says which of the three kinds it is by what it is on.
	| "TRIGGER"i & exists: IfExists? & names: DropNames & tail: ("ON"i & DropScope)?
		=> @(Statement.Dropped("TRIGGER", names, tail, exists))

	// The two that name nothing: there is one of each per database.
	| what: DropOnlyKind
		=> @(Statement.Dropped(what, Expression.None))

	| what: DropKind & exists: IfExists? & names: DropNames
		=> @(Statement.Dropped(what, names, null, exists))

DropNames : @Expression[]
	= first: DropName & (',' & rest: DropName)* => @(Syntax.Listed(first, rest))

DropName : @Expression = t: QualifiedName => @(new Expression.ColumnReference(t))

DropIndexName : @Expression
	= t: (Identifier & "ON"i & QualifiedName & DropIndexWith?) => @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| t: QualifiedName                                       => @(new Expression.ColumnReference(t))

// What an index is dropped with: a degree of parallelism, whether it is done online, where the
// rows go, what they are compressed as and on which partitions, how long it waits, and the
// filegroup the streams go to — each once (`Msg 153`), and nothing else (`Msg 155`), an
// index's own options among the refusals (`PAD_INDEX`, `SORT_IN_TEMPDB`, `DROP_EXISTING` are
// `Msg 102`). The rows go anywhere but a bare `DEFAULT`, and the streams take no column.
DropIndexWith = "WITH"i & '(' & DropIndexOptions & ')'

DropIndexOptions : @Clause[]
	= first: DropIndexOption & (',' & rest: DropIndexOption)* & when @(Syntax.NamedOnce(first, rest))
		=> @(Syntax.Listed(first, rest))

DropIndexOption : @Clause
	= "MAXDOP"i & '=' & t: Sql92.Lexical.Digits
		=> @(new Clause.Option("MAXDOP", new Expression.Literal(SqlLiteralKind.Number, t), Clause.None))
	| "ONLINE"i & '=' & o: OnOff
		=> @(new Clause.Option("ONLINE", new Expression.ColumnReference(o), Clause.None))
	| "MOVE"i & "TO"i & ?!"DEFAULT"i & p: PlacementTarget
		=> @(new Clause.Option("MOVE TO", null, new Clause[] { p }))
	| "FILESTREAM_ON"i & p: PlacementTarget & when @(p is not { Columns: not null })
		=> @(new Clause.Option("FILESTREAM_ON", null, new Clause[] { p }))
	| "DATA_COMPRESSION"i & '=' & w: (RowCompression | ColumnstoreCompression) & OnPartitions?
		=> @(new Clause.Option("DATA_COMPRESSION", new Expression.ColumnReference(Syntax.Squared(w)), Clause.None))
	| LowPriorityWait
		=> @(new Clause.Option("WAIT_AT_LOW_PRIORITY", null, Clause.None))

DropScope = "ALL"i & "SERVER"i | "SERVER"i | "DATABASE"i | "QUEUE"i & QualifiedName

DropKeyKind  = "ASYMMETRIC"i & "KEY"i | "SYMMETRIC"i & "KEY"i
DropOnlyKind = "MASTER"i & "KEY"i | "DATABASE"i & "ENCRYPTION"i & "KEY"i

// The rest, longest first where one name begins another.
DropKind
	= "AGGREGATE"i
	| "APPLICATION"i & "ROLE"i
	| "AVAILABILITY"i & "GROUP"i
	| "BROKER"i & "PRIORITY"i
	| "CERTIFICATE"i
	| "COLUMN"i & "ENCRYPTION"i & "KEY"i
	| "COLUMN"i & "MASTER"i & "KEY"i
	| "CONTRACT"i
	| "CREDENTIAL"i
	| "CRYPTOGRAPHIC"i & "PROVIDER"i
	| "DATABASE"i & "AUDIT"i & "SPECIFICATION"i
	| "DATABASE"i & "SCOPED"i & "CREDENTIAL"i
	| "DATABASE"i
	| "DEFAULT"i
	| "ENDPOINT"i
	| "EXTERNAL"i & "DATA"i & "SOURCE"i
	| "EXTERNAL"i & "FILE"i & "FORMAT"i
	| "EXTERNAL"i & "LANGUAGE"i
	| "EXTERNAL"i & "MODEL"i
	| "EXTERNAL"i & "RESOURCE"i & "POOL"i
	| "EXTERNAL"i & "TABLE"i
	| "FULLTEXT"i & "CATALOG"i
	| "FULLTEXT"i & "STOPLIST"i
	| "FUNCTION"i
	| "LOGIN"i
	| "MESSAGE"i & "TYPE"i
	| "PARTITION"i & "FUNCTION"i
	| "PARTITION"i & "SCHEME"i
	| "PROCEDURE"i
	| "PROC"i
	| "QUEUE"i
	| "REMOTE"i & "SERVICE"i & "BINDING"i
	| "RESOURCE"i & "POOL"i
	| "ROLE"i
	| "ROUTE"i
	| "RULE"i
	| "SCHEMA"i
	| "SEARCH"i & "PROPERTY"i & "LIST"i
	| "SECURITY"i & "POLICY"i
	| "SEQUENCE"i
	| "SERVER"i & "AUDIT"i & "SPECIFICATION"i
	| "SERVER"i & "AUDIT"i
	| "SERVER"i & "ROLE"i
	| "SERVICE"i
	| "STATISTICS"i
	| "SYNONYM"i
	| "TABLE"i
	| "TYPE"i
	| "USER"i
	| "VIEW"i
	| "WORKLOAD"i & "CLASSIFIER"i
	| "WORKLOAD"i & "GROUP"i
	| "XML"i & "SCHEMA"i & "COLLECTION"i

// ── The database ────────────────────────────────────────────────────────────
//
// The largest thing left in the corpus — `ALTER DATABASE … SET` alone is 252 statements —
// and almost none of it is new. A database's settings are said the way an index's and a
// table's are, so the option list already written reads them; a file specification is that
// same list in brackets. What is new is the header and about thirty lines.
//
// A `CREATE DATABASE`'s settings are a catalogue, as `ALTER DATABASE … SET`'s are below, and
// for the reason `--split` found: read as a run of words, `… FOR ATTACH WITH RESTRICTED_USER`
// with no `;` after it took the `ALTER DATABASE` on the next line for more of its options.
// Only Azure's bracket of edition options is still an open list; it is Azure's statement,
// and the engine refuses it.
CreateDatabaseStatement : @Statement
	= "CREATE"i & "DATABASE"i & name: Identifier & '(' & options: OptionList & ')'
		=> @(new Statement.CreateDatabase(name, Clause.None, Tail: "", Options: options))
	| "CREATE"i & "DATABASE"i & name: Identifier & ("CONTAINMENT"i & '=' & containment: ("NONE"i | "PARTIAL"i))?
	  & files: DatabaseFiles? & ("COLLATE"i & collation: QualifiedName)? & tail: DatabaseTail?
		=> @((tail ?? new Statement.CreateDatabase("", Clause.None)) with
			 {
				 Name = name, Containment = containment, Collation = collation,
				 Files = files?.Files ?? Clause.None, Primary = files?.Primary ?? false, Log = files?.Log,
			 })

// What a database may be made out of instead of nothing: another database, a snapshot of
// one, or files that already exist. Each is the tail's words, and then the bracket and the
// `WITH` it may carry.
DatabaseTail : @Statement.CreateDatabase
	= "WITH"i & first: CreateDatabaseOption & (',' & rest: CreateDatabaseOption)*
		=> @(new Statement.CreateDatabase("", Clause.None, With: Syntax.Listed(first, rest)))
	| "FOR"i & "ATTACH"i & ('(' & options: OptionList & ')')?
	  & ("WITH"i & first: AttachOption & (',' & rest: AttachOption)*)?
		=> @(new Statement.CreateDatabase(
				 "", Clause.None, Tail: "FOR ATTACH", Options: options,
				 With: first is null ? null : Syntax.Listed(first, rest)))
	| "FOR"i & "ATTACH_REBUILD_LOG"i
		=> @(new Statement.CreateDatabase("", Clause.None, Tail: "FOR ATTACH_REBUILD_LOG"))

	// Undocumented and read: the same as `FOR ATTACH`, options and `WITH` and all.
	| "FOR"i & "ATTACH_FORCE_REBUILD_LOG"i & ('(' & options: OptionList & ')')?
	  & ("WITH"i & first: AttachOption & (',' & rest: AttachOption)*)?
		=> @(new Statement.CreateDatabase(
				 "", Clause.None, Tail: "FOR ATTACH_FORCE_REBUILD_LOG", Options: options,
				 With: first is null ? null : Syntax.Listed(first, rest)))

	// A snapshot takes a database's options too, which the block does not say and the engine
	// reads.
	| t: ("AS"i & "SNAPSHOT"i & "OF"i & Identifier)
	  & ("WITH"i & first: CreateDatabaseOption & (',' & rest: CreateDatabaseOption)*)?
		=> @(new Statement.CreateDatabase(
				 "", Clause.None, Tail: Syntax.Spaced(t), With: first is null ? null : Syntax.Listed(first, rest)))
	| t: ("AS"i & "COPY"i & "OF"i & QualifiedName) & ('(' & options: OptionList & ')')?
		=> @(new Statement.CreateDatabase("", Clause.None, Tail: Syntax.Spaced(t), Options: options))

// ── The files ───────────────────────────────────────────────────────────────
//
// A file specification is `( NAME = …, FILENAME = …, SIZE = 100 MB )`, which is an option
// list with a unit after the number — and that unit is why an option's value ends with a
// word: `100 MB`, `3 DAYS`, `10 %` are each one value in this language.
// The data files first and the filegroups after them — `ON FILEGROUP g (…)` is refused — and
// the log. A log without data files is read and objected to afterwards (188).
DatabaseFiles : @Statement.CreateDatabase
	= "ON"i & primary: "PRIMARY"i? & first: FileSpec & (',' & rest: FileGroupSpec)*
	  & log: DatabaseLogFiles?
		=> @(new Statement.CreateDatabase("", Syntax.Listed(first, rest), primary is not null, log))
	| log: DatabaseLogFiles
		=> @(new Statement.CreateDatabase("", Clause.None, false, log))

DatabaseLogFiles : @Clause[] = "LOG"i & "ON"i & first: FileSpec & (',' & rest: FileSpec)* => @(Syntax.Listed(first, rest))

FileGroupSpec : @Clause
	= "FILEGROUP"i & name: Identifier & ("CONTAINS"i & contains: FileGroupHolds)? & fallback: "DEFAULT"i?
	  & first: FileSpec & (',' & rest: FileSpec)*
		=> @(new Clause.FileGroup(name, contains, fallback is not null, Syntax.Listed(first, rest)))
	| f: FileSpec => @(f)

FileGroupHolds = "FILESTREAM"i | "MEMORY_OPTIMIZED_DATA"i

FileSpec : @Clause
	= '(' & first: FileOption & (',' & rest: FileOption)* & ')' => @(new Clause.DatabaseFile(Syntax.Listed(first, rest)))

// ── What a database is created with ─────────────────────────────────────────
//
// The block's options, and the engine's answers about them: `TRUSTWORTHY` and `DB_CHAINING`
// take no `=` and `NESTED_TRIGGERS`, `TRANSFORM_NOISE_WORDS` and `LEDGER` must have one; a
// language is a number or a name; `PERSISTENT_LOG_BUFFER = ON` needs its directory. They are
// spelled as `ALTER DATABASE … SET` spells them, so its lines build them, gated by name;
// `LEDGER` and `CATALOG_COLLATION` are a creation's only. What `SET` may say and a creation
// may not — `AUTO_CLOSE`, `READ_ONLY`, `RESTRICTED_USER` — is refused.
CreateDatabaseOption : @Clause
	= ?=CreateDatabaseNames & o: DatabaseSetting => @(o)
	| name: "LEDGER"i & '=' & s: OnOff
		=> @(new Clause.Option(name, new Expression.ColumnReference(s), Clause.None))
	| name: "CATALOG_COLLATION"i & '=' & t: Identifier
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))

CreateDatabaseNames
	= "TRUSTWORTHY"i | "DB_CHAINING"i | "NESTED_TRIGGERS"i | "TRANSFORM_NOISE_WORDS"i
	| "DEFAULT_LANGUAGE"i | "DEFAULT_FULLTEXT_LANGUAGE"i | "TWO_DIGIT_YEAR_CUTOFF"i
	| "FILESTREAM"i | "PERSISTENT_LOG_BUFFER"i

// An attach takes all of those, and the broker's words and `RESTRICTED_USER` besides; its
// `FILESTREAM` says only where the directory is.
AttachOption : @Clause
	= name: ("RESTRICTED_USER"i | "ENABLE_BROKER"i | "NEW_BROKER"i | "ERROR_BROKER_CONVERSATIONS"i)
		=> @(new Clause.Option(name, null, Clause.None))
	| name: "FILESTREAM"i & '(' & ?=("DIRECTORY_NAME"i & '=' & (Quoted | "NULL"i) & ')') & o: OptionSetting & ')'
		=> @(new Clause.Option(name, null, new Clause[] { o }, null, true))
	| ?!"FILESTREAM"i & o: CreateDatabaseOption => @(o)

// A file: named by a name or a string, sized in whole numbers of the four units, grown by
// them or by a percentage, the maximum possibly unlimited — and in any order. `SIZE = 10.5
// MB` and `SIZE = 10 %` are refused, and so are a unit past `TB` and an option the block
// does not name (153).
FileOption : @Clause = ?=(FileOptionSyntax & OptionEnds) & o: OptionSetting => @(o)
FileOptionSyntax
	= ("NAME"i | "NEWNAME"i | "FILENAME"i) & '=' & (Quoted | Identifier)
	| "SIZE"i & '=' & Sql92.Lexical.Digits & SizeUnit?
	| "MAXSIZE"i & '=' & (Sql92.Lexical.Digits & SizeUnit? | "UNLIMITED"i)
	| "FILEGROWTH"i & '=' & Sql92.Lexical.Digits & (SizeUnit | '%')?
	| "OFFLINE"i
SizeUnit = "KB"i | "MB"i | "GB"i | "TB"i

FileGroupContains = "CONTAINS"i & FileGroupHolds

// ── ALTER DATABASE ──────────────────────────────────────────────────────────
//
// `SCOPED CONFIGURATION` stands in front because a database may be called `SCOPED`: the
// corpus has `ALTER DATABASE SCOPED COLLATE Estonian_CS_AS`, which is a database of that
// name and not a malformed configuration. Ordered choice reads the longer one first and
// gives it back when the words that must follow do not.
//
// `FOR SECONDARY` is a `SET`'s and nothing else's: the published block puts it inside the
// braces with `SET`, and the engine refuses `FOR SECONDARY CLEAR PROCEDURE_CACHE`.
AlterDatabaseStatement : @Statement
	= "ALTER"i & "DATABASE"i & "SCOPED"i & "CONFIGURATION"i & "FOR"i & "SECONDARY"i
	  & scoped: ScopedSet
		=> @(scoped with { Secondary = true })
	| "ALTER"i & "DATABASE"i & "SCOPED"i & "CONFIGURATION"i & scoped: ScopedConfiguration
		=> @(scoped)

	// The one action that keeps what it read, so the one written before the rest.
	| "ALTER"i & "DATABASE"i & name: DatabaseTarget
	  & "SET"i & first: DatabaseSetting & (',' & rest: DatabaseSetting)* & how: DatabaseTermination?
		=> @(new Statement.AlterDatabaseSet(name, Syntax.Listed(first, rest), how))

	// The one action with a body of its own: what is modified, and how the cutover goes.
	| "ALTER"i & "DATABASE"i & name: DatabaseTarget & "MODIFY"i & '(' & options: OptionList & ')'
	  & ("WITH"i & with: OptionList)? & DatabaseTermination?
		=> @(new Statement.AlterDatabaseModify(name, options, with))

	| "ALTER"i & "DATABASE"i & name: DatabaseTarget & action: AlterDatabaseAction
	  & how: DatabaseTermination?
		=> @(Statement.OfDatabase(
				 name, action.Action, null,
				 how is null ? action.Tail : action.Tail + " " + how))

DatabaseTarget : @string = "CURRENT"i => @("CURRENT") | t: Identifier => @(t)

ScopedConfiguration : @Statement.AlterDatabaseScopedConfiguration
	= s: ScopedSet => @(s)
	| "CLEAR"i & "PROCEDURE_CACHE"i & handle: PlanHandle?
		=> @(new Statement.AlterDatabaseScopedConfiguration("", "CLEAR PROCEDURE_CACHE", Clause.None, false, handle))

// A plan handle is written as binary and as nothing else: the engine refuses a variable,
// a string and a number in its place.
PlanHandle : @Expression = t: TSql.BinaryLiteral => @(new Expression.Literal(SqlLiteralKind.Hex, t))

// One setting to a statement. The published block says `<set_options>` without `[ ,...n ]`,
// and the engine agrees: `SET MAXDOP = 4, IDENTITY_CACHE = OFF` is refused.
ScopedSet : @Statement.AlterDatabaseScopedConfiguration
	= "SET"i & o: ScopedSetting
		=> @(new Statement.AlterDatabaseScopedConfiguration("", "SET", new Clause[] { o }))

// Which action was written, as the words the tree is keyed by. The statement builds the
// record; this says which record it is, because a rule cannot name a different type per
// alternative and the name is not known until the header above has been read.
// Which action, and what it was given — the action names the record and the rest is the
// words, as the catalogue wrote them.
AlterDatabaseAction : @Statement.AlterTable
	= "COLLATE"i & tail: QualifiedName => @(Statement.Altered("COLLATE", null, null, tail))
	| "MODIFY"i & m: DatabaseModify    => @(m)
	| "ADD"i    & a: DatabaseAdd       => @(a)
	| "REMOVE"i & r: DatabaseRemove    => @(r)

	// Two actions that are only a word. Written out, and this is a place where the words
	// are the syntax: `ALTER DATABASE d AUDIT SPECIFICATION s` is a different statement,
	// and a rule that read any word here would take it and call it this one.
	| "REBUILD"i & "LOG"i & tail: ("ON"i & FileSpecText)?
		=> @(Statement.Altered("REBUILD LOG", null, null, tail))
	| "PERFORM_CUTOVER"i   => @(Statement.Altered("PERFORM_CUTOVER", null))

DatabaseModify : @Statement.AlterTable
	= "NAME"i & tail: ('=' & Identifier)                  => @(Statement.Altered("MODIFY NAME", null, null, tail))
	| "FILEGROUP"i & tail: (Identifier & FileGroupAction) => @(Statement.Altered("MODIFY FILEGROUP", null, null, tail))
	| "FILE"i & tail: FileSpecText                        => @(Statement.Altered("MODIFY FILE", null, null, tail))
	| tail: ('(' & OptionList & ')' & ("WITH"i & OptionList)?)
		=> @(Statement.Altered("MODIFY", null, null, tail))

DatabaseAdd : @Statement.AlterTable
	= "FILEGROUP"i & tail: (Identifier & FileGroupContains?)
		=> @(Statement.Altered("ADD FILEGROUP", null, null, tail))
	| "LOG"i & "FILE"i & tail: (FileSpecText & (',' & FileSpecText)*)
		=> @(Statement.Altered("ADD LOG FILE", null, null, tail))
	| "FILE"i & tail: (FileSpecText & (',' & FileSpecText)* & ("TO"i & "FILEGROUP"i & Identifier)?)
		=> @(Statement.Altered("ADD FILE", null, null, tail))

DatabaseRemove : @Statement.AlterTable
	= "FILEGROUP"i & tail: Identifier => @(Statement.Altered("REMOVE FILEGROUP", null, null, tail))
	| "FILE"i & tail: Identifier      => @(Statement.Altered("REMOVE FILE", null, null, tail))

// A file specification read for its words rather than for its options.
FileSpecText = '(' & FileOptionSyntax & (',' & FileOptionSyntax)* & ')'

// `READ_ONLY`, `READWRITE`, `AUTOGROW_ALL_FILES`, `AUTOGROW_SINGLE_FILE` — words, and a
// catalogue if written out.
FileGroupAction = "DEFAULT"i | "NAME"i & '=' & Identifier | word

// ── What a database is set to ───────────────────────────────────────────────
//
// The catalogue of `ALTER DATABASE … SET`, from the published block and its two companions
// (`SET HADR`, database mirroring), each line put to the engine. It was one rule for all of
// them, a run of words and then whatever followed; the engine's list is closed, and it
// refuses a name it does not know with the same 102 it gives any other syntax error.
//
// Whether a setting takes `=` is part of its syntax, and the engine holds every one to its
// own: `AUTO_CLOSE = ON`, `RECOVERY = SIMPLE` and `DB_CHAINING = ON` are refused, and so are
// `CHANGE_TRACKING ON`, `CONTAINMENT PARTIAL` and `OPTIMIZED_LOCKING ON`. Only
// `MEMORY_OPTIMIZED_ELEVATE_TO_SNAPSHOT` is read both ways.
//
// A setting at the top of the list is built by its own line and not by the option builder,
// because nothing after it proves where it ended: the list may stop without a `;` and the
// next statement begin, and `SET ONLINE SELECT 1` is two statements the builder read as a
// setting called `ONLINE SELECT`. The lists in brackets are gated the way the index options
// are, the syntax in front of the builder that was already there.
//
// The engine knows `SUPPLEMENTAL_LOGGING`, `VARDECIMAL_STORAGE_FORMAT` and
// `RESULT_SET_CACHING`, which the block does not name, and `DESIRED_STATE` and
// `FLUSH_INTERVAL_SECONDS` inside `QUERY_STORE`. It does not know `DATA_RETENTION`, which
// is Azure SQL Edge's.
DatabaseSetting : @Clause
	= name: DatabaseWords
		=> @(new Clause.Option(name, null, Clause.None))
	| name: "AUTO_CREATE_STATISTICS"i & "ON"i & n: IncrementalNest?
		=> @(new Clause.Option(name, new Expression.ColumnReference("ON"), n ?? Clause.None, null, true))
	| name: DatabaseSwitch & s: OnOff
		=> @(new Clause.Option(name, new Expression.ColumnReference(s), Clause.None, null, true))
	| name: DatabaseEqualsSwitch & '=' & s: OnOff
		=> @(new Clause.Option(name, new Expression.ColumnReference(s), Clause.None))

	| name: "COMPATIBILITY_LEVEL"i & '=' & v: DatabaseInteger
		=> @(new Clause.Option(name, v, Clause.None))
	| name: "TWO_DIGIT_YEAR_CUTOFF"i & '=' & v: DatabaseInteger
		=> @(new Clause.Option(name, v, Clause.None))
	| name: ("DEFAULT_LANGUAGE"i | "DEFAULT_FULLTEXT_LANGUAGE"i) & '=' & v: LanguageValue
		=> @(new Clause.Option(name, v, Clause.None))
	| name: "TARGET_RECOVERY_TIME"i & '=' & v: DatabaseDecimal & u: RecoveryUnit
		=> @(new Clause.Option(name, Syntax.Measured(v, u), Clause.None))
	| name: "CONTAINMENT"i & '=' & t: ("NONE"i | "PARTIAL"i)
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))
	| name: "DELAYED_DURABILITY"i & '=' & t: ("DISABLED"i | "ALLOWED"i | "FORCED"i)
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))

	// `= AUTO` and `= CUSTOM`; `= INHERIT` and the index recommendations are Azure's.
	| name: "AUTOMATIC_TUNING"i & '=' & t: ("AUTO"i | "CUSTOM"i)
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))
	| name: "AUTOMATIC_TUNING"i & '(' & first: TuningOption & (',' & rest: TuningOption)* & ')'
		=> @(new Clause.Option(name, null, Syntax.Listed(first, rest), null, true))

	| name: "CHANGE_TRACKING"i & '=' & "OFF"i
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), Clause.None))
	| name: "CHANGE_TRACKING"i & '=' & "ON"i & n: TrackingNest?
		=> @(new Clause.Option(name, new Expression.ColumnReference("ON"), n ?? Clause.None))
	| name: "CHANGE_TRACKING"i & n: TrackingNest
		=> @(new Clause.Option(name, null, n, null, true))

	| name: "QUERY_STORE"i & '=' & "OFF"i & n: ForcedNest?
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), n ?? Clause.None))
	| name: "QUERY_STORE"i & '=' & "ON"i & n: StoreNest?
		=> @(new Clause.Option(name, new Expression.ColumnReference("ON"), n ?? Clause.None))
	| name: "QUERY_STORE"i & n: StoreNest
		=> @(new Clause.Option(name, null, n, null, true))

	| name: "FILESTREAM"i & '(' & first: FilestreamOption & (',' & rest: FilestreamOption)* & ')'
		=> @(new Clause.Option(name, null, Syntax.Listed(first, rest), null, true))

	| name: "REMOTE_DATA_ARCHIVE"i & '=' & "ON"i & n: ArchiveNest
		=> @(new Clause.Option(name, new Expression.ColumnReference("ON"), n))
	| name: "REMOTE_DATA_ARCHIVE"i & '=' & "OFF"i
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), Clause.None))
	| name: "REMOTE_DATA_ARCHIVE"i & n: ArchiveNest
		=> @(new Clause.Option(name, null, n, null, true))

	| name: "PERSISTENT_LOG_BUFFER"i & '=' & "ON"i & n: LogBufferNest
		=> @(new Clause.Option(name, new Expression.ColumnReference("ON"), n))
	| name: "SUSPEND_FOR_SNAPSHOT_BACKUP"i & '=' & "ON"i & n: SuspendNest?
		=> @(new Clause.Option(name, new Expression.ColumnReference("ON"), n ?? Clause.None))
	| name: ("PERSISTENT_LOG_BUFFER"i | "SUSPEND_FOR_SNAPSHOT_BACKUP"i) & '=' & "OFF"i
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), Clause.None))
	| name: "ACCELERATED_DATABASE_RECOVERY"i & '=' & s: OnOff & n: VersionStoreNest?
		=> @(new Clause.Option(name, new Expression.ColumnReference(s), n ?? Clause.None))

	// Availability groups and mirroring. Only `OFF` is a switch here: `HADR ON`, `PARTNER
	// SAFETY ON` and `WITNESS ON` are refused.
	| name: ("PARTNER"i & "SAFETY"i | "HADR"i | "PARTNER"i | "WITNESS"i) & "OFF"i
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), Clause.None, null, true))
	| name: ("HADR"i & "AVAILABILITY"i & "GROUP"i) & '=' & t: Identifier
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))
	| name: ("PARTNER"i | "WITNESS"i) & '=' & v: DatabaseText
		=> @(new Clause.Option(name, v, Clause.None))
	| name: ("PARTNER"i & "TIMEOUT"i) & v: DatabaseInteger
		=> @(new Clause.Option(name, v, Clause.None, null, true))

// The settings that are only words.
// Untyped, like the other lists of names here, so that a setting's name is the words as
// they were written whichever line read them.
DatabaseWords
	= "ONLINE"i | "OFFLINE"i | "EMERGENCY"i | "READ_ONLY"i | "READ_WRITE"i
	| "SINGLE_USER"i | "RESTRICTED_USER"i | "MULTI_USER"i
	| "ENABLE_BROKER"i | "DISABLE_BROKER"i | "NEW_BROKER"i | "ERROR_BROKER_CONVERSATIONS"i
	| "CURSOR_DEFAULT"i & ("LOCAL"i | "GLOBAL"i)
	| "RECOVERY"i & ("FULL"i | "BULK_LOGGED"i | "SIMPLE"i)
	| "PAGE_VERIFY"i & ("CHECKSUM"i | "TORN_PAGE_DETECTION"i | "NONE"i)
	| "PARAMETERIZATION"i & ("SIMPLE"i | "FORCED"i)
	| "ENCRYPTION"i & ("SUSPEND"i | "RESUME"i)
	| "QUERY_STORE"i & "CLEAR"i & "ALL"i?
	| "HADR"i & ("SUSPEND"i | "RESUME"i)
	| "PARTNER"i & ("FAILOVER"i | "FORCE_SERVICE_ALLOW_DATA_LOSS"i | "RESUME"i | "SUSPEND"i
				   | "SAFETY"i & "FULL"i)

// The settings that are switched without `=`.
DatabaseSwitch
	= "AUTO_CLOSE"i | "AUTO_CREATE_STATISTICS"i | "AUTO_SHRINK"i
	| "AUTO_UPDATE_STATISTICS"i | "AUTO_UPDATE_STATISTICS_ASYNC"i
	| "CURSOR_CLOSE_ON_COMMIT"i | "DATE_CORRELATION_OPTIMIZATION"i
	| "DB_CHAINING"i | "TRUSTWORTHY"i | "MIXED_PAGE_ALLOCATION"i | "HONOR_BROKER_PRIORITY"i
	| "ALLOW_SNAPSHOT_ISOLATION"i | "READ_COMMITTED_SNAPSHOT"i
	| "MEMORY_OPTIMIZED_ELEVATE_TO_SNAPSHOT"i
	| "ANSI_NULL_DEFAULT"i | "ANSI_NULLS"i | "ANSI_PADDING"i | "ANSI_WARNINGS"i
	| "ARITHABORT"i | "CONCAT_NULL_YIELDS_NULL"i | "NUMERIC_ROUNDABORT"i
	| "QUOTED_IDENTIFIER"i | "RECURSIVE_TRIGGERS"i | "TORN_PAGE_DETECTION"i
	| "TEMPORAL_HISTORY_RETENTION"i | "ENCRYPTION"i
	| "SUPPLEMENTAL_LOGGING"i | "VARDECIMAL_STORAGE_FORMAT"i | "RESULT_SET_CACHING"i

// And the ones switched with it.
DatabaseEqualsSwitch
	= "NESTED_TRIGGERS"i | "TRANSFORM_NOISE_WORDS"i | "MEMORY_OPTIMIZED_ELEVATE_TO_SNAPSHOT"i
	| "OPTIMIZED_LOCKING"i

// Whole numbers where the engine wants them — `TWO_DIGIT_YEAR_CUTOFF = 2049.5` and `PARTNER
// TIMEOUT 10.5` are refused — and a fraction where it takes one: `TARGET_RECOVERY_TIME =
// 42.5 SECONDS` reads. No exponent anywhere.
DatabaseInteger : @Expression = t: Sql92.Lexical.Digits => @(new Expression.Literal(SqlLiteralKind.Number, t))
DatabaseDecimal : @Expression = t: Sql92.Lexical.ExactNumericLiteral => @(new Expression.Literal(SqlLiteralKind.Number, t))

DatabaseText : @Expression
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(new Expression.Literal(SqlLiteralKind.National, t))
	| t: Sql92.Lexical.CharacterStringLiteral         => @(new Expression.Literal(SqlLiteralKind.Text, t))

// A language by its number or its name, and not by a string: `DEFAULT_LANGUAGE = 'English'`
// is refused where `= English` and `= [us_english]` are read.
LanguageValue : @Expression
	= v: DatabaseInteger => @(v)
	| t: Identifier      => @(new Expression.ColumnReference(t))

RecoveryUnit : @string = t: ("SECONDS"i | "MINUTES"i) => @(t)

// The lists in brackets. A list whose block allows one setting is written with one: the
// engine refuses `(MODE = COPY_ONLY, MODE = COPY_ONLY)` as syntax. Where the block allows a
// list, a setting written twice is left to a check (SqlWalker) as everywhere else.
IncrementalNest : @Clause[]
	= '(' & ?=("INCREMENTAL"i & OnOffValue & ')') & o: OptionSetting & ')' => @(new Clause[] { o })
LogBufferNest : @Clause[]
	= '(' & ?=("DIRECTORY_NAME"i & '=' & Quoted & ')') & o: OptionSetting & ')' => @(new Clause[] { o })
SuspendNest : @Clause[]
	= '(' & ?=("MODE"i & '=' & "COPY_ONLY"i & ')') & o: OptionSetting & ')' => @(new Clause[] { o })
VersionStoreNest : @Clause[]
	= '(' & ?=("PERSISTENT_VERSION_STORE_FILEGROUP"i & '=' & Identifier & ')') & o: OptionSetting & ')'
		=> @(new Clause[] { o })

TuningOption : @Clause
	= ?=("FORCE_LAST_GOOD_PLAN"i & '=' & ("DEFAULT"i | OnOff) & OptionEnds) & o: OptionSetting => @(o)

TrackingNest : @Clause[]
	= '(' & first: TrackingOption & (',' & rest: TrackingOption)* & ')' => @(Syntax.Listed(first, rest))
TrackingOption : @Clause = ?=(TrackingSyntax & OptionEnds) & o: OptionSetting => @(o)

// `CHANGE_RETENTION = 2 DAY` is not a unit the engine knows (155), where `STALE_CAPTURE_
// POLICY_THRESHOLD = 1 DAY` is.
TrackingSyntax
	= "AUTO_CLEANUP"i & OnOffValue
	| "CHANGE_RETENTION"i & '=' & Sql92.Lexical.Digits & ("DAYS"i | "HOURS"i | "MINUTES"i)

ForcedNest : @Clause[]
	= '(' & first: ForcedOption & (',' & rest: ForcedOption)* & ')' => @(Syntax.Listed(first, rest))
ForcedOption : @Clause = ?=("FORCED"i & OptionEnds) & o: OptionSetting => @(o)

StoreNest : @Clause[]
	= '(' & first: StoreOption & (',' & rest: StoreOption)* & ')' => @(Syntax.Listed(first, rest))
StoreOption : @Clause = ?=(StoreSyntax & OptionEnds) & o: OptionSetting => @(o)

StoreSyntax
	= ("OPERATION_MODE"i | "DESIRED_STATE"i) & '=' & ("READ_WRITE"i | "READ_ONLY"i)
	| "CLEANUP_POLICY"i & '=' & '(' & StaleQuery & (',' & StaleQuery)* & ')'
	| ("DATA_FLUSH_INTERVAL_SECONDS"i | "FLUSH_INTERVAL_SECONDS"i | "INTERVAL_LENGTH_MINUTES"i
	  | "MAX_STORAGE_SIZE_MB"i | "MAX_PLANS_PER_QUERY"i) & '=' & Sql92.Lexical.Digits
	| "SIZE_BASED_CLEANUP_MODE"i & '=' & ("AUTO"i | "OFF"i)
	| "QUERY_CAPTURE_MODE"i & '=' & ("ALL"i | "AUTO"i | "CUSTOM"i | "NONE"i)
	| "WAIT_STATS_CAPTURE_MODE"i & OnOffValue
	| "QUERY_CAPTURE_POLICY"i & '=' & '(' & CapturePolicy & (',' & CapturePolicy)* & ')'

StaleQuery = "STALE_QUERY_THRESHOLD_DAYS"i & '=' & Sql92.Lexical.Digits

CapturePolicy
	= "STALE_CAPTURE_POLICY_THRESHOLD"i & '=' & Sql92.Lexical.Digits
	  & ("DAYS"i | "DAY"i | "HOURS"i | "HOUR"i)
	| ("EXECUTION_COUNT"i | "TOTAL_COMPILE_CPU_TIME_MS"i | "TOTAL_EXECUTION_CPU_TIME_MS"i)
	  & '=' & Sql92.Lexical.Digits

FilestreamOption : @Clause = ?=(FilestreamSyntax & OptionEnds) & o: OptionSetting => @(o)
FilestreamSyntax
	= "NON_TRANSACTED_ACCESS"i & '=' & ("OFF"i | "READ_ONLY"i | "FULL"i)
	| "DIRECTORY_NAME"i & '=' & (Quoted | "NULL"i)

ArchiveNest : @Clause[]
	= '(' & first: ArchiveOption & (',' & rest: ArchiveOption)* & ')' => @(Syntax.Listed(first, rest))
ArchiveOption : @Clause = ?=(ArchiveSyntax & OptionEnds) & o: OptionSetting => @(o)
ArchiveSyntax
	= "SERVER"i & '=' & Quoted
	| "CREDENTIAL"i & '=' & Identifier
	| "FEDERATED_SERVICE_ACCOUNT"i & OnOffValue

// ── What a database is configured to ────────────────────────────────────────
//
// `ALTER DATABASE SCOPED CONFIGURATION`, from its block and the engine. A setting that is
// switched on or off may also be set to `PRIMARY` as syntax, whichever it is; that only a
// secondary may be set so is the engine's objection afterwards (12109), not a refusal. Two
// the block names are not known to this engine, 17.0.1125: `ALLOW_STALE_VECTOR_INDEX` and
// `ALLOW_BUILTIN_TVF_IN_ALL_COMPAT_LEVELS`. `DW_COMPATIBILITY_LEVEL` is Synapse's block and
// read here all the same.
ScopedSetting : @Clause
	= name: ScopedSwitch & '=' & v: ScopedSwitchValue
		=> @(new Clause.Option(name, v, Clause.None))
	| name: "MAXDOP"i & '=' & v: ScopedNumber
		=> @(new Clause.Option(name, v, Clause.None))
	| name: "MAXDOP"i & '=' & t: "PRIMARY"i
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))
	| name: ("ELEVATE_ONLINE"i | "ELEVATE_RESUMABLE"i) & '=' & "OFF"i
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), Clause.None))
	| name: ("ELEVATE_ONLINE"i | "ELEVATE_RESUMABLE"i) & '=' & t: ("WHEN_SUPPORTED"i | "FAIL_UNSUPPORTED"i)
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))
	| name: "LEDGER_DIGEST_STORAGE_ENDPOINT"i & '=' & v: DatabaseText
		=> @(new Clause.Option(name, v, Clause.None))
	| name: "LEDGER_DIGEST_STORAGE_ENDPOINT"i & '=' & "OFF"i
		=> @(new Clause.Option(name, new Expression.ColumnReference("OFF"), Clause.None))
	| name: ("PAUSED_RESUMABLE_INDEX_ABORT_DURATION_MINUTES"i | "FULLTEXT_INDEX_VERSION"i
			| "DW_COMPATIBILITY_LEVEL"i) & '=' & v: ScopedNumber
		=> @(new Clause.Option(name, v, Clause.None))
	| name: "DW_COMPATIBILITY_LEVEL"i & '=' & t: "AUTO"i
		=> @(new Clause.Option(name, new Expression.ColumnReference(t), Clause.None))

ScopedSwitch
	= "ACCELERATED_PLAN_FORCING"i | "ASYNC_STATS_UPDATE_WAIT_AT_LOW_PRIORITY"i
	| "BATCH_MODE_ADAPTIVE_JOINS"i | "BATCH_MODE_MEMORY_GRANT_FEEDBACK"i
	| "BATCH_MODE_ON_ROWSTORE"i | "CE_FEEDBACK"i | "DEFERRED_COMPILATION_TV"i | "DOP_FEEDBACK"i
	| "EXEC_QUERY_STATS_FOR_SCALAR_FUNCTIONS"i | "FORCE_SHOWPLAN_RUNTIME_PARAMETER_COLLECTION"i
	| "IDENTITY_CACHE"i | "INTERLEAVED_EXECUTION_TVF"i | "ISOLATE_SECURITY_POLICY_CARDINALITY"i
	| "GLOBAL_TEMPORARY_TABLE_AUTO_DROP"i | "LAST_QUERY_PLAN_STATS"i
	| "LEGACY_CARDINALITY_ESTIMATION"i | "LIGHTWEIGHT_QUERY_PROFILING"i
	| "MEMORY_GRANT_FEEDBACK_PERCENTILE_GRANT"i | "MEMORY_GRANT_FEEDBACK_PERSISTENCE"i
	| "OPTIMIZE_FOR_AD_HOC_WORKLOADS"i | "OPTIMIZED_PLAN_FORCING"i | "OPTIMIZED_SP_EXECUTESQL"i
	| "OPTIONAL_PARAMETER_OPTIMIZATION"i | "PARAMETER_SENSITIVE_PLAN_OPTIMIZATION"i
	| "PARAMETER_SNIFFING"i | "PREVIEW_FEATURES"i | "QUERY_OPTIMIZER_HOTFIXES"i
	| "READABLE_SECONDARY_TEMPORARY_STATS_AUTO_CREATE"i
	| "READABLE_SECONDARY_TEMPORARY_STATS_AUTO_UPDATE"i
	| "ROW_MODE_MEMORY_GRANT_FEEDBACK"i | "TSQL_SCALAR_UDF_INLINING"i
	| "VERBOSE_TRUNCATION_WARNINGS"i | "XTP_PROCEDURE_EXECUTION_STATISTICS"i
	| "XTP_QUERY_EXECUTION_STATISTICS"i

ScopedSwitchValue : @Expression
	= s: OnOff       => @(new Expression.ColumnReference(s))
	| t: "PRIMARY"i  => @(new Expression.ColumnReference(t))

// A number with a sign, where one may stand: `MAXDOP = -1` is read and then found out of
// range (12108), `MAXDOP = +4` is refused.
ScopedNumber : @Expression
	= '-' & v: DatabaseDecimal => @(Expression.Signed("-", v))
	| v: DatabaseDecimal       => @(v)

// Whole seconds, and the unit only as `SECONDS`: `AFTER @x`, `AFTER 5.5` and `AFTER 5
// MINUTES` are refused.
DatabaseTermination : @string
	= t: ("WITH"i & "ROLLBACK"i & "AFTER"i & Sql92.Lexical.Digits & "SECONDS"i?
		  | "WITH"i & "ROLLBACK"i & "IMMEDIATE"i
		  | "WITH"i & "NO_WAIT"i) => @(Syntax.Squared(t))

// ── Permissions ─────────────────────────────────────────────────────────────
//
// One shape, three statements, and the interesting part is that a permission's *name* is
// made of words T-SQL reserves — `ALTER ANY DATABASE`, `CREATE TABLE`, `VIEW DEFINITION`,
// `BACKUP LOG`. An identifier cannot be any of them, so the words are named, the same way
// the option names are and for the same reason: they are a catalogue rather than a
// language, and a permission added to SQL Server does not change this grammar.
PermissionStatement : @Statement
	= "GRANT"i & what: Permissions & on: PermissionOn? & "TO"i & who: Grantees
	  & option: ("WITH"i & "GRANT"i & "OPTION"i)? & who2: PermissionAs?
		=> @(new Statement.Grant(what, who, on, option is not null, who2))
	| "DENY"i & what: Permissions & on: PermissionOn? & "TO"i & who: Grantees
	  & cascade: "CASCADE"i? & who2: PermissionAs?
		=> @(new Statement.Deny(what, who, on, cascade is not null, who2))
	| "REVOKE"i & optionFor: ("GRANT"i & "OPTION"i & "FOR"i)? & what: Permissions & on: PermissionOn?
	  & way: ToOrFrom & who: Grantees & cascade: "CASCADE"i? & who2: PermissionAs?
		=> @(new Statement.Revoke(what, who, on, optionFor is not null, Syntax.Squared(way) == "FROM", cascade is not null, who2))

ToOrFrom      : @string = t: ("TO"i | "FROM"i) => @(t)
PermissionAs  : @string = "AS"i & t: PrincipalName => @(t)
// The columns may follow the securable as well as the permission — `ON t (c1)`, and after
// any class, `ON SCHEMA::s (c1)` — which the engine reads and, where both are written or the
// class has no columns, objects to afterwards (1019). They stay in the securable's words.
PermissionOn  : @string = "ON"i & t: (SecurableClass? & QualifiedName & ('(' & ColumnList & ')')?) => @(Syntax.Spaced(t))

// `OBJECT::t`, `SCHEMA::s`, `SERVER ROLE::r`, `XML SCHEMA COLLECTION::c` — a run of words
// and `::`. Where there is no `::` the whole clause is given back, which is what makes it
// safe to try in front of an ordinary name.
SecurableClass = PermissionWord+ & "::"

// `ALL` and `ALL PRIVILEGES` are permissions like the others: first in a list, later in one,
// with columns after them. An alternative of their own read them alone and, being first,
// left `GRANT ALL, SELECT …` with nowhere to go.
Permissions : @string[]
	= first: Permission & (',' & rest: Permission)* => @(Syntax.Named(first, rest))

Permission : @string
	= t: (PermissionName & ('(' & ColumnList & ')')?) => @(Syntax.Spaced(t))

// A permission is one of the engine's own — the 166 names `sys.fn_builtin_permissions`
// gives on SQL Server 2025 — or `EXEC`, `EXECUTE`'s other spelling, or `ALL [PRIVILEGES]`.
// The engine refuses any other name as syntax: `GRANT FOO`, `GRANT SELECT INSERT`, three
// permissions without their commas. This rule read any run of words once, on the ground that
// a permission SQL Server adds is a word the grammar has never heard of; what that cost showed
// when `NULL` became a principal and thirty-eight statements the engine refuses stopped
// failing on the `NULL` instead. A name an older release does not know is read at every
// level here, which is the version axis's to gate when there is one.
//
// Longest first, so that no name is taken for one it begins with: `ALTER ANY DATABASE`
// before `ALTER`, `CONNECT SQL` before `CONNECT`, `EXECUTE` before `EXEC`.
PermissionName
	= "ALL"i & "PRIVILEGES"i?
	| "VIEW"i & "SERVER"i & "STATE"i
	| "VIEW"i & "SERVER"i & "SECURITY"i & "STATE"i
	| "VIEW"i & "SERVER"i & "SECURITY"i & "AUDIT"i
	| "VIEW"i & "SERVER"i & "PERFORMANCE"i & "STATE"i
	| "VIEW"i & "SECURITY"i & "DEFINITION"i
	| "VIEW"i & "PERFORMANCE"i & "DEFINITION"i
	| "VIEW"i & "LEDGER"i & "CONTENT"i
	| "VIEW"i & "DEFINITION"i
	| "VIEW"i & "DATABASE"i & "STATE"i
	| "VIEW"i & "DATABASE"i & "SECURITY"i & "STATE"i
	| "VIEW"i & "DATABASE"i & "SECURITY"i & "AUDIT"i
	| "VIEW"i & "DATABASE"i & "PERFORMANCE"i & "STATE"i
	| "VIEW"i & "CRYPTOGRAPHICALLY"i & "SECURED"i & "DEFINITION"i
	| "VIEW"i & "CHANGE"i & "TRACKING"i
	| "VIEW"i & "ANY"i & "SENSITIVITY"i & "CLASSIFICATION"i
	| "VIEW"i & "ANY"i & "SECURITY"i & "DEFINITION"i
	| "VIEW"i & "ANY"i & "PERFORMANCE"i & "DEFINITION"i
	| "VIEW"i & "ANY"i & "ERROR"i & "LOG"i
	| "VIEW"i & "ANY"i & "DEFINITION"i
	| "VIEW"i & "ANY"i & "DATABASE"i
	| "VIEW"i & "ANY"i & "CRYPTOGRAPHICALLY"i & "SECURED"i & "DEFINITION"i
	| "VIEW"i & "ANY"i & "COLUMN"i & "MASTER"i & "KEY"i & "DEFINITION"i
	| "VIEW"i & "ANY"i & "COLUMN"i & "ENCRYPTION"i & "KEY"i & "DEFINITION"i
	| "UPDATE"i
	| "UNSAFE"i & "ASSEMBLY"i
	| "UNMASK"i
	| "TAKE"i & "OWNERSHIP"i
	| "SUBSCRIBE"i & "QUERY"i & "NOTIFICATIONS"i
	| "SHUTDOWN"i
	| "SHOWPLAN"i
	| "SEND"i
	| "SELECT"i & "ALL"i & "USER"i & "SECURABLES"i
	| "SELECT"i
	| "REFERENCES"i
	| "RECEIVE"i
	| "KILL"i & "DATABASE"i & "CONNECTION"i
	| "INSERT"i
	| "IMPERSONATE"i & "ANY"i & "LOGIN"i
	| "IMPERSONATE"i
	| "EXTERNAL"i & "ACCESS"i & "ASSEMBLY"i
	| "EXECUTE"i & "EXTERNAL"i & "SCRIPT"i
	| "EXECUTE"i & "ANY"i & "EXTERNAL"i & "SCRIPT"i
	| "EXECUTE"i & "ANY"i & "EXTERNAL"i & "ENDPOINT"i
	| "EXECUTE"i
	| "EXEC"i
	| "ENABLE"i & "LEDGER"i
	| "DROP"i & "ANY"i & "EVENT"i & "SESSION"i
	| "DROP"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i
	| "DELETE"i
	| "CREATE"i & "XML"i & "SCHEMA"i & "COLLECTION"i
	| "CREATE"i & "VIEW"i
	| "CREATE"i & "USER"i
	| "CREATE"i & "TYPE"i
	| "CREATE"i & "TRACE"i & "EVENT"i & "NOTIFICATION"i
	| "CREATE"i & "TABLE"i
	| "CREATE"i & "SYNONYM"i
	| "CREATE"i & "SYMMETRIC"i & "KEY"i
	| "CREATE"i & "SERVICE"i
	| "CREATE"i & "SERVER"i & "ROLE"i
	| "CREATE"i & "SEQUENCE"i
	| "CREATE"i & "SCHEMA"i
	| "CREATE"i & "RULE"i
	| "CREATE"i & "ROUTE"i
	| "CREATE"i & "ROLE"i
	| "CREATE"i & "REMOTE"i & "SERVICE"i & "BINDING"i
	| "CREATE"i & "QUEUE"i
	| "CREATE"i & "PROCEDURE"i
	| "CREATE"i & "MESSAGE"i & "TYPE"i
	| "CREATE"i & "LOGIN"i
	| "CREATE"i & "FUNCTION"i
	| "CREATE"i & "FULLTEXT"i & "CATALOG"i
	| "CREATE"i & "EXTERNAL"i & "MODEL"i
	| "CREATE"i & "EXTERNAL"i & "LIBRARY"i
	| "CREATE"i & "EXTERNAL"i & "LANGUAGE"i
	| "CREATE"i & "ENDPOINT"i
	| "CREATE"i & "DEFAULT"i
	| "CREATE"i & "DDL"i & "EVENT"i & "NOTIFICATION"i
	| "CREATE"i & "DATABASE"i & "DDL"i & "EVENT"i & "NOTIFICATION"i
	| "CREATE"i & "DATABASE"i
	| "CREATE"i & "CONTRACT"i
	| "CREATE"i & "CERTIFICATE"i
	| "CREATE"i & "AVAILABILITY"i & "GROUP"i
	| "CREATE"i & "ASYMMETRIC"i & "KEY"i
	| "CREATE"i & "ASSEMBLY"i
	| "CREATE"i & "ANY"i & "EVENT"i & "SESSION"i
	| "CREATE"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i
	| "CREATE"i & "ANY"i & "DATABASE"i
	| "CREATE"i & "AGGREGATE"i
	| "CONTROL"i & "SERVER"i
	| "CONTROL"i
	| "CONNECT"i & "SQL"i
	| "CONNECT"i & "REPLICATION"i
	| "CONNECT"i & "ANY"i & "DATABASE"i
	| "CONNECT"i
	| "CHECKPOINT"i
	| "BACKUP"i & "LOG"i
	| "BACKUP"i & "DATABASE"i
	| "AUTHENTICATE"i & "SERVER"i
	| "AUTHENTICATE"i
	| "ALTER"i & "TRACE"i
	| "ALTER"i & "SETTINGS"i
	| "ALTER"i & "SERVER"i & "STATE"i
	| "ALTER"i & "RESOURCES"i
	| "ALTER"i & "LEDGER"i & "CONFIGURATION"i
	| "ALTER"i & "LEDGER"i
	| "ALTER"i & "ANY"i & "USER"i
	| "ALTER"i & "ANY"i & "SYMMETRIC"i & "KEY"i
	| "ALTER"i & "ANY"i & "SERVICE"i
	| "ALTER"i & "ANY"i & "SERVER"i & "ROLE"i
	| "ALTER"i & "ANY"i & "SERVER"i & "AUDIT"i
	| "ALTER"i & "ANY"i & "SENSITIVITY"i & "CLASSIFICATION"i
	| "ALTER"i & "ANY"i & "SECURITY"i & "POLICY"i
	| "ALTER"i & "ANY"i & "SCHEMA"i
	| "ALTER"i & "ANY"i & "ROUTE"i
	| "ALTER"i & "ANY"i & "ROLE"i
	| "ALTER"i & "ANY"i & "REMOTE"i & "SERVICE"i & "BINDING"i
	| "ALTER"i & "ANY"i & "MESSAGE"i & "TYPE"i
	| "ALTER"i & "ANY"i & "MASK"i
	| "ALTER"i & "ANY"i & "LOGIN"i
	| "ALTER"i & "ANY"i & "LINKED"i & "SERVER"i
	| "ALTER"i & "ANY"i & "INFORMATION"i & "PROTECTION"i
	| "ALTER"i & "ANY"i & "FULLTEXT"i & "CATALOG"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "STREAM"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "MODEL"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "MIRROR"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "LIBRARY"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "LANGUAGE"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "JOB"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "FILE"i & "FORMAT"i
	| "ALTER"i & "ANY"i & "EXTERNAL"i & "DATA"i & "SOURCE"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "OPTION"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "ENABLE"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "DROP"i & "TARGET"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "DROP"i & "EVENT"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "DISABLE"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "ADD"i & "TARGET"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i & "ADD"i & "EVENT"i
	| "ALTER"i & "ANY"i & "EVENT"i & "SESSION"i
	| "ALTER"i & "ANY"i & "EVENT"i & "NOTIFICATION"i
	| "ALTER"i & "ANY"i & "ENDPOINT"i
	| "ALTER"i & "ANY"i & "DATASPACE"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "SCOPED"i & "CONFIGURATION"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "OPTION"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "ENABLE"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "DROP"i & "TARGET"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "DROP"i & "EVENT"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "DISABLE"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "ADD"i & "TARGET"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i & "ADD"i & "EVENT"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "SESSION"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "EVENT"i & "NOTIFICATION"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "DDL"i & "TRIGGER"i
	| "ALTER"i & "ANY"i & "DATABASE"i & "AUDIT"i
	| "ALTER"i & "ANY"i & "DATABASE"i
	| "ALTER"i & "ANY"i & "CREDENTIAL"i
	| "ALTER"i & "ANY"i & "CONTRACT"i
	| "ALTER"i & "ANY"i & "CONNECTION"i
	| "ALTER"i & "ANY"i & "COLUMN"i & "MASTER"i & "KEY"i
	| "ALTER"i & "ANY"i & "COLUMN"i & "ENCRYPTION"i & "KEY"i
	| "ALTER"i & "ANY"i & "CERTIFICATE"i
	| "ALTER"i & "ANY"i & "AVAILABILITY"i & "GROUP"i
	| "ALTER"i & "ANY"i & "ASYMMETRIC"i & "KEY"i
	| "ALTER"i & "ANY"i & "ASSEMBLY"i
	| "ALTER"i & "ANY"i & "APPLICATION"i & "ROLE"i
	| "ALTER"i
	| "ADMINISTER"i & "DATABASE"i & "BULK"i & "OPERATIONS"i
	| "ADMINISTER"i & "BULK"i & "OPERATIONS"i

// A word of a securable's class, `OBJECT::`, `SERVER ROLE::`: any word the clause after the
// permission does not begin with.
PermissionWord = ?!PermissionEnd & word

// An event an event notification is for, `OBJECT_CREATED`, `DDL_TABLE_EVENTS`, and an audit
// specification's action or group, `SUCCESSFUL_DATABASE_AUTHENTICATION_GROUP`, `SELECT`: runs
// of words, which read the permission rule until that became the engine's list of permissions
// and these two lists of their own stopped at their first name. They are catalogues too, and
// are left open until they are asked about.
ActionWords = PermissionWord+

PermissionEnd = "ON"i | "TO"i | "FROM"i | "WITH"i | "CASCADE"i

PrincipalName : @string = "PUBLIC"i => @("PUBLIC") | t: QualifiedName => @(t)

// Whom a permission is given to, denied or taken from: a principal, or `NULL`, which the
// engine reads anywhere in the list and refuses after `AS`.
Grantees : @string[]
	= first: Grantee & (',' & rest: Grantee)* => @(Syntax.Named(first, rest))

Grantee : @string = "NULL"i => @("NULL") | t: PrincipalName => @(t)
