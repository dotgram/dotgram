@using System;
@using DotGram.Parsers;
@using DotGram.Parsers.Sql;

using Sql92;

// A dialect, and this file is the whole of what makes it one. The rules of
// ISO/IEC 9075:1992 come from `SqlStandard92.gram`, inherited by the class this
// grammar is attached to; what is written here is only where T-SQL differs, and
// §5.1's rebinding is what makes the difference reach every rule that leads to it.
//
// Eleven rules replace eleven of the standard's. Nothing else is restated and nothing
// is copied: a query expression, a join, a predicate and the whole value tower are
// the ones already read against the standard, reading a dialect's identifiers and
// a dialect's primaries because the substitution rewrote every call inside them.

// ── What the wrapper does not carry across ──────────────────────────────────
//
// A grammar this one inherits is wrapped in a namespace of its own, and §4.5 is
// exactly that a namespace keeps its own trivia. So the standard's whitespace and
// its word boundary belong to the standard's rules, and the rules written here
// need their own — the same two, said again, pointing at the same lexemes.
//
// Not saying them is not an error and that is the trap: rules without a boundary
// read their keywords as punctuation, and a grammar that reads `USERS` as `USER`
// followed by `S` is wrong in a way nothing in it looks wrong.
wordboundary = Sql92.Lexical.IdentifierPart
trivia       = { (Std.Spacing | Std.LineComment("--") | Std.BlockComment("/*", "*/"))* }

// ── The lexemes T-SQL has and the standard does not ─────────────────────────
//
// A namespace with no trivia, so a token is its characters — the same shape
// `Sql92.Lexical` has, and a separate one because a grammar declares its own.
namespace Tsql
{
	trivia = none

	// A delimited identifier written the way T-SQL writes it, with `]]` for a
	// bracket inside — the same escape the standard's `""` is.
	BracketedIdentifier = '[' & ("]]" | [^ ']'])* & ']'

	// A local variable, a parameter, and the two `@@` spellings of a built-in.
	// One rule: what tells them apart is the catalogue and not the syntax.
	Variable = '@' & '@'? & Sql92.Lexical.IdentifierStart & Sql92.Lexical.IdentifierPart*

	// Money, written with the sign the culture uses, and a binary string written the
	// way T-SQL writes one. Neither is a lexeme of the standard.
	MoneyLiteral  = ['$' | '£' | '¥' | '€'] & ['+' | '-']? & Sql92.Lexical.Digits & ('.' & Sql92.Lexical.Digits?)?
	BinaryLiteral = '0' & 'x'i & ['0'..'9' | 'a'..'f' | 'A'..'F']*

	// A temporary table, local or global. The name is otherwise ordinary.
	TemporaryName = '#' & '#'? & Sql92.Lexical.IdentifierStart & Sql92.Lexical.IdentifierPart*
}

// ── What T-SQL reserves ─────────────────────────────────────────────────────
//
// A different list and not a longer one. The standard reserves `NATURAL`, `MATCH`
// and `CAST`, which T-SQL does not; T-SQL reserves `TOP`, `OPTION` and `OVER`,
// which the standard has never heard of. So it replaces rather than adds, and the
// standard's own list stands where the standard's rules still read.
//
// All hundred and sixty-nine of them, where `Sql92.Reserved` is a curated part of
// §5.2 — "the part this layer can be confused by". Curating it here was tried and
// is what let `SELECT TOP` read as a column called `TOP` and `FROM t OPTION (x)`
// read as a correlation named `OPTION` with a column list: both are refusals in
// any real T-SQL, and neither looked wrong. The list is Microsoft's own, taken
// from the token table its parser generator is fed (`TSqlTokenTypes.g`), where a
// word being a token at all is exactly what makes it unavailable as a name.
TsqlReserved = ("ADD"i | "ALL"i | "ALTER"i | "AND"i | "ANY"i | "AS"i | "ASC"i | "AUTHORIZATION"i
	| "BACKUP"i | "BEGIN"i | "BETWEEN"i | "BREAK"i | "BROWSE"i | "BULK"i | "BY"i
	| "CASCADE"i | "CASE"i | "CHECK"i | "CHECKPOINT"i | "CLOSE"i | "CLUSTERED"i
	| "COALESCE"i | "COLLATE"i | "COLUMN"i | "COMMIT"i | "COMPUTE"i | "CONSTRAINT"i
	| "CONTAINS"i | "CONTAINSTABLE"i | "CONTINUE"i | "CONVERT"i | "CREATE"i | "CROSS"i
	| "CURRENT"i | "CURRENT_DATE"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i
	| "CURRENT_USER"i | "CURSOR"i | "DATABASE"i | "DBCC"i | "DEALLOCATE"i | "DECLARE"i
	| "DEFAULT"i | "DELETE"i | "DENY"i | "DESC"i | "DISTINCT"i | "DISTRIBUTED"i
	| "DOUBLE"i | "DROP"i | "ELSE"i | "END"i | "ERRLVL"i | "ESCAPE"i | "EXCEPT"i
	| "EXEC"i | "EXECUTE"i | "EXISTS"i | "EXIT"i | "FETCH"i | "FILE"i | "FILLFACTOR"i
	| "FOR"i | "FOREIGN"i | "FREETEXT"i | "FREETEXTTABLE"i | "FROM"i | "FULL"i
	| "FUNCTION"i | "GOTO"i | "GRANT"i | "GROUP"i | "HAVING"i | "HOLDLOCK"i
	| "IDENTITY"i | "IDENTITYCOL"i | "IDENTITY_INSERT"i | "IF"i | "IN"i | "INDEX"i
	| "INNER"i | "INSERT"i | "INTERSECT"i | "INTO"i | "IS"i | "JOIN"i | "KEY"i | "KILL"i
	| "LEFT"i | "LIKE"i | "LINENO"i | "NATIONAL"i | "NOCHECK"i | "NONCLUSTERED"i
	| "NOT"i | "NULL"i | "NULLIF"i | "OF"i | "OFF"i | "OFFSETS"i | "ON"i | "OPEN"i
	| "OPENDATASOURCE"i | "OPENQUERY"i | "OPENROWSET"i | "OPENXML"i | "OPTION"i | "OR"i
	| "ORDER"i | "OUTER"i | "OVER"i | "PERCENT"i | "PLAN"i | "PRIMARY"i | "PRINT"i
	| "PROC"i | "PROCEDURE"i | "PUBLIC"i | "RAISERROR"i | "READ"i | "READTEXT"i
	| "RECONFIGURE"i | "REFERENCES"i | "REPLICATION"i | "RESTORE"i | "RESTRICT"i
	| "RETURN"i | "REVOKE"i | "RIGHT"i | "ROLLBACK"i | "ROWCOUNT"i | "ROWGUIDCOL"i
	| "RULE"i | "SAVE"i | "SCHEMA"i | "SELECT"i | "SESSION_USER"i | "SET"i | "SETUSER"i
	| "SHUTDOWN"i | "SOME"i | "STATISTICS"i | "SYSTEM_USER"i | "TABLE"i | "TEXTSIZE"i
	| "THEN"i | "TO"i | "TOP"i | "TRAN"i | "TRANSACTION"i | "TRIGGER"i | "TRUNCATE"i
	| "TSEQUAL"i | "UNION"i | "UNIQUE"i | "UPDATE"i | "UPDATETEXT"i | "USE"i | "USER"i
	| "VALUES"i | "VARYING"i | "VIEW"i | "WAITFOR"i | "WHEN"i | "WHERE"i | "WHILE"i
	| "WITH"i | "WRITETEXT"i)

// ── §6.20's simple when, widened ───────────────────────────────────────────
//
// `CASE x WHEN NULL THEN …` compares against the null nothing equals, which is useless
// and legal — the standard's `<when operand>` is a value expression and null is not one,
// and T-SQL admits it where the standard does not.
TsqlSimpleWhen : @Clause.When
	= "WHEN"i & test: Result & "THEN"i & result: Result => @(new Clause.When(test, result))

// ── §7.10's query expression, narrowed ─────────────────────────────────────
//
// **`ALL` belongs to `UNION` and to nothing else.** The standard writes it on all three
// set operators and the dialect inherited that; SQL Server answers `The 'ALL' version of
// the EXCEPT operator is not supported` and says the same of `INTERSECT`. `CORRESPONDING`
// goes with it: it is SQL-92 and T-SQL has never had it.
//
// The strengths are the standard's own — `INTERSECT` tighter than the two beside it, all
// three to the left (§4.3.1).
TsqlQueryExpression : @Query
	= left: TsqlQueryExpression & "UNION"i & all: "ALL"i? & right: TsqlQueryExpression  << 1
		=> @(Query.Combined("UNION", all, left, right))
	| left: TsqlQueryExpression & "EXCEPT"i & right: TsqlQueryExpression                << 1
		=> @(Query.Combined("EXCEPT", null, left, right))
	| left: TsqlQueryExpression & "INTERSECT"i & right: TsqlQueryExpression             << 2
		=> @(Query.Combined("INTERSECT", null, left, right))
	| q: QueryPrimary => @(q)

// ── §6.4's qualified name, widened ─────────────────────────────────────────
//
// A part may be left out: `myDb..t2` names a database and a table and no schema between
// them. Written as a dot that stands in front of another dot rather than as an optional
// name, so that `t.*` still ends where it did — a name that could end with a dot would
// eat the one the star needs.
TsqlQualifiedName
	= Identifier     & NamePart*
	| PartitionName  & NamePart*
	| SystemFunction & NamePart*
	| NamePart+

NamePart     = '.' & NamePartName
NamePartName = Identifier | PartitionName | ?='.'

// A name the `$` is part of rather than the money literal it opens elsewhere:
// `$PARTITION.f1(x)` names an index's partition function, and `$node_id`, `$edge_id`,
// `$from_id` and `$to_id` are the columns a graph table has and nobody declared.
PartitionName = '$' & Identifier

// The older spelling of a system table-valued function, which puts the `::` in front of
// the name instead of between two of them: `CROSS APPLY ::fn_get_sql (h)`.
SystemFunction = "::" & Identifier

// ── §5.2's identifier, widened ──────────────────────────────────────────────
//
// The standard's two spellings and the two more T-SQL admits. The lookahead
// stands in front of the regular one only, exactly as it does in the standard:
// a bracketed name may be a reserved word, and that is what brackets are for.
TsqlIdentifier
	= ?!TsqlReserved & Sql92.Lexical.RegularIdentifier
	| Sql92.Lexical.DelimitedIdentifier
	| Tsql.BracketedIdentifier
	| Tsql.TemporaryName

// ── §6.3's general value specification, widened ─────────────────────────────
//
// A variable stands where a parameter does, which is what the standard's rule is
// for. Its own alternatives are restated rather than called: a replacement that
// named the rule it replaces would be rewritten into itself.
TsqlValueSpecification : @Expression
	= t: (':' & Identifier & ("INDICATOR"i? & ':' & Identifier)?)
		=> @(new Expression.Literal(SqlLiteralKind.Parameter, t))
	| '?'
		=> @(new Expression.Literal(SqlLiteralKind.Parameter, "?"))
	| t: Tsql.Variable
		=> @(new Expression.Literal(SqlLiteralKind.Parameter, t))
	| t: ("USER"i | "CURRENT_USER"i | "SESSION_USER"i | "SYSTEM_USER"i | "VALUE"i)
		=> @(new Expression.Literal(SqlLiteralKind.Special, t))

// ── §6.11's value expression primary, widened ───────────────────────────────
//
// The standard names every function it has and leaves the rest to a routine
// invocation it does not define; T-SQL's are ordinary calls on a qualified name,
// which is one alternative and has to stand after the named ones — `COUNT(*)` is
// a set function and not a call to something called `COUNT`.
//
// A postfix stands outside the choice rather than on each arm of it: `AT TIME ZONE`
// applies to whatever was just read, which is one rule around the core and not
// twelve inside it.
TsqlValuePrimary : @Expression
	= p: TsqlPrimaryCore & members: Member* & zone: AtTimeZone?
		=> @(Syntax.Reached(p, members, zone))

AtTimeZone : @Expression = "AT"i & "TIME"i & "ZONE"i & v: TsqlPrimaryCore => @(v)

TsqlPrimaryCore : @Expression
	= '(' & v: ValueExpression & ')' => @(new Expression.Parenthesized(v))
	| c: CaseExpression                        => @(c)
	| c: TsqlCast                              => @(c)
	| f: ValueFunction                         => @(f)
	| f: TsqlValueFunction                     => @(f)
	| f: CountStar & tail: CallTail?                => @(Syntax.Called(f, tail))
	| f: SetFunctionSpecification & tail: CallTail? => @(Syntax.Called(f, tail))
	| q: ScalarSubquery                        => @(q)
	| n: NextValue                             => @(n)
	| f: FunctionCall                          => @(f)
	| e: OdbcEscape                            => @(e)
	| t: Tsql.MoneyLiteral                     => @(new Expression.Literal(SqlLiteralKind.Number, t))
	| t: Tsql.BinaryLiteral                    => @(new Expression.Literal(SqlLiteralKind.Hex, t))
	| v: UnsignedValueSpecification            => @(v)
	| "NULL"i                                  => @(Expression.NullValue)
	| n: ColumnReference                       => @(n)

// ODBC's escapes, which every driver has understood since before this language had a
// standard and which SQL Server still reads: a function called the portable way, and the
// four typed literals. `{ FN convert (@a, sql_int) }` is answered by the engine with a
// complaint about the ODBC type name, which is it having read the escape and then
// disagreeing about what was named inside it.
OdbcEscape : @Expression
	= '{' & fn: "FN"i & f: OdbcFunction & '}' => @(new Expression.OdbcEscape(fn, f))
	| '{' & kind: OdbcLiteralKind & t: Sql92.Lexical.CharacterStringLiteral & '}'
		=> @(new Expression.OdbcEscape(kind, new Expression.Literal(SqlLiteralKind.Text, t)))

OdbcLiteralKind : @string = t: ("TS"i | "D"i | "T"i | "GUID"i) => @(t)

// The name inside `{ fn … }` is ODBC's and not this language's, so a word T-SQL reserves
// may stand there: `{ fn convert (@a, sql_int) }` calls ODBC's two-argument `convert`,
// which is not the `CONVERT` of §6.10 and does not have to obey its shape.
OdbcFunction : @Expression
	= name: OdbcName & '(' & args: Arguments? & ')' => @(new Expression.RoutineInvocation(name, args ?? Expression.None))
	| v: ValueExpression => @(v)

OdbcName = word

// A property or a method reached through a name: `(c1).SomeProperty`, `t::a`,
// `dbo.[type 1]::[Property]`. Read and dropped, as a collate clause is — what it
// names is a type's member, which is a catalogue's business and not this tree's.
// Written as a postfix because a qualified name has already eaten every `.` it
// could, so this fires only where one is left over.
// Built with its left side null and closed by whoever read it, so that a chain of members
// is a chain of nodes rather than one node holding a list of names.
Member : @Expression.Member
	= by: ("::" | '.') & name: Identifier
	  & call: ('(' & args: Arguments? & ')')?
		=> @(new Expression.Member(null!, by, name, call is null ? null : args ?? Expression.None))

// §6.10's cast, widened, and the T-SQL spellings that are casts under other names.
// `CONVERT` is a different rule and not a wider one: the standard's takes a value and
// a character set, T-SQL's takes a type and a value, in that order.
TsqlCast : @Expression
	= name: "CAST"i & '(' & v: CastOperand & "AS"i & type: DataType & ')' => @(new Expression.RoutineInvocation(name, new Expression[] { v }, type))
	| name: "TRY_CAST"i & '(' & v: CastOperand & "AS"i & type: DataType & ')' => @(new Expression.RoutineInvocation(name, new Expression[] { v }, type))
	| name: ("TRY_CONVERT"i | "CONVERT"i) & '(' & type: DataType & ',' & v: ValueExpression
	  & (',' & style: ValueExpression)? & ')'
		=> @(new Expression.RoutineInvocation(name, style is null ? new Expression[] { v } : new Expression[] { v, style }, type))
	| name: ("TRY_PARSE"i | "PARSE"i) & '(' & v: ValueExpression & "AS"i & type: DataType
	  & ("USING"i & culture: ValueExpression)? & ')'
		=> @(new Expression.RoutineInvocation(
				 name,
				 culture is null ? new Expression[] { v } : new Expression[] { v, culture },
				 type))

// The T-SQL functions with a syntax of their own rather than an argument list, which
// is the same reason §6.16's are written out in the standard. What they have in common
// is a condition standing where a value would: `IIF` takes one, and a value expression
// cannot be one.
//
// And the JSON constructors, which have three things an argument list has not: a key
// written with `:` rather than a comma, a clause saying what a null does, and a type to
// return. All three are from the published syntax of `JSON_OBJECT`.
TsqlValueFunction : @Expression
	= name: "IIF"i & '(' & c: SearchCondition & ',' & a: ValueExpression & ',' & b: ValueExpression & ')'
		=> @(new Expression.RoutineInvocation(name, new Expression[] { c, a, b }))
	| name: "CHOOSE"i & '(' & at: ValueExpression & ',' & first: ValueExpression & (',' & rest: ValueExpression)* & ')'
		=> @(new Expression.RoutineInvocation(name, Syntax.Listed(at, Syntax.Listed(first, rest))))
	| name: JsonObjectName & '(' & body: JsonObjectBody? & ')' & tail: CallTail?
		=> @(Syntax.Called(new Expression.RoutineInvocation(name, body ?? Expression.None), tail))
	| name: JsonArrayName & '(' & body: JsonArrayBody? & ')' & tail: CallTail?
		=> @(Syntax.Called(new Expression.RoutineInvocation(name, body ?? Expression.None), tail))

// **The null clause needs something to be null.** The published syntax makes the key
// values and the clause independently optional — `JSON_OBJECT ( [ <json_key_value>
// [ , ...n ] ] [ json_null_clause ] [ RETURNING json ] )` — so `JSON_OBJECT(NULL ON NULL)`
// reads by the documentation and is answered by SQL Server 2025 with `Incorrect syntax near
// the keyword 'ON'`. The engine is right and the syntax block is wrong, which is the first
// thing found on that side rather than in a parser.
JsonObjectBody : @Expression[]
	= pairs: JsonKeyValues & nulls: JsonNullClause? & returning: JsonReturning?
		=> @(Syntax.Tailed(pairs, nulls, returning))
	| returning: JsonReturning => @(Syntax.Tailed(Expression.None, returning))

JsonArrayBody : @Expression[]
	= items: Arguments & order: JsonOrder? & nulls: JsonNullClause? & returning: JsonReturning?
		=> @(Syntax.Tailed(items, order, nulls, returning))
	| returning: JsonReturning => @(Syntax.Tailed(Expression.None, returning))

JsonObjectName = "JSON_OBJECT"i | "JSON_OBJECTAGG"i
JsonArrayName  = "JSON_ARRAY"i  | "JSON_ARRAYAGG"i

JsonKeyValues : @Expression[]
	= first: JsonKeyValue & (',' & rest: JsonKeyValue)* => @(Syntax.Listed(first, rest))

// `json_key_name : value_expression` — the one place in T-SQL where a colon joins two
// values rather than introducing a parameter.
JsonKeyValue : @Expression
	= key: ValueExpression & ':' & v: JsonValue => @(new Expression.JsonPair(key, v))

// A key's value may be the null a value expression is not — `'type':NULL` is the case
// the `ABSENT ON NULL` clause exists for.
JsonValue : @Expression = "NULL"i => @(Expression.NullValue) | v: ValueExpression => @(v)

// Which model an AI function is computed with, written after its arguments rather than
// as one of them: `AI_GENERATE_EMBEDDINGS ('text' USE MODEL MyModel)`.
UseModel : @string = t: ("USE"i & "MODEL"i & QualifiedName & UseModelParameters?) => @(t)

UseModelParameters = "PARAMETERS"i & ValueExpression

JsonNullClause : @string = t: ("NULL"i & "ON"i & "NULL"i | "ABSENT"i & "ON"i & "NULL"i) => @(t)
JsonReturning  : @string = t: ("RETURNING"i & DataType) => @(t)
JsonOrder      : @string = t: ("ORDER"i & "BY"i & ValueExpression & ("ASC"i | "DESC"i)?) => @(t)

// A sequence, read where a value stands. `FOR` here is not the `FOR` of `FOR JSON`;
// it is the middle of one three-word name.
NextValue : @Expression
	= word: ("NEXT"i & "VALUE"i & "FOR"i) & name: QualifiedName & tail: CallTail?
		=> @(Syntax.Called(
				 new Expression.RoutineInvocation(word, Expression.None, name), tail))

// A call to something this grammar has never heard of, which is most of them: the
// name is a catalogue's business and the arguments are values.
FunctionCall : @Expression
	= name: QualifiedName & '(' & quantifier: SetQuantifier? & args: Arguments? & model: UseModel?
	  & returning: JsonReturning? & ')' & tail: CallTail?
		=> @(Syntax.Called(
				 new Expression.RoutineInvocation(
					 name, Syntax.Tailed(args ?? Expression.None, model, returning), Syntax.Distinctly(quantifier)), tail))

// What may follow a call: which rows of a window it sees when they are null, what a
// set function inside a window is ordered by, and the window itself. All three read and
// dropped for the same reason `OVER` is.
//
// Written out as alternatives of a rule rather than as three optionals in a sequence,
// and that is the shape it has to have. **A choice inside a sequence or a repetition does
// not come back**: `Nulls? & WithinGroup? & Over?` read `RESPECT NULLS` and then refused
// `OVER ()`, and `(Nulls | WithinGroup | Over)*` did the same. Alternatives of a rule do
// come back — which is what makes the two spellings different languages here and not two
// ways of writing one. The same thing shapes `WindowFrame` below.
// Built with its call left null and filled in by whoever read it, the way a predicate's
// left operand is: the call is read once for the five shapes that may follow it.
CallTail : @Expression.WindowFunction
	= t: Nulls & w: Over       => @(new Expression.WindowFunction(null!, t, w))
	| t: WithinGroup & w: Over => @(new Expression.WindowFunction(null!, t, w))
	| t: Nulls                 => @(new Expression.WindowFunction(null!, t, null))
	| t: WithinGroup           => @(new Expression.WindowFunction(null!, t, null))
	| w: Over                  => @(new Expression.WindowFunction(null!, null, w))
Nulls : @string = t: ("RESPECT"i & "NULLS"i | "IGNORE"i & "NULLS"i) => @(t)

WithinGroup : @string
	= t: ("WITHIN"i & "GROUP"i & '(' & OrderByClause & ')') => @(t)
	| t: ("WITHIN"i & "GROUP"i & '(' & "GRAPH"i & "PATH"i & ')') => @(t)

// The window a call is computed over. Read and dropped, as `TOP` is: it says which
// rows the call sees and not what the call is, and the tree this grammar builds is
// the standard's. A window may also be named, and the name is declared by the query's
// own `WINDOW` clause.
Over : @Clause.Window
	= "OVER"i & '(' & w: WindowSpecification & ')' => @(w)
	| "OVER"i & only: Identifier => @(new Clause.Window(only, Expression.None, null, null))

// SQL:2003's <window specification>: the window it is built on, the partition, the order,
// the frame — each optional, in that order. What `OVER (…)` holds, and what a `WINDOW`
// clause declares under a name.
WindowSpecification : @Clause.Window
	= name: WindowName?
	  & ("PARTITION"i & "BY"i & first: ValueExpression & (',' & rest: ValueExpression)*)?
	  & by: OrderByClause?
	  & frame: WindowFrame?
		=> @(new Clause.Window(
				 name, first is null ? Expression.None : Syntax.Listed(first, rest),
				 Clause.Ordered(by, null), frame))

// The name of a window declared by the query's `WINDOW` clause, standing where the
// window itself would. Guarded the same way a correlation name is and for the same
// reason: `PARTITION`, `ROWS` and `RANGE` are not reserved words, so without the
// lookahead the name swallowed the clause that follows it and every frame stopped
// reading — which is exactly what happened when this was written without one.
WindowName   = ?!WindowClause & Identifier
WindowClause = "PARTITION"i | "ROWS"i | "RANGE"i

// A window frame: how far either side of the current row the window reaches.
WindowFrame : @string
	= t: (("ROWS"i | "RANGE"i) & "BETWEEN"i & FrameBound & "AND"i & FrameBound) => @(t)
	| t: (("ROWS"i | "RANGE"i) & FrameBound)                                    => @(t)

FrameBound
	= "UNBOUNDED"i & ("PRECEDING"i | "FOLLOWING"i)
	| "CURRENT"i & "ROW"i
	| ValueExpression & ("PRECEDING"i | "FOLLOWING"i)

// A `*` is not an argument. It stands inside three names and no others, and reading it as
// one made `trim(*)` a call — which SQL Server answers with `Incorrect syntax near '*'`,
// found by putting the corpus to the engine rather than to another parser.
// An argument may be either of the two words a value expression is not: `string_split
// (NULL, N',')` and `dbo.f (DEFAULT, 1)` are both read by the engine, and §7.1's
// `<row value constructor element>` is where the standard says the same thing.
Arguments : @Expression[]
	= first: Argument & (',' & rest: Argument)* => @(Syntax.Listed(first, rest))

Argument : @Expression
	= "NULL"i    => @(Expression.NullValue)
	| "DEFAULT"i => @(Expression.DefaultValue)
	| v: ValueExpression => @(v)

CountStar : @Expression
	= name: ("COUNT_BIG"i | "CHECKSUM"i) & '(' & '*' & ')'
		=> @(new Expression.RoutineInvocation(name, Expression.None, "*"))

// ── §6.1's data type, widened ───────────────────────────────────────────────
//
// Restated rather than called, as every replacement here is. What T-SQL adds is a
// third of the list — the money, the two blobs, the four datetimes, the spatial
// three — and one thing that is not a type at all: `MAX` where a length stands,
// which says the largest the type allows rather than a number of characters.
//
// A bare qualified name stands last, and it is not a catch-all by accident: a type in
// T-SQL may be one somebody declared, and no parser can tell without the catalogue.
// What keeps it from swallowing everything is that the only place a type is read is
// after `AS` inside a cast.
TsqlDataType
	= ("CHARACTER"i & "VARYING"i? | "CHAR"i & "VARYING"i? | "VARCHAR"i
	  | "NATIONAL"i & ("CHARACTER"i | "CHAR"i) & "VARYING"i? | "NCHAR"i & "VARYING"i? | "NVARCHAR"i
	  | "BINARY"i & "VARYING"i? | "VARBINARY"i | "VECTOR"i) & TsqlLength?
	| ("NUMERIC"i | "DECIMAL"i | "DEC"i)
	  & ('(' & Sql92.Lexical.Digits & (',' & Sql92.Lexical.Digits)? & ')')?
	| "FLOAT"i & ('(' & Sql92.Lexical.Digits & ')')?
	| ("DATETIME2"i | "DATETIMEOFFSET"i | "TIME"i | "TIMESTAMP"i)
	  & ('(' & Sql92.Lexical.Digits & ')')? & ("WITH"i & "TIME"i & "ZONE"i)?
	| "INTEGER"i | "INT"i | "SMALLINT"i | "TINYINT"i | "BIGINT"i | "BIT"i
	| "REAL"i | "DOUBLE"i & "PRECISION"i | "MONEY"i | "SMALLMONEY"i
	| "DATE"i | "DATETIME"i | "SMALLDATETIME"i
	| "TEXT"i | "NTEXT"i | "IMAGE"i | "JSON"i
	| "XML"i & ('(' & XmlContent? & QualifiedName & ')')?
	| "UNIQUEIDENTIFIER"i | "SQL_VARIANT"i | "ROWVERSION"i | "SYSNAME"i
	| "GEOGRAPHY"i | "GEOMETRY"i | "HIERARCHYID"i
	| "INTERVAL"i & IntervalQualifier
	| QualifiedName & TsqlLength?

TsqlLength = '(' & (Sql92.Lexical.Digits | "MAX"i) & ')'

XmlContent = "CONTENT"i | "DOCUMENT"i

// ── §8's predicate, widened ─────────────────────────────────────────────────
//
// Two things T-SQL has that the standard does not. `IS [NOT] DISTINCT FROM` compares
// two rows treating null as a value, and it stands after the standard's tail rather
// than inside it: `IS NOT NULL` and `IS NOT DISTINCT FROM` share three words, and the
// tail is the rule that reads the first of them.
//
// And a handful of functions that yield a truth rather than a value. A call cannot
// stand where a condition does in general — `WHERE f(x)` is not T-SQL either — so
// they are named, exactly as §6.16's functions are named on the value side.
TsqlPredicate : @Expression
	= "EXISTS"i & q: TableSubquery => @(new Expression.Exists(q))
	| "UNIQUE"i & q: TableSubquery => @(new Expression.Unique(q))
	| name: ("CONTAINS"i | "FREETEXT"i | "TSEQUAL"i | "REGEXP_LIKE"i | "UPDATE"i)
	  & '(' & args: Arguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))
	| m: GraphMatch => @(m)
	| row: RowValueConstructor & tail: PredicateTail => @(Expression.Predicated(row, tail))
	| left: RowValueConstructor & "IS"i & negated: "NOT"i? & "DISTINCT"i & "FROM"i
	  & other: DistinctTail
		=> @(new Expression.IsDistinctFrom(left, negated is not null, other))

DistinctTail : @Expression
	= q: Quantifier & sub: TableSubquery => @(new Expression.Prefixed(Syntax.Squared(q), new Expression.Subquery(sub)))
	| right: RowValueConstructor         => @(right)

// ── §7.9's query specification, widened ─────────────────────────────────────
//
// What may be left out and what may be added. T-SQL's `FROM` is optional — `SELECT 1`
// is a query — `TOP` stands between the quantifier and the select list, `INTO` names a
// table the rows are written to rather than returned from, and a `WINDOW` clause at the
// end declares the windows the select list named. The count and the windows are read
// and dropped, as the standard's collate clause is: they say how many rows come back
// and how a call sees them, not what the rows are.
TsqlQuerySpecification : @Query
	= "SELECT"i & quantifier: SetQuantifier? & top: Top? & columns: SelectList & into: Into?
	  & from: FromClause? & where: WhereClause? & group: GroupByClause? & having: HavingClause?
	  & windows: Window?
		=> @(new Query.Specification(
				 Syntax.Distinctly(quantifier), top, columns, into,
				 from ?? TableReference.None, where, group, having, windows))

// Written as alternatives of a rule rather than one sequence with a choice inside it,
// for the reason `CallTail` gives.
Top : @Clause.Top
	= "TOP"i & '(' & v: ValueExpression & ')' & suffix: TopSuffix?
		=> @(Clause.Topped(new Expression.Parenthesized(v), suffix))
	| "TOP"i & t: Sql92.Lexical.UnsignedNumericLiteral & suffix: TopSuffix?
		=> @(Clause.Topped(new Expression.Literal(SqlLiteralKind.Number, t), suffix))

// Read as the words they are and taken apart in C#: two questions and a rule, and asking
// them here would be three captures where one run of words says it.
TopSuffix : @string = t: ("PERCENT"i & TopWith? | TopWith) => @(t)
TopWith   = "WITH"i & "TIES"i | "WITH"i & "APPROXIMATE"i | "WITH"i & "APPROX"i

// §7.9 has nowhere to put this: the rows go into a table instead of coming back, and
// the filegroup says where that table's pages live.
Into : @Clause
	= "INTO"i & name: QualifiedName & ("ON"i & on: Identifier)?
		=> @(new Clause.Into(name, on))

// The windows a call may name instead of writing out: each a name and the window it
// stands for, in the shape `OVER (…)` has inside its brackets.
Window : @Clause[]
	= "WINDOW"i & first: WindowDef & (',' & rest: WindowDef)* => @(Syntax.Listed(first, rest))

WindowDef : @Clause
	= name: Identifier & "AS"i & '(' & w: WindowSpecification & ')' => @(new Clause.WindowDefinition(name, w))

// ── §7.9's select list, widened ─────────────────────────────────────────────
//
// Two things stand where a value does. A variable takes the value rather than the query
// returning it — `SELECT @a += 1` is an assignment written as a query — and an alias may
// be written in front with `=` rather than behind with `AS`. And an alias may be a
// string, which the standard does not allow and every dialect does.
TsqlSelectSublist : @Clause
	= qualifier: QualifiedName & '.' & '*'        => @(new Clause.QualifiedAsterisk(qualifier))
	| into: Tsql.Variable & by: AssignOp & v: ValueExpression
		=> @(new Clause.VariableAssignment(into, by, v))
	| label: TsqlAlias & '=' & v: ValueExpression  => @(new Clause.DerivedColumn(v, label))
	| v: ValueExpression & alias: TsqlAsClause?    => @(new Clause.DerivedColumn(v, alias))

AssignOp : @string = t: ('=' | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "||=") => @(t)

TsqlAlias    : @string = t: Identifier => @(t) | t: Sql92.Lexical.CharacterStringLiteral => @(t)
TsqlAsClause : @string = "AS"i & t: TsqlAlias => @(t) | t: TsqlAlias => @(t)

// ── §7.7's group by, widened ────────────────────────────────────────────────
//
// Written from the published `GROUP BY` syntax rather than from what the corpus
// happened to contain, which is what caught the nesting: a `ROLLUP` or a `CUBE` takes
// group-by expressions and not grouping sets, and only a `GROUPING SETS` list may hold
// another `ROLLUP` or `CUBE`. The two spellings are separate rules here because the
// specification makes them separate — `GROUP BY GROUPING SETS (GROUPING SETS (a))` is
// legal SQL-2006 and is refused by T-SQL, and refusing it is the point.
//
// And the older spelling beside the ISO one: `WITH CUBE` and `WITH ROLLUP` say after
// the list what `CUBE (…)` and `ROLLUP (…)` say in front of it.
TsqlGroupByClause : @Clause
	= "GROUP"i & "BY"i & "ALL"i & first: TsqlGrouping & (',' & rest: TsqlGrouping)*
		=> @(new Clause.GroupBy(true, Syntax.Listed(first, rest), null))
	| "GROUP"i & "BY"i & first: TsqlGrouping & (',' & rest: TsqlGrouping)* & with: GroupWith?
		=> @(new Clause.GroupBy(false, Syntax.Listed(first, rest), with))

GroupWith : @string = "WITH"i & t: ("CUBE"i | "ROLLUP"i) => @(t)
					| "WITH"i & '(' & t: Identifier & ')' => @(t)

TsqlGrouping : @Expression
	= "CUBE"i     & g: GroupList => @(new Expression.RoutineInvocation("CUBE",   g))
	| "ROLLUP"i   & g: GroupList => @(new Expression.RoutineInvocation("ROLLUP", g))
	| "GROUPING"i & "SETS"i & '(' & first: GroupingSet & (',' & rest: GroupingSet)* & ')'
		=> @(new Expression.RoutineInvocation("GROUPING SETS", Syntax.Listed(first, rest)))
	| e: GroupByExpression => @(e)

GroupList : @Expression[]
	= '(' & first: GroupByExpression & (',' & rest: GroupByExpression)* & ')'
		=> @(Syntax.Listed(first, rest))

// A column, or a list of them standing as one — and the empty list, which is the grand
// total and the one grouping that names nothing.
GroupByExpression : @Expression
	= '(' & ')' => @(new Expression.RowValueConstructor(Expression.None))
	| '(' & first: TsqlGroupingColumn & (',' & rest: TsqlGroupingColumn)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| c: TsqlGroupingColumn => @(c)

TsqlGroupingColumn : @Expression
	= c: ValueExpression & collation: Collate? & hint: ("WITH"i & '(' & Identifier & ')')?
		=> @(Syntax.Grouped(c, collation, hint))

// One entry of a `GROUPING SETS` list: a cube, a rollup, a list of those, or a plain
// group-by expression. A grouping set inside a grouping set is not here, deliberately.
GroupingSet : @Expression
	= "CUBE"i   & g: GroupList => @(new Expression.RoutineInvocation("CUBE",   g))
	| "ROLLUP"i & g: GroupList => @(new Expression.RoutineInvocation("ROLLUP", g))
	| '(' & first: GroupingSetItem & (',' & rest: GroupingSetItem)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| e: GroupByExpression => @(e)

GroupingSetItem : @Expression
	= "CUBE"i   & g: GroupList => @(new Expression.RoutineInvocation("CUBE",   g))
	| "ROLLUP"i & g: GroupList => @(new Expression.RoutineInvocation("ROLLUP", g))
	| e: GroupByExpression => @(e)

// ── §7.5's joined table, widened ────────────────────────────────────────────
//
// **T-SQL has neither `NATURAL JOIN` nor `USING`, and a qualified join must say `ON`.**
// The published `<joined_table>` is three forms and no more: a join with a condition, a
// cross join, and an apply. The dialect read all three of the standard's extra spellings
// until this was written from the syntax rather than from what the corpus contained —
// which is over-acceptance, the half of correctness a refusal count cannot see.
//
// `APPLY` is a join whose right side is read once per row of its left, which is a
// question about evaluation and not about shape — so the tree says `CROSS JOIN` and the
// word is not kept. A join hint says which algorithm to use and is dropped for the same
// reason `OPTION` is; the syntax puts it inside the join type, so a hint without a type
// is not a join.
TsqlTableReference : @TableReference
	= left: TsqlTableReference & "CROSS"i & "JOIN"i & right: TablePrimary
		=> @(new TableReference.Joined(SqlJoin.Cross, false, false, left, right))
	| left: TsqlTableReference & "CROSS"i & "APPLY"i & right: TablePrimary
		=> @(new TableReference.Joined(SqlJoin.CrossApply, false, false, left, right))
	| left: TsqlTableReference & "OUTER"i & "APPLY"i & right: TablePrimary
		=> @(new TableReference.Joined(SqlJoin.OuterApply, false, false, left, right))
	| left: TsqlTableReference & kind: TsqlJoinType? & hint: JoinHint? & "JOIN"i & right: TablePrimary
	  & "ON"i & on: SearchCondition
		=> @(TableReference.Joining(kind, null, left, right, on, null, hint))
	| t: TablePrimary => @(t)

TsqlJoinType : @string = t: JoinType => @(t)

JoinHint : @string
	= t: ("HASH"i | "LOOP"i | "MERGE"i | "REMOTE"i | "REDUCE"i | "REPLICATE"i | "REDISTRIBUTE"i) => @(Syntax.Squared(t))

// ── §7.4's table primary, widened ───────────────────────────────────────────
//
// The published order, which is not the order the examples suggested: a temporal clause
// stands before the correlation name, and a sample before the hints. Writing the hints
// first was accepted here until the syntax said otherwise, and whether ScriptDom accepts
// them the other way round is a question worth asking of it rather than of us.
TsqlTablePrimary : @TableReference
	= f: RowsetFunction & schema: RowsetSchema?
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
	  & pivot: PivotSuffix?
		=> @(Syntax.Pivoted(
				 new TableReference.FunctionCall(f, alias, columns, schema ?? Clause.None), pivot))
	| name: QualifiedName & version: SystemTime? & call: ('(' & args: Arguments? & ')')?
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
	  & sample: TableSample? & hints: TableHints? & pivot: PivotSuffix?
		=> @(Syntax.Sourced(name, version, call, args, alias, columns, sample, hints, pivot))
	| t: Tsql.Variable & s: VariableSource => @(s with { Table = t })
	| derived: TableSubquery & "AS"i? & alias: CorrelationName
	  & ('(' & columns: ColumnList & ')')? & pivot: PivotSuffix?
		=> @(Syntax.Pivoted(new TableReference.Derived(derived, alias, columns), pivot))
	| '(' & j: TableReference & ')' & TableSample? & TableHints?
		=> @(new TableReference.Parenthesized(j))
	| '{' & "OJ"i & j: TableReference & '}' => @(j)

// What a variable may be as a table: the table variable itself, or a table-valued method
// on a variable of a user-defined type — `FROM @v.f(1) AS t(c)`. Left-factored because
// both begin with the variable, which is what GRAM4016 asks for.
VariableSource : @TableReference.Named
	= '.' & Identifier & '(' & Arguments? & ')'
	  & ("AS"i? & alias: CorrelationName & ('(' & columns: ColumnList & ')')?)?
		=> @(new TableReference.Named("", null, alias, columns, null, Clause.None))
	| ("AS"i? & alias: CorrelationName)? & TableSample? & TableHints?
		=> @(new TableReference.Named("", null, alias, null, null, Clause.None))

// The published syntax makes a pivoted table a source of its own — `table_source PIVOT
// (…) [AS] alias` — which is left recursion, and §4.3 folds that only where the rule
// recurses on itself. So it is written as what follows a primary instead, which reads
// the same language wherever a pivot is applied to one source rather than to a join.
//
// The alias is required and not optional, which the syntax says and the examples did
// not: `PIVOT (…)` with nothing after it is not a table source.
// Built with the source it is applied to left null, the way a predicate tail is: the
// source is read once and the pivot is what may follow it.
PivotSuffix : @TableReference = p: Pivot => @(p) | u: Unpivot => @(u)

Pivot : @TableReference
	= "PIVOT"i & '(' & aggregate: ValueExpression & "FOR"i & column: QualifiedName
	  & "IN"i & '(' & names: PivotNames & ')' & ')' & "AS"i? & alias: CorrelationName
		=> @(new TableReference.Pivot(null!, aggregate, column, names, alias))

Unpivot : @TableReference
	= "UNPIVOT"i & '(' & value: QualifiedName & "FOR"i & column: QualifiedName
	  & "IN"i & '(' & names: PivotNames & ')' & ')' & "AS"i? & alias: CorrelationName
		=> @(new TableReference.Unpivot(null!, value, column, names, alias))

PivotNames : @string[]
	= first: PivotName & (',' & rest: PivotName)* => @(Syntax.Named(first, rest))

PivotName : @string = t: QualifiedName => @(t)

// Which version of a temporal table to read. `FOR` is reserved, so nothing here can be
// mistaken for the correlation name it stands in front of.
SystemTime : @Clause
	= "FOR"i & "SYSTEM_TIME"i & w: SystemTimeWhen => @(w)
	| "FOR"i & "PATH"i => @(new Clause.SystemTime("PATH", Expression.None))

SystemTimeWhen : @Clause
	= "AS"i & "OF"i & v: ValueExpression
		=> @(new Clause.SystemTime("AS OF", new Expression[] { v }))
	| "FROM"i & from: ValueExpression & "TO"i & to: ValueExpression
		=> @(new Clause.SystemTime("FROM", new Expression[] { from, to }))
	| "BETWEEN"i & from: ValueExpression & "AND"i & to: ValueExpression
		=> @(new Clause.SystemTime("BETWEEN", new Expression[] { from, to }))
	| "CONTAINED"i & "IN"i & '(' & from: ValueExpression & ',' & to: ValueExpression & ')'
		=> @(new Clause.SystemTime("CONTAINED IN", new Expression[] { from, to }))
	| "ALL"i => @(new Clause.SystemTime("ALL", Expression.None))

// A correlation name is an identifier, and not one of the words that begin a clause of
// its own after a source. None of them is reserved — a column may be called `WINDOW` —
// but a name is what stands *after* a source, and `FROM t PIVOT (…)` has no name in it.
// Without the lookahead the pivot became the correlation and the parse stopped one token
// later, saying nothing about why.
//
// `USING` joined them when `MERGE` was written, and it is the fourth word to do so. The
// shape is always the same: a word that begins a clause, an optional name in the same
// position, and the name winning. Anything added after a source belongs on this list.
CorrelationName = ?!SourceClause & Identifier
SourceClause    = "WINDOW"i | "PIVOT"i | "UNPIVOT"i | "TABLESAMPLE"i | "USING"i

// **Transcribed from `TSql170.g`'s own `tableHint` and `optimizerHints`, and that makes
// these two rules weaker evidence than the rest of this file.** A rule written from the
// other parser's grammar cannot disagree with the other parser: the comparison stops
// being a comparison and becomes a check that the transcription was faithful. Everywhere
// else here the source is the published syntax, so a difference is a finding — a bug on
// one side or the other — and that is the whole point of measuring against ScriptDom at
// all. These two are marked because they are the exception.
//
// What the shape says, and a list of hint names would not: `HOLDLOCK`, `INDEX`, `MERGE`,
// A hint's name is a word and nothing else: `NOLOCK`, `FORCESEEK`, `RECOMPILE`, `MAXDOP`
// are ordinary ones and `ORDER`, `GROUP`, `PLAN`, `TABLE` are words T-SQL reserves, and
// inside these brackets nothing tells them apart. So the rule says `word` (§4.6) and is
// about the shape of a hint list rather than about which hints exist — the ones written
// out are the ones that take an argument of their own.
//
// All of it is read and dropped: a hint says how the rows are to be fetched and never
// which rows they are, and the tree this grammar builds is the standard's.
TableHints : @Clause[]
	= "WITH"i & '(' & first: TableHint & (',' & rest: TableHint)* & ')'
		=> @(Syntax.Listed(first, rest))

TableHint : @Clause
	= t: ("HOLDLOCK"i)              => @(new Clause.Hint(t))
	| t: ("INDEX"i & IndexArgument) => @(new Clause.Hint(t))
	| t: (word & TableHintTail?)    => @(new Clause.Hint(t))

TableHintTail
	= '(' & IndexValue & TableHintRest & ')'
	| '=' & Sql92.Lexical.UnsignedNumericLiteral

TableHintRest = '(' & ColumnList & ')' | (',' & IndexValue)*

IndexArgument
	= '=' & IndexValue
	| '(' & IndexValue & (',' & IndexValue)* & ')'

IndexValue = Identifier | Sql92.Lexical.UnsignedNumericLiteral

QueryHints : @Clause[]
	= "OPTION"i & '(' & first: QueryHint & (',' & rest: QueryHint)* & ')'
		=> @(Syntax.Listed(first, rest))

// Kept as the words it was written as, which is what a hint is: see `Clause.Hint`.
QueryHint : @Clause
	= t: ("MERGE"i & MergeWhat)  => @(new Clause.Hint(t))
	| t: ("ORDER"i & "GROUP"i)   => @(new Clause.Hint(t))
	| t: ("USE"i & UseWhat)      => @(new Clause.Hint(t))
	| t: ("TABLE"i & Identifier & '(' & QualifiedName & (',' & TableHint)* & ')')
		=> @(new Clause.Hint(t))
	| t: (word & QueryHintTail?) => @(new Clause.Hint(t))

MergeWhat = "JOIN"i | "UNION"i
UseWhat   = "PLAN"i & HintString
		  | Identifier & '(' & HintString & (',' & HintString)* & ')'

QueryHintTail
	= "JOIN"i
	| "UNION"i
	| "ORDER"i
	| "GROUP"i
	| "PLAN"i
	| "FOR"i & OptimizeFor
	| '=' & ValueExpression
	| Sql92.Lexical.UnsignedNumericLiteral
	| Identifier

OptimizeFor
	= '(' & VariableValue & (',' & VariableValue)* & ')'
	| Identifier

HintString = Sql92.Lexical.NationalCharacterStringLiteral | Sql92.Lexical.CharacterStringLiteral

VariableValue = Tsql.Variable & VariableValueTail

VariableValueTail = '=' & HintValue | "UNKNOWN"i

HintValue = "NULL"i | ValueExpression

// §7.4's table sample: how much of a source to read, in rows or in per cent, and the
// seed that makes the choice repeatable. Read and dropped for the same reason a hint is.
TableSample : @Clause
	= "TABLESAMPLE"i & system: "SYSTEM"i?
	  & '(' & v: ValueExpression & unit: SampleUnit? & ')' & seed: TableRepeatable?
		=> @(new Clause.TableSample(system is not null, v, unit, seed))

SampleUnit      : @string     = t: ("PERCENT"i | "ROWS"i) => @(t)
TableRepeatable : @Expression = "REPEATABLE"i & '(' & v: ValueExpression & ')' => @(v)

// ── §13.1's direct select, widened ──────────────────────────────────────────
//
// Where the clauses that belong to the statement rather than to the query go: how many
// rows to skip and take, what shape to return them in, and how to run the whole thing.
TsqlDirectSelect : @Statement
	= with: WithClause? & q: QueryExpression & by: OrderByClause? & window: OffsetFetch?
	  & shape: ForClause? & options: QueryHints?
		=> @(new Statement.Select(
				 with ?? Clause.None, q, Clause.Ordered(by, window),
				 shape is null ? Clause.None : new Clause[] { shape },
				 options ?? Clause.None))

// §7's `WITH <common_table_expression>`: a query given a name in front of the statement
// that uses it. Read and dropped — what it names is a query the tree already holds no
// place for, and putting one in is a question about the shape of the tree rather than
// about the grammar.
//
// The definition is a query expression and not a whole statement: the syntax forbids a
// `WITH` inside a `WITH`, and writing it that way is how the grammar says so.
WithClause : @Clause[]
	= "WITH"i & t: ChangeTrackingContext => @(new Clause[] { new Clause.Option(t, null, Clause.None) })
	| "WITH"i & t: XmlNamespaces & (',' & rest: CteDefinition)*
		=> @(Syntax.Listed<Clause>(new Clause.Option(t, null, Clause.None), rest))
	| "WITH"i & first: CteDefinition & (',' & rest: CteDefinition)*
		=> @(Syntax.Listed<Clause>(first, rest))

// The namespaces a `FOR XML` may use, declared where a named query is declared and in
// the same breath as one.
ChangeTrackingContext : @string
	= t: ("CHANGE_TRACKING_CONTEXT"i & '(' & ValueExpression & ')') => @(t)

XmlNamespaces : @string
	= t: ("XMLNAMESPACES"i & '(' & XmlNamespace & (',' & XmlNamespace)* & ')') => @(t)
XmlNamespace  = "DEFAULT"i & ValueExpression
			  | ValueExpression & "AS"i & Identifier
CteDefinition : @Clause.CommonTableExpression
	= name: Identifier & ('(' & columns: ColumnList & ')')? & "AS"i & '(' & q: CteBody & ')'
		=> @(new Clause.CommonTableExpression(name, columns, q))

// The order a named query is written in is read and dropped: a `WITH` defines a table, and
// a table has no order until something asks for one.
CteBody : @Query = q: QueryExpression & OrderByClause? & OffsetFetch? => @(q)

// `FETCH` without `OFFSET` in front of it is not a clause: the engine answers
// `Incorrect syntax`, though ScriptDom reads it. The corpus statement that asked for it was
// wrong to, and reading it was over-acceptance rather than coverage.
// Published as two clauses inside `ORDER BY` and read here as one, since neither may be
// written without the sort. What comes out is the order clause with an empty list, and
// whoever read the list fills it in — `Clause.Ordered` is where the two meet.
OffsetFetch : @Clause.OrderBy
	= "OFFSET"i & skip: ValueExpression & RowWord & take: FetchClause?
		=> @(new Clause.OrderBy(Clause.None, skip, take))

FetchClause : @Expression
	= "FETCH"i & "APPROXIMATE"i & FetchAt & v: ValueExpression & RowWord & "ONLY"i => @(v)
	| "FETCH"i & FetchAt & v: ValueExpression & RowWord & "ONLY"i                  => @(v)

FetchAt = "NEXT"i | "FIRST"i
RowWord = "ROWS"i | "ROW"i

ForClause : @Clause
	= "FOR"i & "BROWSE"i => @(new Clause.For("BROWSE", Syntax.NoNames))
	| "FOR"i & kind: ("JSON"i | "XML"i) & first: ForOption & (',' & rest: ForOption)*
		=> @(new Clause.For(kind, Syntax.Named(first, rest)))

ForOption : @string = t: (Identifier & ForOptionTail?) => @(t)

ForOptionTail = '(' & ValueExpression & ')' | '=' & ValueExpression

// ── What the dialect is, said once ──────────────────────────────────────────
//
// One header, and every rule reachable from inside it reads T-SQL. The four entry
// points are the standard's own, called through the substitution rather than
// rewritten — which is the whole claim this file makes.
namespace Dialect with (
	Identifier                = TsqlIdentifier,
	GeneralValueSpecification = TsqlValueSpecification,
	ValueExpressionPrimary    = TsqlValuePrimary,
	QuerySpecification        = TsqlQuerySpecification,
	TablePrimary              = TsqlTablePrimary,
	TableReference            = TsqlTableReference,
	SelectSublist             = TsqlSelectSublist,
	GroupByClause             = TsqlGroupByClause,
	DirectSelect              = TsqlDirectSelect,
	QualifiedName             = TsqlQualifiedName,
	QueryExpression           = TsqlQueryExpression,
	SimpleWhen                = TsqlSimpleWhen,
	DataType                  = TsqlDataType,
	Predicate                 = TsqlPredicate)
{
	Select    : @Statement  = q: Sql92.DirectSelect    => @(q)
	Query     : @Query      = q: Sql92.QueryExpression => @(q)
	Condition : @Expression = c: Sql92.SearchCondition => @(c)
	Value     : @Expression = v: Sql92.ValueExpression => @(v)
	Statement : @Statement = s: TsqlStatement         => @(s)
}

parse Dialect.Select    as ParseSelect
parse Dialect.Query     as ParseQuery
parse Dialect.Condition as ParseSearchCondition
parse Dialect.Value     as ParseValueExpression
parse Dialect.Statement as ParseStatement

// ── The graph pattern, which is a language of its own ───────────────────────
//
// `MATCH` is a predicate whose operand is not an expression at all: it is a drawing.
// Nodes are names, edges are names in parentheses, and an arrow between them says which
// way the edge points — `Person1-(friend)->Person2`. Written from the published `MATCH`
// syntax, and the whole of it is here: the simple pattern, the arbitrary-length one that
// `SHORTEST_PATH` takes, its two quantifiers, and the predicate that compares the last
// node of two paths.
//
// **The arrows are written as two characters and not as one lexeme, deliberately.** A
// `<-` token would be produced everywhere, and `a <-1` — a comparison with a negative
// number — would stop being one. There is no ambiguity to pay for it: a drawing appears
// only inside `MATCH (…)`, so the two characters can be read as two and the only thing
// admitted that nobody writes is a space between them.
GraphMatch : @Expression
	= "MATCH"i & '(' & t: GraphPattern & ')' => @(new Expression.GraphMatch(t))

GraphPattern = GraphAnd & (',' & GraphAnd)*

// `AND` inside a drawing joins two drawings, and it is the only connective there is:
// the syntax says `OR` and `NOT` are not supported in a pattern.
GraphAnd = GraphItem & ("AND"i & GraphItem)*

GraphItem
	= "SHORTEST_PATH"i & '(' & GraphAnd & ')'
	| '(' & GraphAnd & ')'
	| GraphLengthPattern & GraphNode
	| GraphNode & GraphItemTail

GraphItemTail
	= '=' & GraphNode
	| GraphStep+

GraphStep
	= GraphEdge & GraphNode
	| GraphLengthPattern

// A node is a table's name or the alias it was given in the `FROM` clause, and
// `LAST_NODE` names the far end of a path rather than a table.
GraphNode
	= "LAST_NODE"i & '(' & QualifiedName & ')'
	| QualifiedName

// An edge points one way or the other and must say which.
GraphEdge
	= '<' & '-' & '(' & QualifiedName & ')' & '-'
	| '-' & '(' & QualifiedName & ')' & '-' & '>'

// The pattern `SHORTEST_PATH` repeats, with the regular expression's own two quantifiers.
// It is written edge first or node first, and the difference is which end the node that
// bounds it stands at.
GraphLengthPattern
	= '(' & GraphStep+ & ')' & GraphQuantifier
	| '(' & GraphNode & GraphEdge & ')' & GraphQuantifier

GraphQuantifier = '+' | '{' & Sql92.Lexical.Digits & ',' & Sql92.Lexical.Digits & '}'

// ── The rowset functions ────────────────────────────────────────────────────
//
// A dozen small languages rather than one. Each is a name followed by an argument list
// that is not an argument list: `OPENJSON` takes a schema, `OPENROWSET` takes a file and
// a list of options, `CHANGETABLE` takes a word and then a table, and the full-text four
// take a column list where a value would stand.
//
// What they share is the shape around them — a name, parentheses, and a correlation — so
// they are one alternative of the table primary with a rule each inside it.

// `OPENJSON ( json [ , path ] ) [ WITH ( colName type [ path ] [ AS JSON ] , … ) ]`, and
// `OPENXML`'s schema declaration, which is the same shape with a different fourth part.
// The two are written as one rule because the syntax of the two is one shape.
RowsetSchema : @Clause[]
	= "WITH"i & '(' & first: SchemaColumn & (',' & rest: SchemaColumn)* & ')'
		=> @(Syntax.Listed(first, rest))
	| "WITH"i & name: QualifiedName
		=> @(new Clause[] { new Clause.JsonColumn(name, null, null, false) })

SchemaColumn : @Clause
	= name: Identifier & type: DataType & path: SchemaPath? & json: SchemaAsJson?
		=> @(new Clause.JsonColumn(name, type, path, json is not null))

SchemaPath : @string
	= t: Sql92.Lexical.NationalCharacterStringLiteral => @(t)
	| t: Sql92.Lexical.CharacterStringLiteral         => @(t)

SchemaAsJson = "AS"i & "JSON"i

// What may stand where one of these functions takes an argument. The published syntax of
// each names its own options — `SINGLE_NCLOB`, `FORMATFILE`, `CHANGES`, `LANGUAGE` — and
// the shape they all have is a word, a word and a value, a name, a list of names, or an
// ordinary value. So the shape is written and the vocabulary is left open, exactly as it
// is for the table hints and for the same reason: a name here is a catalogue's business,
// and adding one to T-SQL does not change the grammar.
RowsetArguments : @Expression[]
	= first: RowsetArgument & (',' & rest: RowsetArgument)* => @(Syntax.Listed(first, rest))

RowsetArgument : @Expression
	// A bare `*` here is every column of the source, which is what a column reference
	// spelled `*` says — a select list's `<qualified asterisk>` is a clause and this is not
	// in a select list.
	= '*'                                        => @(new Expression.ColumnReference("*"))
	| n: RowsetOrder                             => @(n)
	| word: "BULK"i & v: RowsetValue             => @(new Expression.Prefixed(word, v))
	| name: Identifier & '=' & v: RowsetValue    => @(new Expression.NamedArgument(name, v))
	| word: Identifier & v: RowsetValue          => @(new Expression.Prefixed(word, v))
	| '(' & first: RowsetArgument & (',' & rest: RowsetArgument)* & ')'
		=> @(new Expression.RowValueConstructor(Syntax.Listed(first, rest)))
	| v: RowsetValue                             => @(v)

// `ORDER ( c1 ASC, c2 DESC ) [ UNIQUE ]` says a bulk source is already sorted.
RowsetOrder : @Expression
	= "ORDER"i & '(' & first: SortSpecification & (',' & rest: SortSpecification)* & ')'
	  & unique: "UNIQUE"i?
		=> @(new Expression.RowsetOrder(Syntax.Listed(first, rest), unique is not null))

// A provider's arguments may be joined by semicolons rather than commas — a connection
// string written as three pieces, which is `OPENROWSET`'s oldest spelling.
RowsetValue : @Expression
	= v: ValueExpression & (';' & ValueExpression)+ => @(v)
	| "NULL"i    => @(Expression.NullValue)
	| "DEFAULT"i => @(Expression.DefaultValue)
	| v: ValueExpression => @(v)

RowsetFunction : @Expression.RoutineInvocation
	= name: RowsetName & '(' & args: RowsetArguments? & ')'
		=> @(new Expression.RoutineInvocation(name, args ?? Expression.None))

RowsetName
	= "OPENROWSET"i | "OPENQUERY"i | "OPENDATASOURCE"i | "OPENXML"i | "OPENJSON"i
	| "CHANGETABLE"i | "CONTAINSTABLE"i | "FREETEXTTABLE"i
	| "SEMANTICKEYPHRASETABLE"i | "SEMANTICSIMILARITYTABLE"i | "SEMANTICSIMILARITYDETAILSTABLE"i
	| "PREDICT"i | "VECTOR_SEARCH"i | "GENERATE_SERIES"i | "STRING_SPLIT"i

// ── The statements that change rows ─────────────────────────────────────────
//
// The query level was the whole of this grammar until now, and the four statements that
// write are written on top of it rather than beside it: an `INSERT` takes a query, an
// `UPDATE` takes a `FROM` clause, a `MERGE` takes a table source and two search
// conditions. Almost nothing here is new — what is new is the frame around what was
// already read.
//
// `OUTPUT` is read and dropped, as `TOP` and the hints are. It says what a statement
// hands back rather than what it does, and it would be a fifth field on four records
// that nothing yet reads.
// The terminator is part of the statement and not of the script, at least for one of
// them: SQL Server answers `A MERGE statement must be terminated by a semi-colon (;)`.
// So it is read here where it stands rather than cut off before the parse — cutting it
// off is what made every merge in the corpus look like a defect on this side.
TsqlStatement : @Statement
	= with: WithClause? & s: StatementBody & ';'? => @(Syntax.Preceded(with, s))

StatementBody : @Statement
	= s: TsqlInsert   => @(s)
	| s: TsqlUpdate   => @(s)
	| s: TsqlDelete   => @(s)
	| s: TsqlMerge    => @(s)
	| s: Procedural   => @(s)
	| s: DirectSelect => @(s)

// What a statement writes to. Narrower than a table primary on purpose: the syntax gives
// a target no correlation and no sample, and `UPDATE t AS x SET …` is not T-SQL.
DmlTarget : @TableReference
	= f: RowsetFunction                 => @(new TableReference.FunctionCall(f, null, null, Clause.None))
	| t: Tsql.Variable & hints: TableHints?    => @(new TableReference.Named(t, null, null, null, null, hints ?? Clause.None))
	| name: QualifiedName & hints: TableHints? => @(new TableReference.Named(name, null, null, null, null, hints ?? Clause.None))

// ── §INSERT ─────────────────────────────────────────────────────────────────
TsqlInsert : @Statement
	= "INSERT"i & top: Top? & into: "INTO"i? & target: DmlTarget
	  & ('(' & columns: ColumnList & ')')? & output: OutputClause?
	  & rows: InsertRows
		=> @(new Statement.Insert(target, columns, rows, null, top, output, into is not null))

InsertRows : @Query
	= "DEFAULT"i & "VALUES"i    => @(new Query.DefaultValues())
	| v: TableValueConstructor  => @(v)
	| e: ExecuteStatement       => @(new Query.FromExecute(e))
	| q: QueryExpression        => @(q)

// ── §UPDATE ─────────────────────────────────────────────────────────────────
TsqlUpdate : @Statement
	= "UPDATE"i & top: Top? & target: DmlTarget
	  & "SET"i & sets: Assignments & output: OutputClause?
	  & from: FromClause? & where: DmlWhere? & options: QueryHints?
		=> @(new Statement.Update(target, sets, from ?? TableReference.None, where, null, top, output, options))

Assignments : @Clause[]
	= first: Assignment & (',' & rest: Assignment)* => @(Syntax.Listed(first, rest))

// Everything the syntax allows on the left of a `SET`, which is more than a column: a
// variable, a variable and a column at once, a member of a user-defined type, and a
// method called on one. `.WRITE (…)` needs no rule of its own — a qualified name has
// already eaten the dot, so what is left is a call.
Assignment : @Clause
	= to: Tsql.Variable   & s: AssignTail       => @(s with { Target = to })
	| to: QualifiedName   & s: ColumnAssignTail => @(s with { Target = to })

// `DEFAULT` is assigned and not compounded: the engine answers `DEFAULT is not allowed
// on the right hand side of "-="`, which is a rule about the operator rather than about
// the value, so it is written on the operator.
AssignTail : @Clause.Set
	= '=' & c: QualifiedName & op: AssignOp & v: SetValue => @(new Clause.Set("", op, v, c))
	| '=' & v: AssignedValue                              => @(new Clause.Set("", "=", v))
	| op: AssignOp & v: SetValue                          => @(new Clause.Set("", op, v))

ColumnAssignTail : @Clause.Set
	= '(' & args: Arguments? & ')' => @(new Clause.Set("", "", new Expression.RoutineInvocation("", args ?? Expression.None)))
	| '=' & v: AssignedValue       => @(new Clause.Set("", "=", v))
	| op: AssignOp & v: SetValue   => @(new Clause.Set("", op, v))

AssignedValue : @Expression
	= "DEFAULT"i => @(Expression.DefaultValue)
	| v: SetValue => @(v)

SetValue : @Expression
	= "NULL"i    => @(Expression.NullValue)
	| v: ValueExpression => @(v)

// A `WHERE` that may name a cursor's current row instead of a condition.
DmlWhere : @Expression
	= "WHERE"i & t: ("CURRENT"i & "OF"i & "GLOBAL"i? & QualifiedName)
		=> @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| "WHERE"i & c: SearchCondition => @(c)

// ── §DELETE ─────────────────────────────────────────────────────────────────
TsqlDelete : @Statement
	= "DELETE"i & top: Top? & "FROM"i? & target: DmlTarget & output: OutputClause?
	  & from: FromClause? & where: DmlWhere? & options: QueryHints?
		=> @(new Statement.Delete(target, from ?? TableReference.None, where, null, top, output, options))

// ── §MERGE ──────────────────────────────────────────────────────────────────
//
// Three shapes of arm and they are not interchangeable: a match and a missing target may
// insert, a missing source may update or delete, and the syntax says which is which.
TsqlMerge : @Statement
	= "MERGE"i & top: Top? & into: "INTO"i? & target: DmlTarget & ("AS"i? & alias: CorrelationName)?
	  & "USING"i & source: TableReference
	  & "ON"i & on: SearchCondition
	  & whens: MergeArm+ & output: OutputClause? & options: QueryHints?
		=> @(new Statement.Merge(target, source, on, whens, null, top, alias, output, options, into is not null))

MergeArm : @Clause
	= "WHEN"i & "MATCHED"i & ("AND"i & c: SearchCondition)? & "THEN"i & a: MergeChange
		=> @(new Clause.MergeWhen(true, null, c, a))
	| "WHEN"i & "NOT"i & "MATCHED"i & "BY"i & "SOURCE"i & ("AND"i & c: SearchCondition)?
	  & "THEN"i & a: MergeChange
		=> @(new Clause.MergeWhen(false, "SOURCE", c, a))
	| "WHEN"i & "NOT"i & "MATCHED"i & ("BY"i & "TARGET"i)? & ("AND"i & c: SearchCondition)?
	  & "THEN"i & a: MergeInsert
		=> @(new Clause.MergeWhen(false, "TARGET", c, a))

MergeChange : @Statement
	= "UPDATE"i & "SET"i & sets: Assignments
		=> @(new Statement.Update(null, sets, TableReference.None, null))
	| "DELETE"i
		=> @(new Statement.Delete(null, TableReference.None, null))

MergeInsert : @Statement
	= "INSERT"i & ('(' & columns: ColumnList & ')')? & rows: MergeInsertRows
		=> @(new Statement.Insert(null, columns, rows))

MergeInsertRows : @Query
	= "DEFAULT"i & "VALUES"i   => @(new Query.DefaultValues())
	| v: TableValueConstructor => @(v)

// ── The output clause, shared by all four ───────────────────────────────────
//
// What it names is `INSERTED`, `DELETED` or a table of the `FROM` clause, and `$action`
// for a merge — all of them ordinary names once `$` is part of one.
OutputClause : @Clause
	= "OUTPUT"i & items: OutputList & "INTO"i & into: DmlTarget & ('(' & columns: ColumnList & ')')? & next: OutputClause?
		=> @(new Clause.Output(items, into, columns, next))
	| "OUTPUT"i & items: OutputList
		=> @(new Clause.Output(items))

OutputList : @Clause[] = first: OutputItem & (',' & rest: OutputItem)* => @(Syntax.Listed(first, rest))

OutputItem : @Clause
	= q: QualifiedName & '.' & '*'          => @(new Clause.QualifiedAsterisk(q))
	| v: ValueExpression & alias: TsqlAsClause? => @(new Clause.DerivedColumn(v, alias))

// ── The procedural level ────────────────────────────────────────────────────
//
// The frame everything else stands inside. It is worth writing before the rest of the
// statement language and not after: `CREATE PROCEDURE`, `CREATE TRIGGER` and
// `CREATE FUNCTION` are a header and a body, and the body is this — so none of the three
// can be read at all until it exists, and `INSERT … EXEC` cannot either.
//
// Everything here was written from the published syntax and every form put to the engine.

// Split in two, and not for tidiness: with all of it in one rule the generator answered
// GRAM5003 — one materializing method of 2,132 basic blocks, past the point where the JIT
// stops optimizing and runs it several times slower than it needs to. Two rules are two
// methods, and each is inside the budget. It is the first time this grammar has been large
// enough for that to happen, and it will not be the last.
Procedural : @Statement
	= s: ControlStatement    => @(s)
	| s: DefinitionStatement => @(s)

ControlStatement : @Statement
	= s: TryCatchStatement    => @(s)
	| s: TransactionStatement => @(s)
	| s: StatementBlock       => @(s)
	| s: ConditionalStatement => @(s)
	| s: LoopStatement        => @(s)
	| s: SimpleCommand        => @(s)

DefinitionStatement : @Statement
	= s: DeclareStatement     => @(s)
	| s: SetStatement         => @(s)
	| e: ExecuteStatement     => @(e)
	| s: BulkInsertStatement  => @(s)
	| s: CreateTableStatement => @(s)
	| s: AlterTableStatement  => @(s)
	| s: CreateRoutine        => @(s)
	| s: CreateIndexStatement => @(s)
	| s: AlterIndexStatement  => @(s)
	| s: PermissionStatement  => @(s)
	| s: AuditStatement          => @(s)
	| s: KeyStatement            => @(s)
	| s: FullTextStatement       => @(s)
	| s: BackupStatement         => @(s)
	| s: RestoreStatement        => @(s)
	| s: CreateDatabaseStatement => @(s)
	| s: AlterDatabaseStatement  => @(s)
	| s: DropStatement           => @(s)
	| s: PrincipalStatement      => @(s)
	| s: ExternalStatement       => @(s)

StatementList : @Statement[] = s: TsqlStatement+ => @(s)

// `BEGIN TRY` and `BEGIN TRANSACTION` open with the same word as a block, so both stand
// in front of it.
TryCatchStatement : @Statement
	= "BEGIN"i & "TRY"i & tried: StatementList & "END"i & "TRY"i
	  & "BEGIN"i & "CATCH"i & caught: StatementList & "END"i & "CATCH"i
		=> @(new Statement.TryCatch(tried, caught))

StatementBlock : @Statement
	= "BEGIN"i & "ATOMIC"i & "WITH"i & '(' & atomic: OptionList & ')' & body: StatementList & "END"i
		=> @(new Statement.Compound(body, atomic))
	| "BEGIN"i & body: StatementList & "END"i => @(new Statement.Compound(body))

ConditionalStatement : @Statement
	= "IF"i & c: SearchCondition & then: TsqlStatement & ("ELSE"i & other: TsqlStatement)?
		=> @(new Statement.If(c, then, other))

LoopStatement : @Statement
	= "WHILE"i & c: SearchCondition & body: TsqlStatement => @(new Statement.While(c, body))

// ── Transactions ────────────────────────────────────────────────────────────
TransactionStatement : @Statement
	= "BEGIN"i & "DISTRIBUTED"i & word: TranWord & name: TranName? & mark: TranMark?
		=> @(new Statement.Transaction("BEGIN DISTRIBUTED", name, word, Syntax.Tail(mark)))
	| "BEGIN"i & word: TranWord & name: TranName? & mark: TranMark?
		=> @(new Statement.Transaction("BEGIN", name, word, Syntax.Tail(mark)))
	| "COMMIT"i & word: TranWord? & name: TranName? & how: TranDelayed?
		=> @(new Statement.Transaction("COMMIT", name, word, Syntax.Tail(how)))
	| "ROLLBACK"i & word: TranWord? & name: TranName?
		=> @(new Statement.Transaction("ROLLBACK", name, word))
	| "SAVE"i & word: TranWord & name: TranName
		=> @(new Statement.Transaction("SAVE", name, word))

TranWord : @string = t: ("TRANSACTION"i | "TRAN"i | "WORK"i) => @(Syntax.Squared(t))
TranMark    = "WITH"i & "MARK"i & ValueExpression?
TranDelayed = "WITH"i & '(' & OptionList & ')'

TranName : @string = t: Identifier => @(t) | t: Tsql.Variable => @(t)

// ── Declarations ────────────────────────────────────────────────────────────
DeclareStatement : @Statement
	= "DECLARE"i & name: Identifier & "CURSOR"i & tail: (CursorOption* & "FOR"i & CursorBody)
		=> @(new Statement.Declare(new Clause[]
			 { new Clause.VariableDeclaration(name, "CURSOR", null, null, null, Syntax.Tail(tail)) }))
	| "DECLARE"i & first: Declaration & (',' & rest: Declaration)*
		=> @(new Statement.Declare(Syntax.Listed(first, rest)))

Declaration : @Clause
	= name: Tsql.Variable & "AS"i? & d: DeclaredAs => @(d with { Name = name })

DeclaredAs : @Clause.VariableDeclaration
	= "TABLE"i & '(' & body: TableBody & ')'              => @(new Clause.VariableDeclaration("", "TABLE", null, body))
	| "CURSOR"i                                           => @(new Clause.VariableDeclaration("", "CURSOR", null))
	| type: DataType & n: NullSpec? & ('=' & v: SetValue)? => @(new Clause.VariableDeclaration("", type, v, null, n))

CursorOption = "LOCAL"i | "GLOBAL"i | "FORWARD_ONLY"i | "SCROLL"i | "STATIC"i | "KEYSET"i
			 | "DYNAMIC"i | "FAST_FORWARD"i | "READ_ONLY"i | "SCROLL_LOCKS"i | "OPTIMISTIC"i
			 | "TYPE_WARNING"i | "INSENSITIVE"i

CursorBody = QueryExpression & OrderByClause? & CursorFor?
CursorFor  = "FOR"i & "UPDATE"i & ("OF"i & ColumnList)?
		   | "FOR"i & "READ"i & "ONLY"i

IndexOrder : @string = t: ("CLUSTERED"i | "NONCLUSTERED"i) => @(Syntax.Squared(t))

// `GENERATED ALWAYS AS { ROW | TRANSACTION_ID | SEQUENCE_NUMBER } { START | END }`, and
// `END` is a reserved word — so the two ends are named rather than read as identifiers,
// which is what the published syntax says they are anyway.
GeneratedWhat = word
GeneratedWhen = word

// ── SET ─────────────────────────────────────────────────────────────────────
//
// Two statements share the word: one assigns a variable, the other names a setting. The
// options that are reserved words stand in front, since the general form reads a name.
SetStatement : @Statement
	= "SET"i & "TRANSACTION"i & "ISOLATION"i & "LEVEL"i & level: IsolationLevel
		=> @(new Statement.SetTransactionIsolationLevel(level))
	| "SET"i & "IDENTITY_INSERT"i & name: QualifiedName & on: OnOff
		=> @(new Statement.SetIdentityInsert(name, Syntax.Switched(on)))
	| "SET"i & option: SetReserved & v: ValueExpression
		=> @(new Statement.SetCommand(option, v))
	| "SET"i & name: Tsql.Variable & s: AssignTail
		=> @(new Statement.SetVariable(name, s.Value, s.Operator, s.Through))
	| "SET"i & first: SetOption & (',' & rest: SetOption)* & on: OnOff
		=> @(new Statement.SetOption(Syntax.Named(first, rest), Syntax.Switched(on)))
	| "SET"i & option: SetOptions & v: ValueExpression
		=> @(new Statement.SetCommand(option, v))
	| "SET"i & option: SetOptions
		=> @(new Statement.SetCommand(option, null))

SetReserved = "ROWCOUNT"i | "TEXTSIZE"i | "OFFSETS"i | "STATISTICS"i | "USER"i
SetOption : @string = t: Identifier => @(t)
SetOptions  = Identifier & (',' & Identifier)*
OnOff : @string = "ON"i => @("ON") | "OFF"i => @("OFF")

IsolationLevel = "READ"i & "UNCOMMITTED"i | "READ"i & "COMMITTED"i | "REPEATABLE"i & "READ"i
			   | "SNAPSHOT"i | "SERIALIZABLE"i

// ── EXECUTE ─────────────────────────────────────────────────────────────────
ExecuteStatement : @Statement.Execute = ExecWord & e: ExecuteBody => @(e)

ExecuteBody : @Statement.Execute
	= "AS"i & who: Identifier & '=' & v: ValueExpression & with: ExecWith?
		=> @(new Statement.Execute(
				 null, "AS", new Expression[] { new Expression.NamedArgument(who, v) }, null,
				 Syntax.Tail(with)))
	| '(' & args: Arguments & ')' & at: ExecAt? & with: ExecWith?
		=> @(new Statement.Execute(null, "(", args, at, Syntax.Tail(with)))
	| into: ExecReturn? & name: ExecName & args: ExecArguments? & at: ExecAt? & with: ExecWith?
		=> @(new Statement.Execute(into, name, args ?? Expression.None, at, Syntax.Tail(with)))

ExecWord   = "EXECUTE"i | "EXEC"i
ExecReturn : @string = t: Tsql.Variable & '=' => @(t)
ExecName   : @string = t: QualifiedName => @(t) | t: Tsql.Variable => @(t)
ExecAt     : @string = "AT"i & t: QualifiedName => @(t)
ExecWith   = "WITH"i & ExecOption & (',' & ExecOption)*
ExecOption = "RESULT"i & "SETS"i & "NONE"i
		   | "RESULT"i & "SETS"i & "UNDEFINED"i
		   | Identifier

ExecArguments : @Expression[]
	= first: ExecArgument & (',' & rest: ExecArgument)* => @(Syntax.Listed(first, rest))

// The lookahead is the fifth of its kind and the first that is not about a name: `AT` is
// not reserved, so `EXEC dbo.p AT linked` read `AT` as an argument and then wanted the
// clause it had just eaten. The shape is the same wherever an optional list stands in
// front of a clause whose first word could belong to the list.
ExecArgument : @Expression
	= name: Tsql.Variable & '=' & v: ExecValue & back: OutputWord?
		=> @(Syntax.Hinted(new Expression.NamedArgument(name, v), back))
	| ?!"AT"i & v: ExecValue & back: OutputWord?
		=> @(Syntax.Hinted(v, back))

// The two spellings of the same word, kept as the author wrote it.
OutputWord = "OUTPUT"i | "OUT"i

ExecValue : @Expression
	= "DEFAULT"i => @(Expression.DefaultValue)
	| "NULL"i    => @(Expression.NullValue)
	| v: ValueExpression => @(v)

// ── BULK INSERT ─────────────────────────────────────────────────────────────
BulkInsertStatement : @Statement
	= "BULK"i & "INSERT"i & target: DmlTarget & "FROM"i & file: ValueExpression
	  & ("WITH"i & '(' & first: BulkOption & (',' & rest: BulkOption)* & ')')?
		=> @(new Statement.Insert(target, null, new Query.FromFile(file, first is null ? null : Syntax.Listed(first, rest)), null, null, null, false))

// `ORDER (c1 ASC, c2 DESC)` is an option whose value is a sort, kept as the words; the
// rest are a name, and what it is set to or given in brackets.
BulkOption : @Clause
	= t: ("ORDER"i & '(' & SortSpecification & (',' & SortSpecification)* & ')')
		=> @(new Clause.Option(Syntax.Spaced(t), null, Clause.None))
	| name: Identifier & tail: BulkOptionTail? => @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

BulkOptionTail : @Clause.Option
	= '=' & v: ValueExpression   => @(new Clause.Option("", v, Clause.None))
	| '(' & a: Arguments & ')'   => @(new Clause.Option("", new Expression.RoutineInvocation("", a), Clause.None, null, true))

// ── A word and some values ──────────────────────────────────────────────────
SimpleCommand : @Statement
	= "PRINT"i & v: ValueExpression      => @(Statement.Commanded("PRINT", v))
	| "RETURN"i & v: ValueExpression?    => @(Statement.Commanded("RETURN", v))
	| "THROW"i & args: Arguments?        => @(Statement.Commanded("THROW", args))
	| "GOTO"i & name: Identifier         => @(Statement.Commanded("GOTO", new Expression.ColumnReference(name)))
	| "BREAK"i                           => @(Statement.Commanded("BREAK", (Expression?)null))
	| "CONTINUE"i                        => @(Statement.Commanded("CONTINUE", (Expression?)null))
	| "CHECKPOINT"i & v: ValueExpression? => @(Statement.Commanded("CHECKPOINT", v))
	| "USE"i & name: QualifiedName       => @(Statement.Commanded("USE", new Expression.ColumnReference(name)))
	| "RAISERROR"i & '(' & args: Arguments & ')' & how: RaiseWith?
		=> @(new Statement.RaiseError(args, Syntax.Tail(how)))
	| "RAISERROR"i & args: Arguments & how: RaiseWith?
		=> @(new Statement.RaiseError(args, Syntax.Tail(how)))
	| "WAITFOR"i & kind: WaitKind & v: ValueExpression
		=> @(new Statement.WaitFor(v, Syntax.Squared(kind)))

RaiseWith = "WITH"i & Identifier & (',' & Identifier)*
WaitKind  = "DELAY"i | "TIME"i

// ── CREATE TABLE, and the column definitions everything shares ──────────────
//
// The largest single kind in the corpus, and the one that pulls the most behind it: a
// column definition is what `ALTER TABLE … ADD` adds and what `ALTER TABLE … ALTER COLUMN`
// changes, and the table body a variable declares is the same thing smaller.
//
// The option lists — `WITH (DATA_COMPRESSION = PAGE, …)`, `WITH (FILLFACTOR = 80)` — are
// written as a shape with an open vocabulary, as the table hints are and for the same
// reason: the names are a catalogue, and adding one to T-SQL does not change the grammar.
// `AS FileTable` stands before the columns and `AS NODE` after them, which is two
// syntaxes rather than one written twice; and a file table has no columns at all, its
// shape being the one the feature gives it.
CreateTableStatement : @Statement
	= "CREATE"i & "TABLE"i & name: QualifiedName & ('(' & columns: ColumnList & ')')?
	  & options: OptionsWith & "AS"i & q: DirectSelect
		=> @(new Statement.CreateTableAsSelect(name, columns, options, q))
	| "CREATE"i & "TABLE"i & name: QualifiedName & kind: TableAs? & '(' & body: TableBody & ')'
	  & after: TableAs? & placements: TablePlacement* & options: OptionsWith?
		=> @(new Statement.TableDefinition(name, kind ?? after, body, placements ?? Clause.None, options ?? Clause.None))
	| "CREATE"i & "TABLE"i & name: QualifiedName & kind: TableAs & placements: TablePlacement* & options: OptionsWith?
		=> @(new Statement.TableDefinition(name, kind, Clause.None, placements ?? Clause.None, options ?? Clause.None))

TableAs : @string = "AS"i & t: Identifier => @(t)

TablePlacement : @Clause
	= k: ("ON"i | "TEXTIMAGE_ON"i | "FILESTREAM_ON"i) & p: PlacementTarget => @(p with { Kind = Syntax.Squared(k) })

// The target and, for a partition scheme, the column it partitions on. The word in front
// is the caller's to say: the same target stands after `ON`, after `MOVE TO`, and after
// `FILESTREAM_ON`.
PlacementTarget : @Clause.Placement
	= t: "DEFAULT"i                                => @(new Clause.Placement("", t, null))
	| t: Sql92.Lexical.CharacterStringLiteral      => @(new Clause.Placement("", t, null))
	| t: Sql92.Lexical.DelimitedIdentifier         => @(new Clause.Placement("", t, null))
	| t: Identifier & ('(' & c: ColumnList & ')')? => @(new Clause.Placement("", t, c))

OptionsWith : @Clause[] = "WITH"i & '(' & o: OptionList & ')' => @(o)

// The same, where the statement keeps what it read as the words rather than as options.
OptionsWithText = "WITH"i & '(' & OptionList & ')'
OptionList  : @Clause[] = first: OptionSetting & (',' & rest: OptionSetting)* => @(Syntax.Listed(first, rest))

OptionSetting : @Clause
	= "DEFAULT"i & '=' & v: OptionValue => @(new Clause.Option("DEFAULT", v, Clause.None))
	| "MOVE"i & "TO"i & m: PlacementTarget => @(new Clause.Option("MOVE TO", null, new Clause[] { m }))

	// `AFFINITY SCHEDULER = AUTO`, `AFFINITY CPU = (0 TO 3)`,
	// `AFFINITY NUMANODE = (0)` — a value that is itself a name and a value.
	| name: ("AFFINITY"i & word?) & '=' & a: AffinityValue
		=> @(new Clause.Option(Syntax.Squared(name), new Expression.ColumnReference(a), Clause.None))

	// `RESAMPLE ON PARTITIONS (1, 3 TO 5)`: a name and a placement.
	| name: OptionName & p: OnPartitions => @(new Clause.Option(name, null, Clause.None, p))

	// `SAMPLE 50 PERCENT`, `SAMPLE 12 ROWS`. A run of words would read it whole
	// and does not: a number is a lexeme whose class holds a `.`, so it is not a
	// word however much §4.6 says a digit continues one.
	| "SAMPLE"i & v: ValueExpression & u: SampleUnit? => @(new Clause.Option("SAMPLE", Syntax.Measured(v, u), Clause.None))
	| t: ("PARTITION"i & '(' & Identifier & "RANGE"i & LeftOrRight?
		  & "FOR"i & "VALUES"i & '(' & Arguments? & ')' & ')')
		=> @(new Clause.Option(t, null, Clause.None))
	| name: OptionName & tail: OptionTail? => @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

// An option's name is not an identifier: `WITH (FILLFACTOR = 80)` names a word T-SQL
// reserves, and so do a dozen others. Nothing about it is a name of this language — it is
// a word standing inside brackets where only a word can stand — and that is what `word`
// says (§4.6). It was twelve reserved words written out beside `Identifier`, which was a
// catalogue of what SQL Server happened to have called its options and went stale on its
// own.
//
// A run of them, because the published syntax says a run in four places: `MOVE TO`,
// `CLUSTERED COLUMNSTORE INDEX`, `TRANSACTION ISOLATION LEVEL = SNAPSHOT` inside a
// `BEGIN ATOMIC WITH`, and every one of the two hundred database settings. Where it ends
// is the syntax: `ON` and `OFF` are what an option is set to rather than part of its
// name, and `WITH` begins the clause after the list.
OptionName = OptionWord+

OptionWord = ?!OptionEnd & word
OptionEnd  = "WITH"i | OnOff

// Two words at least, which is what tells a run from a name: one word is a name and a
// qualified one begins with a word, so a run of one would take `dbo` out of `dbo.h`.
// And a run of words is a value only where the comma or the bracket proves the run ended.
// Without that it takes the clause after an unbracketed list — `ALGORITHM = AES_256
// ENCRYPTION BY PASSWORD = 'p'` read the encryption as three more words of the algorithm.
// Where the list ends at the terminator its last value is one word, which is every value a
// list without brackets is written with.
OptionWords = OptionWord & OptionWord+ & ?=(',' | ')')

// A bare `ON` is a value only where the list goes on or ends. `CREATE INDEX … WITH
// PAD_INDEX ON ps (a)` is the old unbracketed `WITH` and then a placement, and without the
// lookahead the `ON` was read as what `PAD_INDEX` is set to — which GRAM5009 said, and the
// engine confirmed by refusing what came out.
// The list before the value: `CLEANUP_POLICY = (STALE_QUERY_THRESHOLD_DAYS = 367)` is a
// list and not an expression that happens to compare, and only the list reads it as one.
OptionTail : @Clause.Option
	= '=' & n: OptionNest & p: OnPartitions?   => @(new Clause.Option("", null, n, p))
	| '=' & v: OptionValue & n: OptionNest? & p: OnPartitions? => @(new Clause.Option("", v, n ?? Clause.None, p))
	| s: OnOff & o: SwitchTail                 => @(new Clause.Option("", new Expression.ColumnReference(s), o, null, true))
	| '(' & o: OptionList & ')'                => @(new Clause.Option("", null, o, null, true))

// Said as a refusal rather than as a demand, because a list without brackets ends at the
// terminator and a lookahead for a comma would refuse its last option. What a bare switch
// may not be followed by is a placement: `WITH PAD_INDEX ON ps (a)` is an option and then
// the filegroup it goes on, and `WITH TRUSTWORTHY ON` is an option set to on.
SwitchTail : @Clause[] = '(' & o: OptionList & ')' => @(o) | ?!PlacementTarget => @(Clause.None)

// The list a value may carry after it: `IGNORE_DUP_KEY = ON (SUPPRESS_MESSAGES = ON)`.
OptionNest : @Clause[] = '(' & o: OptionList & ')' => @(o)

// Typed, because what a setting is set to is the interesting half of `SET MAXDOP = 4`
// and the only half a name does not already say. `ON` and `OFF` are values here and not
// words of the language, so they arrive as themselves.
OptionValue : @Expression
	= "NULL"i => @(Expression.NullValue)
	| "OFF"i  => @(new Expression.ColumnReference("OFF"))
	| "ON"i   => @(new Expression.ColumnReference("ON"))
	| t: ('(' & Sql92.Lexical.UnsignedNumericLiteral+ & ')') => @(new Expression.ColumnReference(t))
	| '(' & a: Arguments & ')'  => @(new Expression.RoutineInvocation("", a))

	// A run of words, which several protocols spell their settings with:
	// `AUTHENTICATION = WINDOWS NTLM CERTIFICATE c`, `ENCRYPTION = SUPPORTED ALGORITHM AES
	// RC4`. In front of the expression, since a word is one and the run is longer; it stops
	// where an option's name does, which is what leaves `PAGE ON PARTITIONS (…)` alone.
	| w: OptionWords => @(new Expression.ColumnReference(w))

	| v: ValueExpression & u: OptionUnit? => @(Syntax.Measured(v, u))

	// And one word behind the expression, for the words a value may be that a name may
	// not: `MAXDOP = PRIMARY`, `QUERY_CAPTURE_MODE = ALL`.
	| w: word => @(new Expression.ColumnReference(w))

// A catalogue, and here the catalogue is the syntax: a unit is one of the words the
// language has for a size or a span, and nothing else may stand after a value. It was any
// identifier, and then `SET b = 5, c = 10 ACTION (…)` read `ACTION` as the unit of ten and
// lost the clause behind it — the same trap an optional at the end of a rule always is.
OptionUnit : @string = t: ("KB"i | "MB"i | "GB"i | "TB"i | "PB"i
		   | "SECOND"i | "SECONDS"i | "MINUTE"i | "MINUTES"i | "HOUR"i | "HOURS"i
		   | "DAY"i | "DAYS"i | "WEEK"i | "WEEKS"i | "MONTH"i | "MONTHS"i
		   | "YEAR"i | "YEARS"i
		   | "PERCENT"i | "ROWS"i
		   | '%') => @(t)

AffinityValue : @string
	= t: ("AUTO"i
		  | '(' & PartitionRange & (',' & PartitionRange)* & ')'
		  | word & '=' & '(' & PartitionRange & (',' & PartitionRange)* & ')') => @(t)

OnPartitions : @string
	= t: ("ON"i & "PARTITIONS"i & '(' & PartitionRange & (',' & PartitionRange)* & ')') => @(Syntax.Squared(t))
PartitionRange = ValueExpression & ("TO"i & ValueExpression)?

// ── The body ────────────────────────────────────────────────────────────────
TableBody : @Clause[]
	= first: TableElement & (',' & rest: TableElement)* => @(Syntax.Listed(first, rest))

TableElement : @Clause
	= "PERIOD"i & "FOR"i & "SYSTEM_TIME"i & '(' & columns: ColumnList & ')'
		=> @(Clause.Constrained("PERIOD FOR SYSTEM_TIME", Syntax.Columns(columns), null))
	| i: TableIndex                                => @(i)
	| "CONSTRAINT"i & name: Identifier & c: ConstraintBody => @(c with { Name = name })
	| c: ConstraintBody                            => @(c)
	| f: ColumnDefinition                          => @(f)

ColumnDefinition : @Clause
	= name: Identifier & f: ColumnBody => @(f with { Name = name })

ColumnBody : @Clause.ColumnDefinition
	= "AS"i & v: ValueExpression & tail: ColumnTail*
		=> @(new Clause.ColumnDefinition("", null, v, tail ?? Clause.None))
	| type: DataType & tail: ColumnTail*
		=> @(new Clause.ColumnDefinition("", type, null, tail ?? Clause.None))

// What may be said about a column after its type, each kept as what it is: an option, a
// constraint, or an index, in the order they were written.
ColumnTail : @Clause
	= t: "FILESTREAM"i                => @(Clause.Optioned(t))
	| "COLLATE"i & q: QualifiedName   => @(Clause.Optioned("COLLATE", new Expression.ColumnReference(q)))
	| t: "SPARSE"i                    => @(Clause.Optioned(t))
	| t: "HIDDEN"i                    => @(Clause.Optioned(t))
	| "MASKED"i & "WITH"i & '(' & o: OptionList & ')'
		=> @(new Clause.ColumnOption("MASKED", Expression.None, o, null))
	| "IDENTITY"i & ('(' & a: Arguments & ')')?
		=> @(new Clause.ColumnOption("IDENTITY", a ?? Expression.None, Clause.None, null))
	| t: ("NOT"i & "FOR"i & "REPLICATION"i) => @(Clause.Optioned(t))
	| s: NullSpec                     => @(Clause.Optioned(s))
	| t: ("GENERATED"i & "ALWAYS"i & "AS"i & GeneratedWhat & GeneratedWhen) & h: "HIDDEN"i?
		=> @(new Clause.ColumnOption(Syntax.Squared(t), Expression.None, Syntax.Unit(h), null))
	| t: "ROWGUIDCOL"i                => @(Clause.Optioned(t))
	| "ENCRYPTED"i & "WITH"i & '(' & o: OptionList & ')'
		=> @(new Clause.ColumnOption("ENCRYPTED", Expression.None, o, null))
	| t: "PERSISTED"i                 => @(Clause.Optioned(t))
	| t: ("COLUMN_SET"i & "FOR"i & "ALL_SPARSE_COLUMNS"i) => @(Clause.Optioned(t))
	| "CONSTRAINT"i & name: Identifier & n: NamedConstraint => @(Clause.Named(n, name))
	| c: ConstraintBody               => @(c)
	| i: TableIndex                   => @(i)

// The published syntax gives a nullability a constraint name of its own, and nothing else
// about a nullability suggests it can have one.
NamedConstraint : @Clause
	= t: NullSpec       => @(Clause.Optioned(t))
	| c: ConstraintBody => @(c)

NullSpec : @string = t: ("NOT"i & "NULL"i | "NULL"i) => @(Syntax.Squared(t))

// ── Constraints ─────────────────────────────────────────────────────────────
ConstraintBody : @Clause.ConstraintDefinition
	= "PRIMARY"i & "KEY"i & k: IndexOrder? & h: "HASH"i? & columns: IndexColumns?
	  & o: IndexWith? & p: IndexOn? & e: Enforced?
		=> @(Clause.Keyed("PRIMARY KEY", k, h, columns, o, p, e))
	| "UNIQUE"i & k: IndexOrder? & h: "HASH"i? & columns: IndexColumns?
	  & o: IndexWith? & p: IndexOn? & e: Enforced?
		=> @(Clause.Keyed("UNIQUE", k, h, columns, o, p, e))
	| "FOREIGN"i & "KEY"i & columns: IndexColumns? & r: References & e: Enforced?
		=> @(Clause.Constrained("FOREIGN KEY", columns, null) with { Referenced = r, Enforced = Syntax.Enforced(e) })
	| r: References & e: Enforced?
		=> @(Clause.Constrained("REFERENCES", null, null) with { Referenced = r, Enforced = Syntax.Enforced(e) })
	| "CHECK"i & n: ("NOT"i & "FOR"i & "REPLICATION"i)? & '(' & c: SearchCondition & ')'
		=> @(Clause.Constrained("CHECK", null, c) with { Options = Syntax.Unit(n) })
	| "CONNECTION"i & '(' & first: EdgePair & (',' & rest: EdgePair)* & ')' & a: ReferenceAction*
		=> @(Clause.Constrained("CONNECTION", null, null) with { Options = Syntax.Connected(first, rest, a) })
	| "DEFAULT"i & v: ValueExpression & ("FOR"i & f: Identifier)?
		=> @(Clause.Constrained("DEFAULT", null, v) with { ForColumn = f })

// A key a warehouse declares and does not check. Not the box's syntax and refused there,
// which is where the version chain will put it.
Enforced : @string = t: ("NOT"i? & "ENFORCED"i) => @(t)

// Which node tables an edge may join, which is the one constraint only a graph has.
EdgePair : @Clause = f: QualifiedName & "TO"i & t: QualifiedName => @(new Clause.Connection(f, t))

References : @Clause
	= "REFERENCES"i & t: QualifiedName & ('(' & c: ColumnList & ')')? & a: ReferenceAction*
		=> @(Syntax.Referenced(t, c, a))

ReferenceAction : @string
	= t: ("ON"i & DeleteOrUpdate & RefAction) => @(t)
	| t: ("NOT"i & "FOR"i & "REPLICATION"i)  => @(t)

DeleteOrUpdate = "DELETE"i | "UPDATE"i
RefAction      = "NO"i & "ACTION"i | "CASCADE"i | "SET"i & "NULL"i | "SET"i & "DEFAULT"i

IndexColumns : @Clause[] = '(' & first: IndexColumn & (',' & rest: IndexColumn)* & ')'
	=> @(Syntax.Listed(first, rest))

IndexColumn : @Clause
	= t: IndexName & o: ("ASC"i | "DESC"i)?
		=> @(new Clause.SortSpecification(new Expression.ColumnReference(t), Syntax.Ordered(o)))

// `$NODE_ID` and its fellows are columns a graph table has that nobody declared, and an
// index may be built on one.
IndexName : @string = t: Identifier => @(t) | t: PartitionName => @(t)

// The current form and the one that predates it: `WITH (FILLFACTOR = 80, ONLINE = ON)`
// and the bare `WITH PAD_INDEX, FILLFACTOR = 80` SQL Server still reads.
IndexWith : @Clause[]
	= "WITH"i & '(' & o: OptionList & ')' => @(o)
	| "WITH"i & o: OptionList             => @(o)

IndexOn : @Clause = "ON"i & p: PlacementTarget => @(p with { Kind = "ON" })

// ── An index written inside the table ───────────────────────────────────────
TableIndex : @Clause
	= "INDEX"i & name: Identifier & u: "UNIQUE"i? & c: IndexOrder? & s: "COLUMNSTORE"i? & h: "HASH"i?
	  & columns: IndexColumns?
	  & ("ORDER"i & '(' & order: ColumnList & ')')?
	  & ("INCLUDE"i & '(' & include: ColumnList & ')')?
	  & ("WHERE"i & filter: SearchCondition)?
	  & o: IndexWith? & p: IndexOn? & ("FILESTREAM_ON"i & f: PlacementTarget)?
		=> @(Clause.Indexed(name, u, c, s, h, columns, order, include, filter, o, (Clause.Placement?)p, f is null ? null : f with { Kind = "FILESTREAM_ON" }))

// ── ALTER TABLE ─────────────────────────────────────────────────────────────
//
// Nine actions and they share nothing but the header, so the header is read once and each
// action says which it is. What the tree keeps is the table, the word, and the elements
// where the action has any.
AlterTableStatement : @Statement
	= "ALTER"i & "TABLE"i & name: QualifiedName & a: AlterTableAction
		=> @(a with { Name = name })

AlterTableAction : @Statement.AlterTable
	= "ADD"i & c: ConstraintBody & "FOR"i & Identifier
		=> @(Statement.Altered("ADD", new Clause[] { c }))
	| "ADD"i & "CONSTRAINT"i & name: Identifier & c: ConstraintBody & "FOR"i & Identifier
		=> @(Statement.Altered("ADD", new Clause[] { c with { Name = name } }))
	| "ADD"i & body: TableBody
		=> @(Statement.Altered("ADD", body))
	| "WITH"i & mode: CheckWord & "ADD"i & body: TableBody
		=> @(Statement.Altered("WITH " + Syntax.Squared(mode) + " ADD", body))
	| "ALTER"i & "COLUMN"i & column: ColumnDefinition & options: OptionsWith?
		=> @(Statement.Altered("ALTER COLUMN", new Clause[] { column }, options))
	| "ALTER"i & "COLUMN"i & name: Identifier & flag: AlterColumnWord & options: OptionsWith?
		=> @(Statement.Flagged(name, flag, options))
	| "DROP"i & first: DropTarget & (',' & rest: DropTarget)*
		=> @(Statement.Altered("DROP", Syntax.Listed(first, rest)))
	| word: CheckWord & tail: ("CONSTRAINT"i & ConstraintNames)
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| word: EnableWord & tail: ("TRIGGER"i & ConstraintNames)
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| word: EnableWord & tail: ("CHANGE_TRACKING"i & OptionsWith?)
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| word: EnableWord & tail: "FILETABLE_NAMESPACE"i
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| "ALTER"i & tail: ("INDEX"i & Identifier & "REBUILD"i & IndexOrder? & OptionsWith?)
		=> @(Statement.Altered("ALTER", null, null, tail))
	| word: SplitOrMerge & tail: ("RANGE"i & '(' & SetValue & ')')
		=> @(Statement.Altered(Syntax.Squared(word), null, null, tail))
	| "SET"i & tail: ('(' & OptionList & ')')
		=> @(Statement.Altered("SET", null, null, tail))
	| "REBUILD"i & tail: (("PARTITION"i & '=' & PartitionWhich)? & OptionsWith?)
		=> @(Statement.Altered("REBUILD", null, null, tail))
	| "SWITCH"i & tail: (("PARTITION"i & ValueExpression)? & "TO"i & QualifiedName
						 & ("PARTITION"i & ValueExpression)? & OptionsWith?)
		=> @(Statement.Altered("SWITCH", null, null, tail))

AlterColumnWord : @string = t: ("ADD"i & AlterColumnFlag | "DROP"i & AlterColumnFlag) => @(Syntax.Squared(t))

AlterColumnFlag  = "MASKED"i & ("WITH"i & '(' & OptionList & ')')?
				 | "HIDDEN"i
				 | ColumnTail
CheckWord        = "CHECK"i | "NOCHECK"i
SplitOrMerge     = "SPLIT"i | "MERGE"i
LeftOrRight      = "LEFT"i | "RIGHT"i
EnableWord       = "ENABLE"i | "DISABLE"i
ConstraintNames  = "ALL"i | Identifier & (',' & Identifier)*
PartitionWhich : @Expression = "ALL"i => @(new Expression.ColumnReference("ALL")) | v: ValueExpression => @(v)

DropTarget : @Clause
	= "COLUMN"i & exists: IfExists? & name: Identifier
		=> @(Clause.Marked("COLUMN", name, exists, null))
	| "CONSTRAINT"i & exists: IfExists? & name: Identifier & tail: OptionsWithText?
		=> @(Clause.Marked("CONSTRAINT", name, exists, tail))
	| "INDEX"i & name: Identifier      => @(Clause.Marked("INDEX", name))
	| "PERIOD"i & "FOR"i & "SYSTEM_TIME"i => @(Clause.Marked("PERIOD FOR SYSTEM_TIME", null))
	| name: Identifier & tail: OptionsWithText?
		=> @(Clause.Marked("CONSTRAINT", name, null, tail))

IfExists = "IF"i & "EXISTS"i

// ── The routines: a header and a body ───────────────────────────────────────
//
// Four statements that could not be read at all until the procedural level was written,
// because each of them is a header and then whatever T-SQL somebody put inside it. That
// is 341 statements of the corpus, and the body is the part that was already done.
//
// `CREATE OR ALTER` is one word in front of all four, so it is read once.
CreateRoutine : @Statement
	= verb: ("CREATE"i & OrAlter?) & r: RoutineBody => @(Syntax.Verbed(r, verb))
	| verb: "ALTER"i & r: RoutineBody               => @(Syntax.Verbed(r, verb))

OrAlter = "OR"i & "ALTER"i

RoutineBody : @Statement
	= p: ProcedureStatement => @(p)
	| f: FunctionStatement  => @(f)
	| g: TriggerStatement   => @(g)
	| v: ViewStatement      => @(v)

// ── CREATE PROCEDURE ────────────────────────────────────────────────────────
ProcedureStatement : @Statement
	= ProcWord & name: QualifiedName & (';' & number: Sql92.Lexical.Digits)?
	  & parameters: RoutineParameters? & options: RoutineOptions? & replication: ("FOR"i & "REPLICATION"i)?
	  & "AS"i & ("EXTERNAL"i & "NAME"i & external: QualifiedName | body: StatementList)
		=> @(new Statement.CreateProcedure(name, parameters ?? Clause.None, body ?? Statement.None, options, replication is not null, external, number))

ProcWord = "PROCEDURE"i | "PROC"i

// The parentheses are optional, which is why a parameter list is a rule rather than a
// bracketed one: `CREATE PROCEDURE p @a INT AS …` is as good as `p (@a INT)`.
RoutineParameters : @Clause[]
	= '(' & ')' => @(Clause.None)
	| '(' & first: RoutineParameter & (',' & rest: RoutineParameter)* & ')'
		=> @(Syntax.Listed(first, rest))
	| first: RoutineParameter & (',' & rest: RoutineParameter)*
		=> @(Syntax.Listed(first, rest))

RoutineParameter : @Clause
	= name: Tsql.Variable & "AS"i? & type: DataType & varying: "VARYING"i? & n: NullSpec?
	  & ('=' & v: SetValue)? & ways: ParameterWay*
		=> @(new Clause.ParameterDeclaration(name, type, v, n, varying is not null, ways))

ParameterWay : @string = t: ("OUTPUT"i | "OUT"i | "READONLY"i) => @(Syntax.Squared(t))

RoutineOptions : @Clause[]
	= "WITH"i & first: RoutineOption & (',' & rest: RoutineOption)* => @(Syntax.Listed(first, rest))

RoutineOption : @Clause
	= "EXECUTE"i & "AS"i & who: ExecuteAsWho
		=> @(new Clause.Option("EXECUTE AS", new Expression.ColumnReference(who), Clause.None, null, true))
	| t: ("RETURNS"i & "NULL"i & "ON"i & "NULL"i & "INPUT"i) => @(new Clause.Option(Syntax.Squared(t), null, Clause.None))
	| t: ("CALLED"i & "ON"i & "NULL"i & "INPUT"i)            => @(new Clause.Option(Syntax.Squared(t), null, Clause.None))

	// One word and not a run of them, unlike an option inside brackets: this list is not
	// bracketed and `AS` follows it, so a run would take the `AS` and the body behind it.
	// What the published syntax names here is one word anyway — `ENCRYPTION`,
	// `SCHEMABINDING`, `NATIVE_COMPILATION`, `INLINE = ON`.
	| name: word & tail: OptionTail? => @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

ExecuteAsWho : @string
	= t: ("CALLER"i | "SELF"i | "OWNER"i
		  | Sql92.Lexical.CharacterStringLiteral
		  | Sql92.Lexical.NationalCharacterStringLiteral) => @(t)

// ── CREATE FUNCTION ─────────────────────────────────────────────────────────
//
// Three shapes and the difference is what `RETURNS` says: a type, `TABLE`, or a table
// variable and the columns it holds.
FunctionStatement : @Statement
	= "FUNCTION"i & name: QualifiedName & parameters: RoutineParameters?
	  & "RETURNS"i & r: FunctionReturns
		=> @(r with { Name = name, Parameters = parameters ?? Clause.None })

FunctionReturns : @Statement.CreateFunction
	= "TABLE"i & '(' & columns: TableBody & ')' & ("ORDER"i & order: IndexColumns)? & options: RoutineOptions?
	  & "AS"i & "EXTERNAL"i & "NAME"i & external: QualifiedName
		=> @(new Statement.CreateFunction("", Clause.None, "TABLE", Statement.None, options, columns, null, order, external))
	| "TABLE"i & options: RoutineOptions? & "AS"i? & "RETURN"i & body: InlineReturn
		=> @(new Statement.CreateFunction("", Clause.None, "TABLE", body, options))
	| name: Tsql.Variable & "TABLE"i & '(' & columns: TableBody & ')' & options: RoutineOptions? & "AS"i?
	  & body: StatementList
		=> @(new Statement.CreateFunction("", Clause.None, "TABLE", body, options, columns, name))
	| type: DataType & options: RoutineOptions? & "AS"i?
	  & ("EXTERNAL"i & "NAME"i & external: QualifiedName | body: StatementList)
		=> @(new Statement.CreateFunction("", Clause.None, type, body ?? Statement.None, options, null, null, null, external))

InlineReturn : @Statement[]
	= '(' & q: QueryExpression & OrderByClause? & ')' => @(new Statement[] { Statement.Selected(q) })
	| q: QueryExpression & OrderByClause?             => @(new Statement[] { Statement.Selected(q) })

// ── CREATE TRIGGER ──────────────────────────────────────────────────────────
TriggerStatement : @Statement
	= "TRIGGER"i & name: QualifiedName & "ON"i & on: TriggerOn & options: RoutineOptions?
	  & fires: TriggerWhen & events: TriggerEvents
	  & append: ("WITH"i & "APPEND"i)? & replication: ("NOT"i & "FOR"i & "REPLICATION"i)?
	  & "AS"i & ("EXTERNAL"i & "NAME"i & external: QualifiedName | body: StatementList)
		=> @(new Statement.CreateTrigger(name, on, events, body ?? Statement.None, fires, options,
				 append is not null, replication is not null, external))

TriggerOn : @string
	= "ALL"i & "SERVER"i => @("ALL SERVER")
	| "DATABASE"i        => @("DATABASE")
	| t: QualifiedName   => @(t)

TriggerWhen : @string = t: ("INSTEAD"i & "OF"i | "AFTER"i | "FOR"i) => @(Syntax.Squared(t))

// A DML trigger names the three statements; a DDL one names events or a group of them,
// and both are words separated by commas.
TriggerEvents : @string[]
	= first: TriggerEvent & (',' & rest: TriggerEvent)* => @(Syntax.Named(first, rest))

TriggerEvent : @string
	= "INSERT"i => @("INSERT")
	| "UPDATE"i => @("UPDATE")
	| "DELETE"i => @("DELETE")
	| t: Identifier => @(t)

// ── CREATE VIEW ─────────────────────────────────────────────────────────────
ViewStatement : @Statement
	= "MATERIALIZED"i & "VIEW"i & name: QualifiedName & options: OptionsWith?
	  & "AS"i & q: DirectSelect
		=> @(new Statement.ViewDefinition(name, null, q, options, false, true))
	| "VIEW"i & name: QualifiedName & ('(' & columns: ColumnList & ')')? & options: RoutineOptions?
	  & "AS"i & q: DirectSelect & check: ("WITH"i & "CHECK"i & "OPTION"i)?
		=> @(new Statement.ViewDefinition(name, columns, q, options, check is not null))

// ── Indexes ─────────────────────────────────────────────────────────────────
//
// Almost all of it was already written: an index inside a `CREATE TABLE` is the same
// thing said in the same words, so the columns, the options, the placement and the
// filter are shared and only the header is new.
CreateIndexStatement : @Statement
	= "CREATE"i & "SELECTIVE"i & "XML"i & "INDEX"i & name: Identifier?
	  & "ON"i & on: QualifiedName & '(' & promoted: ColumnList & ')'
	  & tail: (("WITH"i & XmlNamespaces)? & SelectivePaths) & o: IndexWith?
		=> @(new Statement.CreateIndex(
				 on, Clause.Indexed(name ?? "", null, null, null, null, Syntax.Columns(promoted), null, null, null, o, null, null),
				 "SELECTIVE XML", Syntax.Tail(tail)))
	| "CREATE"i & kind: ("PRIMARY"i? & "XML"i) & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: IndexColumns
	  & over: XmlIndexUsing? & o: IndexWith?
		=> @(new Statement.CreateIndex(
				 on, Clause.Indexed(name, null, null, null, null, columns, null, null, null, o, null, null),
				 Syntax.Squared(kind), Syntax.Tail(over)))
	| "CREATE"i & u: "UNIQUE"i? & k: IndexOrder? & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: IndexColumns
	  & ("INCLUDE"i & '(' & include: ColumnList & ')')?
	  & ("WHERE"i & filter: SearchCondition)?
	  & o: IndexWith? & p: IndexOn? & ("FILESTREAM_ON"i & f: PlacementTarget)?
		=> @(new Statement.CreateIndex(on, Clause.Indexed(name, u, k, null, null, columns, null, include, filter, o, (Clause.Placement?)p, f is null ? null : f with { Kind = "FILESTREAM_ON" })))
	| "CREATE"i & k: IndexOrder? & s: "COLUMNSTORE"i & "INDEX"i & name: Identifier
	  & "ON"i & on: QualifiedName & columns: IndexColumns?
	  & ("ORDER"i & '(' & order: ColumnList & ')')?
	  & ("WHERE"i & filter: SearchCondition)?
	  & o: IndexWith? & p: IndexOn?
		=> @(new Statement.CreateIndex(on, Clause.Indexed(name, null, k, s, null, columns, order, null, filter, o, (Clause.Placement?)p, null)))

// `ALTER INDEX` names one index or all of them, and then says what to do.
AlterIndexStatement : @Statement
	= "ALTER"i & "INDEX"i & name: IndexTarget & "ON"i & on: QualifiedName
	  & ("WITH"i & ns: XmlNamespaces)? & paths: SelectivePaths & o: IndexWith?
		=> @(new Statement.AlterIndex(name, on, "FOR", null, o, paths, ns))
	| "ALTER"i & "INDEX"i & name: IndexTarget & "ON"i & on: QualifiedName & a: AlterIndexAction
		=> @(a with { Name = name, On = on })

IndexTarget : @string = "ALL"i => @("ALL") | t: Identifier => @(t)

XmlIndexUsing = "USING"i & "XML"i & "INDEX"i & Identifier & ("FOR"i & word)?

// `FOR ( name = '/a/b' AS XQUERY 'xs:double' MAXLENGTH (200) SINGLETON, … )`, and the
// three ways `ALTER INDEX` changes one of them.
SelectivePaths : @string[]
	= "FOR"i & '(' & first: SelectivePath & (',' & rest: SelectivePath)* & ')'
		=> @(Syntax.Named(first, rest))

// Each path as it was written: what it promotes, its XQuery type, its length, its
// cardinality — a small language of its own that the tree keeps whole.
SelectivePath : @string
	= t: ("ADD"i & PromotedPath
		  | "ALTER"i & "PATH"i & PromotedPath
		  | "REMOVE"i & Identifier
		  | PromotedPath) => @(t)

PromotedPath : @string
	= name: Identifier & '=' & path: Sql92.Lexical.CharacterStringLiteral & PathHint*
		=> @(name)
	| path: Sql92.Lexical.CharacterStringLiteral & PathHint*
		=> @(path)

PathHint = "AS"i & "XQUERY"i & Sql92.Lexical.CharacterStringLiteral? & PathLength?
		 | "AS"i & "SQL"i & DataType
		 | "SINGLETON"i
		 | "AS"i & word

PathLength = "MAXLENGTH"i & '(' & Sql92.Lexical.UnsignedNumericLiteral & ')'

AlterIndexAction : @Statement.AlterIndex
	= "REBUILD"i & ("PARTITION"i & '=' & p: PartitionWhich)? & o: IndexWith?
		=> @(new Statement.AlterIndex("", "", "REBUILD", p, o))
	| "REORGANIZE"i & ("PARTITION"i & '=' & p: PartitionWhich)? & o: IndexWith?
		=> @(new Statement.AlterIndex("", "", "REORGANIZE", p, o))
	| "DISABLE"i => @(new Statement.AlterIndex("", "", "DISABLE"))
	| "PAUSE"i   => @(new Statement.AlterIndex("", "", "PAUSE"))
	| "ABORT"i   => @(new Statement.AlterIndex("", "", "ABORT"))
	| "RESUME"i & o: IndexWith? => @(new Statement.AlterIndex("", "", "RESUME", null, o))
	| "SET"i & '(' & o: OptionList & ')' => @(new Statement.AlterIndex("", "", "SET", null, o))

// ── The keys, and what is locked with them ──────────────────────────────────
//
// Seventeen published blocks and one idea running through them: a key is made from
// somewhere, locked by something, and the something is a certificate, a password or another
// key. `ENCRYPTION BY` is written in six of the seventeen and reads the same in all six, so
// it is one rule.
KeyStatement : @Statement
	= "CREATE"i & "ASYMMETRIC"i & "KEY"i & name: Identifier
	  & tail: (Authorization? & ("FROM"i & AsymmetricSource)? & ("WITH"i & OptionList)? & EncryptionBy?)
		=> @(Statement.Defined("ASYMMETRIC KEY", name, Syntax.Tail(tail)))
	| "ALTER"i & "ASYMMETRIC"i & "KEY"i & name: Identifier & tail: KeyChange
		=> @(Statement.Defined("ALTER ASYMMETRIC KEY", name, Syntax.Tail(tail)))

	| "CREATE"i & "SYMMETRIC"i & "KEY"i & name: Identifier
	  & tail: (Authorization? & ("FROM"i & "PROVIDER"i & Identifier)?
			   & "WITH"i & SymmetricOption & (','? & SymmetricOption)*)
		=> @(Statement.Defined("SYMMETRIC KEY", name, Syntax.Tail(tail)))
	| "ALTER"i & "SYMMETRIC"i & "KEY"i & name: Identifier
	  & tail: (AddOrDrop & "ENCRYPTION"i & "BY"i & Encryptor & (',' & Encryptor)*)
		=> @(Statement.Defined("ALTER SYMMETRIC KEY", name, Syntax.Tail(tail)))

	| "CREATE"i & "CERTIFICATE"i & name: Identifier
	  & tail: (Authorization? & CertificateBody & ("ACTIVE"i & "FOR"i & "BEGIN_DIALOG"i & '=' & OnOff)?)
		=> @(Statement.Defined("CERTIFICATE", name, Syntax.Tail(tail)))
	| "ALTER"i & "CERTIFICATE"i & name: Identifier & tail: CertificateChange
		=> @(Statement.Defined("ALTER CERTIFICATE", name, Syntax.Tail(tail)))

	| "CREATE"i & "MASTER"i & "KEY"i & tail: EncryptionBy?
		=> @(Statement.Defined("MASTER KEY", "", Syntax.Tail(tail)))
	| "ALTER"i & "MASTER"i & "KEY"i & tail: MasterKeyChange
		=> @(Statement.Defined("ALTER MASTER KEY", "", Syntax.Tail(tail)))

	| "CREATE"i & "DATABASE"i & "ENCRYPTION"i & "KEY"i
	  & tail: (("WITH"i & OptionList)? & EncryptionBy?)
		=> @(Statement.Defined("DATABASE ENCRYPTION KEY", "", Syntax.Tail(tail)))
	| "ALTER"i & "DATABASE"i & "ENCRYPTION"i & "KEY"i
	  & tail: (("REGENERATE"i & "WITH"i & OptionList)? & EncryptionBy?)
		=> @(Statement.Defined("ALTER DATABASE ENCRYPTION KEY", "", Syntax.Tail(tail)))

	| "CREATE"i & "COLUMN"i & "ENCRYPTION"i & "KEY"i & name: Identifier
	  & tail: ("WITH"i & "VALUES"i & '(' & OptionList & ')' & (',' & '(' & OptionList & ')')*)
		=> @(Statement.Defined("COLUMN ENCRYPTION KEY", name, Syntax.Tail(tail)))
	| "ALTER"i & "COLUMN"i & "ENCRYPTION"i & "KEY"i & name: Identifier
	  & tail: (AddOrDrop & "VALUE"i & '(' & OptionList & ')')
		=> @(Statement.Defined("ALTER COLUMN ENCRYPTION KEY", name, Syntax.Tail(tail)))
	| "CREATE"i & "COLUMN"i & "MASTER"i & "KEY"i & name: Identifier & tail: OptionsWithText
		=> @(Statement.Defined("COLUMN MASTER KEY", name, Syntax.Tail(tail)))

	| verb: CreateOrAlter & "CREDENTIAL"i & name: Identifier
	  & tail: ("WITH"i & OptionList & ("FOR"i & "CRYPTOGRAPHIC"i & "PROVIDER"i & Identifier)?)
		=> @(Statement.Defined("CREDENTIAL", name, Syntax.Tail(tail), verb))
	| verb: CreateOrAlter & "DATABASE"i & "SCOPED"i & "CREDENTIAL"i & name: Identifier
	  & tail: ("WITH"i & OptionList)
		=> @(Statement.Defined("DATABASE SCOPED CREDENTIAL", name, Syntax.Tail(tail), verb))

	// A security policy is a list of predicates rather than a list of settings, and each
	// predicate names a function, the table it guards, and when it fires.
	| verb: CreateOrAlter & "SECURITY"i & "POLICY"i & name: QualifiedName
	  & tail: (PolicyPredicates? & OptionsWith? & NotForReplication?)
		=> @(Statement.Defined("SECURITY POLICY", name, Syntax.Tail(tail), verb))

Authorization     = "AUTHORIZATION"i & QualifiedName
NotForReplication = "NOT"i & "FOR"i & "REPLICATION"i

// `ENCRYPTION BY PASSWORD = 'p'`, `ENCRYPTION BY SERVER CERTIFICATE c`, and the two keys.
EncryptionBy = "ENCRYPTION"i & "BY"i & Encryptor

Encryptor = "PASSWORD"i & '=' & ValueExpression
		  | "SERVICE"i & "MASTER"i & "KEY"i
		  | "SERVER"i? & "CERTIFICATE"i & QualifiedName
		  | "SERVER"i? & "ASYMMETRIC"i & "KEY"i & QualifiedName
		  | "SYMMETRIC"i & "KEY"i & QualifiedName

AsymmetricSource = "EXECUTABLE"i? & "FILE"i & '=' & ValueExpression
				 | "ASSEMBLY"i & QualifiedName
				 | "PROVIDER"i & Identifier

// Its own list rather than the shared one: a key's options and its encryptions run on
// without commas, and an option's value is a run of words — so `ALGORITHM = AES_256
// ENCRYPTION BY PASSWORD = 'p'` had the value take three words that belonged to the clause
// after it. One word or one expression here, which is all the published block names.
SymmetricOption = "ENCRYPTION"i & "BY"i & Encryptor
				| word & '=' & SymmetricValue

SymmetricValue = v: ValueExpression | w: word

KeyChange = "REMOVE"i & "PRIVATE"i & "KEY"i
		  | "WITH"i & "PRIVATE"i & "KEY"i & '(' & PrivateKeyOption & (',' & PrivateKeyOption)* & ')'

MasterKeyChange = "REGENERATE"i & "WITH"i & EncryptionBy
				| "FORCE"i & "REGENERATE"i & "WITH"i & EncryptionBy
				| AddOrDrop & "ENCRYPTION"i & "BY"i & Encryptor

PrivateKeyOption = "DECRYPTION"i & "BY"i & "PASSWORD"i & '=' & ValueExpression
				 | "ENCRYPTION"i & "BY"i & "PASSWORD"i & '=' & ValueExpression
				 | OptionSetting

CertificateBody = "FROM"i & CertificateSource
				| EncryptionBy? & "WITH"i & OptionList

CertificateSource = "ASSEMBLY"i & QualifiedName
				  | "EXECUTABLE"i? & "FILE"i & '=' & ValueExpression & PrivateKeyWith?
				  | "BINARY"i & '=' & ValueExpression & PrivateKeyWith?

PrivateKeyWith = "WITH"i & ("FORMAT"i & '=' & ValueExpression & ',')? & "PRIVATE"i & "KEY"i
				 & '(' & PrivateKeyOption & (',' & PrivateKeyOption)* & ')'

CertificateChange = "REMOVE"i & "PRIVATE"i & "KEY"i
				  | "WITH"i & "PRIVATE"i & "KEY"i & '(' & PrivateKeyOption & (',' & PrivateKeyOption)* & ')'
				  | "WITH"i & "ACTIVE"i & "FOR"i & "BEGIN_DIALOG"i & '=' & OnOff

PolicyPredicates = PolicyPredicate & (',' & PolicyPredicate)*

PolicyPredicate = PolicyChange & PolicyKind? & "PREDICATE"i & QualifiedName
				  & '(' & Arguments? & ')' & "ON"i & QualifiedName & PolicyWhen?
				| "DROP"i & PolicyKind & "PREDICATE"i & "ON"i & QualifiedName

PolicyChange = "ADD"i | "ALTER"i
PolicyKind   = "FILTER"i | "BLOCK"i
PolicyWhen   = "AFTER"i & word | "BEFORE"i & word

// ── The full-text catalogue, and the index over it ──────────────────────────
//
// Eight published blocks. A full-text index is the one index with no name of its own — it
// is named by the table it is on, there being one per table — and the one whose columns
// carry a language and a type column beside them.
FullTextStatement : @Statement
	= "CREATE"i & "FULLTEXT"i & "INDEX"i & "ON"i & on: QualifiedName
	  & tail: (('(' & FullTextColumn & (',' & FullTextColumn)* & ')')?
			   & "KEY"i & "INDEX"i & Identifier & ("ON"i & FullTextCatalogOn)? & FullTextWith?)
		=> @(Statement.Defined("FULLTEXT INDEX", on, Syntax.Tail(tail)))
	| "ALTER"i & "FULLTEXT"i & "INDEX"i & "ON"i & on: QualifiedName & tail: FullTextAction
		=> @(Statement.Defined("ALTER FULLTEXT INDEX", on, Syntax.Tail(tail)))

	| "CREATE"i & "FULLTEXT"i & "CATALOG"i & name: Identifier
	  & tail: (("ON"i & "FILEGROUP"i & Identifier)? & ("IN"i & "PATH"i & ValueExpression)?
			   & ("WITH"i & OptionList)? & AsDefault? & ("AUTHORIZATION"i & QualifiedName)?)
		=> @(Statement.Defined("FULLTEXT CATALOG", name, Syntax.Tail(tail)))
	| "ALTER"i & "FULLTEXT"i & "CATALOG"i & name: Identifier & tail: FullTextCatalogAction
		=> @(Statement.Defined("ALTER FULLTEXT CATALOG", name, Syntax.Tail(tail)))

	| "CREATE"i & "FULLTEXT"i & "STOPLIST"i & name: Identifier
	  & tail: (StopListFrom? & ("AUTHORIZATION"i & QualifiedName)?)
		=> @(Statement.Defined("FULLTEXT STOPLIST", name, Syntax.Tail(tail)))
	| "ALTER"i & "FULLTEXT"i & "STOPLIST"i & name: Identifier & tail: StopListAction
		=> @(Statement.Defined("ALTER FULLTEXT STOPLIST", name, Syntax.Tail(tail)))

	| "CREATE"i & "SEARCH"i & "PROPERTY"i & "LIST"i & name: Identifier
	  & tail: (("FROM"i & QualifiedName)? & ("AUTHORIZATION"i & QualifiedName)?)
		=> @(Statement.Defined("SEARCH PROPERTY LIST", name, Syntax.Tail(tail)))
	| "ALTER"i & "SEARCH"i & "PROPERTY"i & "LIST"i & name: Identifier & tail: PropertyListAction
		=> @(Statement.Defined("ALTER SEARCH PROPERTY LIST", name, Syntax.Tail(tail)))

// Bracketed or not, which the published block writes one way and the corpus both.
FullTextWith = "WITH"i & '(' & OptionList & ')'
			 | "WITH"i & OptionList

AsDefault = "AS"i & "DEFAULT"i

FullTextColumn = Identifier & ("TYPE"i & "COLUMN"i & Identifier)?
			   & ("LANGUAGE"i & FullTextLanguage)? & "STATISTICAL_SEMANTICS"i?

// A language is named, numbered or quoted, and the syntax means all three.
FullTextLanguage = ValueExpression

FullTextCatalogOn = '(' & FullTextPlace & (',' & FullTextPlace)* & ')'
				  | Identifier

FullTextPlace = "FILEGROUP"i & Identifier | Identifier

FullTextAction
	= "ENABLE"i
	| "DISABLE"i
	| "SET"i & OptionList & NoPopulation?
	| "ADD"i & '(' & FullTextColumn & (',' & FullTextColumn)* & ')' & NoPopulation?
	| "ALTER"i & "COLUMN"i & Identifier & AddOrDrop & "STATISTICAL_SEMANTICS"i & NoPopulation?
	| "DROP"i & '(' & ColumnList & ')' & NoPopulation?
	| "START"i & word & "POPULATION"i
	| PopulationWord & "POPULATION"i

NoPopulation   = "WITH"i & "NO"i & "POPULATION"i
PopulationWord = "STOP"i | "PAUSE"i | "RESUME"i

FullTextCatalogAction = "REBUILD"i & ("WITH"i & OptionList)?
					  | "REORGANIZE"i
					  | AsDefault

StopListFrom = "FROM"i & "SYSTEM"i & "STOPLIST"i
			 | "FROM"i & QualifiedName

StopListAction = "ADD"i & ValueExpression & "LANGUAGE"i & FullTextLanguage
			   | "DROP"i & "ALL"i & ("LANGUAGE"i & FullTextLanguage)?
			   | "DROP"i & ValueExpression & "LANGUAGE"i & FullTextLanguage

PropertyListAction = "ADD"i & ValueExpression & OptionsWith
				   | "DROP"i & ValueExpression

// ── BACKUP and RESTORE ──────────────────────────────────────────────────────
//
// Two statements and one shape between them: what is being copied, the devices it is
// copied to or from, and a long option list. A device is a name or one of three words and
// a path, which is the only part of either that is not an option.
BackupStatement : @Statement
	= "BACKUP"i & what: BackupWhat & name: BackupTarget?
	  & tail: (BackupFiles* & "TO"i & BackupDevices & MirrorTo* & BackupWith?)
		=> @(Statement.BackedUp(what, name, Syntax.Tail(tail)))
	| "BACKUP"i & what: BackupKeyWhat & name: BackupName?
	  & tail: ("TO"i & "FILE"i & '=' & ValueExpression & KeyFileTail*)
		=> @(Statement.BackedUp(what, name, Syntax.Tail(tail)))

RestoreStatement : @Statement
	= "RESTORE"i & what: RestoreKeyWhat
	  & tail: ("FROM"i & "FILE"i & '=' & ValueExpression & KeyFileTail*)
		=> @(Statement.Restored(what, null, Syntax.Tail(tail)))
	| "RESTORE"i & what: RestoreWhat & name: BackupTarget?
	  & tail: (BackupFiles* & ("FROM"i & RestoreFrom)? & BackupWith?)
		=> @(Statement.Restored(what, name, Syntax.Tail(tail)))

RestoreKeyWhat : @string
	= "SERVICE"i & "MASTER"i & "KEY"i => @("SERVICE MASTER KEY")
	| "MASTER"i & "KEY"i              => @("MASTER KEY")

// What a key says on its way to a file and back: a password to lock it with, one to unlock
// it with, and the word that says to do it anyway.
KeyFileTail = "ENCRYPTION"i & "BY"i & "PASSWORD"i & '=' & ValueExpression
			| "DECRYPTION"i & "BY"i & "PASSWORD"i & '=' & ValueExpression
			| "FORCE"i

BackupWhat : @string
	= "DATABASE"i => @("DATABASE")
	| "LOG"i      => @("LOG")
	| "SERVER"i   => @("SERVER")
	| "GROUP"i    => @("GROUP")

BackupKeyWhat : @string
	= "CERTIFICATE"i               => @("CERTIFICATE")
	| "SERVICE"i & "MASTER"i & "KEY"i => @("SERVICE MASTER KEY")
	| "MASTER"i & "KEY"i           => @("MASTER KEY")
	| "SYMMETRIC"i & "KEY"i        => @("SYMMETRIC KEY")

RestoreWhat : @string
	= "DATABASE"i     => @("DATABASE")
	| "LOG"i          => @("LOG")
	| "FILELISTONLY"i => @("FILELISTONLY")
	| "HEADERONLY"i   => @("HEADERONLY")
	| "LABELONLY"i    => @("LABELONLY")
	| "REWINDONLY"i   => @("REWINDONLY")
	| "VERIFYONLY"i   => @("VERIFYONLY")

// What a database being copied is called, and what it is not: the four words that begin a
// file clause and the three that begin the clause after it. Without the lookahead the name
// takes the `FILE` of `BACKUP DATABASE FILE = 'f' TO …` and the statement is one word short
// for the rest of its length — which GRAM5009 said before anybody wrote that script.
BackupTarget : @string = ?!BackupBoundary & t: BackupName => @(t)

BackupBoundary = "FILE"i | "FILEGROUP"i | "READ_WRITE_FILEGROUPS"i | "PAGE"i
			   | "TO"i | "FROM"i | "WITH"i

BackupName : @string
	= t: QualifiedName                       => @(t)
	| t: Tsql.Variable                       => @(t)
	| t: Sql92.Lexical.CharacterStringLiteral => @(t)
	| '(' & first: BackupName & (',' & BackupName)* & ')' => @(first)

// The four the published syntax names, written out. An option's name is a run of words,
// so a rule that read one here would read `TO someDevice` and leave the statement with no
// device — the same trap an unbounded run always is.
BackupFiles = ','? & BackupFile

BackupFile = "FILE"i & '=' & BackupName
		   | "FILEGROUP"i & '=' & BackupName
		   | "READ_WRITE_FILEGROUPS"i
		   | "PAGE"i & '=' & ValueExpression

BackupDevices = BackupDevice & (',' & BackupDevice)*

BackupDevice = DeviceWord & '=' & ValueExpression
			 | QualifiedName
			 | Tsql.Variable

DeviceWord = "DISK"i | "TAPE"i | "URL"i

MirrorTo = "MIRROR"i & "TO"i & BackupDevices

RestoreFrom = "DATABASE_SNAPSHOT"i & '=' & QualifiedName
			| BackupDevices

// The option list, and the two options that are not a name and a value: a file moved from
// one path to another, and a mirrored device said again.
BackupWith = "WITH"i & BackupOption & (',' & BackupOption)*

BackupOption = "MOVE"i & ValueExpression & "TO"i & ValueExpression
			 | "STOPAT"i & '=' & ValueExpression
			 | "STOPATMARK"i & '=' & ValueExpression & ("AFTER"i & ValueExpression)?
			 | "STOPBEFOREMARK"i & '=' & ValueExpression & ("AFTER"i & ValueExpression)?
			 | OptionSetting

// ── What the server watches, and who it listens to ──────────────────────────
//
// Audits, extended-event sessions, event notifications and endpoints. Eleven published
// blocks and three shapes: a name and where its output goes, a list of things added and
// dropped, and a bracketed argument list per protocol.
AuditStatement : @Statement
	// A specification is a list of what is watched, added and dropped a bracket at a time.
	// In front of the audit it belongs to, since `ALTER SERVER AUDIT SPECIFICATION` begins
	// with `ALTER SERVER AUDIT` and every clause of an audit is optional — so the shorter
	// reading fits, and over kinds a reading that fits is the one that stands (§4).
	= verb: CreateOrAlter & scope: ServerOrDatabase & "AUDIT"i & "SPECIFICATION"i & name: Identifier
	  & tail: (("FOR"i & "SERVER"i & "AUDIT"i & QualifiedName)? & AuditAction* & OptionsWith?)
		=> @(Statement.Defined(
				 scope == "SERVER" ? "AUDIT SPECIFICATION" : "DATABASE AUDIT SPECIFICATION",
				 name, Syntax.Tail(tail), verb))

	| said: "CREATE"i & "SERVER"i & "AUDIT"i & name: Identifier
	  & tail: ("TO"i & AuditTarget & OptionsWith? & AuditWhere?)
		=> @(Statement.Defined("SERVER AUDIT", name, Syntax.Tail(tail), said))
	| said: "ALTER"i & "SERVER"i & "AUDIT"i & name: Identifier & tail: AlterAuditBody
		=> @(Statement.Defined("SERVER AUDIT", name, Syntax.Tail(tail), said))

	// An extended-event session: events, targets, and what to spend on them.
	| verb: CreateOrAlter & "EVENT"i & "SESSION"i & name: Identifier & "ON"i & on: ServerOrDatabase
	  & pieces: EventPieces? & options: OptionsWith? & ("STATE"i & '=' & status: word)?
		=> @(new Statement.EventSessionDefinition(name, verb, on, pieces, options, status))

	| "CREATE"i & "EVENT"i & "NOTIFICATION"i & name: Identifier
	  & tail: ("ON"i & NotificationScope & ("WITH"i & "FAN_IN"i)?
			   & "FOR"i & PermissionName & (',' & PermissionName)*
			   & "TO"i & "SERVICE"i & ValueExpression & (',' & ValueExpression)*)
		=> @(Statement.Defined("EVENT NOTIFICATION", name, Syntax.Tail(tail)))

	// An endpoint says how it is reached and what it speaks, and each is a bracket of
	// arguments belonging to that protocol rather than to this language.
	| verb: CreateOrAlter & "ENDPOINT"i & name: Identifier & ("AUTHORIZATION"i & owner: QualifiedName)?
	  & standing: EndpointState? & reached: EndpointAs? & spoken: EndpointFor?
		=> @(new Statement.EndpointDefinition(name, verb, owner,
				 standing?.Name, standing?.Options, reached?.Name, reached?.Options, spoken?.Name, spoken?.Options))

ServerOrDatabase : @string = "SERVER"i => @("SERVER") | "DATABASE"i => @("DATABASE")

NotificationScope = "QUEUE"i & QualifiedName | "SERVER"i | "DATABASE"i

// ── An audit ────────────────────────────────────────────────────────────────
AuditTarget = "FILE"i & '(' & OptionList & ')'
			| word

AuditWhere = "WHERE"i & SearchCondition

AlterAuditBody = "REMOVE"i & "WHERE"i
			   | "MODIFY"i & "NAME"i & '=' & Identifier
			   | ("TO"i & AuditTarget)? & OptionsWith? & AuditWhere?

// `ADD (SELECT ON t BY dbo)`, `DROP (DATABASE_PERMISSION_CHANGE_GROUP)`. The comma between
// two of them is optional in the corpus and required in the block, so it is read as neither.
AuditAction = AddOrDrop & '(' & AuditActionBody & ')' & ','?

AddOrDrop = "ADD"i | "DROP"i

AuditActionBody = PermissionName & (',' & PermissionName)* & AuditActionOn?

AuditActionOn = "ON"i & SecurableClass? & QualifiedName & "BY"i & Principals

// ── An extended-event session ───────────────────────────────────────────────
EventPieces : @Clause[] = first: EventPiece & (','? & rest: EventPiece)* => @(Syntax.Listed(first, rest))

EventPiece : @Clause
	= "ADD"i & "EVENT"i & name: QualifiedName & ('(' & body: EventBody & ')')?
		=> @((body ?? new Clause.EventPiece("", "")) with { Action = "ADD EVENT", Name = name })
	| "DROP"i & "EVENT"i & name: QualifiedName  => @(new Clause.EventPiece("DROP EVENT", name))
	| "ADD"i & "TARGET"i & name: QualifiedName & ('(' & "SET"i & set: OptionList & ')')?
		=> @(new Clause.EventPiece("ADD TARGET", name, set))
	| "DROP"i & "TARGET"i & name: QualifiedName => @(new Clause.EventPiece("DROP TARGET", name))

EventBody : @Clause.EventPiece
	= ("SET"i & set: OptionList)? & actions: EventActions? & ("WHERE"i & where: EventPredicate)?
		=> @(new Clause.EventPiece("", "", set, actions, where))

// Not a search condition. An event's predicate compares a field with a constant, and it
// also *calls* a comparison the package supplies — `sqlserver.equal_i_sql_unicode_string
// (field, N'x')` — which is a call standing where a condition goes and is not one anywhere
// else in this language. The comma joins two of them, as `AND` does.
EventPredicate : @string = t: (EventFactor & (EventJoin & EventFactor)*) => @(Syntax.Spaced(t))

EventJoin   = "AND"i | "OR"i | ','
EventFactor = "NOT"i? & EventTerm

EventTerm = '(' & EventPredicate & ')'
		  | name: QualifiedName & EventTermTail

EventTermTail = '(' & EventSource & ',' & ValueExpression & ')'
			  | EventCompare & ValueExpression

EventSource  = '(' & QualifiedName & ')' | QualifiedName
EventCompare = "<>" | "!=" | ">=" | "<=" | '=' | '>' | '<' | "NOT"i? & "LIKE"i

EventActions : @string[] = "ACTION"i & '(' & first: EventAction & (',' & rest: EventAction)* & ')' => @(Syntax.Named(first, rest))
EventAction  : @string   = t: QualifiedName => @(t)

// ── An endpoint ─────────────────────────────────────────────────────────────
// `STATE = STARTED, AFFINITY = NONE`: the published block names only the state and the
// corpus writes a list, so it is read as one.
EndpointState : @Clause.Option
	= "STATE"i & '=' & s: word & (',' & rest: OptionSetting)* => @(new Clause.Option(s, null, rest ?? Clause.None))

EndpointAs  : @Clause.Option = "AS"i  & w: word & '(' & o: OptionList? & ')' => @(new Clause.Option(w, null, o ?? Clause.None))
EndpointFor : @Clause.Option = "FOR"i & w: word & '(' & o: OptionList? & ')' => @(new Clause.Option(w, null, o ?? Clause.None))

// ── What lives outside the database, and what the server spends on it ───────
//
// External data sources, file formats, tables and libraries; resource pools and workload
// groups; statistics. Fourteen published blocks and almost all of them are a name and an
// option list — which is the shape this grammar has been reading since `CREATE TABLE`.
// What is new is four clauses that are not a name and a value.
ExternalStatement : @Statement
	= verb: CreateOrAlter & "EXTERNAL"i & "DATA"i & "SOURCE"i & name: Identifier & tail: DataSourceBody
		=> @(Statement.Defined("EXTERNAL DATA SOURCE", name, Syntax.Tail(tail), verb))
	| "CREATE"i & "EXTERNAL"i & "FILE"i & "FORMAT"i & name: Identifier & tail: OptionsWithText
		=> @(Statement.Defined("EXTERNAL FILE FORMAT", name, Syntax.Tail(tail)))

	// A table of somebody else's rows: the columns as this grammar reads any columns, and
	// then where they are. Synapse writes the query instead and lets it say the columns.
	| "CREATE"i & "EXTERNAL"i & "TABLE"i & name: QualifiedName & '(' & body: TableBody & ')'
	  & options: OptionsWith
		=> @(new Statement.TableDefinition(name, null, body, Clause.None, options, true))
	| "CREATE"i & "EXTERNAL"i & "TABLE"i & name: QualifiedName & options: OptionsWith
	  & "AS"i & q: DirectSelect
		=> @(new Statement.CreateTableAsSelect(name, null, options, q, true))

	| said: "CREATE"i & "EXTERNAL"i & "LIBRARY"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & QualifiedName)?
			   & "FROM"i & LibraryFile & (',' & LibraryFile)* & OptionsWith?)
		=> @(Statement.Defined("EXTERNAL LIBRARY", name, Syntax.Tail(tail), said))
	| said: "ALTER"i & "EXTERNAL"i & "LIBRARY"i & name: Identifier
	  & tail: (("AUTHORIZATION"i & QualifiedName)?
			   & LibraryChange & LibraryFile & (',' & LibraryFile)* & OptionsWith?)
		=> @(Statement.Defined("EXTERNAL LIBRARY", name, Syntax.Tail(tail), said))

	| verb: CreateOrAlter & "EXTERNAL"i & "RESOURCE"i & "POOL"i & pool: PoolName & tail: OptionsWithText?
		=> @(Statement.Defined("EXTERNAL RESOURCE POOL", pool, Syntax.Tail(tail), verb))
	| verb: CreateOrAlter & "RESOURCE"i & "POOL"i & pool: PoolName & tail: OptionsWithText?
		=> @(Statement.Defined("RESOURCE POOL", pool, Syntax.Tail(tail), verb))
	| verb: CreateOrAlter & "WORKLOAD"i & "GROUP"i & pool: PoolName
	  & tail: (OptionsWithText? & ("USING"i & WorkloadPool & (',' & WorkloadPool)*)?)
		=> @(Statement.Defined("WORKLOAD GROUP", pool, Syntax.Tail(tail), verb))

	// Statistics: a name, what they are on, and how they are gathered. `SAMPLE 50 PERCENT`
	// is three words where an option is usually a name and a value, and the option list
	// reads it as one name — which is what a run of words is for (§4.6).
	| "CREATE"i & "STATISTICS"i & name: Identifier
	  & tail: ("ON"i & QualifiedName & IndexColumns & ("WHERE"i & SearchCondition)? & StatisticsWith?)
		=> @(new Statement.StatisticsDefinition(name) { Tail = Syntax.Tail(tail) })
	| "UPDATE"i & "STATISTICS"i & on: QualifiedName & tail: (StatisticsTarget? & StatisticsWith?)
		=> @(new Statement.UpdateStatistics(on) { Tail = Syntax.Tail(tail) })

CreateOrAlter : @string = "CREATE"i => @("CREATE") | "ALTER"i => @("ALTER")

// `"default"` is a pool, and a delimited name is how the syntax says so.
PoolName : @string = t: Identifier => @(t) | t: Sql92.Lexical.CharacterStringLiteral => @(t)

WorkloadPool = "EXTERNAL"i? & PoolName

DataSourceBody = OptionsWith
			   | "SET"i & OptionList

LibraryChange = "SET"i | "ADD"i
LibraryFile   = '(' & OptionList & ')'

StatisticsWith = "WITH"i & OptionList

StatisticsTarget = '(' & IndexName & (',' & IndexName)* & ')'
				 | IndexName

// ── Who may connect, and as whom ────────────────────────────────────────────
//
// Logins, users, roles and schemas. One family because they are one shape: a name, where
// it came from, and a list of settings — and the settings are the option list already
// written, with one exception that the published syntax insists on.
//
// The exception is a password. `PASSWORD = 'p' OLD_PASSWORD = 'q' MUST_CHANGE` is three
// things and no commas between them, which is the only place in T-SQL where an option list
// runs on like that. So the password is a rule and the rest of the list is the ordinary one.
PrincipalStatement : @Statement
	= "CREATE"i & "LOGIN"i & name: Identifier & tail: LoginBody
		=> @(Statement.Defined("CREATE LOGIN", name, Syntax.Tail(tail)))
	| "ALTER"i & "LOGIN"i & name: Identifier & tail: AlterLoginBody
		=> @(Statement.Defined("ALTER LOGIN", name, Syntax.Tail(tail)))

	| "CREATE"i & "USER"i & name: Identifier & tail: (UserSource? & UserOptions?)
		=> @(Statement.Defined("CREATE USER", name, Syntax.Tail(tail)))
	| "ALTER"i & "USER"i & name: Identifier & tail: AlterUserBody
		=> @(Statement.Defined("ALTER USER", name, Syntax.Tail(tail)))

	| "CREATE"i & scope: RoleWord & name: Identifier & tail: ("AUTHORIZATION"i & QualifiedName)?
		=> @(Statement.Defined(
				 Syntax.Squared(scope) == "ROLE" ? "CREATE ROLE" : "CREATE SERVER ROLE",
				 name, Syntax.Tail(tail)))
	| "ALTER"i & scope: RoleWord & name: Identifier & tail: RoleAction
		=> @(Statement.Defined(
				 Syntax.Squared(scope) == "ROLE" ? "ALTER ROLE" : "ALTER SERVER ROLE",
				 name, Syntax.Tail(tail)))

	| "CREATE"i & "APPLICATION"i & "ROLE"i & name: Identifier & tail: ("WITH"i & LoginOptions)
		=> @(Statement.Defined("CREATE APPLICATION ROLE", name, Syntax.Tail(tail)))
	| "ALTER"i & "APPLICATION"i & "ROLE"i & name: Identifier & tail: ("WITH"i & LoginOptions)
		=> @(Statement.Defined("ALTER APPLICATION ROLE", name, Syntax.Tail(tail)))

	// A schema may be declared by its owner alone — `CREATE SCHEMA AUTHORIZATION dbo` — and
	// what follows it is not a clause but whole statements, which is the one statement in
	// T-SQL that holds others without a `BEGIN`.
	| "CREATE"i & "SCHEMA"i & name: Identifier
	  & tail: ("AUTHORIZATION"i & QualifiedName & SchemaElement*)
		=> @(Statement.Defined("CREATE SCHEMA", name, Syntax.Tail(tail)))
	| "CREATE"i & "SCHEMA"i & tail: ("AUTHORIZATION"i & QualifiedName & SchemaElement*)
		=> @(Statement.Defined("CREATE SCHEMA", "", Syntax.Tail(tail)))
	| "CREATE"i & "SCHEMA"i & name: Identifier & tail: (SchemaElement*)
		=> @(Statement.Defined("CREATE SCHEMA", name, Syntax.Tail(tail)))
	| "ALTER"i & "SCHEMA"i & name: Identifier
	  & tail: ("TRANSFER"i & SecurableClass? & QualifiedName)
		=> @(Statement.Defined("ALTER SCHEMA", name, Syntax.Tail(tail)))

	| "ALTER"i & "AUTHORIZATION"i & tail: ("ON"i & SecurableClass? & QualifiedName
										  & "TO"i & AuthorizationTo)
		=> @(Statement.Defined("ALTER AUTHORIZATION", "", Syntax.Tail(tail)))

RoleWord : @string = t: ("SERVER"i & "ROLE"i | "ROLE"i) => @(Syntax.Squared(t))

RoleAction = "ADD"i & "MEMBER"i & QualifiedName
		   | "DROP"i & "MEMBER"i & QualifiedName
		   | "WITH"i & "NAME"i & '=' & QualifiedName

AuthorizationTo = "SCHEMA"i & "OWNER"i | QualifiedName

// What a schema declares in the same breath as itself. The published list is exactly these
// five, and each is the whole statement it is elsewhere.
SchemaElement = s: CreateTableStatement | s: CreateRoutine | s: PermissionStatement

// ── A login ─────────────────────────────────────────────────────────────────
LoginBody = "WITH"i & LoginOptions
		  | "FROM"i & LoginSource

LoginSource = "WINDOWS"i & ("WITH"i & OptionList)?
			| "EXTERNAL"i & "PROVIDER"i & ("WITH"i & OptionList)?
			| "CERTIFICATE"i & QualifiedName & ("WITH"i & OptionList)?
			| "ASYMMETRIC"i & "KEY"i & QualifiedName & ("WITH"i & OptionList)?

AlterLoginBody = "ENABLE"i
			   | "DISABLE"i
			   | "WITH"i & LoginOptions
			   | "ADD"i & "CREDENTIAL"i & QualifiedName
			   | "DROP"i & "CREDENTIAL"i & QualifiedName

LoginOptions = LoginOption & (',' & LoginOption)*

// `PASSWORD = 0x0100 HASHED MUST_CHANGE`, `PASSWORD = 'p' OLD_PASSWORD = 'q'`: a password
// and then however many words and pairs the syntax lets follow it, none of them separated
// by a comma. `NO CREDENTIAL` is two words and no value, which the option list reads as one
// name — but it is written here because the list this belongs to is not that one.
LoginOption = "PASSWORD"i & '=' & ValueExpression & PasswordTail*
			| "NO"i & "CREDENTIAL"i
			| OptionSetting

PasswordTail = "OLD_PASSWORD"i & '=' & ValueExpression
			 | "MUST_CHANGE"i
			 | "UNLOCK"i
			 | "HASHED"i

// ── A user ──────────────────────────────────────────────────────────────────
UserSource = ForOrFrom & UserFrom
		   | "WITHOUT"i & "LOGIN"i

UserFrom = "LOGIN"i & QualifiedName
		 | "CERTIFICATE"i & QualifiedName
		 | "ASYMMETRIC"i & "KEY"i & QualifiedName
		 | "EXTERNAL"i & "PROVIDER"i & ("WITH"i & OptionList)?

ForOrFrom = "FOR"i | "FROM"i

UserOptions = "WITH"i & LoginOptions

AlterUserBody = "WITH"i & LoginOptions
			  | UserSource

// ── DROP ────────────────────────────────────────────────────────────────────
//
// Sixty-six statements in the reference and one shape: `DROP <what> [ IF EXISTS ] <names>`,
// with a clause after it for the five that have one. Written from the sixty-six published
// blocks, which agree about everything but the words in the middle.
//
// Those words are written out, and here that is the syntax rather than a catalogue: `DROP
// TABLE` and `DROP VIEW` are different statements, `DROP DATABASE ENCRYPTION KEY` names no
// object at all, and a rule wide enough for any word would read `DROP FOO x` and call it
// one of them. The order is the one the words force — `DATABASE AUDIT SPECIFICATION`
// before `DATABASE`, `SERVER AUDIT SPECIFICATION` before `SERVER AUDIT` before `SERVER
// ROLE` — since ordered choice reads the first that fits.
DropStatement : @Statement
	= "DROP"i & d: DropBody => @(d)

DropBody : @Statement
	// The five that name something and then say where it is or what to do about it.
	= what: DropKeyKind & exists: IfExists? & names: DropNames
	  & tail: ("REMOVE"i & "PROVIDER"i & "KEY"i)?
		=> @(Statement.Dropped(what, names, tail, exists))
	| "ASSEMBLY"i & exists: IfExists? & names: DropNames
	  & tail: ("WITH"i & "NO"i & "DEPENDENTS"i)?
		=> @(Statement.Dropped("ASSEMBLY", names, tail, exists))
	| "EXTERNAL"i & "LIBRARY"i & names: DropNames & tail: ("AUTHORIZATION"i & QualifiedName)?
		=> @(Statement.Dropped("EXTERNAL LIBRARY", names, tail))
	| "EVENT"i & "SESSION"i & names: DropNames & tail: ("ON"i & DropScope)
		=> @(Statement.Dropped("EVENT SESSION", names, tail))
	| "EVENT"i & "NOTIFICATION"i & names: DropNames & tail: ("ON"i & DropScope)
		=> @(Statement.Dropped("EVENT NOTIFICATION", names, tail))

	// An index is named twice — once for itself and once for what it is on — and the older
	// spelling puts both in one qualified name.
	| "FULLTEXT"i & "INDEX"i & "ON"i & on: DropName
		=> @(Statement.Dropped("FULLTEXT INDEX", new Expression[] { on }))
	| "INDEX"i & exists: IfExists? & first: DropIndexName & (',' & rest: DropIndexName)*
		=> @(Statement.Dropped("INDEX", Syntax.Listed(first, rest), null, exists))

	// A signature is dropped off a module rather than by its own name, and a sensitivity
	// classification off a column.
	| counter: "COUNTER"i? & "SIGNATURE"i & "FROM"i & from: QualifiedName & "BY"i
	  & first: DropCrypto & (',' & rest: DropCrypto)*
		=> @(new Statement.DropSignature(Syntax.Listed(first, rest), from, counter is not null))
	| "SENSITIVITY"i & "CLASSIFICATION"i & from: "FROM"i & names: DropNames
		=> @(Statement.Dropped("SENSITIVITY CLASSIFICATION", names))

	// A trigger says which of the three kinds it is by what it is on.
	| "TRIGGER"i & exists: IfExists? & names: DropNames & tail: ("ON"i & DropScope)?
		=> @(Statement.Dropped("TRIGGER", names, tail, exists))

	// The two that name nothing: there is one of each per database.
	| what: DropOnlyKind
		=> @(Statement.Dropped(what, Expression.None))

	| what: DropKind & exists: IfExists? & names: DropNames
		=> @(Statement.Dropped(what, names, null, exists))

DropNames : @Expression[]
	= first: DropName & (',' & rest: DropName)* => @(Syntax.Listed(first, rest))

DropName : @Expression = t: QualifiedName => @(new Expression.ColumnReference(t))

DropIndexName : @Expression
	= t: (Identifier & "ON"i & QualifiedName & OptionsWith?) => @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| t: QualifiedName                                       => @(new Expression.ColumnReference(t))

DropCrypto : @Expression
	= t: ("CERTIFICATE"i & QualifiedName)         => @(new Expression.ColumnReference(Syntax.Spaced(t)))
	| t: ("ASYMMETRIC"i & "KEY"i & QualifiedName) => @(new Expression.ColumnReference(Syntax.Spaced(t)))

DropScope = "ALL"i & "SERVER"i | "SERVER"i | "DATABASE"i | "QUEUE"i & QualifiedName

DropKeyKind  = "ASYMMETRIC"i & "KEY"i | "SYMMETRIC"i & "KEY"i
DropOnlyKind = "MASTER"i & "KEY"i | "DATABASE"i & "ENCRYPTION"i & "KEY"i

// The rest, longest first where one name begins another.
DropKind
	= "AGGREGATE"i
	| "APPLICATION"i & "ROLE"i
	| "AVAILABILITY"i & "GROUP"i
	| "BROKER"i & "PRIORITY"i
	| "CERTIFICATE"i
	| "COLUMN"i & "ENCRYPTION"i & "KEY"i
	| "COLUMN"i & "MASTER"i & "KEY"i
	| "CONTRACT"i
	| "CREDENTIAL"i
	| "CRYPTOGRAPHIC"i & "PROVIDER"i
	| "DATABASE"i & "AUDIT"i & "SPECIFICATION"i
	| "DATABASE"i & "SCOPED"i & "CREDENTIAL"i
	| "DATABASE"i
	| "DEFAULT"i
	| "ENDPOINT"i
	| "EXTERNAL"i & "DATA"i & "SOURCE"i
	| "EXTERNAL"i & "FILE"i & "FORMAT"i
	| "EXTERNAL"i & "LANGUAGE"i
	| "EXTERNAL"i & "MODEL"i
	| "EXTERNAL"i & "RESOURCE"i & "POOL"i
	| "EXTERNAL"i & "TABLE"i
	| "FULLTEXT"i & "CATALOG"i
	| "FULLTEXT"i & "STOPLIST"i
	| "FUNCTION"i
	| "LOGIN"i
	| "MESSAGE"i & "TYPE"i
	| "PARTITION"i & "FUNCTION"i
	| "PARTITION"i & "SCHEME"i
	| "PROCEDURE"i
	| "PROC"i
	| "QUEUE"i
	| "REMOTE"i & "SERVICE"i & "BINDING"i
	| "RESOURCE"i & "POOL"i
	| "ROLE"i
	| "ROUTE"i
	| "RULE"i
	| "SCHEMA"i
	| "SEARCH"i & "PROPERTY"i & "LIST"i
	| "SECURITY"i & "POLICY"i
	| "SEQUENCE"i
	| "SERVER"i & "AUDIT"i & "SPECIFICATION"i
	| "SERVER"i & "AUDIT"i
	| "SERVER"i & "ROLE"i
	| "SERVICE"i
	| "STATISTICS"i
	| "SYNONYM"i
	| "TABLE"i
	| "TYPE"i
	| "USER"i
	| "VIEW"i
	| "WORKLOAD"i & "CLASSIFIER"i
	| "WORKLOAD"i & "GROUP"i
	| "XML"i & "SCHEMA"i & "COLLECTION"i

// ── The database ────────────────────────────────────────────────────────────
//
// The largest thing left in the corpus — `ALTER DATABASE … SET` alone is 252 statements —
// and almost none of it is new. A database's settings are said the way an index's and a
// table's are, so the option list already written reads them; a file specification is that
// same list in brackets. What is new is the header and about thirty lines.
//
// The settings themselves are not enumerated and are not going to be. There are some two
// hundred of them, they differ by edition and by version, and none of that is syntax: a
// setting is a run of words and then, sometimes, what it is set to.
CreateDatabaseStatement : @Statement
	= "CREATE"i & "DATABASE"i & name: Identifier & '(' & options: OptionList & ')'
		=> @(new Statement.CreateDatabase(name, Clause.None, Tail: "", Options: options))
	| "CREATE"i & "DATABASE"i & name: Identifier & ("CONTAINMENT"i & '=' & containment: word)?
	  & files: DatabaseFiles? & ("COLLATE"i & collation: QualifiedName)? & tail: DatabaseTail?
		=> @((tail ?? new Statement.CreateDatabase("", Clause.None)) with
			 {
				 Name = name, Containment = containment, Collation = collation,
				 Files = files?.Files ?? Clause.None, Primary = files?.Primary ?? false, Log = files?.Log,
			 })

// What a database may be made out of instead of nothing: another database, a snapshot of
// one, or files that already exist. Each is the tail's words, and then the bracket and the
// `WITH` it may carry.
DatabaseTail : @Statement.CreateDatabase
	= "WITH"i & with: OptionList
		=> @(new Statement.CreateDatabase("", Clause.None, With: with))
	| "FOR"i & "ATTACH"i & ('(' & options: OptionList & ')')? & ("WITH"i & with: OptionList)?
		=> @(new Statement.CreateDatabase("", Clause.None, Tail: "FOR ATTACH", Options: options, With: with))
	| "FOR"i & "ATTACH_REBUILD_LOG"i
		=> @(new Statement.CreateDatabase("", Clause.None, Tail: "FOR ATTACH_REBUILD_LOG"))
	| t: ("AS"i & "SNAPSHOT"i & "OF"i & Identifier)
		=> @(new Statement.CreateDatabase("", Clause.None, Tail: Syntax.Spaced(t)))
	| t: ("AS"i & "COPY"i & "OF"i & QualifiedName) & ('(' & options: OptionList & ')')?
		=> @(new Statement.CreateDatabase("", Clause.None, Tail: Syntax.Spaced(t), Options: options))

// ── The files ───────────────────────────────────────────────────────────────
//
// A file specification is `( NAME = …, FILENAME = …, SIZE = 100 MB )`, which is an option
// list with a unit after the number — and that unit is why an option's value ends with a
// word: `100 MB`, `3 DAYS`, `10 %` are each one value in this language.
DatabaseFiles : @Statement.CreateDatabase
	= "ON"i & primary: "PRIMARY"i? & first: FileGroupSpec & (',' & rest: FileGroupSpec)*
	  & log: DatabaseLogFiles?
		=> @(new Statement.CreateDatabase("", Syntax.Listed(first, rest), primary is not null, log))

DatabaseLogFiles : @Clause[] = "LOG"i & "ON"i & first: FileSpec & (',' & rest: FileSpec)* => @(Syntax.Listed(first, rest))

FileGroupSpec : @Clause
	= "FILEGROUP"i & name: Identifier & ("CONTAINS"i & contains: word)? & fallback: "DEFAULT"i?
	  & first: FileSpec & (',' & rest: FileSpec)*
		=> @(new Clause.FileGroup(name, contains, fallback is not null, Syntax.Listed(first, rest)))
	| f: FileSpec => @(f)

FileSpec : @Clause = '(' & o: OptionList & ')' => @(new Clause.DatabaseFile(o))

FileGroupContains = "CONTAINS"i & word

// ── ALTER DATABASE ──────────────────────────────────────────────────────────
//
// `SCOPED CONFIGURATION` stands in front because a database may be called `SCOPED`: the
// corpus has `ALTER DATABASE SCOPED COLLATE Estonian_CS_AS`, which is a database of that
// name and not a malformed configuration. Ordered choice reads the longer one first and
// gives it back when the words that must follow do not.
AlterDatabaseStatement : @Statement
	= "ALTER"i & "DATABASE"i & "SCOPED"i & "CONFIGURATION"i & secondary: ("FOR"i & "SECONDARY"i)?
	  & scoped: ScopedConfiguration
		=> @(scoped with { Secondary = secondary is not null })

	// The one action that keeps what it read, so the one written before the rest.
	| "ALTER"i & "DATABASE"i & name: DatabaseTarget
	  & "SET"i & first: DatabaseOption & (',' & rest: DatabaseOption)* & how: DatabaseTermination?
		=> @(new Statement.AlterDatabaseSet(name, Syntax.Listed(first, rest), how))

	// The one action with a body of its own: what is modified, and how the cutover goes.
	| "ALTER"i & "DATABASE"i & name: DatabaseTarget & "MODIFY"i & '(' & options: OptionList & ')'
	  & ("WITH"i & with: OptionList)? & DatabaseTermination?
		=> @(new Statement.AlterDatabaseModify(name, options, with))

	| "ALTER"i & "DATABASE"i & name: DatabaseTarget & action: AlterDatabaseAction
	  & how: DatabaseTermination?
		=> @(Statement.OfDatabase(
				 name, action.Action, null,
				 how is null ? action.Tail : action.Tail + " " + how))

DatabaseTarget : @string = "CURRENT"i => @("CURRENT") | t: Identifier => @(t)

ScopedConfiguration : @Statement.AlterDatabaseScopedConfiguration
	= "SET"i & first: DatabaseOption & (',' & rest: DatabaseOption)*
		=> @(new Statement.AlterDatabaseScopedConfiguration("", "SET", Syntax.Listed(first, rest)))
	| "CLEAR"i & "PROCEDURE_CACHE"i & handle: ValueExpression?
		=> @(new Statement.AlterDatabaseScopedConfiguration("", "CLEAR PROCEDURE_CACHE", Clause.None, false, handle))

// Which action was written, as the words the tree is keyed by. The statement builds the
// record; this says which record it is, because a rule cannot name a different type per
// alternative and the name is not known until the header above has been read.
// Which action, and what it was given — the action names the record and the rest is the
// words, as the catalogue wrote them.
AlterDatabaseAction : @Statement.AlterTable
	= "COLLATE"i & tail: QualifiedName => @(Statement.Altered("COLLATE", null, null, tail))
	| "MODIFY"i & m: DatabaseModify    => @(m)
	| "ADD"i    & a: DatabaseAdd       => @(a)
	| "REMOVE"i & r: DatabaseRemove    => @(r)

	// Two actions that are only a word. Written out, and this is a place where the words
	// are the syntax: `ALTER DATABASE d AUDIT SPECIFICATION s` is a different statement,
	// and a rule that read any word here would take it and call it this one.
	| "REBUILD"i & "LOG"i  => @(Statement.Altered("REBUILD LOG", null))
	| "PERFORM_CUTOVER"i   => @(Statement.Altered("PERFORM_CUTOVER", null))

DatabaseModify : @Statement.AlterTable
	= "NAME"i & tail: ('=' & Identifier)                  => @(Statement.Altered("MODIFY NAME", null, null, tail))
	| "FILEGROUP"i & tail: (Identifier & FileGroupAction) => @(Statement.Altered("MODIFY FILEGROUP", null, null, tail))
	| "FILE"i & tail: FileSpecText                        => @(Statement.Altered("MODIFY FILE", null, null, tail))
	| tail: ('(' & OptionList & ')' & ("WITH"i & OptionList)?)
		=> @(Statement.Altered("MODIFY", null, null, tail))

DatabaseAdd : @Statement.AlterTable
	= "FILEGROUP"i & tail: (Identifier & FileGroupContains?)
		=> @(Statement.Altered("ADD FILEGROUP", null, null, tail))
	| "LOG"i & "FILE"i & tail: (FileSpecText & (',' & FileSpecText)*)
		=> @(Statement.Altered("ADD LOG FILE", null, null, tail))
	| "FILE"i & tail: (FileSpecText & (',' & FileSpecText)* & ("TO"i & "FILEGROUP"i & Identifier)?)
		=> @(Statement.Altered("ADD FILE", null, null, tail))

DatabaseRemove : @Statement.AlterTable
	= "FILEGROUP"i & tail: Identifier => @(Statement.Altered("REMOVE FILEGROUP", null, null, tail))
	| "FILE"i & tail: Identifier      => @(Statement.Altered("REMOVE FILE", null, null, tail))

// A file specification read for its words rather than for its options.
FileSpecText = '(' & OptionList & ')'

// `READ_ONLY`, `READWRITE`, `AUTOGROW_ALL_FILES`, `AUTOGROW_SINGLE_FILE` — words, and a
// catalogue if written out.
FileGroupAction = "DEFAULT"i | "NAME"i & '=' & Identifier | word

// ── What a database is set to ───────────────────────────────────────────────
//
// One rule for all two hundred of them, and it is `word` (§4.6) that makes it one. A
// setting is a run of words — `MAXDOP`, `SINGLE_USER`, `HADR AVAILABILITY GROUP`,
// `QUERY_STORE CLEAR ALL` — and then what it is set to, where it is set to anything:
// `= 4`, `= ON (…)`, `ON`, `(AUTO_CLEANUP = ON)`, `= 42 SECONDS`.
//
// The run ends where the syntax says it does and not where a list of names would: `ON` and
// `OFF` are what a setting is set to rather than part of its name, and `WITH` begins the
// termination clause after the whole list. Without the lookahead the name would swallow
// the `WITH`, and the parse would then stop one word past what it ate.
DatabaseOption : @Clause
	= name: DatabaseOptionName & tail: DatabaseOptionValue?
		=> @(tail is null ? new Clause.Option(name, null, Clause.None) : tail with { Name = name })

DatabaseOptionName : @string = t: OptionName => @(t)

DatabaseOptionValue : @Clause.Option
	= '=' & n: OptionNest                   => @(new Clause.Option("", null, n))
	| '=' & v: OptionValue & n: OptionNest? => @(new Clause.Option("", v, n ?? Clause.None))
	| '(' & o: OptionList & ')'             => @(new Clause.Option("", null, o, null, true))
	| s: OnOff & n: OptionNest?             => @(new Clause.Option("", new Expression.ColumnReference(s), n ?? Clause.None, null, true))

DatabaseTermination : @string
	= t: ("WITH"i & "ROLLBACK"i & "AFTER"i & ValueExpression & "SECONDS"i?
		  | "WITH"i & "ROLLBACK"i & "IMMEDIATE"i
		  | "WITH"i & "NO_WAIT"i) => @(Syntax.Squared(t))

// ── Permissions ─────────────────────────────────────────────────────────────
//
// One shape, three statements, and the interesting part is that a permission's *name* is
// made of words T-SQL reserves — `ALTER ANY DATABASE`, `CREATE TABLE`, `VIEW DEFINITION`,
// `BACKUP LOG`. An identifier cannot be any of them, so the words are named, the same way
// the option names are and for the same reason: they are a catalogue rather than a
// language, and a permission added to SQL Server does not change this grammar.
PermissionStatement : @Statement
	= "GRANT"i & what: Permissions & on: PermissionOn? & "TO"i & who: Principals
	  & option: ("WITH"i & "GRANT"i & "OPTION"i)? & who2: PermissionAs?
		=> @(new Statement.Grant(what, who, on, option is not null, who2))
	| "DENY"i & what: Permissions & on: PermissionOn? & "TO"i & who: Principals
	  & cascade: "CASCADE"i? & who2: PermissionAs?
		=> @(new Statement.Deny(what, who, on, cascade is not null, who2))
	| "REVOKE"i & optionFor: ("GRANT"i & "OPTION"i & "FOR"i)? & what: Permissions & on: PermissionOn?
	  & way: ToOrFrom & who: Principals & cascade: "CASCADE"i? & who2: PermissionAs?
		=> @(new Statement.Revoke(what, who, on, optionFor is not null, Syntax.Squared(way) == "FROM", cascade is not null, who2))

ToOrFrom      : @string = t: ("TO"i | "FROM"i) => @(t)
PermissionAs  : @string = "AS"i & t: PrincipalName => @(t)
PermissionOn  : @string = "ON"i & t: (SecurableClass? & QualifiedName) => @(Syntax.Spaced(t))

// `OBJECT::t`, `SCHEMA::s`, `SERVER ROLE::r`, `XML SCHEMA COLLECTION::c` — a run of words
// and `::`. Where there is no `::` the whole clause is given back, which is what makes it
// safe to try in front of an ordinary name.
SecurableClass = PermissionWord+ & "::"

Permissions : @string[]
	= t: ("ALL"i & "PRIVILEGES"i?) => @(new[] { Syntax.Spaced(t) })
	| first: Permission & (',' & rest: Permission)* => @(Syntax.Named(first, rest))

Permission : @string
	= t: (PermissionName & ('(' & ColumnList & ')')?) => @(Syntax.Spaced(t))

// A run of them, and it ends where it must: neither `ON` nor `TO` is a permission word,
// so the words of the name are taken and the clause after them is left alone.
PermissionName = PermissionWord+

// A permission is spelled with words, and which words is a catalogue: `ALTER ANY
// DATABASE`, `VIEW DEFINITION`, `BACKUP LOG`, `SUBSCRIBE QUERY NOTIFICATIONS`. Half of
// them are reserved and cannot be read as an identifier, so the list used to be written
// out — thirty-one words, and a permission SQL Server adds is a word this grammar has
// never heard of.
//
// What actually bounds the name is not which words are in it but where it ends, and the
// syntax says that: `ON`, `TO`, `FROM`, `WITH` and `CASCADE` begin the clause after it.
// So the rule is any word that is not one of those — five words instead of thirty-one,
// and it stops being a catalogue.
PermissionWord = ?!PermissionEnd & word

PermissionEnd = "ON"i | "TO"i | "FROM"i | "WITH"i | "CASCADE"i

Principals : @string[]
	= first: PrincipalName & (',' & rest: PrincipalName)* => @(Syntax.Named(first, rest))

PrincipalName : @string = "PUBLIC"i => @("PUBLIC") | t: QualifiedName => @(t)
