// The text of a response file, split into its words.

trivia = none

// csc's syntax: words separated by blanks and line ends; a run in double quotes kept whole, blanks
// and all, the quotes dropped — "a b"c is one word, a bc — and a quote that never closes running
// to the end of its line; a line whose first word begins with # a comment.
//
// Each line after the first is read one way, so that a text this does not read is not read again
// for every way of cutting it: a line end whole, never `\r` ending one empty line and `\n` the
// next, and what the line holds in braces, since a comment reads to the end of the line and so do
// its words — a line that begins with # is never also read as a word.

ResponseText : @Word[] = Blank & (Comment | (Word & (Gap & Word)* & Blank)?)
                         & ({ eol } & Blank & { Comment | (Word & (Gap & Word)* & Blank)? })* & eof

Comment = '#' & [^ '\r' | '\n']*

// A word is a run of plain characters and quoted runs, one after the other. Written so that where
// one run ends and the next begins is never a choice: a plain run stops only at a quote or a blank,
// and a quoted one begins with its quote.
Word : @Word = head: Plain & tail: Quoted* => @(new Word(head + string.Concat(tail), parserSpan.Start))
             | tail: Quoted+               => @(new Word(string.Concat(tail), parserSpan.Start))

// A quoted run and the plain characters straight after it.
Quoted : @string = '"' & text: [^ '"' | '\r' | '\n']* & ('"' | ?=eol | eof) & after: Plain? => @(text + (after ?? ""))

Plain : @string = text: [^ ' ' | '\t' | '"' | '\r' | '\n']+ => @(text)

Blank = [' ' | '\t']*

Gap = [' ' | '\t']+

parse ResponseText
