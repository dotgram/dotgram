<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>DotGram.Cli</RootNamespace>
		<AssemblyName>dotnet-dotgram</AssemblyName>

		<!-- Built for the oldest runtime still in support, so that it runs on 8, 9, 10 and later, and on
		     the newest of them that is installed. The newest, because the generator tells what an identifier
		     may be from the runtime's Unicode tables (GRAM0007): on an older runtime the tool would refuse
		     a name that a build on the newer one accepts, and the tool must decide as the build does. -->
		<TargetFramework>net8.0</TargetFramework>
		<RollForward>LatestMajor</RollForward>

		<!-- NETSDK1138 says net8.0 leaves support (2026-11-10). It is the floor on purpose, above, and
		     warnings are errors here, so the day the SDK starts saying so must not be the day the tool
		     stops building. -->
		<NoWarn>$(NoWarn);NETSDK1138</NoWarn>

		<PackAsTool>true</PackAsTool>
		<PackageId>DotGram.Cli</PackageId>
		<ToolCommandName>dotnet-dotgram</ToolCommandName>
		<Description>The DotGram generator outside the build: writes the parsers a build would generate, so that a project compiles them without referencing the generator.</Description>
		<PackageTags>parser;parser-generator;grammar;dotnet-tool;codegen;csharp</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Roslyn carries a dozen resource cultures, several megabytes, that a tool printing English
		     never reads. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<!-- Symbols inside the assembly, as the libraries carry them: a stack trace from the tool has
		     line numbers without a symbol server. -->
		<DebugType>embedded</DebugType>

		<!-- Paths in the PDB and the package normalized to the repository rather than the runner's
		     disk, as the libraries have them, so that what CI packs can be rebuilt from the commit its
		     nuspec names. Only on CI, because locally it would point a debugger at /_/. -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- The native build: `dotnet publish src/DotGram.Cli -c Release -r <rid> -p:DotGramCliNative=true`
	     publishes one executable, dotgram (dotgram.exe on Windows), compiled ahead of time for the runtime
	     identifier given, under .build/native/publish/DotGram.Cli/. It needs neither .NET nor an SDK
	     where it runs, and does not compile Roslyn and the generator each time it starts, as the .NET
	     tool does: a small grammar takes a tenth of the time. It reads a .gram and not a project: a
	     project brings its other source
	     generators, which only the .NET tool can load (Cli.ReadsProjects). The build is made on the
	     platform it is for, which is how the native linker is found: CI publishes each runtime on its own
	     runner. -->
	<PropertyGroup Condition="'$(DotGramCliNative)' == 'true'">
		<!-- The runtime of the repository's SDK: the native tool carries the one it is built for. -->
		<TargetFramework>net10.0</TargetFramework>
		<PublishAot>true</PublishAot>
		<PackAsTool>false</PackAsTool>
		<IsPackable>false</IsPackable>

		<!-- Each trim warning by itself, not one line an assembly: a new one in Roslyn is then named
		     where it is, and is not hidden behind the ones accepted below. -->
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(DotGramCliNative)' == 'true'">
		<!-- Leaves the reading of a project out of the executable, and the loading of generators with it. -->
		<RuntimeHostConfigurationOption Include="DotGram.Cli.ReadsProjects" Value="false" Trim="true" />

		<!-- Two warnings the native compiler gives in Roslyn, accepted for the native compiler only. The
		     analyzers that check this tool's own code for the same rules run in its compilation, before
		     this, and are not affected. Neither concerns what the tool runs:
		     IL2091, five times: Roslyn's PooledDelegates and RoslynLazyInitializer pass a type argument
		     without the annotation that ConditionalWeakTable's CreateValueCallback and
		     LazyInitializer.EnsureInitialized put on it, which says the type's parameterless constructor
		     may be called. Roslyn hands ConditionalWeakTable a callback of its own, which is what makes
		     the value, and LazyInitializer makes one as new T() does, which the native compiler compiles
		     for each type it is instantiated with.
		     IL3000: CommonCompiler.GetAssemblyLocation reads Assembly.Location, an empty string in a native
		     executable, to name the command-line compiler's own file (csc), which the tool does not run.
		     Both are turned off for the native compiler as a whole because it offers nothing narrower for
		     another assembly's code: an UnconditionalSuppressMessage has to sit in the assembly that has
		     the code, and the native compiler reads no attribute file from outside it (ILLink's
		     link-attributes). This tool's own code is not covered by it: the compilation's analyzers report
		     both rules there, as errors. -->
		<IlcArg Include="--nowarn:IL2091" />
		<IlcArg Include="--nowarn:IL3000" />
	</ItemGroup>

	<!-- The executable is dotgram, a command of its own and not one of dotnet's. The assembly keeps its
	     name, dotnet-dotgram: the native compiler tells assemblies apart by name without case, and
	     dotgram would be the generator's DotGram. -->
	<Target Name="DotGramNativeName" AfterTargets="CopyNativeBinary" Condition="'$(DotGramCliNative)' == 'true'">
		<Move SourceFiles="$(PublishDir)$(TargetName)$(NativeBinaryExt)" DestinationFiles="$(PublishDir)dotgram$(NativeBinaryExt)" />
	</Target>

	<!-- The oldest Roslyn the generator loads into, which a project's SDK compiler must be at least as
	     new as: the version the generator's project references, written into the tool when it is built,
	     because the native tool cannot read it from the generator's references when it runs. -->
	<Target Name="DotGramRoslynFloor" BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>DotGramRoslyn</_Parameter1>
				<_Parameter2>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.CodeAnalysis.CSharp')->'%(Version)')</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- The generator itself, the same build of it the DotGram package ships: the tool hosts it. And
		     as an analyzer too, for the one grammar the tool is written with: its own command line. -->
		<ProjectReference Include="..\DotGram\DotGram.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- The newest Roslyn rather than the generator's floor: the tool parses the user's sources, and
		     those may be written in a C# newer than the oldest compiler the generator loads into. The
		     generator, built against the floor, runs on this one as it does in any newer compiler. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(DotGramCliRoslynVersion)" />

		<!-- The framework's reference assemblies, carried in the tool, so that what a type is does not
		     depend on which SDK or targeting pack happens to be installed where it runs. -->
		<PackageReference Include="Basic.Reference.Assemblies.Net80" />
		<PackageReference Include="Basic.Reference.Assemblies.Net90" />
		<PackageReference Include="Basic.Reference.Assemblies.Net100" />
		<PackageReference Include="Basic.Reference.Assemblies.NetStandard20" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="CommandLine.gram" />
		<EmbeddedResource Include="SKILL.md" LogicalName="DotGram.Cli.SKILL.md" />
		<None Include="SKILL.md" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="../../licenses/LICENSE-GENERATED-CODE" Pack="true" PackagePath="licenses/" />
		<InternalsVisibleTo Include="DotGram.Cli.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- A tool and not a library: nothing here is public, and the baseline says so, so that a type made
		     public is a line in a diff and not an accident. -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
		<!-- The package adds the two files as AdditionalFiles itself; out of None, they appear once. -->
		<None Remove="PublicAPI.*.txt" />
	</ItemGroup>

</Project>
