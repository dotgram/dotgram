<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>DotGram.Cli</RootNamespace>
		<AssemblyName>dotnet-dotgram</AssemblyName>

		<!-- Built for the oldest runtime still in support, so that it runs on 8, 9, 10 and later, on the
		     oldest of them that is installed. What it writes does not depend on which: the generator
		     carries its own Unicode tables instead of asking the runtime for them, and the package smoke
		     runs the tool on 8 and on 10 and holds the two outputs equal. -->
		<TargetFramework>net8.0</TargetFramework>
		<RollForward>Major</RollForward>

		<!-- NETSDK1138 says net8.0 leaves support (2026-11-10). It is the floor on purpose, above, and
		     warnings are errors here, so the day the SDK starts saying so must not be the day the tool
		     stops building. -->
		<NoWarn>$(NoWarn);NETSDK1138</NoWarn>

		<PackAsTool>true</PackAsTool>
		<PackageId>DotGram.Cli</PackageId>
		<ToolCommandName>dotnet-dotgram</ToolCommandName>
		<Description>The DotGram generator outside the build: writes the parsers a build would generate, so that a project compiles them without referencing the generator.</Description>
		<PackageTags>parser;parser-generator;grammar;dotnet-tool;codegen;csharp</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>New in 0.3.0: dotnet dotgram generate writes the parsers a build would generate, for a project (as its own build gives the compiler its inputs) or for one .gram file, so that the project compiles them and does not reference the DotGram package. For large grammars, whose generation shows in a cold build. The files are byte for byte what DotGram writes in dotnet build of the project, for a restored project built with the same SDK, apart from relative #line paths (--line-paths absolute for the build's), no generation report files, and the line endings of the EmbeddedAttribute definition. Needs .NET SDK 8.0.100 or newer; runs on .NET 8 and later. dotnet dotgram --skill prints the guide for coding agents; docs/cli.md in the repository is the reference.</PackageReleaseNotes>

		<!-- Roslyn carries a dozen resource cultures, several megabytes, that a tool printing English
		     never reads. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator itself, the same build of it the DotGram package ships: the tool hosts it. And
		     as an analyzer too, for the one grammar the tool is written with: its own command line. -->
		<ProjectReference Include="..\DotGram\DotGram.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- The newest Roslyn rather than the generator's floor: the tool parses the user's sources, and
		     those may be written in a C# newer than the oldest compiler the generator loads into. The
		     generator, built against the floor, runs on this one as it does in any newer compiler. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(DotGramCliRoslynVersion)" />

		<!-- The framework's reference assemblies, carried in the tool, so that what a type is does not
		     depend on which SDK or targeting pack happens to be installed where it runs. -->
		<PackageReference Include="Basic.Reference.Assemblies.Net80" />
		<PackageReference Include="Basic.Reference.Assemblies.Net90" />
		<PackageReference Include="Basic.Reference.Assemblies.Net100" />
		<PackageReference Include="Basic.Reference.Assemblies.NetStandard20" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="CommandLine.gram" />
		<EmbeddedResource Include="SKILL.md" LogicalName="DotGram.Cli.SKILL.md" />
		<None Include="SKILL.md" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="DotGram.Cli.Tests" />
	</ItemGroup>

</Project>
