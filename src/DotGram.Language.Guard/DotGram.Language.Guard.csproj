<Project Sdk="Microsoft.NET.Sdk">

	<!-- The shared language core compiled with Roslyn, Workspaces included, and nothing else:
	     building it is the assertion that Language/ reaches neither the generator's shell
	     (Generation/) nor an editor — Visual Studio, LSP, WPF, MEF. .NET Framework 4.7.2, the
	     oldest host that compiles these sources (the Visual Studio extension), built here from
	     reference assemblies alone. Referenced by nothing; its output is the build succeeding
	     (../DotGram/Language/README.md). -->
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<IsPackable>false</IsPackable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>

	<Import Project="..\DotGram\Language.projitems" />

	<!-- MEF is how an editor composes itself, and the core must not: Workspaces brings
	     System.Composition with it, and .NET Framework has System.ComponentModel.Composition, the
	     MEF Visual Studio's own [Export]s are written in. Both are taken out of what the compiler
	     is handed, so an [Export] of either here does not build. The core reads Workspaces'
	     types and never composes them. -->
	<Target Name="WithoutComposition" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
		<ItemGroup>
			<ReferencePath Remove="@(ReferencePath)"
			               Condition="$([System.String]::Copy('%(Filename)').StartsWith('System.Composition')) or
			                          '%(Filename)' == 'System.ComponentModel.Composition'" />
		</ItemGroup>
	</Target>

</Project>
