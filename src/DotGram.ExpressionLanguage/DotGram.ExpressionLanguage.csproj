<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The two targets DotGram.Web has, for its reasons: netstandard2.0 is what
		     every consumer can read, and net10.0 is what the newest runtime gets without
		     the shims. -->
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>

		<Description>A C#-style expression language written in .gram, compiled straight into System.Linq.Expressions trees.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>expressions;expression-tree;linq;linq-expressions;parser;csharp;dsl;dotgram</PackageTags>
		<PackageReleaseNotes>Since 0.1.0. Lambdas whose parameters say no types, read where the types are known; interpolated strings, verbatim and raw; a resolution scope a host hands in, so where a name is looked for is the host's to decide — and what it means stays C#'s. Names are found in the calling assembly and what it references, as a compilation's are, and no longer in whatever the process happens to have loaded. Parse, TryParse and Compile are what is public, and TryParse now also answers whether without a message. Faster: an expression of a thousand terms no longer costs the square of its length, nor does a text of many blocks each declaring a name; a name that binds a parameter or a local is never looked for as a type, as in C#. Making a scope loads the assemblies it covers: about 20 ms, once per calling assembly and process.</PackageReleaseNotes>

		<!-- The documentation of what is public, shipped beside the assembly. Here and not
		     in Directory.Build.targets: by the time those are read the SDK has already
		     decided where the file goes, and it goes nowhere. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Symbols inside the assembly, and paths normalized on CI only: both as
		     DotGram.Web has them, and the reasons are written there. -->
		<DebugType>embedded</DebugType>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Generated files land on disk so a reader can open what the grammar became. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator, and nothing else: the parser it writes acquires no runtime
		     dependency (docs/syntax.md §6.1). -->
		<ProjectReference Include="..\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<!-- For the consumer: the generated parser takes `ReadOnlySpan<char>`. The one
		     dependency this package has, and only here. -->
		<PackageReference Include="System.Memory" />

		<!-- For the compilation: types the framework lacks, emitted internal, so nothing
		     reaches the package. -->
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<MeziantouPolyfill_IncludedPolyfills>T:System.Runtime.CompilerServices.IsExternalInit;T:System.Index;T:System.Range;T:System.Diagnostics.CodeAnalysis</MeziantouPolyfill_IncludedPolyfills>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />

		<!-- The skill beside it, so that an agent working in a project that has restored
		     this package can read how to use it without leaving the machine. The README
		     says where it is, in a comment nothing renders. -->
		<None Include="SKILL.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- What the tests and the hand-written yardstick read and no caller should: the
		     factories the grammar builds with, the resolver, a publication written
		     `internal`. It costs nothing across the boundary since the attributes the
		     generator writes into each assembly are marked embedded, and neither sees the
		     other's. -->
		<InternalsVisibleTo Include="DotGram.Tests" />
		<InternalsVisibleTo Include="DotGram.Tests.Slow" />
		<InternalsVisibleTo Include="DotGram.Benchmarks" />
		<InternalsVisibleTo Include="DotGram.Handwritten" />
	</ItemGroup>

</Project>
