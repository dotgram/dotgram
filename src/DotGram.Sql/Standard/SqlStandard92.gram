@using System;
@using DotGram.Sql.Ast;
@using DotGram.Sql.Standard;

using Lexical;

// ── §5 Lexical elements ─────────────────────────────────────────────────────
//
// A namespace with no trivia, so a token is its characters and nothing may stand
// between them (§4.5). Everything outside it may be spaced and commented freely.
namespace Lexical
{
	trivia = none

	// §5.2. A regular identifier is a letter and then letters, digits or underscores;
	// a delimited one is anything between double quotes, with "" for a quote inside.
	// The standard's <identifier body> admits <identifier part> beyond ASCII, which is
	// what \p{L} and \p{Nd} say here. The parts are kept apart rather than taken from
	// the library whole, because a dialect builds its own tokens out of them.
	IdentifierStart     = [\p{L} | '_']
	IdentifierPart      = [\p{L} | \p{Nd} | '_']
	RegularIdentifier   = IdentifierStart & IdentifierPart*
	DelimitedIdentifier = Std.Quoted('"')

	// §5.3 <unsigned numeric literal>. An exact numeric has an optional point; an
	// approximate one is a mantissa and an exponent. Written in that order so that
	// `1E5` is read whole rather than as `1` and something the parse cannot place.
	Digits                    = Std.Digits
	ExactNumericLiteral       = Digits & ('.' & Digits?)? | '.' & Digits
	ApproximateNumericLiteral = ExactNumericLiteral & 'E'i & ['+' | '-']? & Digits
	UnsignedNumericLiteral    = ApproximateNumericLiteral | ExactNumericLiteral

	// §5.3 <character string literal>, with '' for a quote inside. The optional
	// introducer names a character set.
	CharacterStringLiteral         = ('_' & RegularIdentifier)? & QuotedString
	QuotedString                   = Std.Quoted('\'')
	NationalCharacterStringLiteral = 'N'i & QuotedString
	BitStringLiteral               = 'B'i & '\'' & ['0' | '1']* & '\''
	HexStringLiteral               = 'X'i & '\'' & Std.HexDigit* & '\''

	// §5.3 <datetime literal> and <interval literal> carry their type in front of the
	// string, which is what tells them from a character string.
	DateLiteral      = "DATE"i      & Space & QuotedString
	TimeLiteral      = "TIME"i      & Space & QuotedString
	TimestampLiteral = "TIMESTAMP"i & Space & QuotedString
	Space            = Std.Spacing
}

// §5.2, and the reason the keywords below are literals rather than a rule: a keyword
// is a whole word, so `ANDY` is an identifier and not `AND` followed by `Y`. §4.6
// weaves this beside every word literal without it being written again.
wordboundary = IdentifierPart

// §5.4 <comment> is `--` to the end of the line; §5.2 allows the bracketed form in
// later editions and it costs nothing to read.
trivia       = { (Std.Spacing | Std.LineComment("--") | Std.BlockComment("/*", "*/"))* }

// ── §8 Predicates, and the tower the standard calls a search condition ──────
//
// The names are the standard's, production for production: <search condition> over
// <boolean term> over <boolean factor> over <boolean test> over <boolean primary>.
// Left recursive where the standard is left recursive, which §4.3 folds into a loop,
// so the operand at the head is read once however many operators follow it.
//
// What is read is built as the records of DotGram.Sql.Ast, the tree SqlStandardParser builds,
// and in the shape it builds them: the same text is the same tree whichever of the two read it.
// Where the two grammars are written differently the action says how it reaches that shape.

SearchCondition : @Expression
    = left: SearchCondition & "OR"i & right: BooleanTerm => @(new Expression.Binary(left, BinaryOperator.Or, right))
    | t: BooleanTerm                                     => @t

BooleanTerm : @Expression
    = left: BooleanTerm & "AND"i & right: BooleanFactor => @(new Expression.Binary(left, BinaryOperator.And, right))
    | f: BooleanFactor                                  => @f

BooleanFactor : @Expression
    = negated: "NOT"i? & t: BooleanTest => @(negated is null ? t : new Expression.Unary(UnaryOperator.Not, t))

// §8.13 <boolean test>. `IS TRUE` and its fellows, and the standard allows them to
// stack — `x IS TRUE IS NOT FALSE` is legal — so this repeats rather than being one
// optional tail.
// Left recursive rather than a repetition, so that §4.3 folds it and each test is
// built around what stood to its left. The two read the same language.
BooleanTest : @Expression
    = operand: BooleanTest & "IS"i & negated: "NOT"i? & truth: TruthValue => @(new Expression.IsTruth(operand, negated is not null, Nodes.Truthful(truth)))
    | p: BooleanPrimary => @(p)

TruthValue  = "TRUE"i | "FALSE"i | "UNKNOWN"i

BooleanPrimary : @Expression
    = p: Predicate => @(p)
    | '(' & c: SearchCondition & ')' => @(new Expression.Parenthesized(c))

// §8.1. Written in the order the standard lists them, except that the ones sharing a
// left operand are gathered: <row value constructor> opens six of the nine, and
// reading it once for all of them is what §4.3's folding is for. The three that do
// not — EXISTS, UNIQUE and the LIKE whose operand is narrower — stand on their own.
Predicate : @Expression
    = "EXISTS"i                & q:    TableSubquery => @(new Expression.Exists(q))
    | "UNIQUE"i                & q:    TableSubquery => @(new Expression.Unique(null, q))
    | row: RowValueConstructor & tail: PredicateTail => @(Nodes.Predicated(row, tail))

// What may follow a row on the left of a predicate. One rule so that the row is read
// once: written as six alternatives of <predicate> each beginning with <row value
// constructor>, a row would be read six times before the parse found out which
// predicate it was in — and a row holds whole value expressions.
//
// Every alternative leaves its left operand null and `Nodes.Predicated` fills it in, so a
// predicate is one record whichever way it was written, and its operands are named
// rather than numbered.
PredicateTail : @Expression
          // §8.2 <comparison predicate> and §8.8 <quantified comparison predicate>
          // share their operator, and differ only in what stands on the right.
          // The two comparison forms share their operator, so it is read once and
          // what may follow it is the choice — which is the same grammar written the
          // way GRAM4016 asks for, and a row on the right is not cheap to read twice.
          = op: CompOp & ( some: Quantifier & sub: TableSubquery | right: RowValueConstructor ) =>
              @(Nodes.Compared(some is null
                 ? new Expression.Comparison(null!, default, right!)
                 : new Expression.QuantifiedComparison(null!, default, Nodes.Quantified(some), sub!), op))

          // §8.3 to §8.5, the three a `NOT` may stand in front of. The `NOT` is read once and
          // the word after it says which: written three times, a `NOT` in front of `IN` was
          // read by the first, which found no `BETWEEN` and gave it back.
          | negated: "NOT"i? & p: NegatablePredicate => @(Nodes.Negated(p, negated is not null))

          // §8.6 <null predicate>
          | "IS"i & negated: "NOT"i? & "NULL"i => @(new Expression.IsNull(null!, negated is not null))

          // §8.10 <match predicate>
          | "MATCH"i & unique: "UNIQUE"i? & kind: ("PARTIAL"i | "FULL"i)? & sub: TableSubquery =>
              @(new Expression.Match(null!, unique is not null, Nodes.Matching(kind), sub))

          // §8.12 <overlaps predicate>
          | "OVERLAPS"i & right: RowValueConstructor =>
              @(new Expression.Overlaps(null!, right))

NegatablePredicate : @Expression
          // §8.3 <between predicate>
          = "BETWEEN"i & low: RowValueConstructor & "AND"i & high: RowValueConstructor =>
              @(new Expression.Between(null!, false, null, low, high))

          // §8.4 <in predicate>
          | "IN"i & values: InPredicateValue =>
              @(new Expression.In(null!, false, values))

          // §8.5 <like predicate>. The standard narrows both sides to character
          // strings; that is a type rule and not a syntax one, so it is not written
          // here — see the note on the collapsed towers above.
          | "LIKE"i & pattern: ValueExpression & escape: EscapeClause? =>
              @(new Expression.Like(null!, false, LikeKind.Like, pattern, escape))

// §8.5 writes the escape as two things, the word and the character after it. They are
// named together here because a dialect may bracket the pair rather than extend it —
// T-SQL reads ODBC's `{ESCAPE '%'}` wherever this stands — and a replacement replaces
// a whole rule. What is inside is the standard's own <escape character>.
EscapeClause : @Expression = "ESCAPE"i & v: ValueExpression => @(v)

CompOp      = "<>" | "<=" | ">=" | '=' | '<' | '>'
Quantifier = "ALL"i | "SOME"i | "ANY"i

InPredicateValue : @InSource
    = q: TableSubquery => @(new InSource.Subquery(q))
    | '(' & first: ValueExpression & (',' & rest: ValueExpression)* & ')'
      => @(new InSource.Values(Nodes.List(first, rest)))

// ── §7.1 Row value constructor ─────────────────────────────────────────────
//
// A predicate compares rows, and a single value is a row of one — which is why
// `a = 1` and `(a, b) = (1, 2)` are one production in the standard rather than two.
//
// The single value stands first, and the order is about cost and not about meaning:
// a row of several needs a comma the single form cannot read, so the two never match
// the same text and either order accepts the same language. Written the other way
// round, `(a + 1) * 2` was read to its end as the first element of a row, refused at
// the missing comma, and read again as a value — once per level of parentheses.

RowValueConstructor : @Expression
    = e: RowValueConstructorElement => @e
    | '(' & first: RowValueConstructorElement & (',' & rest: RowValueConstructorElement)+ & ')' => @(new Expression.Row(Nodes.List(first, rest)))
    | q: TableSubquery => @(new Expression.Subquery(q))

RowValueConstructorElement : @Expression
    = v: ValueExpression => @(v)
    | "NULL"i    => @(Nodes.Null())
    | "DEFAULT"i => @(new Expression.Default())

// ── §6.11 Value expression ─────────────────────────────────────────────────
//
// **One tower where the standard has four, and this is a deliberate divergence.**
// §6.11 defines <value expression> as a choice of <numeric value expression>,
// <string value expression>, <datetime value expression> and <interval value
// expression>, each with a ladder of its own, and all four bottoming out in the same
// <value expression primary>. So `a + b` matches the numeric ladder and the datetime
// one at once, and which it is depends on the types of `a` and `b` — which a parser
// does not know and the standard does not expect it to: §6.11 is a description of
// syntax modulo type resolution, not a grammar anybody can run.
//
// Every implementation collapses the four into one untyped ladder, and so does this.
// What is lost is nothing syntactic: the four ladders have the same shape and the same
// precedence, and `||` is simply admitted at the additive level where the standard
// gives it a ladder of its own.

// One rule where there were three, each alternative stating its own strength (§4.3.1)
// rather than naming the level below it. What the ladder cost was every level of it at
// every bracket: `((((a + 1) * 2) - 3) / 4)` re-entered the tower five times and paid
// the additive and multiplicative levels on the way down whether an operator of that
// strength was there or not. Measured on an arithmetic language written both ways
// (benchmarks, `--ladders`), climbing is a fifth off nested input and eight per cent
// onto flat; this tower is deeper than that one, and the numbers are in docs/next.md.
//
// The strengths are the standard's own precedence and nothing else: additive and
// concatenation bind loosest and to the left, multiplicative tighter and to the left, a
// sign tightest and to the right — so `-a * b` is `(-a) * b`, which is what the three
// rules said by having the sign apply to a primary.
ValueExpression : @Expression
    = left: ValueExpression & op: ('+' | '-' | "||") & right: ValueExpression   << 1
        => @(Nodes.Arithmetic(left, op, right))
    | left: ValueExpression & op: ('*' | '/') & right: ValueExpression           << 2
        => @(Nodes.Arithmetic(left, op, right))
    | sign: ['+' | '-'] & v: ValueExpression                                     >> 3
        => @(new Expression.Unary(sign == "-" ? UnaryOperator.Minus : UnaryOperator.Plus, v))
    // §6.11 <character factor> is a primary and a collate clause, which says how it is
    // compared rather than what it is, and is kept all the same, as in a GROUP BY. Written on
    // the primary rather than as a strength of its own because that is where the
    // standard puts it, and nothing binds tighter than a primary anyway.
    //
    // §6.14 <interval primary> is a primary and an interval qualifier, written on the primary
    // for the same reason; a primary takes one or the other.
    | p: ValueExpressionPrimary & (q: IntervalQualifier | how: Collate)?
        => @(q is not null ? new Expression.IntervalQualified(p, q) : how is not null ? new Expression.Collate(p, how) : p)

// §6.11 <value expression primary>, in the standard's order, plus the value functions
// §6.16 through §6.18 fold into <numeric primary>, <string value expression> and
// <datetime value expression>. Gathered here because they are all primaries once the
// towers are one.
//
// A bracket around nothing but a subquery is the subquery's: `((SELECT a FROM t))` is a
// subquery of a bracketed query, as SQL:2023 reads it (Nodes.Parenthesized).
ValueExpressionPrimary : @Expression
    = '(' & v: ValueExpression & ')' => @(Nodes.Parenthesized(v))
    | c: CaseExpression              => @(c)
    | c: CastSpecification           => @(c)
    | f: ValueFunction               => @(f)
    | f: SetFunctionSpecification    => @(f)
    | q: ScalarSubquery              => @(q)
    | v: UnsignedValueSpecification  => @(v)
    | n: ColumnReference             => @(n)

// ── §6.9 Set function, §6.16-6.18 value functions ──────────────────────────

// COUNT(*) is its own shape; the rest take a set quantifier and a value expression.
SetFunctionSpecification : @Expression
    = name: "COUNT"i & '(' & '*' & ')'
        => @(Nodes.Call(name, new Expression.Asterisk()))
    | name: SetFunctionType & '(' & quantifier: SetQuantifier? & v: ValueExpression & ')'
        => @(Nodes.Call(name, v) with { Quantifier = Nodes.Quantifier(quantifier) })

SetFunctionType = "AVG"i | "MAX"i | "MIN"i | "SUM"i | "COUNT"i
SetQuantifier   = "DISTINCT"i | "ALL"i

// The functions the standard spells out rather than leaving to <routine invocation>.
// Each is a keyword and a fixed shape, which is why they are here and not a call.
// `BIT_LENGTH` left the standard after 1992, and SQL:2023 reads it as a routine's name:
// it is built as that call.
ValueFunction : @Expression
    = "POSITION"i              & '(' & a: ValueExpression & "IN"i & b: ValueExpression & ')'    => @(new Expression.Position(a, b, null))
    | "EXTRACT"i               & '(' & field: ExtractField & "FROM"i & v: ValueExpression & ')' => @(new Expression.Extract(Nodes.ExtractFieldOf(field), v))
    | name: "CHAR_LENGTH"i      & '(' & v: ValueExpression & ')'                                => @(new Expression.Length(Nodes.LengthFunctionOf(name), v, null))
    | name: "CHARACTER_LENGTH"i & '(' & v: ValueExpression & ')'                                => @(new Expression.Length(Nodes.LengthFunctionOf(name), v, null))
    | "OCTET_LENGTH"i           & '(' & v: ValueExpression & ')'                                => @(new Expression.Length(LengthFunction.OctetLength, v, null))
    | name: "BIT_LENGTH"i       & '(' & v: ValueExpression & ')'                                => @(Nodes.Call(name, v))
    | "SUBSTRING"i        & '(' & v: ValueExpression & "FROM"i & from: ValueExpression
                          & ("FOR"i & length: ValueExpression)? & ')'
        => @(new Expression.Substring(v, from, length, null))
    | name: "UPPER"i     & '(' & v: ValueExpression & ')'                                  => @(Nodes.Call(name, v))
    | name: "LOWER"i     & '(' & v: ValueExpression & ')'                                  => @(Nodes.Call(name, v))
    | "CONVERT"i         & '(' & v: ValueExpression & "USING"i & by: QualifiedName & ')'   => @(new Expression.TranslateUsing(TranslateFunction.Convert, v, by))
    | "TRANSLATE"i       & '(' & v: ValueExpression & "USING"i & by: QualifiedName & ')'   => @(new Expression.TranslateUsing(TranslateFunction.Translate, v, by))
    | "TRIM"i            & '(' & { how: TrimSpecification? } & what: ValueExpression?
                   & "FROM"i & v: ValueExpression & ')'
        => @(new Expression.Trim(how is null ? null : Nodes.TrimSpecificationOf(how), what, true, v))
    | "TRIM"i & '(' & v: ValueExpression & ')'      => @(new Expression.Trim(null, null, false, v))
    | "CURRENT_DATE"i                                            => @(new Expression.Current(CurrentValue.Date))
    | name: "CURRENT_TIME"i      & ('(' & digits: Digits & ')')? => @(Nodes.CurrentTime(name, digits))
    | name: "CURRENT_TIMESTAMP"i & ('(' & digits: Digits & ')')? => @(Nodes.CurrentTime(name, digits))

ExtractField      = "YEAR"i | "MONTH"i | "DAY"i | "HOUR"i | "MINUTE"i | "SECOND"i | "TIMEZONE_HOUR"i | "TIMEZONE_MINUTE"i
TrimSpecification = "LEADING"i | "TRAILING"i | "BOTH"i

// ── §6.20 Case expression, §6.10 Cast ──────────────────────────────────────
//
// The standard's <case abbreviation> — NULLIF and COALESCE — is part of <case
// expression>, not something beside it, and is written here where the standard puts
// it.
CaseExpression : @Expression
    = name: "NULLIF"i   & '(' & a: ValueExpression & ',' & b: ValueExpression & ')'                           => @(Nodes.Invoked(name, a, [b]))
    | name: "COALESCE"i & '(' & first: ValueExpression & (',' & rest: ValueExpression)* & ')'                 => @(Nodes.Invoked(name, first, rest))
    | "CASE"i & operand: ValueExpression & whens: SimpleWhen+ & ("ELSE"i & otherwise: Result)? & "END"i => @(new Expression.Case(operand, Sql.SqlList.Own(whens), otherwise))
    | "CASE"i & whens: SearchedWhen+ & ("ELSE"i & otherwise: Result)? & "END"i                          => @(new Expression.Case(null, Sql.SqlList.Own(whens), otherwise))

SimpleWhen   : @CaseWhen = "WHEN"i & test: ValueExpression & "THEN"i & result: Result => @(new CaseWhen([test], result))
SearchedWhen : @CaseWhen = "WHEN"i & test: SearchCondition & "THEN"i & result: Result => @(new CaseWhen([test], result))

Result            : @Expression = v: ValueExpression => @(v) | "NULL"i => @(Nodes.Null())
CastSpecification : @Expression = "CAST"i & '(' & v: CastOperand & "AS"i & type: DataType & ')' => @(new Expression.Cast(v, type))
CastOperand       : @Expression = v: ValueExpression => @(v) | "NULL"i => @(Nodes.Null())

// ── §6.1 Data type, cut to what a CAST target can be ───────────────────────
//
// Each keeps which of its spellings was written. `BIT` and `BIT VARYING` left the standard
// after 1992 and are SQL-92's own record (DataType.BitString). A length or a precision is
// an int in the tree, which is this implementation's largest (§6.1 leaves it to one), and a
// larger number is refused where it is read (Number).

DataType : @DataType
    = w: ("CHARACTER"i & "VARYING"i? | "CHAR"i & "VARYING"i? | "VARCHAR"i) & n: Length? & ("CHARACTER"i & "SET"i & set: QualifiedName)?
        => @(Nodes.Characters(Nodes.CharacterType(w, n), set is null ? null : new CharacterSetName(set), null))
    | w: ("NATIONAL"i & ("CHARACTER"i | "CHAR"i) & "VARYING"i? | "NCHAR"i & "VARYING"i?) & n: Length?
        => @(Nodes.CharacterType(w, n))
    | w: ("BIT"i & "VARYING"i?) & n: Length? => @(Nodes.BitString(w, n))
    | w: ("NUMERIC"i | "DECIMAL"i | "DEC"i) & ('(' & p: Number & (',' & s: Number)? & ')')? => @(Nodes.NumericType(w, p, s))
    | w: "INTEGER"i => @(Nodes.NumericType(w, null, null))
    | w: "INT"i => @(Nodes.NumericType(w, null, null))
    | w: "SMALLINT"i => @(Nodes.NumericType(w, null, null))
    | (w: "FLOAT"i & ('(' & p: Number & ')')?) => @(Nodes.NumericType(w, p, null))
    | w: "REAL"i => @(Nodes.NumericType(w, null, null))
    | ("DOUBLE"i & "PRECISION"i) => @(Nodes.NumericType("DOUBLE PRECISION", null, null))
    | "DATE"i => @(new DataType.DateTime(DateTimeTypeKind.Date))
    | w: ("TIME"i | "TIMESTAMP"i) & ('(' & p: Number & ')')? & (z: "WITH"i & "TIME"i & "ZONE"i)? => @(Nodes.DateTime(w, p, z))
    | "INTERVAL"i & q: IntervalQualifier => @(new DataType.Interval(q))

Length : @string = '(' & n: Number & ')' => @(n)

// A length, a precision or a scale: digits, and no more of them than an int holds.
Number : @string = n: Digits & when @(Nodes.FitsInt(n)) => @(n)

// §10.1 <interval qualifier>, which is what an INTERVAL type and an interval literal
// both end with, production for production: a start field is a field other than SECOND
// with a leading precision, an end field takes a precision only if it is SECOND, and then
// the fractional one, and a single SECOND may take both. TIMEZONE_HOUR and
// TIMEZONE_MINUTE are §6.6's extract fields and no interval's.
IntervalQualifier : @IntervalQualifier
    = start: StartField & "TO"i & end: EndField => @(Nodes.Qualifier(start, end))
    | f: SingleDatetimeField                    => @(f)

StartField : @IntervalQualifier = f: NonSecondDatetimeField & ('(' & p: Number & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p)))

EndField : @IntervalQualifier
    = f: NonSecondDatetimeField                    => @(new IntervalQualifier(Nodes.Field(f)))
    | f: "SECOND"i & ('(' & p: Number & ')')?      => @(new IntervalQualifier(Nodes.Field(f), null, null, Nodes.Integer(p)))

SingleDatetimeField : @IntervalQualifier
    = f: NonSecondDatetimeField & ('(' & p: Number & ')')?                  => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p)))
    | f: "SECOND"i & ('(' & p: Number & (',' & q: Number)? & ')')?          => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p), null, Nodes.Integer(q)))

NonSecondDatetimeField = "YEAR"i | "MONTH"i | "DAY"i | "HOUR"i | "MINUTE"i

// ── §6.3 Value specification, §6.4 Column reference ────────────────────────

UnsignedValueSpecification : @Expression = l: UnsignedLiteral => @(new Expression.Literal(l)) | v: GeneralValueSpecification => @(v)

// The literals a value may begin with. A typed literal keeps the string after its key
// word, from its first quote to its last, as SQL:2023's does. A bit string left the
// standard after 1992, and is SQL-92's own literal (LiteralValue.BitString).
UnsignedLiteral : @LiteralValue
    = t: UnsignedNumericLiteral         => @(Nodes.NumericLiteral(t))
    | t: CharacterStringLiteral         => @(Nodes.StringLiteral(t, StringLiteralKind.Character))
    | t: NationalCharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.National))
    | t: BitStringLiteral               => @(new LiteralValue.BitString(Nodes.Quoted(t)))
    | t: HexStringLiteral               => @(Nodes.BinaryLiteral(t))
    | t: DateLiteral                    => @(new LiteralValue.DateTime(DateTimeLiteralKind.Date,      Nodes.Quoted(t)))
    | t: TimeLiteral                    => @(new LiteralValue.DateTime(DateTimeLiteralKind.Time,      Nodes.Quoted(t)))
    | t: TimestampLiteral               => @(new LiteralValue.DateTime(DateTimeLiteralKind.Timestamp, Nodes.Quoted(t)))
    | v: IntervalLiteral                => @(v)

// §5.3. The sign belongs to the literal here and not to <factor>, which is what lets
// `INTERVAL -'1' DAY` read.
IntervalLiteral : @LiteralValue = "INTERVAL"i & w: (['+' | '-']? & t: QuotedString) & q: IntervalQualifier => @(new LiteralValue.Interval(t, q, Nodes.LeadingSign(w)))

// §6.3 <general value specification>: the parameters and the niladic functions that
// stand where a value does.
GeneralValueSpecification : @Expression
    = (':' & name: Identifier & (keyword: ("INDICATOR"i? & ':') & indicator: Identifier)?)
        => @(Nodes.HostParameter(name, indicator, keyword is not null && keyword.Length > 1))
    | '?'
        => @(new Expression.Parameter(ParameterKind.Dynamic))
    | t: ("USER"i | "CURRENT_USER"i | "SESSION_USER"i | "SYSTEM_USER"i | "VALUE"i)
        => @(Nodes.Current(t))

// §6.4. A column reference is a qualified name, and how many parts it has is a
// question about a catalogue rather than about syntax — so the syntax admits the
// depth the standard allows and says nothing about what the parts mean.
ColumnReference : @Expression = name: QualifiedName => @(new Expression.Reference(name))

QualifiedName : @QualifiedName = first: Identifier & (('.' & rest: Identifier))* => @(Nodes.Chain(first, rest))

// The lookahead stands in front: an identifier is a word that is *not* reserved,
// which is what 5.2 says. Behind it, it would be asking whether a reserved word
// follows one — a different question, and one that refuses `x IN (1, 2)`.
// A delimited identifier keeps its quotes, as SQL:2023's does.
Identifier : @Identifier
    = ?!Reserved & t: RegularIdentifier => @(new Identifier(t))
    | t: DelimitedIdentifier            => @(new Identifier(t, IdentifierStyle.Delimited))

// ── §7 Query expressions ───────────────────────────────────────────────────
//
// The level this grammar used to hold a place for. A subquery was a rule that read a
// balanced run of characters and handed the text over; it is a query now, and the two
// productions that named it are the standard's own.

// §7.13 <subquery>, and the two §7.11-§7.12 spellings of it that differ only in what
// they may return — which is a question about the query and not about its syntax, so
// both read the same thing and the standard's names are kept for the reader.
TableSubquery  : @Query      = q: Subquery => @(q)
ScalarSubquery : @Expression = q: Subquery => @(new Expression.Subquery(q))

Subquery : @Query = '(' & q: QueryExpression & ')' => @(q)

// §7.10. UNION and EXCEPT bind alike and looser than INTERSECT, and all three are left
// associative — the same three strengths the value tower states, said the same way
// (§4.3.1). Each operation is appended to its left operand's list, which is how SQL:2023
// keeps a run of them: `a UNION b INTERSECT c` is `a` with one operation whose operand is
// `b` with one of its own.
QueryExpression : @Query
    = left: QueryExpression & op: ("UNION"i | "EXCEPT"i) & all: "ALL"i? & how: Corresponding?
      & right: QueryExpression                                                     << 1
        => @(Nodes.Combined(left, [Nodes.Operation(op, all, how, right)]))
    | left: QueryExpression & op: "INTERSECT"i & all: "ALL"i? & how: Corresponding?
      & right: QueryExpression                                                     << 2
        => @(Nodes.Combined(left, [Nodes.Operation(op, all, how, right)]))
    | q: QueryPrimary => @(q)

Corresponding : @CorrespondingClause = "CORRESPONDING"i & ("BY"i & '(' & columns: ColumnList & ')')? => @(new CorrespondingClause(columns is not null, columns ?? []))

// §7.10 <non-join query primary>, and the parenthesized form that lets a query
// expression stand where a primary does.
QueryPrimary : @Query
    = q: QuerySpecification            => @(q)
    | v: TableValueConstructor         => @(v)
    | "TABLE"i & name: QualifiedName   => @(Nodes.Tabled(name))
    | '(' & q: QueryExpression & ')'   => @(Nodes.InBrackets(q))

// §7.2. A row of one value may be written without its parentheses, which is what makes
// `VALUES 1, 2` two rows of one column rather than one row of two.
TableValueConstructor : @Query
    = "VALUES"i & first: RowValueConstructor & (',' & rest: RowValueConstructor)*
        => @(new Query.Select { Values = Nodes.Rows(first, rest) })

// §7.9 <query specification> with §7.3 <table expression> folded into it: the clauses
// are optional rather than alternative, so one record holds them and what tells one
// query from another is which of them are empty.
QuerySpecification : @Query
    = "SELECT"i & quantifier: SetQuantifier? & columns: SelectList
      & from: FromClause & where: WhereClause? & group: GroupByClause? & having: HavingClause?
        => @(Nodes.Specified(quantifier, columns, new Nodes.TableExpression(from, where, group, having, null)))

// §7.9 <select list>. A bare `*` is every column of every table in the FROM clause, and
// `t.*` every column of one — neither is a column reference, so neither is read as one.
SelectList : @Sql.SqlList<SelectColumn>
    = '*' => @(Nodes.Everything())
    | first: SelectSublist & (',' & rest: SelectSublist)* => @(Nodes.List(first, rest))

SelectSublist : @SelectColumn
    = qualifier: QualifiedName & '.' & '*'   => @(new SelectColumn.QualifiedAll(new Expression.Reference(qualifier)))
    | v: ValueExpression & name: AsClause?   => @(Nodes.Selected(v, name ?? Nodes.Unnamed))

AsClause : @Nodes.Fields = w: ("AS"i? & t: Identifier) => @(new Nodes.Fields(t, Nodes.Worded(w, t), null))

// §7.4. The comma list is a cross join written the older way, and it is kept as a list
// rather than folded into joins: what the standard writes is what the tree says.
FromClause : @FromClause
    = "FROM"i & first: TableReference & (',' & rest: TableReference)*
        => @(new FromClause(Nodes.List(first, rest)))

// §7.5 <joined table>, left recursive so that §4.3 folds it and the table at the head
// is read once however many joins follow it. A union join left the standard after 1992,
// and is SQL-92's own join kind (JoinKind.Union).
TableReference : @TableSource
    = left: TableReference & "CROSS"i & "JOIN"i & right: TablePrimary
        => @(new TableSource.Join { Left = left, Right = right, Kind = JoinKind.Cross })
    | left: TableReference & "UNION"i & "JOIN"i & right: TablePrimary
        => @(new TableSource.Join { Left = left, Right = right, Kind = JoinKind.Union })
    | left: TableReference & natural: "NATURAL"i? & kind: JoinType? & "JOIN"i & right: TablePrimary
      & ("ON"i & on: SearchCondition
        | "USING"i & '(' & columns: ColumnList & ')')?
        => @(Nodes.Joined(left, kind, natural is not null, right, on, columns))
    | t: TablePrimary => @(t)

JoinType = ("LEFT"i | "RIGHT"i | "FULL"i) & "OUTER"i? | "INNER"i

// §7.4 <table reference> without a join: a named table or a derived one, and the name
// it is known by inside the query.
// The correlation (§6.3) is written where it is read rather than as a rule of its own:
// its column list renames what the source produces, so it belongs to the reference.
TablePrimary : @TableSource
    = name: QualifiedName & (w: ("AS"i? & alias: Identifier) & ('(' & columns: ColumnList & ')')?)?
        => @(new TableSource.Named(name) { Alias = alias is null ? null : new Alias(alias, columns, Nodes.Worded(w!, alias)) })
    | derived: TableSubquery & w: ("AS"i? & alias: Identifier) & ('(' & columns: ColumnList & ')')?
        => @(new TableSource.Subquery(derived) { Alias = new Alias(alias, columns, Nodes.Worded(w, alias)) })
    | '(' & j: TableReference & ')' => @(new TableSource.Parenthesized(j))

// A name as a value of its own, so that a list of them gathers into a list rather
// than into the text between the first and the last (§4.1 case 4).
ColumnName : @Identifier              = t: Identifier => @(t)
ColumnList : @Sql.SqlList<Identifier> = first: ColumnName & (',' & rest: ColumnName)* => @(Nodes.List(first, rest))

WhereClause  : @Expression = "WHERE"i  & c: SearchCondition => @(c)
HavingClause : @Expression = "HAVING"i & c: SearchCondition => @(c)

// §7.7. A grouping column may carry a collation, which says how it is compared rather
// than what it is; `Expression.Collate` holds it either way.
GroupByClause : @GroupByClause
    = "GROUP"i & "BY"i & first: GroupingColumn & (',' & rest: GroupingColumn)*
        => @(new GroupByClause(null, Nodes.List(first, rest)))

GroupingColumn : @GroupingElement
    = c: ColumnReference & how: Collate? => @(new GroupingElement.Ordinary([how is null ? c : new Expression.Collate(c, how)]))

Collate : @CollationName = "COLLATE"i & t: QualifiedName => @(new CollationName(t))

// §13.1 <order by clause>, and §19's direct select that carries one. Outside §7, and
// here because a query somebody writes has one and a query expression may not hold it.
DirectSelect : @Statement
    = q: QueryExpression & by: OrderByClause? => @(new Statement.Select { Query = by is null ? q : q with { OrderBy = by } })

OrderByClause : @OrderByClause
    = "ORDER"i & "BY"i & first: SortSpecification & (',' & rest: SortSpecification)*
        => @(new OrderByClause(Nodes.List(first, rest)))

SortSpecification : @SortItem
    = v: SortKey & how: Collate? & order: ("ASC"i | "DESC"i)?
        => @(Nodes.Sorted(how is null ? v : new Expression.Collate(v, how), order, null))

// §13.1 sorts by a column or by its position in the select list.
SortKey : @Expression
    = c: ColumnReference          => @(c)
    | t: UnsignedNumericLiteral   => @(new Expression.Literal(Nodes.NumericLiteral(t)))

// ── §5.2 Reserved words ────────────────────────────────────────────────────
//
// What an identifier may not be: §5.2's <reserved word>, the whole list, as SQL-92 has it.
// The words of the statement level are reserved too, though this grammar reads no
// statement but a query: a name SQL-92 refuses is refused here, so `year > month` is not
// a search condition and `b DAY` is an interval primary (§6.14) rather than a column with
// an alias. END-EXEC is left out: a name has no hyphen, so no name could be spelled as it.
Reserved = ("ABSOLUTE"i | "ACTION"i | "ADD"i | "ALL"i | "ALLOCATE"i | "ALTER"i | "AND"i | "ANY"i
         | "ARE"i | "AS"i | "ASC"i | "ASSERTION"i | "AT"i | "AUTHORIZATION"i | "AVG"i
         | "BEGIN"i | "BETWEEN"i | "BIT"i | "BIT_LENGTH"i | "BOTH"i | "BY"i
         | "CASCADE"i | "CASCADED"i | "CASE"i | "CAST"i | "CATALOG"i | "CHAR"i | "CHARACTER"i | "CHAR_LENGTH"i
         | "CHARACTER_LENGTH"i | "CHECK"i | "CLOSE"i | "COALESCE"i | "COLLATE"i | "COLLATION"i | "COLUMN"i | "COMMIT"i
         | "CONNECT"i | "CONNECTION"i | "CONSTRAINT"i | "CONSTRAINTS"i | "CONTINUE"i | "CONVERT"i | "CORRESPONDING"i | "COUNT"i
         | "CREATE"i | "CROSS"i | "CURRENT"i | "CURRENT_DATE"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i | "CURRENT_USER"i | "CURSOR"i
         | "DATE"i | "DAY"i | "DEALLOCATE"i | "DEC"i | "DECIMAL"i | "DECLARE"i | "DEFAULT"i | "DEFERRABLE"i
         | "DEFERRED"i | "DELETE"i | "DESC"i | "DESCRIBE"i | "DESCRIPTOR"i | "DIAGNOSTICS"i | "DISCONNECT"i | "DISTINCT"i
         | "DOMAIN"i | "DOUBLE"i | "DROP"i
         | "ELSE"i | "END"i | "ESCAPE"i | "EXCEPT"i | "EXCEPTION"i | "EXEC"i | "EXECUTE"i | "EXISTS"i
         | "EXTERNAL"i | "EXTRACT"i
         | "FALSE"i | "FETCH"i | "FIRST"i | "FLOAT"i | "FOR"i | "FOREIGN"i | "FOUND"i | "FROM"i
         | "FULL"i
         | "GET"i | "GLOBAL"i | "GO"i | "GOTO"i | "GRANT"i | "GROUP"i
         | "HAVING"i | "HOUR"i
         | "IDENTITY"i | "IMMEDIATE"i | "IN"i | "INDICATOR"i | "INITIALLY"i | "INNER"i | "INPUT"i | "INSENSITIVE"i
         | "INSERT"i | "INT"i | "INTEGER"i | "INTERSECT"i | "INTERVAL"i | "INTO"i | "IS"i | "ISOLATION"i
         | "JOIN"i
         | "KEY"i
         | "LANGUAGE"i | "LAST"i | "LEADING"i | "LEFT"i | "LEVEL"i | "LIKE"i | "LOCAL"i | "LOWER"i
         | "MATCH"i | "MAX"i | "MIN"i | "MINUTE"i | "MODULE"i | "MONTH"i
         | "NAMES"i | "NATIONAL"i | "NATURAL"i | "NCHAR"i | "NEXT"i | "NO"i | "NOT"i | "NULL"i
         | "NULLIF"i | "NUMERIC"i
         | "OCTET_LENGTH"i | "OF"i | "ON"i | "ONLY"i | "OPEN"i | "OPTION"i | "OR"i | "ORDER"i
         | "OUTER"i | "OUTPUT"i | "OVERLAPS"i
         | "PAD"i | "PARTIAL"i | "POSITION"i | "PRECISION"i | "PREPARE"i | "PRESERVE"i | "PRIMARY"i | "PRIOR"i
         | "PRIVILEGES"i | "PROCEDURE"i | "PUBLIC"i
         | "READ"i | "REAL"i | "REFERENCES"i | "RELATIVE"i | "RESTRICT"i | "REVOKE"i | "RIGHT"i | "ROLLBACK"i
         | "ROWS"i
         | "SCHEMA"i | "SCROLL"i | "SECOND"i | "SECTION"i | "SELECT"i | "SESSION"i | "SESSION_USER"i | "SET"i
         | "SIZE"i | "SMALLINT"i | "SOME"i | "SPACE"i | "SQL"i | "SQLCODE"i | "SQLERROR"i | "SQLSTATE"i
         | "SUBSTRING"i | "SUM"i | "SYSTEM_USER"i
         | "TABLE"i | "TEMPORARY"i | "THEN"i | "TIME"i | "TIMESTAMP"i | "TIMEZONE_HOUR"i | "TIMEZONE_MINUTE"i | "TO"i
         | "TRAILING"i | "TRANSACTION"i | "TRANSLATE"i | "TRANSLATION"i | "TRIM"i | "TRUE"i
         | "UNION"i | "UNIQUE"i | "UNKNOWN"i | "UPDATE"i | "UPPER"i | "USAGE"i | "USER"i | "USING"i
         | "VALUE"i | "VALUES"i | "VARCHAR"i | "VARYING"i | "VIEW"i
         | "WHEN"i | "WHENEVER"i | "WHERE"i | "WITH"i | "WORK"i | "WRITE"i
         | "YEAR"i
         | "ZONE"i)

parse DirectSelect as ParseSelect
parse QueryExpression as ParseQuery
parse SearchCondition as ParseSearchCondition
parse ValueExpression as ParseValueExpression
