// ISO/IEC 9075-2:2023, SQL/Foundation: the standard's grammar, written from its BNF
// (Specification/ISO_IEC_9075-2(E)_Foundation.bnf.txt) and held to it by `--standard`, which
// puts each line of a file to the BNF itself and to the rule of the same name here.
//
// A rule is named after its production: each part capitalized and what divides the parts
// dropped, so <query expression> is `QueryExpression`. Where a rule says less or more than its
// production says, or says it in another shape, the comment above it says why. A production
// spelled as one character (<period>, <left paren>) is written as that character.
//
// Written chapter by chapter. So far: §5, the lexical elements, with the literals §5.3 makes of
// them and the names §5.4 does; §6, scalar expressions, with window functions and row pattern
// navigation and the JSON functions; §7, query expressions, with row pattern recognition and JSON
// tables; §8, predicates; §10.9, aggregates; §11 and §12, the schema's core — schemas, tables, views,
// domains, sequences, assertions, roles and privileges; §14, the data change statements and the cursors;
// §16 to §20, §22 and §23, the control, transaction, connection, session, dynamic, direct and
// diagnostics statements. What the BNF leaves to
// the Syntax Rules — the JSON path
// language's literals and names among it — is read as nothing, as `--standard` reads it.

@using System;
@using System.Collections.Generic;
@using DotGram.Sql.Ast;
@using DotGram.Sql.Standard;

using Lexical;

// ── §5.1 SQL terminal character, §5.2 Tokens and separators ─────────────────
//
// A namespace with no trivia, so a token is its characters and nothing stands between them.
// Everything outside it may be separated freely, which is what §5.2 says a <separator> is for.
namespace Lexical
{
	trivia = none

	// <simple Latin letter>, <digit>, <hexit>, <octal digit>, <binary digit>.
	SimpleLatinLetter = ['A'..'Z' | 'a'..'z']
	Digit             = ['0'..'9']
	Hexit             = ['0'..'9' | 'A'..'F' | 'a'..'f']
	OctalDigit        = ['0'..'7']
	BinaryDigit       = ['0' | '1']

	// §5.2 leaves four characters to its Syntax Rules. <space> is the space itself. An
	// <identifier start> is a letter of any script or a letter-like number (Unicode's L and Nl),
	// and an <identifier extend> the middle dot, a combining mark, a decimal digit, a connector
	// or a format character (Mn, Mc, Nd, Pc, Cf). <whitespace> is what Unicode calls white space.
	//
	// <identifier part> is either, and written as one set rather than a choice of the two: it is
	// also the word boundary, and a boundary guards the literals whose characters all fall in a
	// class — which a choice between rules is not.
	Space            = ' '
	IdentifierStart  = [\p{L} | \p{Nl}]
	IdentifierPart   = [\p{L} | \p{Nl} | '·' | \p{Mn} | \p{Mc} | \p{Nd} | \p{Pc} | \p{Cf}]
	Whitespace       = ['\t'..'\r' | '\u0085' | \p{Zs} | \p{Zl} | \p{Zp}]

	// <regular identifier>: <identifier body>, a start and parts. That it is no <reserved word>
	// is a Syntax Rule of §5.4, and it is kept where an identifier is read (`ActualIdentifier`).
	RegularIdentifier = IdentifierStart & IdentifierPart*

	// <delimited identifier>, with "" for a double quote inside; the body is not empty.
	DelimitedIdentifier     = '"' & DelimitedIdentifierPart+ & '"'
	DelimitedIdentifierPart = [^ '"'] | "\"\""

	// <Unicode delimited identifier>: `U&"…"`, where an escape names a character by its code
	// point. The Syntax Rules let `UESCAPE` choose the escape character; what is read here is
	// the default one, the reverse solidus, as `--standard` reads it too.
	UnicodeDelimitedIdentifier = 'U'i & '&' & '"' & UnicodeIdentifierPart+ & '"' & UnicodeEscapeSpecifier
	UnicodeEscapeSpecifier     = ("UESCAPE"i & '\'' & UnicodeEscapeCharacter & '\'')?
	UnicodeIdentifierPart      = UnicodeEscapeValue | DelimitedIdentifierPart
	UnicodeEscapeValue         = Unicode6DigitEscapeValue | Unicode4DigitEscapeValue | UnicodeCharacterEscapeValue
	Unicode4DigitEscapeValue   = UnicodeEscapeCharacter & Hexit{4}
	Unicode6DigitEscapeValue   = UnicodeEscapeCharacter & '+' & Hexit{6}
	UnicodeCharacterEscapeValue = UnicodeEscapeCharacter & UnicodeEscapeCharacter
	UnicodeEscapeCharacter     = '\\'

	// <separator>: comments and whitespace, as many as there are.
	Separator = (Comment | Whitespace)+
	Comment   = SimpleComment | BracketedComment

	// <simple comment> runs to the end of its line. §5.2 ends it with a <newline>, and the end
	// of the text ends the last line as well as a line break would.
	SimpleComment = "--" & [^ '\n' | '\r' | '\u0085' | '\u2028' | '\u2029']*

	// <bracketed comment>: its contents are characters and separators, and a separator may be a
	// bracketed comment, so one holds another: `/* a /* b */ c */` is one comment.
	//
	// A comment is skipped by the trivia scanner, which neither nests nor goes back, so two
	// things are written out that the BNF leaves open. The depth: six comments deep, the same
	// limit and the same reasoning as T-SQL's `TSql.NestedComment`, and deeper than anything the
	// corpus or the standard's own examples write; a seventh `/*` inside the sixth leaves the
	// comment unclosed. And the choice at a `/*`: the BNF lets it be two comment characters as
	// well as an opening, so `/* a /* b */` is one comment there, but a scanner decides at the
	// first character and cannot come back when the inner comment leaves the outer unclosed, so
	// here a `/*` inside a comment always opens one. Each level is, until it closes, the one
	// inside it or a character that opens none.
	BracketedComment = "/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ("/*" & (?!"*/" & ?!"/*" & any)* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/" | ?!"/*" & any))* & "*/"

	// ── §5.3 Literals ────────────────────────────────────────────────────────
	//
	// The letter that begins a literal is read in either case, as a key word is: `n'abc'`,
	// `x'0A'`, `u&'…'`, `0x1F` and `1e5`.

	// <unsigned numeric literal>. An approximate one is an exact one and an exponent, so it is
	// asked first; an integer in another radix begins with a `0`, so it is asked before the
	// decimal one. A digit may follow an underscore, once: `1_000` and not `1__0`.
	UnsignedNumericLiteral     = ApproximateNumericLiteral | ExactNumericLiteral
	ApproximateNumericLiteral  = ExactNumericLiteral & 'E'i & Sign? & UnsignedDecimalInteger
	ExactNumericLiteral        = UnsignedDecimalInteger & '.' & UnsignedDecimalInteger?
	                           | '.' & UnsignedDecimalInteger
	                           | UnsignedInteger
	Sign                       = ['+' | '-']
	UnsignedInteger            = UnsignedHexadecimalInteger | UnsignedOctalInteger | UnsignedBinaryInteger | UnsignedDecimalInteger
	UnsignedDecimalInteger     = Digit & ('_'? & Digit)*
	UnsignedHexadecimalInteger = "0X"i & ('_'? & Hexit)+
	UnsignedOctalInteger       = "0O"i & ('_'? & OctalDigit)+
	UnsignedBinaryInteger      = "0B"i & ('_'? & BinaryDigit)+

	// <character string literal>: quoted parts with '' for a quote inside, which a separator
	// may divide — `'a' 'b'` is one literal — and in front of them, optionally, the character
	// set they are written in: `_latin1'abc'`. The introducer's name is a part of the token,
	// with nothing between it and the quote.
	CharacterStringLiteral  = '\'' & CharacterStringRest
	CharacterStringRest     = QuotedRest(CharacterRepresentation)
	CharacterRepresentation = [^ '\''] | "''"
	QuotedParts(part)       = '\'' & QuotedRest(part)
	QuotedRest(part)        = part* & '\'' & (Separator & '\'' & part* & '\'')*
	Introducer              = '_'

	// <character set name> as it stands after an introducer: a schema's name, and a catalog's
	// before it, and then an <SQL language identifier>. Said as a run, since a name the chain
	// could still go on from is not yet the last. The names are identifiers, so §5.4's Syntax
	// Rule reaches inside the token: `_select.latin1'a'` is refused.
	IntroducedCharacterSet : @CharacterSetName = (q: IntroducedName & '.'){0,2} & l: SQLLanguageIdentifier => @(Nodes.CharacterSet(q, l))
	IntroducedName : @Identifier
		= t: UnicodeDelimitedIdentifier => @(Nodes.UnicodeIdentifier(t))
		| ?!ReservedWordWhole & t: RegularIdentifier => @(new Identifier(t))
		| t: DelimitedIdentifier => @(new Identifier(t, IdentifierStyle.Delimited))

	// <character string literal> and <Unicode character string literal> with an introducer.
	// §5.4's Syntax Rule reaches inside this token — a character set name is no reserved word —
	// and a lexical pattern cannot say so, a lookahead in one not being regular. So the lexer
	// reads the introducer and the rule reads the rest (docs/syntax.md §7): that rule is a
	// recognizer over characters, where a lookahead is allowed and its refusal is the token's.
	// The mechanism asks that nothing else begin the same way, and nothing does: IdentifierStart
	// is letters and letter numbers, so no name begins with `_`.
	//
	// The parts are captured rather than searched for afterwards, which is what `_u&".s".x'a'`
	// and `_u&"'s".x'a'` needed: a period inside a delimited name divided the character set, and
	// a quote inside one began the literal.
	// The terminal is the introducer and one operand the lexer cannot read, which is the shape a
	// continuation has to have: a sequence whose last part is a rule with no regular reading.
	IntroducedStringLiteral : @LiteralValue = Introducer & v: IntroducedRest => @(v)
	// The character set is read once and the body behind it, which is the shared operand written
	// in front rather than read twice.
	IntroducedRest : @LiteralValue = s: IntroducedCharacterSet & v: IntroducedBody => @(Nodes.IntroducedIn(s, v))
	IntroducedBody : @LiteralValue
		= 'U'i & '&' & t: QuotedParts(UnicodeRepresentation) & e: UnicodeEscapeSpecifier
			=> @(Nodes.IntroducedString(t, StringLiteralKind.Unicode, e))
		| t: QuotedParts(CharacterRepresentation)
			=> @(Nodes.IntroducedString(t, StringLiteralKind.Character, null))

	// <SQL language identifier>: a Latin letter, then Latin letters, digits and underscores.
	SQLLanguageIdentifier = SimpleLatinLetter & (SimpleLatinLetter | Digit | '_')*

	// <multiplier>, of a large object's length: `2 K` and the one token `2K` alike. A letter, and a
	// whole word.
	Multiplier = ['K' | 'M' | 'G' | 'T' | 'P' | 'k' | 'm' | 'g' | 't' | 'p']

	// §5.2 guards a key word on both sides: a word that runs into the number before it is no key
	// word, so `CHAR(198OCTETS)` is refused where `CHAR(198 OCTETS)` is read. Over kinds that is a
	// token of its own, and no position accepts it — `2K` still reads, because a multiplier is one
	// letter and the longest match there is the length's own token.
	GluedWord   = UnsignedNumericLiteral & IdentifierStart & IdentifierPart*

	// `2K` is a length and its multiplier written as one token, which is what the comment on
	// <large object length> means. It matches as far as GluedWord does, so the kind holds both
	// and a position that wants a length takes it; `2KB` is the glued word alone, and refused.
	LengthToken = UnsignedInteger & Multiplier

	// <national character string literal>, <Unicode character string literal>, and <binary
	// string literal>, whose hexits come in pairs that spaces may stand between.
	NationalCharacterStringLiteral = 'N'i & '\'' & NationalStringRest
	NationalStringRest             = QuotedRest(CharacterRepresentation)
	UnicodeCharacterStringLiteral  = 'U'i & '&' & '\'' & UnicodeStringRest
	UnicodeStringRest              = QuotedRest(UnicodeRepresentation) & UnicodeEscapeSpecifier
	UnicodeRepresentation          = UnicodeEscapeValue | CharacterRepresentation
	BinaryStringLiteral            = 'X'i & '\'' & BinaryStringRest
	BinaryStringRest               = QuotedRest(BinaryPart)
	BinaryPart                     = Space | Hexit & Space* & Hexit

	// <date string>, <time string>, <timestamp string>, <interval string>: a string whose
	// characters are a value of the type. A <datetime value> is an unsigned integer, so
	// `'2020-1-1'` is a date string.
	DateString      = '\'' & DateValue & '\''
	TimeString      = '\'' & TimeValue & TimeZoneInterval? & '\''
	TimestampString = '\'' & DateValue & Space & TimeValue & TimeZoneInterval? & '\''
	DateValue        = UnsignedDecimalInteger & '-' & UnsignedDecimalInteger & '-' & UnsignedDecimalInteger
	TimeValue        = UnsignedDecimalInteger & ':' & UnsignedDecimalInteger & ':' & SecondsValue
	TimeZoneInterval = Sign & UnsignedDecimalInteger & ':' & UnsignedDecimalInteger
	SecondsValue     = UnsignedDecimalInteger & ('.' & UnsignedDecimalInteger?)?

	// <interval string>. A year-month and a day-time literal, and a day-time literal's forms,
	// begin alike — `'5'` is a year, a day, an hour, a minute and a second — so each form is
	// asked to reach the closing quote before the next is tried: a form that stops short of it
	// would otherwise be taken, and `'5.5'` read as an hour followed by what no string holds.
	IntervalString   = '\'' & Sign? & (YearMonthLiteral | DayTimeLiteral) & '\''
	YearMonthLiteral = UnsignedDecimalInteger & ('-' & UnsignedDecimalInteger)?
	DayTimeLiteral   = DayTimeInterval
	                 | TimeInterval
	DayTimeInterval  = UnsignedDecimalInteger & (Space & UnsignedDecimalInteger & (':' & UnsignedDecimalInteger & (':' & SecondsValue)?)?)?
	TimeInterval     = UnsignedDecimalInteger & (':' & UnsignedDecimalInteger & (':' & SecondsValue)?)?
	                 | UnsignedDecimalInteger & (':' & SecondsValue)?
	                 | SecondsValue

	// ── §5.2 <reserved word> ─────────────────────────────────────────────────
	//
	// The whole list, as the standard gives it, and a whole word: `ABSOLUTE` is not `ABS`.
	//
	// Lexical, and not a list of key words at the top, because a key word there is guarded on
	// both sides and §5.4's Syntax Rule is asked inside a token too: after an introducer the `_`
	// stands before the name, and a guarded `SELECT` would take the `_` for a letter before it
	// and let `_select.latin1'a'` through.
	ReservedWord
		= ("ABS"i | "ABSENT"i | "ACOS"i | "ALL"i | "ALLOCATE"i | "ALTER"i | "AND"i | "ANY"i
		| "ANY_VALUE"i | "ARE"i | "ARRAY"i | "ARRAY_AGG"i | "ARRAY_MAX_CARDINALITY"i | "AS"i
		| "ASENSITIVE"i | "ASIN"i | "ASYMMETRIC"i | "AT"i | "ATAN"i | "ATOMIC"i | "AUTHORIZATION"i
		| "AVG"i | "BEGIN"i | "BEGIN_FRAME"i | "BEGIN_PARTITION"i | "BETWEEN"i | "BIGINT"i | "BINARY"i
		| "BLOB"i | "BOOLEAN"i | "BOTH"i | "BTRIM"i | "BY"i | "CALL"i | "CALLED"i | "CARDINALITY"i
		| "CASCADED"i | "CASE"i | "CAST"i | "CEIL"i | "CEILING"i | "CHAR"i | "CHAR_LENGTH"i
		| "CHARACTER"i | "CHARACTER_LENGTH"i | "CHECK"i | "CLASSIFIER"i | "CLOB"i | "CLOSE"i
		| "COALESCE"i | "COLLATE"i | "COLLECT"i | "COLUMN"i | "COMMIT"i | "CONDITION"i | "CONNECT"i
		| "CONSTRAINT"i | "CONTAINS"i | "CONVERT"i | "COPY"i | "CORR"i | "CORRESPONDING"i | "COS"i
		| "COSH"i | "COUNT"i | "COVAR_POP"i | "COVAR_SAMP"i | "CREATE"i | "CROSS"i | "CUBE"i
		| "CUME_DIST"i | "CURRENT"i | "CURRENT_CATALOG"i | "CURRENT_DATE"i
		| "CURRENT_DEFAULT_TRANSFORM_GROUP"i | "CURRENT_PATH"i | "CURRENT_ROLE"i | "CURRENT_ROW"i
		| "CURRENT_SCHEMA"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i
		| "CURRENT_TRANSFORM_GROUP_FOR_TYPE"i | "CURRENT_USER"i | "CURSOR"i | "CYCLE"i | "DATE"i
		| "DAY"i | "DEALLOCATE"i | "DEC"i | "DECFLOAT"i | "DECIMAL"i | "DECLARE"i | "DEFAULT"i
		| "DEFINE"i | "DELETE"i | "DENSE_RANK"i | "DEREF"i | "DESCRIBE"i | "DETERMINISTIC"i
		| "DISCONNECT"i | "DISTINCT"i | "DOUBLE"i | "DROP"i | "DYNAMIC"i | "EACH"i | "ELEMENT"i
		| "ELSE"i | "EMPTY"i | "END"i | "END_FRAME"i | "END_PARTITION"i | "END-EXEC"i | "EQUALS"i
		| "ESCAPE"i | "EVERY"i | "EXCEPT"i | "EXEC"i | "EXECUTE"i | "EXISTS"i | "EXP"i | "EXTERNAL"i
		| "EXTRACT"i | "FALSE"i | "FETCH"i | "FILTER"i | "FIRST_VALUE"i | "FLOAT"i | "FLOOR"i | "FOR"i
		| "FOREIGN"i | "FRAME_ROW"i | "FREE"i | "FROM"i | "FULL"i | "FUNCTION"i | "FUSION"i | "GET"i
		| "GLOBAL"i | "GRANT"i | "GREATEST"i | "GROUP"i | "GROUPING"i | "GROUPS"i | "HAVING"i | "HOLD"i
		| "HOUR"i | "IDENTITY"i | "IN"i | "INDICATOR"i | "INITIAL"i | "INNER"i | "INOUT"i
		| "INSENSITIVE"i | "INSERT"i | "INT"i | "INTEGER"i | "INTERSECT"i | "INTERSECTION"i
		| "INTERVAL"i | "INTO"i | "IS"i | "JOIN"i | "JSON"i | "JSON_ARRAY"i | "JSON_ARRAYAGG"i
		| "JSON_EXISTS"i | "JSON_OBJECT"i | "JSON_OBJECTAGG"i | "JSON_QUERY"i | "JSON_SCALAR"i
		| "JSON_SERIALIZE"i | "JSON_TABLE"i | "JSON_TABLE_PRIMITIVE"i | "JSON_VALUE"i | "LAG"i
		| "LANGUAGE"i | "LARGE"i | "LAST_VALUE"i | "LATERAL"i | "LEAD"i | "LEADING"i | "LEAST"i
		| "LEFT"i | "LIKE"i | "LIKE_REGEX"i | "LISTAGG"i | "LN"i | "LOCAL"i | "LOCALTIME"i
		| "LOCALTIMESTAMP"i | "LOG"i | "LOG10"i | "LOWER"i | "LPAD"i | "LTRIM"i | "MATCH"i
		| "MATCH_NUMBER"i | "MATCH_RECOGNIZE"i | "MATCHES"i | "MAX"i | "MEMBER"i | "MERGE"i | "METHOD"i
		| "MIN"i | "MINUTE"i | "MOD"i | "MODIFIES"i | "MODULE"i | "MONTH"i | "MULTISET"i | "NATIONAL"i
		| "NATURAL"i | "NCHAR"i | "NCLOB"i | "NEW"i | "NO"i | "NONE"i | "NORMALIZE"i | "NOT"i
		| "NTH_VALUE"i | "NTILE"i | "NULL"i | "NULLIF"i | "NUMERIC"i | "OCCURRENCES_REGEX"i
		| "OCTET_LENGTH"i | "OF"i | "OFFSET"i | "OLD"i | "OMIT"i | "ON"i | "ONE"i | "ONLY"i | "OPEN"i
		| "OR"i | "ORDER"i | "OUT"i | "OUTER"i | "OVER"i | "OVERLAPS"i | "OVERLAY"i | "PARAMETER"i
		| "PARTITION"i | "PATTERN"i | "PER"i | "PERCENT"i | "PERCENT_RANK"i | "PERCENTILE_CONT"i
		| "PERCENTILE_DISC"i | "PERIOD"i | "PORTION"i | "POSITION"i | "POSITION_REGEX"i | "POWER"i
		| "PRECEDES"i | "PRECISION"i | "PREPARE"i | "PRIMARY"i | "PROCEDURE"i | "PTF"i | "RANGE"i
		| "RANK"i | "READS"i | "REAL"i | "RECURSIVE"i | "REF"i | "REFERENCES"i | "REFERENCING"i
		| "REGR_AVGX"i | "REGR_AVGY"i | "REGR_COUNT"i | "REGR_INTERCEPT"i | "REGR_R2"i | "REGR_SLOPE"i
		| "REGR_SXX"i | "REGR_SXY"i | "REGR_SYY"i | "RELEASE"i | "RESULT"i | "RETURN"i | "RETURNS"i
		| "REVOKE"i | "RIGHT"i | "ROLLBACK"i | "ROLLUP"i | "ROW"i | "ROW_NUMBER"i | "ROWS"i | "RPAD"i
		| "RTRIM"i | "RUNNING"i | "SAVEPOINT"i | "SCOPE"i | "SCROLL"i | "SEARCH"i | "SECOND"i | "SEEK"i
		| "SELECT"i | "SENSITIVE"i | "SESSION_USER"i | "SET"i | "SHOW"i | "SIMILAR"i | "SIN"i | "SINH"i
		| "SKIP"i | "SMALLINT"i | "SOME"i | "SPECIFIC"i | "SPECIFICTYPE"i | "SQL"i | "SQLEXCEPTION"i
		| "SQLSTATE"i | "SQLWARNING"i | "SQRT"i | "START"i | "STATIC"i | "STDDEV_POP"i | "STDDEV_SAMP"i
		| "SUBMULTISET"i | "SUBSET"i | "SUBSTRING"i | "SUBSTRING_REGEX"i | "SUCCEEDS"i | "SUM"i
		| "SYMMETRIC"i | "SYSTEM"i | "SYSTEM_TIME"i | "SYSTEM_USER"i | "TABLE"i | "TABLESAMPLE"i
		| "TAN"i | "TANH"i | "THEN"i | "TIME"i | "TIMESTAMP"i | "TIMEZONE_HOUR"i | "TIMEZONE_MINUTE"i
		| "TO"i | "TRAILING"i | "TRANSLATE"i | "TRANSLATE_REGEX"i | "TRANSLATION"i | "TREAT"i
		| "TRIGGER"i | "TRIM"i | "TRIM_ARRAY"i | "TRUE"i | "TRUNCATE"i | "UESCAPE"i | "UNION"i
		| "UNIQUE"i | "UNKNOWN"i | "UNNEST"i | "UPDATE"i | "UPPER"i | "USER"i | "USING"i | "VALUE"i
		| "VALUES"i | "VALUE_OF"i | "VAR_POP"i | "VAR_SAMP"i | "VARBINARY"i | "VARCHAR"i | "VARYING"i
		| "VERSIONING"i | "WHEN"i | "WHENEVER"i | "WHERE"i | "WIDTH_BUCKET"i | "WINDOW"i | "WITH"i
		| "WITHIN"i | "WITHOUT"i | "YEAR"i)
		// No guard on the end: as a kind this has to be regular, and over kinds the lexer takes the
		// longest word there is, so `ABSOLUTE` is one word and never `ABS` with a tail. Read over
		// characters, where there is no longest match, the whole word is what is wanted — that is
		// ReservedWordWhole below, and it is what an introduced name asks.

	ReservedWordWhole = ReservedWord & ?!IdentifierPart

	// A question mark in a <row pattern quantifier>. `??(` and `??)` are the trigraph brackets, each one
	// token (§5.2), so a question mark that begins one is not a quantifier's: `(A??)` is refused.
	// Lexical, so that `(A? ?)` — two question marks and a bracket — is not taken for one.
	PatternQuestionMark = '?'
}

// §5.2: a key word is a whole word, so `ABSOLUTE` is a name and not `ABS` and what follows it.
// Over kinds a word is the longest one the lexer can take, so nothing has to be said about what
// may follow a key word; what may precede one is GluedWord, in the lexical namespace above.
// wordboundary is therefore not written here.

// §5.2: tokens may be separated by a <separator>, and nothing else stands between them.
trivia       = { Separator? }

// ── §5.3 Literals ───────────────────────────────────────────────────────────

Literal         : @LiteralValue = v: SignedNumericLiteral => @(v) | v: GeneralLiteral => @(v)
UnsignedLiteral : @LiteralValue = t: UnsignedNumericLiteral => @(Nodes.NumericLiteral(t)) | v: GeneralLiteral => @(v)

// <general literal>. What begins with a letter is asked before what may begin with the same
// letter as a name would — none of these is a name, and the typed literals begin with key words.
//
// A literal keeps what was written from its first quote to its last, the letter that begins it and
// its introducer apart: `N'a' 'b'` is a national string whose text is `'a' 'b'`.
GeneralLiteral : @LiteralValue
	= t: NationalCharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.National))
	| t: UnicodeCharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.Unicode))
	| t: BinaryStringLiteral => @(Nodes.BinaryLiteral(t))
	| t: CharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.Character))
	| v: IntroducedStringLiteral => @(v)
	| v: DatetimeLiteral => @(v)
	| v: IntervalLiteral => @(v)
	| v: BooleanLiteral => @(v)

// A sign and a number are one literal, and its text is both.
SignedNumericLiteral : @LiteralValue = s: Sign? & n: UnsignedNumericLiteral => @(Nodes.NumericLiteral(s + n))

DatetimeLiteral  : @LiteralValue = v: DateLiteral => @(v) | v: TimeLiteral => @(v) | v: TimestampLiteral => @(v)
DateLiteral      : @LiteralValue = "DATE"i & t: DateString => @(new LiteralValue.DateTime(DateTimeLiteralKind.Date, t))
TimeLiteral      : @LiteralValue = "TIME"i & t: TimeString => @(new LiteralValue.DateTime(DateTimeLiteralKind.Time, t))
TimestampLiteral : @LiteralValue = "TIMESTAMP"i & t: TimestampString => @(new LiteralValue.DateTime(DateTimeLiteralKind.Timestamp, t))
IntervalLiteral  : @LiteralValue = "INTERVAL"i & s: Sign? & t: IntervalString & q: IntervalQualifier => @(new LiteralValue.Interval(t, q, Nodes.SignOf(s)))
BooleanLiteral   : @LiteralValue = t: ("TRUE"i | "FALSE"i | "UNKNOWN"i) => @(Nodes.BooleanLiteral(t))

// ── §10.1 Interval qualifier ────────────────────────────────────────────────
//
// Here because an interval literal ends in one.

IntervalQualifier : @IntervalQualifier
	= s: StartField & "TO"i & e: EndField => @(Nodes.Qualifier(s, e))
	| f: SingleDatetimeField => @(f)

StartField : @IntervalQualifier = f: NonSecondPrimaryDatetimeField & ('(' & p: IntervalLeadingFieldPrecision & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p)))

EndField : @IntervalQualifier
	= f: NonSecondPrimaryDatetimeField => @(new IntervalQualifier(Nodes.Field(f)))
	| f: "SECOND"i & ('(' & p: IntervalFractionalSecondsPrecision & ')')? => @(new IntervalQualifier(Nodes.Field(f), null, null, Nodes.Integer(p)))

SingleDatetimeField : @IntervalQualifier
	= f: NonSecondPrimaryDatetimeField & ('(' & p: IntervalLeadingFieldPrecision & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p)))
	| f: "SECOND"i & ('(' & p: IntervalLeadingFieldPrecision & (',' & q: IntervalFractionalSecondsPrecision)? & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p), null, Nodes.Integer(q)))

NonSecondPrimaryDatetimeField      = "YEAR"i | "MONTH"i | "DAY"i | "HOUR"i | "MINUTE"i
IntervalFractionalSecondsPrecision = UnsignedInteger
IntervalLeadingFieldPrecision      = UnsignedInteger

// ── §5.4 Names and identifiers ──────────────────────────────────────────────

// <identifier>. §5.2 cuts a text into its longest tokens, so a name is one token, and reading over
// kinds is what makes that true here: the lexer hands over a whole name and there is no place to cut
// it differently. Over characters the same had to be said with braces, which also made the rule
// lexical — and a lexical rule cannot hold the lookahead below, which is why it is written here.
Identifier : @Identifier = ?!ReservedWord & i: ActualIdentifier => @(i)

// <actual identifier>. A Unicode one begins `U&`, which a regular identifier would take the
// `U` of, so it is asked first. §5.4's Syntax Rule is the lookahead: a regular identifier is
// no reserved word, in any case.
ActualIdentifier : @Identifier
	= t: UnicodeDelimitedIdentifier => @(Nodes.UnicodeIdentifier(t))
	| t: RegularIdentifier => @(new Identifier(t))
	| t: DelimitedIdentifier => @(new Identifier(t, IdentifierStyle.Delimited))

// <table name>, <local or schema qualified name>: a name, a schema's before it and a catalog's
// before that, or `MODULE` for a module's own. The standard nests the qualifiers, and an ordered
// choice would take the longest one and leave no name for the end, so the names are a run.
TableName                  : @QualifiedName = n: LocalOrSchemaQualifiedName => @(n)
LocalOrSchemaQualifiedName : @QualifiedName = m: LocalQualifier & '.' & q: QualifiedIdentifier => @(Nodes.Named(m, q))
                                            | first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
LocalQualifier             = "MODULE"i
QualifiedIdentifier        : @Identifier = i: Identifier => @(i)

// <schema name>: a catalog's name may stand before it.
SchemaName            : @QualifiedName = first: CatalogName & ('.' & rest: UnqualifiedSchemaName)? => @(Nodes.Chain(first, rest))
UnqualifiedSchemaName : @Identifier = i: Identifier => @(i)
CatalogName           : @Identifier = i: Identifier => @(i)

ColumnName : @Identifier = i: Identifier => @(i)

// §6.6 <identifier chain>, and a column reference made of one.
IdentifierChain      : @QualifiedName = first: Identifier & ('.' & rest: Identifier)* => @(Nodes.Chain(first, rest))
BasicIdentifierChain : @QualifiedName = n: IdentifierChain => @(n)

ColumnReference : @Expression
	= n: BasicIdentifierChain => @(new Expression.Reference(n))
	| m: "MODULE"i & '.' & q: QualifiedIdentifier & '.' & c: ColumnName => @(new Expression.Reference(Nodes.Named(m, q, c)))

SchemaQualifiedName             : @QualifiedName = first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
PathResolvedUserDefinedTypeName : @QualifiedName = first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
RoutineName                     : @QualifiedName = first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
MethodName                      : @Identifier = i: Identifier => @(i)

// ── §6.1 Data types ─────────────────────────────────────────────────────────

// <data type>, with <collection type>'s `ARRAY` and `MULTISET` written after it as often as they
// stand there: the BNF says `<data type> ARRAY`, which recurses through itself on the left.
DataType             : @DataType = b: DataTypeBase & { (trivia & s: CollectionTypeSuffix)* } => @(Nodes.Collected(b, s))
DataTypeBase         : @DataType
	= t: PredefinedType => @(t)
	| t: RowType => @(t)
	| t: ReferenceType => @(t)
	| n: PathResolvedUserDefinedTypeName => @(new DataType.UserDefined(n))
CollectionTypeSuffix : @Nodes.Suffix
	= "ARRAY"i & (l: LeftBracketOrTrigraph & n: UnsignedInteger & RightBracketOrTrigraph)? => @(Nodes.ArraySuffix(l, n))
	| "MULTISET"i => @(Nodes.MultisetSuffix())

PredefinedType : @DataType
	= t: CharacterStringType & ("CHARACTER"i & "SET"i & cs: CharacterSetSpecification)? & c: CollateClause? => @(Nodes.Characters(t, cs, c))
	| t: NationalCharacterStringType & c: CollateClause? => @(Nodes.Characters(t, null, c))
	| t: BinaryStringType => @(t)
	| t: NumericType => @(t)
	| "BOOLEAN"i => @(new DataType.Boolean())
	| t: DatetimeType => @(t)
	| "INTERVAL"i & q: IntervalQualifier => @(new DataType.Interval(q))
	| "JSON"i => @(new DataType.Json())

// The character string types. A type the BNF spells as a longer one's beginning — `CHARACTER`
// before `CHARACTER VARYING` — is asked after it, so that the choice does not take the beginning
// and leave the rest. Each keeps which of its spellings was written.
CharacterStringType : @DataType
	= w: ("CHARACTER"i | "CHAR"i) & "VARYING"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character(w + " VARYING", l))
	| w: ("CHARACTER"i | "CHAR"i) & "LARGE"i & "OBJECT"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character(w + " LARGE OBJECT", l))
	| w: ("CHARACTER"i | "CHAR"i) & ('(' & l: CharacterLength & ')')? => @(Nodes.Character(w, l))
	| "VARCHAR"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("VARCHAR", l))
	| "CLOB"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("CLOB", l))

NationalCharacterStringType : @DataType
	= "NATIONAL"i & w: ("CHARACTER"i | "CHAR"i) & "VARYING"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NATIONAL " + w + " VARYING", l))
	| "NATIONAL"i & "CHARACTER"i & "LARGE"i & "OBJECT"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("NATIONAL CHARACTER LARGE OBJECT", l))
	| "NATIONAL"i & w: ("CHARACTER"i | "CHAR"i) & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NATIONAL " + w, l))
	| "NCHAR"i & "VARYING"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NCHAR VARYING", l))
	| "NCHAR"i & "LARGE"i & "OBJECT"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("NCHAR LARGE OBJECT", l))
	| "NCHAR"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NCHAR", l))
	| "NCLOB"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("NCLOB", l))

BinaryStringType : @DataType
	= "BINARY"i & "VARYING"i & ('(' & n: UnsignedInteger & ')')? => @(Nodes.Binary("BINARY VARYING", n, null))
	| "BINARY"i & "LARGE"i & "OBJECT"i & ('(' & s: LargeObjectLength & ')')? => @(Nodes.Binary("BINARY LARGE OBJECT", null, s))
	| "BINARY"i & ('(' & n: UnsignedInteger & ')')? => @(Nodes.Binary("BINARY", n, null))
	| "VARBINARY"i & ('(' & n: UnsignedInteger & ')')? => @(Nodes.Binary("VARBINARY", n, null))
	| "BLOB"i & ('(' & s: LargeObjectLength & ')')? => @(Nodes.Binary("BLOB", null, s))

NumericType : @DataType
	= w: ("NUMERIC"i | "DECIMAL"i | "DEC"i) & ('(' & p: UnsignedInteger & (',' & s: UnsignedInteger)? & ')')? => @(Nodes.NumericType(w, p, s))
	| w: ("SMALLINT"i | "INTEGER"i | "INT"i | "BIGINT"i | "REAL"i) => @(Nodes.NumericType(w, null, null))
	| w: "FLOAT"i & ('(' & p: UnsignedInteger & ')')? => @(Nodes.NumericType(w, p, null))
	| "DOUBLE"i & "PRECISION"i => @(Nodes.NumericType("DOUBLE PRECISION", null, null))
	| w: "DECFLOAT"i & ('(' & p: UnsignedInteger & ')')? => @(Nodes.NumericType(w, p, null))

DatetimeType : @DataType
	= "DATE"i => @(new DataType.DateTime(DateTimeTypeKind.Date))
	| w: ("TIME"i | "TIMESTAMP"i) & ('(' & p: UnsignedInteger & ')')? & (z: ("WITH"i | "WITHOUT"i) & "TIME"i & "ZONE"i)? => @(Nodes.DateTime(w, p, z))

// <character length>, <large object length>: `2 K` is a length and `2K` one token of it.
CharacterLength            : @Nodes.Length = ?!GluedWord & n: UnsignedInteger & u: CharLengthUnits? => @(Nodes.LengthOf(n, u))
CharacterLargeObjectLength : @Nodes.Length = s: LargeObjectLength & u: CharLengthUnits? => @(Nodes.LengthOf(s, u))
LargeObjectLength          : @LargeObjectSize
	= t: LengthToken => @(Nodes.Size(t))
	| n: UnsignedInteger & m: Multiplier? => @(Nodes.Size(n, m))
CharLengthUnits            = "CHARACTERS"i | "OCTETS"i

RowType         : @DataType = "ROW"i & '(' & first: FieldDefinition & (',' & rest: FieldDefinition)* & ')' => @(new DataType.Row(Nodes.List(first, rest)))
FieldDefinition : @FieldDefinition = n: Identifier & t: DataType => @(new FieldDefinition(n, t))
ReferenceType   : @DataType = "REF"i & '(' & n: PathResolvedUserDefinedTypeName & ')' & ("SCOPE"i & s: TableName)? => @(new DataType.Reference(n, s))

// <character set specification>, <character set name>: names, and an SQL language identifier last.
CharacterSetSpecification : @CharacterSetName = (q: Identifier & '.'){0,2} & l: SQLLanguageIdentifier => @(Nodes.CharacterSet(q, l))

CollateClause : @CollationName = "COLLATE"i & n: SchemaQualifiedName => @(new CollationName(n))

LeftBracketOrTrigraph  = "??(" | '['
RightBracketOrTrigraph = "??)" | ']'

// ── §6.28 Value expressions, §8.1 Boolean value expressions ────────────────
//
// The BNF types its value expressions — a numeric one, a character one, a datetime one, an
// interval one and more — as towers that meet only in a <value expression primary>, and a
// <value expression> is any of them or a boolean or a row. An ordered choice cannot try them one
// after another: each would take the first operand and stop. So each is read once, in the shape
// they share, and what a piece can still be comes back beside its node (Towers.cs): a guard refuses a
// reading that is none of them. `a || b + c` is refused, `x + y AT LOCAL` read and `x - y AT LOCAL`
// refused, as the BNF has them.

// <value expression>. A value that is no boolean is a boolean primary with nothing around it, so
// the boolean reading is the one reading. A datetime less a datetime is read the same way and is
// no value: only a bracket takes it (`Bracketed`), for a qualifier to make an interval of it.
ValueExpression : @Towers.Typed = e: Disjunction & when @((Towers.RolesOf(e) & ~Towers.Difference) != 0) => @(e)

// <boolean value expression>, <search condition>: what only a boolean can be, or a predicand.
BooleanValueExpression : @Towers.Typed = e: Disjunction & when @((Towers.RolesOf(e) & Towers.Truth) != 0) => @(e)
SearchCondition        : @Towers.Typed = e: BooleanValueExpression => @(e)

// `OR`, `AND` and `NOT` join booleans; a term with none of them is whatever it is.
Disjunction   : @Towers.Typed = first: Conjunction & rest: OrOperand* & when @(Towers.Connect(first, rest) != 0) => @(Towers.Connected(first, rest, BinaryOperator.Or))
OrOperand     : @Towers.Typed = "OR"i & e: Conjunction => @(e)
Conjunction   : @Towers.Typed = first: BooleanFactor & rest: AndOperand* & when @(Towers.Connect(first, rest) != 0) => @(Towers.Connected(first, rest, BinaryOperator.And))
AndOperand    : @Towers.Typed = "AND"i & e: BooleanFactor => @(e)
BooleanFactor : @Towers.Typed = "NOT"i & e: BooleanTest & when @((Towers.RolesOf(e) & Towers.Truth) != 0) => @(new Towers.Typed(new Expression.Unary(UnaryOperator.Not, e.Node), Towers.Logical | Towers.Truth))
                              | e: BooleanTest => @(e)

// <boolean test>: `IS TRUE`, `IS NOT UNKNOWN`.
BooleanTest : @Towers.Typed = e: BooleanPrimary & t: TruthTest & when @(!Nodes.TestedOf(t) || (Towers.RolesOf(e) & Towers.Truth) != 0) => @(t.Tested ? new Towers.Typed(new Expression.IsTruth(e.Node, t.Not, t.Value), Towers.Logical | Towers.Truth) : e)
TruthTest   : @Nodes.Truth = "IS"i & n: "NOT"i? & v: TruthValue => @(new Nodes.Truth(true, n is not null, Nodes.Truthful(v)))
                           | none => @(default)
TruthValue  = "TRUE"i | "FALSE"i | "UNKNOWN"i

// <boolean primary>: a predicate, or a boolean predicand. Almost every predicate begins with a row
// value predicand, so the predicand is read once and what follows it says which: nothing, and it is
// a predicand; a predicate's second part, and it is that predicate, if the second part takes it.
BooleanPrimary : @Towers.Typed
	= "EXISTS"i & q: TableSubquery => @(new Towers.Typed(new Expression.Exists(q), Towers.Logical | Towers.Truth))
	| j: JSONExistsPredicate => @(new Towers.Typed(j, Towers.Logical | Towers.Truth))
	| "UNIQUE"i & ("NULLS"i & n: "NOT"i? & d: "DISTINCT"i)? & q: TableSubquery => @(new Towers.Typed(new Expression.Unique(Nodes.Nulls(d, n), q), Towers.Logical | Towers.Truth))
	| p: PeriodConstructor & t: PeriodPredicatePart2 => @(new Towers.Typed(t with { Left = p }, Towers.Logical | Towers.Truth))
	| e: CommonValueExpressionOrRow & takes: PredicatePart2Mark & when @(Towers.RolesOf(takes) == 0 || (Towers.RolesOf(e) & Towers.RolesOf(takes)) != 0) => @(takes.Roles == 0 ? e : new Towers.Typed(Nodes.Predicated(e.Node, takes.Node!), Towers.Logical | Towers.Truth))

PredicatePart2Mark : @Towers.Tail = p: PredicatePart2 => @(p)
                                  | none => @(default)

// <predicate>: a boolean primary that is not only a predicand.
Predicate : @Towers.Typed = e: BooleanPrimary & when @((Towers.RolesOf(e) & Towers.Logical) != 0) => @(e)

// ── §8 Predicates ───────────────────────────────────────────────────────────
//
// The second parts, which is what the BNF calls them too: each says what it takes before it. Most
// take any row value predicand; a JSON predicate a string or a JSON value; a period predicate a
// period's name. Each builds its predicate with the left side empty, and `Nodes.Predicated` puts the
// predicand in.
//
// A quantified comparison is asked after a comparison: `ANY ((SELECT …))` and `SOME ((SELECT …))`
// are aggregates of a scalar subquery too, and read as one they may go on — `a = ANY ((SELECT a FROM
// t)) + 1` — where the quantifier's reading would stop.
PredicatePart2 : @Towers.Tail
	= o: CompOp & compared: ComparisonTail => @(new Towers.Tail(Towers.Any, Nodes.Compared(compared, o)))
	| "MATCH"i & u: "UNIQUE"i? & m: ("SIMPLE"i | "PARTIAL"i | "FULL"i)? & q: TableSubquery => @(new Towers.Tail(Towers.Any, new Expression.Match(null!, u is not null, Nodes.Matching(m), q)))
	| n: "NOT"i? & negatable: NegatablePredicatePart2 => @(new Towers.Tail(Towers.Any, Nodes.Negated(negatable, n is not null)))
	| "IS"i & n: "NOT"i? & tested: IsPredicatePart2 => @(tested with { Node = Nodes.Negated(tested.Node!, n is not null) })
	| "OVERLAPS"i & r: RowValuePredicand => @(new Towers.Tail(Towers.Any, new Expression.Overlaps(null!, r.Node)))
	| i: JSONInputClause & "IS"i & n: "NOT"i? & "JSON"i & y: JSONPredicateTypeConstraint? & k: JSONKeyUniquenessConstraint? => @(new Towers.Tail(Towers.String | Towers.Json, new Expression.JsonPredicate(null!, i, n is not null, Nodes.JsonType(y), Nodes.Uniqueness(k))))
	| period: PeriodPredicatePart2 => @(new Towers.Tail(Towers.Chain, period))

// What follows a comparison's operator: a row value predicand, or a quantifier and a subquery.
ComparisonTail : @Expression
	= r: RowValuePredicand => @(new Expression.Comparison(null!, default, r.Node))
	| w: ("ALL"i | "SOME"i | "ANY"i) & q: TableSubquery => @(new Expression.QuantifiedComparison(null!, default, Nodes.Quantified(w), q))

// <comp op>, the longer operators first.
CompOp = "<>" | "<=" | ">=" | '=' | '<' | '>'

// What may stand after `NOT`: <between predicate part 2>, <in predicate part 2>, <like predicate>'s
// — a character pattern or a binary one, with an escape of the same kind — <similar predicate part
// 2>, <regex like predicate part 2>, <member predicate part 2>, <submultiset predicate part 2>.
NegatablePredicatePart2 : @Expression
	= "BETWEEN"i & s: ("ASYMMETRIC"i | "SYMMETRIC"i)? & l: RowValuePredicand & "AND"i & h: RowValuePredicand => @(new Expression.Between(null!, false, Nodes.Symmetry(s), l.Node, h.Node))
	| "IN"i & q: TableSubquery => @(new Expression.In(null!, false, new InSource.Query(q)))
	| "IN"i & '(' & { first: RowValueExpression & (',' & rest: RowValueExpression)* } & ')' => @(new Expression.In(null!, false, new InSource.Values(Nodes.Values(first, rest))))
	| "LIKE"i & p: StringValueExpression & e: LikeEscape & when @((Towers.RolesOf(p) & Towers.RolesOf(e) & Towers.String) != 0) => @(new Expression.Like(null!, false, LikeKind.Like, p.Node, e.Node))
	| "SIMILAR"i & "TO"i & p: CharacterValueExpression & ("ESCAPE"i & x: CharacterNode)? => @(new Expression.Like(null!, false, LikeKind.Similar, p.Node, x))
	| "LIKE_REGEX"i & p: CharacterValueExpression & ("FLAG"i & f: CharacterNode)? => @(new Expression.Like(null!, false, LikeKind.Regex, p.Node, null, f))
	| m: ("MEMBER"i | "SUBMULTISET"i) & o: "OF"i? & c: MultisetValueExpression => @(Nodes.Membership(m, o is not null, c.Node))

LikeEscape : @Towers.Typed = "ESCAPE"i & e: StringValueExpression => @(e)
                           | none => @(new Towers.Typed(null!, Towers.String))

// What may stand after `IS` and `NOT`: <null predicate part 2>, <normalized predicate part 2>,
// <distinct predicate part 2>, <set predicate part 2>, <type predicate part 2>, <JSON predicate>'s.
IsPredicatePart2 : @Towers.Tail
	= "NULL"i => @(new Towers.Tail(Towers.Any, new Expression.IsNull(null!, false)))
	| f: NormalForm? & "NORMALIZED"i => @(new Towers.Tail(Towers.Any, new Expression.IsNormalized(null!, false, Nodes.Form(f))))
	| "DISTINCT"i & "FROM"i & r: RowValuePredicand => @(new Towers.Tail(Towers.Any, new Expression.IsDistinct(null!, false, r.Node)))
	| "A"i & "SET"i => @(new Towers.Tail(Towers.Any, new Expression.IsSet(null!, false)))
	| "OF"i & '(' & first: UserDefinedTypeSpecification & (',' & rest: UserDefinedTypeSpecification)* & ')' => @(new Towers.Tail(Towers.Any, new Expression.IsOf(null!, false, Nodes.List(first, rest))))
	| "JSON"i & y: JSONPredicateTypeConstraint? & k: JSONKeyUniquenessConstraint? => @(new Towers.Tail(Towers.String | Towers.Json, new Expression.JsonPredicate(null!, null, false, Nodes.JsonType(y), Nodes.Uniqueness(k))))

NormalForm                   = "NFC"i | "NFD"i | "NFKC"i | "NFKD"i
UserDefinedTypeSpecification : @TypeTest = o: "ONLY"i? & n: PathResolvedUserDefinedTypeName => @(new TypeTest(n, o is not null))

// <JSON input clause>, <JSON representation>, and what a JSON predicate asks of the value.
JSONInputClause             : @JsonInputClause = "FORMAT"i & r: JSONRepresentation => @(new JsonInputClause(r))
JSONRepresentation          : @JsonRepresentation = "JSON"i & ("ENCODING"i & e: ("UTF8"i | "UTF16"i | "UTF32"i))? => @(new JsonRepresentation(Nodes.Encoding(e)))
JSONPredicateTypeConstraint = "VALUE"i | "ARRAY"i | "OBJECT"i | "SCALAR"i
// The `KEYS` is taken and not given back: in two of the four places this constraint stands, what
// follows it is an expression, and an expression may begin with a name — `KEYS` is a legal one.
// Over kinds a reading that fits is the one that stands, so the braces say the same thing over
// characters and the grammar reads one way in both (GRAM5009). Every engine reads the word as
// the key word there too.
JSONKeyUniquenessConstraint = ("WITH"i | "WITHOUT"i) & "UNIQUE"i & { "KEYS"i? }

// <period predicate>: a period, named or constructed, and another, or a point in time it contains.
// The left side is filled in by `BooleanPrimary` or `Nodes.Predicated`.
PeriodPredicatePart2 : @Expression.PeriodPredicate
	= o: ("OVERLAPS"i | "EQUALS"i | "PRECEDES"i | "SUCCEEDS"i) & r: PeriodPredicand => @(new Expression.PeriodPredicate(null!, Nodes.Period(o, false), new PeriodRight.Period(r)))
	| "IMMEDIATELY"i & o: ("PRECEDES"i | "SUCCEEDS"i) & r: PeriodPredicand => @(new Expression.PeriodPredicate(null!, Nodes.Period(o, true), new PeriodRight.Period(r)))
	| "CONTAINS"i & contained: PeriodContained => @(new Expression.PeriodPredicate(null!, PeriodOperator.Contains, contained))
PeriodContained   : @PeriodRight = d: DatetimeValueExpression => @(new PeriodRight.Point(d.Node))
                                 | p: PeriodPredicand => @(new PeriodRight.Period(p))
PeriodPredicand   : @PeriodValue = c: PeriodConstructor => @(c)
                                 | n: IdentifierChain => @(new PeriodValue.Reference(n))
PeriodConstructor : @PeriodValue = "PERIOD"i & '(' & s: DatetimeValueExpression & ',' & e: DatetimeValueExpression & ')' => @(new PeriodValue.Range(s.Node, e.Node))

// ── §7.1 Row value constructors, as far as a predicate needs them ───────────

// <row value predicand>: a common value expression — which a boolean predicand in brackets and a
// value expression primary already are — or an explicit row value constructor. A row is read where a
// bracket is (`Bracketed`), and `ROW (…)` where a primary begins; a row subquery is written as a
// scalar subquery is, and read as one.
RowValuePredicand : @Towers.Typed = e: CommonValueExpressionOrRow & when @((Towers.RolesOf(e) & ~Towers.Difference) != 0) => @(e)

// <row value expression>: a value expression primary not in brackets, or an explicit row. So
// `x IN (a + 1)` is refused by the BNF, whose <in value list> holds row value expressions.
RowValueExpression : @Towers.Typed = e: CommonValueExpressionOrRow & when @((Towers.RolesOf(e) & (Towers.Row | Towers.Bare)) != 0) => @(e)

// ── §6.28 Common value expressions ──────────────────────────────────────────

// <common value expression>: operands and the operators between them, which Towers.cs holds to
// the towers and builds the node of. An explicit row is an operand in shape, and something only
// alone: where a row may stand, the one reading serves both.
CommonValueExpressionOrRow : @Towers.Typed = first: Operand & rest: Operated* & when @(Towers.Common(first, rest) != 0) => @(Towers.Expression(first, rest))
CommonValueExpression      : @Towers.Typed = e: CommonValueExpressionOrRow & when @((Towers.RolesOf(e) & Towers.Value) != 0) => @(e)

// Not productions: the operators the towers share, read once for all of them. `||` joins character,
// binary and array operands; `MULTISET UNION`, `EXCEPT` and `INTERSECT` multisets; `*`, `/`, `+`
// and `-` numbers, intervals and datetimes.
Operated : @Towers.Operated = o: Operator & e: Operand => @(new Towers.Operated(o, e))
Operator : @Towers.Op
	= "||" => @(new Towers.Op(Towers.Concatenate))
	| "MULTISET"i & m: ("UNION"i | "EXCEPT"i | "INTERSECT"i) & q: ("ALL"i | "DISTINCT"i)? => @(new Towers.Op(Towers.MultisetOperator, Nodes.Multiset(m), Nodes.Quantifier(q)))
	| '*' => @(new Towers.Op(Towers.Times))
	| '/' => @(new Towers.Op(Towers.Divided))
	| '+' => @(new Towers.Op(Towers.Plus))
	| '-' => @(new Towers.Op(Towers.Minus))

// Not a production: what every tower's factor is made of. A sign (<factor>, <interval factor>),
// a primary, and what may follow one: an interval qualifier (<interval primary>), a time zone
// (<datetime factor>), a collate clause (<character factor>), or a type's name (<specific type
// method>), which is a character value function and may be collated in turn.
Operand : @Towers.Piece = s: Sign? & p: Primary & x: Postfix & when @(Towers.OperandRoles(Nodes.SignOf(s), p, x) != 0) => @(new Towers.Piece(Nodes.SignOf(s), p, x))
Postfix : @Towers.After
	= '.' & w: "SPECIFICTYPE"i & b: ('(' & ')')? & c: CollateClause => @(new Towers.After(Towers.TypedCollated, new Expression.Collate(Nodes.SpecificType(w, b), c)))
	| '.' & w: "SPECIFICTYPE"i & b: ('(' & ')')? => @(new Towers.After(Towers.Typed_, Nodes.SpecificType(w, b)))
	| q: IntervalQualifier => @(new Towers.After(Towers.Qualified, new Expression.IntervalQualified(null!, q)))
	| z: TimeZone => @(new Towers.After(Towers.Zoned, z))
	| c: CollateClause => @(new Towers.After(Towers.Collated, new Expression.Collate(null!, c)))
	| none => @(Towers.After.None)

// <time zone>. The zone is an interval primary: a value expression primary with or without a
// qualifier, or an interval's `ABS`. `AT LOCAL` names no zone.
TimeZone        : @Expression = "AT"i & z: TimeZoneSpecifier => @(new Expression.AtTimeZone(null!, z.Node))
TimeZoneSpecifier : @Towers.Typed = "LOCAL"i => @(new Towers.Typed(null!, 0))
                                  | "TIME"i & "ZONE"i & z: IntervalPrimary => @(z)
IntervalPrimary : @Towers.Typed = p: Primary & q: IntervalQualifier? & when @(q is not null ? (Towers.RolesOf(p) & Towers.Value) == Towers.Value : (Towers.RolesOf(p) & Towers.Interval) != 0) => @(new Towers.Typed(q is null ? p.Node : new Expression.IntervalQualified(p.Node, q), Towers.Interval))

// Not a production: a primary of any tower. A value function is of the tower it names; an array's
// may be subscripted, and is then a value expression primary.
Primary : @Towers.Typed
	= f: ValueFunction & s: FunctionSubscript & when @(Towers.RolesOf(s) == 0 || (Towers.RolesOf(f) & Towers.Array) != 0) => @(Towers.Stepped(f, s))
	| p: PrimaryReading => @(p)

FunctionSubscript : @Towers.Stepping = e: ArrayElementStep & s: PrimaryStep* => @(Towers.Subscripted(e, s))
                                     | none => @(Towers.Stepping.None)

// The towers, each an expression the towers say it can be.
NumericValueExpression    : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Numeric) != 0) => @(e)
StringValueExpression     : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.String) != 0) => @(e)
CharacterValueExpression  : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Character) != 0) => @(e)
BinaryValueExpression     : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Binary) != 0) => @(e)
DatetimeValueExpression   : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Datetime) != 0) => @(e)
IntervalValueExpression   : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Interval) != 0) => @(e)
ArrayValueExpression      : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Array) != 0) => @(e)
MultisetValueExpression   : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Multiset) != 0) => @(e)
CollectionValueExpression : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & (Towers.Array | Towers.Multiset)) != 0) => @(e)

// Not productions: a tower's node alone, where a rule keeps the node and asks nothing of its towers —
// and where it may be left out, which a node says by being null.
ValueNode     : @Expression = e: ValueExpression => @(e.Node)
CharacterNode : @Expression = e: CharacterValueExpression => @(e.Node)

// ── §6.3 Value expression primary ───────────────────────────────────────────

// <value expression primary>: a common value expression that is one — which a subscripted
// concatenation is too (Towers.cs). A non-parenthesized one is `Towers.Bare`, asked where it stands.
ValueExpressionPrimary : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & (Towers.Bare | Towers.Parenthesized)) != 0) => @(e)

// Not a production: a primary read as one. <field reference>, <method invocation>, <attribute or
// method reference> and <array element reference> each begin with a value expression primary,
// which is left recursion through other productions; they are steps after one here, as many as
// there are. A primary in brackets is a parenthesized one only while no step follows it, and a row
// takes no step.
//
// A bracket is read before a <scalar subquery>, and a guard declines it where the subquery is the
// reading: `((SELECT a FROM t))` is both, and only the subquery is a non-parenthesized primary,
// which an in value list asks for. Asking the subquery first cost a reading of everything below every
// bracket -- 200 rule entries a character at a depth of 800, against 12.5 at any depth now.
PrimaryReading : @Towers.Typed
	= b: Bracketed & s: PrimarySteps & when @((Towers.RolesOf(s) == 0 || (Towers.RolesOf(b) & Towers.Row) == 0) && !Nodes.WrapsQuery(b)) => @(Towers.Stepped(b, s))
	| q: ScalarSubquery & s: PrimarySteps => @(Towers.Stepped(new Towers.Typed(new Expression.Subquery(q), Towers.Value | Towers.Truth | Towers.Bare), s))
	| p: PrimaryBase & s: PrimarySteps & when @(Towers.RolesOf(s) == 0 || (Towers.RolesOf(p) & Towers.Row) == 0) => @(Towers.Stepped(p, s))

// Not a production: a bracket, read once. A <parenthesized value expression>, an <explicit row value
// constructor> and a <generalized invocation> each begin with a bracket and a value expression, and
// what follows the value expression says which: the closing bracket, a comma, or `AS`. Tried one
// after another, each read the bracket's contents again, and a line refused deep inside nested
// brackets cost a power of their depth — eight of them, 46 ms. A generalized invocation's value
// expression is a primary.
Bracketed : @Towers.Typed = '(' & e: Disjunction & t: BracketTail & when @(Nodes.Brackets(e, t)) => @(Nodes.Bracketed(e, t))

BracketTail : @Towers.Bracket
	= ')' => @(new Towers.Bracket(Towers.Parenthesized))
	| (',' & rest: ValueNode)+ & ')' => @(new Towers.Bracket(Towers.Row, rest))
	| "AS"i & t: DataType & ')' & '.' & m: MethodName & a: SQLArgumentList? => @(new Towers.Bracket(Towers.Bare, null, t, m, a))

PrimarySteps : @Towers.Stepping = s: PrimaryStep* => @(new Towers.Stepping(Towers.Steps(s), s))
//
// With them the operations of a <JSON simplified accessor>, which is a primary and its operations:
// `.*`, an item method — asked before a method, since its names are mostly reserved words and its
// arguments are fixed — `[*]`, and subscripts in the path language, asked after an array element's.
PrimaryStep : @Towers.Step
	= '.' & '*' => @(new Towers.Step(Towers.Bare | Towers.Starred, new Expression.Wildcard(null!, WildcardKind.Member)))
	| '.' & j: JSONMethod => @(new Towers.Step(Towers.Bare, j))
	| '.' & m: MethodName & a: SQLArgumentList? => @(new Towers.Step(Towers.Bare, new Expression.Member(null!, MemberAccessKind.Dot, m, a)))
	| "->" & m: Identifier & a: SQLArgumentList? => @(new Towers.Step(Towers.Bare, new Expression.Member(null!, MemberAccessKind.Dereference, m, a)))
	| e: ArrayElementStep => @(e)
	| '[' & '*' & ']' => @(new Towers.Step(Towers.Bare, new Expression.Wildcard(null!, WildcardKind.Array)))
	| '[' & first: JSONSubscript & (',' & rest: JSONSubscript)* & ']' => @(new Towers.Step(Towers.Bare, new Expression.JsonAccessor(null!, new JsonPathAccessor.Array(Nodes.List(first, rest)))))

ArrayElementStep : @Towers.Step = l: LeftBracketOrTrigraph & i: NumericValueExpression & RightBracketOrTrigraph => @(new Towers.Step(Towers.Subscript, new Expression.Element(null!, i.Node, null, l == "??(")))

// Not a production: what a non-parenthesized primary begins with. A name followed by arguments is
// a routine's, and a name followed by a method call stops before the method: `a.b.c.d(1)` is
// `a.b.c` and a method `d`.
PrimaryBase : @Towers.Typed
	= literal: UnsignedLiteral => @(new Towers.Typed(new Expression.Literal(literal), Towers.Value | Towers.Truth | Towers.Bare))
	| "ROW"i & '(' & first: ValueNode & (',' & rest: ValueNode)* & ')' => @(new Towers.Typed(new Expression.Row(Nodes.List(first, rest), true), Towers.Row))
	| v: GeneralValueSpecification => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: CaseExpression => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: CastSpecification => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: NextValueExpression => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: SubtypeTreatment => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: NewSpecification => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: ReferenceResolution => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: CollectionValueConstructor => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: MultisetElementReference => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: GreatestOrLeastFunction => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: StaticMethodInvocation => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: WindowedFunction => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: JSONValueFunction => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: JSONQuery => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: JSONObjectConstructor => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: JSONArrayConstructor => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: RowPatternNavigationOperation => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: RoutineInvocation => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare | Towers.Invoked))
	| m: "MODULE"i & '.' & q: QualifiedIdentifier & '.' & c: ColumnName => @(new Towers.Typed(new Expression.Reference(Nodes.Named(m, q, c)), Towers.Value | Towers.Truth | Towers.Bare))
	| i: Identifier & chained: ChainOrMeasure => @(Nodes.ChainOrMeasure(i, chained))

// After a name: the rest of an identifier chain, or `OVER` and a window, which makes the name a
// <window row pattern measure>'s.
ChainOrMeasure : @Towers.Chained = o: WindowOver => @(new Towers.Chained(true, null, o))
                                 | ('.' & rest: Identifier & ?!'(')* => @(new Towers.Chained(false, rest))

// <general value specification>, but an SQL parameter reference, which is an identifier chain and
// read as one; <embedded variable specification> is left to a host language.
GeneralValueSpecification : @Expression
	= ':' & n: Identifier & (k: "INDICATOR"i? & ':' & i: Identifier)? => @(Nodes.HostParameter(n, i, k is not null))
	| '?' => @(new Expression.Parameter(ParameterKind.Dynamic))
	| "COLLATION"i & "FOR"i & '(' & v: StringValueExpression & ')' => @(new Expression.CollationFor(v.Node))
	| "CURRENT_TRANSFORM_GROUP_FOR_TYPE"i & t: PathResolvedUserDefinedTypeName => @(new Expression.Current(CurrentValue.TransformGroupForType, t))
	| w: ("CURRENT_CATALOG"i | "CURRENT_DEFAULT_TRANSFORM_GROUP"i | "CURRENT_PATH"i | "CURRENT_ROLE"i
	  | "CURRENT_SCHEMA"i | "CURRENT_USER"i | "SESSION_USER"i | "SYSTEM_USER"i | "USER"i | "VALUE"i) => @(Nodes.Current(w))

// <case expression>.
CaseExpression : @Expression
	= w: "NULLIF"i & '(' & a: ValueNode & ',' & b: ValueNode & ')' => @(Nodes.Invoked(w, a, [b]))
	| w: "COALESCE"i & '(' & first: ValueNode & (',' & rest: ValueNode)+ & ')' => @(Nodes.Invoked(w, first, rest))
	| "CASE"i & o: RowValuePredicand & { (trivia & whens: SimpleWhenClause)+ } & e: ElseClause? & "END"i => @(new Expression.Case(o.Node, whens, e))
	| "CASE"i & { (trivia & whens: SearchedWhenClause)+ } & e: ElseClause? & "END"i => @(new Expression.Case(null, whens, e))

SimpleWhenClause   : @CaseWhen = "WHEN"i & first: WhenOperand & (',' & rest: WhenOperand)* & "THEN"i & r: Result => @(new CaseWhen(Nodes.List(first, rest), r))
SearchedWhenClause : @CaseWhen = "WHEN"i & c: SearchCondition & "THEN"i & r: Result => @(new CaseWhen(Nodes.List(c.Node, null), r))
ElseClause         : @Expression = "ELSE"i & r: Result => @(r)
Result             : @Expression = v: ValueNode => @(v)
                                 | "NULL"i => @(Nodes.Null())

// <when operand>: a row value predicand, or a predicate's second part with nothing before it — any
// but a JSON predicate's and a period predicate's — whose missing left side is the case operand.
// Of those two, the ones that begin with a word a name may be spelled with (`FORMAT JSON IS JSON`,
// `IMMEDIATELY PRECEDES`) are left out in front as well as by the guard: then the two alternatives
// begin apart, and a second part that fails is not a reading the predicand replaces.
WhenOperand : @Expression = ?!("FORMAT"i | "IMMEDIATELY"i) & p: PredicatePart2 & when @(Towers.RolesOf(p) == Towers.Any) => @(Nodes.Predicated(new Expression.CaseOperand(), p.Node!))
                          | r: RowValuePredicand => @(r.Node)

// <cast specification>. A domain's name is a user-defined type's in shape, and <data type> reads it.
CastSpecification : @Expression = "CAST"i & '(' & v: CastOperand & "AS"i & t: DataType & ("FORMAT"i & f: CharacterStringLiteral)? & ')' => @(new Expression.Cast(v, t, f))
CastOperand       : @Expression = v: ValueNode => @(v)
                                | v: ImplicitlyTypedValueSpecification => @(v)

ImplicitlyTypedValueSpecification   : @Expression = "NULL"i => @(Nodes.Null())
                                                  | w: ("ARRAY"i | "MULTISET"i) & l: LeftBracketOrTrigraph & RightBracketOrTrigraph => @(Nodes.Collection(w, l, null, null))
ContextuallyTypedValueSpecification : @Expression = v: ImplicitlyTypedValueSpecification => @(v)
                                                  | "DEFAULT"i => @(new Expression.Default())

NextValueExpression      : @Expression = "NEXT"i & "VALUE"i & "FOR"i & n: SchemaQualifiedName => @(new Expression.NextValue(n))
SubtypeTreatment         : @Expression = "TREAT"i & '(' & v: ValueNode & "AS"i & t: TargetSubtype & ')' => @(new Expression.Treat(v, t))
TargetSubtype            : @DataType = r: ReferenceType => @(r)
                                     | n: PathResolvedUserDefinedTypeName => @(new DataType.UserDefined(n))
NewSpecification         : @Expression = "NEW"i & n: PathResolvedUserDefinedTypeName & a: SQLArgumentList => @(new Expression.New(n, a))
ReferenceResolution      : @Expression = "DEREF"i & '(' & v: ValueExpressionPrimary & ')' => @(new Expression.Dereference(v.Node))
MultisetElementReference : @Expression = w: "ELEMENT"i & '(' & v: MultisetValueExpression & ')' => @(Nodes.Invoked(w, v.Node, null))
GreatestOrLeastFunction  : @Expression = w: ("GREATEST"i | "LEAST"i) & '(' & first: ValueNode & (',' & rest: ValueNode)+ & ')' => @(Nodes.Invoked(w, first, rest))
StaticMethodInvocation   : @Expression = t: PathResolvedUserDefinedTypeName & "::" & m: MethodName & a: SQLArgumentList? => @(new Expression.Member(new Expression.Reference(t), MemberAccessKind.StaticMethod, m, a))
RoutineInvocation        : @Expression = n: RoutineName & a: SQLArgumentList => @(new Expression.Invocation(n, a))

// <collection value constructor>: by enumeration, and by query — `TABLE (…)` is a multiset's.
CollectionValueConstructor : @Expression
	= w: ("ARRAY"i | "MULTISET"i) & l: LeftBracketOrTrigraph & first: ValueNode & (',' & rest: ValueNode)* & RightBracketOrTrigraph => @(Nodes.Collection(w, l, first, rest))
	| w: ("ARRAY"i | "MULTISET"i | "TABLE"i) & q: TableSubquery => @(new Expression.CollectionQuery(Nodes.CollectionKindOf(w), q))

// <SQL argument list>, but table and descriptor arguments. A named argument is asked first, since
// its name would otherwise be read as a value.
SQLArgumentList : @IReadOnlyList<Argument> = '(' & { first: SQLArgument & (',' & rest: SQLArgument)* }? & ')' => @(Nodes.Arguments(first, rest))
SQLArgument : @Argument
	= n: Identifier & "=>" & v: ArgumentValue => @(new Argument(v, n, true))
	| v: ValueNode & ("AS"i & t: PathResolvedUserDefinedTypeName)? => @(new Argument(t is null ? v : new Expression.Generalized(v, new DataType.UserDefined(t))))
	| v: ContextuallyTypedValueSpecification => @(new Argument(v))
ArgumentValue : @Expression = v: ValueNode => @(v)
                            | v: ContextuallyTypedValueSpecification => @(v)

// ── §6.30–6.36 Value functions ──────────────────────────────────────────────

// Not a production: a function of some tower, and the tower it is of. `ABS` is a number's and an
// interval's both.
ValueFunction : @Towers.Typed
	= numeric: NumericValueFunction => @(new Towers.Typed(numeric, Towers.Numeric))
	| absolute: AbsoluteValue => @(absolute)
	| text: StringValueFunction => @(new Towers.Typed(text, Towers.String))
	| datetime: DatetimeValueFunction => @(new Towers.Typed(datetime, Towers.Datetime))
	| w: "TRIM_ARRAY"i & '(' & array: ArrayValueExpression & ',' & count: NumericValueExpression & ')' => @(new Towers.Typed(Nodes.Call(w, array.Node, count.Node), Towers.Array))
	| w: "SET"i & '(' & multiset: MultisetValueExpression & ')' => @(new Towers.Typed(Nodes.Call(w, multiset.Node), Towers.Multiset))
	| json: JSONTypedValueFunction => @(new Towers.Typed(json, Towers.Json))

// <absolute value expression>, <interval absolute value function>.
AbsoluteValue : @Towers.Typed = w: "ABS"i & '(' & e: CommonValueExpression & ')' & when @((Towers.RolesOf(e) & (Towers.Numeric | Towers.Interval)) != 0) => @(new Towers.Typed(Nodes.Call(w, e.Node), e.Roles & (Towers.Numeric | Towers.Interval)))

// <numeric value function>, but `ABS`.
NumericValueFunction : @Expression
	= position: PositionExpression => @(position)
	| "OCCURRENCES_REGEX"i & '(' & r: RegexSearch & ')' => @(Nodes.Regex(RegexFunction.OccurrencesRegex, r))
	// `AFTER` is no reserved word, so `AFTER (x) IN y` is both a flag before `(x)` and a call of
	// `after`: the search is looked at whole to say which, and that look is the language's (Q7.1 §5).
	| "POSITION_REGEX"i & '(' & (where: ("START"i | "AFTER"i) & ?=RegexSearch)? & r: RegexSearch & ("OCCURRENCE"i & occurrence: NumericNode)? & ("GROUP"i & grouping: NumericNode)? & ')' => @(Nodes.Regex(RegexFunction.PositionRegex, r) with { StartOrAfter = Nodes.StartOrAfter(where), Occurrence = occurrence, Group = grouping })
	| extract: ExtractExpression => @(extract)
	| w: ("CHAR_LENGTH"i | "CHARACTER_LENGTH"i) & '(' & v: CharacterValueExpression & ("USING"i & u: CharLengthUnits)? & ')' => @(new Expression.Length(Nodes.LengthFunctionOf(w), v.Node, Nodes.UnitsOf(u)))
	| "OCTET_LENGTH"i & '(' & v: StringValueExpression & ')' => @(new Expression.Length(LengthFunction.OctetLength, v.Node, null))
	| w: "CARDINALITY"i & '(' & c: CollectionValueExpression & ')' => @(Nodes.Call(w, c.Node))
	| w: "ARRAY_MAX_CARDINALITY"i & '(' & c: ArrayValueExpression & ')' => @(Nodes.Call(w, c.Node))
	| w: ("MOD"i | "LOG"i | "POWER"i) & '(' & x: NumericValueExpression & ',' & y: NumericValueExpression & ')' => @(Nodes.Call(w, x.Node, y.Node))
	| w: ("SIN"i | "COS"i | "TAN"i | "SINH"i | "COSH"i | "TANH"i | "ASIN"i | "ACOS"i | "ATAN"i
	  | "LOG10"i | "LN"i | "EXP"i | "SQRT"i | "FLOOR"i | "CEIL"i | "CEILING"i) & '(' & x: NumericValueExpression & ')' => @(Nodes.Call(w, x.Node))
	| w: "WIDTH_BUCKET"i & '(' & x: NumericValueExpression & ',' & y: NumericValueExpression & ',' & z: NumericValueExpression & ',' & t: NumericValueExpression & ')' => @(Nodes.Call(w, x.Node, y.Node, z.Node, t.Node))
	| w: "MATCH_NUMBER"i & '(' & ')' => @(Nodes.Call(w))

// <character position expression>, <binary position expression>.
PositionExpression : @Expression = "POSITION"i & '(' & a: StringValueExpression & "IN"i & b: StringValueExpression & u: UsingUnits & ')' & when @(Towers.Characters(Towers.RolesOf(a) & Towers.RolesOf(b), u > 0)) => @(new Expression.Position(a.Node, b.Node, Nodes.UnitsOf(u)))

// What the regular expression functions share: a pattern, its flags, the string searched, and where.
RegexSearch : @Nodes.Search = p: CharacterValueExpression & ("FLAG"i & f: CharacterNode)? & "IN"i & v: CharacterValueExpression & ("FROM"i & start: NumericNode)? & ("USING"i & u: CharLengthUnits)? => @(new Nodes.Search(p.Node, f, v.Node, start, Nodes.UnitsOf(u)))

// <extract expression>: a datetime's field, or an interval's.
ExtractExpression : @Expression = "EXTRACT"i & '(' & f: ExtractField & "FROM"i & e: CommonValueExpression & ')' & when @((Towers.RolesOf(e) & (Towers.Datetime | Towers.Interval)) != 0) => @(new Expression.Extract(Nodes.ExtractFieldOf(f), e.Node))
ExtractField      = NonSecondPrimaryDatetimeField | "SECOND"i | "TIMEZONE_HOUR"i | "TIMEZONE_MINUTE"i

// Which units were named: none (0), characters (1), octets (2).
UsingUnits : @int = "USING"i & u: CharLengthUnits => @(Nodes.UnitCode(u))
                  | none => @(0)

// <string value function>, but <specific type method>, which follows a primary (`Primary`).
StringValueFunction : @Expression
	= substring: SubstringFunction => @(substring)
	| serialize: JSONSerialize => @(serialize)
	| "SUBSTRING_REGEX"i & '(' & r: RegexSearch & ("OCCURRENCE"i & occurrence: NumericNode)? & ("GROUP"i & grouping: NumericNode)? & ')' => @(Nodes.Regex(RegexFunction.SubstringRegex, r) with { Occurrence = occurrence, Group = grouping })
	| w: ("UPPER"i | "LOWER"i) & '(' & v: CharacterValueExpression & ')' => @(Nodes.Call(w, v.Node))
	| w: ("CONVERT"i | "TRANSLATE"i) & '(' & v: CharacterValueExpression & "USING"i & n: SchemaQualifiedName & ')' => @(new Expression.TranslateUsing(Nodes.TranslateOf(w), v.Node, n))
	| "TRANSLATE_REGEX"i & '(' & p: CharacterValueExpression & ("FLAG"i & f: CharacterNode)? & "IN"i & v: CharacterValueExpression
	  & ("WITH"i & replacement: CharacterNode)? & ("FROM"i & start: NumericNode)? & ("USING"i & u: CharLengthUnits)?
	  & ("OCCURRENCE"i & (occurrence: NumericNode | all: "ALL"i))? & ')' => @(new Expression.Regex(RegexFunction.TranslateRegex, p.Node, v.Node) { Flag = f, Replacement = replacement, From = start, Using = Nodes.UnitsOf(u), Occurrence = occurrence, AllOccurrences = all is not null })
	| w: ("LPAD"i | "RPAD"i) & '(' & v: CharacterValueExpression & ',' & l: NumericValueExpression & (',' & pad: CharacterNode)? & ')' => @(Nodes.Call(w, v.Node, l.Node, pad))
	| trim: TrimFunction => @(trim)
	| w: ("BTRIM"i | "LTRIM"i | "RTRIM"i) & '(' & v: CharacterValueExpression & (',' & characters: CharacterNode)? & ')' => @(Nodes.Call(w, v.Node, characters))
	| overlay: OverlayFunction => @(overlay)
	| "NORMALIZE"i & '(' & v: CharacterValueExpression & (',' & form: NormalForm & (',' & length: CharacterLargeObjectLength)?)? & ')' => @(Nodes.Normalized(v.Node, form, length))
	| w: "CLASSIFIER"i & '(' & variable: Identifier? & ')' => @(Nodes.Call(w, variable is null ? null : new Expression.Reference(new QualifiedName([variable]))))

// <character substring function>, <binary substring function>, <regular expression substring
// function>. All three begin with the string, which is read once and what follows it says which: the
// last is a character string's alone.
SubstringFunction : @Expression = "SUBSTRING"i & '(' & s: StringValueExpression & t: SubstringTail & ')' & when @(Nodes.SubstringFits(s, t)) => @(Nodes.Substring(s.Node, t))

SubstringTail : @Nodes.SubstringParts
	= "FROM"i & start: NumericNode & ("FOR"i & length: NumericNode)? & u: UsingUnits => @(new Nodes.SubstringParts(u > 0 ? 1 : 0, start, length, Nodes.UnitsOf(u), null, null))
	| "SIMILAR"i & pattern: CharacterNode & "ESCAPE"i & escape: CharacterNode => @(new Nodes.SubstringParts(2, null, null, null, pattern, escape))

// <single-character trim function>, <binary trim function>: what is trimmed, and from what, of one kind.
TrimFunction : @Expression = "TRIM"i & '(' & t: TrimOperands & ')' & when @((Nodes.RolesOf(t) & Towers.String) != 0) => @(Nodes.Trimmed(t))
//
// <trim operands> is `[ [ spec ] [ character ] FROM ] source`. What the operands begin with is read
// once: a specification, `FROM`, or a string that is the source or, with `FROM` after it, the
// character trimmed.
TrimOperands : @Nodes.TrimParts
	= spec: TrimSpecification & after: TrimAfterSpecification => @(after with { Specification = Nodes.TrimSpecificationOf(spec) })
	| "FROM"i & source: StringValueExpression => @(new Nodes.TrimParts(source.Roles, null, null, true, source.Node))
	| c: StringValueExpression & f: TrimFrom => @(f.Node is null ? new Nodes.TrimParts(c.Roles, null, null, false, c.Node) : new Nodes.TrimParts(c.Roles & f.Roles, null, c.Node, true, f.Node))

TrimAfterSpecification : @Nodes.TrimParts
	= "FROM"i & source: StringValueExpression => @(new Nodes.TrimParts(source.Roles, null, null, true, source.Node))
	| c: StringValueExpression & "FROM"i & source: StringValueExpression => @(new Nodes.TrimParts(c.Roles & source.Roles, null, c.Node, true, source.Node))

TrimFrom : @Towers.Typed = "FROM"i & s: StringValueExpression => @(s)
                         | none => @(Towers.Typed.None)
TrimSpecification = "LEADING"i | "TRAILING"i | "BOTH"i

// <character overlay function>, <binary overlay function>.
OverlayFunction : @Expression = "OVERLAY"i & '(' & a: StringValueExpression & "PLACING"i & b: StringValueExpression & "FROM"i & start: NumericNode & ("FOR"i & length: NumericNode)? & u: UsingUnits & ')' & when @(Towers.Characters(Towers.RolesOf(a) & Towers.RolesOf(b), u > 0)) => @(new Expression.Overlay(a.Node, b.Node, start, length, Nodes.UnitsOf(u)))

// <datetime value function>.
DatetimeValueFunction : @Expression
	= "CURRENT_DATE"i => @(new Expression.Current(CurrentValue.Date))
	| w: ("CURRENT_TIMESTAMP"i | "CURRENT_TIME"i | "LOCALTIMESTAMP"i | "LOCALTIME"i) & ('(' & p: UnsignedInteger & ')')? => @(Nodes.CurrentTime(w, p))

// Not a production: a numeric value expression's node alone, where one may be left out.
NumericNode : @Expression = e: NumericValueExpression => @(e.Node)

// ── §6.10 Window function, §6.11 Nested window function, §10.9 Aggregate function ──

// <set function specification>, <window function>, <nested window function>. A window function's
// type may be an aggregate, so an aggregate is read once, with `OVER` after it or not; `RUNNING` and
// `FINAL` stand before one only where it is not a window's.
WindowedFunction : @Expression
	= s: ("RUNNING"i | "FINAL"i) & a: AggregateFunction => @(Nodes.WithSemantics(a, s))
	| a: AggregateFunction & o: WindowOver? => @(Nodes.WithOver(a, o))
	| w: "GROUPING"i & '(' & first: ColumnReference & (',' & rest: ColumnReference)* & ')' => @(Nodes.Invoked(w, first, rest))
	| w: ("RANK"i | "DENSE_RANK"i | "PERCENT_RANK"i | "CUME_DIST"i | "ROW_NUMBER"i) & '(' & ')' & o: WindowOver => @(Nodes.Call(w) with { Over = o })
	| w: "NTILE"i & '(' & n: SimpleOrDynamicValue & ')' & o: WindowOver => @(Nodes.Call(w, n) with { Over = o })
	| w: ("LEAD"i | "LAG"i) & '(' & v: ValueNode & (',' & offset: UnsignedInteger & (',' & otherwise: ValueNode)?)? & ')' & t: NullTreatment? & o: WindowOver => @(Nodes.Call(w, v, offset is null ? null : new Expression.Literal(Nodes.NumericLiteral(offset)), otherwise) with { Nulls = Nodes.NullTreatmentOf(t), Over = o })
	| w: ("FIRST_VALUE"i | "LAST_VALUE"i) & '(' & v: ValueNode & ')' & t: NullTreatment? & o: WindowOver => @(Nodes.Call(w, v) with { Nulls = Nodes.NullTreatmentOf(t), Over = o })
	| w: "NTH_VALUE"i & '(' & v: ValueNode & ',' & n: SimpleOrDynamicValue & ')' & ("FROM"i & end: ("FIRST"i | "LAST"i))? & t: NullTreatment? & o: WindowOver => @(Nodes.Call(w, v, n) with { From = Nodes.FirstOrLast(end), Nulls = Nodes.NullTreatmentOf(t), Over = o })
	| w: "ROW_NUMBER"i & '(' & m: RowMarker & ')' => @(Nodes.Call(w, Nodes.Marked(m, null, null)))
	| "VALUE_OF"i & '(' & v: ValueNode & "AT"i & m: RowMarker & (d: ['+' | '-'] & delta: SimpleOrDynamicValue)? & (',' & otherwise: ValueNode)? & ')' => @(new Expression.ValueOf(v, Nodes.Marked(m, d, delta), otherwise))

// <window name or specification>, after `OVER`.
WindowOver                : @WindowReference = "OVER"i & r: WindowNameOrSpecification => @(r)
WindowNameOrSpecification : @WindowReference = n: WindowName => @(new WindowReference.NameRef(n))
                                             | s: WindowSpecification => @(new WindowReference.Specification(s))
NullTreatment = ("RESPECT"i | "IGNORE"i) & "NULLS"i
RowMarker     = "BEGIN_PARTITION"i | "BEGIN_FRAME"i | "CURRENT_ROW"i | "FRAME_ROW"i | "END_FRAME"i | "END_PARTITION"i

// What <number of tiles>, <nth row>, <row marker offset> and a row pattern navigation's offsets are:
// a simple value specification, or a dynamic parameter.
SimpleOrDynamicValue : @Expression = v: SimpleValueSpecification => @(v)
                                   | '?' => @(new Expression.Parameter(ParameterKind.Dynamic))

// <aggregate function>. A <row pattern count function>, `COUNT(v.*)`, is `COUNT` of a value too, whose
// `v.*` is a JSON accessor, with the same verdict; written apart, a refused line read each twice.
AggregateFunction : @Expression = a: AggregateCall & f: FilterClause? => @(f is null ? a : Nodes.Filtered(a, f))
FilterClause      : @FilterClause = "FILTER"i & '(' & "WHERE"i & c: SearchCondition & ')' => @(new FilterClause(c.Node))

AggregateCall : @Expression
	= w: "COUNT"i & '(' & '*' & ')' => @(Nodes.Call(w, new Expression.Asterisk()))
	| json: JSONAggregateFunction => @(json)
	| w: ComputationalOperation & '(' & q: SetQuantifier? & v: ValueNode & ')' => @(Nodes.Call(w, v) with { Quantifier = Nodes.Quantifier(q) })
	| w: BinarySetFunctionType & '(' & x: NumericValueExpression & ',' & y: NumericValueExpression & ')' => @(Nodes.Call(w, x.Node, y.Node))
	| w: ("RANK"i | "DENSE_RANK"i | "PERCENT_RANK"i | "CUME_DIST"i) & '(' & first: ValueNode & (',' & rest: ValueNode)* & ')' & g: WithinGroupSpecification => @(Nodes.Invoked(w, first, rest) with { WithinGroup = g })
	| w: ("PERCENTILE_CONT"i | "PERCENTILE_DISC"i) & '(' & x: NumericValueExpression & ')' & g: WithinGroupSpecification => @(Nodes.Call(w, x.Node) with { WithinGroup = g })
	| w: "ARRAY_AGG"i & '(' & v: ValueNode & ("ORDER"i & "BY"i & o: SortSpecificationList)? & ')' => @(Nodes.Call(w, v) with { OrderBy = o })
	| w: "LISTAGG"i & '(' & q: SetQuantifier? & listed: CharacterValueExpression & ',' & separator: CharacterStringLiteral & l: ListaggOverflowClause? & ')' & g: WithinGroupSpecification => @(Nodes.Call(w, listed.Node, new Expression.Literal(Nodes.StringLiteral(separator, StringLiteralKind.Character))) with { Quantifier = Nodes.Quantifier(q), Overflow = l, WithinGroup = g })

ComputationalOperation
	= "AVG"i | "MAX"i | "MIN"i | "SUM"i | "EVERY"i | "ANY_VALUE"i | "ANY"i | "SOME"i | "COUNT"i
	| "STDDEV_POP"i | "STDDEV_SAMP"i | "VAR_SAMP"i | "VAR_POP"i | "COLLECT"i | "FUSION"i | "INTERSECTION"i

BinarySetFunctionType
	= "COVAR_POP"i | "COVAR_SAMP"i | "CORR"i | "REGR_SLOPE"i | "REGR_INTERCEPT"i | "REGR_COUNT"i
	| "REGR_R2"i | "REGR_AVGX"i | "REGR_AVGY"i | "REGR_SXX"i | "REGR_SYY"i | "REGR_SXY"i

WithinGroupSpecification : @WithinGroupClause = "WITHIN"i & "GROUP"i & '(' & "ORDER"i & "BY"i & s: SortSpecificationList & ')' => @(new WithinGroupClause(s))
ListaggOverflowClause    : @ListaggOverflow = "ON"i & "OVERFLOW"i & b: OverflowBehavior => @(b)
OverflowBehavior         : @ListaggOverflow = "ERROR"i => @(new ListaggOverflow(false))
                                            | "TRUNCATE"i & filler: CharacterStringLiteral? & c: ("WITH"i | "WITHOUT"i) & "COUNT"i => @(Nodes.Truncated(filler, c))

// ── §6.26 Row pattern navigation operation ──────────────────────────────────

// <row pattern navigation operation>. `FIRST`, `LAST`, `PREV` and `NEXT` are not reserved, and a
// navigation without `RUNNING` or `FINAL` is a routine's invocation in shape — `PREV(a, 1)`,
// `FIRST(A.x)` — which a routine invocation reads, with the same verdict. What only a navigation is
// begins with one of those words; a compound one, `PREV(RUNNING FIRST(a, 1), 2)`, is a routine's
// invocation too, whose first argument is such a navigation. Asked as a navigation first and a
// routine after, every argument was read twice, and a line refused inside nested navigations cost a
// power of their depth.
RowPatternNavigationOperation : @Expression = s: ("RUNNING"i | "FINAL"i) & w: ("FIRST"i | "LAST"i) & '(' & v: ValueNode & (',' & n: SimpleOrDynamicValue)? & ')' => @(Nodes.Call(w, v, n) with { Semantics = Nodes.SemanticsOf(s) })

// ── §6.33 JSON value function, §6.37 JSON value constructor, §6.38 JSON query ──
//
// What the BNF spells, and only that: a path is a <character string literal>, which the functions
// take whole. Inside the simplified accessor the path language is read where the SQL tokens reach —
// its literals, identifiers and key names are left to the Syntax Rules (`!! See the Syntax Rules.`)
// and read as nothing, here as in `--standard`; so `a[$ to last]` is read and `a[1 to last]` is not.

// <JSON value function>. What happens on an empty result is said before what happens on an error,
// and both begin with a behaviour and `ON`: that is read once, and the word after `ON` says which it
// was, so the first behaviour is not read again when it turns out to have been said of an error.
JSONValueFunction : @Expression = "JSON_VALUE"i & '(' & c: JSONAPICommonSyntax & ("RETURNING"i & t: DataType)?
	  & (b: JSONValueBehavior & "ON"i & (e: "EMPTY"i & (r: JSONValueBehavior & "ON"i & "ERROR"i)? | "ERROR"i))? & ')'
	  => @(new Expression.JsonValue(c, t, Nodes.OnEmpty(b, e), Nodes.OnError(b, e, r)))
JSONValueBehavior : @JsonValueBehavior = "ERROR"i => @(new JsonValueBehavior.Error())
                                       | "NULL"i => @(new JsonValueBehavior.Null())
                                       | "DEFAULT"i & v: ValueNode => @(new JsonValueBehavior.Default(v))

// <JSON query>.
JSONQuery : @Expression = "JSON_QUERY"i & '(' & c: JSONAPICommonSyntax & o: JSONOutputClause? & (w: JSONQueryWrapperBehavior & "WRAPPER"i)?
	  & q: JSONQueryQuotes? & (b: JSONQueryBehavior & "ON"i & (e: "EMPTY"i & (r: JSONQueryBehavior & "ON"i & "ERROR"i)? | "ERROR"i))? & ')'
	  => @(new Expression.JsonQuery(c, o, Nodes.Wrapper(w), q, Nodes.QueryBehavior(Nodes.OnEmpty(b, e)), Nodes.QueryBehavior(Nodes.OnError(b, e, r))))
JSONQueryWrapperBehavior = "WITHOUT"i & "ARRAY"i? | "WITH"i & ("CONDITIONAL"i | "UNCONDITIONAL"i)? & "ARRAY"i?
JSONQueryQuotes          : @JsonQuotes = w: ("KEEP"i | "OMIT"i) & "QUOTES"i & s: ("ON"i & "SCALAR"i & "STRING"i)? => @(new JsonQuotes((w[0] | 0x20) == 'k' ? JsonQuotesBehavior.Keep : JsonQuotesBehavior.Omit, s is not null))
JSONQueryBehavior        = "ERROR"i | "NULL"i | "EMPTY"i & ("ARRAY"i | "OBJECT"i)

// <JSON API common syntax>: a context item, a path, the path's name, and what the path is passed.
JSONAPICommonSyntax : @JsonApiCommon = i: JSONInputExpression & ',' & p: CharacterStringLiteral & ("AS"i & n: Identifier)?
	  & ("PASSING"i & first: JSONArgument & (',' & rest: JSONArgument)*)? => @(new JsonApiCommon(i.Value, p, n, Nodes.ListOrEmpty(first, rest), i.Format))
JSONArgument        : @JsonArgument = e: JSONInputExpression & "AS"i & n: Identifier => @(new JsonArgument(e.Value, n, e.Format))
JSONInputExpression : @JsonElement = v: ValueNode & f: JSONInputClause? => @(new JsonElement(v, f))
JSONOutputClause    : @JsonOutput = "RETURNING"i & t: DataType & ("FORMAT"i & r: JSONRepresentation)? => @(new JsonOutput(t, r))

// <JSON object constructor>. A name and a value are `KEY name VALUE value`, `name VALUE value` or
// `name : value`; what follows the name says which, and the name is read once.
JSONObjectConstructor : @Expression = "JSON_OBJECT"i & '(' & (first: JSONNameAndValue & (',' & rest: JSONNameAndValue)* & n: JSONConstructorNullClause? & k: JSONKeyUniquenessConstraint?)? & o: JSONOutputClause? & ')' => @(new Expression.JsonObject(Nodes.ListOrEmpty(first, rest), Nodes.NullHandling(n), Nodes.Uniqueness(k), o))
JSONNameAndValue : @JsonMember
	= "KEY"i & k: CharacterNode & "VALUE"i & v: JSONInputExpression => @(new JsonMember(k, v.Value, JsonMemberSyntax.KeyValue, v.Format))
	| k: CharacterNode & s: ("VALUE"i | ':') & v: JSONInputExpression => @(new JsonMember(k, v.Value, s == ":" ? JsonMemberSyntax.Colon : JsonMemberSyntax.Value, v.Format))
JSONConstructorNullClause = ("NULL"i | "ABSENT"i) & "ON"i & "NULL"i

// <JSON array constructor>, by enumeration and by query. A query begins with a key word a value
// expression does not, or with a bracket, where the enumeration is asked first.
JSONArrayConstructor : @Expression
	// An element may not begin with `RETURNING`, which is what the output clause behind it begins
	// with: `JSON_ARRAY(RETURNING JSON)` is an empty array with an output clause, not an array of
	// one element named RETURNING. Over characters the element is given back when the clause does
	// not fit; over kinds the reading that fits is the one that stands.
	= "JSON_ARRAY"i & '(' & (?!"RETURNING"i & first: JSONInputExpression & (',' & ?!"RETURNING"i & rest: JSONInputExpression)* & n: JSONConstructorNullClause?)? & o: JSONOutputClause? & ')' => @(new Expression.JsonArray(Nodes.ListOrEmpty(first, rest), Nodes.NullHandling(n), o))
	| "JSON_ARRAY"i & '(' & q: QueryExpression & f: JSONInputClause? & n: JSONConstructorNullClause? & o: JSONOutputClause? & ')' => @(new Expression.JsonArrayQuery(q, f, o, Nodes.NullHandling(n)))

// <JSON exists predicate>.
JSONExistsPredicate : @Expression = "JSON_EXISTS"i & '(' & c: JSONAPICommonSyntax & (b: ("TRUE"i | "FALSE"i | "UNKNOWN"i | "ERROR"i) & "ON"i & "ERROR"i)? & ')' => @(new Expression.JsonExists(c, Nodes.ExistsBehavior(b)))

// <JSON typed value function>: <JSON parse> and <JSON scalar>, each a <JSON primary> and nothing else
// — no concatenation takes one, which `Towers.Json` alone says.
JSONTypedValueFunction : @Expression
	= "JSON"i & '(' & v: StringValueExpression & f: JSONInputClause? & k: JSONKeyUniquenessConstraint? & ')' => @(new Expression.JsonParse(v.Node, f, Nodes.Uniqueness(k)))
	| "JSON_SCALAR"i & '(' & s: ValueNode & ')' => @(new Expression.JsonScalar(s))

// <JSON serialize>, of a <JSON value expression>: a value expression primary or a typed value function.
JSONSerialize        : @Expression = "JSON_SERIALIZE"i & '(' & v: JSONValueExpression & o: JSONOutputClause? & ')' => @(new Expression.JsonSerialize(v.Node, o))
JSONValueExpression : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Json) != 0) => @(e)

// <JSON array aggregate constructor>, <JSON object aggregate constructor>.
JSONAggregateFunction : @Expression
	= "JSON_ARRAYAGG"i & '(' & e: JSONInputExpression & ("ORDER"i & "BY"i & s: SortSpecificationList)? & n: JSONConstructorNullClause? & o: JSONOutputClause? & ')' => @(new Expression.JsonArrayAggregate(e, s, Nodes.NullHandling(n), o))
	| "JSON_OBJECTAGG"i & '(' & m: JSONNameAndValue & n: JSONConstructorNullClause? & k: JSONKeyUniquenessConstraint? & o: JSONOutputClause? & ')' => @(new Expression.JsonObjectAggregate(m, Nodes.NullHandling(n), Nodes.Uniqueness(k), o))

// ── §6.39 JSON simplified accessor, as far as the SQL tokens reach ──────────
//
// Its operations are steps after a value expression primary (`PrimaryStep`), beside a field
// reference's and an array element's: `.*`, `[*]`, subscripts in the path language, and an item
// method, whose names are mostly reserved words of SQL and so no method's names: `a.decimal(1, 2)`.

// <JSON method>, as a method called on what stands before it. A datetime's template is a path string
// literal, which the Syntax Rules keep.
JSONMethod : @Expression
	= w: ("TYPE"i | "SIZE"i | "DOUBLE"i | "CEILING"i | "FLOOR"i | "ABS"i | "KEYVALUE"i | "BIGINT"i | "BOOLEAN"i
	  | "DATETIME"i | "DATE"i | "INTEGER"i | "NUMBER"i | "STRING"i) & '(' & ')' => @(Nodes.Method(w, null, null))
	| w: "DECIMAL"i & '(' & (p: UnsignedInteger & (',' & s: UnsignedInteger)?)? & ')' => @(Nodes.Method(w, p, s))
	| w: ("TIMESTAMP_TZ"i | "TIMESTAMP"i | "TIME_TZ"i | "TIME"i) & '(' & p: UnsignedInteger? & ')' => @(Nodes.Method(w, p, null))

// <JSON subscript>, <JSON path wff>: the path language's arithmetic over its primaries.
JSONSubscript          : @JsonSubscript = low: JSONPathWff & ("TO"i & high: JSONPathWff)? => @(new JsonSubscript(low, high))
JSONPathWff            : @JsonPathExpression = first: JSONPathMultiplicative & (trivia & rest: JSONPathAdded)* => @(Nodes.PathFold(first, rest))
JSONPathAdded          : @Nodes.PathOperated = o: ['+' | '-'] & e: JSONPathMultiplicative => @(new Nodes.PathOperated(o, e))
JSONPathMultiplicative : @JsonPathExpression = first: JSONPathUnary & (trivia & rest: JSONPathMultiplied)* => @(Nodes.PathFold(first, rest))
JSONPathMultiplied     : @Nodes.PathOperated = o: ['*' | '/' | '%'] & e: JSONPathUnary => @(new Nodes.PathOperated(o, e))
JSONPathUnary          : @JsonPathExpression = (trivia & signs: ['+' | '-'])* & a: JSONPathAccessor => @(Nodes.PathSigned(signs, a))
JSONPathAccessor       : @JsonPathExpression = p: JSONPathPrimary & (trivia & ops: JSONPathAccessorOp)* => @(Nodes.PathAccessed(p, ops))

// <JSON path primary>: the context variable, `last`, or a wff in brackets. A named variable is `$` and
// a path identifier, and `@` is no SQL token.
JSONPathPrimary : @JsonPathExpression = '$' => @(new JsonPathExpression.Variable(JsonPathVariableKind.Context))
                                      | "LAST"i => @(new JsonPathExpression.Variable(JsonPathVariableKind.Last))
                                      | '(' & w: JSONPathWff & ')' => @(new JsonPathExpression.Parenthesized(w))

// <JSON accessor op>: those of the simplified accessor, and a filter; a member's name is a key name.
JSONPathAccessorOp : @JsonPathAccessor
	= '.' & '*' => @(new JsonPathAccessor.WildcardMember())
	| '[' & '*' & ']' => @(new JsonPathAccessor.WildcardArray())
	| '[' & first: JSONSubscript & (',' & rest: JSONSubscript)* & ']' => @(new JsonPathAccessor.Array(Nodes.List(first, rest)))
	| '?' & '(' & p: JSONPathPredicate & ')' => @(new JsonPathAccessor.Filter(p))
	| '.' & m: JSONMethod => @(new JsonPathAccessor.Method(Nodes.PathMethod(m)))

// <JSON path predicate>. `&&`, `!`, `==` and `!=` are no SQL tokens — `!` is no SQL character at all
// (§5.1) — so a conjunction of two, a negation and those comparisons are never read; `||` is the
// concatenation operator's token, and a disjunction is. `like_regex` and `starts with` need a path
// string literal.
JSONPathPredicate : @JsonPathPredicate = first: JSONPredicatePrimary & ("||" & rest: JSONPredicatePrimary)* => @(Nodes.PathOr(first, rest))
JSONPredicatePrimary : @JsonPathPredicate
	= "EXISTS"i & '(' & w: JSONPathWff & ')' => @(new JsonPathPredicate.Exists(w))
	| '(' & p: JSONPathPredicate & ')' & u: ("IS"i & "UNKNOWN"i)? => @(u is null ? new JsonPathPredicate.Parenthesized(p) : new JsonPathPredicate.IsUnknown(p))
	| l: JSONPathWff & o: ("<>" | "<=" | ">=" | '<' | '>') & r: JSONPathWff => @(new JsonPathPredicate.Comparison(l, Nodes.PathComparison(o), r))

// ── §7.11 JSON table ─────────────────────────────────────────────────────────

JSONTable : @JsonTableDefinition = "JSON_TABLE"i & '(' & c: JSONAPICommonSyntax & columns: JSONTableColumnsClause & p: JSONTablePlanClause? & (e: ("ERROR"i | "EMPTY"i) & "ON"i & "ERROR"i)? & ')' => @(new JsonTableDefinition(c, columns, p, Nodes.TableError(e)))
JSONTablePrimitive : @JsonTableDefinition = "JSON_TABLE_PRIMITIVE"i & '(' & c: JSONAPICommonSyntax & "COLUMNS"i & '(' & first: JSONTablePrimitiveColumn & (',' & rest: JSONTablePrimitiveColumn)* & ')' & e: ("ERROR"i | "EMPTY"i) & "ON"i & "ERROR"i & ')' => @(new JsonTableDefinition(c, Nodes.List(first, rest), null, Nodes.TableError(e), true))

JSONTableColumnsClause : @IReadOnlyList<JsonTableColumn> = "COLUMNS"i & '(' & first: JSONTableColumnDefinition & (',' & rest: JSONTableColumnDefinition)* & ')' => @(Nodes.List(first, rest))

JSONTableColumnDefinition : @JsonTableColumn
	= "NESTED"i & k: "PATH"i? & p: CharacterStringLiteral & ("AS"i & n: Identifier)? & columns: JSONTableColumnsClause => @(new JsonTableColumn.Nested(p, n, columns, k is not null))
	| c: ColumnName & "FOR"i & "ORDINALITY"i => @(new JsonTableColumn.Ordinality(c))
	| t: JSONTableTypedColumn => @(t)

JSONTablePrimitiveColumn : @JsonTableColumn
	= c: ColumnName & "FOR"i & w: ("ORDINALITY"i | "CHAINING"i) => @((w[0] | 0x20) == 'o' ? new JsonTableColumn.Ordinality(c) : new JsonTableColumn.Chaining(c))
	| t: JSONTableTypedColumn => @(t)

// <JSON table regular column definition>, <JSON table formatted column definition>. Both are a name,
// a type, a path and what happens on empty and on error, and neither needs to say which it is; read
// once, a guard refuses what only a regular one has (`DEFAULT … ON`, 1) beside what only a formatted
// one has (`FORMAT`, a wrapper, quotes, `EMPTY ARRAY` or `EMPTY OBJECT`, 2). A column that says neither
// is a regular one.
JSONTableTypedColumn : @JsonTableColumn = c: ColumnName & t: DataType & f: JSONColumnFormat & ("PATH"i & p: CharacterStringLiteral)? & w: JSONColumnWrapper
	& (b: JSONColumnBehavior & "ON"i & (e: "EMPTY"i & (r: JSONColumnBehavior & "ON"i & "ERROR"i)? | "ERROR"i))?
	& when @(Nodes.ColumnKinds(f, w, Nodes.OnEmpty(b, e), Nodes.OnError(b, e, r)) != 3)
	=> @(Nodes.TypedColumn(c, t, f, p, w, Nodes.OnEmpty(b, e) ?? new Nodes.ColumnPart(0), Nodes.OnError(b, e, r) ?? new Nodes.ColumnPart(0)))

JSONColumnFormat  : @Nodes.ColumnPart = "FORMAT"i & r: JSONRepresentation => @(new Nodes.ColumnPart(2) { Format = r })
                                      | none => @(new Nodes.ColumnPart(0))
JSONColumnWrapper : @Nodes.ColumnPart = w: JSONQueryWrapperBehavior & "WRAPPER"i & q: JSONColumnQuotes => @(q with { Kind = 2, Wrapper = Nodes.Wrapper(w) })
                                      | q: JSONColumnQuotes => @(q)
JSONColumnQuotes  : @Nodes.ColumnPart = w: ("KEEP"i | "OMIT"i) & "QUOTES"i & s: ("ON"i & "SCALAR"i & "STRING"i)? => @(new Nodes.ColumnPart(2) { Quotes = new JsonQuotes((w[0] | 0x20) == 'k' ? JsonQuotesBehavior.Keep : JsonQuotesBehavior.Omit, s is not null) })
                                      | none => @(new Nodes.ColumnPart(0))
JSONColumnBehavior : @Nodes.ColumnPart
	= "ERROR"i => @(new Nodes.ColumnPart(0) { Value = new JsonValueBehavior.Error(), Query = JsonQueryBehavior.Error })
	| "NULL"i => @(new Nodes.ColumnPart(0) { Value = new JsonValueBehavior.Null(), Query = JsonQueryBehavior.Null })
	| "DEFAULT"i & v: ValueNode => @(new Nodes.ColumnPart(1) { Value = new JsonValueBehavior.Default(v) })
	| "EMPTY"i & o: ("ARRAY"i | "OBJECT"i) => @(new Nodes.ColumnPart(2) { Query = (o[0] | 0x20) == 'a' ? JsonQueryBehavior.EmptyArray : JsonQueryBehavior.EmptyObject })

// <JSON table plan clause>. A plan is a path's name, a parent and child, or siblings; each begins with
// a plan primary, which is read once and what follows it says which. A parent is a name, and a plan
// in brackets alone is no plan.
JSONTablePlanClause : @JsonTablePlan
	= "PLAN"i & '(' & p: JSONTablePlan & ')' => @(p)
	| "PLAN"i & "DEFAULT"i & '(' & choices: JSONTableDefaultPlanChoices & ')' => @(choices)

JSONTableDefaultPlanChoices : @JsonTablePlan
	= i: ("INNER"i | "OUTER"i) & (',' & u: ("UNION"i | "CROSS"i))? => @(Nodes.DefaultPlan(i, u, false))
	| u: ("UNION"i | "CROSS"i) & (',' & i: ("INNER"i | "OUTER"i))? => @(Nodes.DefaultPlan(i, u, true))

JSONTablePlan : @JsonTablePlan = p: JSONTablePlanPrimary & t: JSONTablePlanTail & when @(Nodes.PlanFits(p, t)) => @(Nodes.Plan(p, t))

JSONTablePlanPrimary : @JsonTablePlan = n: Identifier => @(new JsonTablePlan.Name(n))
                                      | '(' & p: JSONTablePlan & ')' => @(new JsonTablePlan.Parenthesized(p))

JSONTablePlanTail : @Nodes.PlanTail
	= w: ("OUTER"i | "INNER"i) & child: JSONTablePlanPrimary => @(new Nodes.PlanTail(1, w, [child]))
	| ("UNION"i & union: JSONTablePlanPrimary)+ => @(new Nodes.PlanTail(2, "UNION", union))
	| ("CROSS"i & cross: JSONTablePlanPrimary)+ => @(new Nodes.PlanTail(2, "CROSS", cross))
	| none => @(new Nodes.PlanTail(0, null, null))

// ── §7.2 Row value expression list, §7.3 Table value constructor ────────────

// <table value constructor>. A <table row value expression> is a row value special case or a row
// value constructor — a common, a boolean or an explicit row value — and a value expression is
// each of those.
TableValueConstructor : @IReadOnlyList<RowValue> = "VALUES"i & { first: ValueNode & (',' & rest: ValueNode)* } => @(Nodes.Rows(first, rest))

// ── §7.4 Table expression, §7.5 From clause ─────────────────────────────────

TableExpression : @Nodes.TableExpression = f: FromClause & w: WhereClause? & g: GroupByClause? & h: HavingClause? & x: WindowClause? => @(new Nodes.TableExpression(f, w, g, h, x))
FromClause      : @FromClause = "FROM"i & { first: TableReference & (',' & rest: TableReference)* } => @(new FromClause(Nodes.List(first, rest)))

// ── §7.6 Table reference, §7.10 Joined table ────────────────────────────────

// <table reference>, <joined table>. A join begins with a table reference, which is left recursion
// through other productions, so the joins are steps after the first table factor, as many as there
// are, folded from the left. A partitioned join table stands on the left of a qualified or a natural
// join, and is a table factor with `PARTITION BY` after it; it is read as a factor and its
// partitioning, and not tried as a whole and then again without, which would read a derived table
// twice at every depth.
TableReference : @TableSource = f: TableFactor & j: Joins => @(Nodes.Joined(f.Source, j))

// The joins after a factor: none, or steps, the first of which may have the factor's partitioning.
Joins : @Nodes.Joins
	= p: JoinPartitioning & first: PartitionedJoin & (trivia & rest: JoinStep)* => @(new Nodes.Joins(p, Nodes.List(first, rest)))
	| { (trivia & steps: JoinStep)+ } => @(new Nodes.Joins(null, steps))
	| none => @(new Nodes.Joins(null, null))

JoinStep : @Nodes.JoinStep
	= "CROSS"i & "JOIN"i & f: TableFactor => @(new Nodes.JoinStep(JoinKind.Cross, false, false, f.Source, null, null))
	| j: PartitionedJoin => @(j)

// Not a production: a <qualified join> or a <natural join>, from `JOIN` on — what a partitioned join
// table may stand before.
PartitionedJoin : @Nodes.JoinStep
	= "NATURAL"i & t: JoinType? & "JOIN"i & f: TableFactor & p: JoinPartitioning? => @(Nodes.Step(t, true, f.Source, null, p))
	| t: JoinType? & "JOIN"i & o: JoinOperand & s: JoinSpecification => @(Nodes.Step(t, false, o.Source, s, o.Partition))

// A qualified join's right side: a table reference, or a partitioned join table. It is read as far
// as it goes: a join specification must follow it, and one a join inside it took could not have been
// the outer join's, since that join would then have none.
JoinOperand     : @Nodes.JoinOperand = f: TableFactor & t: JoinOperandTail => @(Nodes.Operand(f.Source, t))
JoinOperandTail : @Nodes.Joins
	= p: JoinPartitioning & (first: PartitionedJoin & (trivia & rest: JoinStep)*)? => @(new Nodes.Joins(p, first is null ? null : Nodes.List(first, rest)))
	| (trivia & steps: JoinStep)* => @(new Nodes.Joins(null, steps))

// <partitioned join table>'s partitioning.
JoinPartitioning : @IReadOnlyList<Expression> = "PARTITION"i & "BY"i & '(' & first: ColumnReference & (',' & rest: ColumnReference)* & ')' => @(Nodes.List(first, rest))

JoinType = "INNER"i | ("LEFT"i | "RIGHT"i | "FULL"i) & "OUTER"i?

JoinSpecification : @JoinSpecification
	= "ON"i & c: SearchCondition => @(new JoinSpecification.On(c.Node))
	| "USING"i & '(' & columns: ColumnNameList & ')' & ("AS"i & n: CorrelationName)? => @(new JoinSpecification.Using(columns, n))

// <table factor>: whether it is a parenthesized joined table, which a sample clause after it ends.
TableFactor : @Nodes.Factor = p: TablePrimary & s: SampleClause? => @(new Nodes.Factor(s is null ? p.Source : p.Source with { Sample = s }, p.JoinedTable && s is null))

SampleClause : @SampleClause = "TABLESAMPLE"i & m: ("BERNOULLI"i | "SYSTEM"i) & '(' & p: NumericNode & ')' & ("REPEATABLE"i & '(' & r: NumericNode & ')')? => @(new SampleClause((m[0] | 0x20) == 'b' ? SampleMethod.Bernoulli : SampleMethod.System, p, r))

// <table primary>: whether it is a parenthesized joined table. `TABLE (f(x))` is a collection's and
// then a correlation name must follow, or a polymorphic table function's and one need not: the
// expression is read once, and a routine's invocation alone (`Towers.Invoked`) is the latter. A JSON
// table primitive takes a correlation name and nothing else. A <data change delta table> is asked
// first: `FINAL` is not reserved, and would be taken for a table's name.
TablePrimary : @Nodes.Factor
	= d: DataChangeDeltaTable & c: CorrelationOrRecognition? => @(Nodes.Correlate(d, c))
	| n: TableOrQueryName & s: QuerySystemTimePeriodSpecification? & c: CorrelationOrRecognition? => @(Nodes.Correlate(new TableSource.Named(n) { SystemTime = s }, c))
	| "LATERAL"i & q: TableSubquery & c: CorrelationOrRecognition => @(Nodes.Correlate(new TableSource.Subquery(q) { Lateral = true }, c))
	| "UNNEST"i & '(' & first: CollectionNode & (',' & rest: CollectionNode)* & ')' & o: ("WITH"i & "ORDINALITY"i)? & c: CorrelationOrRecognition => @(Nodes.Correlate(new TableSource.Unnest(Nodes.List(first, rest), o is not null, null), c))
	| "TABLE"i & '(' & e: CollectionValueExpression & ')' & a: Correlated & r: Recognized & when @(a is not null || r is not null || (Towers.RolesOf(e) & Towers.Invoked) != 0) => @(Nodes.Correlate(new TableSource.TableFunction(e.Node), new Nodes.Correlation(a, r)))
	| "ONLY"i & '(' & n: TableOrQueryName & ')' & c: CorrelationOrRecognition? => @(Nodes.Correlate(new TableSource.Named(n) { Only = true }, c))
	| q: TableSubquery & c: CorrelationOrRecognition => @(Nodes.Correlate(new TableSource.Subquery(q), c))
	| j: JSONTable & c: CorrelationOrRecognition => @(Nodes.Correlate(new TableSource.JsonTable(j), c))
	| j: JSONTablePrimitive & k: CorrelationName => @(new Nodes.Factor(new TableSource.JsonTable(j, new Alias(k)), false))
	| p: ParenthesizedJoinedTable => @(new Nodes.Factor(new TableSource.Parenthesized(p), true))

// <parenthesized joined table>: a joined table in brackets, or one such in brackets again. Both
// begin with a table factor, which is read once.
ParenthesizedJoinedTable : @TableSource = '(' & f: TableFactor & j: Joins & ')' & when @(Nodes.JoinsOrJoined(f, j)) => @(Nodes.Joined(f.Source, j))

// <correlation or recognition>: a correlation name, or a row pattern recognition clause with the
// input's name before it, the output's after it, both or neither. Both begin with a name where they
// have one, so a name is read and then a clause: `t s (c) MATCH_RECOGNIZE (…)` would otherwise be
// read as a correlation and leave the clause behind.
CorrelationOrRecognition : @Nodes.Correlation = a: Correlated & r: Recognized & when @(a is not null || r is not null) => @(new Nodes.Correlation(a, r))

// A query's lists give nothing back once read, and a correlation name is a word that is not reserved:
// in `JSON_ARRAY(SELECT a FROM t FORMAT JSON)` the last table would be called `FORMAT`, and the JSON
// constructor's own words left unread. So a name is not taken where one of those goes on after it —
// no table's name could stand there either.
Correlated : @Alias = ?!("FORMAT"i & "JSON"i | "RETURNING"i & DataType | "ABSENT"i & "ON"i & "NULL"i) & a: "AS"i? & n: CorrelationName & ('(' & columns: ColumnNameList & ')')? => @(new Alias(n, columns, a is not null))
                    | none => @(null!)
Recognized : @Nodes.Recognition = c: RowPatternRecognitionClause & a: Correlated => @(new Nodes.Recognition(c, a))
                                | none => @(null!)

// Not a production: a collection value expression's node alone.
CollectionNode : @Expression = e: CollectionValueExpression => @(e.Node)

// ── §7.6 Row pattern recognition clause ─────────────────────────────────────

RowPatternRecognitionClause : @RowPatternClause
	= "MATCH_RECOGNIZE"i & '(' & p: RowPatternPartitionBy? & ("ORDER"i & "BY"i & o: SortSpecificationList)?
	  & m: RowPatternMeasures? & r: RowPatternRowsPerMatch? & c: RowPatternCommonSyntax & ')' => @(Nodes.Recognized(p, o, m, r, c))

RowPatternPartitionBy : @IReadOnlyList<Expression> = "PARTITION"i & "BY"i & first: PartitionColumn & (',' & rest: PartitionColumn)* => @(Nodes.List(first, rest))
RowPatternMeasures    : @IReadOnlyList<RowPatternMeasure> = "MEASURES"i & first: RowPatternMeasure & (',' & rest: RowPatternMeasure)* => @(Nodes.List(first, rest))
RowPatternMeasure     : @RowPatternMeasure = v: ValueNode & "AS"i & n: Identifier => @(new RowPatternMeasure(v, n))

// A column a partition is by, and the collation it is compared under.
PartitionColumn : @Expression = c: ColumnReference & o: CollateClause? => @(o is null ? c : new Expression.Collate(c, o))

RowPatternRowsPerMatch : @RowsPerMatch
	= "ONE"i & "ROW"i & "PER"i & "MATCH"i => @(RowsPerMatch.One)
	| "ALL"i & "ROWS"i & "PER"i & "MATCH"i & h: ("SHOW"i & "EMPTY"i & "MATCHES"i | "OMIT"i & "EMPTY"i & "MATCHES"i | "WITH"i & "UNMATCHED"i & "ROWS"i)? => @(Nodes.AllRows(h))

// <row pattern common syntax>, which a window frame ends in too: what `Nodes.Recognized` and
// `Nodes.Framed` complete a clause with.
RowPatternCommonSyntax : @RowPatternClause
	= ("AFTER"i & "MATCH"i & k: RowPatternSkipTo)? & i: ("INITIAL"i | "SEEK"i)? & "PATTERN"i & '(' & p: RowPattern & ')'
	  & s: RowPatternSubsetClause? & "DEFINE"i & first: RowPatternDefinition & (',' & rest: RowPatternDefinition)* => @(Nodes.Common(k, i, p, s, first, rest))

// <row pattern skip to>. A variable's name is an identifier, and `FIRST`, `LAST` and `NEXT` are none
// of them reserved: `SKIP TO FIRST A` is asked before `SKIP TO FIRST`, which names a variable `FIRST`.
RowPatternSkipTo : @RowPatternSkip
	= "SKIP"i & "TO"i & "NEXT"i & "ROW"i => @(new RowPatternSkip(RowPatternSkipKind.NextRow))
	| "SKIP"i & "PAST"i & "LAST"i & "ROW"i => @(new RowPatternSkip(RowPatternSkipKind.PastLastRow))
	| "SKIP"i & "TO"i & w: ("FIRST"i | "LAST"i) & v: Identifier => @(new RowPatternSkip((w[0] | 0x20) == 'f' ? RowPatternSkipKind.First : RowPatternSkipKind.Last, v))
	| "SKIP"i & "TO"i & v: Identifier => @(new RowPatternSkip(RowPatternSkipKind.Variable, v))

// <row pattern>, <row pattern alternation>, <row pattern term>: the BNF recurses through the first
// and the last on the left, and they are repetitions here.
RowPattern       : @RowPattern = first: RowPatternTerm & ('|' & rest: RowPatternTerm)* => @(Nodes.Alternation(first, rest))
RowPatternTerm   : @RowPattern = first: RowPatternFactor & (trivia & rest: RowPatternFactor)* => @(Nodes.Sequence(first, rest))
RowPatternFactor : @RowPattern = p: RowPatternPrimary & q: RowPatternQuantifier? => @(q is null ? p : new RowPattern.Quantified(p, q))

// <row pattern primary>. `PERMUTE` is not reserved, and is asked before a variable of that name.
RowPatternPrimary : @RowPattern
	= "PERMUTE"i & '(' & first: RowPattern & (',' & rest: RowPattern)* & ')' => @(new RowPattern.Permute(Nodes.List(first, rest)))
	| v: Identifier => @(new RowPattern.Variable(v))
	| '$' => @(new RowPattern.EndAnchor())
	| '^' => @(new RowPattern.StartAnchor())
	| '(' & inner: RowPattern? & ')' => @(new RowPattern.Parenthesized(inner))
	| "{-" & excluded: RowPattern & "-}" => @(new RowPattern.Excluded(excluded))

RowPatternQuantifier : @RowPatternQuantifier
	= '*' & r: PatternQuestionMark? => @(new RowPatternQuantifier(RowPatternQuantifierKind.ZeroOrMore, Reluctant: r is not null))
	| '+' & r: PatternQuestionMark? => @(new RowPatternQuantifier(RowPatternQuantifierKind.OneOrMore, Reluctant: r is not null))
	| PatternQuestionMark & r: PatternQuestionMark? => @(new RowPatternQuantifier(RowPatternQuantifierKind.ZeroOrOne, Reluctant: r is not null))
	| '{' & min: UnsignedInteger? & ',' & max: UnsignedInteger? & '}' & r: PatternQuestionMark? => @(new RowPatternQuantifier(RowPatternQuantifierKind.Range, Nodes.Integer(min), Nodes.Integer(max), r is not null))
	| '{' & exact: UnsignedInteger & '}' => @(new RowPatternQuantifier(RowPatternQuantifierKind.Exact, Nodes.Integer(exact), Nodes.Integer(exact)))

RowPatternSubsetClause : @IReadOnlyList<RowPatternSubset> = "SUBSET"i & first: RowPatternSubsetItem & (',' & rest: RowPatternSubsetItem)* => @(Nodes.List(first, rest))
RowPatternSubsetItem   : @RowPatternSubset = n: Identifier & '=' & '(' & first: Identifier & (',' & rest: Identifier)* & ')' => @(new RowPatternSubset(n, Nodes.List(first, rest)))
RowPatternDefinition   : @RowPatternDefinition = v: Identifier & "AS"i & c: SearchCondition => @(new RowPatternDefinition(v, c.Node))

// <table or query name>: a transition table's name and a query's are identifiers, which a table name is.
TableOrQueryName : @QualifiedName = n: TableName => @(n)

QuerySystemTimePeriodSpecification : @SystemTimeSpecification
	= "FOR"i & "SYSTEM_TIME"i & "AS"i & "OF"i & p: DatetimeValueExpression => @(new SystemTimeSpecification.AsOf(p.Node))
	| "FOR"i & "SYSTEM_TIME"i & "BETWEEN"i & s: ("ASYMMETRIC"i | "SYMMETRIC"i)? & lo: DatetimeValueExpression & "AND"i & hi: DatetimeValueExpression => @(new SystemTimeSpecification.Between(lo.Node, hi.Node, Nodes.Symmetry(s)))
	| "FOR"i & "SYSTEM_TIME"i & "FROM"i & lo: DatetimeValueExpression & "TO"i & hi: DatetimeValueExpression => @(new SystemTimeSpecification.FromTo(lo.Node, hi.Node))

ColumnNameList  : @IReadOnlyList<Identifier> = first: ColumnName & (',' & rest: ColumnName)* => @(Nodes.List(first, rest))
CorrelationName : @Identifier = i: Identifier => @(i)
QueryName       : @Identifier = i: Identifier => @(i)

// ── §7.8 Where clause, §7.9 Group by clause, §7.10 Having clause ────────────

WhereClause  : @Expression = "WHERE"i & c: SearchCondition => @(c.Node)
HavingClause : @Expression = "HAVING"i & c: SearchCondition => @(c.Node)

GroupByClause : @GroupByClause = "GROUP"i & "BY"i & q: SetQuantifier? & { first: GroupingElement & (',' & rest: GroupingElement)* } => @(new GroupByClause(Nodes.Quantifier(q), Nodes.List(first, rest)))

// <grouping element>, <grouping set>: the two are the same five. `()` is an empty grouping set, and
// asked before an ordinary one, which would take its bracket.
GroupingElement : @GroupingElement
	= "ROLLUP"i & '(' & first: OrdinaryGroupingSet & (',' & rest: OrdinaryGroupingSet)* & ')' => @(new GroupingElement.Rollup(Nodes.List(first, rest)))
	| "CUBE"i & '(' & first: OrdinaryGroupingSet & (',' & rest: OrdinaryGroupingSet)* & ')' => @(new GroupingElement.Cube(Nodes.List(first, rest)))
	| "GROUPING"i & "SETS"i & '(' & first: GroupingElement & (',' & rest: GroupingElement)* & ')' => @(new GroupingElement.Sets(Nodes.List(first, rest)))
	| '(' & ')' => @(new GroupingElement.Empty())
	| s: OrdinaryGroupingSet => @(s)

OrdinaryGroupingSet : @GroupingElement
	= c: GroupingColumnReference => @(new GroupingElement.Ordinary([c]))
	| '(' & first: GroupingColumnReference & (',' & rest: GroupingColumnReference)* & ')' => @(new GroupingElement.Ordinary(Nodes.List(first, rest), true))

GroupingColumnReference : @Expression = c: ColumnReference & o: CollateClause? => @(o is null ? c : new Expression.Collate(c, o))

// ── §7.11 Window clause ─────────────────────────────────────────────────────

WindowClause               : @WindowClause = "WINDOW"i & { first: WindowDefinition & (',' & rest: WindowDefinition)* } => @(new WindowClause(Nodes.List(first, rest)))
WindowDefinition           : @WindowDefinition = n: WindowName & "AS"i & s: WindowSpecification => @(new WindowDefinition(n, s))
WindowSpecification        : @WindowSpecification = '(' & s: WindowSpecificationDetails & ')' => @(s)
WindowSpecificationDetails : @WindowSpecification = e: ExistingWindowName? & p: WindowPartitionClause? & o: WindowOrderClause? & f: WindowFrameClause? => @(new WindowSpecification(e, p ?? [], o, f))

// <existing window name>. A frame may begin with `MEASURES`, which is not reserved, so a name is one
// only where what may follow a name follows it.
ExistingWindowName : @Identifier = n: WindowName & ?=("PARTITION"i | "ORDER"i | "ROWS"i | "RANGE"i | "GROUPS"i | "MEASURES"i | ')') => @(n)
WindowName         : @Identifier = i: Identifier => @(i)

WindowPartitionClause : @IReadOnlyList<Expression> = "PARTITION"i & "BY"i & first: PartitionColumn & (',' & rest: PartitionColumn)* => @(Nodes.List(first, rest))
WindowOrderClause     : @OrderByClause = "ORDER"i & "BY"i & s: SortSpecificationList => @(s)

// <window frame clause>, with the row pattern measures before it and the row pattern syntax after.
WindowFrameClause : @WindowFrame = m: RowPatternMeasures? & u: ("ROWS"i | "RANGE"i | "GROUPS"i) & e: WindowFrameExtent & x: WindowFrameExclusion? & c: RowPatternCommonSyntax? => @(Nodes.Framed(m, u, e, x, c))

WindowFrameExtent : @WindowFrameExtent
	= "BETWEEN"i & from: WindowFrameBound & "AND"i & to: WindowFrameBound => @(new WindowFrameExtent.Between(from, to))
	| b: WindowFrameStart => @(new WindowFrameExtent.Single(b))

WindowFrameStart : @WindowFrameBound
	= "UNBOUNDED"i & "PRECEDING"i => @(new WindowFrameBound(WindowBoundKind.UnboundedPreceding))
	| v: UnsignedValueSpecification & "PRECEDING"i => @(new WindowFrameBound(WindowBoundKind.Preceding, v))
	| "CURRENT"i & "ROW"i => @(new WindowFrameBound(WindowBoundKind.CurrentRow))

WindowFrameBound : @WindowFrameBound
	= b: WindowFrameStart => @(b)
	| "UNBOUNDED"i & "FOLLOWING"i => @(new WindowFrameBound(WindowBoundKind.UnboundedFollowing))
	| v: UnsignedValueSpecification & "FOLLOWING"i => @(new WindowFrameBound(WindowBoundKind.Following, v))

WindowFrameExclusion : @WindowFrameExclusion = "EXCLUDE"i & w: ("CURRENT"i & "ROW"i | "GROUP"i | "TIES"i | "NO"i & "OTHERS"i) => @(Nodes.Exclusion(w))

// <unsigned value specification>, <simple value specification>: an SQL parameter reference is an
// identifier chain, and a host's embedded variable is written as a host parameter is.
UnsignedValueSpecification : @Expression = l: UnsignedLiteral => @(new Expression.Literal(l))
                                          | g: GeneralValueSpecification => @(g)
                                          | n: IdentifierChain => @(new Expression.Reference(n))
SimpleValueSpecification   : @Expression = l: Literal => @(new Expression.Literal(l))
                                          | ':' & h: Identifier => @(new Expression.Parameter(ParameterKind.Host, h))
                                          | n: IdentifierChain => @(new Expression.Reference(n))

// ── §7.12 Query specification ───────────────────────────────────────────────

QuerySpecification : @Statement.Select = "SELECT"i & q: SetQuantifier? & l: SelectList & t: TableExpression => @(Nodes.Specified(q, l, t))
SetQuantifier      = "DISTINCT"i | "ALL"i

SelectList : @IReadOnlyList<SelectItem> = '*' => @(Nodes.Everything())
                                        | { first: SelectSublist & (',' & rest: SelectSublist)* } => @(Nodes.List(first, rest))

// <select sublist>: a <derived column>, or a <qualified asterisk>. Each begins with a value
// expression — an <asterisked identifier chain> is a column reference in shape, and an <all fields
// reference> a value expression primary — so the expression is read once. `t.*` is a JSON simplified
// accessor too, and the expression reads its `.*`; `AS (…)` after it asks that `.*` was the last
// step (`Towers.Starred`). Tried apart, a subquery in a select list would be read twice at every depth.
//
// Nothing reads a `.*` after the expression: every primary takes it as a step, and what cannot — a
// row, `(a, b).*` — is no primary to take it. Read there as well, a refused line gave each `.*` back
// to be read the second way, and a select list of them cost a power of their number.
//
// A `.*` with nothing after it is a qualified asterisk, the reading a select list is written for; with
// a name after it, the JSON accessor it is too, named.
SelectSublist : @SelectItem = e: ValueExpression & f: AllFields & when @(!Nodes.RenamesFields(f) || (Towers.RolesOf(e) & Towers.Starred) != 0) => @(Nodes.Selected(e.Node, f))
AllFields     : @Nodes.Fields = "AS"i & '(' & columns: ColumnNameList & ')' => @(new Nodes.Fields(null, false, columns))
                              | a: AsClause => @(a)
                              | none => @(new Nodes.Fields(null, false, null))

AsClause : @Nodes.Fields = a: "AS"i? & n: ColumnName => @(new Nodes.Fields(n, a is not null, null))

// ── §7.13 Query expression ──────────────────────────────────────────────────

// <query expression>. The clauses around a body are the body's own where it has none of them, and a
// query of their own around it where it has: `(SELECT a FROM t ORDER BY a) ORDER BY b` is two orders.
QueryExpression : @Statement.Select = w: WithClause? & b: QueryExpressionBody & o: OrderByClause? & f: ResultOffsetClause? & x: FetchFirstClause? => @(Nodes.Expressed(b, w, o, f, x))

WithClause      : @WithClause = "WITH"i & r: "RECURSIVE"i? & { first: WithListElement & (',' & rest: WithListElement)* } => @(new WithClause(r is not null, Nodes.List(first, rest)))
WithListElement : @CommonTableExpression = n: QueryName & ('(' & columns: ColumnNameList & ')')? & "AS"i & q: TableSubquery & s: SearchOrCycleClause? => @(new CommonTableExpression(n, columns ?? System.Array.Empty<Identifier>(), q, s?.Search, s?.Cycle))

// <query expression body>, <query term>: each recurses through itself on the left, so the operators
// are a repetition here, and `INTERSECT` is read inside a term. A term with an `INTERSECT` in it is an
// operand of its own where `UNION` or `EXCEPT` joins it, so the tree keeps what binds tighter.
QueryExpressionBody : @Statement.Select = { first: QueryTerm & (trivia & rest: UnionOrExcept)* } => @(Nodes.Combined(first, rest))
QueryTerm           : @Statement.Select = { first: QueryPrimary & (trivia & rest: Intersected)* } => @(Nodes.Combined(first, rest))

UnionOrExcept : @SetOperation = o: ("UNION"i | "EXCEPT"i) & q: ("ALL"i | "DISTINCT"i)? & c: CorrespondingSpec? & t: QueryTerm => @(Nodes.Operation(o, q, c, t))
Intersected   : @SetOperation = o: "INTERSECT"i & q: ("ALL"i | "DISTINCT"i)? & c: CorrespondingSpec? & t: QueryPrimary => @(Nodes.Operation(o, q, c, t))

QueryPrimary : @Statement.Select
	= s: SimpleTable => @(s)
	| '(' & b: QueryExpressionBody & o: OrderByClause? & f: ResultOffsetClause? & x: FetchFirstClause? & ')' => @(Nodes.InBrackets(Nodes.Expressed(b, null, o, f, x)))

// <simple table>, with <explicit table>.
SimpleTable : @Statement.Select
	= s: QuerySpecification => @(s)
	| v: TableValueConstructor => @(new Statement.Select { Body = new QueryOperand.Values(v) })
	| "TABLE"i & n: TableOrQueryName => @(new Statement.Select { Body = new QueryOperand.Table(n) })

CorrespondingSpec  : @CorrespondingClause = "CORRESPONDING"i & ("BY"i & '(' & columns: ColumnNameList & ')')? => @(new CorrespondingClause(columns is not null, columns ?? System.Array.Empty<Identifier>()))
OrderByClause      : @OrderByClause = "ORDER"i & "BY"i & s: SortSpecificationList => @(s)
ResultOffsetClause : @OffsetClause = "OFFSET"i & v: SimpleValueSpecification & w: ("ROW"i | "ROWS"i) => @(new OffsetClause(v, Nodes.RowWordOf(w)))

// <fetch first clause>. A <fetch first percentage> is a row count and `PERCENT`.
FetchFirstClause   : @FetchClause = "FETCH"i & p: ("FIRST"i | "NEXT"i) & q: FetchFirstQuantity? & w: ("ROW"i | "ROWS"i) & m: ("ONLY"i | "WITH"i & "TIES"i) => @(Nodes.Fetched(p, q, w, m))
FetchFirstQuantity : @Nodes.Quantity = v: SimpleValueSpecification & p: "PERCENT"i? => @(new Nodes.Quantity(v, p is not null))

// ── §7.14 Search or cycle clause ────────────────────────────────────────────

SearchOrCycleClause : @Nodes.SearchOrCycle
	= s: SearchClause & c: CycleClause? => @(new Nodes.SearchOrCycle(s, c))
	| c: CycleClause => @(new Nodes.SearchOrCycle(null, c))

SearchClause : @SearchClause = "SEARCH"i & o: ("DEPTH"i | "BREADTH"i) & "FIRST"i & "BY"i & columns: ColumnNameList & "SET"i & c: ColumnName => @(new SearchClause((o[0] | 0x20) == 'd' ? SearchOrder.DepthFirst : SearchOrder.BreadthFirst, columns, c))
CycleClause  : @CycleClause = "CYCLE"i & columns: ColumnNameList & "SET"i & m: ColumnName & ("TO"i & v: ValueNode & "DEFAULT"i & d: ValueNode)? & "USING"i & p: ColumnName => @(new CycleClause(columns, m, v, d, p))

// ── §7.15 Subquery ──────────────────────────────────────────────────────────

// A subquery's brackets are the subquery's, and no query's brackets: the query in them has none of its own.
ScalarSubquery : @Statement.Select = q: Subquery => @(q)
TableSubquery  : @Statement.Select = q: Subquery => @(q)
Subquery       : @Statement.Select = '(' & q: QueryExpression & ')' => @(q)

// ── §10.10 Sort specification list ──────────────────────────────────────────

SortSpecificationList : @OrderByClause = { first: SortSpecification & (',' & rest: SortSpecification)* } => @(new OrderByClause(Nodes.List(first, rest)))
SortSpecification     : @SortItem = k: ValueNode & d: ("ASC"i | "DESC"i)? & ("NULLS"i & n: ("FIRST"i | "LAST"i))? => @(Nodes.Sorted(k, d, n))
// ── §14.8 Delete statement, §14.9 Truncate table statement ──────────────────

// <delete statement: searched>, <delete statement: positioned>.
DeleteStatementSearched   : @Statement.Delete = "DELETE"i & "FROM"i & t: TargetTable & p: ForPortionOf? & c: TargetCorrelation? & w: WhereClause? => @(new Statement.Delete { Target = t, Portion = p, Alias = c, Where = w })
DeleteStatementPositioned : @Statement.Delete = "DELETE"i & "FROM"i & t: TargetTable & c: TargetCorrelation? & "WHERE"i & "CURRENT"i & "OF"i & k: CursorName => @(new Statement.Delete { Target = t, Alias = c, CurrentOf = new CursorReference(k) })

TruncateTableStatement : @Statement.TruncateTable = "TRUNCATE"i & "TABLE"i & t: TargetTable & (i: ("CONTINUE"i | "RESTART"i) & "IDENTITY"i)? => @(new Statement.TruncateTable { Target = t, Identity = Nodes.RestartOf(i) })

// <target table>.
TargetTable : @TableSource = n: TableName => @(new TableSource.Named(n))
                           | "ONLY"i & '(' & n: TableName & ')' => @(new TableSource.Named(n) { Only = true })

// Not a production: the correlation name a delete, an update and a merge may give their target.
TargetCorrelation : @Alias = a: "AS"i? & n: CorrelationName => @(new Alias(n, null, a is not null))

// An application time period's portion, which a searched delete and update may name.
ForPortionOf : @PeriodPortion = "FOR"i & "PORTION"i & "OF"i & n: Identifier & "FROM"i & lo: DatetimeValueExpression & "TO"i & hi: DatetimeValueExpression => @(new PeriodPortion(n, lo.Node, hi.Node))

// <cursor name>, a <local qualified name>.
CursorName : @QualifiedName = m: "MODULE"i & '.' & i: Identifier => @(Nodes.Named(m, i))
                            | i: Identifier => @(new QualifiedName([i]))

// ── §14.11 Insert statement ─────────────────────────────────────────────────

// <insert statement>. A column list and an override clause stand before a query and before a
// constructor alike, and are read once; the constructor is asked first, since it reads what a
// query's table value constructor does and `DEFAULT` too.
InsertStatement : @Statement.Insert = "INSERT"i & "INTO"i & n: TableName & s: InsertColumnsAndSource => @(new Statement.Insert { Target = new TableSource.Named(n), Columns = s.Columns, Override = s.Override, SourceValue = s.Source })

InsertColumnsAndSource : @Nodes.InsertBody
	= ('(' & columns: ColumnNameList & ')')? & o: OverrideClause? & v: InsertValues => @(new Nodes.InsertBody(columns ?? System.Array.Empty<Identifier>(), o, v))
	| "DEFAULT"i & "VALUES"i => @(new Nodes.InsertBody(System.Array.Empty<Identifier>(), null, new InsertSource.DefaultValues()))

// Not a production: what an insert's columns are given, rows or a query.
// The plain form is taken only where nothing goes on that would make the source a whole query
// expression — `VALUES (1) ORDER BY 1` and `VALUES (1), (2) UNION SELECT a FROM u` are query
// expressions, and the constructor alone is not. Over characters the first alternative fails at
// that word and the second reads it; over kinds the reading that fits is the one that stands, so
// what may not follow is said here rather than discovered by giving the reading back.
// That the two are told apart only after the rows is the language's: the constructor's rows may
// hold DEFAULT and a query's may not, so they share no beginning to read once, and a reading of
// the rows that the second alternative replaces is meant (Q7.1 §5).
InsertValues : @InsertSource = r: ContextuallyTypedTableValueConstructor & ?!("UNION"i | "EXCEPT"i | "INTERSECT"i | "ORDER"i | "OFFSET"i | "FETCH"i) => @(new InsertSource.Values(r))
                             | q: QueryExpression => @(new InsertSource.Query(q))

OverrideClause : @OverrideKind = "OVERRIDING"i & w: ("USER"i | "SYSTEM"i) & "VALUE"i => @((w[0] | 0x20) == 'u' ? OverrideKind.UserValue : OverrideKind.SystemValue)

// <contextually typed table value constructor>: rows whose values may be `DEFAULT`, `NULL` or an
// empty collection, which take their type from where they go.
ContextuallyTypedTableValueConstructor : @IReadOnlyList<RowValue> = "VALUES"i & { first: ContextuallyTypedRowValueExpression & (',' & rest: ContextuallyTypedRowValueExpression)* } => @(Nodes.Rows(first, rest))

// <contextually typed row value expression>. A bracket holds such a specification alone, or two or
// more elements; a value expression reads any other row and value.
ContextuallyTypedRowValueExpression : @Expression
	= c: ContextuallyTypedValueSpecification => @(c)
	| '(' & p: ContextuallyTypedValueSpecification & ')' => @(new Expression.Parenthesized(p))
	| '(' & first: ContextuallyTypedElement & (',' & rest: ContextuallyTypedElement)+ & ')' => @(new Expression.Row(Nodes.List(first, rest)))
	| "ROW"i & '(' & first: ContextuallyTypedElement & (',' & rest: ContextuallyTypedElement)* & ')' => @(new Expression.Row(Nodes.List(first, rest), true))
	| v: ValueExpression => @(v.Node)

ContextuallyTypedElement : @Expression = c: ContextuallyTypedValueSpecification => @(c)
                                       | v: ValueExpression => @(v.Node)

// ── §14.12 Merge statement ──────────────────────────────────────────────────

MergeStatement : @Statement.Merge = "MERGE"i & "INTO"i & t: TargetTable & c: TargetCorrelation? & "USING"i & s: TableReference & "ON"i & o: SearchCondition & { (trivia & clauses: MergeWhenClause)+ } => @(new Statement.Merge { Target = t, Alias = c, SourceTable = s, On = o.Node, Clauses = clauses })

MergeWhenClause : @MergeClause
	= "WHEN"i & "MATCHED"i & c: MergeCondition? & "THEN"i & a: MergeMatchedThen => @(new MergeClause.Matched(a) { Condition = c })
	| "WHEN"i & "NOT"i & "MATCHED"i & c: MergeCondition? & "THEN"i & i: MergeInsertSpecification => @(new MergeClause.NotMatched(i) { Condition = c })

// Not productions: a merge when clause's search condition, and what a matched row is done.
MergeCondition   : @Expression = "AND"i & c: SearchCondition => @(c.Node)
MergeMatchedThen : @MergeMatchedAction = "UPDATE"i & "SET"i & s: SetClauseList => @(new MergeMatchedAction.Update(s))
                                       | "DELETE"i => @(new MergeMatchedAction.Delete())

MergeInsertSpecification : @MergeInsertAction = "INSERT"i & ('(' & columns: ColumnNameList & ')')? & o: OverrideClause? & "VALUES"i & '(' & first: ContextuallyTypedElement & (',' & rest: ContextuallyTypedElement)* & ')' => @(new MergeInsertAction(columns ?? System.Array.Empty<Identifier>(), o, Nodes.List(first, rest)))

// ── §14.13 Update statement: positioned, §14.14 Update statement: searched ─

UpdateStatementSearched   : @Statement.Update = "UPDATE"i & t: TargetTable & p: ForPortionOf? & c: TargetCorrelation? & "SET"i & s: SetClauseList & w: WhereClause? => @(new Statement.Update { Target = t, Portion = p, Alias = c, Assignments = s, Where = w })
UpdateStatementPositioned : @Statement.Update = "UPDATE"i & t: TargetTable & c: TargetCorrelation? & "SET"i & s: SetClauseList & "WHERE"i & "CURRENT"i & "OF"i & k: CursorName => @(new Statement.Update { Target = t, Alias = c, Assignments = s, CurrentOf = new CursorReference(k) })

// ── §14.15 Set clause list ──────────────────────────────────────────────────

SetClauseList : @IReadOnlyList<Assignment> = { first: SetClause & (',' & rest: SetClause)* } => @(Nodes.List(first, rest))

// <set clause>: several targets and a row, or a target and a value.
SetClause : @Assignment
	= '(' & first: SetTarget & (',' & rest: SetTarget)* & ')' & '=' & r: ContextuallyTypedRowValueExpression => @(new Assignment(Nodes.List(first, rest), r, true))
	| t: SetTarget & '=' & v: ContextuallyTypedElement => @(new Assignment([t], v))

// <set target>: a column, an element of one, or a column's attribute set by a mutator, as often as
// there are attributes on the way — <mutated set clause> recurses through <mutated target> on the left.
// The column is read once and what follows it behind: an element of it, or the methods that
// mutate it. Written this way rather than as two alternatives that each begin with the name,
// which an ordered choice would read twice.
SetTarget : @AssignmentTarget = c: ColumnName & t: SetTargetTail => @(Nodes.Assigned(c, t))
SetTargetTail : @Nodes.TargetTail
	= l: LeftBracketOrTrigraph & i: SimpleValueSpecification & RightBracketOrTrigraph => @(new Nodes.TargetTail(i, null, l == "??("))
	| ('.' & m: MethodName)* => @(new Nodes.TargetTail(null, m is { Length: > 0 } ? m : null, false))

// ── §7.6 Data change delta table ────────────────────────────────────────────

// <data change delta table>, <data change statement>: what a data change statement changed, as a table.
DataChangeDeltaTable : @TableSource = o: ("FINAL"i | "NEW"i | "OLD"i) & "TABLE"i & '(' & s: DataChangeStatement & ')' => @(new TableSource.DataChange((o[0] | 0x20) switch { 'f' => ResultOption.Final, 'n' => ResultOption.New, _ => ResultOption.Old }, s))

DataChangeStatement : @Statement = d: DeleteStatementSearched => @(d)
                                 | i: InsertStatement => @(i)
                                 | m: MergeStatement => @(m)
                                 | u: UpdateStatementSearched => @(u)

// ── §11 Schema definition and manipulation ──────────────────────────────────
//
// Schemas and all a schema holds — tables, views, domains, character sets, collations,
// transliterations, assertions, triggers, user-defined types, routines, casts, orderings, transforms,
// sequence generators, roles and privileges — and what alters and drops them.

// <SQL schema statement>: a definition or a manipulation.
SQLSchemaStatement : @Statement
	= s: SchemaDefinition => @(s)
	| t: TableDefinition => @(t)
	| v: ViewDefinition => @(v)
	| sr: SchemaRoutine => @(sr)
	| g: GrantStatement => @(g)
	| r: RoleDefinition => @(r)
	| d: DomainDefinition => @(d)
	| c: CharacterSetDefinition => @(c)
	| o: CollationDefinition => @(o)
	| l: TransliterationDefinition => @(l)
	| a: AssertionDefinition => @(a)
	| tr: TriggerDefinition => @(tr)
	| ut: UserDefinedTypeDefinition => @(ut)
	| uc: UserDefinedCastDefinition => @(uc)
	| uo: UserDefinedOrderingDefinition => @(uo)
	| tf: TransformDefinition => @(tf)
	| q: SequenceGeneratorDefinition => @(q)
	| ds: DropSchemaStatement => @(ds)
	| at: AlterTableStatement => @(at)
	| dt: DropTableStatement => @(dt)
	| dv: DropViewStatement => @(dv)
	| ar: AlterRoutineStatement => @(ar)
	| xr: DropRoutineStatement => @(xr)
	| xc: DropUserDefinedCastStatement => @(xc)
	| rv: RevokeStatement => @(rv)
	| dr: DropRoleStatement => @(dr)
	| ad: AlterDomainStatement => @(ad)
	| dd: DropDomainStatement => @(dd)
	| dc: DropCharacterSetStatement => @(dc)
	| dl: DropCollationStatement => @(dl)
	| dx: DropTransliterationStatement => @(dx)
	| da: DropAssertionStatement => @(da)
	| xt: DropTriggerStatement => @(xt)
	| ay: AlterTypeStatement => @(ay)
	| xy: DropDataTypeStatement => @(xy)
	| xo: DropUserDefinedOrderingStatement => @(xo)
	| af: AlterTransformStatement => @(af)
	| xf: DropTransformStatement => @(xf)
	| aq: AlterSequenceGeneratorStatement => @(aq)
	| dq: DropSequenceGeneratorStatement => @(dq)

// A drop behavior, which every drop but an assertion's must say.
DropBehavior : @DropBehavior = "CASCADE"i => @(DropBehavior.Cascade)
                             | "RESTRICT"i => @(DropBehavior.Restrict)

// ── §11.1 Schema definition, §11.2 Drop schema statement ────────────────────

// <schema definition>. A schema's name and its authorization, or either; the longer is asked first.
SchemaDefinition : @Statement.CreateSchema = "CREATE"i & "SCHEMA"i & n: SchemaNameClause & p: SchemaCharacterSetOrPath? & { (trivia & elements: SchemaElement)* } => @(Nodes.Schema(n, p, elements))

SchemaNameClause : @Nodes.SchemaNaming
	= n: SchemaName & "AUTHORIZATION"i & a: Identifier => @(new Nodes.SchemaNaming(n, new AuthorizationIdentifier(a)))
	| "AUTHORIZATION"i & a: Identifier => @(new Nodes.SchemaNaming(null, new AuthorizationIdentifier(a)))
	| n: SchemaName => @(new Nodes.SchemaNaming(n, null))

SchemaCharacterSetOrPath : @Nodes.SchemaDefaults
	= c: SchemaCharacterSetSpecification & ("PATH"i & first: SchemaName & (',' & rest: SchemaName)*)? => @(new Nodes.SchemaDefaults(c, first is null ? null : new PathSpecification(Nodes.List(first, rest)), false))
	| "PATH"i & first: SchemaName & (',' & rest: SchemaName)* & c: SchemaCharacterSetSpecification? => @(new Nodes.SchemaDefaults(c, new PathSpecification(Nodes.List(first, rest)), true))

SchemaCharacterSetSpecification : @CharacterSetName = "DEFAULT"i & "CHARACTER"i & "SET"i & c: CharacterSetSpecification => @(c)

SchemaElement : @Statement
	= t: TableDefinition => @(t)
	| v: ViewDefinition => @(v)
	| d: DomainDefinition => @(d)
	| c: CharacterSetDefinition => @(c)
	| o: CollationDefinition => @(o)
	| l: TransliterationDefinition => @(l)
	| a: AssertionDefinition => @(a)
	| tr: TriggerDefinition => @(tr)
	| ut: UserDefinedTypeDefinition => @(ut)
	| uc: UserDefinedCastDefinition => @(uc)
	| uo: UserDefinedOrderingDefinition => @(uo)
	| tf: TransformDefinition => @(tf)
	| sr: SchemaRoutine => @(sr)
	| q: SequenceGeneratorDefinition => @(q)
	| g: GrantStatement => @(g)
	| r: RoleDefinition => @(r)

DropSchemaStatement : @Statement.DropSchema = "DROP"i & "SCHEMA"i & n: SchemaName & b: DropBehavior => @(new Statement.DropSchema { Names = [n], Behavior = b })

// ── §11.3 Table definition ──────────────────────────────────────────────────

// <table definition>. A table's contents are its elements or a query's result. A column list before
// a query is an element list in shape — `(a, b)` is two columns with no type — so the query is asked
// first: in a schema's elements, which give nothing back, the element list would end the table before
// its `AS`.
TableDefinition : @Statement.CreateTable = "CREATE"i & s: (("GLOBAL"i | "LOCAL"i) & "TEMPORARY"i)? & "TABLE"i & n: TableName & c: TableContentsSource
	  & v: ("WITH"i & "SYSTEM"i & "VERSIONING"i)? & ("ON"i & "COMMIT"i & o: ("PRESERVE"i | "DELETE"i) & "ROWS"i)?
	  => @(new Statement.CreateTable { Scope = Nodes.ScopeOf(s), Name = n, Contents = c, SystemVersioning = v is not null, OnCommit = Nodes.CommitOf(o) })

// `(a, b) AS … WITH DATA` and a list of elements `(a, b)` — a column may be defined without a
// type — are told apart only by the `AS` after the bracket, which is the language's. Read once, the
// bracket would be a list of elements that becomes a list of names where `AS` follows; left as it is
// until nothing else holds the expressions on the tape (Q7.1 §5).
TableContentsSource : @TableContents
	= ('(' & columns: ColumnNameList & ')')? & "AS"i & q: TableSubquery & "WITH"i & no: "NO"i? & "DATA"i => @(new TableContents.AsQuery(columns ?? System.Array.Empty<Identifier>(), q, no is null ? WithDataMode.WithData : WithDataMode.WithNoData))
	| e: TableElementList => @(new TableContents.Elements(e))
	| t: TypedTableClause => @(t)

// <typed table clause>: a table of a structured type, under a supertable, with options for its
// columns, constraints, and the column that references its rows.
TypedTableClause      : @TableContents = "OF"i & n: PathResolvedUserDefinedTypeName & ("UNDER"i & u: TableName)? & e: TypedTableElementList? => @(new TableContents.Typed(n, u, e ?? System.Array.Empty<TableElement>()))
TypedTableElementList : @IReadOnlyList<TableElement> = '(' & { first: TypedTableElement & (',' & rest: TypedTableElement)* } & ')' => @(Nodes.List(first, rest))
TypedTableElement     : @TableElement = s: SelfReferencingColumnSpecification => @(s)
                                      | c: TableConstraintDefinition => @(new TableElement.TableConstraint(c))
                                      | o: ColumnOptions => @(o)

SelfReferencingColumnSpecification : @TableElement = "REF"i & "IS"i & n: ColumnName & g: ReferenceGeneration? => @(new TableElement.SelfReference(n, g))

// Not a production: how the values of a self-referencing column are made.
ReferenceGeneration : @ReferenceGeneration = "SYSTEM"i & "GENERATED"i => @(ReferenceGeneration.SystemGenerated)
                                           | "USER"i & "GENERATED"i => @(ReferenceGeneration.UserGenerated)
                                           | "DERIVED"i => @(ReferenceGeneration.Derived)

// <column options>: a scope, a default and constraints, any of them.
ColumnOptions : @TableElement = n: ColumnName & "WITH"i & "OPTIONS"i & ("SCOPE"i & s: TableName)? & d: DefaultClause? & (trivia & { constraints: ColumnConstraintDefinition })* => @(new TableElement.ColumnOptions(n, new ColumnOptionList(s, d, constraints ?? System.Array.Empty<Constraint>())))

// The list is atomic: a list refused at its end gave back its elements, and their shorter readings,
// and read every later element again for each — a square of its length.
TableElementList : @IReadOnlyList<TableElement> = '(' & { first: TableElement & (',' & rest: TableElement)* } & ')' => @(Nodes.List(first, rest))

// <table element>. A column begins with its name, which none of the others' key words can be.
TableElement : @TableElement = c: ColumnDefinition => @(new TableElement.Column(c))
                             | p: TablePeriodDefinition => @(new TableElement.Period(p))
                             | t: TableConstraintDefinition => @(new TableElement.TableConstraint(t))
                             | l: LikeClause => @(l)

// <like clause>.
LikeClause : @TableElement = "LIKE"i & n: TableName & (trivia & options: LikeOption)* => @(new TableElement.Like(n, options ?? System.Array.Empty<LikeOption>()))
LikeOption : @LikeOption = w: ("INCLUDING"i | "EXCLUDING"i) & k: ("IDENTITY"i | "DEFAULTS"i | "GENERATED"i) => @(Nodes.LikeOptionOf(w, k))

// <table period definition>.
TablePeriodDefinition  : @PeriodDefinition = p: PeriodForSpecification & '(' & b: ColumnName & ',' & e: ColumnName & ')' => @(new PeriodDefinition(p.Kind, p.Name, b, e))
PeriodForSpecification : @Nodes.PeriodName = "PERIOD"i & "FOR"i & "SYSTEM_TIME"i => @(new Nodes.PeriodName(PeriodKind.SystemTime, null))
                                           | "PERIOD"i & "FOR"i & n: Identifier => @(new Nodes.PeriodName(PeriodKind.ApplicationTime, n))

// ── §11.4 Column definition ─────────────────────────────────────────────────

// <column definition>: a name, a type or a domain's name — which <data type> reads — or neither, one
// of a default, an identity, a generation expression and a system time period's row start or end,
// then constraints, and a collation.
//
// `GENERATED` is not reserved, and a user-defined type may be named so; the list of elements gives
// nothing back once it is read, so a type is not taken where `GENERATED ALWAYS` or `GENERATED BY`
// follows, which only a generation can go on from.
ColumnDefinition : @ColumnDefinition = n: ColumnName & (?!("GENERATED"i & ("ALWAYS"i | "BY"i)) & t: DataType)? & g: ColumnValueSource? & (trivia & { constraints: ColumnConstraintDefinition })* & c: CollateClause?
	  => @(new ColumnDefinition(n, t, g, constraints ?? System.Array.Empty<Constraint>(), c))

ColumnValueSource : @ColumnGeneration
	= d: DefaultClause => @(new ColumnGeneration.Default(d))
	| "GENERATED"i & i: IdentityGeneration & "AS"i & "IDENTITY"i & ('(' & o: CommonSequenceGeneratorOptions & ')')? => @(new ColumnGeneration.Identity(i, o ?? System.Array.Empty<SequenceOption>()))
	| "GENERATED"i & "ALWAYS"i & "AS"i & '(' & e: ValueNode & ')' => @(new ColumnGeneration.Generated(e))
	| "GENERATED"i & "ALWAYS"i & "AS"i & "ROW"i & "START"i => @(new ColumnGeneration.RowStart())
	| "GENERATED"i & "ALWAYS"i & "AS"i & "ROW"i & "END"i => @(new ColumnGeneration.RowEnd())

// Not a production: `ALWAYS` or `BY DEFAULT`, an identity column's.
IdentityGeneration : @IdentityGeneration = "ALWAYS"i => @(IdentityGeneration.Always)
                                         | "BY"i & "DEFAULT"i => @(IdentityGeneration.ByDefault)

ColumnConstraintDefinition : @Constraint = n: ConstraintNameDefinition? & c: ColumnConstraint & k: ConstraintCharacteristics? => @(c with { Name = n, Characteristics = k })

ColumnConstraint : @Constraint
	= "NOT"i & "NULL"i => @(new Constraint.NotNull())
	| "UNIQUE"i => @(new Constraint.Unique(UniqueKind.Unique, null, System.Array.Empty<Identifier>()))
	| "PRIMARY"i & "KEY"i => @(new Constraint.Unique(UniqueKind.PrimaryKey, null, System.Array.Empty<Identifier>()))
	| r: ReferencesSpecification => @(new Constraint.ForeignKey(System.Array.Empty<Identifier>(), null, r))
	| c: CheckConstraintDefinition => @(c)

// ── §11.5 Default clause ────────────────────────────────────────────────────

// <default clause>: a literal, a datetime value function, a user or a schema of the session, or a
// value whose type comes from the column; no expression.
DefaultClause : @Expression = "DEFAULT"i & o: DefaultOption => @(o)

DefaultOption : @Expression
	= l: Literal => @(new Expression.Literal(l))
	| f: DatetimeValueFunction => @(f)
	| w: ("USER"i | "CURRENT_USER"i | "CURRENT_ROLE"i | "SESSION_USER"i | "SYSTEM_USER"i) => @(Nodes.Current(w))
	| w: ("CURRENT_CATALOG"i | "CURRENT_SCHEMA"i | "CURRENT_PATH"i) => @(Nodes.Current(w))
	| i: ImplicitlyTypedValueSpecification => @(i)

// ── §11.6 Table constraint definition ───────────────────────────────────────

TableConstraintDefinition : @Constraint = n: ConstraintNameDefinition? & c: TableConstraint & k: ConstraintCharacteristics? => @(c with { Name = n, Characteristics = k })

TableConstraint : @Constraint
	= "UNIQUE"i & '(' & "VALUE"i & ')' => @(new Constraint.Unique(UniqueKind.UniqueValue, null, System.Array.Empty<Identifier>()))
	// The list is written out rather than called, so that a name followed by `WITHOUT OVERLAPS`
	// is left to the period it belongs to. Over characters the list gives the name back when the
	// closing bracket does not come; over kinds the reading that fits is the one that stands.
	| u: ("UNIQUE"i | "PRIMARY"i & "KEY"i) & ("NULLS"i & nn: "NOT"i? & d: "DISTINCT"i)? & '(' & first: ColumnName & (',' & rest: ColumnName & ?!("WITHOUT"i & "OVERLAPS"i))* & (',' & p: Identifier & "WITHOUT"i & "OVERLAPS"i)? & ')'
	  => @(new Constraint.Unique((u[0] | 0x20) == 'u' ? UniqueKind.Unique : UniqueKind.PrimaryKey, Nodes.Nulls(d, nn), Nodes.List(first, rest), p))
	| "FOREIGN"i & "KEY"i & '(' & keys: ColumnNameList & (',' & "PERIOD"i & period: Identifier)? & ')' & r: ReferencesSpecification => @(new Constraint.ForeignKey(keys, period, r))
	| c: CheckConstraintDefinition => @(c)

ConstraintNameDefinition : @QualifiedName = "CONSTRAINT"i & n: SchemaQualifiedName => @(n)

// <constraint characteristics>: when it is checked, whether that may be deferred, and whether it is enforced.
ConstraintCharacteristics : @ConstraintCharacteristics
	= t: ConstraintCheckTime & (n: "NOT"i? & d: "DEFERRABLE"i)? & e: ConstraintEnforcement? => @(new ConstraintCharacteristics(t, d is null ? null : n is null, e))
	| n: "NOT"i? & "DEFERRABLE"i & later: ConstraintCheckTime? & e: ConstraintEnforcement? => @(new ConstraintCharacteristics(later, n is null, e, true))
	| only: ConstraintEnforcement => @(new ConstraintCharacteristics(null, null, only))

ConstraintCheckTime   : @ConstraintTiming = "INITIALLY"i & "DEFERRED"i => @(ConstraintTiming.InitiallyDeferred)
                                          | "INITIALLY"i & "IMMEDIATE"i => @(ConstraintTiming.InitiallyImmediate)
ConstraintEnforcement : @bool = n: "NOT"i? & "ENFORCED"i => @(n is null)

// ── §11.8 Referential constraint definition, §11.9 Check constraint definition ─

ReferencesSpecification : @ReferencesSpecification = "REFERENCES"i & n: TableName & ('(' & columns: ColumnNameList & (',' & "PERIOD"i & p: Identifier)? & ')')?
	  & ("MATCH"i & m: ("FULL"i | "PARTIAL"i | "SIMPLE"i))? & a: ReferentialTriggeredAction?
	  => @(new ReferencesSpecification(n, columns ?? System.Array.Empty<Identifier>(), p, Nodes.Matching(m), a?.OnUpdate, a?.OnDelete, a?.DeleteFirst ?? false))

// <referential triggered action>: an update rule, a delete rule, or both in either order.
ReferentialTriggeredAction : @Nodes.ReferentialRules
	= u: UpdateRule & d: DeleteRule? => @(new Nodes.ReferentialRules(u, d, false))
	| deleted: DeleteRule & updated: UpdateRule? => @(new Nodes.ReferentialRules(updated, deleted, true))

UpdateRule        : @ReferentialAction = "ON"i & "UPDATE"i & a: ReferentialAction => @(a)
DeleteRule        : @ReferentialAction = "ON"i & "DELETE"i & a: ReferentialAction => @(a)
ReferentialAction : @ReferentialAction = "CASCADE"i => @(ReferentialAction.Cascade)
                                       | "SET"i & "NULL"i => @(ReferentialAction.SetNull)
                                       | "SET"i & "DEFAULT"i => @(ReferentialAction.SetDefault)
                                       | "RESTRICT"i => @(ReferentialAction.Restrict)
                                       | "NO"i & "ACTION"i => @(ReferentialAction.NoAction)

CheckConstraintDefinition : @Constraint = "CHECK"i & '(' & c: SearchCondition & ')' => @(new Constraint.Check(c.Node))

// ── §11.10 Alter table statement and its actions ────────────────────────────

AlterTableStatement : @Statement.AlterTable = "ALTER"i & "TABLE"i & n: TableName & a: AlterTableAction => @(new Statement.AlterTable { Name = n, Actions = [a] })

// <alter table action>: one. A column is named with or without `COLUMN`, and a column's name is none
// of the key words that begin the other actions.
AlterTableAction : @AlterTableAction
	= "ADD"i & k: "COLUMN"i? & c: ColumnDefinition => @(new AlterTableAction.AddColumn(c, k is not null))
	| "ALTER"i & k: "COLUMN"i? & n: ColumnName & a: AlterColumnAction => @(new AlterTableAction.AlterColumn(n, a, k is not null))
	| "DROP"i & k: "COLUMN"i? & n: ColumnName & b: DropBehavior => @(new AlterTableAction.DropColumn(n, b, k is not null))
	| "ADD"i & t: TableConstraintDefinition => @(new AlterTableAction.AddConstraint(t))
	| "ALTER"i & "CONSTRAINT"i & q: SchemaQualifiedName & e: ConstraintEnforcement => @(new AlterTableAction.AlterConstraint(q, e))
	| "DROP"i & "CONSTRAINT"i & q: SchemaQualifiedName & b: DropBehavior => @(new AlterTableAction.DropConstraint(q, b))
	| "ADD"i & p: TablePeriodDefinition & ("ADD"i & k1: "COLUMN"i? & c1: ColumnDefinition & "ADD"i & k2: "COLUMN"i? & c2: ColumnDefinition)? => @(Nodes.AddPeriod(p, c1, k1, c2, k2))
	| "DROP"i & f: PeriodForSpecification & b: DropBehavior => @(new AlterTableAction.DropPeriod(f.Kind, f.Name, b))
	| "ADD"i & "SYSTEM"i & "VERSIONING"i => @(new AlterTableAction.AddSystemVersioning())
	| "DROP"i & "SYSTEM"i & "VERSIONING"i & b: DropBehavior => @(new AlterTableAction.DropSystemVersioning(b))

// <alter column action>.
AlterColumnAction : @AlterColumnAction
	= "SET"i & d: DefaultClause => @(new AlterColumnAction.SetDefault(d))
	| "DROP"i & "DEFAULT"i => @(new AlterColumnAction.DropDefault())
	| "SET"i & "NOT"i & "NULL"i => @(new AlterColumnAction.SetNotNull())
	| "DROP"i & "NOT"i & "NULL"i => @(new AlterColumnAction.DropNotNull())
	| "ADD"i & "SCOPE"i & n: TableName => @(new AlterColumnAction.AddScope(n))
	| "DROP"i & "SCOPE"i & b: DropBehavior => @(new AlterColumnAction.DropScope(b))
	| "SET"i & "DATA"i & "TYPE"i & t: DataType => @(new AlterColumnAction.SetDataType(t))
	| "SET"i & "GENERATED"i & g: IdentityGeneration & (trivia & options: AlterIdentityColumnOption)* => @(new AlterColumnAction.SetIdentityGeneration(g, options ?? System.Array.Empty<SequenceOption>()))
	| first: AlterIdentityColumnOption & (trivia & rest: AlterIdentityColumnOption)* => @(new AlterColumnAction.IdentityOptions(Nodes.List(first, rest)))
	| "DROP"i & "IDENTITY"i => @(new AlterColumnAction.DropIdentity())
	| "DROP"i & "EXPRESSION"i => @(new AlterColumnAction.DropExpression())

AlterIdentityColumnOption : @SequenceOption
	= "RESTART"i & ("WITH"i & v: SignedNumericLiteral)? => @(new SequenceOption.Restart(Nodes.LiteralOrNull(v)))
	| "SET"i & o: BasicSequenceGeneratorOption => @(o)

DropTableStatement : @Statement.DropTable = "DROP"i & "TABLE"i & n: TableName & b: DropBehavior => @(new Statement.DropTable { Names = [n], Behavior = b })

// ── §11.22 View definition, §11.23 Drop view statement ──────────────────────

ViewDefinition : @Statement.CreateView = "CREATE"i & r: "RECURSIVE"i? & "VIEW"i & n: TableName & s: ViewSpecification & "AS"i & q: QueryExpression
	  & ("WITH"i & o: ("CASCADED"i | "LOCAL"i)? & c: "CHECK"i & "OPTION"i)?
	  => @(new Statement.CreateView { Recursive = r is not null, Name = n, Specification = s, Query = q, CheckOption = Nodes.CheckOptionOf(c, o) })

// <view specification>: a view of a structured type, with its self-referencing column and its columns'
// scopes, or a regular view with its columns named or not.
ViewSpecification : @ViewSpecification
	= "OF"i & t: PathResolvedUserDefinedTypeName & ("UNDER"i & u: TableName)? & e: ViewElementList? => @(new ViewSpecification.Referenceable(t, u, e ?? System.Array.Empty<ViewElement>()))
	| ('(' & columns: ColumnNameList & ')')? => @(new ViewSpecification.Regular(columns ?? System.Array.Empty<Identifier>()))

ViewElementList : @IReadOnlyList<ViewElement> = '(' & { first: ViewElement & (',' & rest: ViewElement)* } & ')' => @(Nodes.List(first, rest))
ViewElement     : @ViewElement = "REF"i & "IS"i & n: ColumnName & g: ReferenceGeneration? => @(new ViewElement.SelfReference(n, g))
                               | n: ColumnName & "WITH"i & "OPTIONS"i & "SCOPE"i & s: TableName => @(new ViewElement.ColumnOption(n, s))

DropViewStatement : @Statement.DropView = "DROP"i & "VIEW"i & n: TableName & b: DropBehavior => @(new Statement.DropView { Names = [n], Behavior = b })

// ── §11.24 Domain definition, §11.26–11.31 Alter and drop domain ────────────

// <domain definition>: of a predefined type only, which a collection is not.
DomainDefinition : @Statement.CreateDomain = "CREATE"i & "DOMAIN"i & n: SchemaQualifiedName & a: "AS"i? & t: PredefinedType & d: DefaultClause? & { (trivia & constraints: DomainConstraint)* } & c: CollateClause?
	  => @(new Statement.CreateDomain { Name = n, AsKeyword = a is not null, Type = t, Default = d, Constraints = constraints ?? System.Array.Empty<Constraint>(), Collation = c })
DomainConstraint : @Constraint = n: ConstraintNameDefinition? & c: CheckConstraintDefinition & k: ConstraintCharacteristics? => @(c with { Name = n, Characteristics = k })

AlterDomainStatement : @Statement.AlterDomain = "ALTER"i & "DOMAIN"i & n: SchemaQualifiedName & a: AlterDomainAction => @(new Statement.AlterDomain { Name = n, Action = a })
AlterDomainAction : @AlterDomainAction
	= "SET"i & d: DefaultClause => @(new AlterDomainAction.SetDefault(d))
	| "DROP"i & "DEFAULT"i => @(new AlterDomainAction.DropDefault())
	| "ADD"i & c: DomainConstraint => @(new AlterDomainAction.AddConstraint(c))
	| "DROP"i & "CONSTRAINT"i & q: SchemaQualifiedName => @(new AlterDomainAction.DropConstraint(q))

DropDomainStatement : @Statement.DropDomain = "DROP"i & "DOMAIN"i & n: SchemaQualifiedName & b: DropBehavior => @(new Statement.DropDomain { Name = n, Behavior = b })

// ── §11.47 Assertion definition, §11.48 Drop assertion statement ────────────

AssertionDefinition    : @Statement.CreateAssertion = "CREATE"i & "ASSERTION"i & n: SchemaQualifiedName & c: CheckConstraintDefinition & k: ConstraintCharacteristics? => @(new Statement.CreateAssertion { Name = n, Condition = ((Constraint.Check)c).Condition, Characteristics = k })
DropAssertionStatement : @Statement.DropAssertion = "DROP"i & "ASSERTION"i & n: SchemaQualifiedName & b: DropBehavior? => @(new Statement.DropAssertion { Name = n, Behavior = b })

// ── §11.49 Trigger definition, §11.50 Drop trigger statement ────────────────

TriggerDefinition : @Statement.CreateTrigger = "CREATE"i & "TRIGGER"i & n: SchemaQualifiedName & t: TriggerActionTime & e: TriggerEvent & "ON"i & o: TableName
	  & ("REFERENCING"i & { (trivia & references: TransitionTableOrVariable)+ })? & a: TriggeredAction
	  => @(new Statement.CreateTrigger { Name = n, Time = t, Event = e, Table = o, Referencing = references ?? System.Array.Empty<TransitionReference>(), Action = a })

TriggerActionTime : @TriggerTime = "BEFORE"i => @(TriggerTime.Before)
                                 | "AFTER"i => @(TriggerTime.After)
                                 | "INSTEAD"i & "OF"i => @(TriggerTime.InsteadOf)
TriggerEvent      : @TriggerEvent = "INSERT"i => @(new TriggerEvent(TriggerEventKind.Insert, System.Array.Empty<Identifier>()))
                                  | "DELETE"i => @(new TriggerEvent(TriggerEventKind.Delete, System.Array.Empty<Identifier>()))
                                  | "UPDATE"i & ("OF"i & columns: ColumnNameList)? => @(new TriggerEvent(TriggerEventKind.Update, columns ?? System.Array.Empty<Identifier>()))

// <transition table or variable>: a table asked first, since `TABLE` is reserved and no variable's name.
TransitionTableOrVariable : @TransitionReference
	= w: ("OLD"i | "NEW"i) & "TABLE"i & a: "AS"i? & n: Identifier => @(new TransitionReference((w[0] | 0x20) == 'o' ? TransitionKind.OldTable : TransitionKind.NewTable, n, false, a is not null))
	| w: ("OLD"i | "NEW"i) & r: "ROW"i? & a: "AS"i? & n: CorrelationName => @(new TransitionReference((w[0] | 0x20) == 'o' ? TransitionKind.OldRow : TransitionKind.NewRow, n, r is not null, a is not null))

TriggeredAction       : @TriggerAction = ("FOR"i & "EACH"i & g: ("ROW"i | "STATEMENT"i))? & c: TriggeredWhenClause? & s: TriggeredSQLStatement => @(new TriggerAction(Nodes.GranularityOf(g), c, s.Statements, s.Atomic))
TriggeredWhenClause   : @Expression = "WHEN"i & '(' & c: SearchCondition & ')' => @(c.Node)
TriggeredSQLStatement : @Nodes.Triggered = s: SQLProcedureStatement => @(new Nodes.Triggered(new[] { s }, false))
                                         | c: CompoundTriggeredSQLStatement => @(c)

// <compound triggered SQL statement>: one statement at least, each with its semicolon.
CompoundTriggeredSQLStatement : @Nodes.Triggered = "BEGIN"i & "ATOMIC"i & { (statements: SQLProcedureStatement & ';')+ } & "END"i => @(new Nodes.Triggered(statements, true))

// <drop trigger statement>, which says no drop behavior.
DropTriggerStatement : @Statement.DropTrigger = "DROP"i & "TRIGGER"i & n: SchemaQualifiedName => @(new Statement.DropTrigger { Names = [n] })

// ── §11 SQL-invoked routines, alter routine, drop routine ───────────────────

// <schema routine>: a procedure, a function or a method, created.
SchemaRoutine       : @Statement.CreateRoutine = "CREATE"i & d: InvokedRoutine => @(new Statement.CreateRoutine { Definition = d })
InvokedRoutine      : @RoutineDefinition = p: SQLInvokedProcedure => @(p)
                                         | f: SQLInvokedFunction => @(f)
SQLInvokedProcedure : @RoutineDefinition = "PROCEDURE"i & n: SchemaQualifiedName & p: SQLParameterDeclarationList & c: RoutineCharacteristics & b: RoutineBody
	  => @(new RoutineDefinition(RoutineKind.Procedure, n, p, null, c, b))
SQLInvokedFunction  : @RoutineDefinition = f: FunctionSpecification & b: RoutineBody => @(f with { Body = b })
                                         | m: MethodSpecificationDesignator & body: RoutineBody => @(m with { Body = body })

FunctionSpecification : @RoutineDefinition = "FUNCTION"i & n: SchemaQualifiedName & p: SQLParameterDeclarationList & r: ReturnsClause & c: RoutineCharacteristics & d: ("STATIC"i & "DISPATCH"i)?
	  => @(new RoutineDefinition(RoutineKind.Function, n, p, r, c, null!, StaticDispatch: d is not null))

// <method specification designator>, which says no characteristics.
MethodSpecificationDesignator : @RoutineDefinition
	= "SPECIFIC"i & "METHOD"i & n: SchemaQualifiedName
	  => @(new RoutineDefinition(RoutineKind.Method, n, System.Array.Empty<ParameterDefinition>(), null, System.Array.Empty<RoutineCharacteristic>(), null!, SpecificMethod: true))
	| m: ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i & k: MethodName & p: SQLParameterDeclarationList & r: ReturnsClause? & "FOR"i & t: SchemaQualifiedName
	  => @(new RoutineDefinition(RoutineKind.Method, new QualifiedName([k]), p, r, System.Array.Empty<RoutineCharacteristic>(), null!, Nodes.Method(m).Modifier, t))

SQLParameterDeclarationList : @IReadOnlyList<ParameterDefinition> = '(' & { first: SQLParameterDeclaration & (',' & rest: SQLParameterDeclaration)* }? & ')' => @(Nodes.ListOrEmpty(first, rest))

// <SQL parameter declaration>. A parameter's name is asked before its type, which a user-defined
// type's name could be: `(a b)` is a parameter `a` of type `b`, and `(a)` one of type `a`.
// Over kinds the reading that fits is the one that stands, so the name is taken only where a
// type follows it — `(DESCRIPTOR)` is a descriptor parameter and not a parameter named so
// (GRAM5009). The assertion reads the type twice, which is a reason for Replay and recorded
// as one.
SQLParameterDeclaration : @ParameterDefinition = m: ("IN"i | "OUT"i | "INOUT"i)? & (n: Identifier & ?=ParameterType)? & t: ParameterType & r: "RESULT"i? & ("DEFAULT"i & d: ParameterDefault)?
	  => @(new ParameterDefinition(Nodes.ModeOf(m), n, t.Type, r is not null, d, t.Locator))

ParameterType : @Nodes.ParameterTyped
	= t: DataType & l: LocatorIndication? => @(new Nodes.ParameterTyped(t, l is not null))
	| "TABLE"i & p: PassThroughOption? & s: TableSemanticsOption? => @(new Nodes.ParameterTyped(new DataType.GenericTable(p, s?.Semantics, s?.Pruning), false))
	| "DESCRIPTOR"i => @(new Nodes.ParameterTyped(new DataType.Descriptor(), false))

// A table parameter's pass-through, its semantics, and what a set's does with no rows.
PassThroughOption    : @PassThroughMode = "PASS"i & "THROUGH"i => @(PassThroughMode.PassThrough)
                                        | "NO"i & "PASS"i & "THROUGH"i => @(PassThroughMode.NoPassThrough)
TableSemanticsOption : @Nodes.TableSemanticsOf = "WITH"i & "ROW"i & "SEMANTICS"i => @(new Nodes.TableSemanticsOf(TableSemantics.Row, null))
                                        | "WITH"i & "SET"i & "SEMANTICS"i & u: PruningOption? => @(new Nodes.TableSemanticsOf(TableSemantics.Set, u))
PruningOption        : @TablePruning = "PRUNE"i & "ON"i & "EMPTY"i => @(TablePruning.PruneOnEmpty)
                                     | "KEEP"i & "ON"i & "EMPTY"i => @(TablePruning.KeepOnEmpty)

LocatorIndication = "AS"i & "LOCATOR"i

// <parameter default>. A descriptor is asked first: `DESCRIPTOR` is not reserved, and a value
// expression would read it as a column and end the parameter list, which gives nothing back.
ParameterDefault : @Expression = d: DescriptorValueConstructor => @(d)
                               | v: ValueExpression => @(v.Node)
                               | c: ContextuallyTypedValueSpecification => @(c)

DescriptorValueConstructor    : @Expression = "DESCRIPTOR"i & '(' & { first: DescriptorColumnSpecification & (',' & rest: DescriptorColumnSpecification)* } & ')' => @(new Expression.DescriptorConstructor(Nodes.List(first, rest)))
DescriptorColumnSpecification : @DescriptorColumn = n: ColumnName & t: DataType? => @(new DescriptorColumn(n, t))

ReturnsClause : @ReturnsDefinition = "RETURNS"i & t: ReturnsType => @(t)

// <returns type>: a table, asked first since `TABLE` and `ONLY` are reserved, or a data type.
ReturnsType : @ReturnsDefinition
	= "TABLE"i & ('(' & { first: ReturnsTableColumn & (',' & rest: ReturnsTableColumn)* } & ')')? => @(new ReturnsDefinition(null, first is null ? null : Nodes.List(first, rest)) { TableKeyword = true })
	| "ONLY"i & "PASS"i & "THROUGH"i => @(new ReturnsDefinition(null, null, true))
	| t: DataType & l: LocatorIndication? & ("CAST"i & "FROM"i & f: DataType & fl: LocatorIndication?)? => @(new ReturnsDefinition(t, null) { Locator = l is not null, CastFrom = f, CastFromLocator = fl is not null })

// A column of a returned table.
ReturnsTableColumn : @FieldDefinition = n: ColumnName & t: DataType => @(new FieldDefinition(n, t))

// <routine characteristics>: none begins a statement, so all of them are read before the body.
RoutineCharacteristics : @IReadOnlyList<RoutineCharacteristic> = { (trivia & items: RoutineCharacteristic)* } => @(items ?? System.Array.Empty<RoutineCharacteristic>())

RoutineCharacteristic : @RoutineCharacteristic
	= l: LanguageClause => @(l)
	| s: ParameterStyleClause => @(new RoutineCharacteristic.ParameterStyle(s))
	| "SPECIFIC"i & n: SchemaQualifiedName => @(new RoutineCharacteristic.Specific(n))
	| d: "NOT"i? & "DETERMINISTIC"i => @(new RoutineCharacteristic.Deterministic(d is null))
	| a: SQLDataAccessIndication => @(new RoutineCharacteristic.DataAccess(a))
	| c: NullCallClause => @(new RoutineCharacteristic.NullCall(c))
	| r: ReturnedResultSetsCharacteristic => @(new RoutineCharacteristic.DynamicResultSets(r))
	| w: ("NEW"i | "OLD"i) & "SAVEPOINT"i & "LEVEL"i => @(new RoutineCharacteristic.SavepointLevel((w[0] | 0x20) == 'n' ? SavepointLevelKind.New : SavepointLevelKind.Old))

LanguageClause                   : @RoutineCharacteristic = "LANGUAGE"i & n: ("ADA"i | "COBOL"i | "C"i | "FORTRAN"i | "MUMPS"i | "M"i | "PASCAL"i | "PLI"i | "SQL"i) => @(new RoutineCharacteristic.Language(n))
ParameterStyleClause             : @ParameterStyleKind = "PARAMETER"i & "STYLE"i & "SQL"i => @(ParameterStyleKind.Sql)
                                                       | "PARAMETER"i & "STYLE"i & "GENERAL"i => @(ParameterStyleKind.General)
SQLDataAccessIndication          : @SqlDataAccess = "NO"i & "SQL"i => @(SqlDataAccess.NoSql)
                                                  | "CONTAINS"i & "SQL"i => @(SqlDataAccess.ContainsSql)
                                                  | "READS"i & "SQL"i & "DATA"i => @(SqlDataAccess.ReadsSqlData)
                                                  | "MODIFIES"i & "SQL"i & "DATA"i => @(SqlDataAccess.ModifiesSqlData)
NullCallClause                   : @NullCallMode = "RETURNS"i & "NULL"i & "ON"i & "NULL"i & "INPUT"i => @(NullCallMode.ReturnsNullOnNullInput)
                                                 | "CALLED"i & "ON"i & "NULL"i & "INPUT"i => @(NullCallMode.CalledOnNullInput)
ReturnedResultSetsCharacteristic : @int = "DYNAMIC"i & "RESULT"i & "SETS"i & n: UnsignedInteger => @(Nodes.Integer(n)!.Value)

// <routine body>: a statement, with the rights it runs with, or a reference to an external body, or a
// polymorphic table function's component procedures.
RoutineBody : @RoutineBody
	= ("SQL"i & "SECURITY"i & s: ("INVOKER"i | "DEFINER"i))? & p: SQLProcedureStatement => @(new RoutineBody.Sql(p, Nodes.SecurityOf(s)))
	| e: ExternalBodyReference => @(e)
	| t: PolymorphicTableFunctionBody => @(new RoutineBody.PolymorphicTableFunction(t))

ExternalBodyReference : @RoutineBody = "EXTERNAL"i & ("NAME"i & n: ExternalRoutineName)? & p: ParameterStyleClause? & g: TransformGroupSpecification? & ("EXTERNAL"i & "SECURITY"i & s: ExternalSecurityClause)?
	  => @(new RoutineBody.External(n, p, g, s))

ExternalSecurityClause : @ExternalSecurity = "DEFINER"i => @(ExternalSecurity.Definer)
                                           | "INVOKER"i => @(ExternalSecurity.Invoker)
                                           | "IMPLEMENTATION"i & "DEFINED"i => @(ExternalSecurity.ImplementationDefined)

// <external routine name>, as it is written: `x` and `'x'` are two names.
ExternalRoutineName = Identifier | CharacterStringLiteral

// <transform group specification>: groups for types, asked before a single group, whose name begins them.
TransformGroupSpecification : @TransformGroupSpecification
	= "TRANSFORM"i & "GROUP"i & first: GroupSpecification & (',' & rest: GroupSpecification)* => @(new TransformGroupSpecification(null, Nodes.List(first, rest)))
	| "TRANSFORM"i & "GROUP"i & i: Identifier => @(new TransformGroupSpecification(i, System.Array.Empty<TransformGroupForType>()))
GroupSpecification          : @TransformGroupForType = i: Identifier & "FOR"i & "TYPE"i & t: SchemaQualifiedName => @(new TransformGroupForType(i, t))

PolymorphicTableFunctionBody : @PolymorphicTableFunctionBody = ("PRIVATE"i & k: "DATA"i? & p: SQLParameterDeclarationList)? & ("DESCRIBE"i & "WITH"i & d: SpecificRoutineDesignator)?
	  & ("START"i & "WITH"i & s: SpecificRoutineDesignator)? & "FULFILL"i & "WITH"i & f: SpecificRoutineDesignator & ("FINISH"i & "WITH"i & e: SpecificRoutineDesignator)?
	  => @(new PolymorphicTableFunctionBody(p, d, s, f, e, k is not null))

// <SQL procedure statement>, <SQL executable statement>: what a routine's body and a trigger's action are.
SQLProcedureStatement : @Statement = s: SQLExecutableStatement => @(s)

// Dynamic statements are asked before data statements: a searched `UPDATE` or `DELETE` reads what
// comes before a dynamic cursor's `WHERE CURRENT OF GLOBAL :c` and ends, and in a schema's elements,
// which give nothing back, the schema would end there.
SQLExecutableStatement : @Statement
	= s: SQLSchemaStatement => @(s)
	| y: SQLDynamicStatement => @(y)
	| d: SQLDataStatement => @(d)
	| c: SQLControlStatement => @(c)
	| t: SQLTransactionStatement => @(t)
	| n: SQLConnectionStatement => @(n)
	| e: SQLSessionStatement => @(e)
	| g: SQLDiagnosticsStatement => @(g)

// <alter routine statement>: a characteristic at least, and no behavior but `RESTRICT`.
AlterRoutineStatement : @Statement.AlterRoutine = "ALTER"i & r: SpecificRoutineDesignator & { (trivia & items: AlterRoutineCharacteristic)+ } & "RESTRICT"i
	  => @(new Statement.AlterRoutine { Routine = r, Characteristics = items, Behavior = AlterRoutineBehavior.Restrict })

AlterRoutineCharacteristic : @RoutineCharacteristic
	= l: LanguageClause => @(l)
	| s: ParameterStyleClause => @(new RoutineCharacteristic.ParameterStyle(s))
	| a: SQLDataAccessIndication => @(new RoutineCharacteristic.DataAccess(a))
	| c: NullCallClause => @(new RoutineCharacteristic.NullCall(c))
	| r: ReturnedResultSetsCharacteristic => @(new RoutineCharacteristic.DynamicResultSets(r))
	| "NAME"i & n: ExternalRoutineName => @(new RoutineCharacteristic.ExternalName(n))

DropRoutineStatement : @Statement.DropRoutine = "DROP"i & r: SpecificRoutineDesignator & b: DropBehavior => @(new Statement.DropRoutine { Routines = [r], Behavior = b })

// <specific routine designator>: a routine by its specific name, or by its name and its parameters' types.
SpecificRoutineDesignator : @RoutineDesignator
	= "SPECIFIC"i & t: RoutineType & n: SchemaQualifiedName => @(new RoutineDesignator(t.Kind, n, null, null, true, t.Modifier))
	| t: RoutineType & n: SchemaQualifiedName & ('(' & (first: DataType & (',' & rest: DataType)*)? & p: ')')? & ("FOR"i & f: SchemaQualifiedName)?
	  => @(new RoutineDesignator(t.Kind, n, p is null ? null : Nodes.ListOrEmpty(first, rest), f, false, t.Modifier))

RoutineType : @Nodes.RoutineTypeOf = "ROUTINE"i => @(new Nodes.RoutineTypeOf(RoutineKind.Routine, null))
                                   | "FUNCTION"i => @(new Nodes.RoutineTypeOf(RoutineKind.Function, null))
                                   | "PROCEDURE"i => @(new Nodes.RoutineTypeOf(RoutineKind.Procedure, null))
                                   | m: ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i => @(Nodes.Method(m))

// ── §11 User-defined types ──────────────────────────────────────────────────

// <user-defined type definition>: a type's name, its supertype, what it is represented by, its options
// in any order and number, and its methods.
UserDefinedTypeDefinition : @Statement.CreateType = "CREATE"i & "TYPE"i & n: SchemaQualifiedName & ("UNDER"i & u: PathResolvedUserDefinedTypeName)? & ("AS"i & r: Representation)?
	  & { (trivia & options: UserDefinedTypeOption)* } & m: MethodSpecificationList?
	  => @(new Statement.CreateType { Definition = new UserDefinedTypeDefinition(n, u, r, options ?? System.Array.Empty<UserTypeOption>(), m ?? System.Array.Empty<MethodSpecification>()) })

// <representation>: a predefined type, a collection — of any type, `ARRAY` or `MULTISET` after it —
// or attributes. A type of no other kind is refused: `AS ROW (a INT)` and `AS u`.
Representation : @TypeRepresentation
	= a: MemberList => @(new TypeRepresentation.Members(a))
	| p: PredefinedType & (trivia & s: CollectionTypeSuffix)* => @(new TypeRepresentation.Type(Nodes.Collected(p, s)))
	| o: RepresentedElementType & (trivia & more: CollectionTypeSuffix)+ => @(new TypeRepresentation.Type(Nodes.Collected(o, more)))

// A row, a reference or a user-defined type, which a representation holds only as a collection's element.
RepresentedElementType : @DataType = r: RowType => @(r)
                                   | f: ReferenceType => @(f)
                                   | n: PathResolvedUserDefinedTypeName => @(new DataType.UserDefined(n))

MemberList          : @IReadOnlyList<AttributeDefinition> = '(' & { first: AttributeDefinition & (',' & rest: AttributeDefinition)* } & ')' => @(Nodes.List(first, rest))
AttributeDefinition : @AttributeDefinition = n: Identifier & t: DataType & d: DefaultClause? & c: CollateClause? => @(new AttributeDefinition(n, t, d, c))

UserDefinedTypeOption : @UserTypeOption
	= n: "NOT"i? & "INSTANTIABLE"i => @(new UserTypeOption.Instantiable(n is null))
	| n: "NOT"i? & "FINAL"i => @(new UserTypeOption.Final(n is null))
	| "REF"i & "USING"i & t: PredefinedType => @(new UserTypeOption.Reference(new UserTypeReference.Using(t)))
	| "REF"i & "FROM"i & '(' & first: Identifier & (',' & rest: Identifier)* & ')' => @(new UserTypeOption.Reference(new UserTypeReference.FromAttributes(Nodes.List(first, rest))))
	| "REF"i & "IS"i & "SYSTEM"i & "GENERATED"i => @(new UserTypeOption.Reference(new UserTypeReference.SystemGenerated()))
	| "CAST"i & '(' & k: CastOptionKind & ')' & "WITH"i & f: Identifier => @(new UserTypeOption.Cast(k, f))

// A cast option's two sides: the source to a reference or a distinct type, or either back to the source.
CastOptionKind : @UserTypeCastKind = "SOURCE"i & "AS"i & "REF"i => @(UserTypeCastKind.ToRef)
                                   | "SOURCE"i & "AS"i & "DISTINCT"i => @(UserTypeCastKind.ToDistinct)
                                   | "REF"i & "AS"i & "SOURCE"i => @(UserTypeCastKind.ToType)
                                   | "DISTINCT"i & "AS"i & "SOURCE"i => @(UserTypeCastKind.ToSource)

MethodSpecificationList : @IReadOnlyList<MethodSpecification> = { first: MethodSpecification & (',' & rest: MethodSpecification)* } => @(Nodes.List(first, rest))

// <method specification>: an overriding method says no characteristics.
MethodSpecification : @MethodSpecification
	= "OVERRIDING"i & p: PartialMethodSpecification => @(p with { Overriding = true })
	| o: OriginalMethodSpecification => @(o)

OriginalMethodSpecification : @MethodSpecification = p: PartialMethodSpecification & r: ("SELF"i & "AS"i & "RESULT"i)? & l: ("SELF"i & "AS"i & "LOCATOR"i)? & { (trivia & characteristics: MethodCharacteristic)* }
	  => @(p with { SelfAsResult = r is not null, SelfAsLocator = l is not null, Characteristics = characteristics ?? System.Array.Empty<RoutineCharacteristic>() })
PartialMethodSpecification  : @MethodSpecification = m: ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i & n: MethodName & p: SQLParameterDeclarationList & r: ReturnsClause & ("SPECIFIC"i & s: SchemaQualifiedName)?
	  => @(new MethodSpecification(Nodes.Method(m).Modifier, n, p, r, s, false, false, System.Array.Empty<RoutineCharacteristic>()))

MethodCharacteristic : @RoutineCharacteristic
	= l: LanguageClause => @(l)
	| s: ParameterStyleClause => @(new RoutineCharacteristic.ParameterStyle(s))
	| d: "NOT"i? & "DETERMINISTIC"i => @(new RoutineCharacteristic.Deterministic(d is null))
	| a: SQLDataAccessIndication => @(new RoutineCharacteristic.DataAccess(a))
	| c: NullCallClause => @(new RoutineCharacteristic.NullCall(c))

// <alter type statement>: an attribute or a method added or dropped.
AlterTypeStatement : @Statement.AlterType = "ALTER"i & "TYPE"i & n: SchemaQualifiedName & a: AlterTypeAction => @(new Statement.AlterType { Name = n, Action = a })

AlterTypeAction : @AlterTypeAction
	= "ADD"i & "ATTRIBUTE"i & d: AttributeDefinition => @(new AlterTypeAction.AddAttribute(d))
	| "ADD"i & m: MethodSpecification => @(new AlterTypeAction.AddMethod(m, m.Overriding))
	| "DROP"i & "ATTRIBUTE"i & i: Identifier & "RESTRICT"i => @(new AlterTypeAction.DropAttribute(i))
	| "DROP"i & s: SpecificMethodSpecificationDesignator & "RESTRICT"i => @(new AlterTypeAction.DropMethod(s))

SpecificMethodSpecificationDesignator : @MethodDesignator = m: ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i & n: MethodName & '(' & (first: DataType & (',' & rest: DataType)*)? & ')'
	  => @(new MethodDesignator(Nodes.Method(m).Modifier, n, Nodes.ListOrEmpty(first, rest)))

DropDataTypeStatement : @Statement.DropType = "DROP"i & "TYPE"i & n: SchemaQualifiedName & b: DropBehavior => @(new Statement.DropType { Names = [n], Behavior = b })

// ── §11 User-defined casts, orderings and transforms ────────────────────────

UserDefinedCastDefinition    : @Statement.CreateCast = "CREATE"i & "CAST"i & '(' & s: DataType & "AS"i & t: DataType & ')' & "WITH"i & f: SpecificRoutineDesignator & a: ("AS"i & "ASSIGNMENT"i)?
	  => @(new Statement.CreateCast { SourceType = s, TargetType = t, Function = f, AsAssignment = a is not null })
DropUserDefinedCastStatement : @Statement.DropCast = "DROP"i & "CAST"i & '(' & s: DataType & "AS"i & t: DataType & ')' & b: DropBehavior => @(new Statement.DropCast { SourceType = s, TargetType = t, Behavior = b })

UserDefinedOrderingDefinition    : @Statement.CreateOrdering = "CREATE"i & "ORDERING"i & "FOR"i & n: SchemaQualifiedName & f: OrderingForm & "BY"i & c: OrderingCategory
	  => @(new Statement.CreateOrdering { TypeName = n, Ordering = new OrderingDefinition(f, c) })
DropUserDefinedOrderingStatement : @Statement.DropOrdering = "DROP"i & "ORDERING"i & "FOR"i & n: SchemaQualifiedName & b: DropBehavior => @(new Statement.DropOrdering { TypeName = n, Behavior = b })

// <ordering form>: `EQUALS ONLY` or `ORDER FULL`.
OrderingForm : @OrderingForm = "EQUALS"i & "ONLY"i => @(OrderingForm.EqualsOnly)
                             | "ORDER"i & "FULL"i => @(OrderingForm.Full)

OrderingCategory : @OrderingCategory
	= "RELATIVE"i & "WITH"i & r: SpecificRoutineDesignator => @(new OrderingCategory.Relative(r))
	| "MAP"i & "WITH"i & m: SpecificRoutineDesignator => @(new OrderingCategory.Map(m))
	| "STATE"i & n: SchemaQualifiedName? => @(new OrderingCategory.State(n))

// <transform definition>: groups, one at least, of a transform to SQL and one from it, or either.
TransformDefinition  : @Statement.CreateTransform = "CREATE"i & k: TransformKeyword & "FOR"i & n: SchemaQualifiedName & { (trivia & groups: TransformGroup)+ }
	  => @(new Statement.CreateTransform { PluralKeyword = Nodes.IsPlural(k), TypeName = n, Groups = groups })
TransformKeyword     = "TRANSFORMS"i | "TRANSFORM"i
TransformGroup       : @TransformGroup = n: Identifier & '(' & e: TransformElementList & ')' => @(new TransformGroup(n, e))
TransformElementList : @IReadOnlyList<TransformElement> = first: TransformElement & (',' & second: TransformElement)? => @(Nodes.List(first, second is null ? null : new[] { second }))
TransformElement     : @TransformElement = k: TransformKind & "WITH"i & f: SpecificRoutineDesignator => @(new TransformElement(k, f))
TransformKind        : @TransformDirection = "TO"i & "SQL"i => @(TransformDirection.ToSql)
                                           | "FROM"i & "SQL"i => @(TransformDirection.FromSql)

AlterTransformStatement : @Statement.AlterTransform = "ALTER"i & k: TransformKeyword & "FOR"i & n: SchemaQualifiedName & { (trivia & groups: AlterGroup)+ }
	  => @(new Statement.AlterTransform { PluralKeyword = Nodes.IsPlural(k), TypeName = n, Groups = groups })
AlterGroup              : @TransformAlterGroup = n: Identifier & '(' & { first: AlterTransformAction & (',' & rest: AlterTransformAction)* } & ')' => @(new TransformAlterGroup(n, Nodes.List(first, rest)))

AlterTransformAction : @TransformAlterAction
	= "ADD"i & '(' & e: TransformElementList & ')' => @(new TransformAlterAction(true, e, System.Array.Empty<TransformDirection>(), null))
	| "DROP"i & '(' & first: TransformKind & (',' & second: TransformKind)? & b: DropBehavior & ')' => @(new TransformAlterAction(false, System.Array.Empty<TransformElement>(), Nodes.Directions(first, second), b))

DropTransformStatement : @Statement.DropTransform = "DROP"i & k: TransformKeyword & t: TransformDropTarget & "FOR"i & n: SchemaQualifiedName & b: DropBehavior
	  => @(new Statement.DropTransform { PluralKeyword = Nodes.IsPlural(k), Target = t, TypeName = n, Behavior = b })

// Not a production: `ALL`, or a group's name.
TransformDropTarget : @TransformDropTarget = "ALL"i => @(new TransformDropTarget.All())
                                           | g: Identifier => @(new TransformDropTarget.Group(g))

// ── §11 Character sets, collations and transliterations ─────────────────────

CharacterSetDefinition    : @Statement.CreateCharacterSet = "CREATE"i & "CHARACTER"i & "SET"i & n: CharacterSetSpecification & a: "AS"i? & "GET"i & s: CharacterSetSpecification & c: CollateClause? => @(new Statement.CreateCharacterSet { Name = n, AsKeyword = a is not null, Source = s, Collation = c })
DropCharacterSetStatement : @Statement.DropCharacterSet = "DROP"i & "CHARACTER"i & "SET"i & n: CharacterSetSpecification => @(new Statement.DropCharacterSet { Name = n })

CollationDefinition    : @Statement.CreateCollation = "CREATE"i & "COLLATION"i & n: SchemaQualifiedName & "FOR"i & c: CharacterSetSpecification & "FROM"i & s: SchemaQualifiedName & p: ("NO"i & "PAD"i | "PAD"i & "SPACE"i)?
	  => @(new Statement.CreateCollation { Name = new CollationName(n), CharacterSet = c, Source = new CollationName(s), Padding = Nodes.PaddingOf(p) })
DropCollationStatement : @Statement.DropCollation = "DROP"i & "COLLATION"i & n: SchemaQualifiedName & b: DropBehavior => @(new Statement.DropCollation { Name = new CollationName(n), Behavior = b })

// <transliteration definition>: from a routine, asked first since `ROUTINE` is not reserved, or from an
// existing transliteration.
TransliterationDefinition    : @Statement.CreateTranslation = "CREATE"i & "TRANSLATION"i & n: SchemaQualifiedName & "FOR"i & s: CharacterSetSpecification & "TO"i & t: CharacterSetSpecification
	  & "FROM"i & f: TransliterationSource => @(new Statement.CreateTranslation { Name = n, SourceCharacterSet = s, TargetCharacterSet = t, Source = f })
DropTransliterationStatement : @Statement.DropTranslation = "DROP"i & "TRANSLATION"i & n: SchemaQualifiedName => @(new Statement.DropTranslation { Name = n })

// Not a production: what a transliteration is made from.
TransliterationSource : @TranslationSource = r: SpecificRoutineDesignator => @(new TranslationSource(null, r))
                                           | n: SchemaQualifiedName => @(new TranslationSource(n, null))

// ── §11.74 Sequence generator definition, §11.75–11.76 Alter and drop ───────

SequenceGeneratorDefinition : @Statement.CreateSequence = "CREATE"i & "SEQUENCE"i & n: SchemaQualifiedName & (trivia & options: SequenceGeneratorOption)* => @(new Statement.CreateSequence { Name = n, Options = options ?? System.Array.Empty<SequenceOption>() })

// Not a production: an option of a sequence generator's definition, its type among them.
SequenceGeneratorOption : @SequenceOption = "AS"i & t: DataType => @(new SequenceOption.DataTypeOption(t))
                                          | o: CommonSequenceGeneratorOption => @(o)

CommonSequenceGeneratorOptions : @IReadOnlyList<SequenceOption> = first: CommonSequenceGeneratorOption & (trivia & rest: CommonSequenceGeneratorOption)* => @(Nodes.List(first, rest))
CommonSequenceGeneratorOption  : @SequenceOption = "START"i & "WITH"i & v: SignedNumericLiteral => @(new SequenceOption.Start(new Expression.Literal(v)))
                                                 | o: BasicSequenceGeneratorOption => @(o)

BasicSequenceGeneratorOption : @SequenceOption
	= "INCREMENT"i & "BY"i & v: SignedNumericLiteral => @(new SequenceOption.Increment(new Expression.Literal(v)))
	| "MAXVALUE"i & v: SignedNumericLiteral => @(new SequenceOption.Max(new Expression.Literal(v)))
	| "MINVALUE"i & v: SignedNumericLiteral => @(new SequenceOption.Min(new Expression.Literal(v)))
	| "NO"i & "MAXVALUE"i => @(new SequenceOption.Max(null, true))
	| "NO"i & "MINVALUE"i => @(new SequenceOption.Min(null, true))
	| "NO"i & "CYCLE"i => @(new SequenceOption.Cycle(false))
	| "CYCLE"i => @(new SequenceOption.Cycle(true))

// <alter sequence generator statement>: a restart or a basic option, at least one; a start is not
// altered.
AlterSequenceGeneratorStatement : @Statement.AlterSequence = "ALTER"i & "SEQUENCE"i & n: SchemaQualifiedName & first: AlterSequenceGeneratorOption & (trivia & rest: AlterSequenceGeneratorOption)* => @(new Statement.AlterSequence { Name = n, Options = Nodes.List(first, rest) })
AlterSequenceGeneratorOption    : @SequenceOption = "RESTART"i & ("WITH"i & v: SignedNumericLiteral)? => @(new SequenceOption.Restart(Nodes.LiteralOrNull(v)))
                                                  | o: BasicSequenceGeneratorOption => @(o)

DropSequenceGeneratorStatement : @Statement.DropSequence = "DROP"i & "SEQUENCE"i & n: SchemaQualifiedName & b: DropBehavior => @(new Statement.DropSequence { Names = [n], Behavior = b })

// ── §12 Access control: roles and privileges ────────────────────────────────

RoleDefinition    : @Statement.CreateRole = "CREATE"i & "ROLE"i & n: Identifier & ("WITH"i & "ADMIN"i & g: Grantor)? => @(new Statement.CreateRole { Name = n, Admin = g })
DropRoleStatement : @Statement.DropRole = "DROP"i & "ROLE"i & n: Identifier & b: DropBehavior => @(new Statement.DropRole { Names = [n], Behavior = b })

// <grant statement>: privileges, asked first since they begin with key words, or roles, whose names
// are identifiers — `USAGE` among them, which is not reserved.
GrantStatement : @Statement.Grant
	= "GRANT"i & p: Privileges & "TO"i & to: Grantees & h: ("WITH"i & "HIERARCHY"i & "OPTION"i)? & o: ("WITH"i & "GRANT"i & "OPTION"i)? & granted: GrantedBy?
	  => @(new Statement.Grant { Body = new GrantBody.Privileges(p.Items, p.Object, to, h is not null, o is not null, granted) })
	| "GRANT"i & first: Identifier & (',' & rest: Identifier)* & "TO"i & to: Grantees & a: ("WITH"i & "ADMIN"i & "OPTION"i)? & granted: GrantedBy?
	  => @(new Statement.Grant { Body = new GrantBody.Roles(Nodes.List(first, rest), to, a is not null, granted) })

RevokeStatement : @Statement.Revoke
	= "REVOKE"i & (w: ("GRANT"i | "HIERARCHY"i) & "OPTION"i & "FOR"i)? & p: Privileges & "FROM"i & revoked: Grantees & granted: GrantedBy? & b: DropBehavior
	  => @(new Statement.Revoke { Body = new RevokeBody.Privileges(Nodes.RevokeOptionOf(w), p.Items, p.Object, revoked, granted, b) })
	| "REVOKE"i & a: ("ADMIN"i & "OPTION"i & "FOR"i)? & first: Identifier & (',' & rest: Identifier)* & "FROM"i & revoked: Grantees & granted: GrantedBy? & b: DropBehavior
	  => @(new Statement.Revoke { Body = new RevokeBody.Roles(a is not null, Nodes.List(first, rest), revoked, granted, b) })

Privileges : @Nodes.PrivilegesOn = i: PrivilegeActions & "ON"i & o: ObjectName => @(new Nodes.PrivilegesOn(i, o))

// Not a production: `ALL PRIVILEGES`, or the actions listed.
PrivilegeActions : @IReadOnlyList<Privilege> = "ALL"i & "PRIVILEGES"i => @(new[] { new Privilege(PrivilegeKind.AllPrivileges, System.Array.Empty<Identifier>(), System.Array.Empty<RoutineDesignator>()) })
                                             | first: PrivilegeAction & (',' & rest: PrivilegeAction)* => @(Nodes.List(first, rest))

// <action>. A selection names columns or methods; a column's name could be a routine type's word,
// `ROUTINE`, which is not reserved.
PrivilegeAction : @Privilege
	= "SELECT"i & '(' & columns: ColumnNameList & ')' => @(new Privilege(PrivilegeKind.Select, columns, System.Array.Empty<RoutineDesignator>()))
	| "SELECT"i & '(' & first: SpecificRoutineDesignator & (',' & rest: SpecificRoutineDesignator)* & ')' => @(new Privilege(PrivilegeKind.Select, System.Array.Empty<Identifier>(), Nodes.List(first, rest)))
	| "SELECT"i => @(new Privilege(PrivilegeKind.Select, System.Array.Empty<Identifier>(), System.Array.Empty<RoutineDesignator>()))
	| w: ("INSERT"i | "UPDATE"i | "REFERENCES"i) & ('(' & listed: ColumnNameList & ')')? => @(new Privilege(Nodes.PrivilegeKindOf(w), listed ?? System.Array.Empty<Identifier>(), System.Array.Empty<RoutineDesignator>()))
	| w: ("DELETE"i | "USAGE"i | "TRIGGER"i | "UNDER"i | "EXECUTE"i) => @(new Privilege(Nodes.PrivilegeKindOf(w), System.Array.Empty<Identifier>(), System.Array.Empty<RoutineDesignator>()))

// <object name>. A kind of object is named before a table's name, which could be the kind's word:
// `TYPE`, `SEQUENCE` and `ROUTINE` are not reserved.
ObjectName : @PrivilegeObject
	= "DOMAIN"i & n: SchemaQualifiedName => @(new PrivilegeObject(PrivilegeObjectKind.Domain, n))
	| "COLLATION"i & n: SchemaQualifiedName => @(new PrivilegeObject(PrivilegeObjectKind.Collation, n))
	| "CHARACTER"i & "SET"i & c: CharacterSetSpecification => @(new PrivilegeObject(PrivilegeObjectKind.CharacterSet, c.Name))
	| "TRANSLATION"i & n: SchemaQualifiedName => @(new PrivilegeObject(PrivilegeObjectKind.Translation, n))
	| "TYPE"i & n: SchemaQualifiedName => @(new PrivilegeObject(PrivilegeObjectKind.Type, n))
	| "SEQUENCE"i & n: SchemaQualifiedName => @(new PrivilegeObject(PrivilegeObjectKind.Sequence, n))
	| r: SpecificRoutineDesignator => @(new PrivilegeObject(PrivilegeObjectKind.Routine, r.Name, r))
	| k: "TABLE"i? & n: TableName => @(new PrivilegeObject(PrivilegeObjectKind.Table, n, null, k is not null))

Grantees  : @IReadOnlyList<Grantee> = first: GranteeItem & (',' & rest: GranteeItem)* => @(Nodes.List(first, rest))
Grantor   : @Grantor = "CURRENT_USER"i => @(Grantor.CurrentUser)
                     | "CURRENT_ROLE"i => @(Grantor.CurrentRole)
GrantedBy : @Grantor = "GRANTED"i & "BY"i & g: Grantor => @(g)

// Not a production: `PUBLIC`, or an authorization identifier.
GranteeItem : @Grantee = "PUBLIC"i => @(new Grantee.Public())
                       | n: Identifier => @(new Grantee.Identifier(new AuthorizationIdentifier(n)))

// ── §22 Direct invocation of SQL, and the statements it invokes ─────────────
//
// <direct SQL statement>: a statement and its semicolon. What an implementation defines for itself is
// none of the standard's, and not read.
DirectSQLStatement : @Statement = s: DirectlyExecutableStatement & ';' => @(s)

DirectlyExecutableStatement : @Statement
	= d: DirectSQLDataStatement => @(d)
	| s: SQLSchemaStatement => @(s)
	| t: SQLTransactionStatement => @(t)
	| c: SQLConnectionStatement => @(c)
	| n: SQLSessionStatement => @(n)

// <direct SQL data statement>. A multiple row select statement is a cursor specification; a searched
// statement is asked before a query only by its key word.
DirectSQLDataStatement : @Statement
	= d: DeleteStatementSearched => @(d)
	| i: InsertStatement => @(i)
	| u: UpdateStatementSearched => @(u)
	| t: TruncateTableStatement => @(t)
	| m: MergeStatement => @(m)
	| l: TemporaryTableDeclaration => @(l)
	| c: CursorSpecification => @(c)

// <cursor specification>: a query, and whether it is updated through.
CursorSpecification : @Statement.Select = q: QueryExpression & u: UpdatabilityClause? => @(u is null ? q : q with { Updatability = u })

UpdatabilityClause : @UpdatabilityClause = "FOR"i & "READ"i & "ONLY"i => @(new UpdatabilityClause(true, System.Array.Empty<Identifier>()))
                                         | "FOR"i & "UPDATE"i & ("OF"i & columns: ColumnNameList)? => @(new UpdatabilityClause(false, columns ?? System.Array.Empty<Identifier>()))

TemporaryTableDeclaration : @Statement.DeclareLocalTemporaryTable = "DECLARE"i & "LOCAL"i & "TEMPORARY"i & "TABLE"i & n: TableName & e: TableElementList & ("ON"i & "COMMIT"i & o: ("PRESERVE"i | "DELETE"i) & "ROWS"i)?
	  => @(new Statement.DeclareLocalTemporaryTable { Name = n, Elements = e, OnCommit = Nodes.CommitOf(o) })

// ── §14.7 Select statement: single row, §14 cursors and locators ────────────

// <SQL data statement>, in a routine's body.
SQLDataStatement : @Statement
	= o: OpenStatement => @(o)
	| f: FetchStatement => @(f)
	| c: CloseStatement => @(c)
	| s: SelectStatementSingleRow => @(s)
	| fl: FreeLocatorStatement => @(fl)
	| hl: HoldLocatorStatement => @(hl)
	| dp: DeleteStatementPositioned => @(dp)
	| ds: DeleteStatementSearched => @(ds)
	| i: InsertStatement => @(i)
	| up: UpdateStatementPositioned => @(up)
	| us: UpdateStatementSearched => @(us)
	| t: TruncateTableStatement => @(t)
	| m: MergeStatement => @(m)

OpenStatement  : @Statement.OpenCursor = "OPEN"i & n: CursorName => @(new Statement.OpenCursor { Cursor = new CursorReference(n) })
CloseStatement : @Statement.CloseCursor = "CLOSE"i & n: CursorName => @(new Statement.CloseCursor { Cursor = new CursorReference(n) })
FetchStatement : @Statement.FetchCursor = "FETCH"i & (o: FetchOrientation? & f: "FROM"i)? & n: CursorName & "INTO"i & { first: TargetSpecification & (',' & rest: TargetSpecification)* }
	  => @(new Statement.FetchCursor { Orientation = o, FromKeyword = f is not null, Cursor = new CursorReference(n), Into = new DynamicArguments.Values(Nodes.List(first, rest)) })

FetchOrientation : @FetchOrientation
	= w: ("NEXT"i | "PRIOR"i | "FIRST"i | "LAST"i) => @(new FetchOrientation(Nodes.EnumOf<FetchOrientationKind>(w)))
	| w: ("ABSOLUTE"i | "RELATIVE"i) & v: SimpleValueSpecification => @(new FetchOrientation(Nodes.EnumOf<FetchOrientationKind>(w), v))

// <select statement: single row>: a query specification whose select list is followed by `INTO`.
SelectStatementSingleRow : @Statement.Select = "SELECT"i & q: SetQuantifier? & l: SelectList & "INTO"i & { first: TargetSpecification & (',' & rest: TargetSpecification)* } & t: TableExpression
	  => @(Nodes.Specified(q, l, t) with { Into = new IntoClause(Nodes.List(first, rest)) })

// <target specification>: a host parameter with its indicator, an SQL parameter or a column — an
// identifier chain either — an element of an array, or a dynamic parameter. An embedded variable is
// written as a host parameter is.
TargetSpecification : @Expression
	= ':' & n: Identifier & (k: "INDICATOR"i? & ':' & i: Identifier)? => @(Nodes.HostParameter(n, i, k is not null))
	| c: IdentifierChain & (l: LeftBracketOrTrigraph & x: SimpleValueSpecification & RightBracketOrTrigraph)? => @(Nodes.Target(c, l, x))
	| m: "MODULE"i & '.' & a: Identifier & '.' & b: Identifier => @(new Expression.Reference(Nodes.Named(m, a, b)))
	| '?' => @(new Expression.Parameter(ParameterKind.Dynamic))

FreeLocatorStatement : @Statement.FreeLocator = "FREE"i & "LOCATOR"i & first: LocatorReference & (',' & rest: LocatorReference)* => @(new Statement.FreeLocator { Locators = Nodes.List(first, rest) })
HoldLocatorStatement : @Statement.HoldLocator = "HOLD"i & "LOCATOR"i & first: LocatorReference & (',' & rest: LocatorReference)* => @(new Statement.HoldLocator { Locators = Nodes.List(first, rest) })
LocatorReference     : @Expression = ':' & n: Identifier => @(new Expression.Parameter(ParameterKind.Host, n))
                                   | '?' => @(new Expression.Parameter(ParameterKind.Dynamic))

// ── §16 Control statements ──────────────────────────────────────────────────

SQLControlStatement : @Statement = c: CallStatement => @(c)
                                 | r: ReturnStatement => @(r)
CallStatement       : @Statement.Call = "CALL"i & i: RoutineInvocation => @(new Statement.Call { Invocation = (Expression.Invocation)i })
ReturnStatement     : @Statement.Return = "RETURN"i & v: ValueExpression => @(new Statement.Return { Value = v.Node })
                                        | "RETURN"i & "NULL"i => @(new Statement.Return { NullKeyword = true })

// ── §17 Transaction management ──────────────────────────────────────────────

SQLTransactionStatement : @Statement
	= s: StartTransactionStatement => @(s)
	| t: SetTransactionStatement => @(t)
	| c: SetConstraintsModeStatement => @(c)
	| p: SavepointStatement => @(p)
	| r: ReleaseSavepointStatement => @(r)
	| m: CommitStatement => @(m)
	| b: RollbackStatement => @(b)

StartTransactionStatement   : @Statement.StartTransaction = "START"i & "TRANSACTION"i & (first: TransactionMode & (',' & rest: TransactionMode)*)? => @(new Statement.StartTransaction { Modes = Nodes.ListOrEmpty(first, rest) })
SetTransactionStatement     : @Statement.SetTransaction = "SET"i & l: "LOCAL"i? & "TRANSACTION"i & (first: TransactionMode & (',' & rest: TransactionMode)*)? => @(new Statement.SetTransaction { Local = l is not null, Modes = Nodes.ListOrEmpty(first, rest) })
SetConstraintsModeStatement : @Statement.SetConstraints = "SET"i & "CONSTRAINTS"i & c: ConstraintNameList & w: ("DEFERRED"i | "IMMEDIATE"i) => @(new Statement.SetConstraints { Target = c, Timing = (w[0] | 0x20) == 'd' ? ConstraintTiming.Deferred : ConstraintTiming.Immediate })
SavepointStatement          : @Statement.Savepoint = "SAVEPOINT"i & n: Identifier => @(new Statement.Savepoint { Name = n })
ReleaseSavepointStatement   : @Statement.ReleaseSavepoint = "RELEASE"i & "SAVEPOINT"i & n: Identifier => @(new Statement.ReleaseSavepoint { Name = n })
CommitStatement             : @Statement.Commit = "COMMIT"i & w: "WORK"i? & c: ChainClause? => @(new Statement.Commit { Work = w is not null, Chain = c })
RollbackStatement           : @Statement.Rollback = "ROLLBACK"i & w: "WORK"i? & c: ChainClause? & ("TO"i & "SAVEPOINT"i & s: Identifier)? => @(new Statement.Rollback { Work = w is not null, Chain = c, ToSavepoint = s })

// <constraint name list>.
ConstraintNameList : @ConstraintTarget = "ALL"i => @(new ConstraintTarget.All())
                                       | first: SchemaQualifiedName & (',' & rest: SchemaQualifiedName)* => @(new ConstraintTarget.Names(Nodes.List(first, rest)))

// Not a production: `AND CHAIN` or `AND NO CHAIN`.
ChainClause : @ChainMode = "AND"i & n: "NO"i? & "CHAIN"i => @(n is null ? ChainMode.Chain : ChainMode.NoChain)

// <transaction mode>.
TransactionMode : @TransactionMode
	= "ISOLATION"i & "LEVEL"i & "READ"i & "UNCOMMITTED"i => @(new TransactionMode.Isolation(IsolationLevel.ReadUncommitted))
	| "ISOLATION"i & "LEVEL"i & "READ"i & "COMMITTED"i => @(new TransactionMode.Isolation(IsolationLevel.ReadCommitted))
	| "ISOLATION"i & "LEVEL"i & "REPEATABLE"i & "READ"i => @(new TransactionMode.Isolation(IsolationLevel.RepeatableRead))
	| "ISOLATION"i & "LEVEL"i & "SERIALIZABLE"i => @(new TransactionMode.Isolation(IsolationLevel.Serializable))
	| "READ"i & "ONLY"i => @(new TransactionMode.Access(TransactionAccess.ReadOnly))
	| "READ"i & "WRITE"i => @(new TransactionMode.Access(TransactionAccess.ReadWrite))
	| "DIAGNOSTICS"i & "SIZE"i & v: SimpleValueSpecification => @(new TransactionMode.DiagnosticsSize(v))

// ── §18 Connection management ───────────────────────────────────────────────

SQLConnectionStatement : @Statement = c: ConnectStatement => @(c)
                                    | s: SetConnectionStatement => @(s)
                                    | d: DisconnectStatement => @(d)

ConnectStatement       : @Statement.Connect = "CONNECT"i & "TO"i & "DEFAULT"i => @(new Statement.Connect { Target = new ConnectionTarget(null, null, null, true) })
                                            | "CONNECT"i & "TO"i & s: SimpleValueSpecification & ("AS"i & n: SimpleValueSpecification)? & ("USER"i & u: SimpleValueSpecification)? => @(new Statement.Connect { Target = new ConnectionTarget(s, n, u, false) })
SetConnectionStatement : @Statement.SetConnection = "SET"i & "CONNECTION"i & c: ConnectionObject => @(new Statement.SetConnection { Connection = c })
DisconnectStatement    : @Statement.Disconnect = "DISCONNECT"i & d: DisconnectObject => @(new Statement.Disconnect { Object = d })

ConnectionObject : @ConnectionObject = "DEFAULT"i => @(new ConnectionObject.Default())
                                     | v: SimpleValueSpecification => @(new ConnectionObject.Named(v))
DisconnectObject : @DisconnectObject = "ALL"i => @(new DisconnectObject.All())
                                     | "CURRENT"i => @(new DisconnectObject.Current())
                                     | c: ConnectionObject => @(new DisconnectObject.Connection(c))

// ── §19 Session management ──────────────────────────────────────────────────

// <SQL session statement>. A value specification is a literal or a general value specification; a
// catalog's, schema's, path's and names' are all given as a value, not written as a name.
SQLSessionStatement : @Statement
	= "SET"i & "SESSION"i & "AUTHORIZATION"i & v: ValueSpecification => @(new Statement.SetSessionAuthorization { Value = v })
	| "SET"i & "ROLE"i & "NONE"i => @(new Statement.SetRole { None = true })
	| "SET"i & "ROLE"i & v: ValueSpecification => @(new Statement.SetRole { Value = v })
	| "SET"i & "TIME"i & "ZONE"i & "LOCAL"i => @(new Statement.SetTimeZone { Local = true })
	| "SET"i & "TIME"i & "ZONE"i & z: IntervalValueExpression => @(new Statement.SetTimeZone { Value = z.Node })
	| "SET"i & "SESSION"i & "CHARACTERISTICS"i & "AS"i & first: SessionTransactionCharacteristics & (',' & rest: SessionTransactionCharacteristics)* => @(new Statement.SetSessionCharacteristics { Characteristics = Nodes.List(first, rest) })
	| "SET"i & w: ("CATALOG"i | "SCHEMA"i | "NAMES"i | "PATH"i) & v: ValueSpecification => @(Nodes.SetValue(w, v))
	| "SET"i & "DEFAULT"i & "TRANSFORM"i & "GROUP"i & v: ValueSpecification => @(new Statement.SetTransformGroup { Value = new TransformGroupCharacteristic(true, null, v) })
	| "SET"i & "TRANSFORM"i & "GROUP"i & "FOR"i & "TYPE"i & t: PathResolvedUserDefinedTypeName & v: ValueSpecification => @(new Statement.SetTransformGroup { Value = new TransformGroupCharacteristic(false, t, v) })
	| "SET"i & "COLLATION"i & v: ValueSpecification & ("FOR"i & { cs: CharacterSetSpecification & (',' & more: CharacterSetSpecification)* })? => @(new Statement.SetCollation { Value = v, ForCharacterSets = Nodes.ListOrEmpty(cs, more) })
	| "SET"i & "NO"i & "COLLATION"i & ("FOR"i & { cs: CharacterSetSpecification & (',' & more: CharacterSetSpecification)* })? => @(new Statement.SetCollation { NoCollation = true, ForCharacterSets = Nodes.ListOrEmpty(cs, more) })

SessionTransactionCharacteristics : @IReadOnlyList<TransactionMode> = "TRANSACTION"i & first: TransactionMode & (',' & rest: TransactionMode)* => @(Nodes.List(first, rest))

// <value specification>.
ValueSpecification : @Expression = l: Literal => @(new Expression.Literal(l))
                                 | g: GeneralValueSpecification => @(g)
                                 | n: IdentifierChain => @(new Expression.Reference(n))

// ── §23 Diagnostics management ──────────────────────────────────────────────

SQLDiagnosticsStatement : @Statement.GetDiagnostics = "GET"i & "DIAGNOSTICS"i & i: SQLDiagnosticsInformation => @(new Statement.GetDiagnostics { Information = i })

// <SQL diagnostics information>: statement information, a condition's, or all of it.
SQLDiagnosticsInformation : @DiagnosticsInformation
	= t: SimpleTargetSpecification & '=' & "ALL"i & a: AllInformationQualifier? => @(new DiagnosticsInformation.All(t, a?.Qualifier, a?.Number))
	| "CONDITION"i & c: SimpleValueSpecification & { first: ConditionInformationItem & (',' & rest: ConditionInformationItem)* } => @(new DiagnosticsInformation.Condition(c, Nodes.List(first, rest)))
	| { head: StatementInformationItem & (',' & tail: StatementInformationItem)* } => @(new DiagnosticsInformation.Statement(Nodes.List(head, tail)))

// Not a production: `STATEMENT`, or `CONDITION` and the condition's number, after `ALL`.
AllInformationQualifier : @Nodes.AllOf = "STATEMENT"i => @(new Nodes.AllOf(AllInformationQualifier.Statement, null))
                                       | "CONDITION"i & n: SimpleValueSpecification? => @(new Nodes.AllOf(AllInformationQualifier.Condition, n))

StatementInformationItem : @StatementInformationItem = t: SimpleTargetSpecification & '=' & n: StatementInformationItemName => @(new StatementInformationItem(t, Nodes.EnumOf<StatementInformationItemName>(n)))
ConditionInformationItem : @ConditionInformationItem = t: SimpleTargetSpecification & '=' & n: ConditionInformationItemName => @(new ConditionInformationItem(t, Nodes.EnumOf<ConditionInformationItemName>(n)))

SimpleTargetSpecification : @Expression = ':' & n: Identifier => @(new Expression.Parameter(ParameterKind.Host, n))
                                        | c: IdentifierChain => @(new Expression.Reference(c))
                                        | m: "MODULE"i & '.' & a: Identifier & '.' & b: Identifier => @(new Expression.Reference(Nodes.Named(m, a, b)))

StatementInformationItemName
	= "NUMBER"i | "MORE"i | "COMMAND_FUNCTION_CODE"i | "COMMAND_FUNCTION"i | "DYNAMIC_FUNCTION_CODE"i | "DYNAMIC_FUNCTION"i
	| "ROW_COUNT"i | "TRANSACTIONS_COMMITTED"i | "TRANSACTIONS_ROLLED_BACK"i | "TRANSACTION_ACTIVE"i

ConditionInformationItemName
	= "CATALOG_NAME"i | "CLASS_ORIGIN"i | "COLUMN_NAME"i | "CONDITION_NUMBER"i | "CONNECTION_NAME"i
	| "CONSTRAINT_CATALOG"i | "CONSTRAINT_NAME"i | "CONSTRAINT_SCHEMA"i | "CURSOR_NAME"i
	| "MESSAGE_LENGTH"i | "MESSAGE_OCTET_LENGTH"i | "MESSAGE_TEXT"i | "PARAMETER_MODE"i | "PARAMETER_NAME"i
	| "PARAMETER_ORDINAL_POSITION"i | "RETURNED_SQLSTATE"i | "ROUTINE_CATALOG"i | "ROUTINE_NAME"i | "ROUTINE_SCHEMA"i
	| "SCHEMA_NAME"i | "SERVER_NAME"i | "SPECIFIC_NAME"i | "SUBCLASS_ORIGIN"i | "TABLE_NAME"i
	| "TRIGGER_CATALOG"i | "TRIGGER_NAME"i | "TRIGGER_SCHEMA"i

// ── §20 Dynamic SQL ─────────────────────────────────────────────────────────

// <SQL dynamic statement>.
SQLDynamicStatement : @Statement
	= d: SQLDescriptorStatement => @(d)
	| p: PrepareStatement => @(p)
	| a: DeallocatePreparedStatement => @(a)
	| s: DescribeStatement => @(s)
	| i: ExecuteImmediateStatement => @(i)
	| e: ExecuteStatement => @(e)
	| y: SQLDynamicDataStatement => @(y)
	| c: CopyDescriptorStatement => @(c)
	| r: PipeRowStatement => @(r)

// <scope option>.
ScopeOption = "GLOBAL"i | "LOCAL"i

// <SQL statement name>: a statement's name, an identifier, or an extended one — a scope and a simple
// value, which an identifier already is. A name alone is the name; anything else the extended name.
SQLStatementName : @StatementReference = s: ScopeOption? & v: SimpleValueSpecification => @(Nodes.StatementName(s, v))

// <descriptor name>: a conventional one — an identifier, or a scope and a simple value — or a
// polymorphic table function's.
DescriptorName             : @DescriptorReference = d: ConventionalDescriptorName => @(d)
                                                  | "PTF"i & v: SimpleValueSpecification => @(Nodes.DescriptorName(null, v, true))
ConventionalDescriptorName : @DescriptorReference = s: ScopeOption? & v: SimpleValueSpecification => @(Nodes.DescriptorName(s, v, false))

// <conventional dynamic cursor name>: a cursor's name, or an extended one.
ConventionalDynamicCursorName : @CursorReference = n: CursorName => @(new CursorReference(n))
                                                 | s: ScopeOption? & v: SimpleValueSpecification => @(Nodes.CursorName(s, v, false))
DynamicCursorName             : @CursorReference = c: ConventionalDynamicCursorName => @(c)
                                                 | "PTF"i & v: SimpleValueSpecification => @(Nodes.CursorName(null, v, true))

// ── §20.1 Descriptor statements ─────────────────────────────────────────────

SQLDescriptorStatement : @Statement
	= "ALLOCATE"i & q: "SQL"i? & "DESCRIPTOR"i & d: ConventionalDescriptorName & ("WITH"i & "MAX"i & m: SimpleValueSpecification)? => @(new Statement.AllocateDescriptor { SqlKeyword = q is not null, Descriptor = d, Max = m })
	| "DEALLOCATE"i & q: "SQL"i? & "DESCRIPTOR"i & d: ConventionalDescriptorName => @(new Statement.DeallocateDescriptor { SqlKeyword = q is not null, Descriptor = d })
	| "GET"i & q: "SQL"i? & "DESCRIPTOR"i & d: DescriptorName & g: GetDescriptorInformation => @(new Statement.GetDescriptor { SqlKeyword = q is not null, Descriptor = d, Body = g })
	| "SET"i & q: "SQL"i? & "DESCRIPTOR"i & d: DescriptorName & s: SetDescriptorInformation => @(new Statement.SetDescriptor { SqlKeyword = q is not null, Descriptor = d, Body = s })

// <get descriptor information>, <set descriptor information>: the header's items, or one item's.
GetDescriptorInformation : @DescriptorGet
	= { first: HeaderRead & (',' & rest: HeaderRead)* } => @(new DescriptorGet.Header(Nodes.List(first, rest)))
	| "VALUE"i & i: SimpleValueSpecification & { head: ItemRead & (',' & tail: ItemRead)* } => @(new DescriptorGet.Value(i, Nodes.List(head, tail)))

SetDescriptorInformation : @DescriptorSet
	= { first: HeaderWrite & (',' & rest: HeaderWrite)* } => @(new DescriptorSet.Header(Nodes.List(first, rest)))
	| "VALUE"i & i: SimpleValueSpecification & { head: ItemWrite & (',' & tail: ItemWrite)* } => @(new DescriptorSet.Value(i, Nodes.List(head, tail)))

// Not productions: an item of a descriptor's header, or of one of its items, read into a target or set
// from a value.
HeaderRead  : @DescriptorRead = t: SimpleTargetSpecification & '=' & n: HeaderItemName => @(new DescriptorRead(t, Nodes.EnumOf<DescriptorItem>(n)))
ItemRead    : @DescriptorRead = t: SimpleTargetSpecification & '=' & n: DescriptorItemName => @(new DescriptorRead(t, Nodes.EnumOf<DescriptorItem>(n)))
HeaderWrite : @DescriptorWrite = n: HeaderItemName & '=' & v: SimpleValueSpecification => @(new DescriptorWrite(Nodes.EnumOf<DescriptorItem>(n), v))
ItemWrite   : @DescriptorWrite = n: DescriptorItemName & '=' & v: SimpleValueSpecification => @(new DescriptorWrite(Nodes.EnumOf<DescriptorItem>(n), v))

HeaderItemName = "COUNT"i | "KEY_TYPE"i | "DYNAMIC_FUNCTION_CODE"i | "DYNAMIC_FUNCTION"i | "TOP_LEVEL_COUNT"i

DescriptorItemName
	= "CARDINALITY"i | "CHARACTER_SET_CATALOG"i | "CHARACTER_SET_NAME"i | "CHARACTER_SET_SCHEMA"i
	| "COLLATION_CATALOG"i | "COLLATION_NAME"i | "COLLATION_SCHEMA"i | "DATA"i | "DATETIME_INTERVAL_CODE"i
	| "DATETIME_INTERVAL_PRECISION"i | "DEGREE"i | "INDICATOR"i | "KEY_MEMBER"i | "LENGTH"i | "LEVEL"i | "NAME"i
	| "NULLABLE"i | "NULL_ORDERING"i | "OCTET_LENGTH"i | "PARAMETER_MODE"i | "PARAMETER_ORDINAL_POSITION"i
	| "PARAMETER_SPECIFIC_CATALOG"i | "PARAMETER_SPECIFIC_NAME"i | "PARAMETER_SPECIFIC_SCHEMA"i | "PRECISION"i
	| "RETURNED_CARDINALITY"i | "RETURNED_LENGTH"i | "RETURNED_OCTET_LENGTH"i | "SCALE"i | "SCOPE_CATALOG"i
	| "SCOPE_NAME"i | "SCOPE_SCHEMA"i | "SORT_DIRECTION"i | "TYPE"i | "UNNAMED"i | "USER_DEFINED_TYPE_CATALOG"i
	| "USER_DEFINED_TYPE_NAME"i | "USER_DEFINED_TYPE_SCHEMA"i | "USER_DEFINED_TYPE_CODE"i

// <copy descriptor statement>: to a polymorphic table function's descriptor, the whole or an item.
CopyDescriptorStatement : @Statement.CopyDescriptor = "COPY"i & d: DescriptorName & t: CopyDescriptorTail => @(new Statement.CopyDescriptor { Body = Nodes.Copy(d, t) })

CopyDescriptorTail : @Nodes.CopyTail
	= "TO"i & "PTF"i & p: SimpleValueSpecification => @(new Nodes.CopyTail(null, null, Nodes.DescriptorName(null, p, true), null))
	| "VALUE"i & si: SimpleValueSpecification & '(' & o: CopyOptions & ')' & "TO"i & "PTF"i & p: SimpleValueSpecification & "VALUE"i & ti: SimpleValueSpecification
	  => @(new Nodes.CopyTail(si, o, Nodes.DescriptorName(null, p, true), ti))

// Not a production: what an item's copy takes.
CopyOptions : @IReadOnlyList<DescriptorCopyOption> = "NAME"i & ',' & "TYPE"i => @(new[] { DescriptorCopyOption.Name, DescriptorCopyOption.Type })
                                                  | "NAME"i => @(new[] { DescriptorCopyOption.Name })
                                                  | "TYPE"i => @(new[] { DescriptorCopyOption.Type })
                                                  | "DATA"i => @(new[] { DescriptorCopyOption.Data })

PipeRowStatement : @Statement.PipeRow = "PIPE"i & "ROW"i & "PTF"i & v: SimpleValueSpecification => @(new Statement.PipeRow { Descriptor = Nodes.DescriptorName(null, v, true) })

// ── §20.6–20.11 Prepare, deallocate, describe, execute ──────────────────────

PrepareStatement            : @Statement.Prepare = "PREPARE"i & n: SQLStatementName & ("ATTRIBUTES"i & a: SimpleValueSpecification)? & "FROM"i & s: SimpleValueSpecification => @(new Statement.Prepare { Statement = n, Attributes = a, Sql = s })
DeallocatePreparedStatement : @Statement.DeallocatePrepare = "DEALLOCATE"i & "PREPARE"i & n: SQLStatementName => @(new Statement.DeallocatePrepare { Statement = n })

// <describe statement>. `INPUT` and `OUTPUT` are not reserved, and a statement may be named so.
DescribeStatement : @Statement.Describe
	= "DESCRIBE"i & "INPUT"i & n: SQLStatementName & u: UsingDescriptor & g: NestingOption? => @(new Statement.Describe { Body = new DescribeBody.Input(n, u.Descriptor, g, u.SqlKeyword) })
	| "DESCRIBE"i & (o: "OUTPUT"i & ?=DescribedObject)? & w: DescribedObject & u: UsingDescriptor & g: NestingOption? => @(new Statement.Describe { Body = new DescribeBody.Output(w, u.Descriptor, g, o is not null, u.SqlKeyword) })

// Not a production: a cursor's structure, or a prepared statement, described.
DescribedObject : @DescribeObject = "CURSOR"i & c: CursorName & "STRUCTURE"i => @(new DescribeObject.Cursor(new CursorReference(c)))
                                  | n: SQLStatementName => @(new DescribeObject.Statement(n))

UsingDescriptor : @Nodes.UsingDescriptor = "USING"i & q: "SQL"i? & "DESCRIPTOR"i & d: DescriptorName => @(new Nodes.UsingDescriptor(q is not null, d))
NestingOption   : @bool = "WITH"i & "NESTING"i => @(true)
                        | "WITHOUT"i & "NESTING"i => @(false)

// <execute immediate statement>, asked before <execute statement>, which names a statement `IMMEDIATE` as readily.
ExecuteImmediateStatement : @Statement.ExecuteImmediate = "EXECUTE"i & "IMMEDIATE"i & s: SimpleValueSpecification => @(new Statement.ExecuteImmediate { Sql = s })
ExecuteStatement          : @Statement.Execute = "EXECUTE"i & n: SQLStatementName & o: OutputUsingClause? & i: InputUsingClause? => @(new Statement.Execute { Statement = n, Result = o, Parameters = i })

// <input using clause>, <output using clause>: arguments, or a descriptor. A <using argument> is a
// general value specification, whose SQL parameter reference is an identifier chain.
InputUsingClause : @DynamicArguments
	= "USING"i & q: "SQL"i? & "DESCRIPTOR"i & d: DescriptorName => @(new DynamicArguments.Descriptor(d, q is not null))
	| "USING"i & { first: UsingArgument & (',' & rest: UsingArgument)* } => @(new DynamicArguments.Values(Nodes.List(first, rest)))

UsingArgument : @Expression = g: GeneralValueSpecification => @(g)
                            | n: IdentifierChain => @(new Expression.Reference(n))

OutputUsingClause : @DynamicArguments
	= "INTO"i & q: "SQL"i? & "DESCRIPTOR"i & d: DescriptorName => @(new DynamicArguments.Descriptor(d, q is not null))
	| "INTO"i & { first: TargetSpecification & (',' & rest: TargetSpecification)* } => @(new DynamicArguments.Values(Nodes.List(first, rest)))

// ── §20.12–20.23 Dynamic cursors ────────────────────────────────────────────

SQLDynamicDataStatement : @Statement
	= a: AllocateExtendedDynamicCursorStatement => @(a)
	| r: AllocateReceivedCursorStatement => @(r)
	| "OPEN"i & c: ConventionalDynamicCursorName & i: InputUsingClause? => @(new Statement.OpenCursor { Cursor = c, Using = i })
	| "FETCH"i & (o: FetchOrientation? & f: "FROM"i)? & d: DynamicCursorName & u: OutputUsingClause => @(new Statement.FetchCursor { Orientation = o, FromKeyword = f is not null, Cursor = d, Into = u })
	| "CLOSE"i & c: ConventionalDynamicCursorName => @(new Statement.CloseCursor { Cursor = c })
	| "DELETE"i & "FROM"i & t: TargetTable & "WHERE"i & "CURRENT"i & "OF"i & c: ConventionalDynamicCursorName => @(new Statement.Delete { Target = t, CurrentOf = c })
	| "UPDATE"i & t: TargetTable & "SET"i & s: SetClauseList & "WHERE"i & "CURRENT"i & "OF"i & c: ConventionalDynamicCursorName => @(new Statement.Update { Target = t, Assignments = s, CurrentOf = c })

AllocateExtendedDynamicCursorStatement : @Statement.AllocateCursor = "ALLOCATE"i & s: ScopeOption? & v: SimpleValueSpecification & p: CursorProperties & "FOR"i & t: ScopeOption? & w: SimpleValueSpecification
	  => @(new Statement.AllocateCursor { Cursor = Nodes.CursorName(s, v, false), Properties = p, SourceValue = new CursorAllocationSource.Prepared(Nodes.StatementName(t, w)) })
AllocateReceivedCursorStatement        : @Statement.AllocateCursor = "ALLOCATE"i & n: CursorName & k: "CURSOR"i? & "FOR"i & r: SpecificRoutineDesignator
	  => @(new Statement.AllocateCursor { Cursor = new CursorReference(n), CursorKeyword = k is not null, SourceValue = new CursorAllocationSource.Routine(r) })

// <cursor properties>.
CursorProperties : @CursorProperties = s: CursorSensitivity? & c: CursorScrollability? & "CURSOR"i & h: CursorHoldability? & r: CursorReturnability? => @(new CursorProperties(s, c, h, r))

CursorSensitivity   : @CursorSensitivity = "SENSITIVE"i => @(CursorSensitivity.Sensitive)
                                         | "INSENSITIVE"i => @(CursorSensitivity.Insensitive)
                                         | "ASENSITIVE"i => @(CursorSensitivity.Asensitive)
CursorScrollability : @CursorScrollability = "SCROLL"i => @(CursorScrollability.Scroll)
                                           | "NO"i & "SCROLL"i => @(CursorScrollability.NoScroll)
CursorHoldability   : @CursorHoldability = "WITH"i & "HOLD"i => @(CursorHoldability.WithHold)
                                         | "WITHOUT"i & "HOLD"i => @(CursorHoldability.WithoutHold)
CursorReturnability : @CursorReturnability = "WITH"i & "RETURN"i => @(CursorReturnability.WithReturn)
                                           | "WITHOUT"i & "RETURN"i => @(CursorReturnability.WithoutReturn)

// What a publication of a tower hands back: the node alone, since the towers are the grammar's own business.
ValueExpressionTree        : @Expression = e: ValueExpression => @(e.Node)
CommonValueExpressionTree  : @Expression = e: CommonValueExpression => @(e.Node)
NumericValueExpressionTree : @Expression = e: NumericValueExpression => @(e.Node)
StringValueExpressionTree  : @Expression = e: StringValueExpression => @(e.Node)
CharacterValueExpressionTree : @Expression = e: CharacterValueExpression => @(e.Node)
BinaryValueExpressionTree  : @Expression = e: BinaryValueExpression => @(e.Node)
DatetimeValueExpressionTree : @Expression = e: DatetimeValueExpression => @(e.Node)
IntervalValueExpressionTree : @Expression = e: IntervalValueExpression => @(e.Node)
BooleanValueExpressionTree : @Expression = e: BooleanValueExpression => @(e.Node)
SearchConditionTree        : @Expression = e: SearchCondition => @(e.Node)
PredicateTree              : @Expression = e: Predicate => @(e.Node)
RowValuePredicandTree      : @Expression = e: RowValuePredicand => @(e.Node)
ValueExpressionPrimaryTree : @Expression = e: ValueExpressionPrimary => @(e.Node)

parse Literal                  as ParseLiteral
parse UnsignedLiteral          as ParseUnsignedLiteral
parse Identifier               as ParseIdentifier
parse IdentifierChain          as ParseIdentifierChain
parse ColumnReference          as ParseColumnReference
parse TableName                as ParseTableName
parse SchemaName               as ParseSchemaName
parse DataType                 as ParseDataType
parse ValueExpressionTree as ParseValueExpression
parse CommonValueExpressionTree as ParseCommonValueExpression
parse NumericValueExpressionTree as ParseNumericValueExpression
parse StringValueExpressionTree as ParseStringValueExpression
parse CharacterValueExpressionTree as ParseCharacterValueExpression
parse BinaryValueExpressionTree as ParseBinaryValueExpression
parse DatetimeValueExpressionTree as ParseDatetimeValueExpression
parse IntervalValueExpressionTree as ParseIntervalValueExpression
parse BooleanValueExpressionTree as ParseBooleanValueExpression
parse SearchConditionTree as ParseSearchCondition
parse PredicateTree as ParsePredicate
parse RowValuePredicandTree as ParseRowValuePredicand
parse ValueExpressionPrimaryTree as ParseValueExpressionPrimary
parse QueryExpression          as ParseQueryExpression
parse QuerySpecification       as ParseQuerySpecification
parse TableReference           as ParseTableReference
parse InsertStatement          as ParseInsertStatement
parse UpdateStatementSearched  as ParseUpdateStatementSearched
parse UpdateStatementPositioned as ParseUpdateStatementPositioned
parse DeleteStatementSearched  as ParseDeleteStatementSearched
parse DeleteStatementPositioned as ParseDeleteStatementPositioned
parse MergeStatement           as ParseMergeStatement
parse TruncateTableStatement   as ParseTruncateTableStatement
parse SQLSchemaStatement       as ParseSQLSchemaStatement
parse DirectSQLStatement       as ParseDirectSQLStatement
parse SQLTransactionStatement  as ParseSQLTransactionStatement
parse SQLConnectionStatement   as ParseSQLConnectionStatement
parse SQLSessionStatement      as ParseSQLSessionStatement
parse SQLDiagnosticsStatement  as ParseSQLDiagnosticsStatement
parse DirectSQLDataStatement   as ParseDirectSQLDataStatement
parse SQLControlStatement      as ParseSQLControlStatement
parse SQLDataStatement         as ParseSQLDataStatement
parse SQLDynamicStatement      as ParseSQLDynamicStatement
parse SQLProcedureStatement    as ParseSQLProcedureStatement
