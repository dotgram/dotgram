// ISO/IEC 9075-2:2023, SQL/Foundation: the standard's grammar, written from its BNF
// (Specification/ISO_IEC_9075-2(E)_Foundation.bnf.txt) and held to it by `--standard`, which
// puts each line of a file to the BNF itself and to the rule of the same name here.
//
// A rule is named after its production: each part capitalized and what divides the parts
// dropped, so <query expression> is `QueryExpression`. Where a rule says less or more than its
// production says, or says it in another shape, the comment above it says why. A production
// spelled as one character (<period>, <left paren>) is written as that character.
//
// Written chapter by chapter. So far: §5, the lexical elements, with the literals §5.3 makes of
// them and the names §5.4 does; §6, scalar expressions, with window functions and row pattern
// navigation and the JSON functions; §7, query expressions, with row pattern recognition and JSON
// tables; §8, predicates; §10.9, aggregates; §11 and §12, the schema's core — schemas, tables, views,
// domains, sequences, assertions, roles and privileges; §14, the data change statements and the cursors;
// §16 to §20, §22 and §23, the control, transaction, connection, session, dynamic, direct and
// diagnostics statements. What the BNF leaves to
// the Syntax Rules — the JSON path
// language's literals and names among it — is read as nothing, as `--standard` reads it.

@using System;
@using System.Collections.Generic;
@using DotGram.Sql.Ast;
@using DotGram.Sql.Standard;

using Lexical;

// ── §5.1 SQL terminal character, §5.2 Tokens and separators ─────────────────
//
// A namespace with no trivia, so a token is its characters and nothing stands between them.
// Everything outside it may be separated freely, which is what §5.2 says a <separator> is for.
namespace Lexical
{
	trivia = none

	// <simple Latin letter>, <digit>, <hexit>, <octal digit>, <binary digit>.
	SimpleLatinLetter = ['A'..'Z' | 'a'..'z']
	Digit             = ['0'..'9']
	Hexit             = ['0'..'9' | 'A'..'F' | 'a'..'f']
	OctalDigit        = ['0'..'7']
	BinaryDigit       = ['0' | '1']

	// §5.2 leaves four characters to its Syntax Rules. <space> is the space itself. An
	// <identifier start> is a letter of any script or a letter-like number (Unicode's L and Nl),
	// and an <identifier extend> the middle dot, a combining mark, a decimal digit, a connector
	// or a format character (Mn, Mc, Nd, Pc, Cf). <whitespace> is what Unicode calls white space.
	//
	// <identifier part> is either, and written as one set rather than a choice of the two: it is
	// also the word boundary, and a boundary guards the literals whose characters all fall in a
	// class — which a choice between rules is not.
	Space            = ' '
	IdentifierStart  = [\p{L} | \p{Nl}]
	IdentifierPart   = [\p{L} | \p{Nl} | '·' | \p{Mn} | \p{Mc} | \p{Nd} | \p{Pc} | \p{Cf}]
	Whitespace       = ['\t'..'\r' | '\u0085' | \p{Zs} | \p{Zl} | \p{Zp}]

	// <regular identifier>: <identifier body>, a start and parts. That it is no <reserved word>
	// is a Syntax Rule of §5.4, and it is kept where an identifier is read (`ActualIdentifier`).
	RegularIdentifier = IdentifierStart & IdentifierPart*

	// <delimited identifier>, with "" for a double quote inside; the body is not empty.
	DelimitedIdentifier     = '"' & DelimitedIdentifierPart+ & '"'
	DelimitedIdentifierPart = [^ '"'] | "\"\""

	// <Unicode delimited identifier>: `U&"…"`, where an escape names a character by its code
	// point. The Syntax Rules let `UESCAPE` choose the escape character; what is read here is
	// the default one, the reverse solidus, as `--standard` reads it too.
	UnicodeDelimitedIdentifier = 'U'i & '&' & '"' & UnicodeIdentifierPart+ & '"' & UnicodeEscapeSpecifier
	UnicodeEscapeSpecifier     = ("UESCAPE"i & '\'' & UnicodeEscapeCharacter & '\'')?
	UnicodeIdentifierPart      = UnicodeEscapeValue | DelimitedIdentifierPart
	UnicodeEscapeValue         = Unicode6DigitEscapeValue | Unicode4DigitEscapeValue | UnicodeCharacterEscapeValue
	Unicode4DigitEscapeValue   = UnicodeEscapeCharacter & Hexit{4}
	Unicode6DigitEscapeValue   = UnicodeEscapeCharacter & '+' & Hexit{6}
	UnicodeCharacterEscapeValue = UnicodeEscapeCharacter & UnicodeEscapeCharacter
	UnicodeEscapeCharacter     = '\\'

	// <separator>: comments and whitespace, as many as there are.
	Separator = (Comment | Whitespace)+
	Comment   = SimpleComment | BracketedComment

	// <simple comment> runs to the end of its line. §5.2 ends it with a <newline>, and the end
	// of the text ends the last line as well as a line break would.
	SimpleComment = "--" & (?!eol & any)* & (eol | eof)

	// <bracketed comment>: its contents are characters and separators, and a separator may be a
	// bracketed comment, so one holds another: `/* a /* b */ c */` is one comment.
	BracketedComment = "/*" & (BracketedComment | ?!"*/" & any)* & "*/"

	// ── §5.3 Literals ────────────────────────────────────────────────────────
	//
	// The letter that begins a literal is read in either case, as a key word is: `n'abc'`,
	// `x'0A'`, `u&'…'`, `0x1F` and `1e5`.

	// <unsigned numeric literal>. An approximate one is an exact one and an exponent, so it is
	// asked first; an integer in another radix begins with a `0`, so it is asked before the
	// decimal one. A digit may follow an underscore, once: `1_000` and not `1__0`.
	UnsignedNumericLiteral     = ApproximateNumericLiteral | ExactNumericLiteral
	ApproximateNumericLiteral  = ExactNumericLiteral & 'E'i & Sign? & UnsignedDecimalInteger
	ExactNumericLiteral        = UnsignedDecimalInteger & '.' & UnsignedDecimalInteger?
	                           | '.' & UnsignedDecimalInteger
	                           | UnsignedInteger
	Sign                       = ['+' | '-']
	UnsignedInteger            = UnsignedHexadecimalInteger | UnsignedOctalInteger | UnsignedBinaryInteger | UnsignedDecimalInteger
	UnsignedDecimalInteger     = Digit & ('_'? & Digit)*
	UnsignedHexadecimalInteger = "0X"i & ('_'? & Hexit)+
	UnsignedOctalInteger       = "0O"i & ('_'? & OctalDigit)+
	UnsignedBinaryInteger      = "0B"i & ('_'? & BinaryDigit)+

	// <character string literal>: quoted parts with '' for a quote inside, which a separator
	// may divide — `'a' 'b'` is one literal — and in front of them, optionally, the character
	// set they are written in: `_latin1'abc'`. The introducer's name is a part of the token,
	// with nothing between it and the quote.
	CharacterStringLiteral  = (Introducer & IntroducedCharacterSet)? & QuotedParts(CharacterRepresentation)
	CharacterRepresentation = [^ '\''] | "''"
	QuotedParts(part)       = '\'' & part* & '\'' & (Separator & '\'' & part* & '\'')*
	Introducer              = '_'

	// <character set name> as it stands after an introducer: a schema's name, and a catalog's
	// before it, and then an <SQL language identifier>. Said as a run, since a name the chain
	// could still go on from is not yet the last. The names are identifiers, so §5.4's Syntax
	// Rule reaches inside the token: `_select.latin1'a'` is refused.
	IntroducedCharacterSet = (IntroducedName & '.'){0,2} & SQLLanguageIdentifier
	IntroducedName         = UnicodeDelimitedIdentifier | ?!ReservedWord & RegularIdentifier | DelimitedIdentifier

	// <SQL language identifier>: a Latin letter, then Latin letters, digits and underscores.
	SQLLanguageIdentifier = SimpleLatinLetter & (SimpleLatinLetter | Digit | '_')* & ?!IdentifierPart

	// <multiplier>, of a large object's length: `2 K` and the one token `2K` alike. A letter, and a
	// whole word.
	Multiplier = ['K' | 'M' | 'G' | 'T' | 'P' | 'k' | 'm' | 'g' | 't' | 'p'] & ?!IdentifierPart

	// <national character string literal>, <Unicode character string literal>, and <binary
	// string literal>, whose hexits come in pairs that spaces may stand between.
	NationalCharacterStringLiteral = 'N'i & QuotedParts(CharacterRepresentation)
	UnicodeCharacterStringLiteral  = (Introducer & IntroducedCharacterSet)? & 'U'i & '&' & QuotedParts(UnicodeRepresentation) & UnicodeEscapeSpecifier
	UnicodeRepresentation          = UnicodeEscapeValue | CharacterRepresentation
	BinaryStringLiteral            = 'X'i & QuotedParts(BinaryPart)
	BinaryPart                     = Space | Hexit & Space* & Hexit

	// <date string>, <time string>, <timestamp string>, <interval string>: a string whose
	// characters are a value of the type. A <datetime value> is an unsigned integer, so
	// `'2020-1-1'` is a date string.
	DateString      = '\'' & DateValue & '\''
	TimeString      = '\'' & TimeValue & TimeZoneInterval? & '\''
	TimestampString = '\'' & DateValue & Space & TimeValue & TimeZoneInterval? & '\''
	DateValue        = UnsignedDecimalInteger & '-' & UnsignedDecimalInteger & '-' & UnsignedDecimalInteger
	TimeValue        = UnsignedDecimalInteger & ':' & UnsignedDecimalInteger & ':' & SecondsValue
	TimeZoneInterval = Sign & UnsignedDecimalInteger & ':' & UnsignedDecimalInteger
	SecondsValue     = UnsignedDecimalInteger & ('.' & UnsignedDecimalInteger?)?

	// <interval string>. A year-month and a day-time literal, and a day-time literal's forms,
	// begin alike — `'5'` is a year, a day, an hour, a minute and a second — so each form is
	// asked to reach the closing quote before the next is tried: a form that stops short of it
	// would otherwise be taken, and `'5.5'` read as an hour followed by what no string holds.
	IntervalString   = '\'' & Sign? & (YearMonthLiteral & ?='\'' | DayTimeLiteral) & '\''
	YearMonthLiteral = UnsignedDecimalInteger & ('-' & UnsignedDecimalInteger)?
	DayTimeLiteral   = DayTimeInterval & ?='\''
	                 | TimeInterval
	DayTimeInterval  = UnsignedDecimalInteger & (Space & UnsignedDecimalInteger & (':' & UnsignedDecimalInteger & (':' & SecondsValue)?)?)?
	TimeInterval     = UnsignedDecimalInteger & (':' & UnsignedDecimalInteger & (':' & SecondsValue)?)? & ?='\''
	                 | UnsignedDecimalInteger & (':' & SecondsValue)? & ?='\''
	                 | SecondsValue

	// ── §5.2 <reserved word> ─────────────────────────────────────────────────
	//
	// The whole list, as the standard gives it, and a whole word: `ABSOLUTE` is not `ABS`.
	//
	// Lexical, and not a list of key words at the top, because a key word there is guarded on
	// both sides and §5.4's Syntax Rule is asked inside a token too: after an introducer the `_`
	// stands before the name, and a guarded `SELECT` would take the `_` for a letter before it
	// and let `_select.latin1'a'` through.
	ReservedWord
		= ("ABS"i | "ABSENT"i | "ACOS"i | "ALL"i | "ALLOCATE"i | "ALTER"i | "AND"i | "ANY"i
		| "ANY_VALUE"i | "ARE"i | "ARRAY"i | "ARRAY_AGG"i | "ARRAY_MAX_CARDINALITY"i | "AS"i
		| "ASENSITIVE"i | "ASIN"i | "ASYMMETRIC"i | "AT"i | "ATAN"i | "ATOMIC"i | "AUTHORIZATION"i
		| "AVG"i | "BEGIN"i | "BEGIN_FRAME"i | "BEGIN_PARTITION"i | "BETWEEN"i | "BIGINT"i | "BINARY"i
		| "BLOB"i | "BOOLEAN"i | "BOTH"i | "BTRIM"i | "BY"i | "CALL"i | "CALLED"i | "CARDINALITY"i
		| "CASCADED"i | "CASE"i | "CAST"i | "CEIL"i | "CEILING"i | "CHAR"i | "CHAR_LENGTH"i
		| "CHARACTER"i | "CHARACTER_LENGTH"i | "CHECK"i | "CLASSIFIER"i | "CLOB"i | "CLOSE"i
		| "COALESCE"i | "COLLATE"i | "COLLECT"i | "COLUMN"i | "COMMIT"i | "CONDITION"i | "CONNECT"i
		| "CONSTRAINT"i | "CONTAINS"i | "CONVERT"i | "COPY"i | "CORR"i | "CORRESPONDING"i | "COS"i
		| "COSH"i | "COUNT"i | "COVAR_POP"i | "COVAR_SAMP"i | "CREATE"i | "CROSS"i | "CUBE"i
		| "CUME_DIST"i | "CURRENT"i | "CURRENT_CATALOG"i | "CURRENT_DATE"i
		| "CURRENT_DEFAULT_TRANSFORM_GROUP"i | "CURRENT_PATH"i | "CURRENT_ROLE"i | "CURRENT_ROW"i
		| "CURRENT_SCHEMA"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i
		| "CURRENT_TRANSFORM_GROUP_FOR_TYPE"i | "CURRENT_USER"i | "CURSOR"i | "CYCLE"i | "DATE"i
		| "DAY"i | "DEALLOCATE"i | "DEC"i | "DECFLOAT"i | "DECIMAL"i | "DECLARE"i | "DEFAULT"i
		| "DEFINE"i | "DELETE"i | "DENSE_RANK"i | "DEREF"i | "DESCRIBE"i | "DETERMINISTIC"i
		| "DISCONNECT"i | "DISTINCT"i | "DOUBLE"i | "DROP"i | "DYNAMIC"i | "EACH"i | "ELEMENT"i
		| "ELSE"i | "EMPTY"i | "END"i | "END_FRAME"i | "END_PARTITION"i | "END-EXEC"i | "EQUALS"i
		| "ESCAPE"i | "EVERY"i | "EXCEPT"i | "EXEC"i | "EXECUTE"i | "EXISTS"i | "EXP"i | "EXTERNAL"i
		| "EXTRACT"i | "FALSE"i | "FETCH"i | "FILTER"i | "FIRST_VALUE"i | "FLOAT"i | "FLOOR"i | "FOR"i
		| "FOREIGN"i | "FRAME_ROW"i | "FREE"i | "FROM"i | "FULL"i | "FUNCTION"i | "FUSION"i | "GET"i
		| "GLOBAL"i | "GRANT"i | "GREATEST"i | "GROUP"i | "GROUPING"i | "GROUPS"i | "HAVING"i | "HOLD"i
		| "HOUR"i | "IDENTITY"i | "IN"i | "INDICATOR"i | "INITIAL"i | "INNER"i | "INOUT"i
		| "INSENSITIVE"i | "INSERT"i | "INT"i | "INTEGER"i | "INTERSECT"i | "INTERSECTION"i
		| "INTERVAL"i | "INTO"i | "IS"i | "JOIN"i | "JSON"i | "JSON_ARRAY"i | "JSON_ARRAYAGG"i
		| "JSON_EXISTS"i | "JSON_OBJECT"i | "JSON_OBJECTAGG"i | "JSON_QUERY"i | "JSON_SCALAR"i
		| "JSON_SERIALIZE"i | "JSON_TABLE"i | "JSON_TABLE_PRIMITIVE"i | "JSON_VALUE"i | "LAG"i
		| "LANGUAGE"i | "LARGE"i | "LAST_VALUE"i | "LATERAL"i | "LEAD"i | "LEADING"i | "LEAST"i
		| "LEFT"i | "LIKE"i | "LIKE_REGEX"i | "LISTAGG"i | "LN"i | "LOCAL"i | "LOCALTIME"i
		| "LOCALTIMESTAMP"i | "LOG"i | "LOG10"i | "LOWER"i | "LPAD"i | "LTRIM"i | "MATCH"i
		| "MATCH_NUMBER"i | "MATCH_RECOGNIZE"i | "MATCHES"i | "MAX"i | "MEMBER"i | "MERGE"i | "METHOD"i
		| "MIN"i | "MINUTE"i | "MOD"i | "MODIFIES"i | "MODULE"i | "MONTH"i | "MULTISET"i | "NATIONAL"i
		| "NATURAL"i | "NCHAR"i | "NCLOB"i | "NEW"i | "NO"i | "NONE"i | "NORMALIZE"i | "NOT"i
		| "NTH_VALUE"i | "NTILE"i | "NULL"i | "NULLIF"i | "NUMERIC"i | "OCCURRENCES_REGEX"i
		| "OCTET_LENGTH"i | "OF"i | "OFFSET"i | "OLD"i | "OMIT"i | "ON"i | "ONE"i | "ONLY"i | "OPEN"i
		| "OR"i | "ORDER"i | "OUT"i | "OUTER"i | "OVER"i | "OVERLAPS"i | "OVERLAY"i | "PARAMETER"i
		| "PARTITION"i | "PATTERN"i | "PER"i | "PERCENT"i | "PERCENT_RANK"i | "PERCENTILE_CONT"i
		| "PERCENTILE_DISC"i | "PERIOD"i | "PORTION"i | "POSITION"i | "POSITION_REGEX"i | "POWER"i
		| "PRECEDES"i | "PRECISION"i | "PREPARE"i | "PRIMARY"i | "PROCEDURE"i | "PTF"i | "RANGE"i
		| "RANK"i | "READS"i | "REAL"i | "RECURSIVE"i | "REF"i | "REFERENCES"i | "REFERENCING"i
		| "REGR_AVGX"i | "REGR_AVGY"i | "REGR_COUNT"i | "REGR_INTERCEPT"i | "REGR_R2"i | "REGR_SLOPE"i
		| "REGR_SXX"i | "REGR_SXY"i | "REGR_SYY"i | "RELEASE"i | "RESULT"i | "RETURN"i | "RETURNS"i
		| "REVOKE"i | "RIGHT"i | "ROLLBACK"i | "ROLLUP"i | "ROW"i | "ROW_NUMBER"i | "ROWS"i | "RPAD"i
		| "RTRIM"i | "RUNNING"i | "SAVEPOINT"i | "SCOPE"i | "SCROLL"i | "SEARCH"i | "SECOND"i | "SEEK"i
		| "SELECT"i | "SENSITIVE"i | "SESSION_USER"i | "SET"i | "SHOW"i | "SIMILAR"i | "SIN"i | "SINH"i
		| "SKIP"i | "SMALLINT"i | "SOME"i | "SPECIFIC"i | "SPECIFICTYPE"i | "SQL"i | "SQLEXCEPTION"i
		| "SQLSTATE"i | "SQLWARNING"i | "SQRT"i | "START"i | "STATIC"i | "STDDEV_POP"i | "STDDEV_SAMP"i
		| "SUBMULTISET"i | "SUBSET"i | "SUBSTRING"i | "SUBSTRING_REGEX"i | "SUCCEEDS"i | "SUM"i
		| "SYMMETRIC"i | "SYSTEM"i | "SYSTEM_TIME"i | "SYSTEM_USER"i | "TABLE"i | "TABLESAMPLE"i
		| "TAN"i | "TANH"i | "THEN"i | "TIME"i | "TIMESTAMP"i | "TIMEZONE_HOUR"i | "TIMEZONE_MINUTE"i
		| "TO"i | "TRAILING"i | "TRANSLATE"i | "TRANSLATE_REGEX"i | "TRANSLATION"i | "TREAT"i
		| "TRIGGER"i | "TRIM"i | "TRIM_ARRAY"i | "TRUE"i | "TRUNCATE"i | "UESCAPE"i | "UNION"i
		| "UNIQUE"i | "UNKNOWN"i | "UNNEST"i | "UPDATE"i | "UPPER"i | "USER"i | "USING"i | "VALUE"i
		| "VALUES"i | "VALUE_OF"i | "VAR_POP"i | "VAR_SAMP"i | "VARBINARY"i | "VARCHAR"i | "VARYING"i
		| "VERSIONING"i | "WHEN"i | "WHENEVER"i | "WHERE"i | "WIDTH_BUCKET"i | "WINDOW"i | "WITH"i
		| "WITHIN"i | "WITHOUT"i | "YEAR"i)
		& ?!IdentifierPart

	// A question mark in a <row pattern quantifier>. `??(` and `??)` are the trigraph brackets, each one
	// token (§5.2), so a question mark that begins one is not a quantifier's: `(A??)` is refused.
	// Lexical, so that `(A? ?)` — two question marks and a bracket — is not taken for one.
	PatternQuestionMark = '?' & ?!("?(" | "?)")
}

// §5.2: a key word is a whole word, so `ABSOLUTE` is a name and not `ABS` and what follows it.
wordboundary = IdentifierPart

// §5.2: tokens may be separated by a <separator>, and nothing else stands between them.
trivia       = { Separator? }

// ── §5.3 Literals ───────────────────────────────────────────────────────────

Literal         : @LiteralValue = v: SignedNumericLiteral => @(v) | v: GeneralLiteral => @(v)
UnsignedLiteral : @LiteralValue = t: UnsignedNumericLiteral => @(Nodes.NumericLiteral(t)) | v: GeneralLiteral => @(v)

// <general literal>. What begins with a letter is asked before what may begin with the same
// letter as a name would — none of these is a name, and the typed literals begin with key words.
//
// A literal keeps what was written from its first quote to its last, the letter that begins it and
// its introducer apart: `N'a' 'b'` is a national string whose text is `'a' 'b'`.
GeneralLiteral : @LiteralValue
	= t: NationalCharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.National))
	| t: UnicodeCharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.Unicode))
	| t: BinaryStringLiteral => @(Nodes.BinaryLiteral(t))
	| t: CharacterStringLiteral => @(Nodes.StringLiteral(t, StringLiteralKind.Character))
	| v: DatetimeLiteral => @(v)
	| v: IntervalLiteral => @(v)
	| v: BooleanLiteral => @(v)

// A sign and a number are one literal, and its text is both.
SignedNumericLiteral : @LiteralValue = s: Sign? & n: UnsignedNumericLiteral => @(Nodes.NumericLiteral(s + n))

DatetimeLiteral  : @LiteralValue = v: DateLiteral => @(v) | v: TimeLiteral => @(v) | v: TimestampLiteral => @(v)
DateLiteral      : @LiteralValue = "DATE"i & t: DateString => @(new LiteralValue.DateTime(DateTimeLiteralKind.Date, t))
TimeLiteral      : @LiteralValue = "TIME"i & t: TimeString => @(new LiteralValue.DateTime(DateTimeLiteralKind.Time, t))
TimestampLiteral : @LiteralValue = "TIMESTAMP"i & t: TimestampString => @(new LiteralValue.DateTime(DateTimeLiteralKind.Timestamp, t))
IntervalLiteral  : @LiteralValue = "INTERVAL"i & s: Sign? & t: IntervalString & q: IntervalQualifier => @(new LiteralValue.Interval(t, q, Nodes.SignOf(s)))
BooleanLiteral   : @LiteralValue = t: ("TRUE"i | "FALSE"i | "UNKNOWN"i) => @(Nodes.BooleanLiteral(t))

// ── §10.1 Interval qualifier ────────────────────────────────────────────────
//
// Here because an interval literal ends in one.

IntervalQualifier : @IntervalQualifier
	= s: StartField & "TO"i & e: EndField => @(Nodes.Qualifier(s, e))
	| f: SingleDatetimeField => @(f)

StartField : @IntervalQualifier = f: NonSecondPrimaryDatetimeField & ('(' & p: IntervalLeadingFieldPrecision & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p)))

EndField : @IntervalQualifier
	= f: NonSecondPrimaryDatetimeField => @(new IntervalQualifier(Nodes.Field(f)))
	| f: "SECOND"i & ('(' & p: IntervalFractionalSecondsPrecision & ')')? => @(new IntervalQualifier(Nodes.Field(f), null, null, Nodes.Integer(p)))

SingleDatetimeField : @IntervalQualifier
	= f: NonSecondPrimaryDatetimeField & ('(' & p: IntervalLeadingFieldPrecision & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p)))
	| f: "SECOND"i & ('(' & p: IntervalLeadingFieldPrecision & (',' & q: IntervalFractionalSecondsPrecision)? & ')')? => @(new IntervalQualifier(Nodes.Field(f), Nodes.Integer(p), null, Nodes.Integer(q)))

NonSecondPrimaryDatetimeField      = "YEAR"i | "MONTH"i | "DAY"i | "HOUR"i | "MINUTE"i
IntervalFractionalSecondsPrecision = UnsignedInteger
IntervalLeadingFieldPrecision      = UnsignedInteger

// ── §5.4 Names and identifiers ──────────────────────────────────────────────

// <identifier>, read whole. Over characters a rule gives back what it read when what follows fails
// (docs/syntax.md §4), and an identifier would give back its letters: `COLUMNS (xy)` was a column `x`
// of a type `y`, and `ROW(ab)` a field `a` of a type `b`. §5.2 cuts a text into its longest tokens,
// so a name is one token, and the braces say so; a refused line no longer tries every place a name
// could be cut, either.
Identifier : @Identifier = { i: ActualIdentifier } => @(i)

// <actual identifier>. A Unicode one begins `U&`, which a regular identifier would take the
// `U` of, so it is asked first. §5.4's Syntax Rule is the lookahead: a regular identifier is
// no reserved word, in any case.
ActualIdentifier : @Identifier
	= t: UnicodeDelimitedIdentifier => @(Nodes.UnicodeIdentifier(t))
	| ?!ReservedWord & t: RegularIdentifier => @(new Identifier(t))
	| t: DelimitedIdentifier => @(new Identifier(t, IdentifierStyle.Delimited))

// <table name>, <local or schema qualified name>: a name, a schema's before it and a catalog's
// before that, or `MODULE` for a module's own. The standard nests the qualifiers, and an ordered
// choice would take the longest one and leave no name for the end, so the names are a run.
TableName                  : @QualifiedName = n: LocalOrSchemaQualifiedName => @(n)
LocalOrSchemaQualifiedName : @QualifiedName = m: LocalQualifier & '.' & q: QualifiedIdentifier => @(Nodes.Named(m, q))
                                            | first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
LocalQualifier             = "MODULE"i
QualifiedIdentifier        : @Identifier = i: Identifier => @(i)

// <schema name>: a catalog's name may stand before it.
SchemaName            : @QualifiedName = first: CatalogName & ('.' & rest: UnqualifiedSchemaName)? => @(Nodes.Chain(first, rest))
UnqualifiedSchemaName : @Identifier = i: Identifier => @(i)
CatalogName           : @Identifier = i: Identifier => @(i)

ColumnName : @Identifier = i: Identifier => @(i)

// §6.6 <identifier chain>, and a column reference made of one.
IdentifierChain      : @QualifiedName = first: Identifier & ('.' & rest: Identifier)* => @(Nodes.Chain(first, rest))
BasicIdentifierChain : @QualifiedName = n: IdentifierChain => @(n)

ColumnReference : @Expression
	= n: BasicIdentifierChain => @(new Expression.Reference(n))
	| m: "MODULE"i & '.' & q: QualifiedIdentifier & '.' & c: ColumnName => @(new Expression.Reference(Nodes.Named(m, q, c)))

SchemaQualifiedName             : @QualifiedName = first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
PathResolvedUserDefinedTypeName : @QualifiedName = first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
RoutineName                     : @QualifiedName = first: Identifier & ('.' & rest: Identifier){0,2} => @(Nodes.Chain(first, rest))
MethodName                      : @Identifier = i: Identifier => @(i)

// ── §6.1 Data types ─────────────────────────────────────────────────────────

// <data type>, with <collection type>'s `ARRAY` and `MULTISET` written after it as often as they
// stand there: the BNF says `<data type> ARRAY`, which recurses through itself on the left.
DataType             : @DataType = b: DataTypeBase & (trivia & s: CollectionTypeSuffix)* => @(Nodes.Collected(b, s))
DataTypeBase         : @DataType
	= t: PredefinedType => @(t)
	| t: RowType => @(t)
	| t: ReferenceType => @(t)
	| n: PathResolvedUserDefinedTypeName => @(new DataType.UserDefined(n))
CollectionTypeSuffix : @Nodes.Suffix
	= "ARRAY"i & (l: LeftBracketOrTrigraph & n: UnsignedInteger & RightBracketOrTrigraph)? => @(Nodes.ArraySuffix(l, n))
	| "MULTISET"i => @(Nodes.MultisetSuffix())

PredefinedType : @DataType
	= t: CharacterStringType & ("CHARACTER"i & "SET"i & cs: CharacterSetSpecification)? & c: CollateClause? => @(Nodes.Characters(t, cs, c))
	| t: NationalCharacterStringType & c: CollateClause? => @(Nodes.Characters(t, null, c))
	| t: BinaryStringType => @(t)
	| t: NumericType => @(t)
	| "BOOLEAN"i => @(new DataType.Boolean())
	| t: DatetimeType => @(t)
	| "INTERVAL"i & q: IntervalQualifier => @(new DataType.Interval(q))
	| "JSON"i => @(new DataType.Json())

// The character string types. A type the BNF spells as a longer one's beginning — `CHARACTER`
// before `CHARACTER VARYING` — is asked after it, so that the choice does not take the beginning
// and leave the rest. Each keeps which of its spellings was written.
CharacterStringType : @DataType
	= w: ("CHARACTER"i | "CHAR"i) & "VARYING"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character(w + " VARYING", l))
	| w: ("CHARACTER"i | "CHAR"i) & "LARGE"i & "OBJECT"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character(w + " LARGE OBJECT", l))
	| w: ("CHARACTER"i | "CHAR"i) & ('(' & l: CharacterLength & ')')? => @(Nodes.Character(w, l))
	| "VARCHAR"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("VARCHAR", l))
	| "CLOB"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("CLOB", l))

NationalCharacterStringType : @DataType
	= "NATIONAL"i & w: ("CHARACTER"i | "CHAR"i) & "VARYING"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NATIONAL " + w + " VARYING", l))
	| "NATIONAL"i & "CHARACTER"i & "LARGE"i & "OBJECT"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("NATIONAL CHARACTER LARGE OBJECT", l))
	| "NATIONAL"i & w: ("CHARACTER"i | "CHAR"i) & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NATIONAL " + w, l))
	| "NCHAR"i & "VARYING"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NCHAR VARYING", l))
	| "NCHAR"i & "LARGE"i & "OBJECT"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("NCHAR LARGE OBJECT", l))
	| "NCHAR"i & ('(' & l: CharacterLength & ')')? => @(Nodes.Character("NCHAR", l))
	| "NCLOB"i & ('(' & l: CharacterLargeObjectLength & ')')? => @(Nodes.Character("NCLOB", l))

BinaryStringType : @DataType
	= "BINARY"i & "VARYING"i & ('(' & n: UnsignedInteger & ')')? => @(Nodes.Binary("BINARY VARYING", n, null))
	| "BINARY"i & "LARGE"i & "OBJECT"i & ('(' & s: LargeObjectLength & ')')? => @(Nodes.Binary("BINARY LARGE OBJECT", null, s))
	| "BINARY"i & ('(' & n: UnsignedInteger & ')')? => @(Nodes.Binary("BINARY", n, null))
	| "VARBINARY"i & ('(' & n: UnsignedInteger & ')')? => @(Nodes.Binary("VARBINARY", n, null))
	| "BLOB"i & ('(' & s: LargeObjectLength & ')')? => @(Nodes.Binary("BLOB", null, s))

NumericType : @DataType
	= w: ("NUMERIC"i | "DECIMAL"i | "DEC"i) & ('(' & p: UnsignedInteger & (',' & s: UnsignedInteger)? & ')')? => @(Nodes.NumericType(w, p, s))
	| w: ("SMALLINT"i | "INTEGER"i | "INT"i | "BIGINT"i | "REAL"i) => @(Nodes.NumericType(w, null, null))
	| w: "FLOAT"i & ('(' & p: UnsignedInteger & ')')? => @(Nodes.NumericType(w, p, null))
	| "DOUBLE"i & "PRECISION"i => @(Nodes.NumericType("DOUBLE PRECISION", null, null))
	| w: "DECFLOAT"i & ('(' & p: UnsignedInteger & ')')? => @(Nodes.NumericType(w, p, null))

DatetimeType : @DataType
	= "DATE"i => @(new DataType.DateTime(DateTimeTypeKind.Date))
	| w: ("TIME"i | "TIMESTAMP"i) & ('(' & p: UnsignedInteger & ')')? & (z: ("WITH"i | "WITHOUT"i) & "TIME"i & "ZONE"i)? => @(Nodes.DateTime(w, p, z))

// <character length>, <large object length>: `2 K` is a length and `2K` one token of it.
CharacterLength            : @Nodes.Length = n: UnsignedInteger & u: CharLengthUnits? => @(Nodes.LengthOf(n, u))
CharacterLargeObjectLength : @Nodes.Length = s: LargeObjectLength & u: CharLengthUnits? => @(Nodes.LengthOf(s, u))
LargeObjectLength          : @LargeObjectSize = n: UnsignedInteger & m: Multiplier? => @(Nodes.Size(n, m))
CharLengthUnits            = "CHARACTERS"i | "OCTETS"i

RowType         : @DataType = "ROW"i & '(' & first: FieldDefinition & (',' & rest: FieldDefinition)* & ')' => @(new DataType.Row(Nodes.List(first, rest)))
FieldDefinition : @FieldDefinition = n: Identifier & t: DataType => @(new FieldDefinition(n, t))
ReferenceType   : @DataType = "REF"i & '(' & n: PathResolvedUserDefinedTypeName & ')' & ("SCOPE"i & s: TableName)? => @(new DataType.Reference(n, s))

// <character set specification>, <character set name>: names, and an SQL language identifier last.
CharacterSetSpecification : @CharacterSetName = (q: Identifier & '.'){0,2} & l: SQLLanguageIdentifier => @(Nodes.CharacterSet(q, l))

CollateClause : @CollationName = "COLLATE"i & n: SchemaQualifiedName => @(new CollationName(n))

LeftBracketOrTrigraph  = "??(" | '['
RightBracketOrTrigraph = "??)" | ']'

// ── §6.28 Value expressions, §8.1 Boolean value expressions ────────────────
//
// The BNF types its value expressions — a numeric one, a character one, a datetime one, an
// interval one and more — as towers that meet only in a <value expression primary>, and a
// <value expression> is any of them or a boolean or a row. An ordered choice cannot try them one
// after another: each would take the first operand and stop. So each is read once, in the shape
// they share, and what a piece can still be comes back beside its node (Towers.cs): a guard refuses a
// reading that is none of them. `a || b + c` is refused, `x + y AT LOCAL` read and `x - y AT LOCAL`
// refused, as the BNF has them.
//
// What is not built yet — a subquery's query, the window and JSON functions, a JSON subscript — stands
// as `Nodes.Unbuilt`, and each goes as its chapter builds its tree.

// <value expression>. A value that is no boolean is a boolean primary with nothing around it, so
// the boolean reading is the one reading.
ValueExpression : @Towers.Typed = e: Disjunction => @(e)

// <boolean value expression>, <search condition>: what only a boolean can be, or a predicand.
BooleanValueExpression : @Towers.Typed = e: Disjunction & when @((Towers.RolesOf(e) & Towers.Truth) != 0) => @(e)
SearchCondition        : @Towers.Typed = e: BooleanValueExpression => @(e)

// `OR`, `AND` and `NOT` join booleans; a term with none of them is whatever it is.
Disjunction   : @Towers.Typed = first: Conjunction & rest: OrOperand* & when @(Towers.Connect(first, rest) != 0) => @(Towers.Connected(first, rest, BinaryOperator.Or))
OrOperand     : @Towers.Typed = "OR"i & e: Conjunction => @(e)
Conjunction   : @Towers.Typed = first: BooleanFactor & rest: AndOperand* & when @(Towers.Connect(first, rest) != 0) => @(Towers.Connected(first, rest, BinaryOperator.And))
AndOperand    : @Towers.Typed = "AND"i & e: BooleanFactor => @(e)
BooleanFactor : @Towers.Typed = "NOT"i & e: BooleanTest & when @((Towers.RolesOf(e) & Towers.Truth) != 0) => @(new Towers.Typed(new Expression.Unary(UnaryOperator.Not, e.Node), Towers.Logical | Towers.Truth))
                              | e: BooleanTest => @(e)

// <boolean test>: `IS TRUE`, `IS NOT UNKNOWN`.
BooleanTest : @Towers.Typed = e: BooleanPrimary & t: TruthTest & when @(!Nodes.TestedOf(t) || (Towers.RolesOf(e) & Towers.Truth) != 0) => @(t.Tested ? new Towers.Typed(new Expression.IsTruth(e.Node, t.Not, t.Value), Towers.Logical | Towers.Truth) : e)
TruthTest   : @Nodes.Truth = "IS"i & n: "NOT"i? & v: TruthValue => @(new Nodes.Truth(true, n is not null, Nodes.Truthful(v)))
                           | none => @(default)
TruthValue  = "TRUE"i | "FALSE"i | "UNKNOWN"i

// <boolean primary>: a predicate, or a boolean predicand. Almost every predicate begins with a row
// value predicand, so the predicand is read once and what follows it says which: nothing, and it is
// a predicand; a predicate's second part, and it is that predicate, if the second part takes it.
BooleanPrimary : @Towers.Typed
	= "EXISTS"i & TableSubquery => @(new Towers.Typed(new Expression.Exists(Nodes.UnbuiltQuery()), Towers.Logical | Towers.Truth))
	| JSONExistsPredicate => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Logical | Towers.Truth))
	| "UNIQUE"i & ("NULLS"i & n: "NOT"i? & d: "DISTINCT"i)? & TableSubquery => @(new Towers.Typed(new Expression.Unique(Nodes.Nulls(d, n), Nodes.UnbuiltQuery()), Towers.Logical | Towers.Truth))
	| p: PeriodConstructor & t: PeriodPredicatePart2 => @(new Towers.Typed(t with { Left = p }, Towers.Logical | Towers.Truth))
	| e: RowValuePredicand & takes: PredicatePart2Mark & when @(Towers.RolesOf(takes) == 0 || (Towers.RolesOf(e) & Towers.RolesOf(takes)) != 0) => @(takes.Roles == 0 ? e : new Towers.Typed(Nodes.Predicated(e.Node, takes.Node!), Towers.Logical | Towers.Truth))

PredicatePart2Mark : @Towers.Tail = p: PredicatePart2 => @(p)
                                  | none => @(default)

// <predicate>: a boolean primary that is not only a predicand.
Predicate : @Towers.Typed = e: BooleanPrimary & when @((Towers.RolesOf(e) & Towers.Logical) != 0) => @(e)

// ── §8 Predicates ───────────────────────────────────────────────────────────
//
// The second parts, which is what the BNF calls them too: each says what it takes before it. Most
// take any row value predicand; a JSON predicate a string or a JSON value; a period predicate a
// period's name. Each builds its predicate with the left side empty, and `Nodes.Predicated` puts the
// predicand in.
//
// A quantified comparison is asked after a comparison: `ANY ((SELECT …))` and `SOME ((SELECT …))`
// are aggregates of a scalar subquery too, and read as one they may go on — `a = ANY ((SELECT a FROM
// t)) + 1` — where the quantifier's reading would stop.
PredicatePart2 : @Towers.Tail
	= o: CompOp & compared: ComparisonTail => @(new Towers.Tail(Towers.Any, Nodes.Compared(compared, o)))
	| "MATCH"i & u: "UNIQUE"i? & m: ("SIMPLE"i | "PARTIAL"i | "FULL"i)? & TableSubquery => @(new Towers.Tail(Towers.Any, new Expression.Match(null!, u is not null, Nodes.Matching(m), Nodes.UnbuiltQuery())))
	| n: "NOT"i? & negatable: NegatablePredicatePart2 => @(new Towers.Tail(Towers.Any, Nodes.Negated(negatable, n is not null)))
	| "IS"i & n: "NOT"i? & tested: IsPredicatePart2 => @(tested with { Node = Nodes.Negated(tested.Node!, n is not null) })
	| "OVERLAPS"i & r: RowValuePredicand => @(new Towers.Tail(Towers.Any, new Expression.Overlaps(null!, r.Node)))
	| i: JSONInputClause & "IS"i & n: "NOT"i? & "JSON"i & y: JSONPredicateTypeConstraint? & k: JSONKeyUniquenessConstraint? => @(new Towers.Tail(Towers.String | Towers.Json, new Expression.JsonPredicate(null!, i, n is not null, Nodes.JsonType(y), Nodes.Uniqueness(k))))
	| period: PeriodPredicatePart2 => @(new Towers.Tail(Towers.Chain, period))

// What follows a comparison's operator: a row value predicand, or a quantifier and a subquery.
ComparisonTail : @Expression
	= r: RowValuePredicand => @(new Expression.Comparison(null!, default, r.Node))
	| q: ("ALL"i | "SOME"i | "ANY"i) & TableSubquery => @(new Expression.QuantifiedComparison(null!, default, Nodes.Quantified(q), Nodes.UnbuiltQuery()))

// <comp op>, the longer operators first.
CompOp = "<>" | "<=" | ">=" | '=' | '<' | '>'

// What may stand after `NOT`: <between predicate part 2>, <in predicate part 2>, <like predicate>'s
// — a character pattern or a binary one, with an escape of the same kind — <similar predicate part
// 2>, <regex like predicate part 2>, <member predicate part 2>, <submultiset predicate part 2>.
NegatablePredicatePart2 : @Expression
	= "BETWEEN"i & s: ("ASYMMETRIC"i | "SYMMETRIC"i)? & l: RowValuePredicand & "AND"i & h: RowValuePredicand => @(new Expression.Between(null!, false, Nodes.Symmetry(s), l.Node, h.Node))
	| "IN"i & TableSubquery => @(new Expression.In(null!, false, new InSource.Query(Nodes.UnbuiltQuery())))
	| "IN"i & '(' & { first: RowValueExpression & (',' & rest: RowValueExpression)* } & ')' => @(new Expression.In(null!, false, new InSource.Values(Nodes.Values(first, rest))))
	| "LIKE"i & p: StringValueExpression & e: LikeEscape & when @((Towers.RolesOf(p) & Towers.RolesOf(e) & Towers.String) != 0) => @(new Expression.Like(null!, false, LikeKind.Like, p.Node, e.Node))
	| "SIMILAR"i & "TO"i & p: CharacterValueExpression & ("ESCAPE"i & x: CharacterNode)? => @(new Expression.Like(null!, false, LikeKind.Similar, p.Node, x))
	| "LIKE_REGEX"i & p: CharacterValueExpression & ("FLAG"i & f: CharacterNode)? => @(new Expression.Like(null!, false, LikeKind.Regex, p.Node, null, f))
	| m: ("MEMBER"i | "SUBMULTISET"i) & o: "OF"i? & c: MultisetValueExpression => @(Nodes.Membership(m, o is not null, c.Node))

LikeEscape : @Towers.Typed = "ESCAPE"i & e: StringValueExpression => @(e)
                           | none => @(new Towers.Typed(null!, Towers.String))

// What may stand after `IS` and `NOT`: <null predicate part 2>, <normalized predicate part 2>,
// <distinct predicate part 2>, <set predicate part 2>, <type predicate part 2>, <JSON predicate>'s.
IsPredicatePart2 : @Towers.Tail
	= "NULL"i => @(new Towers.Tail(Towers.Any, new Expression.IsNull(null!, false)))
	| f: NormalForm? & "NORMALIZED"i => @(new Towers.Tail(Towers.Any, new Expression.IsNormalized(null!, false, Nodes.Form(f))))
	| "DISTINCT"i & "FROM"i & r: RowValuePredicand => @(new Towers.Tail(Towers.Any, new Expression.IsDistinct(null!, false, r.Node)))
	| "A"i & "SET"i => @(new Towers.Tail(Towers.Any, new Expression.IsSet(null!, false)))
	| "OF"i & '(' & first: UserDefinedTypeSpecification & (',' & rest: UserDefinedTypeSpecification)* & ')' => @(new Towers.Tail(Towers.Any, new Expression.IsOf(null!, false, Nodes.List(first, rest))))
	| "JSON"i & y: JSONPredicateTypeConstraint? & k: JSONKeyUniquenessConstraint? => @(new Towers.Tail(Towers.String | Towers.Json, new Expression.JsonPredicate(null!, null, false, Nodes.JsonType(y), Nodes.Uniqueness(k))))

NormalForm                   = "NFC"i | "NFD"i | "NFKC"i | "NFKD"i
UserDefinedTypeSpecification : @TypeTest = o: "ONLY"i? & n: PathResolvedUserDefinedTypeName => @(new TypeTest(n, o is not null))

// <JSON input clause>, <JSON representation>, and what a JSON predicate asks of the value.
JSONInputClause             : @JsonInputClause = "FORMAT"i & r: JSONRepresentation => @(new JsonInputClause(r))
JSONRepresentation          : @JsonRepresentation = "JSON"i & ("ENCODING"i & e: ("UTF8"i | "UTF16"i | "UTF32"i))? => @(new JsonRepresentation(Nodes.Encoding(e)))
JSONPredicateTypeConstraint = "VALUE"i | "ARRAY"i | "OBJECT"i | "SCALAR"i
JSONKeyUniquenessConstraint = ("WITH"i | "WITHOUT"i) & "UNIQUE"i & "KEYS"i?

// <period predicate>: a period, named or constructed, and another, or a point in time it contains.
// The left side is filled in by `BooleanPrimary` or `Nodes.Predicated`.
PeriodPredicatePart2 : @Expression.PeriodPredicate
	= o: ("OVERLAPS"i | "EQUALS"i | "PRECEDES"i | "SUCCEEDS"i) & r: PeriodPredicand => @(new Expression.PeriodPredicate(null!, Nodes.Period(o, false), new PeriodRight.Period(r)))
	| "IMMEDIATELY"i & o: ("PRECEDES"i | "SUCCEEDS"i) & r: PeriodPredicand => @(new Expression.PeriodPredicate(null!, Nodes.Period(o, true), new PeriodRight.Period(r)))
	| "CONTAINS"i & contained: PeriodContained => @(new Expression.PeriodPredicate(null!, PeriodOperator.Contains, contained))
PeriodContained   : @PeriodRight = d: DatetimeValueExpression => @(new PeriodRight.Point(d.Node))
                                 | p: PeriodPredicand => @(new PeriodRight.Period(p))
PeriodPredicand   : @PeriodValue = c: PeriodConstructor => @(c)
                                 | n: IdentifierChain => @(new PeriodValue.Reference(n))
PeriodConstructor : @PeriodValue = "PERIOD"i & '(' & s: DatetimeValueExpression & ',' & e: DatetimeValueExpression & ')' => @(new PeriodValue.Range(s.Node, e.Node))

// ── §7.1 Row value constructors, as far as a predicate needs them ───────────

// <row value predicand>: a common value expression — which a boolean predicand in brackets and a
// value expression primary already are — or an explicit row value constructor. A row is read where a
// bracket is (`Bracketed`), and `ROW (…)` where a primary begins; a row subquery is written as a
// scalar subquery is, and read as one.
RowValuePredicand : @Towers.Typed = e: CommonValueExpressionOrRow => @(e)

// <row value expression>: a value expression primary not in brackets, or an explicit row. So
// `x IN (a + 1)` is refused by the BNF, whose <in value list> holds row value expressions.
RowValueExpression : @Towers.Typed = e: CommonValueExpressionOrRow & when @((Towers.RolesOf(e) & (Towers.Row | Towers.Bare)) != 0) => @(e)

// ── §6.28 Common value expressions ──────────────────────────────────────────

// <common value expression>: operands and the operators between them, which Towers.cs holds to
// the towers and builds the node of. An explicit row is an operand in shape, and something only
// alone: where a row may stand, the one reading serves both.
CommonValueExpressionOrRow : @Towers.Typed = first: Operand & rest: Operated* & when @(Towers.Common(first, rest) != 0) => @(Towers.Expression(first, rest))
CommonValueExpression      : @Towers.Typed = e: CommonValueExpressionOrRow & when @((Towers.RolesOf(e) & Towers.Value) != 0) => @(e)

// Not productions: the operators the towers share, read once for all of them. `||` joins character,
// binary and array operands; `MULTISET UNION`, `EXCEPT` and `INTERSECT` multisets; `*`, `/`, `+`
// and `-` numbers, intervals and datetimes.
Operated : @Towers.Operated = o: Operator & e: Operand => @(new Towers.Operated(o, e))
Operator : @Towers.Op
	= "||" => @(new Towers.Op(Towers.Concatenate))
	| "MULTISET"i & m: ("UNION"i | "EXCEPT"i | "INTERSECT"i) & q: ("ALL"i | "DISTINCT"i)? => @(new Towers.Op(Towers.MultisetOperator, Nodes.Multiset(m), Nodes.Quantifier(q)))
	| '*' => @(new Towers.Op(Towers.Times))
	| '/' => @(new Towers.Op(Towers.Divided))
	| '+' => @(new Towers.Op(Towers.Plus))
	| '-' => @(new Towers.Op(Towers.Minus))

// Not a production: what every tower's factor is made of. A sign (<factor>, <interval factor>),
// a primary, and what may follow one: an interval qualifier (<interval primary>), a time zone
// (<datetime factor>), a collate clause (<character factor>), or a type's name (<specific type
// method>), which is a character value function and may be collated in turn.
Operand : @Towers.Piece = s: Sign? & p: Primary & x: Postfix & when @(Towers.OperandRoles(Nodes.SignOf(s), p, x) != 0) => @(new Towers.Piece(Nodes.SignOf(s), p, x))
Postfix : @Towers.After
	= '.' & w: "SPECIFICTYPE"i & b: ('(' & ')')? & c: CollateClause => @(new Towers.After(Towers.TypedCollated, new Expression.Collate(Nodes.SpecificType(w, b), c)))
	| '.' & w: "SPECIFICTYPE"i & b: ('(' & ')')? => @(new Towers.After(Towers.Typed_, Nodes.SpecificType(w, b)))
	| q: IntervalQualifier => @(new Towers.After(Towers.Qualified, new Expression.IntervalQualified(null!, q)))
	| z: TimeZone => @(new Towers.After(Towers.Zoned, z))
	| c: CollateClause => @(new Towers.After(Towers.Collated, new Expression.Collate(null!, c)))
	| none => @(default)

// <time zone>. The zone is an interval primary: a value expression primary with or without a
// qualifier, or an interval's `ABS`. `AT LOCAL` names no zone.
TimeZone        : @Expression = "AT"i & z: TimeZoneSpecifier => @(new Expression.AtTimeZone(null!, z.Node))
TimeZoneSpecifier : @Towers.Typed = "LOCAL"i => @(new Towers.Typed(null!, 0))
                                  | "TIME"i & "ZONE"i & z: IntervalPrimary => @(z)
IntervalPrimary : @Towers.Typed = p: Primary & q: IntervalQualifier? & when @(q is not null ? (Towers.RolesOf(p) & Towers.Value) == Towers.Value : (Towers.RolesOf(p) & Towers.Interval) != 0) => @(new Towers.Typed(q is null ? p.Node : new Expression.IntervalQualified(p.Node, q), Towers.Interval))

// Not a production: a primary of any tower. A value function is of the tower it names; an array's
// may be subscripted, and is then a value expression primary.
Primary : @Towers.Typed
	= f: ValueFunction & s: FunctionSubscript & when @(Towers.RolesOf(s) == 0 || (f & Towers.Array) != 0) => @(Towers.Stepped(new Towers.Typed(Nodes.Unbuilt(), f), s))
	| p: PrimaryReading => @(p)

FunctionSubscript : @Towers.Stepping = e: ArrayElementStep & s: PrimaryStep* => @(Towers.Subscripted(e, s))
                                     | none => @(default)

// The towers, each an expression the towers say it can be.
NumericValueExpression    : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Numeric) != 0) => @(e)
StringValueExpression     : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.String) != 0) => @(e)
CharacterValueExpression  : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Character) != 0) => @(e)
BinaryValueExpression     : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Binary) != 0) => @(e)
DatetimeValueExpression   : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Datetime) != 0) => @(e)
IntervalValueExpression   : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Interval) != 0) => @(e)
ArrayValueExpression      : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Array) != 0) => @(e)
MultisetValueExpression   : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Multiset) != 0) => @(e)
CollectionValueExpression : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & (Towers.Array | Towers.Multiset)) != 0) => @(e)

// Not productions: a tower's node alone, where a rule keeps the node and asks nothing of its towers —
// and where it may be left out, which a node says by being null.
ValueNode     : @Expression = e: ValueExpression => @(e.Node)
CharacterNode : @Expression = e: CharacterValueExpression => @(e.Node)

// ── §6.3 Value expression primary ───────────────────────────────────────────

// <value expression primary>: a common value expression that is one — which a subscripted
// concatenation is too (Towers.cs). A non-parenthesized one is `Towers.Bare`, asked where it stands.
ValueExpressionPrimary : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & (Towers.Bare | Towers.Parenthesized)) != 0) => @(e)

// Not a production: a primary read as one. <field reference>, <method invocation>, <attribute or
// method reference> and <array element reference> each begin with a value expression primary,
// which is left recursion through other productions; they are steps after one here, as many as
// there are. A primary in brackets is a parenthesized one only while no step follows it, and a row
// takes no step.
//
// A <scalar subquery> is asked before a bracket's value expression: `((SELECT a FROM t))` is both,
// and only the subquery is a non-parenthesized primary, which an in value list asks for.
PrimaryReading : @Towers.Typed
	= ScalarSubquery & s: PrimarySteps => @(Towers.Stepped(new Towers.Typed(new Expression.Subquery(Nodes.UnbuiltQuery()), Towers.Value | Towers.Truth | Towers.Bare), s))
	| b: Bracketed & s: PrimarySteps & when @(Towers.RolesOf(s) == 0 || (Towers.RolesOf(b) & Towers.Row) == 0) => @(Towers.Stepped(b, s))
	| p: PrimaryBase & s: PrimarySteps & when @(Towers.RolesOf(s) == 0 || (Towers.RolesOf(p) & Towers.Row) == 0) => @(Towers.Stepped(p, s))

// Not a production: a bracket, read once. A <parenthesized value expression>, an <explicit row value
// constructor> and a <generalized invocation> each begin with a bracket and a value expression, and
// what follows the value expression says which: the closing bracket, a comma, or `AS`. Tried one
// after another, each read the bracket's contents again, and a line refused deep inside nested
// brackets cost a power of their depth — eight of them, 46 ms. A generalized invocation's value
// expression is a primary.
Bracketed : @Towers.Typed = '(' & e: ValueExpression & t: BracketTail & when @(Towers.KindOf(t) != Towers.Bare || (Towers.RolesOf(e) & (Towers.Bare | Towers.Parenthesized)) != 0) => @(Nodes.Bracketed(e, t))

BracketTail : @Towers.Bracket
	= ')' => @(new Towers.Bracket(Towers.Parenthesized))
	| (',' & rest: ValueNode)+ & ')' => @(new Towers.Bracket(Towers.Row, rest))
	| "AS"i & t: DataType & ')' & '.' & m: MethodName & a: SQLArgumentList? => @(new Towers.Bracket(Towers.Bare, null, t, m, a))

PrimarySteps : @Towers.Stepping = s: PrimaryStep* => @(new Towers.Stepping(Towers.Steps(s), s))
//
// With them the operations of a <JSON simplified accessor>, which is a primary and its operations:
// `.*`, an item method — asked before a method, since its names are mostly reserved words and its
// arguments are fixed — `[*]`, and subscripts in the path language, asked after an array element's.
PrimaryStep : @Towers.Step
	= '.' & '*' => @(new Towers.Step(Towers.Bare | Towers.Starred, new Expression.Wildcard(null!, WildcardKind.Member)))
	| '.' & j: JSONMethod => @(new Towers.Step(Towers.Bare, j))
	| '.' & m: MethodName & a: SQLArgumentList? => @(new Towers.Step(Towers.Bare, new Expression.Member(null!, MemberAccessKind.Dot, m, a)))
	| "->" & m: Identifier & a: SQLArgumentList? => @(new Towers.Step(Towers.Bare, new Expression.Member(null!, MemberAccessKind.Dereference, m, a)))
	| e: ArrayElementStep => @(e)
	| '[' & '*' & ']' => @(new Towers.Step(Towers.Bare, new Expression.Wildcard(null!, WildcardKind.Array)))
	| '[' & JSONSubscript & (',' & JSONSubscript)* & ']' => @(new Towers.Step(Towers.Bare, new Expression.Element(null!, Nodes.Unbuilt())))

ArrayElementStep : @Towers.Step = l: LeftBracketOrTrigraph & i: NumericValueExpression & RightBracketOrTrigraph => @(new Towers.Step(Towers.Subscript, new Expression.Element(null!, i.Node, null, l == "??(")))

// Not a production: what a non-parenthesized primary begins with. A name followed by arguments is
// a routine's, and a name followed by a method call stops before the method: `a.b.c.d(1)` is
// `a.b.c` and a method `d`.
PrimaryBase : @Towers.Typed
	= literal: UnsignedLiteral => @(new Towers.Typed(new Expression.Literal(literal), Towers.Value | Towers.Truth | Towers.Bare))
	| "ROW"i & '(' & first: ValueNode & (',' & rest: ValueNode)* & ')' => @(new Towers.Typed(new Expression.Row(Nodes.List(first, rest), true), Towers.Row))
	| v: GeneralValueSpecification => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: CaseExpression => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: CastSpecification => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: NextValueExpression => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: SubtypeTreatment => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: NewSpecification => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: ReferenceResolution => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: CollectionValueConstructor => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: MultisetElementReference => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: GreatestOrLeastFunction => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| v: StaticMethodInvocation => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare))
	| WindowedFunction => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Value | Towers.Truth | Towers.Bare))
	| JSONValueFunction => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Value | Towers.Truth | Towers.Bare))
	| JSONQuery => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Value | Towers.Truth | Towers.Bare))
	| JSONObjectConstructor => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Value | Towers.Truth | Towers.Bare))
	| JSONArrayConstructor => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Value | Towers.Truth | Towers.Bare))
	| RowPatternNavigationOperation => @(new Towers.Typed(Nodes.Unbuilt(), Towers.Value | Towers.Truth | Towers.Bare))
	| v: RoutineInvocation => @(new Towers.Typed(v, Towers.Value | Towers.Truth | Towers.Bare | Towers.Invoked))
	| m: "MODULE"i & '.' & q: QualifiedIdentifier & '.' & c: ColumnName => @(new Towers.Typed(new Expression.Reference(Nodes.Named(m, q, c)), Towers.Value | Towers.Truth | Towers.Bare))
	| i: Identifier & chained: ChainOrMeasure => @(Nodes.ChainOrMeasure(i, chained))

// After a name: the rest of an identifier chain, or `OVER` and a window, which makes the name a
// <window row pattern measure>'s.
ChainOrMeasure : @Towers.Chained = WindowOver => @(new Towers.Chained(true, null))
                                 | ('.' & rest: Identifier & ?!'(')* => @(new Towers.Chained(false, rest))

// <general value specification>, but an SQL parameter reference, which is an identifier chain and
// read as one; <embedded variable specification> is left to a host language.
GeneralValueSpecification : @Expression
	= ':' & n: Identifier & (k: "INDICATOR"i? & ':' & i: Identifier)? => @(Nodes.HostParameter(n, i, k is not null))
	| '?' => @(new Expression.Parameter(ParameterKind.Dynamic))
	| "COLLATION"i & "FOR"i & '(' & v: StringValueExpression & ')' => @(new Expression.CollationFor(v.Node))
	| "CURRENT_TRANSFORM_GROUP_FOR_TYPE"i & t: PathResolvedUserDefinedTypeName => @(new Expression.Current(CurrentValue.TransformGroupForType, t))
	| w: ("CURRENT_CATALOG"i | "CURRENT_DEFAULT_TRANSFORM_GROUP"i | "CURRENT_PATH"i | "CURRENT_ROLE"i
	  | "CURRENT_SCHEMA"i | "CURRENT_USER"i | "SESSION_USER"i | "SYSTEM_USER"i | "USER"i | "VALUE"i) => @(Nodes.Current(w))

// <case expression>.
CaseExpression : @Expression
	= w: "NULLIF"i & '(' & a: ValueNode & ',' & b: ValueNode & ')' => @(Nodes.Invoked(w, a, [b]))
	| w: "COALESCE"i & '(' & first: ValueNode & (',' & rest: ValueNode)+ & ')' => @(Nodes.Invoked(w, first, rest))
	| "CASE"i & o: RowValuePredicand & { (trivia & whens: SimpleWhenClause)+ } & e: ElseClause? & "END"i => @(new Expression.Case(o.Node, whens, e))
	| "CASE"i & { (trivia & whens: SearchedWhenClause)+ } & e: ElseClause? & "END"i => @(new Expression.Case(null, whens, e))

SimpleWhenClause   : @CaseWhen = "WHEN"i & first: WhenOperand & (',' & rest: WhenOperand)* & "THEN"i & r: Result => @(new CaseWhen(Nodes.List(first, rest), r))
SearchedWhenClause : @CaseWhen = "WHEN"i & c: SearchCondition & "THEN"i & r: Result => @(new CaseWhen(Nodes.List(c.Node, null), r))
ElseClause         : @Expression = "ELSE"i & r: Result => @(r)
Result             : @Expression = v: ValueNode => @(v)
                                 | "NULL"i => @(Nodes.Null())

// <when operand>: a row value predicand, or a predicate's second part with nothing before it — any
// but a JSON predicate's and a period predicate's — whose missing left side is the case operand.
WhenOperand : @Expression = p: PredicatePart2 & when @(Towers.RolesOf(p) == Towers.Any) => @(Nodes.Predicated(new Expression.CaseOperand(), p.Node!))
                          | r: RowValuePredicand => @(r.Node)

// <cast specification>. A domain's name is a user-defined type's in shape, and <data type> reads it.
CastSpecification : @Expression = "CAST"i & '(' & v: CastOperand & "AS"i & t: DataType & ("FORMAT"i & f: CharacterStringLiteral)? & ')' => @(new Expression.Cast(v, t, f))
CastOperand       : @Expression = v: ValueNode => @(v)
                                | v: ImplicitlyTypedValueSpecification => @(v)

ImplicitlyTypedValueSpecification   : @Expression = "NULL"i => @(Nodes.Null())
                                                  | w: ("ARRAY"i | "MULTISET"i) & l: LeftBracketOrTrigraph & RightBracketOrTrigraph => @(Nodes.Collection(w, l, null, null))
ContextuallyTypedValueSpecification : @Expression = v: ImplicitlyTypedValueSpecification => @(v)
                                                  | "DEFAULT"i => @(new Expression.Default())

NextValueExpression      : @Expression = "NEXT"i & "VALUE"i & "FOR"i & n: SchemaQualifiedName => @(new Expression.NextValue(n))
SubtypeTreatment         : @Expression = "TREAT"i & '(' & v: ValueNode & "AS"i & t: TargetSubtype & ')' => @(new Expression.Treat(v, t))
TargetSubtype            : @DataType = r: ReferenceType => @(r)
                                     | n: PathResolvedUserDefinedTypeName => @(new DataType.UserDefined(n))
NewSpecification         : @Expression = "NEW"i & n: PathResolvedUserDefinedTypeName & a: SQLArgumentList => @(new Expression.New(n, a))
ReferenceResolution      : @Expression = "DEREF"i & '(' & v: ValueExpressionPrimary & ')' => @(new Expression.Dereference(v.Node))
MultisetElementReference : @Expression = w: "ELEMENT"i & '(' & v: MultisetValueExpression & ')' => @(Nodes.Invoked(w, v.Node, null))
GreatestOrLeastFunction  : @Expression = w: ("GREATEST"i | "LEAST"i) & '(' & first: ValueNode & (',' & rest: ValueNode)+ & ')' => @(Nodes.Invoked(w, first, rest))
StaticMethodInvocation   : @Expression = t: PathResolvedUserDefinedTypeName & "::" & m: MethodName & a: SQLArgumentList? => @(new Expression.Member(new Expression.Reference(t), MemberAccessKind.StaticMethod, m, a))
RoutineInvocation        : @Expression = n: RoutineName & a: SQLArgumentList => @(new Expression.Invocation(n, a))

// <collection value constructor>: by enumeration, and by query — `TABLE (…)` is a multiset's.
CollectionValueConstructor : @Expression
	= w: ("ARRAY"i | "MULTISET"i) & l: LeftBracketOrTrigraph & first: ValueNode & (',' & rest: ValueNode)* & RightBracketOrTrigraph => @(Nodes.Collection(w, l, first, rest))
	| w: ("ARRAY"i | "MULTISET"i | "TABLE"i) & TableSubquery => @(new Expression.CollectionQuery(Nodes.CollectionKindOf(w), Nodes.UnbuiltQuery()))

// <SQL argument list>, but table and descriptor arguments. A named argument is asked first, since
// its name would otherwise be read as a value.
SQLArgumentList : @IReadOnlyList<Argument> = '(' & { first: SQLArgument & (',' & rest: SQLArgument)* }? & ')' => @(Nodes.Arguments(first, rest))
SQLArgument : @Argument
	= n: Identifier & "=>" & v: ArgumentValue => @(new Argument(v, n, true))
	| v: ValueNode & ("AS"i & t: PathResolvedUserDefinedTypeName)? => @(new Argument(t is null ? v : new Expression.Generalized(v, new DataType.UserDefined(t))))
	| v: ContextuallyTypedValueSpecification => @(new Argument(v))
ArgumentValue : @Expression = v: ValueNode => @(v)
                            | v: ContextuallyTypedValueSpecification => @(v)

// ── §6.30–6.36 Value functions ──────────────────────────────────────────────

// Not a production: a function of some tower, and the tower it is of. `ABS` is a number's and an
// interval's both.
ValueFunction : @int
	= NumericValueFunction => @(Towers.Numeric)
	| a: AbsoluteValue => @(a)
	| StringValueFunction => @(Towers.String)
	| DatetimeValueFunction => @(Towers.Datetime)
	| "TRIM_ARRAY"i & '(' & ArrayValueExpression & ',' & NumericValueExpression & ')' => @(Towers.Array)
	| "SET"i & '(' & MultisetValueExpression & ')' => @(Towers.Multiset)
	| JSONTypedValueFunction => @(Towers.Json)

// <absolute value expression>, <interval absolute value function>.
AbsoluteValue : @int = "ABS"i & '(' & e: CommonValueExpression & ')' & when @((Towers.RolesOf(e) & (Towers.Numeric | Towers.Interval)) != 0) => @(e.Roles & (Towers.Numeric | Towers.Interval))

// <numeric value function>, but `ABS`.
NumericValueFunction
	= PositionExpression
	| "OCCURRENCES_REGEX"i & '(' & RegexSearch & ')'
	| "POSITION_REGEX"i & '(' & ("START"i | "AFTER"i)? & RegexSearch & ("OCCURRENCE"i & NumericValueExpression)? & ("GROUP"i & NumericValueExpression)? & ')'
	| ExtractExpression
	| ("CHAR_LENGTH"i | "CHARACTER_LENGTH"i) & '(' & CharacterValueExpression & ("USING"i & CharLengthUnits)? & ')'
	| "OCTET_LENGTH"i & '(' & StringValueExpression & ')'
	| "CARDINALITY"i & '(' & CollectionValueExpression & ')'
	| "ARRAY_MAX_CARDINALITY"i & '(' & ArrayValueExpression & ')'
	| ("MOD"i | "LOG"i | "POWER"i) & '(' & NumericValueExpression & ',' & NumericValueExpression & ')'
	| ("SIN"i | "COS"i | "TAN"i | "SINH"i | "COSH"i | "TANH"i | "ASIN"i | "ACOS"i | "ATAN"i
	  | "LOG10"i | "LN"i | "EXP"i | "SQRT"i | "FLOOR"i | "CEIL"i | "CEILING"i) & '(' & NumericValueExpression & ')'
	| "WIDTH_BUCKET"i & '(' & NumericValueExpression & ',' & NumericValueExpression & ',' & NumericValueExpression & ',' & NumericValueExpression & ')'
	| "MATCH_NUMBER"i & '(' & ')'

// <character position expression>, <binary position expression>.
PositionExpression : @bool = "POSITION"i & '(' & a: StringValueExpression & "IN"i & b: StringValueExpression & u: UsingUnits & ')' & when @(Towers.Characters(Towers.RolesOf(a) & Towers.RolesOf(b), u == true)) => @(true)

// What the regular expression functions share: a pattern, its flags, the string searched, and where.
RegexSearch = CharacterValueExpression & ("FLAG"i & CharacterValueExpression)? & "IN"i & CharacterValueExpression & ("FROM"i & NumericValueExpression)? & ("USING"i & CharLengthUnits)?

// <extract expression>: a datetime's field, or an interval's.
ExtractExpression : @bool = "EXTRACT"i & '(' & ExtractField & "FROM"i & e: CommonValueExpression & ')' & when @((Towers.RolesOf(e) & (Towers.Datetime | Towers.Interval)) != 0) => @(true)
ExtractField      = NonSecondPrimaryDatetimeField | "SECOND"i | "TIMEZONE_HOUR"i | "TIMEZONE_MINUTE"i

UsingUnits : @bool = "USING"i & CharLengthUnits => @(true)
                   | none => @(false)

// <string value function>, but <specific type method>, which follows a primary (`Primary`).
StringValueFunction
	= SubstringFunction
	| JSONSerialize
	| "SUBSTRING_REGEX"i & '(' & RegexSearch & ("OCCURRENCE"i & NumericValueExpression)? & ("GROUP"i & NumericValueExpression)? & ')'
	| ("UPPER"i | "LOWER"i) & '(' & CharacterValueExpression & ')'
	| ("CONVERT"i | "TRANSLATE"i) & '(' & CharacterValueExpression & "USING"i & SchemaQualifiedName & ')'
	| "TRANSLATE_REGEX"i & '(' & CharacterValueExpression & ("FLAG"i & CharacterValueExpression)? & "IN"i & CharacterValueExpression
	  & ("WITH"i & CharacterValueExpression)? & ("FROM"i & NumericValueExpression)? & ("USING"i & CharLengthUnits)?
	  & ("OCCURRENCE"i & (NumericValueExpression | "ALL"i))? & ')'
	| ("LPAD"i | "RPAD"i) & '(' & CharacterValueExpression & ',' & NumericValueExpression & (',' & CharacterValueExpression)? & ')'
	| TrimFunction
	| ("BTRIM"i | "LTRIM"i | "RTRIM"i) & '(' & CharacterValueExpression & (',' & CharacterValueExpression)? & ')'
	| OverlayFunction
	| "NORMALIZE"i & '(' & CharacterValueExpression & (',' & NormalForm & (',' & CharacterLargeObjectLength)?)? & ')'
	| "CLASSIFIER"i & '(' & Identifier? & ')'

// <character substring function>, <binary substring function>, <regular expression substring
// function>. All three begin with the string, which is read once and what follows it says which: the
// last is a character string's alone.
SubstringFunction : @bool = "SUBSTRING"i & '(' & s: StringValueExpression & t: SubstringTail & ')' & when @(t == 2 ? (Towers.RolesOf(s) & Towers.Character) != 0 : Towers.Characters(Towers.RolesOf(s), t == 1)) => @(true)

// 1 where a length unit is named, 2 for `SIMILAR`.
SubstringTail : @int
	= "FROM"i & NumericValueExpression & ("FOR"i & NumericValueExpression)? & u: UsingUnits => @(u == true ? 1 : 0)
	| "SIMILAR"i & CharacterValueExpression & "ESCAPE"i & CharacterValueExpression => @(2)

// <single-character trim function>, <binary trim function>: what is trimmed, and from what, of one kind.
TrimFunction : @bool = "TRIM"i & '(' & t: TrimOperands & ')' & when @((t & Towers.String) != 0) => @(true)
//
// <trim operands> is `[ [ spec ] [ character ] FROM ] source`. What the operands begin with is read
// once: a specification, `FROM`, or a string that is the source or, with `FROM` after it, the
// character trimmed.
TrimOperands : @int
	= TrimSpecification & t: TrimAfterSpecification => @(t)
	| "FROM"i & s: StringValueExpression => @(s.Roles)
	| c: StringValueExpression & f: TrimFrom => @(f == 0 ? c.Roles : c.Roles & f)

TrimAfterSpecification : @int
	= "FROM"i & s: StringValueExpression => @(s.Roles)
	| c: StringValueExpression & "FROM"i & s: StringValueExpression => @(c.Roles & s.Roles)

TrimFrom : @int = "FROM"i & s: StringValueExpression => @(s.Roles)
                | none => @(0)
TrimSpecification = "LEADING"i | "TRAILING"i | "BOTH"i

// <character overlay function>, <binary overlay function>.
OverlayFunction : @bool = "OVERLAY"i & '(' & a: StringValueExpression & "PLACING"i & b: StringValueExpression & "FROM"i & NumericValueExpression & ("FOR"i & NumericValueExpression)? & u: UsingUnits & ')' & when @(Towers.Characters(Towers.RolesOf(a) & Towers.RolesOf(b), u == true)) => @(true)

// <datetime value function>.
DatetimeValueFunction
	= "CURRENT_DATE"i
	| ("CURRENT_TIMESTAMP"i | "CURRENT_TIME"i | "LOCALTIMESTAMP"i | "LOCALTIME"i) & ('(' & UnsignedInteger & ')')?

// ── §6.10 Window function, §6.11 Nested window function, §10.9 Aggregate function ──

// <set function specification>, <window function>, <nested window function>. A window function's
// type may be an aggregate, so an aggregate is read once, with `OVER` after it or not; `RUNNING` and
// `FINAL` stand before one only where it is not a window's.
WindowedFunction
	= ("RUNNING"i | "FINAL"i) & AggregateFunction
	| AggregateFunction & WindowOver?
	| "GROUPING"i & '(' & ColumnReference & (',' & ColumnReference)* & ')'
	| ("RANK"i | "DENSE_RANK"i | "PERCENT_RANK"i | "CUME_DIST"i | "ROW_NUMBER"i) & '(' & ')' & WindowOver
	| "NTILE"i & '(' & SimpleOrDynamicValue & ')' & WindowOver
	| ("LEAD"i | "LAG"i) & '(' & ValueExpression & (',' & UnsignedInteger & (',' & ValueExpression)?)? & ')' & NullTreatment? & WindowOver
	| ("FIRST_VALUE"i | "LAST_VALUE"i) & '(' & ValueExpression & ')' & NullTreatment? & WindowOver
	| "NTH_VALUE"i & '(' & ValueExpression & ',' & SimpleOrDynamicValue & ')' & ("FROM"i & ("FIRST"i | "LAST"i))? & NullTreatment? & WindowOver
	| "ROW_NUMBER"i & '(' & RowMarker & ')'
	| "VALUE_OF"i & '(' & ValueExpression & "AT"i & RowMarker & (['+' | '-'] & SimpleOrDynamicValue)? & (',' & ValueExpression)? & ')'

// <window name or specification>, after `OVER`.
WindowOver    = "OVER"i & (WindowName | WindowSpecification)
NullTreatment = ("RESPECT"i | "IGNORE"i) & "NULLS"i
RowMarker     = "BEGIN_PARTITION"i | "BEGIN_FRAME"i | "CURRENT_ROW"i | "FRAME_ROW"i | "END_FRAME"i | "END_PARTITION"i

// What <number of tiles>, <nth row>, <row marker offset> and a row pattern navigation's offsets are:
// a simple value specification, or a dynamic parameter.
SimpleOrDynamicValue = SimpleValueSpecification | '?'

// <aggregate function>. A <row pattern count function>, `COUNT(v.*)`, is `COUNT` of a value too, whose
// `v.*` is a JSON accessor, with the same verdict; written apart, a refused line read each twice.
AggregateFunction = AggregateCall & ("FILTER"i & '(' & "WHERE"i & SearchCondition & ')')?

AggregateCall
	= "COUNT"i & '(' & '*' & ')'
	| JSONAggregateFunction
	| ComputationalOperation & '(' & SetQuantifier? & ValueExpression & ')'
	| BinarySetFunctionType & '(' & NumericValueExpression & ',' & NumericValueExpression & ')'
	| ("RANK"i | "DENSE_RANK"i | "PERCENT_RANK"i | "CUME_DIST"i) & '(' & ValueExpression & (',' & ValueExpression)* & ')' & WithinGroupSpecification
	| ("PERCENTILE_CONT"i | "PERCENTILE_DISC"i) & '(' & NumericValueExpression & ')' & WithinGroupSpecification
	| "ARRAY_AGG"i & '(' & ValueExpression & ("ORDER"i & "BY"i & SortSpecificationList)? & ')'
	| "LISTAGG"i & '(' & SetQuantifier? & CharacterValueExpression & ',' & CharacterStringLiteral & ListaggOverflowClause? & ')' & WithinGroupSpecification

ComputationalOperation
	= "AVG"i | "MAX"i | "MIN"i | "SUM"i | "EVERY"i | "ANY_VALUE"i | "ANY"i | "SOME"i | "COUNT"i
	| "STDDEV_POP"i | "STDDEV_SAMP"i | "VAR_SAMP"i | "VAR_POP"i | "COLLECT"i | "FUSION"i | "INTERSECTION"i

BinarySetFunctionType
	= "COVAR_POP"i | "COVAR_SAMP"i | "CORR"i | "REGR_SLOPE"i | "REGR_INTERCEPT"i | "REGR_COUNT"i
	| "REGR_R2"i | "REGR_AVGX"i | "REGR_AVGY"i | "REGR_SXX"i | "REGR_SYY"i | "REGR_SXY"i

WithinGroupSpecification = "WITHIN"i & "GROUP"i & '(' & "ORDER"i & "BY"i & SortSpecificationList & ')'
ListaggOverflowClause    = "ON"i & "OVERFLOW"i & ("ERROR"i | "TRUNCATE"i & CharacterStringLiteral? & ("WITH"i | "WITHOUT"i) & "COUNT"i)

// ── §6.26 Row pattern navigation operation ──────────────────────────────────

// <row pattern navigation operation>. `FIRST`, `LAST`, `PREV` and `NEXT` are not reserved, and a
// navigation without `RUNNING` or `FINAL` is a routine's invocation in shape — `PREV(a, 1)`,
// `FIRST(A.x)` — which a routine invocation reads, with the same verdict. What only a navigation is
// begins with one of those words; a compound one, `PREV(RUNNING FIRST(a, 1), 2)`, is a routine's
// invocation too, whose first argument is such a navigation. Asked as a navigation first and a
// routine after, every argument was read twice, and a line refused inside nested navigations cost a
// power of their depth.
RowPatternNavigationOperation = ("RUNNING"i | "FINAL"i) & ("FIRST"i | "LAST"i) & '(' & ValueExpression & (',' & SimpleOrDynamicValue)? & ')'

// ── §6.33 JSON value function, §6.37 JSON value constructor, §6.38 JSON query ──
//
// What the BNF spells, and only that: a path is a <character string literal>, which the functions
// take whole. Inside the simplified accessor the path language is read where the SQL tokens reach —
// its literals, identifiers and key names are left to the Syntax Rules (`!! See the Syntax Rules.`)
// and read as nothing, here as in `--standard`; so `a[$ to last]` is read and `a[1 to last]` is not.

// <JSON value function>. What happens on an empty result is said before what happens on an error.
JSONValueFunction = "JSON_VALUE"i & '(' & JSONAPICommonSyntax & ("RETURNING"i & DataType)?
	  & (JSONValueBehavior & "ON"i & "EMPTY"i)? & (JSONValueBehavior & "ON"i & "ERROR"i)? & ')'
JSONValueBehavior = "ERROR"i | "NULL"i | "DEFAULT"i & ValueExpression

// <JSON query>.
JSONQuery = "JSON_QUERY"i & '(' & JSONAPICommonSyntax & JSONOutputClause? & (JSONQueryWrapperBehavior & "WRAPPER"i)?
	  & (("KEEP"i | "OMIT"i) & "QUOTES"i & ("ON"i & "SCALAR"i & "STRING"i)?)?
	  & (JSONQueryBehavior & "ON"i & "EMPTY"i)? & (JSONQueryBehavior & "ON"i & "ERROR"i)? & ')'
JSONQueryWrapperBehavior = "WITHOUT"i & "ARRAY"i? | "WITH"i & ("CONDITIONAL"i | "UNCONDITIONAL"i)? & "ARRAY"i?
JSONQueryBehavior        = "ERROR"i | "NULL"i | "EMPTY"i & ("ARRAY"i | "OBJECT"i)

// <JSON API common syntax>: a context item, a path, the path's name, and what the path is passed.
JSONAPICommonSyntax = JSONInputExpression & ',' & CharacterStringLiteral & ("AS"i & Identifier)?
	  & ("PASSING"i & JSONInputExpression & "AS"i & Identifier & (',' & JSONInputExpression & "AS"i & Identifier)*)?
JSONInputExpression = ValueExpression & JSONInputClause?
JSONOutputClause    = "RETURNING"i & DataType & ("FORMAT"i & JSONRepresentation)?

// <JSON object constructor>. A name and a value are `KEY name VALUE value`, `name VALUE value` or
// `name : value`; what follows the name says which, and the name is read once.
JSONObjectConstructor = "JSON_OBJECT"i & '(' & (JSONNameAndValue & (',' & JSONNameAndValue)* & JSONConstructorNullClause? & JSONKeyUniquenessConstraint?)? & JSONOutputClause? & ')'
JSONNameAndValue
	= "KEY"i & CharacterValueExpression & "VALUE"i & JSONInputExpression
	| CharacterValueExpression & ("VALUE"i | ':') & JSONInputExpression
JSONConstructorNullClause = ("NULL"i | "ABSENT"i) & "ON"i & "NULL"i

// <JSON array constructor>, by enumeration and by query. A query begins with a key word a value
// expression does not, or with a bracket, where the enumeration is asked first.
JSONArrayConstructor
	= "JSON_ARRAY"i & '(' & (JSONInputExpression & (',' & JSONInputExpression)* & JSONConstructorNullClause?)? & JSONOutputClause? & ')'
	| "JSON_ARRAY"i & '(' & QueryExpression & JSONInputClause? & JSONConstructorNullClause? & JSONOutputClause? & ')'

// <JSON exists predicate>.
JSONExistsPredicate = "JSON_EXISTS"i & '(' & JSONAPICommonSyntax & (("TRUE"i | "FALSE"i | "UNKNOWN"i | "ERROR"i) & "ON"i & "ERROR"i)? & ')'

// <JSON typed value function>: <JSON parse> and <JSON scalar>, each a <JSON primary> and nothing else
// — no concatenation takes one, which `Towers.Json` alone says.
JSONTypedValueFunction
	= "JSON"i & '(' & StringValueExpression & JSONInputClause? & JSONKeyUniquenessConstraint? & ')'
	| "JSON_SCALAR"i & '(' & ValueExpression & ')'

// <JSON serialize>, of a <JSON value expression>: a value expression primary or a typed value function.
JSONSerialize        = "JSON_SERIALIZE"i & '(' & JSONValueExpression & JSONOutputClause? & ')'
JSONValueExpression : @Towers.Typed = e: CommonValueExpression & when @((Towers.RolesOf(e) & Towers.Json) != 0) => @(e)

// <JSON array aggregate constructor>, <JSON object aggregate constructor>.
JSONAggregateFunction
	= "JSON_ARRAYAGG"i & '(' & JSONInputExpression & ("ORDER"i & "BY"i & SortSpecificationList)? & JSONConstructorNullClause? & JSONOutputClause? & ')'
	| "JSON_OBJECTAGG"i & '(' & JSONNameAndValue & JSONConstructorNullClause? & JSONKeyUniquenessConstraint? & JSONOutputClause? & ')'

// ── §6.39 JSON simplified accessor, as far as the SQL tokens reach ──────────
//
// Its operations are steps after a value expression primary (`PrimaryStep`), beside a field
// reference's and an array element's: `.*`, `[*]`, subscripts in the path language, and an item
// method, whose names are mostly reserved words of SQL and so no method's names: `a.decimal(1, 2)`.

// <JSON method>. A datetime's template is a path string literal, which the Syntax Rules keep.
JSONMethod : @Expression
	= w: ("TYPE"i | "SIZE"i | "DOUBLE"i | "CEILING"i | "FLOOR"i | "ABS"i | "KEYVALUE"i | "BIGINT"i | "BOOLEAN"i
	  | "DATETIME"i | "DATE"i | "INTEGER"i | "NUMBER"i | "STRING"i) & '(' & ')' => @(Nodes.Method(w, null, null))
	| w: "DECIMAL"i & '(' & (p: UnsignedInteger & (',' & s: UnsignedInteger)?)? & ')' => @(Nodes.Method(w, p, s))
	| w: ("TIMESTAMP_TZ"i | "TIMESTAMP"i | "TIME_TZ"i | "TIME"i) & '(' & p: UnsignedInteger? & ')' => @(Nodes.Method(w, p, null))

// <JSON subscript>, <JSON path wff>: the path language's arithmetic over its primaries.
JSONSubscript          = JSONPathWff & ("TO"i & JSONPathWff)?
JSONPathWff            = JSONPathMultiplicative & (['+' | '-'] & JSONPathMultiplicative)*
JSONPathMultiplicative = JSONPathUnary & (['*' | '/' | '%'] & JSONPathUnary)*
JSONPathUnary          = (trivia & ['+' | '-'])* & JSONPathAccessor
JSONPathAccessor       = JSONPathPrimary & (trivia & JSONPathAccessorOp)*

// <JSON path primary>: the context variable, `last`, or a wff in brackets. A named variable is `$` and
// a path identifier, and `@` is no SQL token.
JSONPathPrimary = '$' | "LAST"i | '(' & JSONPathWff & ')'

// <JSON accessor op>: those of the simplified accessor, and a filter; a member's name is a key name.
JSONPathAccessorOp
	= '.' & '*'
	| '[' & '*' & ']'
	| '[' & JSONSubscript & (',' & JSONSubscript)* & ']'
	| '?' & '(' & JSONPathPredicate & ')'
	| '.' & JSONMethod

// <JSON path predicate>. `&&`, `!`, `==` and `!=` are no SQL tokens — `!` is no SQL character at all
// (§5.1) — so a conjunction of two, a negation and those comparisons are never read; `||` is the
// concatenation operator's token, and a disjunction is. `like_regex` and `starts with` need a path
// string literal.
JSONPathPredicate = JSONPredicatePrimary & ("||" & JSONPredicatePrimary)*
JSONPredicatePrimary
	= "EXISTS"i & '(' & JSONPathWff & ')'
	| '(' & JSONPathPredicate & ')' & ("IS"i & "UNKNOWN"i)?
	| JSONPathWff & ("<>" | "<=" | ">=" | '<' | '>') & JSONPathWff

// ── §7.11 JSON table ─────────────────────────────────────────────────────────

JSONTable = "JSON_TABLE"i & '(' & JSONAPICommonSyntax & JSONTableColumnsClause & JSONTablePlanClause? & (("ERROR"i | "EMPTY"i) & "ON"i & "ERROR"i)? & ')'
JSONTablePrimitive = "JSON_TABLE_PRIMITIVE"i & '(' & JSONAPICommonSyntax & "COLUMNS"i & '(' & JSONTablePrimitiveColumn & (',' & JSONTablePrimitiveColumn)* & ')' & ("ERROR"i | "EMPTY"i) & "ON"i & "ERROR"i & ')'

JSONTableColumnsClause = "COLUMNS"i & '(' & JSONTableColumnDefinition & (',' & JSONTableColumnDefinition)* & ')'

JSONTableColumnDefinition
	= "NESTED"i & "PATH"i? & CharacterStringLiteral & ("AS"i & Identifier)? & JSONTableColumnsClause
	| ColumnName & "FOR"i & "ORDINALITY"i
	| JSONTableTypedColumn

JSONTablePrimitiveColumn
	= ColumnName & "FOR"i & ("ORDINALITY"i | "CHAINING"i)
	| JSONTableTypedColumn

// <JSON table regular column definition>, <JSON table formatted column definition>. Both are a name,
// a type, a path and what happens on empty and on error, and neither needs to say which it is; read
// once, a guard refuses what only a regular one has (`DEFAULT … ON`, 1) beside what only a formatted
// one has (`FORMAT`, a wrapper, quotes, `EMPTY ARRAY` or `EMPTY OBJECT`, 2).
JSONTableTypedColumn : @bool = ColumnName & DataType & f: JSONColumnFormat & ("PATH"i & CharacterStringLiteral)? & w: JSONColumnWrapper & e: JSONColumnOnEmpty & r: JSONColumnOnError & when @((f | w | e | r) != 3) => @(true)

JSONColumnFormat  : @int = "FORMAT"i & JSONRepresentation => @(2)
                         | none => @(0)
JSONColumnWrapper : @int = JSONQueryWrapperBehavior & "WRAPPER"i & JSONColumnQuotes => @(2)
                         | q: JSONColumnQuotes => @(q)
JSONColumnQuotes  : @int = ("KEEP"i | "OMIT"i) & "QUOTES"i & ("ON"i & "SCALAR"i & "STRING"i)? => @(2)
                         | none => @(0)
JSONColumnOnEmpty : @int = b: JSONColumnBehavior & "ON"i & "EMPTY"i => @(b)
                         | none => @(0)
JSONColumnOnError : @int = b: JSONColumnBehavior & "ON"i & "ERROR"i => @(b)
                         | none => @(0)
JSONColumnBehavior : @int
	= "ERROR"i => @(0)
	| "NULL"i => @(0)
	| "DEFAULT"i & ValueExpression => @(1)
	| "EMPTY"i & ("ARRAY"i | "OBJECT"i) => @(2)

// <JSON table plan clause>. A plan is a path's name, a parent and child, or siblings; each begins with
// a plan primary, which is read once and what follows it says which. A parent is a name, and a plan
// in brackets alone is no plan.
JSONTablePlanClause
	= "PLAN"i & '(' & JSONTablePlan & ')'
	| "PLAN"i & "DEFAULT"i & '(' & (("INNER"i | "OUTER"i) & (',' & ("UNION"i | "CROSS"i))? | ("UNION"i | "CROSS"i) & (',' & ("INNER"i | "OUTER"i))?) & ')'

JSONTablePlan : @bool = p: JSONTablePlanPrimary & t: JSONTablePlanTail & when @(t == 2 || p == true) => @(true)

JSONTablePlanPrimary : @bool = Identifier => @(true)
                             | '(' & JSONTablePlan & ')' => @(false)

JSONTablePlanTail : @int
	= ("OUTER"i | "INNER"i) & JSONTablePlanPrimary => @(1)
	| ("UNION"i & JSONTablePlanPrimary)+ => @(2)
	| ("CROSS"i & JSONTablePlanPrimary)+ => @(2)
	| none => @(0)

// ── §7.2 Row value expression list, §7.3 Table value constructor ────────────

// <table value constructor>. A <table row value expression> is a row value special case or a row
// value constructor — a common, a boolean or an explicit row value — and a value expression is
// each of those.
TableValueConstructor = "VALUES"i & { ValueExpression & (',' & ValueExpression)* }

// ── §7.4 Table expression, §7.5 From clause ─────────────────────────────────

TableExpression = FromClause & WhereClause? & GroupByClause? & HavingClause? & WindowClause?
FromClause      = "FROM"i & { TableReference & (',' & TableReference)* }

// ── §7.6 Table reference, §7.10 Joined table ────────────────────────────────

// <table reference>, <joined table>. A join begins with a table reference, which is left recursion
// through other productions, so the joins are steps after the first table factor, as many as there
// are. A partitioned join table stands on the left of a qualified or a natural join, and is a table
// factor with `PARTITION BY` after it; it is read as a factor and its partitioning, and not tried
// as a whole and then again without, which would read a derived table twice at every depth.
TableReference = TableFactor & Joins

// Whether any join follows.
Joins : @bool
	= JoinPartitioning & PartitionedJoin & (trivia & JoinStep)* => @(true)
	| { (trivia & JoinStep)+ } => @(true)
	| none => @(false)

JoinStep
	= "CROSS"i & "JOIN"i & TableFactor
	| PartitionedJoin

// Not a production: a <qualified join> or a <natural join>, from `JOIN` on — what a partitioned join
// table may stand before.
PartitionedJoin
	= "NATURAL"i & JoinType? & "JOIN"i & TableFactor & JoinPartitioning?
	| JoinType? & "JOIN"i & JoinOperand & JoinSpecification

// A qualified join's right side: a table reference, or a partitioned join table. It is read as far
// as it goes: a join specification must follow it, and one a join inside it took could not have been
// the outer join's, since that join would then have none.
JoinOperand = TableFactor & (JoinPartitioning & (PartitionedJoin & (trivia & JoinStep)*)? | (trivia & JoinStep)*)

// <partitioned join table>'s partitioning.
JoinPartitioning = "PARTITION"i & "BY"i & '(' & ColumnReference & (',' & ColumnReference)* & ')'

JoinType = "INNER"i | ("LEFT"i | "RIGHT"i | "FULL"i) & "OUTER"i?

JoinSpecification
	= "ON"i & SearchCondition
	| "USING"i & '(' & ColumnNameList & ')' & ("AS"i & CorrelationName)?

// <table factor>: whether it is a parenthesized joined table, which a sample clause after it ends.
TableFactor : @bool = p: TablePrimary & s: Sampled => @(p && !s)
Sampled     : @bool = SampleClause => @(true)
                    | none => @(false)

SampleClause = "TABLESAMPLE"i & ("BERNOULLI"i | "SYSTEM"i) & '(' & NumericValueExpression & ')' & ("REPEATABLE"i & '(' & NumericValueExpression & ')')?

// <table primary>: whether it is a parenthesized joined table. `TABLE (f(x))` is a collection's and
// then a correlation name must follow, or a polymorphic table function's and one need not: the
// expression is read once, and a routine's invocation alone (`Towers.Invoked`) is the latter. A JSON
// table primitive takes a correlation name and nothing else. A <data change delta table> is asked
// first: `FINAL` is not reserved, and would be taken for a table's name.
TablePrimary : @bool
	= DataChangeDeltaTable & CorrelationOrRecognition? => @(false)
	| TableOrQueryName & QuerySystemTimePeriodSpecification? & CorrelationOrRecognition? => @(false)
	| "LATERAL"i & TableSubquery & CorrelationOrRecognition => @(false)
	| "UNNEST"i & '(' & CollectionValueExpression & (',' & CollectionValueExpression)* & ')' & ("WITH"i & "ORDINALITY"i)? & CorrelationOrRecognition => @(false)
	| "TABLE"i & '(' & e: CollectionValueExpression & ')' & c: Correlated & r: Recognized & when @(c == true || r == true || (Towers.RolesOf(e) & Towers.Invoked) != 0) => @(false)
	| "ONLY"i & '(' & TableOrQueryName & ')' & CorrelationOrRecognition? => @(false)
	| TableSubquery & CorrelationOrRecognition => @(false)
	| JSONTable & CorrelationOrRecognition => @(false)
	| JSONTablePrimitive & CorrelationName => @(false)
	| ParenthesizedJoinedTable => @(true)

// <parenthesized joined table>: a joined table in brackets, or one such in brackets again. Both
// begin with a table factor, which is read once.
ParenthesizedJoinedTable : @bool = '(' & f: TableFactor & j: Joins & ')' & when @(f || j) => @(true)

// <correlation or recognition>: a correlation name, or a row pattern recognition clause with the
// input's name before it, the output's after it, both or neither. Both begin with a name where they
// have one, so a name is read and then a clause: `t s (c) MATCH_RECOGNIZE (…)` would otherwise be
// read as a correlation and leave the clause behind.
CorrelationOrRecognition : @bool = c: Correlated & r: Recognized & when @(c || r) => @(true)

// A query's lists give nothing back once read, and a correlation name is a word that is not reserved:
// in `JSON_ARRAY(SELECT a FROM t FORMAT JSON)` the last table would be called `FORMAT`, and the JSON
// constructor's own words left unread. So a name is not taken where one of those goes on after it —
// no table's name could stand there either.
Correlated : @bool = ?!("FORMAT"i & "JSON"i | "RETURNING"i & DataType | "ABSENT"i & "ON"i & "NULL"i) & "AS"i? & CorrelationName & ('(' & ColumnNameList & ')')? => @(true)
                   | none => @(false)
Recognized : @bool = RowPatternRecognitionClause & Correlated => @(true)
                   | none => @(false)

// ── §7.6 Row pattern recognition clause ─────────────────────────────────────

RowPatternRecognitionClause
	= "MATCH_RECOGNIZE"i & '(' & RowPatternPartitionBy? & ("ORDER"i & "BY"i & SortSpecificationList)?
	  & RowPatternMeasures? & RowPatternRowsPerMatch? & RowPatternCommonSyntax & ')'

RowPatternPartitionBy = "PARTITION"i & "BY"i & ColumnReference & CollateClause? & (',' & ColumnReference & CollateClause?)*
RowPatternMeasures    = "MEASURES"i & ValueExpression & "AS"i & Identifier & (',' & ValueExpression & "AS"i & Identifier)*

RowPatternRowsPerMatch
	= "ONE"i & "ROW"i & "PER"i & "MATCH"i
	| "ALL"i & "ROWS"i & "PER"i & "MATCH"i & ("SHOW"i & "EMPTY"i & "MATCHES"i | "OMIT"i & "EMPTY"i & "MATCHES"i | "WITH"i & "UNMATCHED"i & "ROWS"i)?

// <row pattern common syntax>, which a window frame ends in too.
RowPatternCommonSyntax
	= ("AFTER"i & "MATCH"i & RowPatternSkipTo)? & ("INITIAL"i | "SEEK"i)? & "PATTERN"i & '(' & RowPattern & ')'
	  & RowPatternSubsetClause? & "DEFINE"i & RowPatternDefinition & (',' & RowPatternDefinition)*

// <row pattern skip to>. A variable's name is an identifier, and `FIRST`, `LAST` and `NEXT` are none
// of them reserved: `SKIP TO FIRST A` is asked before `SKIP TO FIRST`, which names a variable `FIRST`.
RowPatternSkipTo
	= "SKIP"i & "TO"i & "NEXT"i & "ROW"i
	| "SKIP"i & "PAST"i & "LAST"i & "ROW"i
	| "SKIP"i & "TO"i & ("FIRST"i | "LAST"i) & Identifier
	| "SKIP"i & "TO"i & Identifier

// <row pattern>, <row pattern alternation>, <row pattern term>: the BNF recurses through the first
// and the last on the left, and they are repetitions here.
RowPattern       = RowPatternTerm & ('|' & RowPatternTerm)*
RowPatternTerm   = RowPatternFactor & (trivia & RowPatternFactor)*
RowPatternFactor = RowPatternPrimary & RowPatternQuantifier?

// <row pattern primary>. `PERMUTE` is not reserved, and is asked before a variable of that name.
RowPatternPrimary
	= "PERMUTE"i & '(' & RowPattern & (',' & RowPattern)* & ')'
	| Identifier
	| '$'
	| '^'
	| '(' & RowPattern? & ')'
	| "{-" & RowPattern & "-}"

RowPatternQuantifier
	= '*' & PatternQuestionMark?
	| '+' & PatternQuestionMark?
	| PatternQuestionMark & PatternQuestionMark?
	| '{' & UnsignedInteger? & ',' & UnsignedInteger? & '}' & PatternQuestionMark?
	| '{' & UnsignedInteger & '}'

RowPatternSubsetClause = "SUBSET"i & RowPatternSubsetItem & (',' & RowPatternSubsetItem)*
RowPatternSubsetItem   = Identifier & '=' & '(' & Identifier & (',' & Identifier)* & ')'
RowPatternDefinition   = Identifier & "AS"i & SearchCondition

// <table or query name>: a transition table's name and a query's are identifiers, which a table name is.
TableOrQueryName = TableName

QuerySystemTimePeriodSpecification
	= "FOR"i & "SYSTEM_TIME"i & "AS"i & "OF"i & DatetimeValueExpression
	| "FOR"i & "SYSTEM_TIME"i & "BETWEEN"i & ("ASYMMETRIC"i | "SYMMETRIC"i)? & DatetimeValueExpression & "AND"i & DatetimeValueExpression
	| "FOR"i & "SYSTEM_TIME"i & "FROM"i & DatetimeValueExpression & "TO"i & DatetimeValueExpression

ColumnNameList  = ColumnName & (',' & ColumnName)*
CorrelationName = Identifier
QueryName       = Identifier

// ── §7.8 Where clause, §7.9 Group by clause, §7.10 Having clause ────────────

WhereClause  = "WHERE"i & SearchCondition
HavingClause = "HAVING"i & SearchCondition

GroupByClause = "GROUP"i & "BY"i & SetQuantifier? & { GroupingElement & (',' & GroupingElement)* }

// <grouping element>, <grouping set>: the two are the same five. `()` is an empty grouping set, and
// asked before an ordinary one, which would take its bracket.
GroupingElement
	= "ROLLUP"i & '(' & OrdinaryGroupingSet & (',' & OrdinaryGroupingSet)* & ')'
	| "CUBE"i & '(' & OrdinaryGroupingSet & (',' & OrdinaryGroupingSet)* & ')'
	| "GROUPING"i & "SETS"i & '(' & GroupingElement & (',' & GroupingElement)* & ')'
	| '(' & ')'
	| OrdinaryGroupingSet

OrdinaryGroupingSet
	= GroupingColumnReference
	| '(' & GroupingColumnReference & (',' & GroupingColumnReference)* & ')'

GroupingColumnReference = ColumnReference & CollateClause?

// ── §7.11 Window clause ─────────────────────────────────────────────────────

WindowClause               = "WINDOW"i & { WindowDefinition & (',' & WindowDefinition)* }
WindowDefinition           = WindowName & "AS"i & WindowSpecification
WindowSpecification        = '(' & WindowSpecificationDetails & ')'
WindowSpecificationDetails = ExistingWindowName? & WindowPartitionClause? & WindowOrderClause? & WindowFrameClause?

// <existing window name>. A frame may begin with `MEASURES`, which is not reserved, so a name is one
// only where what may follow a name follows it.
ExistingWindowName = WindowName & ?=("PARTITION"i | "ORDER"i | "ROWS"i | "RANGE"i | "GROUPS"i | "MEASURES"i | ')')
WindowName                 = Identifier

WindowPartitionClause = "PARTITION"i & "BY"i & WindowPartitionColumnReference & (',' & WindowPartitionColumnReference)*
WindowPartitionColumnReference = ColumnReference & CollateClause?
WindowOrderClause     = "ORDER"i & "BY"i & SortSpecificationList

// <window frame clause>, with the row pattern measures before it and the row pattern syntax after.
WindowFrameClause = RowPatternMeasures? & ("ROWS"i | "RANGE"i | "GROUPS"i) & WindowFrameExtent & WindowFrameExclusion? & RowPatternCommonSyntax?

WindowFrameExtent
	= "BETWEEN"i & WindowFrameBound & "AND"i & WindowFrameBound
	| WindowFrameStart

WindowFrameStart
	= "UNBOUNDED"i & "PRECEDING"i
	| UnsignedValueSpecification & "PRECEDING"i
	| "CURRENT"i & "ROW"i

WindowFrameBound
	= WindowFrameStart
	| "UNBOUNDED"i & "FOLLOWING"i
	| UnsignedValueSpecification & "FOLLOWING"i

WindowFrameExclusion = "EXCLUDE"i & ("CURRENT"i & "ROW"i | "GROUP"i | "TIES"i | "NO"i & "OTHERS"i)

// <unsigned value specification>, <simple value specification>: an SQL parameter reference is an
// identifier chain, and a host's embedded variable is written as a host parameter is.
UnsignedValueSpecification = UnsignedLiteral | GeneralValueSpecification | IdentifierChain
SimpleValueSpecification   = Literal | ':' & Identifier | IdentifierChain

// ── §7.12 Query specification ───────────────────────────────────────────────

QuerySpecification = "SELECT"i & SetQuantifier? & SelectList & TableExpression
SetQuantifier      = "DISTINCT"i | "ALL"i

SelectList = '*' | { SelectSublist & (',' & SelectSublist)* }

// <select sublist>: a <derived column>, or a <qualified asterisk>. Each begins with a value
// expression — an <asterisked identifier chain> is a column reference in shape, and an <all fields
// reference> a value expression primary — so the expression is read once. `t.*` is a JSON simplified
// accessor too, and the expression reads its `.*`; `AS (…)` after it asks that `.*` was the last
// step (`Towers.Starred`). Tried apart, a subquery in a select list would be read twice at every depth.
//
// Nothing reads a `.*` after the expression: every primary takes it as a step, and what cannot — a
// row, `(a, b).*` — is no primary to take it. Read there as well, a refused line gave each `.*` back
// to be read the second way, and a select list of them cost a power of their number.
SelectSublist : @bool = e: ValueExpression & f: AllFields & when @(f == false || (Towers.RolesOf(e) & Towers.Starred) != 0) => @(true)
AllFields     : @bool = "AS"i & '(' & ColumnNameList & ')' => @(true)
                      | AsClause => @(false)
                      | none => @(false)

AsClause = "AS"i? & ColumnName

// ── §7.13 Query expression ──────────────────────────────────────────────────

QueryExpression = WithClause? & QueryExpressionBody & OrderByClause? & ResultOffsetClause? & FetchFirstClause?

WithClause      = "WITH"i & "RECURSIVE"i? & { WithListElement & (',' & WithListElement)* }
WithListElement = QueryName & ('(' & ColumnNameList & ')')? & "AS"i & TableSubquery & SearchOrCycleClause?

// <query expression body>, <query term>: each recurses through itself on the left, so the operators
// are a repetition here, and `INTERSECT` is read inside a term.
QueryExpressionBody = { QueryTerm & (("UNION"i | "EXCEPT"i) & ("ALL"i | "DISTINCT"i)? & CorrespondingSpec? & QueryTerm)* }
QueryTerm           = { QueryPrimary & ("INTERSECT"i & ("ALL"i | "DISTINCT"i)? & CorrespondingSpec? & QueryPrimary)* }

QueryPrimary
	= SimpleTable
	| '(' & QueryExpressionBody & OrderByClause? & ResultOffsetClause? & FetchFirstClause? & ')'

// <simple table>, with <explicit table>.
SimpleTable
	= QuerySpecification
	| TableValueConstructor
	| "TABLE"i & TableOrQueryName

CorrespondingSpec  = "CORRESPONDING"i & ("BY"i & '(' & ColumnNameList & ')')?
OrderByClause      = "ORDER"i & "BY"i & SortSpecificationList
ResultOffsetClause = "OFFSET"i & SimpleValueSpecification & ("ROW"i | "ROWS"i)

// <fetch first clause>. A <fetch first percentage> is a row count and `PERCENT`.
FetchFirstClause   = "FETCH"i & ("FIRST"i | "NEXT"i) & FetchFirstQuantity? & ("ROW"i | "ROWS"i) & ("ONLY"i | "WITH"i & "TIES"i)
FetchFirstQuantity = SimpleValueSpecification & "PERCENT"i?

// ── §7.14 Search or cycle clause ────────────────────────────────────────────

SearchOrCycleClause
	= SearchClause & CycleClause?
	| CycleClause

SearchClause = "SEARCH"i & ("DEPTH"i | "BREADTH"i) & "FIRST"i & "BY"i & ColumnNameList & "SET"i & ColumnName
CycleClause  = "CYCLE"i & ColumnNameList & "SET"i & ColumnName & ("TO"i & ValueExpression & "DEFAULT"i & ValueExpression)? & "USING"i & ColumnName

// ── §7.15 Subquery ──────────────────────────────────────────────────────────

ScalarSubquery = Subquery
TableSubquery  = Subquery
Subquery       = '(' & QueryExpression & ')'

// ── §10.10 Sort specification list ──────────────────────────────────────────

SortSpecificationList = { SortSpecification & (',' & SortSpecification)* }
SortSpecification     = ValueExpression & ("ASC"i | "DESC"i)? & ("NULLS"i & ("FIRST"i | "LAST"i))?

// ── §14.8 Delete statement, §14.9 Truncate table statement ──────────────────

// <delete statement: searched>, <delete statement: positioned>.
DeleteStatementSearched   = "DELETE"i & "FROM"i & TargetTable & ForPortionOf? & ("AS"i? & CorrelationName)? & ("WHERE"i & SearchCondition)?
DeleteStatementPositioned = "DELETE"i & "FROM"i & TargetTable & ("AS"i? & CorrelationName)? & "WHERE"i & "CURRENT"i & "OF"i & CursorName

TruncateTableStatement = "TRUNCATE"i & "TABLE"i & TargetTable & (("CONTINUE"i | "RESTART"i) & "IDENTITY"i)?

// <target table>.
TargetTable = TableName | "ONLY"i & '(' & TableName & ')'

// An application time period's portion, which a searched delete and update may name.
ForPortionOf = "FOR"i & "PORTION"i & "OF"i & Identifier & "FROM"i & DatetimeValueExpression & "TO"i & DatetimeValueExpression

// <cursor name>, a <local qualified name>.
CursorName = ("MODULE"i & '.')? & Identifier

// ── §14.11 Insert statement ─────────────────────────────────────────────────

// <insert statement>. A column list and an override clause stand before a query and before a
// constructor alike, and are read once; the constructor is asked first, since it reads what a
// query's table value constructor does and `DEFAULT` too.
InsertStatement = "INSERT"i & "INTO"i & TableName & InsertColumnsAndSource

InsertColumnsAndSource
	= ('(' & ColumnNameList & ')')? & OverrideClause? & (ContextuallyTypedTableValueConstructor | QueryExpression)
	| "DEFAULT"i & "VALUES"i

OverrideClause = "OVERRIDING"i & ("USER"i | "SYSTEM"i) & "VALUE"i

// <contextually typed table value constructor>: rows whose values may be `DEFAULT`, `NULL` or an
// empty collection, which take their type from where they go.
ContextuallyTypedTableValueConstructor = "VALUES"i & { ContextuallyTypedRowValueExpression & (',' & ContextuallyTypedRowValueExpression)* }

// <contextually typed row value expression>. A bracket holds such a specification alone, or two or
// more elements; a value expression reads any other row and value.
ContextuallyTypedRowValueExpression
	= ContextuallyTypedValueSpecification
	| '(' & ContextuallyTypedValueSpecification & ')'
	| '(' & ContextuallyTypedElement & (',' & ContextuallyTypedElement)+ & ')'
	| "ROW"i & '(' & ContextuallyTypedElement & (',' & ContextuallyTypedElement)* & ')'
	| ValueExpression

ContextuallyTypedElement = ContextuallyTypedValueSpecification | ValueExpression

// ── §14.12 Merge statement ──────────────────────────────────────────────────

MergeStatement = "MERGE"i & "INTO"i & TargetTable & ("AS"i? & CorrelationName)? & "USING"i & TableReference & "ON"i & SearchCondition & { (trivia & MergeWhenClause)+ }

MergeWhenClause
	= "WHEN"i & "MATCHED"i & ("AND"i & SearchCondition)? & "THEN"i & ("UPDATE"i & "SET"i & SetClauseList | "DELETE"i)
	| "WHEN"i & "NOT"i & "MATCHED"i & ("AND"i & SearchCondition)? & "THEN"i & MergeInsertSpecification

MergeInsertSpecification = "INSERT"i & ('(' & ColumnNameList & ')')? & OverrideClause? & "VALUES"i & '(' & ContextuallyTypedElement & (',' & ContextuallyTypedElement)* & ')'

// ── §14.13 Update statement: positioned, §14.14 Update statement: searched ─

UpdateStatementSearched   = "UPDATE"i & TargetTable & ForPortionOf? & ("AS"i? & CorrelationName)? & "SET"i & SetClauseList & ("WHERE"i & SearchCondition)?
UpdateStatementPositioned = "UPDATE"i & TargetTable & ("AS"i? & CorrelationName)? & "SET"i & SetClauseList & "WHERE"i & "CURRENT"i & "OF"i & CursorName

// ── §14.15 Set clause list ──────────────────────────────────────────────────

SetClauseList = { SetClause & (',' & SetClause)* }

// <set clause>: several targets and a row, or a target and a value.
SetClause
	= '(' & SetTarget & (',' & SetTarget)* & ')' & '=' & ContextuallyTypedRowValueExpression
	| SetTarget & '=' & (ContextuallyTypedValueSpecification | ValueExpression)

// <set target>: a column, an element of one, or a column's attribute set by a mutator, as often as
// there are attributes on the way — <mutated set clause> recurses through <mutated target> on the left.
SetTarget = ColumnName & (LeftBracketOrTrigraph & SimpleValueSpecification & RightBracketOrTrigraph | ('.' & MethodName)*)

// ── §7.6 Data change delta table ────────────────────────────────────────────

// <data change delta table>, <data change statement>: what a data change statement changed, as a table.
DataChangeDeltaTable = ("FINAL"i | "NEW"i | "OLD"i) & "TABLE"i & '(' & (DeleteStatementSearched | InsertStatement | MergeStatement | UpdateStatementSearched) & ')'

// ── §11 Schema definition and manipulation ──────────────────────────────────
//
// Schemas and all a schema holds — tables, views, domains, character sets, collations,
// transliterations, assertions, triggers, user-defined types, routines, casts, orderings, transforms,
// sequence generators, roles and privileges — and what alters and drops them.

// <SQL schema statement>: a definition or a manipulation.
SQLSchemaStatement
	= SchemaDefinition
	| TableDefinition
	| ViewDefinition
	| SchemaRoutine
	| GrantStatement
	| RoleDefinition
	| DomainDefinition
	| CharacterSetDefinition
	| CollationDefinition
	| TransliterationDefinition
	| AssertionDefinition
	| TriggerDefinition
	| UserDefinedTypeDefinition
	| UserDefinedCastDefinition
	| UserDefinedOrderingDefinition
	| TransformDefinition
	| SequenceGeneratorDefinition
	| DropSchemaStatement
	| AlterTableStatement
	| DropTableStatement
	| DropViewStatement
	| AlterRoutineStatement
	| DropRoutineStatement
	| DropUserDefinedCastStatement
	| RevokeStatement
	| DropRoleStatement
	| AlterDomainStatement
	| DropDomainStatement
	| DropCharacterSetStatement
	| DropCollationStatement
	| DropTransliterationStatement
	| DropAssertionStatement
	| DropTriggerStatement
	| AlterTypeStatement
	| DropDataTypeStatement
	| DropUserDefinedOrderingStatement
	| AlterTransformStatement
	| DropTransformStatement
	| AlterSequenceGeneratorStatement
	| DropSequenceGeneratorStatement

// A drop behavior, which every drop but an assertion's must say.
DropBehavior = "CASCADE"i | "RESTRICT"i

// ── §11.1 Schema definition, §11.2 Drop schema statement ────────────────────

// <schema definition>. A schema's name and its authorization, or either; the longer is asked first.
SchemaDefinition = "CREATE"i & "SCHEMA"i & SchemaNameClause & SchemaCharacterSetOrPath? & { (trivia & SchemaElement)* }

SchemaNameClause
	= SchemaName & "AUTHORIZATION"i & Identifier
	| "AUTHORIZATION"i & Identifier
	| SchemaName

SchemaCharacterSetOrPath
	= SchemaCharacterSetSpecification & ("PATH"i & SchemaName & (',' & SchemaName)*)?
	| "PATH"i & SchemaName & (',' & SchemaName)* & SchemaCharacterSetSpecification?

SchemaCharacterSetSpecification = "DEFAULT"i & "CHARACTER"i & "SET"i & CharacterSetSpecification

SchemaElement
	= TableDefinition
	| ViewDefinition
	| DomainDefinition
	| CharacterSetDefinition
	| CollationDefinition
	| TransliterationDefinition
	| AssertionDefinition
	| TriggerDefinition
	| UserDefinedTypeDefinition
	| UserDefinedCastDefinition
	| UserDefinedOrderingDefinition
	| TransformDefinition
	| SchemaRoutine
	| SequenceGeneratorDefinition
	| GrantStatement
	| RoleDefinition

DropSchemaStatement = "DROP"i & "SCHEMA"i & SchemaName & DropBehavior

// ── §11.3 Table definition ──────────────────────────────────────────────────

// <table definition>. A table's contents are its elements or a query's result. A column list before
// a query is an element list in shape — `(a, b)` is two columns with no type — so the query is asked
// first: in a schema's elements, which give nothing back, the element list would end the table before
// its `AS`.
TableDefinition = "CREATE"i & (("GLOBAL"i | "LOCAL"i) & "TEMPORARY"i)? & "TABLE"i & TableName & TableContentsSource
	  & ("WITH"i & "SYSTEM"i & "VERSIONING"i)? & ("ON"i & "COMMIT"i & ("PRESERVE"i | "DELETE"i) & "ROWS"i)?

TableContentsSource
	= ('(' & ColumnNameList & ')')? & "AS"i & TableSubquery & "WITH"i & "NO"i? & "DATA"i
	| TableElementList
	| TypedTableClause

// <typed table clause>: a table of a structured type, under a supertable, with options for its
// columns, constraints, and the column that references its rows.
TypedTableClause      = "OF"i & PathResolvedUserDefinedTypeName & ("UNDER"i & TableName)? & TypedTableElementList?
TypedTableElementList = '(' & { TypedTableElement & (',' & TypedTableElement)* } & ')'
TypedTableElement     = SelfReferencingColumnSpecification | TableConstraintDefinition | ColumnOptions

SelfReferencingColumnSpecification = "REF"i & "IS"i & ColumnName & ("SYSTEM"i & "GENERATED"i | "USER"i & "GENERATED"i | "DERIVED"i)?

// <column options>: a scope, a default and constraints, any of them.
ColumnOptions = ColumnName & "WITH"i & "OPTIONS"i & ("SCOPE"i & TableName)? & DefaultClause? & (trivia & { ColumnConstraintDefinition })*

// The list is atomic: a list refused at its end gave back its elements, and their shorter readings,
// and read every later element again for each — a square of its length.
TableElementList = '(' & { TableElement & (',' & TableElement)* } & ')'

// <table element>. A column begins with its name, which none of the others' key words can be.
TableElement = ColumnDefinition | TablePeriodDefinition | TableConstraintDefinition | LikeClause

// <like clause>.
LikeClause = "LIKE"i & TableName & (("INCLUDING"i | "EXCLUDING"i) & ("IDENTITY"i | "DEFAULTS"i | "GENERATED"i))*

// <table period definition>.
TablePeriodDefinition = PeriodForSpecification & '(' & ColumnName & ',' & ColumnName & ')'
PeriodForSpecification = "PERIOD"i & "FOR"i & ("SYSTEM_TIME"i | Identifier)

// ── §11.4 Column definition ─────────────────────────────────────────────────

// <column definition>: a name, a type or a domain's name — which <data type> reads — or neither, one
// of a default, an identity, a generation expression and a system time period's row start or end,
// then constraints, and a collation.
//
// `GENERATED` is not reserved, and a user-defined type may be named so; the list of elements gives
// nothing back once it is read, so a type is not taken where `GENERATED ALWAYS` or `GENERATED BY`
// follows, which only a generation can go on from.
ColumnDefinition = ColumnName & (?!("GENERATED"i & ("ALWAYS"i | "BY"i)) & DataType)? & ColumnValueSource? & (trivia & { ColumnConstraintDefinition })* & CollateClause?

ColumnValueSource
	= DefaultClause
	| "GENERATED"i & ("ALWAYS"i | "BY"i & "DEFAULT"i) & "AS"i & "IDENTITY"i & ('(' & CommonSequenceGeneratorOptions & ')')?
	| "GENERATED"i & "ALWAYS"i & "AS"i & '(' & ValueExpression & ')'
	| "GENERATED"i & "ALWAYS"i & "AS"i & "ROW"i & ("START"i | "END"i)

ColumnConstraintDefinition = ConstraintNameDefinition? & ColumnConstraint & ConstraintCharacteristics?

ColumnConstraint
	= "NOT"i & "NULL"i
	| "UNIQUE"i
	| "PRIMARY"i & "KEY"i
	| ReferencesSpecification
	| CheckConstraintDefinition

// ── §11.5 Default clause ────────────────────────────────────────────────────

// <default clause>: a literal, a datetime value function, a user or a schema of the session, or a
// value whose type comes from the column; no expression.
DefaultClause = "DEFAULT"i & DefaultOption

DefaultOption
	= Literal
	| DatetimeValueFunction
	| "USER"i | "CURRENT_USER"i | "CURRENT_ROLE"i | "SESSION_USER"i | "SYSTEM_USER"i
	| "CURRENT_CATALOG"i | "CURRENT_SCHEMA"i | "CURRENT_PATH"i
	| ImplicitlyTypedValueSpecification

// ── §11.6 Table constraint definition ───────────────────────────────────────

TableConstraintDefinition = ConstraintNameDefinition? & TableConstraint & ConstraintCharacteristics?

TableConstraint
	= "UNIQUE"i & '(' & "VALUE"i & ')'
	| ("UNIQUE"i | "PRIMARY"i & "KEY"i) & ("NULLS"i & "NOT"i? & "DISTINCT"i)? & '(' & ColumnNameList & (',' & Identifier & "WITHOUT"i & "OVERLAPS"i)? & ')'
	| "FOREIGN"i & "KEY"i & '(' & ColumnNameList & (',' & "PERIOD"i & Identifier)? & ')' & ReferencesSpecification
	| CheckConstraintDefinition

ConstraintNameDefinition = "CONSTRAINT"i & SchemaQualifiedName

// <constraint characteristics>: when it is checked, whether that may be deferred, and whether it is enforced.
ConstraintCharacteristics
	= ConstraintCheckTime & ("NOT"i? & "DEFERRABLE"i)? & ConstraintEnforcement?
	| "NOT"i? & "DEFERRABLE"i & ConstraintCheckTime? & ConstraintEnforcement?
	| ConstraintEnforcement

ConstraintCheckTime   = "INITIALLY"i & ("DEFERRED"i | "IMMEDIATE"i)
ConstraintEnforcement = "NOT"i? & "ENFORCED"i

// ── §11.8 Referential constraint definition, §11.9 Check constraint definition ─

ReferencesSpecification = "REFERENCES"i & TableName & ('(' & ColumnNameList & (',' & "PERIOD"i & Identifier)? & ')')?
	  & ("MATCH"i & ("FULL"i | "PARTIAL"i | "SIMPLE"i))? & ReferentialTriggeredAction?

// <referential triggered action>: an update rule, a delete rule, or both in either order.
ReferentialTriggeredAction
	= UpdateRule & DeleteRule?
	| DeleteRule & UpdateRule?

UpdateRule        = "ON"i & "UPDATE"i & ReferentialAction
DeleteRule        = "ON"i & "DELETE"i & ReferentialAction
ReferentialAction = "CASCADE"i | "SET"i & ("NULL"i | "DEFAULT"i) | "RESTRICT"i | "NO"i & "ACTION"i

CheckConstraintDefinition = "CHECK"i & '(' & SearchCondition & ')'

// ── §11.10 Alter table statement and its actions ────────────────────────────

AlterTableStatement = "ALTER"i & "TABLE"i & TableName & AlterTableAction

// <alter table action>: one. A column is named with or without `COLUMN`, and a column's name is none
// of the key words that begin the other actions.
AlterTableAction
	= "ADD"i & "COLUMN"i? & ColumnDefinition
	| "ALTER"i & "COLUMN"i? & ColumnName & AlterColumnAction
	| "DROP"i & "COLUMN"i? & ColumnName & DropBehavior
	| "ADD"i & TableConstraintDefinition
	| "ALTER"i & "CONSTRAINT"i & SchemaQualifiedName & ConstraintEnforcement
	| "DROP"i & "CONSTRAINT"i & SchemaQualifiedName & DropBehavior
	| "ADD"i & TablePeriodDefinition & ("ADD"i & "COLUMN"i? & ColumnDefinition & "ADD"i & "COLUMN"i? & ColumnDefinition)?
	| "DROP"i & PeriodForSpecification & DropBehavior
	| "ADD"i & "SYSTEM"i & "VERSIONING"i
	| "DROP"i & "SYSTEM"i & "VERSIONING"i & DropBehavior

// <alter column action>.
AlterColumnAction
	= "SET"i & DefaultClause
	| "DROP"i & "DEFAULT"i
	| "SET"i & "NOT"i & "NULL"i
	| "DROP"i & "NOT"i & "NULL"i
	| "ADD"i & "SCOPE"i & TableName
	| "DROP"i & "SCOPE"i & DropBehavior
	| "SET"i & "DATA"i & "TYPE"i & DataType
	| "SET"i & "GENERATED"i & ("ALWAYS"i | "BY"i & "DEFAULT"i) & (trivia & AlterIdentityColumnOption)*
	| AlterIdentityColumnOption & (trivia & AlterIdentityColumnOption)*
	| "DROP"i & "IDENTITY"i
	| "DROP"i & "EXPRESSION"i

AlterIdentityColumnOption
	= "RESTART"i & ("WITH"i & SignedNumericLiteral)?
	| "SET"i & BasicSequenceGeneratorOption

DropTableStatement = "DROP"i & "TABLE"i & TableName & DropBehavior

// ── §11.22 View definition, §11.23 Drop view statement ──────────────────────

ViewDefinition = "CREATE"i & "RECURSIVE"i? & "VIEW"i & TableName & ViewSpecification & "AS"i & QueryExpression
	  & ("WITH"i & ("CASCADED"i | "LOCAL"i)? & "CHECK"i & "OPTION"i)?

// <view specification>: a view of a structured type, with its self-referencing column and its columns'
// scopes, or a regular view with its columns named or not.
ViewSpecification
	= "OF"i & PathResolvedUserDefinedTypeName & ("UNDER"i & TableName)? & ViewElementList?
	| ('(' & ColumnNameList & ')')?

ViewElementList = '(' & { ViewElement & (',' & ViewElement)* } & ')'
ViewElement     = SelfReferencingColumnSpecification | ColumnName & "WITH"i & "OPTIONS"i & "SCOPE"i & TableName

DropViewStatement = "DROP"i & "VIEW"i & TableName & DropBehavior

// ── §11.24 Domain definition, §11.26–11.31 Alter and drop domain ────────────

// <domain definition>: of a predefined type only, which a collection is not.
DomainDefinition = "CREATE"i & "DOMAIN"i & SchemaQualifiedName & "AS"i? & PredefinedType & DefaultClause? & { (trivia & DomainConstraint)* } & CollateClause?
DomainConstraint = ConstraintNameDefinition? & CheckConstraintDefinition & ConstraintCharacteristics?

AlterDomainStatement = "ALTER"i & "DOMAIN"i & SchemaQualifiedName & AlterDomainAction
AlterDomainAction
	= "SET"i & DefaultClause
	| "DROP"i & "DEFAULT"i
	| "ADD"i & DomainConstraint
	| "DROP"i & "CONSTRAINT"i & SchemaQualifiedName

DropDomainStatement = "DROP"i & "DOMAIN"i & SchemaQualifiedName & DropBehavior

// ── §11.47 Assertion definition, §11.48 Drop assertion statement ────────────

AssertionDefinition    = "CREATE"i & "ASSERTION"i & SchemaQualifiedName & CheckConstraintDefinition & ConstraintCharacteristics?
DropAssertionStatement = "DROP"i & "ASSERTION"i & SchemaQualifiedName & DropBehavior?

// ── §11.49 Trigger definition, §11.50 Drop trigger statement ────────────────

TriggerDefinition = "CREATE"i & "TRIGGER"i & SchemaQualifiedName & TriggerActionTime & TriggerEvent & "ON"i & TableName
	  & ("REFERENCING"i & { (trivia & TransitionTableOrVariable)+ })? & TriggeredAction

TriggerActionTime = "BEFORE"i | "AFTER"i | "INSTEAD"i & "OF"i
TriggerEvent      = "INSERT"i | "DELETE"i | "UPDATE"i & ("OF"i & ColumnNameList)?

// <transition table or variable>: a table asked first, since `TABLE` is reserved and no variable's name.
TransitionTableOrVariable = ("OLD"i | "NEW"i) & ("TABLE"i & "AS"i? & Identifier | "ROW"i? & "AS"i? & CorrelationName)

TriggeredAction       = ("FOR"i & "EACH"i & ("ROW"i | "STATEMENT"i))? & ("WHEN"i & '(' & SearchCondition & ')')? & TriggeredSQLStatement
TriggeredSQLStatement = SQLProcedureStatement | CompoundTriggeredSQLStatement

// <compound triggered SQL statement>: one statement at least, each with its semicolon.
CompoundTriggeredSQLStatement = "BEGIN"i & "ATOMIC"i & { (SQLProcedureStatement & ';')+ } & "END"i

// <drop trigger statement>, which says no drop behavior.
DropTriggerStatement = "DROP"i & "TRIGGER"i & SchemaQualifiedName

// ── §11 SQL-invoked routines, alter routine, drop routine ───────────────────

// <schema routine>: a procedure, a function or a method, created.
SchemaRoutine       = "CREATE"i & (SQLInvokedProcedure | SQLInvokedFunction)
SQLInvokedProcedure = "PROCEDURE"i & SchemaQualifiedName & SQLParameterDeclarationList & RoutineCharacteristics & RoutineBody
SQLInvokedFunction  = (FunctionSpecification | MethodSpecificationDesignator) & RoutineBody

FunctionSpecification = "FUNCTION"i & SchemaQualifiedName & SQLParameterDeclarationList & ReturnsClause & RoutineCharacteristics & ("STATIC"i & "DISPATCH"i)?

// <method specification designator>, which says no characteristics.
MethodSpecificationDesignator
	= "SPECIFIC"i & "METHOD"i & SchemaQualifiedName
	| ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i & MethodName & SQLParameterDeclarationList & ReturnsClause? & "FOR"i & SchemaQualifiedName

SQLParameterDeclarationList = '(' & { SQLParameterDeclaration & (',' & SQLParameterDeclaration)* }? & ')'

// <SQL parameter declaration>. A parameter's name is asked before its type, which a user-defined
// type's name could be: `(a b)` is a parameter `a` of type `b`, and `(a)` one of type `a`.
SQLParameterDeclaration = ("IN"i | "OUT"i | "INOUT"i)? & Identifier? & ParameterType & "RESULT"i? & ("DEFAULT"i & ParameterDefault)?

ParameterType
	= DataType & LocatorIndication?
	| "TABLE"i & ("PASS"i & "THROUGH"i | "NO"i & "PASS"i & "THROUGH"i)? & ("WITH"i & ("ROW"i & "SEMANTICS"i | "SET"i & "SEMANTICS"i & (("PRUNE"i | "KEEP"i) & "ON"i & "EMPTY"i)?))?
	| "DESCRIPTOR"i

LocatorIndication = "AS"i & "LOCATOR"i

// <parameter default>. A descriptor is asked first: `DESCRIPTOR` is not reserved, and a value
// expression would read it as a column and end the parameter list, which gives nothing back.
ParameterDefault = DescriptorValueConstructor | ValueExpression | ContextuallyTypedValueSpecification

DescriptorValueConstructor = "DESCRIPTOR"i & '(' & { DescriptorColumnSpecification & (',' & DescriptorColumnSpecification)* } & ')'
DescriptorColumnSpecification = ColumnName & DataType?

ReturnsClause = "RETURNS"i & ReturnsType

// <returns type>: a table, asked first since `TABLE` and `ONLY` are reserved, or a data type.
ReturnsType
	= "TABLE"i & ('(' & { ColumnName & DataType & (',' & ColumnName & DataType)* } & ')')?
	| "ONLY"i & "PASS"i & "THROUGH"i
	| DataType & LocatorIndication? & ("CAST"i & "FROM"i & DataType & LocatorIndication?)?

// <routine characteristics>: none begins a statement, so all of them are read before the body.
RoutineCharacteristics = { (trivia & RoutineCharacteristic)* }

RoutineCharacteristic
	= LanguageClause
	| ParameterStyleClause
	| "SPECIFIC"i & SchemaQualifiedName
	| "NOT"i? & "DETERMINISTIC"i
	| SQLDataAccessIndication
	| NullCallClause
	| ReturnedResultSetsCharacteristic
	| ("NEW"i | "OLD"i) & "SAVEPOINT"i & "LEVEL"i

LanguageClause                   = "LANGUAGE"i & ("ADA"i | "COBOL"i | "C"i | "FORTRAN"i | "MUMPS"i | "M"i | "PASCAL"i | "PLI"i | "SQL"i)
ParameterStyleClause             = "PARAMETER"i & "STYLE"i & ("SQL"i | "GENERAL"i)
SQLDataAccessIndication          = ("NO"i | "CONTAINS"i) & "SQL"i | ("READS"i | "MODIFIES"i) & "SQL"i & "DATA"i
NullCallClause                   = ("RETURNS"i & "NULL"i | "CALLED"i) & "ON"i & "NULL"i & "INPUT"i
ReturnedResultSetsCharacteristic = "DYNAMIC"i & "RESULT"i & "SETS"i & UnsignedInteger

// <routine body>: a statement, with the rights it runs with, or a reference to an external body, or a
// polymorphic table function's component procedures.
RoutineBody
	= ("SQL"i & "SECURITY"i & ("INVOKER"i | "DEFINER"i))? & SQLProcedureStatement
	| ExternalBodyReference
	| PolymorphicTableFunctionBody

ExternalBodyReference = "EXTERNAL"i & ("NAME"i & ExternalRoutineName)? & ParameterStyleClause? & TransformGroupSpecification?
	  & ("EXTERNAL"i & "SECURITY"i & ("DEFINER"i | "INVOKER"i | "IMPLEMENTATION"i & "DEFINED"i))?

ExternalRoutineName = Identifier | CharacterStringLiteral

// <transform group specification>: groups for types, asked before a single group, whose name begins them.
TransformGroupSpecification = "TRANSFORM"i & "GROUP"i & (GroupSpecification & (',' & GroupSpecification)* | Identifier)
GroupSpecification          = Identifier & "FOR"i & "TYPE"i & SchemaQualifiedName

PolymorphicTableFunctionBody = ("PRIVATE"i & "DATA"i? & SQLParameterDeclarationList)? & ("DESCRIBE"i & "WITH"i & SpecificRoutineDesignator)?
	  & ("START"i & "WITH"i & SpecificRoutineDesignator)? & "FULFILL"i & "WITH"i & SpecificRoutineDesignator & ("FINISH"i & "WITH"i & SpecificRoutineDesignator)?

// <SQL procedure statement>, <SQL executable statement>: what a routine's body and a trigger's action are.
SQLProcedureStatement = SQLExecutableStatement

// Dynamic statements are asked before data statements: a searched `UPDATE` or `DELETE` reads what
// comes before a dynamic cursor's `WHERE CURRENT OF GLOBAL :c` and ends, and in a schema's elements,
// which give nothing back, the schema would end there.
SQLExecutableStatement
	= SQLSchemaStatement
	| SQLDynamicStatement
	| SQLDataStatement
	| SQLControlStatement
	| SQLTransactionStatement
	| SQLConnectionStatement
	| SQLSessionStatement
	| SQLDiagnosticsStatement

// <alter routine statement>: a characteristic at least, and no behavior but `RESTRICT`.
AlterRoutineStatement = "ALTER"i & SpecificRoutineDesignator & { (trivia & AlterRoutineCharacteristic)+ } & "RESTRICT"i

AlterRoutineCharacteristic
	= LanguageClause
	| ParameterStyleClause
	| SQLDataAccessIndication
	| NullCallClause
	| ReturnedResultSetsCharacteristic
	| "NAME"i & ExternalRoutineName

DropRoutineStatement = "DROP"i & SpecificRoutineDesignator & DropBehavior

// <specific routine designator>: a routine by its specific name, or by its name and its parameters' types.
SpecificRoutineDesignator
	= "SPECIFIC"i & RoutineType & SchemaQualifiedName
	| RoutineType & SchemaQualifiedName & ('(' & (DataType & (',' & DataType)*)? & ')')? & ("FOR"i & SchemaQualifiedName)?

RoutineType = "ROUTINE"i | "FUNCTION"i | "PROCEDURE"i | ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i

// ── §11 User-defined types ──────────────────────────────────────────────────

// <user-defined type definition>: a type's name, its supertype, what it is represented by, its options
// in any order and number, and its methods.
UserDefinedTypeDefinition = "CREATE"i & "TYPE"i & SchemaQualifiedName & ("UNDER"i & PathResolvedUserDefinedTypeName)? & ("AS"i & Representation)?
	  & { (trivia & UserDefinedTypeOption)* } & MethodSpecificationList?

// <representation>: a predefined type, a collection — of any type, `ARRAY` or `MULTISET` after it —
// or attributes. A type of no other kind is refused: `AS ROW (a INT)` and `AS u`.
Representation
	= MemberList
	| PredefinedType & (trivia & CollectionTypeSuffix)*
	| (RowType | ReferenceType | PathResolvedUserDefinedTypeName) & (trivia & CollectionTypeSuffix)+

MemberList          = '(' & { AttributeDefinition & (',' & AttributeDefinition)* } & ')'
AttributeDefinition = Identifier & DataType & DefaultClause? & CollateClause?

UserDefinedTypeOption
	= "NOT"i? & ("INSTANTIABLE"i | "FINAL"i)
	| "REF"i & ("USING"i & PredefinedType | "FROM"i & '(' & Identifier & (',' & Identifier)* & ')' | "IS"i & "SYSTEM"i & "GENERATED"i)
	| "CAST"i & '(' & ("SOURCE"i & "AS"i & ("REF"i | "DISTINCT"i) | ("REF"i | "DISTINCT"i) & "AS"i & "SOURCE"i) & ')' & "WITH"i & Identifier

MethodSpecificationList = { MethodSpecification & (',' & MethodSpecification)* }

// <method specification>: an overriding method says no characteristics.
MethodSpecification
	= "OVERRIDING"i & PartialMethodSpecification
	| OriginalMethodSpecification

OriginalMethodSpecification = PartialMethodSpecification & ("SELF"i & "AS"i & "RESULT"i)? & ("SELF"i & "AS"i & "LOCATOR"i)? & { (trivia & MethodCharacteristic)* }
PartialMethodSpecification  = ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i & MethodName & SQLParameterDeclarationList & ReturnsClause & ("SPECIFIC"i & SchemaQualifiedName)?

MethodCharacteristic = LanguageClause | ParameterStyleClause | "NOT"i? & "DETERMINISTIC"i | SQLDataAccessIndication | NullCallClause

// <alter type statement>: an attribute or a method added or dropped.
AlterTypeStatement = "ALTER"i & "TYPE"i & SchemaQualifiedName & AlterTypeAction

AlterTypeAction
	= "ADD"i & ("ATTRIBUTE"i & AttributeDefinition | MethodSpecification)
	| "DROP"i & ("ATTRIBUTE"i & Identifier | SpecificMethodSpecificationDesignator) & "RESTRICT"i

SpecificMethodSpecificationDesignator = ("INSTANCE"i | "STATIC"i | "CONSTRUCTOR"i)? & "METHOD"i & MethodName & '(' & (DataType & (',' & DataType)*)? & ')'

DropDataTypeStatement = "DROP"i & "TYPE"i & SchemaQualifiedName & DropBehavior

// ── §11 User-defined casts, orderings and transforms ────────────────────────

UserDefinedCastDefinition    = "CREATE"i & "CAST"i & '(' & DataType & "AS"i & DataType & ')' & "WITH"i & SpecificRoutineDesignator & ("AS"i & "ASSIGNMENT"i)?
DropUserDefinedCastStatement = "DROP"i & "CAST"i & '(' & DataType & "AS"i & DataType & ')' & DropBehavior

UserDefinedOrderingDefinition    = "CREATE"i & "ORDERING"i & "FOR"i & SchemaQualifiedName & ("EQUALS"i & "ONLY"i | "ORDER"i & "FULL"i) & "BY"i & OrderingCategory
DropUserDefinedOrderingStatement = "DROP"i & "ORDERING"i & "FOR"i & SchemaQualifiedName & DropBehavior

OrderingCategory
	= ("RELATIVE"i | "MAP"i) & "WITH"i & SpecificRoutineDesignator
	| "STATE"i & SchemaQualifiedName?

// <transform definition>: groups, one at least, of a transform to SQL and one from it, or either.
TransformDefinition  = "CREATE"i & TransformKeyword & "FOR"i & SchemaQualifiedName & { (trivia & TransformGroup)+ }
TransformKeyword     = "TRANSFORMS"i | "TRANSFORM"i
TransformGroup       = Identifier & '(' & TransformElementList & ')'
TransformElementList = TransformElement & (',' & TransformElement)?
TransformElement     = TransformKind & "WITH"i & SpecificRoutineDesignator
TransformKind        = ("TO"i | "FROM"i) & "SQL"i

AlterTransformStatement = "ALTER"i & TransformKeyword & "FOR"i & SchemaQualifiedName & { (trivia & AlterGroup)+ }
AlterGroup              = Identifier & '(' & { AlterTransformAction & (',' & AlterTransformAction)* } & ')'

AlterTransformAction
	= "ADD"i & '(' & TransformElementList & ')'
	| "DROP"i & '(' & TransformKind & (',' & TransformKind)? & DropBehavior & ')'

DropTransformStatement = "DROP"i & TransformKeyword & ("ALL"i | Identifier) & "FOR"i & SchemaQualifiedName & DropBehavior

// ── §11 Character sets, collations and transliterations ─────────────────────

CharacterSetDefinition     = "CREATE"i & "CHARACTER"i & "SET"i & CharacterSetSpecification & "AS"i? & "GET"i & CharacterSetSpecification & CollateClause?
DropCharacterSetStatement  = "DROP"i & "CHARACTER"i & "SET"i & CharacterSetSpecification

CollationDefinition    = "CREATE"i & "COLLATION"i & SchemaQualifiedName & "FOR"i & CharacterSetSpecification & "FROM"i & SchemaQualifiedName & ("NO"i & "PAD"i | "PAD"i & "SPACE"i)?
DropCollationStatement = "DROP"i & "COLLATION"i & SchemaQualifiedName & DropBehavior

// <transliteration definition>: from a routine, asked first since `ROUTINE` is not reserved, or from an
// existing transliteration.
TransliterationDefinition    = "CREATE"i & "TRANSLATION"i & SchemaQualifiedName & "FOR"i & CharacterSetSpecification & "TO"i & CharacterSetSpecification
	  & "FROM"i & (SpecificRoutineDesignator | SchemaQualifiedName)
DropTransliterationStatement = "DROP"i & "TRANSLATION"i & SchemaQualifiedName

// ── §11.74 Sequence generator definition, §11.75–11.76 Alter and drop ───────

SequenceGeneratorDefinition = "CREATE"i & "SEQUENCE"i & SchemaQualifiedName & (trivia & ("AS"i & DataType | CommonSequenceGeneratorOption))*

CommonSequenceGeneratorOptions = CommonSequenceGeneratorOption & (trivia & CommonSequenceGeneratorOption)*
CommonSequenceGeneratorOption  = "START"i & "WITH"i & SignedNumericLiteral | BasicSequenceGeneratorOption

BasicSequenceGeneratorOption
	= "INCREMENT"i & "BY"i & SignedNumericLiteral
	| "MAXVALUE"i & SignedNumericLiteral
	| "MINVALUE"i & SignedNumericLiteral
	| "NO"i & ("MAXVALUE"i | "MINVALUE"i | "CYCLE"i)
	| "CYCLE"i

// <alter sequence generator statement>: a restart or a basic option, at least one; a start is not
// altered.
AlterSequenceGeneratorStatement = "ALTER"i & "SEQUENCE"i & SchemaQualifiedName & AlterSequenceGeneratorOption & (trivia & AlterSequenceGeneratorOption)*
AlterSequenceGeneratorOption    = "RESTART"i & ("WITH"i & SignedNumericLiteral)? | BasicSequenceGeneratorOption

DropSequenceGeneratorStatement = "DROP"i & "SEQUENCE"i & SchemaQualifiedName & DropBehavior

// ── §12 Access control: roles and privileges ────────────────────────────────

RoleDefinition    = "CREATE"i & "ROLE"i & Identifier & ("WITH"i & "ADMIN"i & Grantor)?
DropRoleStatement = "DROP"i & "ROLE"i & Identifier & DropBehavior

// <grant statement>: privileges, asked first since they begin with key words, or roles, whose names
// are identifiers — `USAGE` among them, which is not reserved.
GrantStatement
	= "GRANT"i & Privileges & "TO"i & Grantees & ("WITH"i & "HIERARCHY"i & "OPTION"i)? & ("WITH"i & "GRANT"i & "OPTION"i)? & GrantedBy?
	| "GRANT"i & Identifier & (',' & Identifier)* & "TO"i & Grantees & ("WITH"i & "ADMIN"i & "OPTION"i)? & GrantedBy?

RevokeStatement
	= "REVOKE"i & (("GRANT"i | "HIERARCHY"i) & "OPTION"i & "FOR"i)? & Privileges & "FROM"i & Grantees & GrantedBy? & DropBehavior
	| "REVOKE"i & ("ADMIN"i & "OPTION"i & "FOR"i)? & Identifier & (',' & Identifier)* & "FROM"i & Grantees & GrantedBy? & DropBehavior

Privileges = ("ALL"i & "PRIVILEGES"i | PrivilegeAction & (',' & PrivilegeAction)*) & "ON"i & ObjectName

// <action>. A selection names columns or methods; a column's name could be a routine type's word,
// `ROUTINE`, which is not reserved.
PrivilegeAction
	= "SELECT"i & ('(' & (ColumnNameList | SpecificRoutineDesignator & (',' & SpecificRoutineDesignator)*) & ')')?
	| ("INSERT"i | "UPDATE"i | "REFERENCES"i) & ('(' & ColumnNameList & ')')?
	| "DELETE"i | "USAGE"i | "TRIGGER"i | "UNDER"i | "EXECUTE"i

// <object name>. A kind of object is named before a table's name, which could be the kind's word:
// `TYPE`, `SEQUENCE` and `ROUTINE` are not reserved.
ObjectName
	= "DOMAIN"i & SchemaQualifiedName
	| "COLLATION"i & SchemaQualifiedName
	| "CHARACTER"i & "SET"i & CharacterSetSpecification
	| "TRANSLATION"i & SchemaQualifiedName
	| "TYPE"i & SchemaQualifiedName
	| "SEQUENCE"i & SchemaQualifiedName
	| SpecificRoutineDesignator
	| "TABLE"i? & TableName

Grantees  = ("PUBLIC"i | Identifier) & (',' & ("PUBLIC"i | Identifier))*
Grantor   = "CURRENT_USER"i | "CURRENT_ROLE"i
GrantedBy = "GRANTED"i & "BY"i & Grantor

// ── §22 Direct invocation of SQL, and the statements it invokes ─────────────
//
// <direct SQL statement>: a statement and its semicolon. What an implementation defines for itself is
// none of the standard's, and not read.
DirectSQLStatement = DirectlyExecutableStatement & ';'

DirectlyExecutableStatement
	= DirectSQLDataStatement
	| SQLSchemaStatement
	| SQLTransactionStatement
	| SQLConnectionStatement
	| SQLSessionStatement

// <direct SQL data statement>. A multiple row select statement is a cursor specification; a searched
// statement is asked before a query only by its key word.
DirectSQLDataStatement
	= DeleteStatementSearched
	| InsertStatement
	| UpdateStatementSearched
	| TruncateTableStatement
	| MergeStatement
	| TemporaryTableDeclaration
	| CursorSpecification

// <cursor specification>: a query, and whether it is updated through.
CursorSpecification = QueryExpression & ("FOR"i & ("READ"i & "ONLY"i | "UPDATE"i & ("OF"i & ColumnNameList)?))?

TemporaryTableDeclaration = "DECLARE"i & "LOCAL"i & "TEMPORARY"i & "TABLE"i & TableName & TableElementList & ("ON"i & "COMMIT"i & ("PRESERVE"i | "DELETE"i) & "ROWS"i)?

// ── §14.7 Select statement: single row, §14 cursors and locators ────────────

// <SQL data statement>, in a routine's body.
SQLDataStatement
	= OpenStatement
	| FetchStatement
	| CloseStatement
	| SelectStatementSingleRow
	| FreeLocatorStatement
	| HoldLocatorStatement
	| DeleteStatementPositioned
	| DeleteStatementSearched
	| InsertStatement
	| UpdateStatementPositioned
	| UpdateStatementSearched
	| TruncateTableStatement
	| MergeStatement

OpenStatement  = "OPEN"i & CursorName
CloseStatement = "CLOSE"i & CursorName
FetchStatement = "FETCH"i & (FetchOrientation? & "FROM"i)? & CursorName & "INTO"i & { TargetSpecification & (',' & TargetSpecification)* }

FetchOrientation = "NEXT"i | "PRIOR"i | "FIRST"i | "LAST"i | ("ABSOLUTE"i | "RELATIVE"i) & SimpleValueSpecification

// <select statement: single row>: a query specification whose select list is followed by `INTO`.
SelectStatementSingleRow = "SELECT"i & SetQuantifier? & SelectList & "INTO"i & { TargetSpecification & (',' & TargetSpecification)* } & TableExpression

// <target specification>: a host parameter with its indicator, an SQL parameter or a column — an
// identifier chain either — an element of an array, or a dynamic parameter. An embedded variable is
// written as a host parameter is.
TargetSpecification
	= ':' & Identifier & ("INDICATOR"i? & ':' & Identifier)?
	| IdentifierChain & (LeftBracketOrTrigraph & SimpleValueSpecification & RightBracketOrTrigraph)?
	| "MODULE"i & '.' & Identifier & '.' & Identifier
	| '?'

FreeLocatorStatement = "FREE"i & "LOCATOR"i & LocatorReference & (',' & LocatorReference)*
HoldLocatorStatement = "HOLD"i & "LOCATOR"i & LocatorReference & (',' & LocatorReference)*
LocatorReference     = ':' & Identifier | '?'

// ── §16 Control statements ──────────────────────────────────────────────────

SQLControlStatement = CallStatement | ReturnStatement
CallStatement       = "CALL"i & RoutineInvocation
ReturnStatement     = "RETURN"i & (ValueExpression | "NULL"i)

// ── §17 Transaction management ──────────────────────────────────────────────

SQLTransactionStatement
	= StartTransactionStatement
	| SetTransactionStatement
	| SetConstraintsModeStatement
	| SavepointStatement
	| ReleaseSavepointStatement
	| CommitStatement
	| RollbackStatement

StartTransactionStatement   = "START"i & "TRANSACTION"i & (TransactionMode & (',' & TransactionMode)*)?
SetTransactionStatement     = "SET"i & "LOCAL"i? & "TRANSACTION"i & (TransactionMode & (',' & TransactionMode)*)?
SetConstraintsModeStatement = "SET"i & "CONSTRAINTS"i & ("ALL"i | SchemaQualifiedName & (',' & SchemaQualifiedName)*) & ("DEFERRED"i | "IMMEDIATE"i)
SavepointStatement          = "SAVEPOINT"i & Identifier
ReleaseSavepointStatement   = "RELEASE"i & "SAVEPOINT"i & Identifier
CommitStatement             = "COMMIT"i & "WORK"i? & ("AND"i & "NO"i? & "CHAIN"i)?
RollbackStatement           = "ROLLBACK"i & "WORK"i? & ("AND"i & "NO"i? & "CHAIN"i)? & ("TO"i & "SAVEPOINT"i & Identifier)?

// <transaction mode>.
TransactionMode
	= "ISOLATION"i & "LEVEL"i & ("READ"i & ("UNCOMMITTED"i | "COMMITTED"i) | "REPEATABLE"i & "READ"i | "SERIALIZABLE"i)
	| "READ"i & ("ONLY"i | "WRITE"i)
	| "DIAGNOSTICS"i & "SIZE"i & SimpleValueSpecification

// ── §18 Connection management ───────────────────────────────────────────────

SQLConnectionStatement = ConnectStatement | SetConnectionStatement | DisconnectStatement

ConnectStatement       = "CONNECT"i & "TO"i & ("DEFAULT"i | SimpleValueSpecification & ("AS"i & SimpleValueSpecification)? & ("USER"i & SimpleValueSpecification)?)
SetConnectionStatement = "SET"i & "CONNECTION"i & ("DEFAULT"i | SimpleValueSpecification)
DisconnectStatement    = "DISCONNECT"i & ("DEFAULT"i | "ALL"i | "CURRENT"i | SimpleValueSpecification)

// ── §19 Session management ──────────────────────────────────────────────────

// <SQL session statement>. A value specification is a literal or a general value specification; a
// catalog's, schema's, path's and names' are all given as a value, not written as a name.
SQLSessionStatement
	= "SET"i & "SESSION"i & "AUTHORIZATION"i & ValueSpecification
	| "SET"i & "ROLE"i & ("NONE"i | ValueSpecification)
	| "SET"i & "TIME"i & "ZONE"i & ("LOCAL"i | IntervalValueExpression)
	| "SET"i & "SESSION"i & "CHARACTERISTICS"i & "AS"i & SessionTransactionCharacteristics & (',' & SessionTransactionCharacteristics)*
	| "SET"i & ("CATALOG"i | "SCHEMA"i | "NAMES"i | "PATH"i) & ValueSpecification
	| "SET"i & "DEFAULT"i & "TRANSFORM"i & "GROUP"i & ValueSpecification
	| "SET"i & "TRANSFORM"i & "GROUP"i & "FOR"i & "TYPE"i & PathResolvedUserDefinedTypeName & ValueSpecification
	| "SET"i & "COLLATION"i & ValueSpecification & ("FOR"i & { CharacterSetSpecification & (',' & CharacterSetSpecification)* })?
	| "SET"i & "NO"i & "COLLATION"i & ("FOR"i & { CharacterSetSpecification & (',' & CharacterSetSpecification)* })?

SessionTransactionCharacteristics = "TRANSACTION"i & TransactionMode & (',' & TransactionMode)*

// <value specification>.
ValueSpecification = Literal | GeneralValueSpecification | IdentifierChain

// ── §23 Diagnostics management ──────────────────────────────────────────────

SQLDiagnosticsStatement = "GET"i & "DIAGNOSTICS"i & SQLDiagnosticsInformation

// <SQL diagnostics information>: statement information, a condition's, or all of it.
SQLDiagnosticsInformation
	= SimpleTargetSpecification & '=' & "ALL"i & ("STATEMENT"i | "CONDITION"i & SimpleValueSpecification?)?
	| "CONDITION"i & SimpleValueSpecification & { ConditionInformationItem & (',' & ConditionInformationItem)* }
	| { StatementInformationItem & (',' & StatementInformationItem)* }

StatementInformationItem = SimpleTargetSpecification & '=' & StatementInformationItemName
ConditionInformationItem = SimpleTargetSpecification & '=' & ConditionInformationItemName

SimpleTargetSpecification = ':' & Identifier | IdentifierChain | "MODULE"i & '.' & Identifier & '.' & Identifier

StatementInformationItemName
	= "NUMBER"i | "MORE"i | "COMMAND_FUNCTION_CODE"i | "COMMAND_FUNCTION"i | "DYNAMIC_FUNCTION_CODE"i | "DYNAMIC_FUNCTION"i
	| "ROW_COUNT"i | "TRANSACTIONS_COMMITTED"i | "TRANSACTIONS_ROLLED_BACK"i | "TRANSACTION_ACTIVE"i

ConditionInformationItemName
	= "CATALOG_NAME"i | "CLASS_ORIGIN"i | "COLUMN_NAME"i | "CONDITION_NUMBER"i | "CONNECTION_NAME"i
	| "CONSTRAINT_CATALOG"i | "CONSTRAINT_NAME"i | "CONSTRAINT_SCHEMA"i | "CURSOR_NAME"i
	| "MESSAGE_LENGTH"i | "MESSAGE_OCTET_LENGTH"i | "MESSAGE_TEXT"i | "PARAMETER_MODE"i | "PARAMETER_NAME"i
	| "PARAMETER_ORDINAL_POSITION"i | "RETURNED_SQLSTATE"i | "ROUTINE_CATALOG"i | "ROUTINE_NAME"i | "ROUTINE_SCHEMA"i
	| "SCHEMA_NAME"i | "SERVER_NAME"i | "SPECIFIC_NAME"i | "SUBCLASS_ORIGIN"i | "TABLE_NAME"i
	| "TRIGGER_CATALOG"i | "TRIGGER_NAME"i | "TRIGGER_SCHEMA"i

// ── §20 Dynamic SQL ─────────────────────────────────────────────────────────

// <SQL dynamic statement>.
SQLDynamicStatement
	= SQLDescriptorStatement
	| PrepareStatement
	| DeallocatePreparedStatement
	| DescribeStatement
	| ExecuteImmediateStatement
	| ExecuteStatement
	| SQLDynamicDataStatement
	| CopyDescriptorStatement
	| PipeRowStatement

// <scope option>.
ScopeOption = "GLOBAL"i | "LOCAL"i

// <SQL statement name>: a statement's name, an identifier, or an extended one — a scope and a simple
// value, which an identifier already is.
SQLStatementName = ScopeOption? & SimpleValueSpecification

// <descriptor name>: a conventional one — an identifier, or a scope and a simple value — or a
// polymorphic table function's.
DescriptorName             = ConventionalDescriptorName | "PTF"i & SimpleValueSpecification
ConventionalDescriptorName = ScopeOption? & SimpleValueSpecification

// <conventional dynamic cursor name>: a cursor's name, or an extended one.
ConventionalDynamicCursorName = CursorName | ScopeOption? & SimpleValueSpecification
DynamicCursorName             = ConventionalDynamicCursorName | "PTF"i & SimpleValueSpecification

// ── §20.1 Descriptor statements ─────────────────────────────────────────────

SQLDescriptorStatement
	= "ALLOCATE"i & "SQL"i? & "DESCRIPTOR"i & ConventionalDescriptorName & ("WITH"i & "MAX"i & SimpleValueSpecification)?
	| "DEALLOCATE"i & "SQL"i? & "DESCRIPTOR"i & ConventionalDescriptorName
	| "GET"i & "SQL"i? & "DESCRIPTOR"i & DescriptorName & GetDescriptorInformation
	| "SET"i & "SQL"i? & "DESCRIPTOR"i & DescriptorName & SetDescriptorInformation

// <get descriptor information>, <set descriptor information>: the header's items, or one item's.
GetDescriptorInformation
	= { SimpleTargetSpecification & '=' & HeaderItemName & (',' & SimpleTargetSpecification & '=' & HeaderItemName)* }
	| "VALUE"i & SimpleValueSpecification & { SimpleTargetSpecification & '=' & DescriptorItemName & (',' & SimpleTargetSpecification & '=' & DescriptorItemName)* }

SetDescriptorInformation
	= { HeaderItemName & '=' & SimpleValueSpecification & (',' & HeaderItemName & '=' & SimpleValueSpecification)* }
	| "VALUE"i & SimpleValueSpecification & { DescriptorItemName & '=' & SimpleValueSpecification & (',' & DescriptorItemName & '=' & SimpleValueSpecification)* }

HeaderItemName = "COUNT"i | "KEY_TYPE"i | "DYNAMIC_FUNCTION_CODE"i | "DYNAMIC_FUNCTION"i | "TOP_LEVEL_COUNT"i

DescriptorItemName
	= "CARDINALITY"i | "CHARACTER_SET_CATALOG"i | "CHARACTER_SET_NAME"i | "CHARACTER_SET_SCHEMA"i
	| "COLLATION_CATALOG"i | "COLLATION_NAME"i | "COLLATION_SCHEMA"i | "DATA"i | "DATETIME_INTERVAL_CODE"i
	| "DATETIME_INTERVAL_PRECISION"i | "DEGREE"i | "INDICATOR"i | "KEY_MEMBER"i | "LENGTH"i | "LEVEL"i | "NAME"i
	| "NULLABLE"i | "NULL_ORDERING"i | "OCTET_LENGTH"i | "PARAMETER_MODE"i | "PARAMETER_ORDINAL_POSITION"i
	| "PARAMETER_SPECIFIC_CATALOG"i | "PARAMETER_SPECIFIC_NAME"i | "PARAMETER_SPECIFIC_SCHEMA"i | "PRECISION"i
	| "RETURNED_CARDINALITY"i | "RETURNED_LENGTH"i | "RETURNED_OCTET_LENGTH"i | "SCALE"i | "SCOPE_CATALOG"i
	| "SCOPE_NAME"i | "SCOPE_SCHEMA"i | "SORT_DIRECTION"i | "TYPE"i | "UNNAMED"i | "USER_DEFINED_TYPE_CATALOG"i
	| "USER_DEFINED_TYPE_NAME"i | "USER_DEFINED_TYPE_SCHEMA"i | "USER_DEFINED_TYPE_CODE"i

// <copy descriptor statement>: to a polymorphic table function's descriptor, the whole or an item.
CopyDescriptorStatement = "COPY"i & DescriptorName & CopyDescriptorTail

CopyDescriptorTail
	= "TO"i & "PTF"i & SimpleValueSpecification
	| "VALUE"i & SimpleValueSpecification & '(' & ("NAME"i & ',' & "TYPE"i | "NAME"i | "TYPE"i | "DATA"i) & ')'
	  & "TO"i & "PTF"i & SimpleValueSpecification & "VALUE"i & SimpleValueSpecification

PipeRowStatement = "PIPE"i & "ROW"i & "PTF"i & SimpleValueSpecification

// ── §20.6–20.11 Prepare, deallocate, describe, execute ──────────────────────

PrepareStatement            = "PREPARE"i & SQLStatementName & ("ATTRIBUTES"i & SimpleValueSpecification)? & "FROM"i & SimpleValueSpecification
DeallocatePreparedStatement = "DEALLOCATE"i & "PREPARE"i & SQLStatementName

// <describe statement>. `INPUT` and `OUTPUT` are not reserved, and a statement may be named so.
DescribeStatement
	= "DESCRIBE"i & "INPUT"i & SQLStatementName & UsingDescriptor & NestingOption?
	| "DESCRIBE"i & "OUTPUT"i? & ("CURSOR"i & CursorName & "STRUCTURE"i | SQLStatementName) & UsingDescriptor & NestingOption?

UsingDescriptor = "USING"i & "SQL"i? & "DESCRIPTOR"i & DescriptorName
NestingOption   = ("WITH"i | "WITHOUT"i) & "NESTING"i

// <execute immediate statement>, asked before <execute statement>, which names a statement `IMMEDIATE` as readily.
ExecuteImmediateStatement = "EXECUTE"i & "IMMEDIATE"i & SimpleValueSpecification
ExecuteStatement          = "EXECUTE"i & SQLStatementName & OutputUsingClause? & InputUsingClause?

// <input using clause>, <output using clause>: arguments, or a descriptor. A <using argument> is a
// general value specification, whose SQL parameter reference is an identifier chain.
InputUsingClause
	= "USING"i & "SQL"i? & "DESCRIPTOR"i & DescriptorName
	| "USING"i & { UsingArgument & (',' & UsingArgument)* }

UsingArgument = GeneralValueSpecification | IdentifierChain

OutputUsingClause
	= "INTO"i & "SQL"i? & "DESCRIPTOR"i & DescriptorName
	| "INTO"i & { TargetSpecification & (',' & TargetSpecification)* }

// ── §20.12–20.23 Dynamic cursors ────────────────────────────────────────────

SQLDynamicDataStatement
	= AllocateExtendedDynamicCursorStatement
	| AllocateReceivedCursorStatement
	| "OPEN"i & ConventionalDynamicCursorName & InputUsingClause?
	| "FETCH"i & (FetchOrientation? & "FROM"i)? & DynamicCursorName & OutputUsingClause
	| "CLOSE"i & ConventionalDynamicCursorName
	| "DELETE"i & "FROM"i & TargetTable & "WHERE"i & "CURRENT"i & "OF"i & ConventionalDynamicCursorName
	| "UPDATE"i & TargetTable & "SET"i & SetClauseList & "WHERE"i & "CURRENT"i & "OF"i & ConventionalDynamicCursorName

AllocateExtendedDynamicCursorStatement = "ALLOCATE"i & ScopeOption? & SimpleValueSpecification & CursorProperties & "FOR"i & ScopeOption? & SimpleValueSpecification
AllocateReceivedCursorStatement        = "ALLOCATE"i & CursorName & "CURSOR"i? & "FOR"i & SpecificRoutineDesignator

// <cursor properties>.
CursorProperties = ("SENSITIVE"i | "INSENSITIVE"i | "ASENSITIVE"i)? & ("SCROLL"i | "NO"i & "SCROLL"i)? & "CURSOR"i
	  & (("WITH"i | "WITHOUT"i) & "HOLD"i)? & (("WITH"i | "WITHOUT"i) & "RETURN"i)?

// What a publication of a tower hands back: the node alone, since the towers are the grammar's own business.
ValueExpressionTree        : @Expression = e: ValueExpression => @(e.Node)
CommonValueExpressionTree  : @Expression = e: CommonValueExpression => @(e.Node)
NumericValueExpressionTree : @Expression = e: NumericValueExpression => @(e.Node)
StringValueExpressionTree  : @Expression = e: StringValueExpression => @(e.Node)
CharacterValueExpressionTree : @Expression = e: CharacterValueExpression => @(e.Node)
BinaryValueExpressionTree  : @Expression = e: BinaryValueExpression => @(e.Node)
DatetimeValueExpressionTree : @Expression = e: DatetimeValueExpression => @(e.Node)
IntervalValueExpressionTree : @Expression = e: IntervalValueExpression => @(e.Node)
BooleanValueExpressionTree : @Expression = e: BooleanValueExpression => @(e.Node)
SearchConditionTree        : @Expression = e: SearchCondition => @(e.Node)
PredicateTree              : @Expression = e: Predicate => @(e.Node)
RowValuePredicandTree      : @Expression = e: RowValuePredicand => @(e.Node)
ValueExpressionPrimaryTree : @Expression = e: ValueExpressionPrimary => @(e.Node)

parse Literal                  as ParseLiteral
parse UnsignedLiteral          as ParseUnsignedLiteral
parse Identifier               as ParseIdentifier
parse IdentifierChain          as ParseIdentifierChain
parse ColumnReference          as ParseColumnReference
parse TableName                as ParseTableName
parse SchemaName               as ParseSchemaName
parse DataType                 as ParseDataType
parse ValueExpressionTree as ParseValueExpression
parse CommonValueExpressionTree as ParseCommonValueExpression
parse NumericValueExpressionTree as ParseNumericValueExpression
parse StringValueExpressionTree as ParseStringValueExpression
parse CharacterValueExpressionTree as ParseCharacterValueExpression
parse BinaryValueExpressionTree as ParseBinaryValueExpression
parse DatetimeValueExpressionTree as ParseDatetimeValueExpression
parse IntervalValueExpressionTree as ParseIntervalValueExpression
parse BooleanValueExpressionTree as ParseBooleanValueExpression
parse SearchConditionTree as ParseSearchCondition
parse PredicateTree as ParsePredicate
parse RowValuePredicandTree as ParseRowValuePredicand
parse ValueExpressionPrimaryTree as ParseValueExpressionPrimary
parse QueryExpression          as ParseQueryExpression
parse QuerySpecification       as ParseQuerySpecification
parse TableReference           as ParseTableReference
parse InsertStatement          as ParseInsertStatement
parse UpdateStatementSearched  as ParseUpdateStatementSearched
parse UpdateStatementPositioned as ParseUpdateStatementPositioned
parse DeleteStatementSearched  as ParseDeleteStatementSearched
parse DeleteStatementPositioned as ParseDeleteStatementPositioned
parse MergeStatement           as ParseMergeStatement
parse TruncateTableStatement   as ParseTruncateTableStatement
parse SQLSchemaStatement       as ParseSQLSchemaStatement
parse DirectSQLStatement       as ParseDirectSQLStatement
parse SQLTransactionStatement  as ParseSQLTransactionStatement
parse SQLConnectionStatement   as ParseSQLConnectionStatement
parse SQLSessionStatement      as ParseSQLSessionStatement
parse SQLDiagnosticsStatement  as ParseSQLDiagnosticsStatement
parse DirectSQLDataStatement   as ParseDirectSQLDataStatement
parse SQLControlStatement      as ParseSQLControlStatement
parse SQLDataStatement         as ParseSQLDataStatement
parse SQLDynamicStatement      as ParseSQLDynamicStatement
parse SQLProcedureStatement    as ParseSQLProcedureStatement