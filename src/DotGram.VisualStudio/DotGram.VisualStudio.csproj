<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<Version>0.1.56</Version>
		<UseWPF>true</UseWPF>
		<Description>Visual Studio tooling for .gram documents.</Description>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<StartAction>Program</StartAction>
		<StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
		<StartArguments>/RootSuffix DotGram</StartArguments>
	</PropertyGroup>

	<PropertyGroup Label="Enabled Polyfills">
		<Polyfill></Polyfill>
		<Polyfill>$(Polyfill)|T:System.HashCode</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Index</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Range</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Diagnostics.CodeAnalysis</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.CallerArgumentExpressionAttribute</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.CompilerFeatureRequiredAttribute</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.IsExternalInit</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.RequiredMemberAttribute</Polyfill>
		<MeziantouPolyfill_IncludedPolyfills>$(Polyfill)</MeziantouPolyfill_IncludedPolyfills>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VisualStudio.LanguageServices" ExcludeAssets="runtime" />
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
		<PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
		<Reference Include="System.ComponentModel.Composition" />
		<Reference Include="PresentationFramework" />
		<Reference Include="PresentationCore" />
		<Reference Include="WindowsBase" />
		<Reference Include="System.Xaml" />
	</ItemGroup>

	<ItemGroup>
		<None Include="source.extension.vsixmanifest" />
		<Content Include="..\..\LICENSE" Link="LICENSE.txt">
			<IncludeInVSIX>true</IncludeInVSIX>
			<TargetPath>LICENSE.txt</TargetPath>
		</Content>
		<Content Include="VSIX.ReleaseNotes.txt">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Assets\DotGram.LetterIcon.16.16.png">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="DotGram.VisualStudio.Icon.pkgdef">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="DotGram.VisualStudio.imagemanifest">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Resource Include="Assets\DotGram.LetterIcon.16.16.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="*.cs" />
		<Compile Include="..\DotGram\Grammar\**\*.cs"
		         Link="Grammar\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The standard library goes wherever Grammar/ goes: StandardLibrary.cs reads it
		     out of the assembly it was compiled into, under this name. -->
		<EmbeddedResource Include="..\DotGram\Grammar\Std.gram"
		                  Link="Grammar\Std.gram" LogicalName="DotGram.Std.gram" />
		<Compile Include="..\DotGram\Generation\RoslynCSharpScanner.cs"
		         Link="Generation\RoslynCSharpScanner.cs" />
		<Compile Include="..\DotGram\Language\**\*.cs"
		         Link="Language\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<Target Name="GetVsixVersion" Returns="$(Version)" />

</Project>
