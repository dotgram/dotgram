<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>

		<!-- The extension ships as a VSIX and never as a NuGet package: say so, so that a pack
		     of everything packable leaves it alone rather than by CI naming the five. -->
		<IsPackable>false</IsPackable>
		<!-- No version here: it takes the repository's, because the three artifacts go out
		     under one tag. `GetVsixVersion` below hands that to the manifest. It used to
		     carry a line of its own, counted up per build and unrelated to the packages;
		     nothing was ever published under it. -->
		<UseWPF>true</UseWPF>
		<Description>Visual Studio tooling for .gram documents.</Description>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<StartAction>Program</StartAction>
		<StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
		<StartArguments>/RootSuffix DotGram</StartArguments>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VisualStudio.LanguageServices" ExcludeAssets="runtime" />
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
		<PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" PrivateAssets="all" />
		<Reference Include="System.ComponentModel.Composition" />
		<Reference Include="PresentationFramework" />
		<Reference Include="PresentationCore" />
		<Reference Include="WindowsBase" />
		<Reference Include="System.Xaml" />
	</ItemGroup>

	<ItemGroup>
		<None Include="source.extension.vsixmanifest" />
		<Content Include="..\..\LICENSE" Link="LICENSE.txt">
			<IncludeInVSIX>true</IncludeInVSIX>
			<TargetPath>LICENSE.txt</TargetPath>
		</Content>
		<Content Include="VSIX.ReleaseNotes.txt">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Assets\DotGram.LetterIcon.16.16.png">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Assets\DotGram.Main.png">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Assets\DotGram.Preview.png">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="DotGram.VisualStudio.Icon.pkgdef">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="DotGram.VisualStudio.imagemanifest">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Resource Include="Assets\DotGram.LetterIcon.16.16.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="*.cs" />
	</ItemGroup>

	<!-- The language itself — the grammar half and the editor-neutral analysis over it — is
	     compiled here from the shared sources rather than referenced: ../DotGram/Language/README.md. -->
	<Import Project="..\DotGram\Language.projitems" />

	<Target Name="GetVsixVersion" Returns="$(Version)" />

</Project>
