<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
	              xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
	              xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
	<Metadata>
		<Identity Id="DotGram.VisualStudio"
		          Version="|%CurrentProject%;GetVsixVersion|"
		          Language="en-US"
		          Publisher="dotgram" />
		<DisplayName>.Gram language support</DisplayName>
		<Description xml:space="preserve">First-class Visual Studio tooling for .Gram parser grammars, both in standalone .gram files and embedded in C# attributes.

Features:
• Theme-aware syntax highlighting and live diagnostics
• Completion, signature help, Quick Info, brace matching, and folding
• Go To Definition, Find All References, reference highlighting, and Rename
• Navigation between grammar rules and generated C# APIs
• Embedded DSL highlighting and diagnostics through StringSyntax

Design grammars and use their generated parsers without leaving the C# editor.</Description>
		<MoreInfo>https://github.com/dotgram/dotgram</MoreInfo>
		<License>LICENSE.txt</License>
		<GettingStartedGuide>https://github.com/dotgram/dotgram/blob/main/docs/syntax.md</GettingStartedGuide>
		<ReleaseNotes>VSIX.ReleaseNotes.txt</ReleaseNotes>
		<Icon>Assets\DotGram.Main.png</Icon>
		<PreviewImage>Assets\DotGram.Preview.png</PreviewImage>
		<Tags>.Gram, DotGram, grammar, parser, language, CSharp</Tags>
	</Metadata>
	<Installation>
		<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
	</Installation>
	<Dependencies>
		<Dependency Id="Microsoft.Framework.NDP"
		            DisplayName="Microsoft .NET Framework"
		            d:Source="Manual"
		            Version="[4.7.2,)" />
	</Dependencies>
	<Prerequisites>
		<Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
		              Version="[17.14,19.0)"
		              DisplayName="Visual Studio core editor" />
	</Prerequisites>
	<Assets>
		<Asset Type="Microsoft.VisualStudio.MefComponent"
		       d:Source="Project"
		       d:ProjectName="%CurrentProject%"
		       Path="|%CurrentProject%;BuiltProjectOutputGroup|" />
		<Asset Type="Microsoft.VisualStudio.VsPackage"
		       d:Source="Project"
		       d:ProjectName="%CurrentProject%"
		       Path="|%CurrentProject%;PkgDefProjectOutputGroup|" />
		<Asset Type="Microsoft.VisualStudio.VsPackage"
		       Path="DotGram.VisualStudio.Icon.pkgdef" />
		<Asset Type="Microsoft.VisualStudio.ImageManifest"
		       Path="DotGram.VisualStudio.imagemanifest" />
	</Assets>
</PackageManifest>
