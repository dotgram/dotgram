<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
	              xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
	              xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
	<Metadata>
		<Identity Id="DotGram.VisualStudio"
		          Version="|%CurrentProject%;GetVsixVersion|"
		          Language="en-US"
		          Publisher="DotGram" />
		<DisplayName>DotGram language support</DisplayName>
		<Description xml:space="preserve">Language support for standalone .gram files and DotGram grammars embedded in C#.</Description>
		<MoreInfo>https://github.com/dotgram/dotgram</MoreInfo>
		<License>LICENSE.txt</License>
		<ReleaseNotes>VSIX.ReleaseNotes.txt</ReleaseNotes>
		<Icon>Assets\DotGram.LetterIcon.16.16.png</Icon>
		<Tags>DotGram, grammar, parser, language, CSharp</Tags>
	</Metadata>
	<Installation>
		<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,19.0)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
	</Installation>
	<Dependencies>
		<Dependency Id="Microsoft.Framework.NDP"
		            DisplayName="Microsoft .NET Framework"
		            d:Source="Manual"
		            Version="[4.7.2,)" />
	</Dependencies>
	<Prerequisites>
		<Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
		              Version="[18.0,19.0)"
		              DisplayName="Visual Studio core editor" />
	</Prerequisites>
	<Assets>
		<Asset Type="Microsoft.VisualStudio.MefComponent"
		       d:Source="Project"
		       d:ProjectName="%CurrentProject%"
		       Path="|%CurrentProject%;BuiltProjectOutputGroup|" />
		<Asset Type="Microsoft.VisualStudio.VsPackage"
		       Path="DotGram.VisualStudio.pkgdef" />
		<Asset Type="Microsoft.VisualStudio.ImageManifest"
		       Path="DotGram.VisualStudio.imagemanifest" />
	</Assets>
</PackageManifest>
