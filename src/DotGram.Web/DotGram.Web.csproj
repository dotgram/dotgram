<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- The floor and the newest, and nothing between: a parser here is ordinary C#
		     over a generated one, so netstandard2.0 is what every consumer can read and
		     net10.0 is what a consumer on the newest runtime gets without the shims. -->
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<RootNamespace>DotGram.Web</RootNamespace>

		<Description>The formats of the web, written in .gram against their specifications: timestamps after RFC 3339, URIs after RFC 3986, email addresses after RFC 5322, language tags after RFC 5646 (BCP 47), the Content-Disposition header field after RFC 6266, cookies after RFC 6265, URI Templates after RFC 6570, JSON Pointer after RFC 6901, JSON Patch after RFC 6902, the Forwarded header field after RFC 7239, JSON after RFC 8259, the Link header field after RFC 8288, media types with the Content-Type and Accept header fields after RFC 9110, and Structured Field Values for HTTP after RFC 9651.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>parser;rfc3339;timestamp;date-time;uri;rfc3986;email;email-address;mailbox;rfc5322;bcp47;language-tag;rfc5646;cookie;set-cookie;rfc6265;content-disposition;filename;rfc6266;uri-template;rfc6570;json-pointer;rfc6901;json-patch;rfc6902;forwarded;proxy;rfc7239;json;rfc8259;link-header;web-linking;rfc8288;media-type;mime;content-type;accept;rfc9110;http;structured-fields;rfc9651;web;dotgram</PackageTags>
		<PackageReleaseNotes>First release: RFC 3339 timestamps, RFC 3986 URIs and relative references, RFC 5322 email addresses, mailboxes and groups in both the receiving and the generating syntax, RFC 5646 language tags (BCP 47), RFC 6265 Set-Cookie and Cookie header fields with cookie dates, RFC 6266 Content-Disposition header fields, RFC 6570 URI Templates with their expansion, RFC 6901 JSON Pointer resolved over RFC 8259 JSON, RFC 6902 JSON Patch read and applied, RFC 7239 Forwarded header fields and their node identifiers, RFC 8288 Link header fields, RFC 9110 media types in Content-Type and Accept with quality values, and RFC 9651 Structured Field Values for HTTP, parsed and serialized.</PackageReleaseNotes>

		<!-- Symbols inside the assembly, as the generator carries them: a stack trace from
		     a parser here has line numbers without a symbol server. -->
		<DebugType>embedded</DebugType>

		<!-- Paths in the PDB and the package normalized to the repository rather than the
		     runner's disk, so that what CI packs can be rebuilt byte for byte from the commit
		     its nuspec names. Here and not in Directory.Build.props: it rewrites every source
		     path, [CallerFilePath] included, to /_/, and nine test classes find the
		     repository from their own file — set for everything, it failed eighty of them.
		     Only on CI, because locally it would point a debugger at /_/. -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Generated files land on disk so a reader can open what the grammars became. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- The generator, and nothing else: a .gram parser acquires no runtime
		     dependency, which is why this can be an ordinary library (docs/syntax.md
		     §6.1). -->
		<ProjectReference Include="..\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<!-- What a consumer on this framework needs: the generated parser's own methods
		     take `ReadOnlySpan<char>`, which is not in the framework there. It is the one
		     dependency this package has, and it has it only here. -->
		<PackageReference Include="System.Memory" />

		<!-- And what the compilation needs rather than the consumer: the records written
		     by hand beside the grammars have `init` accessors, and `IsExternalInit` is not
		     declared on this framework. The polyfill is a generator and emits it as an
		     internal type, so nothing reaches the package. -->
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<MeziantouPolyfill_IncludedPolyfills>T:System.Runtime.CompilerServices.IsExternalInit;T:System.Index;T:System.Range;T:System.Diagnostics.CodeAnalysis</MeziantouPolyfill_IncludedPolyfills>
	</PropertyGroup>

	<ItemGroup>
		<!-- What the package says for itself. The grammars are in the repository and the
		     README points at them: a parser here is worth reading as much as it is worth
		     calling. -->
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
