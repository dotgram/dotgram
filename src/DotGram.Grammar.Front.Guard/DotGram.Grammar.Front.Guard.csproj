<Project Sdk="Microsoft.NET.Sdk">

	<!-- The front of Grammar/ compiled without the language the parser is generated in: the lexer,
	     the parser, the binder, the normalizer, the analyses and the compiler that runs them, with
	     neither the emitters (Grammar/Emit/) nor C# as a target (Grammar/CSharp/) in reach. Building
	     it is the assertion that those stages ask the target language (ITargetLanguage) and know no
	     language themselves: a call of an emitter or of CSharpLanguage there does not build here,
	     wherever else it would. It proves references and nothing more: a message that names C#
	     builds here as well as anywhere. netstandard2.0, as the generator compiles it. Referenced
	     by nothing; its output is the build succeeding. -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
		<!-- `ReadOnlySpan<char>`, which netstandard2.0 lacks; the generator has it through Roslyn. -->
		<PackageReference Include="System.Memory" />
	</ItemGroup>

	<!-- The shared list, less Language/ and less the two folders a target language lives in. -->
	<Import Project="..\DotGram\Language.projitems" />

	<ItemGroup>
		<Compile Remove="..\DotGram\Language\**" />
		<Compile Remove="..\DotGram\Grammar\Emit\**" />
		<Compile Remove="..\DotGram\Grammar\CSharp\**" />
	</ItemGroup>

</Project>
