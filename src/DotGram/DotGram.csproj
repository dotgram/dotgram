<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<!-- Neither RootNamespace nor PackageId: both default to the project name, which
		     is what they should be. Nothing else ships — everything a generated parser
		     needs is emitted into the consumer's own compilation (docs/syntax.md §6.1) —
		     so a .Generator suffix would separate this package from no other.
		     Folders give the namespaces below it: Grammar/ is the Roslyn-free half,
		     Generation/ is the shell. -->
		<Description>Source generator that compiles .gram grammars into C# parsers.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>parser;parser-generator;grammar;source-generator;roslyn;analyzer;codegen;dsl;csharp</PackageTags>

		<!-- The symbols inside the assembly rather than beside it. When the generator fails
		     in somebody else's build — GRAM0001, with the exception in the message — the
		     stack trace has line numbers without a symbol server to fetch them from. -->
		<DebugType>embedded</DebugType>

		<!-- Paths in the PDB and the package normalized to the repository rather than the
		     runner's disk, so that what CI packs can be rebuilt byte for byte from the commit
		     its nuspec names. Here and not in Directory.Build.props: it rewrites every source
		     path, [CallerFilePath] included, to /_/, and nine test classes find the
		     repository from their own file — set for everything, it failed eighty of them.
		     Only on CI, because locally it would point a debugger at /_/. -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Roslyn component: runs inside the compiler, ships as an analyzer. -->
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<DevelopmentDependency>true</DevelopmentDependency>
		<!-- Expected for an analyzer package: it carries no lib/ assemblies by design. -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<!-- Optimized whatever the consumer's configuration is. An analyzer is built in the
	     configuration of the project that references it, and a Debug build of the
	     generator normalizes the SQL grammars with no JIT optimization and every
	     Debug.Assert live: the SQL parsers rebuilt in 56 s that way, 20 s this way, 16 s
	     in Release. The consumer's configuration changes nothing the generator emits,
	     and it should change nothing about how long it takes either. Stepping through
	     the generator itself is the one reason to want it otherwise, and that is what
	     `-p:DebugGenerator=true` is for. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(DebugGenerator)' != 'true'">
		<Optimize>true</Optimize>
		<DefineConstants>$(DefineConstants.Replace('DEBUG', ''))</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Label="Enabled Polyfills">
		<!-- netstandard2.0 is forced on us by Roslyn; these bring back the modern
		     types without adding a runtime dependency — Meziantou.Polyfill is itself
		     a generator and emits them as internal.
		     https://github.com/meziantou/Meziantou.Polyfill -->
		<Polyfill></Polyfill>
		<Polyfill>$(Polyfill)|T:System.HashCode</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Index</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Range</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Diagnostics.CodeAnalysis</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.CallerArgumentExpressionAttribute</Polyfill>
		<!-- `required` needs both of these on netstandard2.0. -->
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.CompilerFeatureRequiredAttribute</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.IsExternalInit</Polyfill>
		<Polyfill>$(Polyfill)|T:System.Runtime.CompilerServices.RequiredMemberAttribute</Polyfill>
		<MeziantouPolyfill_IncludedPolyfills>$(Polyfill)</MeziantouPolyfill_IncludedPolyfills>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pinned to the oldest Roslyn we intend to load into: a generator built
		     against an older Roslyn runs on newer hosts, but not the other way round. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The analyzer SDK picks these up as AdditionalFiles on its own; they only
		     need taking out of the default None glob so they appear once. -->
		<None Remove="AnalyzerReleases.*.md" />

		<!-- The standard library (docs/syntax.md §5.2) travels inside the generator: a
		     grammar that writes `using Std;` gets it spliced on, and there is no other
		     file for it to come from. -->
		<EmbeddedResource Include="Grammar\Std.gram" LogicalName="DotGram.Std.gram" />

		<!-- The writers of the case-fold and category tables are file-based apps (top-level statements, run with
		     `dotnet run`), not part of the generator: the default globbing would compile them in. -->
		<Compile Remove="Grammar/Model/CaseFold.generate.cs" />
		<Compile Remove="Grammar/UnicodeCategories.generate.cs" />

		<!-- Language/ is the editor's half of the shared core (Language/README.md), compiled by
		     the editors from Language.projitems. The analyzer takes only the Roslyn seams it shares
		     with them — the scanner of @(...), the walk of included grammars, the reading of
		     [Gram] and the map of a string literal's value onto its spelling — and none of the rest, which is editor code and needs Roslyn's Workspaces. -->
		<Compile Remove="Language/**" />
		<Compile Include="Language/RoslynCSharpScanner.cs;Language/GramIncludes.cs;Language/GramHostOptions.cs;Language/CSharpStringMap.cs" />

		<!-- The package's own README, not the repository's. The two answer different
		     questions: the front page argues for the project and the package tells
		     somebody who has already installed it what to write. It links back rather
		     than repeating what it links to. -->
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="build/DotGram.targets" Pack="true" PackagePath="build/" />

		<!-- And the skill beside it, so that an agent working in a project that has
		     restored this package can read how to write a grammar without leaving the
		     machine. The README says where it is, in a comment nothing renders. -->
		<None Include="SKILL.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- The package ships no lib/ assembly, so nothing outside this repository compiles against these
		     types, and they are internal. The tests call the stages one by one and read what they
		     produce; DotGram.Cli, whose assembly is dotnet-dotgram, reads the marker attributes' text. -->
		<InternalsVisibleTo Include="dotnet-dotgram" />
		<InternalsVisibleTo Include="DotGram.Tests" />
		<InternalsVisibleTo Include="DotGram.Tests.Slow" />
		<InternalsVisibleTo Include="DotGram.Determinism.Tests" />
		<!-- The generator class itself is internal too: Roslyn finds a generator by its [Generator] attribute
		     and creates it through its public constructor, whatever the class's own accessibility. The tool's
		     tests and the stand's compile row create one directly. -->
		<InternalsVisibleTo Include="DotGram.Cli.Tests" />
		<InternalsVisibleTo Include="DotGram.CompileRow" />
	</ItemGroup>

	<ItemGroup>
		<!-- What is public here is in the baseline, so that a type or a member made public is a line in a
		     diff and not an accident. Three enums are public only because the tests' theories take them as
		     parameters, and an xUnit theory is a public method. What a consumer does see, the attributes
		     the generator emits, is text and is held to its own list by a test (GeneratedAttributeSurfaceTests). -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
		<!-- The package adds the two files as AdditionalFiles itself; out of None, they appear once. -->
		<None Remove="PublicAPI.*.txt" />
	</ItemGroup>

	<!-- Puts the assembly in the analyzer folder of the package. Done as a pack-time
	     target rather than a None item pointing into bin: a None item makes Solution
	     Explorer materialise a bin node even with Visible="false". -->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackGeneratorAsAnalyzer</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="PackGeneratorAsAnalyzer">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

	<!-- The assembly reaches the output directory by an atomic replace, not by the SDK's copy. Visual Studio
	     loads the generator from that path and watches it: the moment the file changes, Roslyn copies it
	     again and reloads it. The SDK copies in place, so the editor can take a half-written copy — the
	     generator is then lost for the session: [Gram] is CS0246, the analyzer node under Dependencies is
	     empty — and Roslyn's analyzer cache (%TEMP%\Roslyn\AnalyzerPathResolver), which files its copies by
	     path, MVID and size, can keep serving such a copy for every later build of the same sources, since a
	     deterministic build changes neither. Replacing the file in one step gives the editor either the old
	     file or the whole new one. -->
	<PropertyGroup>
		<CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
	</PropertyGroup>

	<!-- File.Replace is one rename on every platform (ReplaceFile on Windows, rename(2) elsewhere) and exists
	     on .NET Framework as well as .NET, so it serves Visual Studio's MSBuild and `dotnet build` alike; a
	     destination that does not exist yet is moved into place. The retries are the ones the SDK's Copy has:
	     another process may hold the destination for a moment (the editor copying it, a virus scanner). -->
	<UsingTask TaskName="_DotGramReplaceFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Source ParameterType="System.String" Required="true" />
			<Destination ParameterType="System.String" Required="true" />
			<Retries ParameterType="System.Int32" />
			<RetryDelayMilliseconds ParameterType="System.Int32" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Threading" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				for (var attempt = 0; ; attempt++)
				{
					try
					{
						if (File.Exists(Destination))
						{
							File.Replace(Source, Destination, null, true);
						}
						else
						{
							File.Move(Source, Destination);
						}
						break;
					}
					catch (Exception e) when ((e is IOException || e is UnauthorizedAccessException) && attempt < Retries)
					{
						Log.LogMessage(MessageImportance.Normal, "Could not replace \"{0}\" ({1}); retrying in {2} ms, attempt {3} of {4}.",
							Destination, e.Message, RetryDelayMilliseconds, attempt + 1, Retries);
						Thread.Sleep(RetryDelayMilliseconds);
					}
				}
			]]></Code>
		</Task>
	</UsingTask>

	<Target Name="PlaceGeneratorByRename" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="_PlaceGeneratorByRenameCore"
	        Condition="'$(SkipCopyBuildProduct)' != 'true'">
		<!-- What the SDK's copy would have declared: the reference assembly, which has its own change
		     check, and the outputs IncrementalClean must not take for stale — the staging file among
		     them, so that a clean removes one a failed build left behind. -->
		<CopyRefAssembly SourcePath="@(IntermediateRefAssembly)" DestinationPath="$(TargetRefPath)"
		                 Condition="'$(ProduceReferenceAssembly)' == 'true'">
			<Output TaskParameter="DestinationPath" ItemName="ReferenceAssembly" />
			<Output TaskParameter="DestinationPath" ItemName="FileWrites" />
		</CopyRefAssembly>
		<ItemGroup>
			<MainAssembly Include="$(TargetPath)" />
			<FileWrites Include="$(TargetPath)" />
			<FileWrites Include="$(TargetPath).staging" />
		</ItemGroup>
	</Target>

	<Target Name="_PlaceGeneratorByRenameCore" Inputs="@(IntermediateAssembly)" Outputs="$(TargetPath)"
	        Condition="'$(SkipCopyBuildProduct)' != 'true'">
		<Copy SourceFiles="@(IntermediateAssembly)" DestinationFiles="$(TargetPath).staging"
		      Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
		<_DotGramReplaceFile Source="$(TargetPath).staging" Destination="$(TargetPath)"
		                     Retries="$(CopyRetryCount)" RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
		<Message Importance="High" Text="$(MSBuildProjectName) -&gt; $(TargetPath)" />
	</Target>

</Project>
