// The standard library: the lexemes every grammar writes and none should have to.
//
// Every grammar has it, named in full — `Std.Integer`, `Std.LineComment("--")` — or
// opened with `using Std;` (syntax.md §5.2). A grammar of its own, so its trivia is the
// built-in one and a token is its characters with nothing between them; the grammar
// calling it spaces and comments around the call as it does around anything else
// (§4.5). Whatever is not called is not compiled.
//
// What a lexeme means is left to the caller wherever meaning takes code — a string's
// escapes — because there is no class behind this file to put that code in. The values
// below are what the .NET parsers make of the text. A number too wide for its type is
// not a number of that rule: the rule refuses it, as it refuses a letter, and never throws.

// ── One character ────────────────────────────────────────────────────────────

Digit      = ['0'..'9']
HexDigit   = ['0'..'9' | 'a'..'f' | 'A'..'F']
Letter     = [\p{L}]
Space      = [' ' | '\t']
Whitespace = [' ' | '\t' | '\r' | '\n']

// ── Runs of them ─────────────────────────────────────────────────────────────
//
// Each run is atomic: it reads to the end of what it recognizes and never hands a character
// back, which is what a lexeme means (syntax.md §3.2) and what keeps a run beside a seam
// from being read two ways.

Digits     = { Digit+ }
HexDigits  = { HexDigit+ }
Blank      = { Space+ }
Spacing    = { Whitespace+ }

// A letter or an underscore, then letters, digits and underscores: the identifier of
// C, C# and most of what was written after them, in the Unicode reading.
Identifier = { [\p{L} | '_'] & [\p{L} | \p{Nd} | '_']* }

// ── Numbers, as values ───────────────────────────────────────────────────────
//
// Read as the invariant culture reads them, so that a grammar means the same thing on
// every machine. Unsigned: a sign is the calling grammar's business, because whether
// `-` is part of a number or an operator in front of one is a question about that
// grammar and not about digits.

Integer : int     = n: Digits & when @(n.Length <= 9 || int.TryParse(n, global::System.Globalization.CultureInfo.InvariantCulture, out _)) => @(int.Parse(n, global::System.Globalization.CultureInfo.InvariantCulture))
Long    : long    = n: Digits & when @(n.Length <= 18 || long.TryParse(n, global::System.Globalization.CultureInfo.InvariantCulture, out _)) => @(long.Parse(n, global::System.Globalization.CultureInfo.InvariantCulture))
Decimal : decimal = n: (Digits & ('.' & Digits)?)
	& when @(n.Length <= 28 || decimal.TryParse(n, global::System.Globalization.NumberStyles.AllowDecimalPoint, global::System.Globalization.CultureInfo.InvariantCulture, out _))
	=> @(decimal.Parse(n, global::System.Globalization.NumberStyles.AllowDecimalPoint, global::System.Globalization.CultureInfo.InvariantCulture))
Double  : double  = m: (Digits & ('.' & Digits)?) & ('e'i & ['+' | '-']? & Digits)?
	& when @(parserText.Length == m.Length && m.Length <= 308 || double.TryParse(parserText, global::System.Globalization.NumberStyles.Float, global::System.Globalization.CultureInfo.InvariantCulture, out var d) && double.IsFinite(d))
	=> @(double.Parse(parserText, global::System.Globalization.NumberStyles.Float, global::System.Globalization.CultureInfo.InvariantCulture))

// ── Comments ─────────────────────────────────────────────────────────────────
//
// Parameterized by what opens and closes them, since that is all that differs between
// one language's comment and the next: `LineComment("--")`, `BlockComment("/*", "*/")`.
// The line comment stops short of the line ending and leaves it, so that a grammar
// which counts lines still sees every one.

LineComment(start)        = { start & [^ '\r' | '\n']* }
BlockComment(open, close) = open & (?!close & any)* & close

// A pair that holds others: `Nested("/*", "*/")` reads `/* a /* b */ c */` whole. Inside
// it `close` is asked first and an `open` always opens another, so it ends where its
// opens and closes balance, at any depth; one that never balances is refused where it
// opened. The rule is the meaning, and what reads it with the engine reads it so; a
// scanner and a lexer read it with a counter instead, which is why both arguments have
// to be literals that cannot begin at one place (syntax.md §5.2).

Nested(open, close) = open & (?!close & (Nested(open, close) | ?!open & any))* & close

// ── Quoted text ──────────────────────────────────────────────────────────────
//
// The two ways a quote is written inside what it quotes. `Quoted('\'')` doubles it,
// as SQL and CSV do; `Escaped('"', '\\')` puts an escape character in front of it —
// and in front of anything else, which is what the escape character means. Both give
// back the text between the quotes as written, escapes and all: what an escape stands
// for differs between languages that agree on how it is spelled.
//
// Written with the until idiom, `(?!quote & any)*`, and not with an element set: a set
// names its characters and cannot take a parameter, and the idiom is the one shape of
// lookahead a lexer reads as a pattern (§6.3) — so these are tokens in a grammar read
// over tokens, and read the same over characters. The `?!escape` on the plain
// alternative is what makes that last part true: over characters a repetition hands
// back what it read when the closing quote is not there, and without it `"a\"` would
// be read as the string `a\` — the escape alone, and the quote after it as the end.

Quoted(quote)          = quote & (?!quote & any)* & (quote & quote & (?!quote & any)*)* & quote
Escaped(quote, escape) = quote & (?!quote & (escape & any | ?!escape & any))* & quote
