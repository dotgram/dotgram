<Project Sdk="Microsoft.NET.Sdk">

	<!-- A probe, not a shipped tool: dumps the span of every node the located PostgreSQL reading
	     gives over the regression corpus, so that two builds of the parser can be compared node by
	     node, and times the plain and the located reading over the same statements. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DotGram.Sql\DotGram.Sql.csproj" />
		<Compile Include="..\..\benchmarks\DotGram.Benchmarks\PgCorpus.cs" Link="PgCorpus.cs" />
	</ItemGroup>

</Project>
