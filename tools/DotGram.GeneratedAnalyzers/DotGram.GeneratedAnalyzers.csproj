<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<!-- An internal tool, never packed: it inspects the generator's OWN output for
		     dead or redundant code, on request (DotGramAnalyzeGenerated=true), never as
		     part of a shipped package. -->
		<IsPackable>false</IsPackable>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The analyzer SDK picks these up as AdditionalFiles on its own; only needs taking
		     out of the default None glob so it does not appear twice (RS2008). -->
		<None Remove="AnalyzerReleases.*.md" />
	</ItemGroup>

</Project>
