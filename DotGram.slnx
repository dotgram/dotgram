<Solution>
	<Configurations>
		<BuildType Name="Debug" />
		<BuildType Name="Release" />
		<!-- What a machine without Visual Studio can build: every project compiled as
		     Release, minus the two that need the VS SDK. The VSIX and its tests are
		     Windows-only by nature, and this is where that is written down. -->
		<BuildType Name="Linux" />
	</Configurations>
	<Folder Name="/.agents/">
		<File Path="CLAUDE.md" />
		<Project Path=".claude/.claude.csproj">
			<Build Project="false" />
		</Project>
	</Folder>
	<Folder Name="/.root/">
		<File Path=".editorconfig" />
		<File Path=".gitattributes" />
		<File Path=".gitignore" />
		<File Path="Directory.Build.props" />
		<File Path="Directory.Packages.props" />
		<File Path="LICENSE" />
		<File Path="README.md" />
	</Folder>
	<Folder Name="/benchmarks/">
		<File Path="benchmarks/README.md" />
		<Project Path="benchmarks/DotGram.Benchmarks/DotGram.Benchmarks.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
		<Project Path="benchmarks/DotGram.HandDeferred/DotGram.HandDeferred.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
	</Folder>
	<Folder Name="/docs/">
		<File Path="docs/implementation.md" />
		<File Path="docs/status.md" />
		<File Path="docs/syntax.md" />
	</Folder>
	<Folder Name="/examples/">
		<File Path="examples/README.md" />
		<Project Path="examples/DotGram.Examples/DotGram.Examples.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
	</Folder>
	<Folder Name="/src/">
		<Project Path="src/DotGram/DotGram.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
		<Project Path="src/DotGram.ExpressionLanguage/DotGram.ExpressionLanguage.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
		<Project Path="src/DotGram.Parsers/DotGram.Parsers.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
		<Project Path="src/DotGram.VisualStudio/DotGram.VisualStudio.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
			<Build Solution="Linux|*" Project="false" />
		</Project>
	</Folder>
	<Folder Name="/tests/">
		<Project Path="tests/DotGram.VisualStudio.Tests/DotGram.VisualStudio.Tests.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
			<Build Solution="Linux|*" Project="false" />
		</Project>
		<Project Path="tests/DotGram.Tests/DotGram.Tests.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
		<Project Path="tests/DotGram.Compatibility/DotGram.Compatibility.csproj">
			<BuildType Solution="Linux|*" Project="Release" />
		</Project>
		<Project Path="tests/Snapshots/Snapshots.csproj">
			<Build Project="false" />
		</Project>
	</Folder>
</Solution>
