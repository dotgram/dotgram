@using DotGram.Finance.Fix44;
using Known;

context : @Fix44Context

Separator    = ['\u0001']
LogSeparator = ' '* & '|' & ' '*
ValueText    = (?!Separator & any)+
Digits       = ['1'..'9'] & ['0'..'9']*
Size         = ['0'..'9']+
Position : @int = none => @(parserSpan.Start)

// Only binary pairs need a byte limit. Ordinary fields never enter these rules.
Block4096 = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 4096) & any{4096}
Block256  = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 256) & any{256}
Block16   = when @(context.DataLimit - parserSpan.Start - parserSpan.Length >= 16) & any{16}
Octet     = when @(parserSpan.Start + parserSpan.Length < context.DataLimit) & any
Data = { Block4096* & Block256* & Block16* & Octet* & when @(parserSpan.Start + parserSpan.Length == context.DataLimit) }

// A length field announces its data; the data field after it reads that many.
KnownBinary : @FixField =
	"93=" & size: Size & when @(context.Expect(89, size)) => @(new FixField.Integer(FixTag.SignatureLength, FixConvert.ToInteger(size)))
	| "89=" & start: Position & when @(context.Takes(89, start)) & value: Data => @(new FixField.Data(FixTag.Signature, FixConvert.ToData(value)))
	| "90=" & size: Size & when @(context.Expect(91, size)) => @(new FixField.Integer(FixTag.SecureDataLen, FixConvert.ToInteger(size)))
	| "91=" & start: Position & when @(context.Takes(91, start)) & value: Data => @(new FixField.Data(FixTag.SecureData, FixConvert.ToData(value)))
	| "95=" & size: Size & when @(context.Expect(96, size)) => @(new FixField.Integer(FixTag.RawDataLength, FixConvert.ToInteger(size)))
	| "96=" & start: Position & when @(context.Takes(96, start)) & value: Data => @(new FixField.Data(FixTag.RawData, FixConvert.ToData(value)))
	| "212=" & size: Size & when @(context.Expect(213, size)) => @(new FixField.Integer(FixTag.XmlDataLen, FixConvert.ToInteger(size)))
	| "213=" & start: Position & when @(context.Takes(213, start)) & value: Data => @(new FixField.Data(FixTag.XmlData, FixConvert.ToData(value)))
	| "348=" & size: Size & when @(context.Expect(349, size)) => @(new FixField.Integer(FixTag.EncodedIssuerLen, FixConvert.ToInteger(size)))
	| "349=" & start: Position & when @(context.Takes(349, start)) & value: Data => @(new FixField.Data(FixTag.EncodedIssuer, FixConvert.ToData(value)))
	| "350=" & size: Size & when @(context.Expect(351, size)) => @(new FixField.Integer(FixTag.EncodedSecurityDescLen, FixConvert.ToInteger(size)))
	| "351=" & start: Position & when @(context.Takes(351, start)) & value: Data => @(new FixField.Data(FixTag.EncodedSecurityDesc, FixConvert.ToData(value)))
	| "352=" & size: Size & when @(context.Expect(353, size)) => @(new FixField.Integer(FixTag.EncodedListExecInstLen, FixConvert.ToInteger(size)))
	| "353=" & start: Position & when @(context.Takes(353, start)) & value: Data => @(new FixField.Data(FixTag.EncodedListExecInst, FixConvert.ToData(value)))
	| "354=" & size: Size & when @(context.Expect(355, size)) => @(new FixField.Integer(FixTag.EncodedTextLen, FixConvert.ToInteger(size)))
	| "355=" & start: Position & when @(context.Takes(355, start)) & value: Data => @(new FixField.Data(FixTag.EncodedText, FixConvert.ToData(value)))
	| "356=" & size: Size & when @(context.Expect(357, size)) => @(new FixField.Integer(FixTag.EncodedSubjectLen, FixConvert.ToInteger(size)))
	| "357=" & start: Position & when @(context.Takes(357, start)) & value: Data => @(new FixField.Data(FixTag.EncodedSubject, FixConvert.ToData(value)))
	| "358=" & size: Size & when @(context.Expect(359, size)) => @(new FixField.Integer(FixTag.EncodedHeadlineLen, FixConvert.ToInteger(size)))
	| "359=" & start: Position & when @(context.Takes(359, start)) & value: Data => @(new FixField.Data(FixTag.EncodedHeadline, FixConvert.ToData(value)))
	| "360=" & size: Size & when @(context.Expect(361, size)) => @(new FixField.Integer(FixTag.EncodedAllocTextLen, FixConvert.ToInteger(size)))
	| "361=" & start: Position & when @(context.Takes(361, start)) & value: Data => @(new FixField.Data(FixTag.EncodedAllocText, FixConvert.ToData(value)))
	| "362=" & size: Size & when @(context.Expect(363, size)) => @(new FixField.Integer(FixTag.EncodedUnderlyingIssuerLen, FixConvert.ToInteger(size)))
	| "363=" & start: Position & when @(context.Takes(363, start)) & value: Data => @(new FixField.Data(FixTag.EncodedUnderlyingIssuer, FixConvert.ToData(value)))
	| "364=" & size: Size & when @(context.Expect(365, size)) => @(new FixField.Integer(FixTag.EncodedUnderlyingSecurityDescLen, FixConvert.ToInteger(size)))
	| "365=" & start: Position & when @(context.Takes(365, start)) & value: Data => @(new FixField.Data(FixTag.EncodedUnderlyingSecurityDesc, FixConvert.ToData(value)))
	| "445=" & size: Size & when @(context.Expect(446, size)) => @(new FixField.Integer(FixTag.EncodedListStatusTextLen, FixConvert.ToInteger(size)))
	| "446=" & start: Position & when @(context.Takes(446, start)) & value: Data => @(new FixField.Data(FixTag.EncodedListStatusText, FixConvert.ToData(value)))
	| "618=" & size: Size & when @(context.Expect(619, size)) => @(new FixField.Integer(FixTag.EncodedLegIssuerLen, FixConvert.ToInteger(size)))
	| "619=" & start: Position & when @(context.Takes(619, start)) & value: Data => @(new FixField.Data(FixTag.EncodedLegIssuer, FixConvert.ToData(value)))
	| "621=" & size: Size & when @(context.Expect(622, size)) => @(new FixField.Integer(FixTag.EncodedLegSecurityDescLen, FixConvert.ToInteger(size)))
	| "622=" & start: Position & when @(context.Takes(622, start)) & value: Data => @(new FixField.Data(FixTag.EncodedLegSecurityDesc, FixConvert.ToData(value)))

// Reserved for a future grammar extension; never matches by default.
// The consuming shape keeps the yielded Field non-nullable even with an EOF terminator.
CustomFiled : @FixField = any & when @(false) => @(null!)

Unknown : @FixField =
	tag: Digits & when @(Fix44Context.IsUnknownText(tag)) & '=' & value: ValueText
	=> @(new FixField.Invalid((FixTag)Fix44Context.Tag(tag), value))

Field : @FixField =
	{ ?=any } & when @(context.Next()) & (v: KnownBinary | v: KnownField(ValueText) | v: CustomFiled | v: Unknown) & end: (Separator | eof) => @(v.WithTerminator(end.Length))

Fields : @FixField[] = Field* recover Separator
	=> @(new FixField.Invalid(parserText, parserSpan.Start, parserMessage))

parse Fields stream bytes
parse Fields with (Separator = LogSeparator) as ParseLogFields stream bytes
parse Fields as ReadFields stream bytes yield : @FixField
parse Fields with (Separator = LogSeparator) as ReadLogFields stream bytes yield : @FixField
