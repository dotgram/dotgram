	  => @(new FixField.Integer(FixTag.Nested3PartyRole, FixConvert.ToInteger(value)))

	// 952: NoNested3PartySubIDs (NumInGroup)
	| { "952=" & value: text }
	  => @(new FixField.Integer(FixTag.NoNested3PartySubIDs, FixConvert.ToInteger(value)))

	// 953: Nested3PartySubID (String)
	| { "953=" & value: text }
	  => @(new FixField.Text(FixTag.Nested3PartySubID, FixConvert.ToText(value)))

	// 954: Nested3PartySubIDType (int)
	| { "954=" & value: text }
	  => @(new FixField.Integer(FixTag.Nested3PartySubIDType, FixConvert.ToInteger(value)))

	// 955: LegContractSettlMonth (MonthYear)
	| { "955=" & value: text }
	  => @(new FixField.MonthYear(FixTag.LegContractSettlMonth, FixConvert.ToMonthYear(value)))

	// 956: LegInterestAccrualDate (LocalMktDate)
	| { "956=" & value: text }
