// Reading policy is supplied by the handwritten Fix44Grammar.gram.
@using DotGram.Finance.Fix;

KnownField(text) : @FixField =
	// 1: Account (String)
	{ "1=" & value: text }
	  => @(new FixField.Text(FixTag.Account, FixConvert.ToText(value)))

