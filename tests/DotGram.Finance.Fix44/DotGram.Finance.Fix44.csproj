<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.Finance.Fix44</RootNamespace>
		<IsPackable>false</IsPackable>

		<!-- One literal alternative per standard tag is what this grammar is for, and its reading
		     methods pass the size the JIT optimizes (GRAM5003, eight of them at line 66). That is
		     known and chosen: this is the oracle the package is held against, not what ships, and
		     splitting its one rule would make it a different grammar. So it is silenced here, and
		     here only, rather than printed on every green build where a warning nobody acts on
		     teaches everyone to ignore warnings. That GRAM5003 is reported where it should be is
		     the generator's own tests' to hold (DotGram.Tests.Slow). -->
		<NoWarn>$(NoWarn);GRAM5003</NoWarn>

		<!-- Generated files land on disk so a reader can open what the grammar became. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- The field model and conversions are Finance's; the grammar is written against them. -->
		<ProjectReference Include="../../src/DotGram.Finance/DotGram.Finance.csproj" />
		<InternalsVisibleTo Include="DotGram.Finance.Fix44.Tests" />
		<AdditionalFiles Include="*.gram" />
		<ProjectReference Include="../../src/DotGram/DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
