<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<RootNamespace>DotGram.VisualStudio.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<!-- What the extension is tried against by hand: the grammars of Playground/, which
		     are compiled here so that Visual Studio has a real compilation behind them. A
		     file the editor cannot resolve types in exercises half the extension. -->
		<PackageReference Include="System.Memory" />
		<!-- StringSyntax is what the playground annotates its literals with, and .NET
		     Framework has no such attribute. The polyfill declares one here, which is
		     all the extension needs: it reads the annotation by name. -->
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<MeziantouPolyfill_IncludedPolyfills>T:System.Diagnostics.CodeAnalysis</MeziantouPolyfill_IncludedPolyfills>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="Playground\VisualStudioToolingPlayground.gram" />
		<AdditionalFiles Include="Playground\ToolingQuery.gram" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\DotGram.VisualStudio\DotGram.VisualStudio.csproj" />
		<Compile Include="..\DotGram.Tests\EmittedCode.cs" Link="EmittedCode.cs" />
	</ItemGroup>

</Project>
