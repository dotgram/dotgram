<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<RootNamespace>DotGram.VisualStudio.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<!-- PlaygroundAdapterTests drives the extension's own adapters over the playground and holds them to
	     its recorded answers: they need the editor's assemblies at run time, a WPF dispatcher for Quick
	     Info's panels, and Moq for the editor's views and sessions. -->
	<PropertyGroup>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.SDK" />
		<PackageReference Include="Microsoft.VisualStudio.LanguageServices" />
		<PackageReference Include="Moq" />
	</ItemGroup>

	<ItemGroup>
		<!-- What the extension is tried against by hand: the grammars of Playground/, which
		     are compiled here so that Visual Studio has a real compilation behind them. A
		     file the editor cannot resolve types in exercises half the extension. -->
		<PackageReference Include="System.Memory" />
		<!-- StringSyntax is what the playground annotates its literals with, and .NET
		     Framework has no such attribute. The polyfill declares one here, which is
		     all the extension needs: it reads the annotation by name. -->
		<PackageReference Include="Meziantou.Polyfill" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<!-- The playground is written to try the extension's tooling on every directive, a find among them
		     (ToolingFound, over the rule Row). A file with a find is read by the engine, so a rule that ends
		     in a run is read without its settled copy (GRAM5022); nothing here reads a long run refused at
		     its end, and the grammars are shown to Visual Studio, not run. -->
		<NoWarn>$(NoWarn);GRAM5022</NoWarn>
		<MeziantouPolyfill_IncludedPolyfills>T:System.Diagnostics.CodeAnalysis</MeziantouPolyfill_IncludedPolyfills>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="Playground\VisualStudioToolingPlayground.gram" />
		<AdditionalFiles Include="Playground\ToolingQuery.gram" />
		<AdditionalFiles Include="Playground\RecoveryPlayground.gram" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\DotGram.VisualStudio\DotGram.VisualStudio.csproj" />
		<Compile Include="..\DotGram.Tests\EmittedCode.cs" Link="EmittedCode.cs" />
	</ItemGroup>

</Project>
