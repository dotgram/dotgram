// Manual standalone .gram tooling playground.
//
// Keep new standalone editor scenarios in this file. Run the checks below in the
// experimental Visual Studio instance (RootSuffix DotGram). The grammar is an
// AdditionalFile compiled into the StandaloneVisualStudioToolingPlayground host class.

@using System.Globalization;

trivia = [' ' | '\t']*

// Hover Sum or its Product references: classified Quick Info should appear and
// referenced rules should expand by link. F12/Shift+F12 on Product should navigate
// to its declaration/show every occurrence. The navigation dropdown should track
// the current rule and navigate when another rule is selected.
Sum     : @decimal = left: Sum     & op: ['+' | '-'] & right: Product => @(op == "+" ? left + right : left - right)
                   | value: Product                                   => @(value)

// Shift+F12 on the capture `left` should list its definition and both uses inside
// @(...). Ctrl+R, Ctrl+R should rename all three occurrences together.
Product : @decimal = left: Product & op: ['*' | '/'] & right: Unary   => @(op == "*" ? left * right : left / right)
                   | value: Unary                                     => @(value)

// Temporarily type after @ or inside @(...), then press Ctrl+Space. For example:
// @dec or @(decimal.Pa). Roslyn completion should appear; undo the edit afterward.
Unary   : @decimal = '-' & operand: Unary                             => @(-operand)
                   | value: Power                                     => @(value)

// F12 on decimal or Parse should open Metadata-as-Source; hover should show
// classified Roslyn Quick Info. Click beside (), [], or {} and collapse this
// multiline rule/comment to check brace matching and folding.
Primary : @decimal = '(' & inner: Sum & ')'                           => @(inner)
                   | digits: ['0'..'9']+                              => @(decimal.Parse(digits, CultureInfo.InvariantCulture))

// F12 on Raise should navigate from this standalone .gram file to the user method in
// VisualStudioToolingPlayground.gram.cs. Hover should show Roslyn Quick Info.
Power   : @decimal = value: Primary                                   => @(Raise(value, 1))

// Put the caret after `Digits(` or inside its arguments and press Ctrl+Shift+Space.
// Expected: parameterized-rule signature help shows n and keeps the active argument.
Digits(n) = ['0'..'9']{n}
Fixed     = Digits(4)

// `~` is a sequence with no trivia seam. It should use the special-symbol color;
// hovering it should say "sequence without trivia".
Shift = '>' ~ '>'

// Case-insensitive literals should retain a string-like theme color while remaining
// visually distinct from ordinary literals.
Insensitive = "select"i | 'x'i
// Temporarily uncomment the next rule. Case-insensitive characters are literal
// tokens, not character-set elements: only each `i` suffix should be underlined.
//InvalidRange = ['a'i .. 'z'i]

// `?` immediately after a rule name marks a rule that may give back within its body.
// It remains a special symbol, but its hover must describe rule backtracking rather
// than an optional expression. The trailing `?` keeps the ordinary optional hint.
Backtracking? = 'x'?

// `recover` lives in RecoveryPlayground.gram and not here, and the reason is worth the
// line: a recovering repetition anywhere in a file turns on line and column tracking, and
// GRAM4026 then refuses buffered byte input for every publication in that file -- including
// ToolingLazy below, in a namespace of its own. One file cannot hold both checks.
Row  = ['a'..'z']+

// Lookahead both ways. `?=` and `?!` are one token each: hovering either must name it --
// "positive lookahead", "negative lookahead" -- and neither may read as a `?` beside an
// `=` or a `!`, which is what a two-character token is for.
Guarded  = ?= 'a' & Row
Excluded = ?! 'z' & Row

// A mark and what stands under it (7.8): the newest corner of the language, and the one
// nothing here could see until now. `state` and `with` are keywords, and the `@(...)`
// after `with state` is C# -- Roslyn colors inside it, and Ctrl+Space completes there.
// Comment out the `state` line: the squiggle should name GRAM4029, because a mark needs
// a type to be written in. Give the mark a value that names a capture of its own
// alternative and it should name GRAM4030.
state : @int
Marked = 'm' & Row with state @(1)

// F12 on ToolingEvaluate should open the generated C# publication method.
parse Sum as ToolingEvaluate

// The rules above this line are here to be hovered rather than to be read from, and
// `Sum` reaches none of them — which is what GRAM4018 is for. Publishing them is what
// says they are meant: each becomes an entry point of its own, so F12 on any of the
// names lands in a generated method the way it does on `Sum`. `Digits` needs none of
// its own, being reached through `Fixed`; a parameterized rule has no publication.
parse Fixed        as ToolingFixed
parse Shift        as ToolingShift
parse Insensitive  as ToolingInsensitive
parse Backtracking as ToolingBacktracking
parse Guarded      as ToolingGuarded
parse Excluded     as ToolingExcluded
parse Marked       as ToolingMarked

// `find` is a directive of its own, not an expression: the word before a rule, and `as`
// after it, exactly as `parse` takes them. F12 on `Row` here and on `ToolingFound` should
// both navigate, one into this file and one into the generated method.
find Row as ToolingFound

// Check keyword colors for switch/case/default and C# colors in the selector.
// F12 on Insensitive inside the selected branch should open its rule above.
Selected = switch @(1) { case 1: Insensitive; default: 'x' }
parse Selected as ToolingSelected : @string

// Check stream/bytes/yield and the C# int keyword in the output contract.
namespace LazyExample
{
	trivia = none
	LazyItem : @int = 'x' => @(1)
	LazyItems : @int[] = LazyItem*
	parse LazyItems as ToolingLazy stream bytes yield : @int
}
