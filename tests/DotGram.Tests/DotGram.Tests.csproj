<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>

		<!-- Generated files land on disk so they can be read and diffed as code. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- The grammar the generator compiles for real, during this project's own build.
		     The same file the snapshot is taken of and the in-memory tests compile, so
		     all three levels are looking at one grammar. -->
		<AdditionalFiles Include="..\Snapshots\Url.gram" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<!-- For driving the generator in memory and reading back what it produced. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- Twice, deliberately: once as an analyzer so the generator actually runs over
		     this project, once as an ordinary reference so tests can call into it
		     directly. Without the second, only end-to-end effects are observable. -->
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="AnalyzerReference" ReferenceOutputAssembly="true" />

		<!-- The examples carry no test framework so they can be copied as they stand;
		     this project is what runs them. -->
		<ProjectReference Include="..\..\examples\DotGram.Examples\DotGram.Examples.csproj" />

		<!-- And the parsers, for the same reason and one more: they are the only place
		     the generator runs against a real Roslyn compilation of a real grammar, so
		     what only a true symbol resolver can reach is reachable from here. -->
		<ProjectReference Include="..\..\src\DotGram.Parsers\DotGram.Parsers.csproj" />
		<ProjectReference Include="..\..\src\DotGram.ExpressionLanguage\DotGram.ExpressionLanguage.csproj" />
	</ItemGroup>

</Project>
