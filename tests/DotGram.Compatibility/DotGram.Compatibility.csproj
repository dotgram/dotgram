<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  What a consumer needs, framework by framework:

	      net8.0            nothing
	      netstandard2.0    System.Memory, for `ReadOnlySpan<char>`

	  Two compatibility surfaces exist and only one of them is the analyzer's own target
	  framework. That one is settled: the generator is netstandard2.0 so that every compiler
	  host can load it. This project is about the other — that what the generator writes
	  compiles in a consumer that is not the newest thing available.

	  It runs no tests and asserts nothing. Building it is the assertion: a grammar goes in,
	  a parser comes out, and the C# compiler of an older target framework accepts it. A
	  member the generator stopped emitting, or a language feature it started emitting,
	  fails this build rather than somebody else's.
	-->

	<PropertyGroup>
		<TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
		<RootNamespace>DotGram.Compatibility</RootNamespace>
		<IsPackable>false</IsPackable>

		<!-- The floor the emitted code declares, not the newest an SDK would give. C# 8,
		     because every generated file opens with `#nullable enable` and that needs it,
		     and nothing emitted needs more.

		     Building at the floor is the assertion. A language feature the emitter starts
		     using fails here rather than in somebody else's build, which is what the
		     netstandard2.0 target already does for framework surface. -->
		<LangVersion>8.0</LangVersion>

		<!-- Off: the file it generates is C# 10 and would fail the floor before anything
		     of ours was judged. A consumer at the floor has no implicit usings either. -->
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<!-- What a consumer on this framework has to add, and the reason this project
		     exists: the generated parser's own methods take `ReadOnlySpan<char>`, which is
		     not in the framework here. This is the whole of the addition — no other package
		     and no polyfill of ours. -->
		<PackageReference Include="System.Memory" Version="4.6.3" />
	</ItemGroup>

	<ItemGroup>
		<!-- The analyzer only. A consumer never references the generator assembly: `[Gram]`
		     is emitted into their compilation, which is the whole of why no runtime ships. -->
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
