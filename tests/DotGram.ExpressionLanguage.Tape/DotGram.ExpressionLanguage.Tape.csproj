<Project Sdk="Microsoft.NET.Sdk">

	<!-- The expression language's second reading, on the tape: the sources of
	     src/DotGram.ExpressionLanguage compiled again with DOTGRAM_EL_TAPE, under which the
	     grammar asks for `[GramOptions(Carrier = Tape, Suffix = "Tape")]` as well. The package
	     leaves the symbol off and so carries one reading, the immediate one; this assembly carries
	     both, and ExpressionParser.Tape is read from here — by the agreement tests, which hold the
	     package's reading to it, and by the stand, which measures it. Not shipped: it is a fixture.

	     Every type of the language is here a second time under the same full name, so a project
	     that references the package as well takes this one under an alias (`extern alias
	     tape`) and reads `State`, `Match<T>` and `ResolutionScope` of the tape's reading from
	     here: the two readings meet only in what they answer, never in a value of one
	     assembly handed to the other. Their static caches are per assembly too. -->
	<PropertyGroup>
		<!-- net10.0 alone: the tests and the stand are what read it, and both are net10.0. -->
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<RootNamespace>DotGram.ExpressionLanguage</RootNamespace>
		<DefineConstants>$(DefineConstants);DOTGRAM_EL_TAPE</DefineConstants>

		<!-- As the package has them, so that a reader can open what the grammar became beside the
		     package's own and see that the immediate reading is the same text. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\src\DotGram.ExpressionLanguage\**\*.cs"
		         Exclude="..\..\src\DotGram.ExpressionLanguage\obj\**;..\..\src\DotGram.ExpressionLanguage\bin\**"
		         LinkBase="ExpressionLanguage" />
	</ItemGroup>

	<ItemGroup>
		<!-- The package's own, for the same readers: the tape's reading is internal here. -->
		<InternalsVisibleTo Include="DotGram.Tests" />
		<InternalsVisibleTo Include="DotGram.Benchmarks" />
	</ItemGroup>

</Project>
