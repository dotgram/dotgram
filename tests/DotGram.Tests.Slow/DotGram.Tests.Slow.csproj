<Project Sdk="Microsoft.NET.Sdk">

	<!-- What is paid for on request and in CI rather than on every run of DotGram.Tests (D12):
	     the whole refusal record, the memory bounds of streamed input, GRAM5003's parts at every
	     size and a nine-hundred-rule split over buffered input. `dotnet test` over the
	     solution runs it; over DotGram.Tests alone it does not, and nothing has to be filtered. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.Tests</RootNamespace>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

		<!-- The corpus gate's other parser, and its printer: CorpusRoundTripTests cuts somebody else's
		     SQL into statements with ScriptDom and holds our reading of each against theirs through
		     ScriptDom's own printer. Here and in the benchmarks and nowhere else, so the suite that runs
		     on every change does not acquire a third-party SQL parser; the version is central, so it is
		     the benchmarks' 180.102.0 and the two roads print with the same printer. -->
		<PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
	</ItemGroup>

	<ItemGroup>
		<!-- The generator is called here, not run over this project. -->
		<!-- The examples, for what is held to a bound over a whole grammar: StockCountScalingTests. -->
		<ProjectReference Include="..\..\examples\DotGram.Examples\DotGram.Examples.csproj" />
		<!-- And SQL, for the long condition a shipped parser has to read in linear time: SqlConditionScalingTests. -->
		<ProjectReference Include="..\..\src\DotGram.Sql\DotGram.Sql.csproj" />
		<!-- And the expression language, whose tape reads a long expression in linear time: ExpressionScalingTests. -->
		<ProjectReference Include="..\..\src\DotGram.ExpressionLanguage\DotGram.ExpressionLanguage.csproj" />
		<!-- The web formats: the refusal scaling that holds `(A+)*` out of their grammars,
		     and the accept and address lists where the pools' retention bounds were measured. -->
		<ProjectReference Include="..\..\src\DotGram.Web\DotGram.Web.csproj" />
		<!-- And FIX, the last package the refusal ladders read (RefusalGuardTests). -->
		<ProjectReference Include="..\..\src\DotGram.Finance\DotGram.Finance.csproj" />

		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="AnalyzerReference" ReferenceOutputAssembly="true" />
	</ItemGroup>

	<!-- Written once, in DotGram.Tests, and read by both: the compiler of emitted code, the
	     shapes and the record of their refusals, which DotGram.Tests holds a sample of. -->
	<ItemGroup>
		<Compile Include="..\DotGram.Tests\EmittedCode.cs"   Link="Shared\EmittedCode.cs" />
		<Compile Include="..\DotGram.Tests\CarrierShapes.cs" Link="Shared\CarrierShapes.cs" />
		<Compile Include="..\DotGram.Tests\RefusalCorpus.cs" Link="Shared\RefusalCorpus.cs" />
		<Compile Include="..\DotGram.Tests\BufferedInputTests.Input.cs" Link="Shared\BufferedInputTests.Input.cs" />
		<Compile Include="..\DotGram.Tests\CaseFoldAttackTests.Fuzz.cs" Link="Shared\CaseFoldAttackTests.Fuzz.cs" />
		<Compile Include="..\DotGram.Tests\ReferenceInterpreter.cs" Link="Shared\ReferenceInterpreter.cs" />
	</ItemGroup>

	<!-- Written once, in the benchmarks (which prints every series as an audit), and read here as a guard held to a baseline (D57). -->
	<ItemGroup>
		<Compile Include="..\..\benchmarks\DotGram.Benchmarks\RefusalLadders.cs" Link="Shared\RefusalLadders.cs" />
		<None Include="RefusalBaseline.txt" CopyToOutputDirectory="PreserveNewest" />

		<!-- The same arrangement for the corpus round trip: the benchmarks' roundtrip switch prints what
		     this counts, CorpusRoundTripTests holds it to a baseline, and there is one implementation.
		     CorpusBaseline.txt is not copied to the output, unlike RefusalBaseline.txt above: that test
		     reads the copy, this one reads and REWRITES the source file, and a recording run that wrote
		     the source while reading the copy would hold a run against the wrong file. It needs the
		     source tree anyway, since tests/Corpus/ScriptDom is not copied either. -->
		<Compile Include="..\..\benchmarks\DotGram.Benchmarks\CorpusRoundTrip.cs" Link="Shared\CorpusRoundTrip.cs" />
	</ItemGroup>

</Project>
