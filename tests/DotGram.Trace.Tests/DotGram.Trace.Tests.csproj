<Project Sdk="Microsoft.NET.Sdk">

	<!-- The trace build of the shipped grammars held to the libraries as they ship (docs/syntax.md,
	     §6.9): the same answers, explanations in the words of the message, a frame for every
	     forwarding rule, every rule entered left, memory and time within bounds. Three builds of the
	     same sources meet here, so each is referenced under an alias of its own. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.Trace.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
	</ItemGroup>

	<ItemGroup>
		<!-- As shipped. -->
		<ProjectReference Include="..\..\src\DotGram.Sql\DotGram.Sql.csproj" Aliases="plain" />
		<ProjectReference Include="..\..\src\DotGram.ExpressionLanguage\DotGram.ExpressionLanguage.csproj" Aliases="plain" />
		<ProjectReference Include="..\..\src\DotGram.Web\DotGram.Web.csproj" Aliases="plain" />

		<!-- As a trace build, and as one whose forwarding rules are called as written. -->
		<ProjectReference Include="..\DotGram.Traced\DotGram.Traced.csproj" Aliases="traced" />
		<ProjectReference Include="..\DotGram.Traced.Unfolded\DotGram.Traced.Unfolded.csproj" Aliases="unfolded" />

		<!-- The process the deep refusal is measured in, built beside the tests and started by them. -->
		<ProjectReference Include="..\DotGram.Trace.Deep\DotGram.Trace.Deep.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
