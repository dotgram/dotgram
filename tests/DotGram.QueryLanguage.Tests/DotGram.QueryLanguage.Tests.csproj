<Project Sdk="Microsoft.NET.Sdk">

	<!-- The query language end to end: text, binder, translator, audit, and linq2db over SQLite in
	     memory; SQL Server where a connection string is given (QL_MSSQL). -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.QueryLanguage.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DotGram.QueryLanguage.LinqToDB\DotGram.QueryLanguage.LinqToDB.csproj" />
	</ItemGroup>

</Project>
