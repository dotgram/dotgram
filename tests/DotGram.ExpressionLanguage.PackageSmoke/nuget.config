<?xml version="1.0" encoding="utf-8"?>
<!-- What a package smoke check is for: the packages this build just made, and nothing else
     called DotGram from anywhere. The mapping is what makes that true — without it a
     floating version would happily take a published package from nuget.org, and the check
     would pass without the build having been looked at. Everything else, the compiler
     toolset and the libraries' own dependencies, comes from nuget.org as any consumer's
     would. -->
<configuration>
	<packageSources>
		<clear />
		<add key="artifacts" value="../../artifacts" />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<packageSource key="artifacts">
			<package pattern="DotGram" />
			<package pattern="DotGram.*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
