<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.Cli.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<!-- The release gates' comparisons, a file-based app run-gates.sh builds on its own. -->
		<Compile Remove="gates/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />

		<!-- The tool's Roslyn, not the generator's floor: the two meet in this process. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(DotGramCliRoslynVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- The tool, called in this process for most tests; the generator comes with it, and its
		     DotGram.dll is also what the scratch projects here take as their analyzer, so a build
		     and the tool run one and the same generator. -->
		<ProjectReference Include="..\..\src\DotGram.Cli\DotGram.Cli.csproj" />

		<!-- And the generator directly, which the tool keeps to itself (PrivateAssets): its version and
		     its location, the analyzer a scratch project is built with. -->
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj" />
	</ItemGroup>

</Project>
