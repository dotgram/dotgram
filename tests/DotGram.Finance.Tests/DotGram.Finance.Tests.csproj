<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<!-- To compile the fenced C# of the shipped pages, which is what ShippedPages does. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<ProjectReference Include="../../examples/DotGram.Handwritten/DotGram.Handwritten.csproj" />
		<ProjectReference Include="../../src/DotGram.Finance/DotGram.Finance.csproj" />
		<!-- One configuration a process (D115): a rule lives in a static field on the message class,
		     so a test that loads somebody's dictionary changes what every other test sees while it
		     runs. Collections would not do, since different collections run at the same time and a dozen
		     classes here validate, so the suite runs one test at a time. It costs about a second. -->
		<None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Fixtures.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="FieldCases.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<!-- D37's page checker, written once for DotGram.Tests and linked rather than copied:
	     two answers to "does this page compile" would drift, which is the defect it exists to
	     catch. -->
	<ItemGroup>
		<Compile Include="..\DotGram.Tests\ShippedPages.cs" Link="ShippedPages.cs" />
	</ItemGroup>

</Project>
