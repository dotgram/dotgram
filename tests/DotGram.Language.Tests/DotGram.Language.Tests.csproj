<Project Sdk="Microsoft.NET.Sdk">

	<!-- The shared language core held to what it promises, on any machine: the editor's
	     analysis of a grammar, of the C# around one and of a referenced parser's metadata,
	     and the drift checks that keep it the generator's own language. The sources are
	     compiled here from Language.projitems, as every editor compiles them, and the
	     generator's assembly is not referenced: it carries Grammar/ too, and the two copies
	     would collide (CS0436). -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>DotGram.Language.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
	</ItemGroup>

	<Import Project="..\..\src\DotGram\Language.projitems" />

	<ItemGroup>
		<!-- The compiler of emitted code, written once in DotGram.Tests. -->
		<Compile Include="..\DotGram.Tests\EmittedCode.cs" Link="Shared\EmittedCode.cs" />
	</ItemGroup>

	<!-- The generator itself, for the tests that need a library built the way a build builds one:
	     run in the test process, never referenced, for the same reason as above. Where its
	     assembly is reaches the tests as assembly metadata. -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  ReferenceOutputAssembly="false" OutputItemType="DotGramGenerator" />
	</ItemGroup>

	<Target Name="DotGramGeneratorPath" DependsOnTargets="ResolveProjectReferences" BeforeTargets="GetAssemblyAttributes">
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>DotGramGenerator</_Parameter1>
				<_Parameter2>@(DotGramGenerator->'%(FullPath)')</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

</Project>
