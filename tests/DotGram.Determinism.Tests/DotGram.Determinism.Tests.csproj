<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- .NET 8 on purpose, and only it: the snapshots are written by DotGram.Tests on .NET 10,
		     and this asks the generator on another runtime for the same files. A runtime whose
		     Unicode tables differ is where a generator that asked the runtime anything about
		     characters would write something else. -->
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>DotGram.Determinism.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- A test project is an executable: it hosts Microsoft.Testing.Platform itself
		     rather than being hosted by VSTest. -->
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- The generator as a library, run in this process: the runtime it runs on is this one. -->
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj" />
	</ItemGroup>

	<!-- What each snapshot is compiled with, written once for DotGram.Tests and linked rather
	     than copied: two lists of options would drift, and the files would differ for that. -->
	<ItemGroup>
		<Compile Include="..\DotGram.Tests\SnapshotRenderings.cs" Link="SnapshotRenderings.cs" />
	</ItemGroup>

</Project>
