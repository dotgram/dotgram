<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<!-- Only what was just built, plus nuget.org for the compiler toolset. The
		     package under test cannot come from anywhere but ../../artifacts. -->
		<clear />
		<add key="built" value="../../artifacts" />
		<add key="nuget" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
</configuration>
