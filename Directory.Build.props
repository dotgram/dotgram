<Project>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Deterministic>true</Deterministic>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>

		<!-- A warning nobody has to act on is a warning everybody learns to scroll past.
		     CI has always built with -warnaserror; saying it here too means such a build
		     fails on the machine that wrote the code rather than on the server. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Without this, the style rules in .editorconfig are seen by an editor and by
		     `dotnet format`, and by nothing else: a build does not read them, so a rule
		     written there is a rule only for whoever was already going to follow it. That
		     is how the block-body rule came to be broken in 2,962 places while sitting in
		     docs/coding-conventions.md the whole time. With it, the next one fails a build
		     on the machine that wrote it. Measured: it wakes no other diagnostic, and its
		     cost is not visible against the spread of a full rebuild. -->
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- NU1900 is not a warning about this code: it says NuGet could not reach a source to ask
		     whether a package has a known vulnerability. That is a condition of the machine, and a
		     build that fails when the network is down fails for something nobody can fix by editing
		     anything. The audit itself stays on: a real finding is NU1901 and above. -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>

		<!-- `summary`: one line a parser, saying the generator ran and what came out. The rest —
		     the mode, the options, the carrier of every machine — is `full`, which the runs that
		     read it ask for: `-p:DotGramReportGeneration=full`, as the carriers run needs. An
		     ordinary build here is not a measurement and should not read like one. -->
		<DotGramReportGeneration>summary</DotGramReportGeneration>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Igor Tkachev</Authors>
		<Product>.Gram</Product>
		<Company>DotGram</Company>
		<Copyright>Copyright © 2026 $(Authors)</Copyright>
		<Version>0.3.0</Version>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/dotgram/dotgram</RepositoryUrl>
		<PackageProjectUrl>https://github.com/dotgram/dotgram</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>

		<!-- SourceLink, which the SDK carries itself: with the repository's URL above, a debugger
		     steps from a package's line into the source on GitHub. The symbols are in the assembly
		     (`DebugType embedded` in each package), so no symbol package is published. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- Two things a generated parser can be asked to carry for our own measurement, neither of
		     them defined by default, so a consumer compiles none of it: DOTGRAM_COUNTS, the walk's
		     counters (D144), and DOTGRAM_CHECKS, which asserts the walk's invariants as it goes.

		     Set here rather than per project so a sweep can turn one on for the whole repository, and
		     by a PROPERTY rather than `-p:DefineConstants=…` on the command line, which REPLACES the
		     symbols the SDK adds (NETSTANDARD2_0, NET472 and the rest) and would break the
		     multi-targeted projects in a way that looks like the checks breaking them. -->
		<DefineConstants Condition="'$(DotGramCounts)' == 'true'">$(DefineConstants);DOTGRAM_COUNTS</DefineConstants>
		<DefineConstants Condition="'$(DotGramChecks)' == 'true'">$(DefineConstants);DOTGRAM_CHECKS</DefineConstants>
		<!-- Spike: a trace build of every grammar (1), or one that keeps forwarding rules as written (2). -->
		<DefineConstants Condition="'$(DotGramSpikeTrace)' == '1'">$(DefineConstants);DOTGRAM_GRAMTRACE</DefineConstants>
		<DefineConstants Condition="'$(DotGramSpikeTrace)' == '2'">$(DefineConstants);DOTGRAM_GRAMTRACE;DOTGRAM_GRAMTRACE_NOINLINE</DefineConstants>

		<!-- Off everywhere unless a caller sets it: the generator's own generated code analysed
		     for dead or redundant emitter output (tools/DotGram.GeneratedAnalyzers), which each
		     shipped package and the examples reference as an analyzer only under this property
		     (their own .csproj). An ordinary build and the IDE never load it; the CI job that
		     does turns it on explicitly (`-p:DotGramAnalyzeGenerated=true`, tools/generated-analysis/
		     emit.sh). See docs/development.md. -->
		<DotGramAnalyzeGenerated Condition="'$(DotGramAnalyzeGenerated)' == ''">false</DotGramAnalyzeGenerated>

		<!-- A field either of them adds needs an INITIALISER, not merely a declaration. A grammar whose
		     walk never reaches one — no marks, nothing that materialises — leaves it unassigned, and
		     CS0649 is an ERROR wherever a consumer treats warnings as errors: DotGram.Compatibility does,
		     on purpose, and the counted and checked variants would not build on any of its three targets
		     without one. This cost three separate builds to learn. With [ThreadStatic] the initialiser
		     runs for the first thread only, which for a zero default is what every other thread gets. -->
	</PropertyGroup>

	<!-- The icon every package carries. Items are evaluated after every property, so
	     `IsPackable` here is the project's own answer and the tests are left out. -->
	<ItemGroup Condition="'$(IsPackable)' != 'false'">
		<None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
