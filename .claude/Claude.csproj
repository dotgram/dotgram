<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- Builds nothing. It exists so the agent configuration in this folder is
	     visible and editable in the IDE alongside the rest of the solution. -->
	<ItemGroup>
		<None Include="**/*" Exclude="bin/**;obj/**;$(MSBuildProjectFile)" />
	</ItemGroup>

</Project>
