{
  "name": "VisualStudioCode",
  "displayName": ".Gram for VS Code",
  "description": "Colours, diagnostics, completion, Quick Info, navigation, rename, folding and outline for .gram grammars, and colours, diagnostics, Quick Info and navigation for grammars written in C# strings, from the same language core as the DotGram source generator.",
  "version": "0.3.1",
  "publisher": "dotgram",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotgram/dotgram"
  },
  "homepage": "https://github.com/dotgram/dotgram/blob/main/docs/vscode.md",
  "bugs": {
    "url": "https://github.com/dotgram/dotgram/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "dotgram",
    "gram",
    "grammar",
    "parser",
    "peg"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server runs in an untrusted workspace too; which program runs it is a setting of the machine, never of a workspace.",
      "restrictedConfigurations": [
        "dotgram.server.path",
        "dotgram.dotnetPath"
      ]
    }
  },
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ],
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gram",
        "aliases": [
          ".Gram",
          "gram"
        ],
        "extensions": [
          ".gram"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/gram-file.png",
          "dark": "./images/gram-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "gram",
        "scopeName": "source.gram",
        "path": "./syntaxes/gram.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.cs": "csharp"
        }
      }
    ],
    "snippets": [
      {
        "language": "gram",
        "path": "./snippets/gram.code-snippets"
      },
      {
        "language": "csharp",
        "path": "./snippets/gram.code-snippets"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "gramInvalid",
        "superType": "comment",
        "description": "A token the grammar's lexer does not recognize."
      },
      {
        "id": "gramEmbeddedCode",
        "superType": "variable",
        "description": "C# inside a grammar, where it is not classified more closely."
      },
      {
        "id": "gramCaseInsensitive",
        "superType": "string",
        "description": "A case-insensitive literal: 'x'i or \"text\"i."
      },
      {
        "id": "gramSpecialSymbol",
        "superType": "operator",
        "description": "A symbol of the notation with a meaning of its own, such as a lookahead."
      },
      {
        "id": "gramPunctuation",
        "superType": "operator",
        "description": "Brackets, braces, parentheses and separators."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gram",
        "scopes": {
          "gramInvalid": [
            "invalid.illegal.gram"
          ],
          "gramEmbeddedCode": [
            "meta.embedded.expression.cs"
          ],
          "gramCaseInsensitive": [
            "string.quoted.case-insensitive.gram"
          ],
          "gramSpecialSymbol": [
            "keyword.control.special.gram"
          ],
          "gramPunctuation": [
            "punctuation.separator.gram"
          ],
          "macro": [
            "keyword.other.transition.gram"
          ],
          "keyword": [
            "keyword.other.gram"
          ]
        }
      }
    ],
    "colors": [
      {
        "id": "dotgram.embedded.comment",
        "description": "In a grammar written in a C# string, a comment.",
        "defaults": {
          "dark": "#6A9955",
          "light": "#008000",
          "highContrast": "#7CA668",
          "highContrastLight": "#515151"
        }
      },
      {
        "id": "dotgram.embedded.keyword",
        "description": "In a grammar written in a C# string, a keyword, such as parse or using.",
        "defaults": {
          "dark": "#569CD6",
          "light": "#0000FF",
          "highContrast": "#569CD6",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "dotgram.embedded.variable",
        "description": "In a grammar written in a C# string, a rule, capture or parameter; in a DSL, a variable or another name.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "dotgram.embedded.number",
        "description": "In a grammar written in a C# string, a number.",
        "defaults": {
          "dark": "#B5CEA8",
          "light": "#098658",
          "highContrast": "#B5CEA8",
          "highContrastLight": "#096D48"
        }
      },
      {
        "id": "dotgram.embedded.string",
        "description": "In a grammar written in a C# string, a literal or a character class.",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515",
          "highContrast": "#CE9178",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "dotgram.embedded.operator",
        "description": "In a grammar written in a C# string, an operator, such as = or =>.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "dotgram.embedded.macro",
        "description": "In a grammar written in a C# string, the @ before C#.",
        "defaults": {
          "dark": "#569CD6",
          "light": "#0000FF",
          "highContrast": "#569CD6",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "dotgram.embedded.gramInvalid",
        "description": "In a grammar written in a C# string, a token the grammar's lexer does not recognize.",
        "defaults": {
          "dark": "#F44747",
          "light": "#CD3131",
          "highContrast": "#F44747",
          "highContrastLight": "#B5200D"
        }
      },
      {
        "id": "dotgram.embedded.gramEmbeddedCode",
        "description": "In a grammar written in a C# string, C# inside the grammar.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "dotgram.embedded.gramCaseInsensitive",
        "description": "In a grammar written in a C# string, a case-insensitive literal: 'x'i or \"text\"i.",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515",
          "highContrast": "#CE9178",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "dotgram.embedded.gramSpecialSymbol",
        "description": "In a grammar written in a C# string, a symbol of the notation, such as | & * + .. ?=.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#AF00DB",
          "highContrast": "#C586C0",
          "highContrastLight": "#B5200D"
        }
      },
      {
        "id": "dotgram.embedded.gramPunctuation",
        "description": "In a grammar written in a C# string, brackets, braces, parentheses and separators.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      },
      {
        "id": "dotgram.embedded.type",
        "description": "In a C# string written in a DSL of a [GramLanguage], a type.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#267F99",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#185E73"
        }
      },
      {
        "id": "dotgram.embedded.function",
        "description": "In a C# string written in a DSL of a [GramLanguage], a function or method.",
        "defaults": {
          "dark": "#DCDCAA",
          "light": "#795E26",
          "highContrast": "#DCDCAA",
          "highContrastLight": "#5E2CBC"
        }
      },
      {
        "id": "dotgram.embedded.property",
        "description": "In a C# string written in a DSL of a [GramLanguage], a property.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "dotgram.embedded.namespace",
        "description": "In a C# string written in a DSL of a [GramLanguage], a namespace.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#267F99",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#185E73"
        }
      },
      {
        "id": "dotgram.embedded.parameter",
        "description": "In a C# string written in a DSL of a [GramLanguage], a parameter.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "dotgram.embedded.label",
        "description": "In a C# string written in a DSL of a [GramLanguage], a label.",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      }
    ],
    "configuration": {
      "title": ".Gram",
      "properties": {
        "dotgram.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The language server to run instead of the one the extension carries: a `DotGram.LanguageServer.dll`, run with .NET, or an executable."
        },
        "dotgram.dotnetPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The `dotnet` executable that runs the language server. Empty: the .NET 10 runtime is acquired through the .NET Install Tool."
        },
        "dotgram.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between VS Code and the .Gram language server in the output panel."
        },
        "dotgram.embedded.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether the grammars written into C# strings are analysed: their diagnostics, colours, hover and navigation. Off, the extension gives the server no C# document."
        },
        "dotgram.embedded.diagnostics": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Shown, except where the C# extension is installed and the project runs the DotGram generator, whose build shows them already.",
            "Always shown.",
            "Never shown."
          ],
          "default": "auto",
          "markdownDescription": "Whether the diagnostics of a grammar written into a C# string are shown."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check && npm run bundle",
    "check": "tsc --noEmit -p .",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify --sourcemap --metafile=dist/meta.json",
    "notices": "node scripts/notices.mjs",
    "test:notices": "node --test scripts/notices.test.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "test": "npm run bundle && npm run compile-tests && node ./out/test/runTest.js",
    "package": "vsce package --out ../../artifacts/"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.0"
  }
}
