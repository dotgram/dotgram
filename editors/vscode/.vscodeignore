# What the .vsix carries is the bundle, the server, and what package.json points at.
**
!dist/extension.js
!server/**
!syntaxes/**
!snippets/**
# The Marketplace page loads its screenshots (images/marketplace-*.png) from the repository: vsce points the
# README's relative links there, so the package leaves them out.
!images/icon.png
!images/gram-file.png
!language-configuration.json
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!ThirdPartyNotices.txt
server/*.pdb
