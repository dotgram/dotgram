# Line endings are CRLF in the working tree and in the repository — this project
# is Windows-only in practice, and normalizing would fight the editor.
* text eol=crlf

# Binary
*.png binary
*.jpg binary
*.dll binary
*.gz binary
*.snk binary

# Somebody else's corpus, kept byte for byte. Fifteen of the files are UTF-16 and
# normalizing line endings would corrupt them; more to the point, the whole value
# of a corpus written elsewhere is that it is the text they wrote and not ours.
tests/Corpus/ScriptDom/** -text

# JSONTestSuite's parsing cases are the bytes a parser is handed: some are UTF-16, some are not
# valid UTF-8, and a line ending is part of what several of them test.
tests/DotGram.Tests/Web/JsonTestSuite/** -text

# The http-state working group's cookie cases are header lines as sent: CRLF, and ISO-8859-1 octets
# that are not UTF-8.
tests/DotGram.Tests/Web/HttpState/** -text

# is_email's tests, kept as their author wrote them.
tests/DotGram.Tests/Web/IsEmail/** -text
