<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />

		<!-- The library this package is compared against (D123), and the FIX 4.4 dictionary that
		     ships with it: their schema is read from that file, and our loaded mode reads the same
		     one, so the comparison is over one description and not two. -->
		<PackageReference Include="QuickFIXn.Core" />
		<PackageReference Include="QuickFIXn.FIX44" />
		<None Include="$([MSBuild]::EnsureTrailingSlash($(NuGetPackageRoot)))quickfixn.fix44/1.14.1/DataDictionary/FIX44.xml" Link="FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
		<ProjectReference Include="../../examples/DotGram.Handwritten/DotGram.Handwritten.csproj" />
		<ProjectReference Include="../../src/DotGram.Finance/DotGram.Finance.csproj" />

		<!-- To compile the rule text the composer writes, which is how a dump says whether what it
		     wrote is a program. The package itself does not reference the expression language. -->
		<ProjectReference Include="../../src/DotGram.ExpressionLanguage/DotGram.ExpressionLanguage.csproj" />
		<ProjectReference Include="../../tests/DotGram.Finance.Fix44/DotGram.Finance.Fix44.csproj" />
	</ItemGroup>
</Project>
