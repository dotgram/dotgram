<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />

		<ProjectReference Include="../../examples/DotGram.Handwritten/DotGram.Handwritten.csproj" />
		<ProjectReference Include="../../src/DotGram.Finance/DotGram.Finance.csproj" />

		<!-- To compile the rule text the composer writes, which is how a dump says whether what it
		     wrote is a program. The package itself does not reference the expression language. -->
		<ProjectReference Include="../../src/DotGram.ExpressionLanguage/DotGram.ExpressionLanguage.csproj" />
		<ProjectReference Include="../../tests/DotGram.Finance.Fix44/DotGram.Finance.Fix44.csproj" />

		<!-- For FixInitializationBenchmarks: the dictionary D143 measures loading and applying. -->
		<None Include="../../tests/Corpus/Fix/FIX44.xml" Link="FIX44.xml" CopyToOutputDirectory="PreserveNewest" />
		<None Include="../../tests/Corpus/Fix/quickfixn-fix44-errata.xml" Link="quickfixn-fix44-errata.xml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
