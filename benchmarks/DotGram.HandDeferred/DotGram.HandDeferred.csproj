<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>DotGram.HandDeferred</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Newer than the one DotGram.Benchmarks takes, and deliberately not unified
		     here: the two were written a year apart, and moving either is a change to a
		     harness rather than to a version list. -->
		<PackageReference Include="BenchmarkDotNet" VersionOverride="0.15.8" />
	</ItemGroup>

	<ItemGroup>
		<!-- The grammar this parser is a reading of. Not compiled: the point of the project
		     is what a person writes when the generator is not there, so it takes no
		     reference to the generator and the file is here to be read beside the code. -->
		<None Include="Deferred.gram" />
	</ItemGroup>

</Project>
