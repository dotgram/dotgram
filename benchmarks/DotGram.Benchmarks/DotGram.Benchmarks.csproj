<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>DotGram.Benchmarks</RootNamespace>
		<IsPackable>false</IsPackable>

		<!-- The generated parser is the thing under test, so it goes on disk where it can
		     be read next to the numbers it produced. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
		<!-- Hardware counters (SqlCounters.cs) come from ETW, which this package wraps. -->
		<PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />

		<!-- The library being compared against (Against.cs). It lives here and nowhere
		     else: nothing that ships may depend on it, and nothing has to — what it is
		     for is being a second opinion about what T-SQL is, held by people who wrote
		     a T-SQL parser before this one existed. It is also the only authority on
		     where one statement of a script ends and the next begins, which is what
		     makes a comparison per statement possible at all. -->
		<PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />

		<!-- The third source, and the only one that is not somebody's reading of the
		     language: the engine itself. `SET PARSEONLY ON` asks it whether a statement is
		     syntax, which needs no schema and runs nothing (Engine.cs). Benchmarks only,
		     like ScriptDom, and the harness says so and moves on where no server answers. -->
		<PackageReference Include="Microsoft.Data.SqlClient" />
	</ItemGroup>

	<ItemGroup>
		<!-- The generator, and nothing else — the same reference a consumer takes. It
		     stays that way deliberately: referencing the compiler as a library here would
		     drag its Roslyn version in and stop this project being a consumer at all. What
		     the compiler itself costs is measured from the tests, which reference both. -->
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

		<!-- And two ordinary references, to the shipping parsers. This is the exception the
		     paragraph above does not cover, and it is a different case: a parser library is
		     not the compiler, it is a consumer of it, so referencing one drags no Roslyn in
		     and this project stays a consumer.

		     Referenced rather than copied, which is the opposite of what Urls.cs does with
		     the example beside it, and for a reason that does not apply there.
		     ExpressionParser is sixteen hundred lines of grammar and hand-written half,
		     and it ships: a copy of it here would be a second copy of a shipped artifact to
		     keep in step, and it would drift silently, where a URL grammar of forty lines
		     will not. The other half of the argument for copying — that the parser under
		     test should be the one this compilation produces — costs nothing here either,
		     because the generator's emission does not vary with the referencing project's
		     target framework. What the library was built with and what would be generated
		     here are the same C#. -->
		<ProjectReference Include="..\..\src\DotGram.Parsers\DotGram.Parsers.csproj" />
		<ProjectReference Include="..\..\src\DotGram.ExpressionLanguage\DotGram.ExpressionLanguage.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The SQL grammar once more, compiled eagerly (EagerSql.cs): the same file
		     DotGram.Parsers hosts, linked rather than copied so that it cannot drift, read by
		     the generator here under another carrier (docs/next.md, the redesign). -->
		<AdditionalFiles Include="..\..\src\DotGram.Parsers\Sql\Standard\SqlStandard92.gram" Link="SqlStandard92.gram" />
	</ItemGroup>

</Project>
