<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>DotGram.Benchmarks</RootNamespace>
		<IsPackable>false</IsPackable>

		<!-- BenchmarkDotNet builds and runs its own Release copy of this assembly, and
		     refuses to measure a Debug one. Building it in the solution's default
		     configuration is still worth doing: a benchmark that does not compile is
		     found here rather than the next time somebody asks for numbers. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- The generated parser is the thing under test, so it goes on disk where it can
		     be read next to the numbers it produced. -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
		<!-- Hardware counters (SqlCounters.cs) come from ETW, which this package wraps. -->
		<PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.14.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- The generator, and nothing else — the same reference a consumer takes. It
		     stays that way deliberately: referencing the compiler as a library here would
		     drag its Roslyn version in and stop this project being a consumer at all. What
		     the compiler itself costs is measured from the tests, which reference both. -->
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj"
		                  OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

		<!-- And one ordinary reference, to the shipping parsers. This is the exception the
		     paragraph above does not cover, and it is a different case: DotGram.Parsers is
		     not the compiler, it is a consumer of it, so referencing it drags no Roslyn in
		     and this project stays a consumer.

		     Referenced rather than copied, which is the opposite of what Urls.cs does with
		     the example beside it, and for a reason that does not apply there.
		     ExpressionLanguage is sixteen hundred lines of grammar and hand-written half,
		     and it ships: a copy of it here would be a second copy of a shipped artifact to
		     keep in step, and it would drift silently, where a URL grammar of forty lines
		     will not. The other half of the argument for copying — that the parser under
		     test should be the one this compilation produces — costs nothing here either,
		     because the generator's emission does not vary with the referencing project's
		     target framework. What DotGram.Parsers was built with and what would be
		     generated here are the same C#. -->
		<ProjectReference Include="..\..\src\DotGram.Parsers\DotGram.Parsers.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The SQL grammar once more, compiled eagerly (EagerSql.cs): the same file
		     DotGram.Parsers hosts, linked rather than copied so that it cannot drift, read by
		     the generator here under another carrier (docs/next.md, the redesign). -->
		<AdditionalFiles Include="..\..\src\DotGram.Parsers\SqlStandard92.gram" Link="SqlStandard92.gram" />
	</ItemGroup>

</Project>
