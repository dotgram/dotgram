<Project Sdk="Microsoft.NET.Sdk">

	<!-- What the C# compiler makes of DotGram.Sql's generated parsers, in one process and without
	     MSBuild: the generator runs over the project's own sources at a language version, and the
	     sources it wrote are compiled with the hand-written ones at that version. Not part of the
	     solution, as DotGram.CodeSize is not. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<ProjectReference Include="..\..\src\DotGram\DotGram.csproj" />
	</ItemGroup>

</Project>
