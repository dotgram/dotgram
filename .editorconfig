root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Strict rule for this repository: leading indentation is tabs, always.
# Spaces are allowed only for alignment after the first non-whitespace character.
indent_style = tab
indent_size = 4
tab_width = 4

[*.{cs,csproj,props,targets}]
# What Visual Studio itself writes for these.
charset = utf-8-bom

[FixMessageValidation.g.cs]
# Written by t4, which emits UTF-8 without a BOM and takes no option to do otherwise. The file is
# ASCII, so a BOM would carry nothing; added by hand it would be lost on the next run of the
# template, which is worse than not having it.
charset = utf-8

[*.slnx]
# Visual Studio writes .slnx without a BOM; matching it keeps solution edits from
# showing up as encoding churn.
charset = utf-8

[*.{md,markdown}]
# Markdown keeps spaces: leading whitespace inside fenced blocks is often
# alignment, not indentation, and tabs would destroy it.
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.cs]
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# using directives: System first, groups separated by a blank line, alphabetical
# within and between groups. Every file starts with `using System;` even when it
# is not needed — see CLAUDE.md.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Access modifiers that merely restate the language default are noise: `private`
# on a member, `internal` on a top-level type.
dotnet_style_require_accessibility_modifiers = omit_if_default:suggestion
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion

# A method body is a block, never an expression: an expression-bodied method reads as a property
# (docs/coding-conventions.md). Properties, indexers and accessors may stay expressions, and
# lambdas are untouched by these three.
csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_expression_bodied_local_functions = false:error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0021.severity = error
dotnet_diagnostic.IDE0061.severity = error
